{"id":"4.2","title":"Hjemme hos Bjørnar","audio":"audio/4.2.mp3","duration":109.07,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.54,"text":"4.2 Hjemme hos Bjørnar","heading":true,"zh":"4.2 在比约纳尔家","words":[[0,3,0.15,1.03,"4.2"],[4,10,1.91,2.57,"hjemme"],[11,14,2.57,2.79,"hos"],[15,22,2.79,3.46,"bjørnar"]]},{"id":1,"start":5.39,"end":11.9,"text":"Jeg heter Bjørnar, og jeg er pappa til Sofie på sju år og Markus på fire.","zh":"我叫比约纳尔，是七岁的苏菲和四岁的马库斯的爸爸。","words":[[0,3,5.47,5.67,"jeg"],[4,9,5.67,5.95,"heter"],[10,17,5.95,6.59,"bjørnar"],[19,21,7.09,7.11,"og"],[22,25,7.11,7.31,"jeg"],[26,28,7.31,7.57,"er"],[29,34,7.57,8.03,"pappa"],[35,38,8.03,8.27,"til~8de1a9181f86"],[39,44,8.27,8.99,"sofie"],[45,47,8.99,9.23,"på~f81b9c7a500b"],[48,51,9.23,9.61,"sju"],[52,54,9.61,9.91,"år"],[55,57,10.31,10.47,"og"],[58,64,10.47,10.99,"markus"],[65,67,10.99,11.39,"på~f81b9c7a500b"],[68,72,11.39,11.82,"fire"]]},{"id":2,"start":13.34,"end":17.39,"text":"Jeg er skilt, og barna bor hos meg annenhver uke.","zh":"我离婚了，孩子们每隔一周住在我这里。","words":[[0,3,13.42,13.64,"jeg"],[4,6,13.64,13.9,"er"],[7,12,13.9,14.28,"skilt~39bb7cd38da8"],[14,16,14.84,14.88,"og"],[17,22,14.88,15.32,"barna"],[23,26,15.32,15.54,"bor"],[27,30,15.54,15.78,"hos"],[31,34,15.78,16.06,"meg"],[35,44,16.06,16.84,"annenhver"],[45,48,16.84,17.31,"uke"]]},{"id":3,"start":18.9,"end":21.53,"text":"Jeg står opp kvart over seks om morgenen.","zh":"我早上六点一刻起床。","words":[[0,3,18.98,19.18,"jeg"],[4,8,19.18,19.58,"står~13cfed49d0de"],[9,12,19.58,19.76,"opp~4bb5dba4f351"],[13,18,19.76,20.16,"kvart"],[19,23,20.16,20.52,"over~fc4babce59ce"],[24,28,20.52,20.8,"seks"],[29,31,20.8,20.98,"om~5b93c55d689f"],[32,40,20.98,21.45,"morgenen"]]},{"id":4,"start":22.67,"end":24.12,"text":"Først dusjer jeg.","zh":"我先冲个澡。","words":[[0,5,22.75,23.19,"først"],[6,12,23.19,23.61,"dusjer~fc4b8b314d59"],[13,16,23.61,24.04,"jeg"]]},{"id":5,"start":24.73,"end":26.38,"text":"Så kler jeg på meg.","zh":"然后我穿好衣服。","words":[[0,2,24.81,25.15,"så~bfb333151d21"],[3,7,25.15,25.59,"kler"],[8,11,25.59,25.77,"jeg"],[12,14,25.77,25.99,"på~21aaa4d0f582"],[15,18,25.99,26.3,"meg"]]},{"id":6,"start":28.06,"end":30.68,"text":"Klokka halv sju vekker jeg barna.","zh":"六点半我叫醒孩子们。","words":[[0,6,28.14,28.5,"klokka"],[7,11,28.5,29.0,"halv~642706f0805b"],[12,15,29.0,29.36,"sju"],[16,22,29.36,30.02,"vekker"],[23,26,30.02,30.14,"jeg"],[27,32,30.14,30.6,"barna"]]},{"id":7,"start":31.82,"end":33.95,"text":"De vasker seg og kler på seg.","zh":"他们洗漱、穿衣服。","words":[[0,2,31.9,32.11,"de"],[3,9,32.11,32.57,"vasker~8c408dabdea1"],[10,13,32.57,32.81,"seg"],[14,16,32.81,33.07,"og"],[17,21,33.07,33.33,"kler"],[22,24,33.33,33.53,"på~21aaa4d0f582"],[25,28,33.53,33.87,"seg"]]},{"id":8,"start":34.76,"end":40.36,"text":"Etterpå spiser vi frokost sammen, og jeg lager matpakker til barna.","zh":"之后我们一起吃早餐，我给孩子们准备午餐便当。","words":[[0,7,34.84,35.54,"etterpå"],[8,14,35.54,36.1,"spiser"],[15,17,36.1,36.26,"vi"],[18,25,36.26,36.88,"frokost"],[26,32,36.88,37.32,"sammen"],[34,36,37.91,38.09,"og"],[37,40,38.09,38.35,"jeg"],[41,46,38.35,38.87,"lager~2ce37095d0c8"],[47,56,38.87,39.63,"matpakker"],[57,60,39.63,39.81,"til"],[61,66,39.81,40.28,"barna"]]},{"id":9,"start":41.45,"end":44.65,"text":"Jeg drikker kaffe, og barna drikker melk.","zh":"我喝咖啡，孩子们喝牛奶。","words":[[0,3,41.52,41.78,"jeg"],[4,11,41.78,42.1,"drikker~8bc6fe28e25c"],[12,17,42.1,42.4,"kaffe"],[19,21,43.16,43.24,"og"],[22,27,43.24,43.72,"barna"],[28,35,43.72,44.06,"drikker~8bc6fe28e25c"],[36,40,44.06,44.57,"melk"]]},{"id":10,"start":45.93,"end":48.62,"text":"Jeg liker å ha god tid om morgenen.","zh":"我喜欢早上时间充裕一些。","words":[[0,3,46.01,46.26,"jeg"],[4,9,46.26,46.7,"liker"],[10,11,46.7,46.86,"å~0583da7a620a"],[12,14,46.86,47.04,"ha~ca5edb8b1cdb"],[15,18,47.04,47.46,"god~3bf5a9c975f3"],[19,22,47.46,47.9,"tid"],[23,25,47.9,48.02,"om~5b93c55d689f"],[26,34,48.02,48.54,"morgenen"]]},{"id":11,"start":49.98,"end":55.3,"text":"Klokka kvart på åtte leverer jeg barna på skolen og i barnehagen.","zh":"七点四十五分我把孩子们送到学校和幼儿园。","words":[[0,6,50.06,50.4,"klokka"],[7,12,50.4,50.72,"kvart"],[13,15,50.72,50.94,"på~2554220f753c"],[16,20,50.94,51.34,"åtte"],[21,28,51.34,52.26,"leverer"],[29,32,52.26,52.36,"jeg"],[33,38,52.36,52.82,"barna"],[39,41,52.82,52.98,"på"],[42,48,52.98,53.42,"skolen"],[49,51,53.42,54.1,"og"],[52,53,54.1,54.22,"i"],[54,64,54.22,55.22,"barnehagen"]]},{"id":12,"start":56.89,"end":60.51,"text":"Fra klokka åtte til halv fire er jeg på jobb.","zh":"从八点到三点半我在上班。","words":[[0,3,56.97,57.2,"fra"],[4,10,57.2,57.58,"klokka"],[11,15,57.58,58.1,"åtte"],[16,19,58.1,58.46,"til"],[20,24,58.46,58.8,"halv~afaec9028f69"],[25,29,58.8,59.08,"fire"],[30,32,59.08,59.66,"er"],[33,36,59.66,59.78,"jeg"],[37,39,59.78,59.98,"på"],[40,44,59.98,60.43,"jobb"]]},{"id":13,"start":61.06,"end":63.17,"text":"Jeg er bilmekaniker.","zh":"我是汽车修理工。","words":[[0,3,61.14,61.46,"jeg"],[4,6,61.46,61.78,"er"],[7,19,61.78,63.09,"bilmekaniker"]]},{"id":14,"start":64.72,"end":68.03,"text":"Etter jobb henter jeg barna, og vi kjører hjem.","zh":"下班后我去接孩子们，然后我们开车回家。","words":[[0,5,64.8,65.11,"etter"],[6,10,65.11,65.45,"jobb"],[11,17,65.45,65.99,"henter"],[18,21,65.99,66.11,"jeg"],[22,27,66.11,66.53,"barna"],[29,31,67.03,67.07,"og"],[32,34,67.07,67.21,"vi"],[35,41,67.21,67.59,"kjører"],[42,46,67.59,67.95,"hjem~3f5fbf6a493e"]]},{"id":15,"start":69.21,"end":71.39,"text":"Vi spiser middag klokka fem.","zh":"我们五点吃晚饭。","words":[[0,2,69.29,69.49,"vi"],[3,9,69.49,69.89,"spiser"],[10,16,69.89,70.41,"middag"],[17,23,70.41,70.97,"klokka"],[24,27,70.97,71.31,"fem"]]},{"id":16,"start":71.47,"end":76.9,"text":"Sofie gjør lekser etter middag, og jeg hjelper henne.","zh":"苏菲晚饭后做作业，我帮她。","words":[[0,5,72.19,72.95,"sofie"],[6,10,73.09,73.57,"gjør"],[11,17,73.57,74.21,"lekser"],[18,23,74.21,74.69,"etter"],[24,30,74.69,75.03,"middag"],[32,34,75.59,75.69,"og"],[35,38,75.69,75.97,"jeg"],[39,46,75.97,76.49,"hjelper"],[47,52,76.49,76.82,"henne"]]},{"id":17,"start":78.35,"end":81.57,"text":"Klokka seks ser vi på barne-tv sammen.","zh":"六点我们一起看儿童电视节目。","words":[[0,6,78.43,78.74,"klokka"],[7,11,78.74,79.2,"seks"],[12,15,79.2,79.74,"ser"],[16,18,79.74,79.94,"vi"],[19,21,79.94,80.14,"på~fab38a6838d6"],[22,30,80.14,81.0,"barne-tv"],[31,37,81.0,81.49,"sammen"]]},{"id":18,"start":82.2,"end":83.93,"text":"Vi liker å kose oss.","zh":"我们喜欢一起享受温馨时光。","words":[[0,2,82.28,82.44,"vi"],[3,8,82.44,82.88,"liker"],[9,10,82.88,83.04,"å~0583da7a620a"],[11,15,83.04,83.48,"kose"],[16,19,83.48,83.85,"oss"]]},{"id":19,"start":85.67,"end":88.85,"text":"Barna legger seg klokka halv åtte om kvelden.","zh":"孩子们晚上七点半上床睡觉。","words":[[0,5,85.75,86.32,"barna"],[6,12,86.32,86.76,"legger~621543baabad"],[13,16,86.76,86.92,"seg"],[17,23,86.92,87.34,"klokka"],[24,28,87.34,87.64,"halv~e5cf85157fed"],[29,33,87.64,88.06,"åtte"],[34,36,88.06,88.26,"om~c13075d78f52"],[37,44,88.26,88.77,"kvelden"]]},{"id":20,"start":90.28,"end":92.81,"text":"Så rydder jeg litt og vasker klær.","zh":"然后我收拾一下，洗洗衣服。","words":[[0,2,90.36,90.66,"så~bfb333151d21"],[3,9,90.66,91.26,"rydder"],[10,13,91.26,91.42,"jeg"],[14,18,91.42,91.64,"litt~54360be2a478"],[19,21,91.64,91.94,"og"],[22,28,91.94,92.34,"vasker~4b94c156b07f"],[29,33,92.34,92.73,"klær"]]},{"id":21,"start":93.65,"end":96.71,"text":"Etterpå slapper jeg av og ser på tv.","zh":"之后我放松一下，看看电视。","words":[[0,7,93.73,94.4,"etterpå"],[8,15,94.4,95.02,"slapper"],[16,19,95.02,95.26,"jeg"],[20,22,95.26,95.5,"av~6aef60c561bf"],[23,25,95.5,95.72,"og"],[26,29,95.72,95.98,"ser"],[30,32,95.98,96.16,"på~fab38a6838d6"],[33,35,96.16,96.63,"tv"]]},{"id":22,"start":97.9,"end":100.46,"text":"Klokka halv elleve pusser jeg tennene.","zh":"十点半我刷牙。","words":[[0,6,97.98,98.29,"klokka"],[7,11,98.29,98.55,"halv~c32acaf180bc"],[12,18,98.55,98.87,"elleve"],[19,25,98.87,99.73,"pusser~28d9fabfd0d3"],[26,29,99.73,99.73,"jeg"],[30,37,99.73,99.73,"tennene"]]},{"id":23,"start":101.9,"end":104.76,"text":"Jeg er trøtt om kvelden og legger meg tidlig.","zh":"我晚上很累，很早就上床睡觉。","words":[[0,3,101.98,102.09,"jeg"],[4,6,102.09,102.25,"er"],[7,12,102.25,102.69,"trøtt"],[13,15,102.69,102.83,"om~c13075d78f52"],[16,23,102.83,103.21,"kvelden"],[24,26,103.21,103.45,"og"],[27,33,103.45,104.01,"legger~621543baabad"],[34,37,104.01,104.17,"meg"],[38,44,104.17,104.68,"tidlig"]]}],"lexicon":{"4.2":{"lemma":"4.2","zh":"第 4.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"annenhver":{"lemma":"annenhver","zh":"每隔一个","pos":"限定词","ref":"4-024","clip":"pronunciation/4d88951ffa5fb057d4e7.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barne-tv":{"lemma":"barne-tv","zh":"儿童电视节目","pos":"名词","ref":"4-036","clip":"pronunciation/d91fc1f2071874ad60d4.mp3"},"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"bilmekaniker":{"lemma":"bilmekaniker","zh":"汽车修理工","pos":"名词","ref":"3-105","clip":"pronunciation/a7c48c34a4ca23023834.mp3"},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"bor":{"lemma":"bo","zh":"居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e3751847918c.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时","clip":"pronunciation/665ab7c0b1f21648dfe4.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke","form":"复数不定"}]},"dusjer":{"lemma":"dusje","zh":"淋浴","pos":"动词","ref":"4-026","form":"现在时","clip":null,"ambiguous":true,"candidates":[{"lemma":"dusje","zh":"淋浴","pos":"动词","ref":"4-026","form":"现在时"},{"lemma":"dusj","zh":"淋浴","pos":"名词","ref":"9-117","form":"复数不定"}]},"elleve":{"lemma":"elleve","zh":"数字 11","pos":"数词","ref":"basics:numbers:elleve","clip":"pronunciation/827005e1432c8163b1