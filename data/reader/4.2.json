{"id":"4.2","title":"Hjemme hos Bjørnar","audio":"audio/4.2.mp3","duration":109.07,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.54,"text":"4.2 Hjemme hos Bjørnar","heading":true,"zh":"4.2 在比约纳尔家","words":[[0,3,0.15,1.03,"4.2"],[4,10,1.91,2.57,"hjemme"],[11,14,2.57,2.79,"hos"],[15,22,2.79,3.46,"bjørnar"]]},{"id":1,"start":5.43,"end":11.96,"text":"Jeg heter Bjørnar, og jeg er pappa til Sofie på sju år og Markus på fire.","zh":"我叫比约纳尔，是七岁的苏菲和四岁的马库斯的爸爸。","words":[[0,3,5.49,5.78,"jeg"],[4,9,5.78,6.18,"heter"],[10,17,6.18,6.86,"bjørnar"],[19,21,7.04,7.16,"og"],[22,25,7.16,7.46,"jeg"],[26,28,7.46,7.72,"er"],[29,34,7.72,8.14,"pappa"],[35,38,8.14,8.5,"til~8de1a9181f86"],[39,44,8.5,9.16,"sofie"],[45,47,9.16,9.36,"på~f81b9c7a500b"],[48,51,9.36,9.7,"sju"],[52,54,9.7,10.12,"år"],[55,57,10.38,10.54,"og"],[58,64,10.54,11.32,"markus"],[65,67,11.32,11.46,"på~f81b9c7a500b"],[68,72,11.46,11.8,"fire"]]},{"id":2,"start":13.37,"end":17.43,"text":"Jeg er skilt, og barna bor hos meg annenhver uke.","zh":"我离婚了，孩子们每隔一周住在我这里。","words":[[0,3,13.43,13.74,"jeg"],[4,6,13.74,14.0,"er"],[7,12,14.0,14.62,"skilt~39bb7cd38da8"],[14,16,14.72,14.98,"og"],[17,22,14.98,15.4,"barna"],[23,26,15.4,15.62,"bor"],[27,30,15.62,15.84,"hos"],[31,34,15.84,16.25,"meg"],[35,44,16.38,16.94,"annenhver"],[45,48,16.94,17.29,"uke"]]},{"id":3,"start":18.93,"end":21.58,"text":"Jeg står opp kvart over seks om morgenen.","zh":"我早上六点一刻起床。","words":[[0,3,18.99,19.26,"jeg"],[4,8,19.26,19.6,"står~13cfed49d0de"],[9,12,19.6,19.92,"opp~4bb5dba4f351"],[13,18,19.92,20.32,"kvart"],[19,23,20.32,20.58,"over~fc4babce59ce"],[24,28,20.58,20.9,"seks"],[29,31,20.9,21.0,"om~5b93c55d689f"],[32,40,21.0,21.43,"morgenen"]]},{"id":4,"start":22.71,"end":24.2,"text":"Først dusjer jeg.","zh":"我先冲个澡。","words":[[0,5,22.77,23.28,"først"],[6,12,23.28,23.72,"dusjer~fc4b8b314d59"],[13,16,23.72,24.05,"jeg"]]},{"id":5,"start":24.77,"end":26.43,"text":"Så kler jeg på meg.","zh":"然后我穿好衣服。","words":[[0,2,24.82,25.23,"så~bfb333151d21"],[3,7,25.36,25.7,"kler"],[8,11,25.7,25.88,"jeg"],[12,14,25.88,26.06,"på~21aaa4d0f582"],[15,18,26.06,26.28,"meg"]]},{"id":6,"start":28.09,"end":30.75,"text":"Klokka halv sju vekker jeg barna.","zh":"六点半我叫醒孩子们。","words":[[0,6,28.15,28.64,"klokka"],[7,11,28.64,29.1,"halv~642706f0805b"],[12,15,29.1,29.45,"sju"],[16,22,29.66,30.06,"vekker"],[23,26,30.06,30.22,"jeg"],[27,32,30.22,30.6,"barna"]]},{"id":7,"start":31.86,"end":34.0,"text":"De vasker seg og kler på seg.","zh":"他们洗漱、穿衣服。","words":[[0,2,31.91,32.2,"de"],[3,9,32.2,32.64,"vasker~8c408dabdea1"],[10,13,32.64,33.0,"seg"],[14,16,33.0,33.12,"og"],[17,21,33.12,33.46,"kler"],[22,24,33.46,33.58,"på~21aaa4d0f582"],[25,28,33.58,33.85,"seg"]]},{"id":8,"start":34.8,"end":40.41,"text":"Etterpå spiser vi frokost sammen, og jeg lager matpakker til barna.","zh":"之后我们一起吃早餐，我给孩子们准备午餐便当。","words":[[0,7,34.86,35.59,"etterpå"],[8,14,35.74,36.16,"spiser"],[15,17,36.16,36.34,"vi"],[18,25,36.34,37.02,"frokost"],[26,32,37.02,37.52,"sammen"],[34,36,38.0,38.14,"og"],[37,40,38.14,38.62,"jeg"],[41,46,38.62,38.98,"lager~2ce37095d0c8"],[47,56,38.98,39.72,"matpakker"],[57,60,39.72,39.88,"til"],[61,66,39.88,40.27,"barna"]]},{"id":9,"start":41.47,"end":44.7,"text":"Jeg drikker kaffe, og barna drikker melk.","zh":"我喝咖啡，孩子们喝牛奶。","words":[[0,3,41.53,41.86,"jeg"],[4,11,41.86,42.18,"drikker~8bc6fe28e25c"],[12,17,42.18,42.67,"kaffe"],[19,21,43.12,43.3,"og"],[22,27,43.3,43.8,"barna"],[28,35,43.8,44.14,"drikker~8bc6fe28e25c"],[36,40,44.14,44.55,"melk"]]},{"id":10,"start":45.97,"end":48.68,"text":"Jeg liker å ha god tid om morgenen.","zh":"我喜欢早上时间充裕一些。","words":[[0,3,46.03,46.36,"jeg"],[4,9,46.36,46.78,"liker"],[10,11,46.78,46.9,"å~0583da7a620a"],[12,14,46.9,47.18,"ha~ca5edb8b1cdb"],[15,18,47.18,47.62,"god~3bf5a9c975f3"],[19,22,47.62,47.96,"tid"],[23,25,47.96,48.08,"om~5b93c55d689f"],[26,34,48.08,48.53,"morgenen"]]},{"id":11,"start":50.02,"end":55.35,"text":"Klokka kvart på åtte leverer jeg barna på skolen og i barnehagen.","zh":"七点四十五分我把孩子们送到学校和幼儿园。","words":[[0,6,50.08,50.5,"klokka"],[7,12,50.5,50.86,"kvart"],[13,15,50.86,51.0,"på~2554220f753c"],[16,20,51.0,51.52,"åtte"],[21,28,51.8,52.28,"leverer"],[29,32,52.28,52.48,"jeg"],[33,38,52.48,52.9,"barna"],[39,41,52.9,53.04,"på"],[42,48,53.04,53.67,"skolen"],[49,51,53.96,54.16,"og"],[52,53,54.16,54.3,"i"],[54,64,54.3,55.2,"barnehagen"]]},{"id":12,"start":56.93,"end":60.57,"text":"Fra klokka åtte til halv fire er jeg på jobb.","zh":"从八点到三点半我在上班。","words":[[0,3,56.99,57.28,"fra"],[4,10,57.28,57.68,"klokka"],[11,15,57.68,58.26,"åtte"],[16,19,58.36,58.58,"til"],[20,24,58.58,58.9,"halv~afaec9028f69"],[25,29,58.9,59.38,"fire"],[30,32,59.5,59.7,"er"],[33,36,59.7,59.9,"jeg"],[37,39,59.9,60.08,"på"],[40,44,60.08,60.42,"jobb"]]},{"id":13,"start":61.09,"end":63.23,"text":"Jeg er bilmekaniker.","zh":"我是汽车修理工。","words":[[0,3,61.16,61.58,"jeg"],[4,6,61.58,61.96,"er"],[7,19,61.96,63.09,"bilmekaniker"]]},{"id":14,"start":64.76,"end":68.09,"text":"Etter jobb henter jeg barna, og vi kjører hjem.","zh":"下班后我去接孩子们，然后我们开车回家。","words":[[0,5,64.82,65.18,"etter"],[6,10,65.18,65.66,"jobb"],[11,17,65.66,66.04,"henter"],[18,21,66.04,66.2,"jeg"],[22,27,66.2,66.72,"barna"],[29,31,66.98,67.1,"og"],[32,34,67.1,67.28,"vi"],[35,41,67.28,67.64,"kjører"],[42,46,67.64,67.94,"hjem~3f5fbf6a493e"]]},{"id":15,"start":69.24,"end":71.46,"text":"Vi spiser middag klokka fem.","zh":"我们五点吃晚饭。","words":[[0,2,69.3,69.52,"vi"],[3,9,69.52,69.96,"spiser"],[10,16,69.96,70.68,"middag"],[17,23,70.68,71.02,"klokka"],[24,27,71.02,71.31,"fem"]]},{"id":16,"start":72.55,"end":76.96,"text":"Sofie gjør lekser etter middag, og jeg hjelper henne.","zh":"苏菲晚饭后做作业，我帮她。","words":[[0,5,72.61,73.44,"sofie"],[6,10,73.44,73.68,"gjør"],[11,17,73.68,74.42,"lekser"],[18,23,74.42,74.74,"etter"],[24,30,74.74,75.3,"middag"],[32,34,75.62,75.76,"og"],[35,38,75.76,76.16,"jeg"],[39,46,76.16,76.52,"hjelper"],[47,52,76.52,76.81,"henne"]]},{"id":17,"start":78.39,"end":81.63,"text":"Klokka seks ser vi på barne-tv sammen.","zh":"六点我们一起看儿童电视节目。","words":[[0,6,78.45,78.8,"klokka"],[7,11,78.8,79.4,"seks"],[12,15,79.58,79.82,"ser"],[16,18,79.82,80.0,"vi"],[19,21,80.0,80.26,"på~fab38a6838d6"],[22,30,80.26,81.08,"barne-tv"],[31,37,81.08,81.48,"sammen"]]},{"id":18,"start":82.23,"end":83.99,"text":"Vi liker å kose oss.","zh":"我们喜欢一起享受温馨时光。","words":[[0,2,82.3,82.5,"vi"],[3,8,82.5,82.94,"liker"],[9,10,82.94,83.1,"å~0583da7a620a"],[11,15,83.1,83.54,"kose"],[16,19,83.54,83.84,"oss"]]},{"id":19,"start":85.71,"end":88.91,"text":"Barna legger seg klokka halv åtte om kvelden.","zh":"孩子们晚上七点半上床睡觉。","words":[[0,5,85.77,86.46,"barna"],[6,12,86.46,86.8,"legger~621543baabad"],[13,16,86.8,87.04,"seg"],[17,23,87.04,87.4,"klokka"],[24,28,87.4,87.72,"halv~e5cf85157fed"],[29,33,87.72,88.14,"åtte"],[34,36,88.14,88.3,"om~c13075d78f52"],[37,44,88.3,88.76,"kvelden"]]},{"id":20,"start":90.31,"end":92.87,"text":"Så rydder jeg litt og vasker klær.","zh":"然后我收拾一下，洗洗衣服。","words":[[0,2,90.38,90.78,"så~bfb333151d21"],[3,9,90.94,91.3,"rydder"],[10,13,91.3,91.48,"jeg"],[14,18,91.48,91.8,"litt~54360be2a478"],[19,21,91.8,92.04,"og"],[22,28,92.04,92.4,"vasker~4b94c156b07f"],[29,33,92.4,92.72,"klær"]]},{"id":21,"start":93.69,"end":96.78,"text":"Etterpå slapper jeg av og ser på tv.","zh":"之后我放松一下，看看电视。","words":[[0,7,93.75,94.5,"etterpå"],[8,15,94.66,95.14,"slapper"],[16,19,95.14,95.34,"jeg"],[20,22,95.34,95.6,"av~6aef60c561bf"],[23,25,95.6,95.8,"og"],[26,29,95.8,96.08,"ser"],[30,32,96.08,96.22,"på~fab38a6838d6"],[33,35,96.22,96.62,"tv"]]},{"id":22,"start":97.95,"end":100.55,"text":"Klokka halv elleve pusser jeg tennene.","zh":"十点半我刷牙。","words":[[0,6,98.02,98.36,"klokka"],[7,11,98.36,98.6,"halv~c32acaf180bc"],[12,18,98.6,99.06,"elleve"],[19,25,99.42,99.74,"pusser~28d9fabfd0d3"],[26,29,99.74,99.88,"jeg"],[30,37,99.88,100.4,"tennene"]]},{"id":23,"start":101.94,"end":104.82,"text":"Jeg er trøtt om kvelden og legger meg tidlig.","zh":"我晚上很累，很早就上床睡觉。","words":[[0,3,102.0,102.2,"jeg"],[4,6,102.2,102.36,"er"],[7,12,102.36,102.76,"trøtt"],[13,15,102.76,102.88,"om~c13075d78f52"],[16,23,102.88,103.32,"kvelden"],[24,26,103.32,103.6,"og"],[27,33,103.7,104.08,"legger~621543baabad"],[34,37,104.08,104.26,"meg"],[38,44,104.26,104.67,"tidlig"]]}],"lexicon":{"4.2":{"lemma":"4.2","zh":"第 4.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"annenhver":{"lemma":"annenhver","zh":"每隔一个","pos":"限定词","ref":"4-024","clip":"pronunciation/4d88951ffa5fb057d4e7.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barne-tv":{"lemma":"barne-tv","zh":"儿童电视节目","pos":"名词","ref":"4-036","clip":"pronunciation/d91fc1f2071874ad60d4.mp3"},"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"bilmekaniker":{"lemma":"bilmekaniker","zh":"汽车修理工","pos":"名词","ref":"3-105","clip":"pronunciation/a7c48c34a4ca23023834.mp3"},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e3751847918c.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时","clip":"pronunciation/665ab7c0b1f21648dfe4.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke","form":"复数不定"}]},"dusjer":{"lemma":"dusje","zh":"冲澡；淋浴","pos":"动词","ref":"4-026","form":"现在时","clip":null,"ambiguous":true,"candidates":[{"lemma":"dusje","zh":"冲澡；淋浴","pos":"动词","ref":"4-026","form":"现在时"},{"lemma":"dusj","zh":"淋浴","pos":"名词","ref":"9-117","form":"复数不定"}]},"elleve":{"lemma":"elleve","zh":"数字 11","pos":"数词","ref":"basics:numbers:elleve","clip":"pronunciation/827005e1432c8163b1dc.mp3"},"er":{"lemma":"være","zh":"是