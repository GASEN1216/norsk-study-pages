{"id":"ty-conversation-8.2","bookId":"ty-conversation-guide","readingId":"8.2","title":"Meeting the children","audio":"audio/ty-conversation/8.2.mp3","duration":52.453878,"synthetic":false,"sentences":[{"id":0,"start":16.39,"end":18.755,"speaker":"Olav","text":"Hei Sverre! Jeg heter Olav.","zh":"你好，斯韦雷！我叫奥拉夫。","words":[[0,3,16.39,16.615,"hei"],[4,10,16.69,17.055,"sverre"],[12,15,17.73,17.932,"jeg"],[16,21,17.932,18.235,"heter"],[22,26,18.31,18.755,"olav"]]},{"id":1,"start":19.35,"end":19.555,"speaker":"Sverre","text":"Hei.","zh":"你好。","words":[[0,3,19.35,19.555,"hei"]]},{"id":2,"start":20.41,"end":21.495,"speaker":"Olav","text":"Har du ferie nå?","zh":"你现在放假了吗？","words":[[0,3,20.41,20.672,"har@ty-have-holiday"],[4,6,20.672,20.815,"du"],[7,12,20.91,21.352,"ferie"],[13,15,21.352,21.495,"nå"]]},{"id":3,"start":22.35,"end":22.495,"speaker":"Sverre","text":"Ja.","zh":"是的。","words":[[0,2,22.35,22.495,"ja"]]},{"id":4,"start":23.63,"end":24.615,"speaker":"Olav","text":"Liker du skolen?","zh":"你喜欢上学吗？","words":[[0,5,23.63,24.053,"liker"],[6,8,24.053,24.155,"du"],[9,15,24.19,24.615,"skolen"]]},{"id":5,"start":25.11,"end":27.435,"speaker":"Sverre","text":"Nei. Skolen er kjedelig.","zh":"不喜欢。上学很无聊。","words":[[0,3,25.11,25.355,"nei"],[5,11,26.05,26.515,"skolen"],[12,14,26.63,26.795,"er@ty-be-description"],[15,23,26.89,27.435,"kjedelig"]]},{"id":6,"start":28.25,"end":29.575,"speaker":"Olav","text":"Hva er du interessert i?","zh":"你对什么感兴趣？","words":[[0,3,28.25,28.435,"hva"],[4,6,28.45,28.602,"er@ty-be-state"],[7,9,28.602,28.735,"du"],[10,21,28.77,29.473,"interessert"],[22,23,29.473,29.575,"i@ty-interest-in"]]},{"id":7,"start":30.47,"end":31.055,"speaker":"Sverre","text":"Ingenting.","zh":"什么都不感兴趣。","words":[[0,9,30.47,31.055,"ingenting"]]},{"id":8,"start":31.93,"end":33.155,"speaker":"Olav","text":"Liker du ikke sport?","zh":"你不喜欢运动吗？","words":[[0,5,31.93,32.312,"liker"],[6,8,32.312,32.403,"du"],[9,13,32.403,32.655,"ikke"],[14,19,32.67,33.155,"sport"]]},{"id":9,"start":33.59,"end":33.855,"speaker":"Sverre","text":"Nei.","zh":"不喜欢。","words":[[0,3,33.59,33.855,"nei"]]},{"id":10,"start":34.57,"end":35.595,"speaker":"Olav","text":"Har du mange venner?","zh":"你的朋友多吗？","words":[[0,3,34.57,34.733,"har@ty-have-family-friends"],[4,6,34.733,34.835,"du"],[7,12,34.85,35.175,"mange"],[13,19,35.19,35.595,"venner"]]},{"id":11,"start":36.33,"end":36.595,"speaker":"Sverre","text":"Nei.","zh":"不多。","words":[[0,3,36.33,36.595,"nei"]]},{"id":12,"start":37.47,"end":38.215,"speaker":"Olav","text":"Hva med TV?","zh":"那看电视呢？","words":[[0,3,37.47,37.635,"hva"],[4,7,37.69,37.855,"med@ty-med-topic"],[8,10,37.87,38.215,"tv"]]},{"id":13,"start":38.81,"end":39.915,"speaker":"Sverre","text":"Jeg ser på TV.","zh":"我看电视。","words":[[0,3,38.81,38.995,"jeg"],[4,7,39.05,39.335,"ser@ty-watch-tv"],[8,10,39.37,39.495,"på@ty-on-watch-object"],[11,13,39.53,39.915,"tv"]]},{"id":14,"start":40.71,"end":41.695,"speaker":"Olav","text":"Hva liker du å se?","zh":"你喜欢看什么？","words":[[0,3,40.71,40.895,"hva"],[4,9,40.99,41.312,"liker"],[10,12,41.312,41.415,"du"],[13,14,41.43,41.532,"å"],[15,17,41.532,41.695,"se@ty-watch-program"]]},{"id":15,"start":42.71,"end":43.555,"speaker":"Sverre","text":"Såpeoperaer.","zh":"肥皂剧。","words":[[0,11,42.71,43.555,"såpeoperaer"]]},{"id":16,"start":44.43,"end":46.215,"speaker":"Olav","text":"Du har en søt liten søster.","zh":"你有个可爱的妹妹。","words":[[0,2,44.43,44.562,"du"],[3,6,44.562,44.733,"har@ty-have-family-friends"],[7,9,44.733,44.875,"en"],[10,13,44.95,45.392,"søt"],[14,19,45.392,45.752,"liten"],[20,26,45.752,46.215,"søster"]]},{"id":17,"start":47.07,"end":49.635,"speaker":"Sverre","text":"Jeg liker henne ikke. Hun er dum.","zh":"我不喜欢她。她很笨。","words":[[0,3,47.07,47.255,"jeg"],[4,9,47.29,47.752,"liker"],[10,15,47.752,48.032,"henne"],[16,20,48.032,48.315,"ikke"],[22,25,48.95,49.133,"hun"],[26,28,49.133,49.275,"er@ty-be-description"],[29,32,49.41,49.635,"dum"]]}],"lexicon":{"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格