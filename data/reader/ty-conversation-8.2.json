{"id":"ty-conversation-8.2","bookId":"ty-conversation-guide","readingId":"8.2","title":"Meeting the children","audio":"audio/ty-conversation/8.2.mp3","duration":52.453878,"synthetic":false,"sentences":[{"id":0,"start":15.88,"end":18.76,"speaker":"Olav","text":"Hei Sverre! Jeg heter Olav.","zh":"你好，斯韦雷！我叫奥拉夫。","words":[[0,3,15.88,16.64,"hei"],[4,10,16.76,17.08,"sverre"],[12,15,17.6,17.92,"jeg"],[16,21,17.92,18.2,"heter"],[22,26,18.2,18.76,"olav"]]},{"id":1,"start":19.34,"end":19.62,"speaker":"Sverre","text":"Hei.","zh":"你好。","words":[[0,3,19.34,19.62,"hei"]]},{"id":2,"start":20.3,"end":21.52,"speaker":"Olav","text":"Har du ferie nå?","zh":"你现在放假了吗？","words":[[0,3,20.3,20.66,"har@ty-have-holiday"],[4,6,20.66,20.84,"du"],[7,12,20.84,21.32,"ferie"],[13,15,21.32,21.52,"nå"]]},{"id":3,"start":22.18,"end":22.54,"speaker":"Sverre","text":"Ja.","zh":"是的。","words":[[0,2,22.18,22.54,"ja"]]},{"id":4,"start":23.46,"end":24.5,"speaker":"Olav","text":"Liker du skolen?","zh":"你喜欢上学吗？","words":[[0,5,23.46,24.0,"liker"],[6,8,24.0,24.16,"du"],[9,15,24.16,24.5,"skolen"]]},{"id":5,"start":25.06,"end":27.44,"speaker":"Sverre","text":"Nei. Skolen er kjedelig.","zh":"不喜欢。上学很无聊。","words":[[0,3,25.06,25.38,"nei"],[5,11,25.98,26.52,"skolen"],[12,14,26.52,26.78,"er@ty-be-description"],[15,23,26.78,27.44,"kjedelig"]]},{"id":6,"start":28.04,"end":29.6,"speaker":"Olav","text":"Hva er du interessert i?","zh":"你对什么感兴趣？","words":[[0,3,28.04,28.5,"hva"],[4,6,28.5,28.62,"er@ty-be-state"],[7,9,28.62,28.74,"du"],[10,21,28.74,29.38,"interessert"],[22,23,29.38,29.6,"i@ty-interest-in"]]},{"id":7,"start":30.26,"end":31.02,"speaker":"Sverre","text":"Ingenting.","zh":"什么都不感兴趣。","words":[[0,9,30.26,31.02,"ingenting"]]},{"id":8,"start":31.78,"end":32.92,"speaker":"Olav","text":"Liker du ikke sport?","zh":"你不喜欢运动吗？","words":[[0,5,31.78,32.26,"liker"],[6,8,32.26,32.4,"du"],[9,13,32.4,32.6,"ikke"],[14,19,32.6,32.92,"sport"]]},{"id":9,"start":33.48,"end":33.88,"speaker":"Sverre","text":"Nei.","zh":"不喜欢。","words":[[0,3,33.48,33.88,"nei"]]},{"id":10,"start":34.44,"end":35.54,"speaker":"Olav","text":"Har du mange venner?","zh":"你的朋友多吗？","words":[[0,3,34.44,34.72,"har@ty-have-family-friends"],[4,6,34.72,34.84,"du"],[7,12,34.84,35.06,"mange"],[13,19,35.06,35.54,"venner"]]},{"id":11,"start":36.24,"end":36.64,"speaker":"Sverre","text":"Nei.","zh":"不多。","words":[[0,3,36.24,36.64,"nei"]]},{"id":12,"start":37.34,"end":38.18,"speaker":"Olav","text":"Hva med TV?","zh":"那看电视呢？","words":[[0,3,37.34,37.66,"hva"],[4,7,37.66,37.8,"med@ty-med-topic"],[8,10,37.8,38.18,"tv"]]},{"id":13,"start":38.7,"end":39.88,"speaker":"Sverre","text":"Jeg ser på TV.","zh":"我看电视。","words":[[0,3,38.7,38.98,"jeg"],[4,7,38.98,39.28,"ser@ty-watch-tv"],[8,10,39.28,39.5,"på@ty-on-watch-object"],[11,13,39.5,39.88,"tv"]]},{"id":14,"start":40.48,"end":41.72,"speaker":"Olav","text":"Hva liker du å se?","zh":"你喜欢看什么？","words":[[0,3,40.48,40.94,"hva"],[4,9,40.94,41.3,"liker"],[10,12,41.3,41.42,"du"],[13,14,41.42,41.54,"å"],[15,17,41.54,41.72,"se@ty-watch-program"]]},{"id":15,"start":42.84,"end":43.6,"speaker":"Sverre","text":"Såpeoperaer.","zh":"肥皂剧。","words":[[0,11,42.84,43.6,"såpeoperaer"]]},{"id":16,"start":43.6,"end":46.2,"speaker":"Olav","text":"Du har en søt liten søster.","zh":"你有个可爱的妹妹。","words":[[0,2,43.6,44.56,"du"],[3,6,44.56,44.68,"har@ty-have-family-friends"],[7,9,44.68,44.86,"en"],[10,13,44.86,45.38,"søt"],[14,19,45.42,45.68,"liten"],[20,26,45.68,46.2,"søster"]]},{"id":17,"start":46.92,"end":49.64,"speaker":"Sverre","text":"Jeg liker henne ikke. Hun er dum.","zh":"我不喜欢她。她很笨。","words":[[0,3,46.92,47.22,"jeg"],[4,9,47.22,47.76,"liker"],[10,15,47.76,47.98,"henne"],[16,20,47.98,48.28,"ikke"],[22,25,48.86,49.1,"hun"],[26,28,49.1,49.26,"er@ty-be-description"],[29,32,49.26,49.64,"dum"]]}],"lexicon":{"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"dum":{"lemma":"dum","zh":"笨的","pos":"形容词","ref":"ty-conversation-8-004","clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","po