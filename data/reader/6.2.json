{"id":"6.2","title":"Hva gjorde du i helga?","audio":"audio/6.2.mp3","duration":156.31,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.55,"text":"6.2 Hva gjorde du i helga?","heading":true,"zh":"6.2 你周末做了什么？","words":[[0,3,0.15,1.26,"6.2"],[4,7,2.37,3.15,"hva"],[8,14,3.15,3.65,"gjorde"],[15,17,3.65,3.85,"du"],[18,19,3.85,4.01,"i~16f1f6aa6ab5"],[20,25,4.01,4.47,"helga"]]},{"id":1,"start":6.37,"end":9.84,"text":"Det er mandag, og Bjørnar er på jobben.","zh":"今天是星期一，比约纳尔在上班。","words":[[0,3,6.45,6.57,"det"],[4,6,6.57,6.73,"er"],[7,13,6.73,7.33,"mandag"],[15,17,7.57,8.09,"og"],[18,25,8.09,8.59,"bjørnar"],[26,28,8.59,9.05,"er"],[29,31,9.05,9.25,"på"],[32,38,9.25,9.76,"jobben"]]},{"id":2,"start":10.98,"end":12.84,"text":"Han snakker med en kollega.","zh":"他在和一位同事聊天。","words":[[0,3,11.06,11.36,"han"],[4,11,11.36,11.84,"snakker"],[12,15,11.84,12.0,"med"],[16,18,12.0,12.16,"en~a939a9e56dc5"],[19,26,12.16,12.76,"kollega"]]},{"id":3,"start":13.97,"end":16.26,"text":"Kollegaen heter Øystein.","zh":"这位同事叫奥于斯坦。","words":[[0,9,14.05,14.86,"kollegaen"],[10,15,14.86,15.38,"heter"],[16,23,15.38,16.18,"øystein"]]},{"id":4,"start":18.0,"end":21.74,"text":"God morgen, Bjørnar. Hvordan var helga?","speaker":"Øystein","zh":"早上好，比约纳尔。周末过得怎么样？","words":[[0,3,18.08,18.32,"god"],[4,10,18.32,18.64,"morgen"],[12,19,18.9,19.28,"bjørnar"],[21,28,20.28,20.82,"hvordan"],[29,32,20.82,21.06,"var"],[33,38,21.06,21.66,"helga"]]},{"id":5,"start":23.07,"end":27.96,"text":"Den var fin. Barna var hos meg, og vi hadde det veldig hyggelig.","speaker":"Bjørnar","zh":"挺好的。孩子们在我这儿，我们过得很愉快。","words":[[0,3,23.15,23.34,"den"],[4,7,23.34,23.5,"var"],[8,11,23.5,23.74,"fin"],[13,18,24.48,25.06,"barna"],[19,22,25.06,25.22,"var"],[23,26,25.22,25.4,"hos"],[27,30,25.4,25.64,"meg"],[32,34,26.02,26.3,"og"],[35,37,26.3,26.44,"vi"],[38,43,26.44,26.66,"hadde~efc0cfad6408"],[44,47,26.66,26.86,"det"],[48,54,26.86,27.38,"veldig"],[55,63,27.38,27.88,"hyggelig"]]},{"id":6,"start":28.98,"end":30.24,"text":"Hva gjorde dere?","speaker":"Øystein","zh":"你们做了什么？","words":[[0,3,29.06,29.39,"hva"],[4,10,29.39,29.79,"gjorde"],[11,15,29.79,30.16,"dere"]]},{"id":7,"start":31.24,"end":51.21,"text":"På fredag laget vi taco. Vi så en tegnefilm på tv og spiste potetgull. På lørdag var vi i svømmehallen. Etterpå spiste vi grøt. Om ettermiddagen besøkte vi noen venner. Du da, Øystein?","speaker":"Bjørnar","zh":"星期五我们做了墨西哥卷饼。我们在电视上看了一部动画片，还吃了薯片。星期六我们去了游泳馆。之后我们吃了粥。下午我们去拜访了几个朋友。你呢，奥于斯坦？","words":[[0,2,31.32,31.45,"på~80f98df994af"],[3,9,31.45,31.95,"fredag"],[10,15,31.95,32.47,"laget~8790a82fb4ba"],[16,18,32.47,32.61,"vi"],[19,23,32.61,33.11,"taco"],[25,27,34.03,34.43,"vi"],[28,30,34.43,34.59,"så~e945ddab6ef4"],[31,33,34.59,34.75,"en~a939a9e56dc5"],[34,43,34.75,35.49,"tegnefilm"],[44,46,35.49,35.75,"på"],[47,49,35.75,36.09,"tv"],[50,52,36.09,36.51,"og"],[53,59,36.51,36.93,"spiste"],[60,69,36.93,37.63,"potetgull"],[71,73,38.88,39.16,"på~a7f6cbc869c8"],[74,80,39.16,39.68,"lørdag"],[81,84,39.68,40.12,"var"],[85,87,40.12,40.34,"vi"],[88,89,40.34,40.56,"i"],[90,102,40.56,41.2,"svømmehallen"],[104,111,42.18,42.94,"etterpå"],[112,118,42.94,43.7,"spiste"],[119,121,43.7,43.86,"vi"],[122,126,43.86,44.38,"grøt"],[128,130,45.78,46.02,"om~17a2982960f3"],[131,144,46.02,47.06,"ettermiddagen"],[145,152,47.06,47.96,"besøkte"],[153,155,47.96,48.12,"vi"],[156,160,48.12,48.28,"noen~c766e2ef794d"],[161,167,48.28,48.62,"venner"],[169,171,50.11,50.37,"du"],[172,174,50.37,50.55,"da~db5a09a6733b"],[176,183,50.55,51.13,"øystein"]]},{"id":8,"start":51.96,"end":53.3,"text":"Hadde du ei fin helg?","speaker":"Bjørnar","zh":"你周末过得好吗？","words":[[0,5,52.04,52.25,"hadde"],[6,8,52.25,52.51,"du"],[9,11,52.51,52.69,"ei~47aa2d18e376"],[12,15,52.69,52.89,"fin"],[16,20,52.89,53.22,"helg"]]},{"id":9,"start":54.29,"end":65.56,"text":"Ja, veldig. Jeg var sammen med venner på lørdag. Vi var på en pub og tok noen øl. Hva gjorde dere på søndag?","speaker":"Øystein","zh":"好，非常好。星期六我和朋友们在一起。我们去了一家酒吧，喝了几杯啤酒。你们星期天做了什么？","words":[[0,2,54.37,54.66,"ja"],[4,10,55.04,55.54,"veldig"],[12,15,56.42,56.78,"jeg"],[16,19,56.78,57.08,"var"],[20,26,57.08,57.54,"sammen"],[27,30,57.54,57.7,"med"],[31,37,57.7,58.16,"venner"],[38,40,58.16,58.38,"på~a7f6cbc869c8"],[41,47,58.38,58.84,"lørdag"],[49,51,59.39,59.97,"vi"],[52,55,59.97,60.27,"var"],[56,58,60.27,60.53,"på"],[59,61,60.53,60.71,"en~a939a9e56dc5"],[62,65,60.71,60.95,"pub"],[66,68,60.95,61.47,"og"],[69,72,61.47,61.71,"tok"],[73,77,61.71,62.09,"noen~c766e2ef794d"],[78,80,62.09,62.37,"øl"],[82,85,63.48,63.82,"hva"],[86,92,63.82,64.08,"gjorde"],[93,97,64.08,64.36,"dere"],[98,100,64.36,64.8,"på~0b13a9143ed6"],[101,107,64.8,65.48,"søndag"]]},{"id":10,"start":66.82,"end":79.18,"text":"På søndag kjørte vi slalåm. Barna fikk slalåmski for et år siden, og de elsker å kjøre slalåm. Etterpå var vi på kino.","speaker":"Bjørnar","zh":"星期天我们去滑了高山滑雪。孩子们一年前得到了高山滑雪板，他们特别喜欢滑高山滑雪。之后我们去看了电影。","words":[[0,2,66.9,67.03,"på~0b13a9143ed6"],[3,9,67.03,67.57,"søndag"],[10,16,67.57,67.95,"kjørte"],[17,19,67.95,68.09,"vi"],[20,26,68.09,68.71,"slalåm"],[28,33,70.16,70.68,"barna"],[34,38,70.68,70.94,"fikk"],[39,48,70.94,71.84,"slalåmski"],[49,52,71.84,72.06,"for~d0291af9704a"],[53,55,72.06,72.32,"et~054dde72f37b"],[56,58,72.32,72.54,"år"],[59,64,72.54,72.8,"siden~9a3d2d89a980"],[66,68,72.98,73.84,"og"],[69,71,73.84,74.04,"de"],[72,78,74.04,74.72,"elsker"],[79,80,74.72,74.88,"å~0583da7a620a"],[81,86,74.88,75.12,"kjøre"],[87,93,75.12,75.74,"slalåm"],[95,102,76.73,77.53,"etterpå"],[103,106,77.53,78.21,"var"],[107,109,78.21,78.39,"vi"],[110,112,78.39,78.57,"på"],[113,117,78.57,79.1,"kino"]]},{"id":11,"start":80.34,"end":88.09,"text":"Du er veldig aktiv. På søndag slappet jeg bare av og så en fotballkamp på tv.","speaker":"Øystein","zh":"你真活跃。星期天我就只是放松了一下，在电视上看了一场足球赛。","words":[[0,2,80.42,80.74,"du"],[3,5,80.74,81.04,"er"],[6,12,81.04,81.56,"veldig"],[13,18,81.56,81.96,"aktiv"],[20,22,83.11,83.39,"på~0b13a9143ed6"],[23,29,83.39,83.93,"søndag"],[30,37,83.93,84.43,"slappet"],[38,41,84.43,84.53,"jeg"],[42,46,84.53,84.77,"bare"],[47,49,84.77,85.03,"av~6aef60c561bf"],[50,52,85.63,85.67,"og"],[53,55,85.67,85.85,"så~e945ddab6ef4"],[56,58,85.85,86.05,"en~a939a9e56dc5"],[59,70,86.05,86.87,"fotballkamp"],[71,73,86.87,87.41,"på"],[74,76,87.41,88.01,"tv"]]},{"id":12,"start":89.01,"end":100.88,"text":"Vi tok det med ro på søndag kveld. Mamma inviterte oss på middag. Hun liker å være sammen med barnebarna, og de er veldig glad i henne.","speaker":"Bjørnar","zh":"星期天晚上我们过得很悠闲。我妈妈请我们吃晚饭。她喜欢和孙辈们在一起，孩子们也很爱她。","words":[[0,2,89.09,89.29,"vi"],[3,6,89.29,89.49,"tok~2c6e2d59a981"],[7,10,89.49,89.69,"det"],[11,14,89.69,89.83,"med~a153bb99781d"],[15,17,89.83,90.15,"ro~62058ae5a974"],[18,20,90.15,90.37,"på~82685e8edbed"],[21,27,90.37,90.77,"søndag"],[28,33,90.77,91.07,"kveld"],[35,40,92.06,92.92,"mamma"],[41,50,92.92,93.54,"inviterte"],[51,54,93.54,93.68,"oss"],[55,57,93.68,93.84,"på~db4686b84afd"],[58,64,93.84,94.22,"middag"],[66,69,95.73,95.95,"hun"],[70,75,95.95,96.53,"liker"],[76,77,96.53,96.67,"å~0583da7a620a"],[78,82,96.67,96.85,"være"],[83,89,96.85,97.35,"sammen"],[90,93,97.35,97.47,"med"],[94,104,97.47,97.87,"barnebarna"],[106,108,97.87,98.43,"og"],[109,111,98.43,99.13,"de"],[112,114,99.13,99.39,"er"],[115,121,99.39,99.91,"veldig"],[122,126,99.91,100.13,"glad~b5ec8d5b115a"],[127,128,100.13,100.31,"i~61214259ab5f"],[129,134,100.31,100.8,"henne"]]},{"id":13,"start":101.92,"end":103.41,"text":"Bor hun alene?","speaker":"Øystein","zh":"她一个人住吗？","words":[[0,3,102.0,102.34,"bor"],[4,7,102.34,102.58,"hun"],[8,13,102.58,103.33,"alene"]]},{"id":14,"start":104.01,"end":107.16,"text":"Ja. Pappa døde for mange år siden.","speaker":"Bjørnar","zh":"是的。我爸爸很多年前就去世了。","words":[[0,2,104.09,104.3,"ja"],[4,9,105.24,105.58,"pappa"],[10,14,105.58,106.06,"døde~7c26078a3b47"],[15,18,106.06,106.26,"for~d0291af9704a"],[19,24,106.26,106.5,"mange"],[25,27,106.5,106.7,"år"],[28,33,106.7,107.08,"siden~9a3d2d89a980"]]},{"id":15,"start":108.49,"end":112.13,"text":"Da er hun sikkert glad for å få besøk av dere.","speaker":"Øystein","zh":"那你们去看她，她一定很高兴。","words":[[0,2,108.57,108.92,"da~4f486b190f4c"],[3,5,108.92,109.2,"er"],[6,9,109.2,109.38,"hun"],[10,17,109.38,109.98,"sikkert~319975cb0cd0"],[18,22,109.98,110.24,"glad"],[23,26,110.24,110.66,"for~f47d487af782"],[27,28,110.66,110.78,"å~0583da7a620a"],[29,31,110.78,110.92,"få~65b84e08cd43"],[32,37,110.92,111.46,"besøk"],[38,40,111.46,111.6,"av~563221794fae"],[41,45,111.6,112.05,"dere"]]},{"id":16,"start":113.19,"end":118.78,"text":"Ja, vi besøker henne hver uke, og hun inviterer oss ofte på middag.","speaker":"Bjørnar","zh":"是的，我们每周都去看她，她也经常请我们吃晚饭。","words":[[0,2,113.27,113.54,"ja"],[4,6,114.0,114.1,"vi"],[7,14,114.1,114.64,"besøker"],[15,20,114.64,114.82,"henne"],[21,25,114.82,115.12,"hver"],[26,29,115.12,115.48,"uke"],[31,33,115.82,116.42,"og"],[34,37,116.42,116.66,"hun"],[38,47,116.66,117.32,"inviterer"],[48,51,117.32,117.56,"oss"],[52,56,117.56,118.08,"ofte"],[57,59,118.08,118.26,"på~db4686b84afd"],[60,66,118.26,118.7,"middag"]]},{"id":17,"start":122.15,"end":123.34,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,122.23,123.26,"sammendrag"]]},{"id":18,"start":124.61,"end":129.18,"text":"Bjørnar hadde barna i helga, og de gjorde mange ting.","zh":"周末孩子们在比约纳尔那儿，他们做了很多事情。","words":[[0,7,124.69,125.17,"bjørnar"],[8,13,125.17,125.71,"hadde~96f4fc62b62e"],[14,19,125.71,126.13,"barna"],[20,21,126.13,126.27,"i~16f1f6aa6ab5"],[22,27,126.27,126.55,"helga"],[29,31,127.23,127.73,"og"],[32,34,127.73,127.91,"de"],[35,41,127.91,128.21,"gjorde"],[42,47,128.21,128.63,"mange"],[48,52,128.63,129.1,"ting"]]},{"id":19,"start":130.25,"end":134.08,"text":"De spiste taco og så en tegnefilm på fredag.","zh":"星期五他们吃了墨西哥卷饼，看了一部动画片。","words":[[0,2,130.33,130.52,"de"],[3,9,130.52,130.98,"spiste"],[10,14,130.98,131.58,"taco"],[15,17,131.58,132.32,"og"],[18,20,132.32,132.48,"så~e945ddab6ef4"],[21,23,132.48,132.7,"en~a939a9e56dc5"],[24,33,132.7,133.3,"tegnefilm"],[34,36,133.3,133.5,"på~80f98df994af"],[37,43,133.5,134.0,"fredag"]]},{"id":20,"start":135.31,"end":140.46,"text":"På lørdag var de i svømmehallen, og etterpå spiste de grøt.","zh":"星期六他们去了游泳馆，之后吃了粥。","words":[[0,2,135.39,135.56,"på~a7f6cbc869c8"],[3,9,135.56,136.32,"lørdag"],[10,13,136.32,136.56,"var"],[14,16,136.56,136.7,"de"],[17,18,136.7,136.84,"i"],[19,31,136.84,137.48,"svømmehallen"],[33,35,137.48,138.5,"og"],[36,43,138.5,139.16,"etterpå"],[44,50,139.16,139.88,"spiste"],[51,53,139.88,140.02,"de"],[54,58,140.02,140.38,"grøt"]]},{"id":21,"start":141.89,"end":145.49,"text":"Om ettermiddagen besøkte de noen venner.","zh":"下午他们拜访了几个朋友。","words":[[0,2,141.97,142.22,"om~17a2982960f3"],[3,16,142.22,143.38,"ettermiddagen"],[17,24,143.38,144.36,"besøkte"],[25,27,144.36,144.58,"de"],[28,32,144.58,144.9,"noen~c766e2ef794d"],[33,39,144.9,145.41,"venner"]]},{"id":22,"start":146.8,"end":153.07,"text":"På søndag kjørte de slalåm, dro på kino og besøkte farmor.","zh":"星期天他们去滑了高山滑雪，去看了电影，还看望了奶奶。","words":[[0,2,146.88,147.1,"på~0b13a9143ed6"],[3,9,147.1,147.86,"søndag"],[10,16,147.86,148.66,"kjørte"],[17,19,148.66,148.78,"de"],[20,26,148.78,149.5,"slalåm"],[28,31,149.97,150.23,"dro"],[32,34,150.23,150.51,"på~eeea9e5780c2"],[35,39,150.51,150.95,"kino"],[40,42,150.95,151.83,"og"],[43,50,151.88,152.36,"besøkte"],[51,57,152.36,152.99,"farmor"]]}],"lexicon":{"6.2":{"lemma":"6.2","zh":"第 6.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aktiv":{"lemma":"aktiv","zh":"活跃的；爱运动的；积极的","pos":"形容词","ref":"4-089","clip":"pronunciation/3139fcc40f9c93f69203.mp3"},"alene":{"lemma":"alene","zh":"独自一人","pos":"副词","ref":"2-054","clip":"pronunciation/3c24fdbe3fdf986a62b0.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barnebarna":{"lemma":"barnebarn","zh":"孙辈；孙子、孙女、外孙或外孙女