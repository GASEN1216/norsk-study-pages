{"id":"6.2","title":"Hva gjorde du i helga?","audio":"audio/6.2.mp3","duration":156.31,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.55,"text":"6.2 Hva gjorde du i helga?","heading":true,"zh":"6.2 你周末做了什么？","words":[[0,3,0.15,1.26,"6.2"],[4,7,2.37,3.15,"hva"],[8,14,3.15,3.65,"gjorde"],[15,17,3.65,3.85,"du"],[18,19,3.85,4.01,"i~16f1f6aa6ab5"],[20,25,4.01,4.47,"helga"]]},{"id":1,"start":6.38,"end":9.91,"text":"Det er mandag, og Bjørnar er på jobben.","zh":"今天是星期一，比约纳尔在上班。","words":[[0,3,6.44,6.6,"det"],[4,6,6.6,6.84,"er"],[7,13,6.84,7.58,"mandag"],[15,17,7.98,8.14,"og"],[18,25,8.14,8.9,"bjørnar"],[26,28,8.9,9.16,"er"],[29,31,9.16,9.3,"på"],[32,38,9.3,9.76,"jobben"]]},{"id":2,"start":11.01,"end":12.91,"text":"Han snakker med en kollega.","zh":"他在和一位同事聊天。","words":[[0,3,11.07,11.48,"han"],[4,11,11.48,11.92,"snakker"],[12,15,11.92,12.06,"med"],[16,18,12.06,12.22,"en~a939a9e56dc5"],[19,26,12.22,12.76,"kollega"]]},{"id":3,"start":14.0,"end":16.32,"text":"Kollegaen heter Øystein.","zh":"这位同事叫奥于斯坦。","words":[[0,9,14.06,14.96,"kollegaen"],[10,15,15.1,15.6,"heter"],[16,23,15.6,16.18,"øystein"]]},{"id":4,"start":18.02,"end":21.79,"text":"God morgen, Bjørnar. Hvordan var helga?","speaker":"Øystein","zh":"早上好，比约纳尔。周末过得怎么样？","words":[[0,3,18.08,18.38,"god"],[4,10,18.38,18.88,"morgen"],[12,19,18.88,19.55,"bjørnar"],[21,28,20.44,20.9,"hvordan"],[29,32,20.9,21.2,"var"],[33,38,21.2,21.64,"helga"]]},{"id":5,"start":23.11,"end":28.01,"text":"Den var fin. Barna var hos meg, og vi hadde det veldig hyggelig.","speaker":"Bjørnar","zh":"挺好的。孩子们在我这儿，我们过得很愉快。","words":[[0,3,23.16,23.4,"den"],[4,7,23.4,23.56,"var"],[8,11,23.56,24.02,"fin"],[13,18,24.68,25.12,"barna"],[19,22,25.12,25.28,"var"],[23,26,25.28,25.5,"hos"],[27,30,25.5,25.86,"meg"],[32,34,26.18,26.34,"og"],[35,37,26.34,26.48,"vi"],[38,43,26.48,26.76,"hadde~efc0cfad6408"],[44,47,26.76,26.98,"det"],[48,54,26.98,27.46,"veldig"],[55,63,27.46,27.86,"hyggelig"]]},{"id":6,"start":29.01,"end":30.31,"text":"Hva gjorde dere?","speaker":"Øystein","zh":"你们做了什么？","words":[[0,3,29.07,29.52,"hva"],[4,10,29.52,29.84,"gjorde"],[11,15,29.84,30.16,"dere"]]},{"id":7,"start":31.25,"end":51.3,"text":"På fredag laget vi taco. Vi så en tegnefilm på tv og spiste potetgull. På lørdag var vi i svømmehallen. Etterpå spiste vi grøt. Om ettermiddagen besøkte vi noen venner. Du da, Øystein?","speaker":"Bjørnar","zh":"星期五我们做了墨西哥卷饼。我们在电视上看了一部动画片，还吃了薯片。星期六我们去了游泳馆。之后我们吃了粥。下午我们去拜访了几个朋友。你呢，奥于斯坦？","words":[[0,2,31.31,31.5,"på~80f98df994af"],[3,9,31.5,32.16,"fredag"],[10,15,32.16,32.52,"laget~8790a82fb4ba"],[16,18,32.52,32.7,"vi"],[19,23,32.7,33.35,"taco"],[25,27,34.3,34.48,"vi"],[28,30,34.48,34.68,"så~e945ddab6ef4"],[31,33,34.68,34.8,"en~a939a9e56dc5"],[34,43,34.8,35.64,"tegnefilm"],[44,46,35.64,35.8,"på"],[47,49,35.8,36.34,"tv"],[50,52,36.34,36.58,"og"],[53,59,36.58,37.04,"spiste"],[60,69,37.04,37.99,"potetgull"],[71,73,39.04,39.22,"på~a7f6cbc869c8"],[74,80,39.22,39.98,"lørdag"],[81,84,39.98,40.24,"var"],[85,87,40.24,40.44,"vi"],[88,89,40.44,40.56,"i"],[90,102,40.56,41.49,"svømmehallen"],[104,111,42.32,43.05,"etterpå"],[112,118,43.28,43.76,"spiste"],[119,121,43.76,43.94,"vi"],[122,126,43.94,44.55,"grøt"],[128,130,45.88,46.08,"om~17a2982960f3"],[131,144,46.08,47.26,"ettermiddagen"],[145,152,47.38,48.02,"besøkte"],[153,155,48.02,48.16,"vi"],[156,160,48.16,48.34,"noen~c766e2ef794d"],[161,167,48.34,48.85,"venner"],[169,171,50.24,50.42,"du"],[172,174,50.42,50.6,"da~db5a09a6733b"],[176,183,50.6,51.16,"øystein"]]},{"id":8,"start":51.98,"end":53.38,"text":"Hadde du ei fin helg?","speaker":"Bjørnar","zh":"你周末过得好吗？","words":[[0,5,52.05,52.38,"hadde"],[6,8,52.38,52.6,"du"],[9,11,52.6,52.76,"ei~47aa2d18e376"],[12,15,52.76,52.96,"fin"],[16,20,52.96,53.23,"helg"]]},{"id":9,"start":54.33,"end":65.62,"text":"Ja, veldig. Jeg var sammen med venner på lørdag. Vi var på en pub og tok noen øl. Hva gjorde dere på søndag?","speaker":"Øystein","zh":"好，非常好。星期六我和朋友们在一起。我们去了一家酒吧，喝了几杯啤酒。你们星期天做了什么？","words":[[0,2,54.39,54.76,"ja"],[4,10,55.1,55.73,"veldig"],[12,15,56.6,56.86,"jeg"],[16,19,56.86,57.24,"var"],[20,26,57.24,57.6,"sammen"],[27,30,57.6,57.8,"med"],[31,37,57.8,58.28,"venner"],[38,40,58.28,58.44,"på~a7f6cbc869c8"],[41,47,58.44,59.03,"lørdag"],[49,51,59.88,60.08,"vi"],[52,55,60.08,60.42,"var"],[56,58,60.42,60.62,"på"],[59,61,60.62,60.82,"en~a939a9e56dc5"],[62,65,60.82,61.38,"pub"],[66,68,61.38,61.56,"og"],[69,72,61.56,61.86,"tok"],[73,77,61.86,62.2,"noen~c766e2ef794d"],[78,80,62.2,62.53,"øl"],[82,85,63.68,63.9,"hva"],[86,92,63.9,64.14,"gjorde"],[93,97,64.14,64.6,"dere"],[98,100,64.6,64.92,"på~0b13a9143ed6"],[101,107,64.92,65.47,"søndag"]]},{"id":10,"start":66.84,"end":79.28,"text":"På søndag kjørte vi slalåm. Barna fikk slalåmski for et år siden, og de elsker å kjøre slalåm. Etterpå var vi på kino.","speaker":"Bjørnar","zh":"星期天我们去滑了高山滑雪。孩子们一年前得到了高山滑雪板，他们特别喜欢滑高山滑雪。之后我们去看了电影。","words":[[0,2,66.9,67.1,"på~0b13a9143ed6"],[3,9,67.1,67.68,"søndag"],[10,16,67.68,68.0,"kjørte"],[17,19,68.0,68.18,"vi"],[20,26,68.18,68.86,"slalåm"],[28,33,70.3,70.76,"barna"],[34,38,70.76,71.04,"fikk"],[39,48,71.04,71.96,"slalåmski"],[49,52,71.96,72.14,"for~d0291af9704a"],[53,55,72.14,72.42,"et~054dde72f37b"],[56,58,72.42,72.62,"år"],[59,64,72.62,73.16,"siden~9a3d2d89a980"],[66,68,73.7,73.88,"og"],[69,71,73.88,74.18,"de"],[72,78,74.18,74.82,"elsker"],[79,80,74.82,74.96,"å~0583da7a620a"],[81,86,74.96,75.24,"kjøre"],[87,93,75.24,75.86,"slalåm"],[95,102,76.98,77.68,"etterpå"],[103,106,78.02,78.28,"var"],[107,109,78.28,78.46,"vi"],[110,112,78.46,78.68,"på"],[113,117,78.68,79.12,"kino"]]},{"id":11,"start":80.38,"end":88.15,"text":"Du er veldig aktiv. På søndag slappet jeg bare av og så en fotballkamp på tv.","speaker":"Øystein","zh":"你真活跃。星期天我就只是放松了一下，在电视上看了一场足球赛。","words":[[0,2,80.44,80.88,"du"],[3,5,80.88,81.2,"er"],[6,12,81.2,81.64,"veldig"],[13,18,81.64,82.3,"aktiv"],[20,22,83.26,83.48,"på~0b13a9143ed6"],[23,29,83.48,84.04,"søndag"],[30,37,84.04,84.46,"slappet"],[38,41,84.46,84.64,"jeg"],[42,46,84.64,84.9,"bare"],[47,49,84.9,85.3,"av~6aef60c561bf"],[50,52,85.58,85.72,"og"],[53,55,85.72,85.94,"så~e945ddab6ef4"],[56,58,85.94,86.12,"en~a939a9e56dc5"],[59,70,86.12,87.2,"fotballkamp"],[71,73,87.2,87.52,"på"],[74,76,87.52,88.0,"tv"]]},{"id":12,"start":89.05,"end":100.95,"text":"Vi tok det med ro på søndag kveld. Mamma inviterte oss på middag. Hun liker å være sammen med barnebarna, og de er veldig glad i henne.","speaker":"Bjørnar","zh":"星期天晚上我们过得很悠闲。我妈妈请我们吃晚饭。她喜欢和孙辈们在一起，孩子们也很爱她。","words":[[0,2,89.11,89.36,"vi"],[3,6,89.36,89.62,"tok~2c6e2d59a981"],[7,10,89.62,89.76,"det"],[11,14,89.76,89.94,"med~a153bb99781d"],[15,17,89.94,90.28,"ro~62058ae5a974"],[18,20,90.28,90.46,"på~82685e8edbed"],[21,27,90.46,90.84,"søndag"],[28,33,90.84,91.3,"kveld"],[35,40,92.52,93.04,"mamma"],[41,50,93.04,93.6,"inviterte"],[51,54,93.6,93.76,"oss"],[55,57,93.76,93.92,"på~db4686b84afd"],[58,64,93.92,94.52,"middag"],[66,69,95.84,96.04,"hun"],[70,75,96.04,96.62,"liker"],[76,77,96.62,96.72,"å~0583da7a620a"],[78,82,96.72,97.02,"være"],[83,89,97.02,97.4,"sammen"],[90,93,97.4,97.56,"med"],[94,104,97.56,98.38,"barnebarna"],[106,108,98.76,98.96,"og"],[109,111,98.96,99.3,"de"],[112,114,99.3,99.5,"er"],[115,121,99.5,99.96,"veldig"],[122,126,99.96,100.26,"glad~b5ec8d5b115a"],[127,128,100.26,100.38,"i~61214259ab5f"],[129,134,100.38,100.8,"henne"]]},{"id":13,"start":101.96,"end":103.48,"text":"Bor hun alene?","speaker":"Øystein","zh":"她一个人住吗？","words":[[0,3,102.02,102.42,"bor"],[4,7,102.42,102.76,"hun"],[8,13,102.76,103.33,"alene"]]},{"id":14,"start":104.05,"end":107.23,"text":"Ja. Pappa døde for mange år siden.","speaker":"Bjørnar","zh":"是的。我爸爸很多年前就去世了。","words":[[0,2,104.11,104.46,"ja"],[4,9,105.3,105.74,"pappa"],[10,14,105.74,106.14,"døde~7c26078a3b47"],[15,18,106.14,106.34,"for~d0291af9704a"],[19,24,106.34,106.62,"mange"],[25,27,106.62,106.76,"år"],[28,33,106.76,107.08,"siden~9a3d2d89a980"]]},{"id":15,"start":108.53,"end":112.2,"text":"Da er hun sikkert glad for å få besøk av dere.","speaker":"Øystein","zh":"那你们去看她，她一定很高兴。","words":[[0,2,108.59,109.04,"da~4f486b190f4c"],[3,5,109.04,109.26,"er"],[6,9,109.26,109.54,"hun"],[10,17,109.54,110.06,"sikkert~319975cb0cd0"],[18,22,110.06,110.54,"glad"],[23,26,110.54,110.7,"for~f47d487af782"],[27,28,110.7,110.82,"å~0583da7a620a"],[29,31,110.82,111.0,"få~65b84e08cd43"],[32,37,111.0,111.52,"besøk"],[38,40,111.52,111.62,"av~563221794fae"],[41,45,111.62,112.05,"dere"]]},{"id":16,"start":113.23,"end":118.84,"text":"Ja, vi besøker henne hver uke, og hun inviterer oss ofte på middag.","speaker":"Bjørnar","zh":"是的，我们每周都去看她，她也经常请我们吃晚饭。","words":[[0,2,113.29,113.66,"ja"],[4,6,114.02,114.18,"vi"],[7,14,114.18,114.68,"besøker"],[15,20,114.68,114.92,"henne"],[21,25,114.92,115.26,"hver"],[26,29,115.26,115.74,"uke"],[31,33,116.3,116.48,"og"],[34,37,116.48,116.74,"hun"],[38,47,116.74,117.4,"inviterer"],[48,51,117.4,117.72,"oss"],[52,56,117.72,118.16,"ofte"],[57,59,118.16,118.3,"på~db4686b84afd"],[60,66,118.3,118.69,"middag"]]},{"id":17,"start":122.19,"end":123.4,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,122.25,123.25,"sammendrag"]]},{"id":18,"start":124.65,"end":129.25,"text":"Bjørnar hadde barna i helga, og de gjorde mange ting.","zh":"周末孩子们在比约纳尔那儿，他们做了很多事情。","words":[[0,7,124.71,125.46,"bjørnar"],[8,13,125.46,125.82,"hadde~96f4fc62b62e"],[14,19,125.82,126.22,"barna"],[20,21,126.22,126.32,"i~16f1f6aa6ab5"],[22,27,126.32,126.84,"helga"],[29,31,127.64,127.78,"og"],[32,34,127.78,127.98,"de"],[35,41,127.98,128.4,"gjorde"],[42,47,128.4,128.76,"mange"],[48,52,128.76,129.09,"ting"]]},{"id":19,"start":130.28,"end":134.14,"text":"De spiste taco og så en tegnefilm på fredag.","zh":"星期五他们吃了墨西哥卷饼，看了一部动画片。","words":[[0,2,130.34,130.66,"de"],[3,9,130.66,131.12,"spiste"],[10,14,131.12,131.74,"taco"],[15,17,132.22,132.38,"og"],[18,20,132.38,132.62,"så~e945ddab6ef4"],[21,23,132.62,132.78,"en~a939a9e56dc5"],[24,33,132.78,133.44,"tegnefilm"],[34,36,133.44,133.58,"på~80f98df994af"],[37,43,133.58,133.99,"fredag"]]},{"id":20,"start":135.34,"end":140.79,"text":"På lørdag var de i svømmehallen, og etterpå spiste de grøt.","zh":"星期六他们去了游泳馆，之后吃了粥。","words":[[0,2,135.41,135.66,"på~a7f6cbc869c8"],[3,9,135.66,136.34,"lørdag"],[10,13,136.44,136.6,"var"],[14,16,136.6,136.78,"de"],[17,18,136.78,136.92,"i"],[19,31,136.92,137.78,"svømmehallen"],[33,35,138.32,138.64,"og"],[36,43,138.64,139.3,"etterpå"],[44,50,139.54,139.92,"spiste"],[51,53,139.92,140.1,"de"],[54,58,140.1,140.64,"grøt"]]},{"id":21,"start":141.93,"end":145.55,"text":"Om ettermiddagen besøkte de noen venner.","zh":"下午他们拜访了几个朋友。","words":[[0,2,141.99,142.34,"om~17a2982960f3"],[3,16,142.34,143.4,"ettermiddagen"],[17,24,143.86,144.44,"besøkte"],[25,27,144.44,144.66,"de"],[28,32,144.66,144.96,"noen~c766e2ef794d"],[33,39,144.96,145.4,"venner"]]},{"id":22,"start":146.83,"end":153.13,"text":"På søndag kjørte de slalåm, dro på kino og besøkte farmor.","zh":"星期天他们去滑了高山滑雪，去看了电影，还看望了奶奶。","words":[[0,2,146.89,147.24,"på~0b13a9143ed6"],[3,9,147.24,147.98,"søndag"],[10,16,148.4,148.7,"kjørte"],[17,19,148.7,148.86,"de"],[20,26,148.86,149.58,"slalåm"],[28,31,150.12,150.4,"dro"],[32,34,150.4,150.68,"på~eeea9e5780c2"],[35,39,150.68,151.22,"kino"],[40,42,151.78,151.94,"og"],[43,50,151.94,152.48,"besøkte"],[51,57,152.48,152.98,"farmor"]]}],"lexicon":{"6.2":{"lemma":"6.2","zh":"第 6.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aktiv":{"lemma":"aktiv","zh":"活跃的；爱运动的；积极的","pos":"形容词","ref":"4-089","clip":"pronunciation/3139fcc40f9c93f69203.mp3"},"alene":{"lemma":"alene","zh":"独自一人","pos":"副词","ref":"2-054","clip":"pronunciation/3c24fdbe3fdf986a62b0.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barnebarna":{"lemma":"barnebarn","zh":"孙辈；孙子、孙女、外孙或外孙女","pos":"名词","ref":"5-036","form":"复数定指","