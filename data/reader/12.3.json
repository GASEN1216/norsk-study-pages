{"id":"12.3","title":"Vi må holde oss i form","audio":"audio/12.3.mp3","duration":115.71,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.19,"text":"12.3 Vi må holde oss i form","heading":true,"zh":"12.3 我们得保持良好的身体状态","words":[[0,4,0.15,1.04,"12.3"],[5,7,2.15,2.43,"vi"],[8,10,2.43,2.63,"må"],[11,16,2.63,2.99,"holde"],[17,20,2.99,3.25,"oss"],[21,22,3.25,3.55,"i~31a7d6f07639"],[23,27,3.55,4.11,"form"]]},{"id":1,"start":6.28,"end":10.16,"text":"Marit og Håvard har bodd sammen i fem år.","zh":"玛丽特和霍瓦尔已经在一起生活五年了。","words":[[0,5,6.36,6.97,"marit"],[6,8,6.97,7.15,"og"],[9,15,7.15,7.65,"håvard"],[16,19,7.65,8.33,"har~8b9792170cca"],[20,24,8.33,8.67,"bodd"],[25,31,8.67,9.07,"sammen"],[32,33,9.07,9.27,"i~9a628056b72c"],[34,37,9.27,9.59,"fem"],[38,40,9.59,10.08,"år"]]},{"id":2,"start":11.2,"end":14.55,"text":"Marit synes at de sitter for mye i sofaen.","zh":"玛丽特觉得他们在沙发上坐得太多了。","words":[[0,5,11.28,11.85,"marit"],[6,11,11.85,12.37,"synes"],[12,14,12.37,12.55,"at"],[15,17,12.55,12.69,"de"],[18,24,12.69,13.03,"sitter"],[25,28,13.03,13.35,"for~79c080957b12"],[29,32,13.35,13.69,"mye~933c5a923198"],[33,34,13.69,13.89,"i"],[35,41,13.89,14.47,"sofaen"]]},{"id":3,"start":14.71,"end":19.22,"text":"Skal vi begynne å trene på et treningssenter, Håvard?","speaker":"Marit","zh":"霍瓦尔，我们去健身中心开始锻炼好不好？","words":[[0,4,15.99,16.59,"skal"],[5,7,16.59,16.71,"vi"],[8,15,16.71,17.07,"begynne"],[16,17,17.07,17.19,"å~0583da7a620a"],[18,23,17.19,17.59,"trene"],[24,26,17.59,17.75,"på"],[27,29,17.75,17.87,"et~054dde72f37b"],[30,44,17.87,18.61,"treningssenter"],[46,52,18.73,19.14,"håvard"]]},{"id":4,"start":20.01,"end":20.93,"text":"Hvorfor det?","speaker":"Håvard","zh":"为什么？","words":[[0,7,20.09,20.54,"hvorfor"],[8,11,20.54,20.85,"det"]]},{"id":5,"start":21.99,"end":23.21,"text":"Jeg har blitt tjukk!","speaker":"Marit","zh":"我变胖了！","words":[[0,3,22.07,22.19,"jeg"],[4,7,22.19,22.29,"har~8b9792170cca"],[8,13,22.29,22.47,"blitt"],[14,19,22.75,23.13,"tjukk"]]},{"id":6,"start":24.19,"end":28.66,"text":"Nei, nå tuller du! Du er helt perfekt.","speaker":"Håvard","zh":"才没有，你开玩笑呢！你简直完美。","words":[[0,3,24.27,24.75,"nei"],[5,7,25.29,25.47,"nå~d531d47a7712"],[8,14,25.47,26.03,"tuller"],[15,17,26.03,26.17,"du"],[19,21,26.17,26.21,"du"],[22,24,27.07,27.25,"er"],[25,29,27.25,27.63,"helt~09b00b4a2abd"],[30,37,27.63,28.58,"perfekt"]]},{"id":7,"start":29.18,"end":32.24,"text":"Takk, men jeg har lagt på meg fem kilo.","speaker":"Marit","zh":"谢谢，可我已经胖了五公斤。","words":[[0,4,29.19,29.83,"takk"],[6,9,30.21,30.29,"men"],[10,13,30.29,30.43,"jeg"],[14,17,30.43,30.55,"har~8b9792170cca"],[18,22,30.55,30.85,"lagt~8cb1622b847f"],[23,25,30.85,31.07,"på~9284de4ec9e2"],[26,29,31.07,31.25,"meg"],[30,33,31.25,31.63,"fem"],[34,38,31.63,32.16,"kilo"]]},{"id":8,"start":33.14,"end":36.56,"text":"Jeg synes at det er deilig å slappe av etter jobb.","speaker":"Håvard","zh":"我觉得下班后放松一下很舒服。","words":[[0,3,33.22,33.42,"jeg"],[4,9,33.42,33.84,"synes"],[10,12,33.84,34.04,"at"],[13,16,34.04,34.16,"det"],[17,19,34.16,34.24,"er"],[20,26,34.24,34.68,"deilig~a40a3aeaf456"],[27,28,34.68,34.76,"å~0583da7a620a"],[29,35,34.76,35.34,"slappe~f12305fe3dd8"],[36,38,35.34,35.64,"av~e2175249f92f"],[39,44,35.64,35.96,"etter"],[45,49,35.96,36.48,"jobb"]]},{"id":9,"start":37.42,"end":49.68,"text":"Jeg synes at vi ser for mye på tv. Det er usunt å sitte stille hver kveld, og jeg tror det blir gøy å trene sammen. Vi kan trene spinning, løfte vekter og gå på gruppetimer sammen.","speaker":"Marit","zh":"我觉得我们看电视看得太多了。每天晚上都坐着不动对健康不好，而且我觉得一起锻炼会很有趣。我们可以一起骑动感单车、举重，还可以一起上团体课。","words":[[0,3,37.5,37.62,"jeg"],[4,9,37.62,37.94,"synes"],[10,12,37.94,38.1,"at"],[13,15,38.1,38.24,"vi"],[16,19,38.24,38.44,"ser"],[20,23,38.44,38.64,"for~79c080957b12"],[24,27,38.64,38.88,"mye~933c5a923198"],[28,30,38.88,39.02,"på~f7432850c54b"],[31,33,39.02,39.28,"tv"],[35,38,39.88,40.32,"det"],[39,41,40.32,40.4,"er"],[42,47,40.4,41.14,"usunt"],[48,49,41.14,41.2,"å~0583da7a620a"],[50,55,41.2,41.42,"sitte"],[56,62,41.42,41.8,"stille~a2c6c970aa62"],[63,67,41.8,41.94,"hver"],[68,73,41.94,42.32,"kveld"],[75,77,42.64,42.88,"og"],[78,81,42.88,42.98,"jeg"],[82,86,42.98,43.14,"tror"],[87,90,43.14,43.26,"det"],[91,95,43.26,43.38,"blir"],[96,99,43.38,43.74,"gøy"],[100,101,43.74,43.88,"å~0583da7a620a"],[102,107,43.88,44.24,"trene"],[108,114,44.24,44.62,"sammen"],[116,118,45.43,45.67,"vi"],[119,122,45.67,45.83,"kan"],[123,128,45.83,46.09,"trene"],[129,137,46.09,46.45,"spinning"],[139,144,46.97,47.23,"løfte"],[145,151,47.23,47.75,"vekter~7c14e5667ea9"],[152,154,47.75,48.01,"og"],[155,157,48.01,48.17,"gå"],[158,160,48.17,48.35,"på~bcd70525f6ff"],[161,172,48.35,49.03,"gruppetimer"],[173,179,49.03,49.6,"sammen"]]},{"id":10,"start":50.74,"end":55.43,"text":"Jeg synes at det er kjedelig å trene inne. Det er dyrt også.","speaker":"Håvard","zh":"我觉得在室内锻炼很无聊。而且也很贵。","words":[[0,3,50.82,50.97,"jeg"],[4,9,50.97,51.51,"synes"],[10,12,51.51,51.73,"at"],[13,16,51.73,51.81,"det"],[17,19,51.81,51.93,"er"],[20,28,51.93,52.51,"kjedelig"],[29,30,52.51,52.61,"å~0583da7a620a"],[31,36,52.61,53.11,"trene"],[37,41,53.11,53.35,"inne"],[43,46,53.96,54.38,"det"],[47,49,54.38,54.52,"er"],[50,54,54.52,54.98,"dyrt"],[55,59,54.98,55.35,"også"]]},{"id":11,"start":56.11,"end":61.44,"text":"Det synes jeg er en dårlig unnskyldning. Vi kan trene ute. Det er gratis.","speaker":"Marit","zh":"我觉得这是个糟糕的借口。我们可以在户外锻炼。那是免费的。","words":[[0,3,56.19,56.36,"det"],[4,9,56.36,56.64,"synes"],[10,13,56.64,56.78,"jeg"],[14,16,56.78,56.9,"er"],[17,19,56.9,57.04,"en~a939a9e56dc5"],[20,26,57.04,57.58,"dårlig"],[27,39,57.58,58.14,"unnskyldning"],[41,43,58.7,58.88,"vi"],[44,47,58.88,59.02,"kan"],[48,53,59.02,59.4,"trene"],[54,57,59.4,59.76,"ute"],[59,62,60.36,60.52,"det"],[63,65,60.52,60.64,"er"],[66,72,60.64,61.36,"gratis~2d64ec2ad302"]]},{"id":12,"start":62.47,"end":66.23,"text":"Jeg trenger nye joggesko. Det er ikke billig.","speaker":"Håvard","zh":"我需要新的跑鞋。那可不便宜。","words":[[0,3,62.55,62.82,"jeg"],[4,11,63.12,63.26,"trenger"],[12,15,63.26,63.5,"nye"],[16,24,63.5,64.12,"joggesko"],[26,29,65.06,65.22,"det"],[30,32,65.22,65.36,"er"],[33,37,65.36,65.68,"ikke"],[38,44,65.68,66.15,"billig~a6e70043e36a"]]},{"id":13,"start":67.09,"end":73.18,"text":"Nå synes jeg at du er vanskelig. Vi bør holde oss i form i stedet for å sitte foran tv-en hver kveld.","speaker":"Marit","zh":"现在我觉得你真难说话。我们应该保持良好的身体状态，而不是每天晚上坐在电视机前。","words":[[0,2,67.17,67.32,"nå~d531d47a7712"],[3,8,67.32,67.64,"synes"],[9,12,67.64,67.76,"jeg"],[13,15,67.76,68.0,"at"],[16,18,68.0,68.24,"du"],[19,21,68.24,68.47,"er"],[22,31,68.47,68.71,"vanskelig"],[33,35,68.71,68.95,"vi"],[36,39,68.95,69.79,"bør"],[40,45,69.79,70.07,"holde"],[46,49,70.07,70.15,"oss"],[50,51,70.15,70.31,"i~31a7d6f07639"],[52,56,70.31,70.61,"form"],[57,58,70.61,70.89,"i~fa903f3423c4"],[59,65,70.89,71.19,"stedet~67828d356494"],[66,69,71.19,71.31,"for~6e8e04655bdf"],[70,71,71.31,71.43,"å~0583da7a620a"],[72,77,71.43,71.71,"sitte"],[78,83,71.71,72.07,"foran~d09b0d7b7ee2"],[84,89,72.07,72.49,"tv-en~5a77084a0851"],[90,94,72.49,72.73,"hver"],[95,100,72.73,73.1,"kveld"]]},{"id":14,"start":73.96,"end":79.28,"text":"Hm... jeg skal tenke på det. Jeg skal bare slappe av litt først.","speaker":"Håvard","zh":"嗯……我会考虑的。我先放松一下。","words":[[0,2,74.04,74.51,"hm"],[6,9,75.11,75.53,"jeg"],[10,14,75.53,75.73,"skal"],[15,20,75.73,76.13,"tenke"],[21,23,76.13,76.35,"på~a8a1ad1e26f3"],[24,27,76.35,76.51,"det"],[29,32,77.21,77.77,"jeg"],[33,37,77.77,77.97,"skal"],[38,42,77.97,78.25,"bare"],[43,49,78.25,78.57,"slappe~f12305fe3dd8"],[50,52,78.57,78.67,"av~e2175249f92f"],[53,57,78.67,78.77,"litt~54360be2a478"],[58,63,78.77,79.2,"først"]]},{"id":15,"start":82.75,"end":83.83,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,82.83,83.75,"sammendrag"]]},{"id":16,"start":84.77,"end":88.21,"text":"Marit og Håvard sitter mye i sofaen hjemme.","zh":"玛丽特和霍瓦尔在家经常坐在沙发上。","words":[[0,5,84.85,85.37,"marit"],[6,8,85.37,85.55,"og"],[9,15,85.55,86.05,"håvard"],[16,22,86.05,86.47,"sitter"],[23,26,86.47,86.91,"mye~933c5a923198"],[27,28,86.91,87.15,"i"],[29,35,87.15,87.69,"sofaen"],[36,42,87.69,88.13,"hjemme"]]},{"id":17,"start":89.15,"end":94.62,"text":"Marit sier at hun har lagt på seg fem kilo, og at hun har lyst til å begynne å trene.","zh":"玛丽特说她胖了五公斤，她想开始锻炼。","words":[[0,5,89.23,89.72,"marit"],[6,10,89.72,90.04,"sier"],[11,13,90.04,90.26,"at"],[14,17,90.26,90.38,"hun"],[18,21,90.38,90.54,"har~8b9792170cca"],[22,26,90.54,90.76,"lagt~8cb1622b847f"],[27,29,90.76,91.0,"på~9284de4ec9e2"],[30,33,91.0,91.16,"seg"],[34,37,91.16,91.46,"fem"],[38,42,91.46,91.8,"kilo"],[44,46,91.8,92.68,"og"],[47,49,92.68,92.82,"at"],[50,53,92.82,92.98,"hun"],[54,57,92.98,93.12,"har"],[58,62,93.12,93.34,"lyst~868273f22b73"],[63,66,93.34,93.5,"til~99ccdd3453b0"],[67,68,93.5,93.58,"å~0583da7a620a"],[69,76,93.58,93.84,"begynne"],[77,78,93.84,93.94,"å~0583da7a620a"],[79,84,93.94,94.54,"trene"]]},{"id":18,"start":95.57,"end":100.47,"text":"Håvard er ikke så interessert i trening, og han har mange unnskyldninger.","zh":"霍瓦尔对锻炼不太感兴趣，他有很多借口。","words":[[0,6,95.65,96.1,"håvard"],[7,9,96.1,96.4,"er"],[10,14,96.4,96.62,"ikke"],[15,17,96.62,96.78,"så~0ccb28b00948"],[18,29,96.78,97.38,"interessert"],[30,31,97.38,97.54,"i~df67e991931c"],[32,39,97.54,98.04,"trening"],[41,43,98.44,98.62,"og"],[44,47,98.62,98.84,"han"],[48,51,98.84,99.06,"har"],[52,57,99.06,99.38,"mange"],[58,72,99.38,100.39,"unnskyldninger"]]},{"id":19,"start":100.69,"end":107.06,"text":"Han sier at det er kjedelig og dyrt å trene inne, og at han må ha nye joggesko.","zh":"他说在室内锻炼又无聊又贵，而且他得有一双新跑鞋。","words":[[0,3,100.9,101.48,"han"],[4,8,101.48,101.88,"sier"],[9,11,101.88,102.12,"at"],[12,15,102.12,102.24,"det"],[16,18,102.24,102.36,"er"],[19,27,102.36,103.0,"kjedelig"],[28,30,103.0,103.14,"og"],[31,35,103.14,103.64,"dyrt"],[36,37,103.64,103.71,"å~0583da7a620a"],[38,43,103.71,104.08,"trene"],[44,48,104.08,104.36,"inne"],[50,52,105.02,105.22,"og"],[53,55,105.22,105.46,"at"],[56,59,105.46,105.72,"han"],[60,62,105.72,105.86,"må"],[63,65,105.86,106.02,"ha~ca5edb8b1cdb"],[66,69,106.02,106.32,"ny