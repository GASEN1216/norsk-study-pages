{"id":"12.3","title":"Vi må holde oss i form","audio":"audio/12.3.mp3","duration":115.71,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.19,"text":"12.3 Vi må holde oss i form","heading":true,"zh":"12.3 我们得保持良好的身体状态","words":[[0,4,0.15,1.04,"12.3"],[5,7,2.15,2.43,"vi"],[8,10,2.43,2.63,"må"],[11,16,2.63,2.99,"holde"],[17,20,2.99,3.25,"oss"],[21,22,3.25,3.55,"i~31a7d6f07639"],[23,27,3.55,4.11,"form"]]},{"id":1,"start":6.32,"end":10.21,"text":"Marit og Håvard har bodd sammen i fem år.","zh":"玛丽特和霍瓦尔已经在一起生活五年了。","words":[[0,5,6.38,7.06,"marit"],[6,8,7.06,7.2,"og"],[9,15,7.2,7.9,"håvard"],[16,19,8.18,8.42,"har~8b9792170cca"],[20,24,8.42,8.72,"bodd"],[25,31,8.72,9.2,"sammen"],[32,33,9.2,9.4,"i~9a628056b72c"],[34,37,9.4,9.74,"fem"],[38,40,9.74,10.06,"år"]]},{"id":2,"start":11.23,"end":14.62,"text":"Marit synes at de sitter for mye i sofaen.","zh":"玛丽特觉得他们在沙发上坐得太多了。","words":[[0,5,11.29,11.94,"marit"],[6,11,11.94,12.46,"synes"],[12,14,12.46,12.58,"at"],[15,17,12.58,12.74,"de"],[18,24,12.74,13.22,"sitter"],[25,28,13.22,13.44,"for~79c080957b12"],[29,32,13.44,13.82,"mye~933c5a923198"],[33,34,13.82,13.96,"i"],[35,41,13.96,14.46,"sofaen"]]},{"id":3,"start":16.31,"end":19.27,"text":"Skal vi begynne å trene på et treningssenter, Håvard?","speaker":"Marit","zh":"霍瓦尔，我们去健身中心开始锻炼好不好？","words":[[0,4,16.37,16.64,"skal"],[5,7,16.64,16.78,"vi"],[8,15,16.78,17.14,"begynne"],[16,17,17.14,17.26,"å~0583da7a620a"],[18,23,17.26,17.66,"trene"],[24,26,17.66,17.78,"på"],[27,29,17.78,17.9,"et~054dde72f37b"],[30,44,17.9,18.72,"treningssenter"],[46,52,18.72,19.12,"håvard"]]},{"id":4,"start":20.05,"end":20.99,"text":"Hvorfor det?","speaker":"Håvard","zh":"为什么？","words":[[0,7,20.11,20.58,"hvorfor"],[8,11,20.58,20.84,"det"]]},{"id":5,"start":22.02,"end":23.22,"text":"Jeg har blitt tjukk!","speaker":"Marit","zh":"我变胖了！","words":[[0,3,22.07,22.22,"jeg"],[4,7,22.22,22.34,"har~8b9792170cca"],[8,13,22.34,22.66,"blitt"],[14,19,22.66,23.07,"tjukk"]]},{"id":6,"start":24.23,"end":28.71,"text":"Nei, nå tuller du! Du er helt perfekt.","speaker":"Håvard","zh":"才没有，你开玩笑呢！你简直完美。","words":[[0,3,24.29,24.86,"nei"],[5,7,25.32,25.68,"nå~d531d47a7712"],[8,14,25.68,26.06,"tuller"],[15,17,26.06,26.38,"du"],[19,21,26.96,27.14,"du"],[22,24,27.14,27.34,"er"],[25,29,27.34,27.76,"helt~09b00b4a2abd"],[30,37,27.76,28.56,"perfekt"]]},{"id":7,"start":29.53,"end":32.29,"text":"Takk, men jeg har lagt på meg fem kilo.","speaker":"Marit","zh":"谢谢，可我已经胖了五公斤。","words":[[0,4,29.59,30.2,"takk"],[6,9,30.2,30.34,"men"],[10,13,30.34,30.46,"jeg"],[14,17,30.46,30.62,"har~8b9792170cca"],[18,22,30.62,30.98,"lagt~8cb1622b847f"],[23,25,30.98,31.14,"på~9284de4ec9e2"],[26,29,31.14,31.4,"meg"],[30,33,31.4,31.76,"fem"],[34,38,31.76,32.14,"kilo"]]},{"id":8,"start":33.17,"end":36.61,"text":"Jeg synes at det er deilig å slappe av etter jobb.","speaker":"Håvard","zh":"我觉得下班后放松一下很舒服。","words":[[0,3,33.23,33.58,"jeg"],[4,9,33.58,33.94,"synes"],[10,12,33.94,34.04,"at"],[13,16,34.04,34.18,"det"],[17,19,34.18,34.34,"er"],[20,26,34.34,34.72,"deilig~a40a3aeaf456"],[27,28,34.72,34.88,"å~0583da7a620a"],[29,35,34.88,35.46,"slappe~f12305fe3dd8"],[36,38,35.46,35.86,"av~e2175249f92f"],[39,44,35.86,36.14,"etter"],[45,49,36.14,36.46,"jobb"]]},{"id":9,"start":37.45,"end":49.73,"text":"Jeg synes at vi ser for mye på tv. Det er usunt å sitte stille hver kveld, og jeg tror det blir gøy å trene sammen. Vi kan trene spinning, løfte vekter og gå på gruppetimer sammen.","speaker":"Marit","zh":"我觉得我们看电视看得太多了。每天晚上都坐着不动对健康不好，而且我觉得一起锻炼会很有趣。我们可以一起骑动感单车、举重，还可以一起上团体课。","words":[[0,3,37.52,37.76,"jeg"],[4,9,37.76,38.04,"synes"],[10,12,38.04,38.16,"at"],[13,15,38.16,38.3,"vi"],[16,19,38.3,38.56,"ser"],[20,23,38.56,38.72,"for~79c080957b12"],[24,27,38.72,38.94,"mye~933c5a923198"],[28,30,38.94,39.08,"på~f7432850c54b"],[31,33,39.08,39.62,"tv"],[35,38,40.22,40.34,"det"],[39,41,40.34,40.54,"er"],[42,47,40.54,41.14,"usunt"],[48,49,41.14,41.24,"å~0583da7a620a"],[50,55,41.24,41.52,"sitte"],[56,62,41.52,41.82,"stille~a2c6c970aa62"],[63,67,41.82,42.04,"hver"],[68,73,42.04,42.52,"kveld"],[75,77,42.8,42.9,"og"],[78,81,42.9,43.04,"jeg"],[82,86,43.04,43.2,"tror"],[87,90,43.2,43.3,"det"],[91,95,43.3,43.52,"blir"],[96,99,43.52,43.84,"gøy"],[100,101,43.84,43.94,"å~0583da7a620a"],[102,107,43.94,44.34,"trene"],[108,114,44.34,44.84,"sammen"],[116,118,45.62,45.72,"vi"],[119,122,45.72,45.86,"kan"],[123,128,45.86,46.18,"trene"],[129,137,46.18,46.98,"spinning"],[139,144,46.98,47.32,"løfte"],[145,151,47.32,47.94,"vekter~7c14e5667ea9"],[152,154,47.94,48.08,"og"],[155,157,48.08,48.28,"gå"],[158,160,48.28,48.42,"på~bcd70525f6ff"],[161,172,48.42,49.18,"gruppetimer"],[173,179,49.18,49.59,"sammen"]]},{"id":10,"start":50.77,"end":55.49,"text":"Jeg synes at det er kjedelig å trene inne. Det er dyrt også.","speaker":"Håvard","zh":"我觉得在室内锻炼很无聊。而且也很贵。","words":[[0,3,50.84,51.18,"jeg"],[4,9,51.18,51.62,"synes"],[10,12,51.62,51.72,"at"],[13,16,51.72,51.82,"det"],[17,19,51.82,52.0,"er"],[20,28,52.0,52.56,"kjedelig"],[29,30,52.56,52.68,"å~0583da7a620a"],[31,36,52.68,53.2,"trene"],[37,41,53.2,53.67,"inne"],[43,46,54.28,54.44,"det"],[47,49,54.44,54.62,"er"],[50,54,54.62,55.0,"dyrt"],[55,59,55.0,55.34,"også"]]},{"id":11,"start":56.18,"end":61.5,"text":"Det synes jeg er en dårlig unnskyldning. Vi kan trene ute. Det er gratis.","speaker":"Marit","zh":"我觉得这是个糟糕的借口。我们可以在户外锻炼。那是免费的。","words":[[0,3,56.24,56.48,"det"],[4,9,56.48,56.72,"synes"],[10,13,56.72,56.84,"jeg"],[14,16,56.84,56.98,"er"],[17,19,56.98,57.2,"en~a939a9e56dc5"],[20,26,57.2,57.64,"dårlig"],[27,39,57.64,58.44,"unnskyldning"],[41,43,58.82,58.94,"vi"],[44,47,58.94,59.1,"kan"],[48,53,59.1,59.5,"trene"],[54,57,59.5,60.03,"ute"],[59,62,60.42,60.56,"det"],[63,65,60.56,60.72,"er"],[66,72,60.72,61.35,"gratis~2d64ec2ad302"]]},{"id":12,"start":62.59,"end":66.31,"text":"Jeg trenger nye joggesko. Det er ikke billig.","speaker":"Håvard","zh":"我需要新的跑鞋。那可不便宜。","words":[[0,3,62.66,62.9,"jeg"],[4,11,62.9,63.32,"trenger"],[12,15,63.32,63.62,"nye"],[16,24,63.62,64.32,"joggesko"],[26,29,65.1,65.26,"det"],[30,32,65.26,65.44,"er"],[33,37,65.44,65.76,"ikke"],[38,44,65.76,66.16,"billig~a6e70043e36a"]]},{"id":13,"start":67.13,"end":73.24,"text":"Nå synes jeg at du er vanskelig. Vi bør holde oss i form i stedet for å sitte foran tv-en hver kveld.","speaker":"Marit","zh":"现在我觉得你真难说话。我们应该保持良好的身体状态，而不是每天晚上坐在电视机前。","words":[[0,2,67.19,67.46,"nå~d531d47a7712"],[3,8,67.46,67.68,"synes"],[9,12,67.68,67.8,"jeg"],[13,15,67.8,67.88,"at"],[16,18,67.88,68.0,"du"],[19,21,68.0,68.18,"er"],[22,31,68.18,69.0,"vanskelig"],[33,35,69.56,69.68,"vi"],[36,39,69.68,69.84,"bør"],[40,45,69.84,70.06,"holde"],[46,49,70.06,70.22,"oss"],[50,51,70.22,70.38,"i~31a7d6f07639"],[52,56,70.38,70.82,"form"],[57,58,70.82,70.9,"i~fa903f3423c4"],[59,65,70.9,71.22,"stedet~67828d356494"],[66,69,71.22,71.36,"for~6e8e04655bdf"],[70,71,71.36,71.46,"å~0583da7a620a"],[72,77,71.46,71.82,"sitte"],[78,83,71.82,72.12,"foran~d09b0d7b7ee2"],[84,89,72.12,72.54,"tv-en~5a77084a0851"],[90,94,72.54,72.8,"hver"],[95,100,72.8,73.09,"kveld"]]},{"id":14,"start":74.01,"end":79.34,"text":"Hm... jeg skal tenke på det. Jeg skal bare slappe av litt først.","speaker":"Håvard","zh":"嗯……我会考虑的。我先放松一下。","words":[[0,2,74.07,74.48,"hm"],[6,9,75.42,75.58,"jeg"],[10,14,75.58,75.86,"skal"],[15,20,75.86,76.22,"tenke"],[21,23,76.22,76.38,"på~a8a1ad1e26f3"],[24,27,76.38,76.72,"det"],[29,32,77.64,77.82,"jeg"],[33,37,77.82,78.08,"skal"],[38,42,78.08,78.34,"bare"],[43,49,78.34,78.62,"slappe~f12305fe3dd8"],[50,52,78.62,78.68,"av~e2175249f92f"],[53,57,78.68,78.86,"litt~54360be2a478"],[58,63,78.86,79.19,"først"]]},{"id":15,"start":82.79,"end":83.89,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,82.85,83.74,"sammendrag"]]},{"id":16,"start":84.81,"end":88.26,"text":"Marit og Håvard sitter mye i sofaen hjemme.","zh":"玛丽特和霍瓦尔在家经常坐在沙发上。","words":[[0,5,84.87,85.48,"marit"],[6,8,85.48,85.6,"og"],[9,15,85.6,86.22,"håvard"],[16,22,86.22,86.68,"sitter"],[23,26,86.68,87.1,"mye~933c5a923198"],[27,28,87.1,87.2,"i"],[29,35,87.2,87.74,"sofaen"],[36,42,87.74,88.11,"hjemme"]]},{"id":17,"start":89.19,"end":94.68,"text":"Marit sier at hun har lagt på seg fem kilo, og at hun har lyst til å begynne å trene.","zh":"玛丽特说她胖了五公斤，她想开始锻炼。","words":[[0,5,89.25,89.82,"marit"],[6,10,89.82,90.16,"sier"],[11,13,90.16,90.3,"at"],[14,17,90.3,90.46,"hun"],[18,21,90.46,90.6,"har~8b9792170cca"],[22,26,90.6,90.92,"lagt~8cb1622b847f"],[27,29,90.92,91.08,"på~9284de4ec9e2"],[30,33,91.08,91.3,"seg"],[34,37,91.3,91.56,"fem"],[38,42,91.56,92.1,"kilo"],[44,46,92.6,92.74,"og"],[47,49,92.74,92.88,"at"],[50,53,92.88,93.04,"hun"],[54,57,93.04,93.18,"har"],[58,62,93.18,93.4,"lyst~868273f22b73"],[63,66,93.4,93.56,"til~99ccdd3453b0"],[67,68,93.56,93.62,"å~0583da7a620a"],[69,76,93.62,93.92,"begynne"],[77,78,93.92,94.02,"å~0583da7a620a"],[79,84,94.02,94.53,"trene"]]},{"id":18,"start":95.61,"end":100.53,"text":"Håvard er ikke så interessert i trening, og han har mange unnskyldninger.","zh":"霍瓦尔对锻炼不太感兴趣，他有很多借口。","words":[[0,6,95.67,96.28,"håvard"],[7,9,96.28,96.48,"er"],[10,14,96.48,96.68,"ikke"],[15,17,96.68,96.82,"så~0ccb28b00948"],[18,29,96.82,97.48,"interessert"],[30,31,97.48,97.58,"i~df67e991931c"],[32,39,97.58,98.24,"trening"],[41,43,98.5,98.64,"og"],[44,47,98.64,98.9,"han"],[48,51,98.9,99.16,"har"],[52,57,99.16,99.58,"mange"],[58,72,99.58,100.38,"unnskyldninger"]]},{"id":19,"start":101.18,"end":107.12,"text":"Han sier at det er kjedelig og dyrt å trene inne, og at han må ha nye joggesko.","zh":"他说在室内锻炼又无聊又贵，而且他得有一双新跑鞋。","words":[[0,3,101.24,101.64,"han"],[4,8,101.64,102.0,"sier"],[9,11,102.0,102.14,"at"],[12,15,102.14,102.26,"det"],[16,18,102.26,102.44,"er"],[19,27,102.44,103.06,"kjedelig"],[28,30,103.06,103.24,"og"],[31,35,103.24,103.7,"dyrt"],[36,37,103.7,103.8,"å~0583da7a620a"],[38,43,103.8,104.14,"trene"],[44,48,104.14,104.62,"inne"],[50,52,105.08,105.36,"og"],[53,55,105.36,105.54,"at"],[56,59,105.54,105.78,"han"],[60,62,105.78,105.92,"må"],[63,65,105.92,106.08,"ha~ca5edb8b1cdb"],[66,69,106.08,106.4,"nye"],[70,78,106.4,106.97,"joggesko"]]},