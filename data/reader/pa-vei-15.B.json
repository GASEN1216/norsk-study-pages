{"id":"pa-vei-15.B","bookId":"pa-vei-textbook","readingId":"15.B","title":"Borte fra jobben","audio":"audio/pa-vei/15.B.mp3","duration":123.312,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.96,"end":5.165,"text":"Monica har fått vondt i ryggen og har sovet dårlig hele natta.","zh":"莫妮卡背疼，整晚都没睡好。","words":[[0,6,0.96,1.545,"monica"],[7,10,1.56,1.745,"har"],[11,15,1.76,1.985,"fått@pa-vei-extra-65"],[16,21,2.0,2.343,"vondt"],[22,23,2.343,2.422,"i"],[24,30,2.422,2.825,"ryggen"],[31,33,3.4,3.513,"og"],[34,37,3.513,3.663,"har"],[38,43,3.663,4.065,"sovet"],[44,50,4.1,4.525,"dårlig"],[51,55,4.56,4.842,"hele"],[56,61,4.842,5.165,"natta"]]},{"id":1,"start":6.38,"end":11.905,"text":"Hun kan nesten ikke gå om morgenen, og hun forstår at hun ikke klarer å gå på jobb.","zh":"早上她几乎走不了路，知道自己没法上班了。","words":[[0,3,6.38,6.545,"hun"],[4,7,6.56,6.745,"kan"],[8,14,6.76,7.133,"nesten"],[15,19,7.133,7.385,"ikke"],[20,22,7.48,7.645,"gå"],[23,25,7.88,8.023,"om"],[26,34,8.023,8.425,"morgenen"],[36,38,9.42,9.543,"og"],[39,42,9.543,9.705,"hun"],[43,50,9.72,10.245,"forstår"],[51,53,10.3,10.443,"at"],[54,57,10.443,10.572,"hun"],[58,62,10.572,10.785,"ikke"],[63,69,10.8,11.282,"klarer"],[70,71,11.282,11.373,"å"],[72,74,11.373,11.485,"gå"],[75,77,11.5,11.643,"på"],[78,82,11.643,11.905,"jobb"]]},{"id":2,"start":13.484,"end":16.009,"text":"Derfor ringer hun til jobben for å gi beskjed.","zh":"因此，她打电话到单位说明情况。","words":[[0,6,13.484,13.886,"derfor"],[7,13,13.886,14.256,"ringer"],[14,17,14.256,14.409,"hun"],[18,21,14.424,14.589,"til"],[22,28,14.604,15.009,"jobben"],[29,32,15.224,15.377,"for"],[33,34,15.377,15.457,"å"],[35,37,15.457,15.589,"gi@pa-vei-extra-62"],[38,45,15.604,16.009,"beskjed"]]},{"id":3,"start":17.124,"end":21.309,"text":"I resepsjonen sitter Torstein, som er en god kollega av Monica.","zh":"前台坐着托尔斯泰因，他是莫妮卡的一位好同事。","words":[[0,1,17.124,17.227,"i"],[2,13,17.227,17.969,"resepsjonen"],[14,20,17.984,18.289,"sitter"],[21,29,18.304,18.869,"torstein"],[31,34,19.504,19.689,"som"],[35,37,19.704,19.837,"er"],[38,40,19.837,19.966,"en"],[41,44,19.966,20.209,"god"],[45,52,20.224,20.729,"kollega"],[53,55,20.764,20.896,"av"],[56,62,20.896,21.309,"monica"]]},{"id":4,"start":23.444,"end":25.369,"text":"Hotell Prinsen, vær så god!","zh":"王子酒店，您好！","words":[[0,6,23.444,23.827,"hotell"],[7,14,23.827,24.289,"prinsen@pa-vei-extra-63"],[16,19,24.844,25.007,"vær@pa-vei-vær-be"],[20,22,25.007,25.137,"så"],[23,26,25.137,25.369,"god"]],"speaker":"Torstein"},{"id":5,"start":26.684,"end":29.109,"text":"Hei, Torstein. Det er Monica.","zh":"嗨，托尔斯泰因。我是莫妮卡。","words":[[0,3,26.684,26.949,"hei"],[5,13,27.104,27.649,"torstein"],[15,18,28.424,28.566,"det"],[19,21,28.566,28.677,"er"],[22,28,28.677,29.109,"monica"]],"speaker":"Monica"},{"id":6,"start":30.524,"end":31.229,"text":"Hei, Monica.","zh":"嗨，莫妮卡。","words":[[0,3,30.524,30.769,"hei"],[5,11,30.824,31.229,"monica"]],"speaker":"Torstein"},{"id":7,"start":32.584,"end":35.249,"text":"Du, jeg kan ikke komme på jobben i dag.","zh":"我今天没法来上班了。","words":[[0,2,32.584,32.729,"du"],[4,7,33.444,33.609,"jeg"],[8,11,33.624,33.829,"kan"],[12,16,33.844,34.087,"ikke"],[17,22,34.087,34.409,"komme"],[23,25,34.424,34.547,"på"],[26,32,34.547,34.907,"jobben"],[33,34,34.907,35.007,"i"],[35,38,35.007,35.249,"dag"]],"speaker":"Monica"},{"id":8,"start":36.304,"end":38.729,"text":"Jeg har vondt i ryggen og kan nesten ikke gå.","zh":"我背疼，几乎走不了路。","words":[[0,3,36.304,36.437,"jeg"],[4,7,36.437,36.547,"har"],[8,13,36.547,36.806,"vondt"],[14,15,36.806,36.877,"i"],[16,22,36.877,37.309,"ryggen"],[23,25,37.604,37.737,"og"],[26,29,37.737,37.909,"kan"],[30,36,37.924,38.377,"nesten"],[37,41,38.377,38.606,"ikke"],[42,44,38.606,38.729,"gå"]],"speaker":"Monica"},{"id":9,"start":40.2,"end":43.379,"text":"Å det var synd! Stakkars deg!","zh":"啊，真不巧！你太难受了！","words":[[0,1,40.2,40.62,"å"],[2,5,41.054,41.239,"det"],[6,9,41.254,41.419,"var"],[10,14,41.454,41.759,"synd"],[16,24,42.574,43.157,"stakkars"],[25,28,43.157,43.379,"deg"]],"speaker":"Torstein"},{"id":10,"start":44.374,"end":45.579,"text":"Har du vært hos legen?","zh":"你去看医生了吗？","words":[[0,3,44.374,44.587,"har"],[4,6,44.587,44.719,"du"],[7,11,44.734,44.956,"vært"],[12,15,44.956,45.127,"hos"],[16,21,45.127,45.579,"legen"]],"speaker":"Torstein"},{"id":11,"start":46.954,"end":51.539,"text":"Nei, ikke ennå. Jeg håper jeg blir bedre i morgen.","zh":"还没有。我希望明天会好一些。","words":[[0,3,46.954,47.219,"nei"],[5,9,47.814,48.119,"ikke"],[10,14,48.134,48.419,"ennå"],[16,19,49.794,49.939,"jeg"],[20,25,49.974,50.397,"håper"],[26,29,50.397,50.526,"jeg"],[30,34,50.526,50.697,"blir"],[35,40,50.697,51.087,"bedre@pa-vei-extra-66"],[41,42,51.087,51.166,"i"],[43,49,51.166,51.539,"morgen"]],"speaker":"Monica"},{"id":12,"start":53.024,"end":54.029,"text":"Er Larsen inne?","zh":"拉森在吗？","words":[[0,2,53.024,53.169,"er"],[3,9,53.184,53.689,"larsen"],[10,14,53.744,54.029,"inne"]],"speaker":"Monica"},{"id":13,"start":55.404,"end":57.489,"text":"Nei, han er i et møte.","zh":"不在，他在开会。","words":[[0,3,55.404,55.689,"nei"],[5,8,56.384,56.569,"han"],[9,11,56.624,56.806,"er"],[12,13,56.806,56.897,"i"],[14,16,56.897,57.067,"et"],[17,21,57.067,57.489,"møte"]],"speaker":"Torstein"},{"id":14,"start":58.584,"end":60.669,"text":"Kan du si fra til ham når du ser ham?","zh":"你见到他时能告诉他吗？","words":[[0,3,58.584,58.746,"kan"],[4,6,58.746,58.869,"du"],[7,9,58.944,59.129,"si"],[10,13,59.244,59.409,"fra"],[14,17,59.424,59.589,"til"],[18,21,59.624,59.889,"ham"],[22,25,59.904,60.047,"når@pa-vei-når-when"],[26,28,60.047,60.169,"du"],[29,32,60.224,60.486,"ser"],[33,36,60.486,60.669,"ham"]],"speaker":"Monica"},{"id":15,"start":61.824,"end":65.169,"text":"Ja, klart det. Jeg skal gi ham beskjed.","zh":"当然可以，我会告诉他。","words":[[0,2,61.824,61.969,"ja"],[4,9,62.684,63.056,"klart"],[10,13,63.056,63.209,"det"],[15,18,64.004,64.189,"jeg"],[19,23,64.224,64.406,"skal"],[24,26,64.406,64.549,"gi@pa-vei-extra-64"],[27,30,64.584,64.749,"ham"],[31,38,64.764,65.169,"beskjed"]],"speaker":"Torstein"},{"id":16,"start":66.184,"end":67.009,"text":"God bedring, da!","zh":"祝你早日康复！","words":[[0,3,66.184,66.416,"god"],[4,11,66.416,66.897,"bedring"],[13,15,66.897,67.009,"da"]],"speaker":"Torstein"},{"id":17,"start":68.504,"end":72.369,"text":"Takk skal du ha. Jeg ringer i morgen hvis jeg er like dårlig.","zh":"谢谢你。如果明天还是这么难受，我会再打电话。","words":[[0,4,68.504,68.769,"takk"],[5,9,68.784,68.977,"skal"],[10,12,68.977,69.089,"du"],[13,15,69.104,69.229,"ha"],[17,20,70.464,70.617,"jeg"],[21,27,70.617,70.936,"ringer"],[28,29,70.936,71.036,"i"],[30,36,71.036,71.326,"morgen"],[37,41,71.326,71.489,"hvis"],[42,45,71.504,71.637,"jeg"],[46,48,71.637,71.707,"er"],[49,53,71.707,72.026,"like@pa-vei-like-equally"],[54,60,72.026,72.369,"dårlig"]],"speaker":"Monica"},{"id":18,"start":73.804,"end":75.909,"text":"Ok. Pass på deg selv.","zh":"好的，照顾好自己。","words":[[0,2,73.804,74.049,"ok"],[4,8,75.084,75.356,"pass@pa-vei-extra-67"],[9,11,75.356,75.477,"på"],[12,15,75.477,75.656,"deg"],[16,20,75.656,75.909,"selv"]],"speaker":"Torstein"},{"id":19,"start":77.444,"end":80.989,"text":"Torstein har også tatt imot to andre beskjeder til Larsen:","zh":"托尔斯坦还替拉森收到了另外两条留言：","words":[[0,8,77.444,78.036,"torstein"],[9,12,78.036,78.177,"har"],[13,17,78.177,78.389,"også"],[18,22,78.424,78.726,"tatt@pa-vei-extra-73"],[23,27,78.726,79.069,"imot@pa-vei-extra-74"],[28,30,79.224,79.389,"to"],[31,36,79.584,79.927,"andre"],[37,46,79.927,80.427,"beskjeder"],[47,50,80.427,80.577,"til"],[51,57,80.577,80.989,"larsen"]]},{"id":20,"start":83.264,"end":83.989,"text":"Beskjed 1:","zh":"留言一：","words":[[0,7,83.264,83.669,"beskjed"],[8,9,83.744,83.989,"1"]]},{"id":21,"start":86.044,"end":88.249,"text":"Til: Arne Larsen","zh":"收件人：阿尔内·拉森","words":[[0,3,86.044,86.269,"til"],[5,9,87.404,87.749,"arne"],[10,16,87.764,88.249,"larsen"]]},{"id":22,"start":89.834,"end":92.879,"text":"Emne: Dale kommer senere i dag","zh":"主题：达勒今天晚点来","words":[[0,4,89.834,90.179,"emne"],[6,10,91.334,91.759,"dale"],[11,17,91.774,92.119,"kommer"],[18,24,92.154,92.556,"senere@pa-vei-extra-71"],[25,26,92.556,92.647,"i"],[27,30,92.647,92.879,"dag"]]},{"id":23,"start":94.994,"end":98.119,"text":"Dale kommer etter tolv. Sykt barn.","zh":"达勒十二点以后来。孩子生病了。","words":[[0,4,94.994,95.399,"dale"],[5,11,95.434,95.819,"kommer"],[12,17,95.874,96.216,"etter"],[18,22,96.216,96.539,"tolv"],[24,28,97.414,97.816,"sykt"],[29,33,97.816,98.119,"barn"]]},{"id":24,"start":99.154,"end":100.239,"text":"Hilsen Torstein","zh":"祝好，托尔斯坦","words":[[0,6,99.154,99.619,"hilsen"],[7,15,99.714,100.239,"torstein"]]},{"id":25,"start":102.694,"end":103.359,"text":"Beskjed 2:","zh":"留言二：","words":[[0,7,102.694,103.099,"beskjed"],[8,9,103.194,103.359,"2"]]},{"id":26,"start":104.794,"end":106.719,"text":"Til: Arne Larsen","zh":"收件人：阿尔内·拉森","words":[[0,3,104.794,105.019,"til"],[5,9,105.994,106.316,"arne"],[10,16,106.316,106.719,"larsen"]]},{"id":27,"start":108.234,"end":110.999,"text":"Emne: Beskjed fra barnehagen","zh":"主题：幼儿园的留言","words":[[0,4,108.234,108.559,"emne"],[6,13,109.514,109.999,"beskjed"],[14,17,110.074,110.259,"fra"],[18,28,110.314,110.999,"barnehagen"]]},{"id":28,"start":113.134,"end":117.019,"text":"Barnehagen ringte. Ellen har feber og kaster opp.","zh":"幼儿园打来电话了。埃伦发烧，还在呕吐。","words":[[0,10,113.134,113.819,"barnehagen"],[11,17,113.854,114.259,"ringte@pa-vei-extra-68"],[19,24,115.114,115.439,"ellen"],[25,28,115.474,115.637,"har"],[29,34,115.637,116.019,"feber"],[35,37,116.314,116.427,"og"],[38,44,116.427,116.797,"kaster@pa-vei-extra-69"],[45,48,116.797,117.019,"opp@pa-vei-extra-70"]]},{"id":29,"start":117.914,"end":119.479,"text":"Hent henne så fort som mulig.","zh":"请尽快把她接走。","words":[[0,4,117.914,118.227,"hent@pa-vei-extra-72"],[5,10,118.227,118.479,"henne"],[11,13,118.594,118.739,"så"],[14,18,118.754,118.996,"fort"],[19,22,118.996,119.156,"som"],[23,28,119.156,119.479,"mulig"]]},{"id":30,"start":120.584,"end":121.669,"text":"Hilsen Torstein","zh":"祝好，托尔斯坦","words":[[0,6,120.584,121.009,"hilsen"],[7,15,121.184,121.669,"torstein"]]}],"lexicon":{"1":{"lemma":"1","pos":"数词","zh":"数字 1","r