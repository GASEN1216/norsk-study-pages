{"id":"ty-conversation-6.2","bookId":"ty-conversation-guide","readingId":"6.2","title":"Buying souvenirs","audio":"audio/ty-conversation/6.2.mp3","duration":51.957551,"synthetic":false,"sentences":[{"id":0,"start":18.03,"end":20.035,"speaker":"Olav","text":"Hva koster disse fuglene?","zh":"这些小鸟多少钱？","words":[[0,3,18.03,18.215,"hva"],[4,10,18.33,18.915,"koster"],[11,16,19.07,19.475,"disse"],[17,24,19.55,20.035,"fuglene"]]},{"id":1,"start":21.33,"end":25.035,"speaker":"Assistant","text":"De hvite fuglene koster hundre og førti kroner.","zh":"白色的小鸟要 140 克朗。","words":[[0,2,21.33,21.495,"de@ty-de-definite"],[3,8,21.61,22.115,"hvite"],[9,16,22.19,22.755,"fuglene"],[17,23,23.07,23.515,"koster"],[24,30,23.61,23.962,"hundre"],[31,33,23.962,24.075,"og"],[34,39,24.09,24.515,"førti"],[40,46,24.55,25.035,"kroner"]]},{"id":2,"start":26.1,"end":29.945,"speaker":"Assistant","text":"De grønne fuglene koster to hundre og ti kroner.","zh":"绿色的小鸟要 210 克朗。","words":[[0,2,26.1,26.265,"de@ty-de-definite"],[3,9,26.38,26.905,"grønne"],[10,17,27.0,27.565,"fuglene"],[18,24,27.88,28.325,"koster"],[25,27,28.4,28.585,"to"],[28,34,28.66,29.023,"hundre"],[35,37,29.023,29.145,"og"],[38,40,29.16,29.365,"ti"],[41,47,29.48,29.945,"kroner"]]},{"id":3,"start":30.68,"end":31.565,"speaker":"Olav","text":"Det er dyrt.","zh":"真贵。","words":[[0,3,30.68,30.865,"det@ty-det-price"],[4,6,30.9,31.085,"er@ty-be-description"],[7,11,31.16,31.565,"dyrt"]]},{"id":4,"start":32.86,"end":34.045,"speaker":"Assistant","text":"Det er ikke billig.","zh":"是不便宜。","words":[[0,3,32.86,33.045,"det@ty-det-price"],[4,6,33.06,33.225,"er@ty-be-description"],[7,11,33.3,33.625,"ikke"],[12,18,33.66,34.045,"billig"]]},{"id":5,"start":34.88,"end":36.625,"speaker":"Assistant","text":"Men de er fine.","zh":"不过它们很漂亮。","words":[[0,3,34.88,35.145,"men"],[4,6,35.46,35.605,"de@ty-de-pronoun"],[7,9,35.78,36.105,"er@ty-be-description"],[10,14,36.22,36.625,"fine"]]},{"id":6,"start":37.43,"end":39.535,"speaker":"Olav","text":"Hva koster lysestaken?",