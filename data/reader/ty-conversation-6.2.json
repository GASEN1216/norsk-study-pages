{"id":"ty-conversation-6.2","bookId":"ty-conversation-guide","readingId":"6.2","title":"Buying souvenirs","audio":"audio/ty-conversation/6.2.mp3","duration":51.957551,"synthetic":false,"sentences":[{"id":0,"start":17.1,"end":19.92,"speaker":"Olav","text":"Hva koster disse fuglene?","zh":"这些小鸟多少钱？","words":[[0,3,17.1,18.26,"hva"],[4,10,18.26,18.82,"koster"],[11,16,18.82,19.4,"disse"],[17,24,19.4,19.92,"fuglene"]]},{"id":1,"start":20.9,"end":25.06,"speaker":"Assistant","text":"De hvite fuglene koster hundre og førti kroner.","zh":"白色的小鸟要 140 克朗。","words":[[0,2,20.9,21.56,"de@ty-de-definite"],[3,8,21.56,22.1,"hvite"],[9,16,22.1,22.78,"fuglene"],[17,23,22.78,23.48,"koster"],[24,30,23.48,23.96,"hundre"],[31,33,23.96,24.06,"og"],[34,39,24.06,24.5,"førti"],[40,46,24.5,25.06,"kroner"]]},{"id":2,"start":25.35,"end":29.93,"speaker":"Assistant","text":"De grønne fuglene koster to hundre og ti kroner.","zh":"绿色的小鸟要 210 克朗。","words":[[0,2,25.35,26.33,"de@ty-de-definite"],[3,9,26.33,26.93,"grønne"],[10,17,26.93,27.59,"fuglene"],[18,24,27.59,28.29,"koster"],[25,27,28.29,28.65,"to"],[28,34,28.65,29.03,"hundre"],[35,37,29.03,29.13,"og"],[38,40,29.13,29.41,"ti"],[41,47,29.41,29.93,"kroner"]]},{"id":3,"start":30.48,"end":31.62,"speaker":"Olav","text":"Det er dyrt.","zh":"真贵。","words":[[0,3,30.48,30.86,"det@ty-det-price"],[4,6,30.86,31.08,"er@ty-be-description"],[7,11,31.08,31.62,"dyrt"]]},{"id":4,"start":32.58,"end":34.04,"speaker":"Assistant","text":"Det er ikke billig.","zh":"是不便宜。","words":[[0,3,32.58,33.04,"det@ty-det-price"],[4,6,33.04,33.24,"er@ty-be-description"],[7,11,33.24,33.58,"ikke"],[12,18,33.58,34.04,"billig"]]},{"id":5,"start":34.88,"end":36.48,"speaker":"Assistant","text":"Men de er fine.","zh":"不过它们很漂亮。","words":[[0,3,34.88,35.16,"men"],[4,6,35.16,35.68,"de@ty-de-pronoun"],[7,9,35.68,36.1,"er@ty-be-description"],[10,14,36.1,36.48,"fine"]]},{"id":6,"start":37.16,"end":39.42,"speaker":"Olav","text":"Hva koster lysestaken?","zh":"那个烛台多少钱？","words":[[0,3,37.16,37.68,"hva"],[4,10,37.68,38.22,"koster"],[11,21,38.22,39.42,"lysestaken"]]},{"id":7,"start":39.8,"end":44.76,"speaker":"Assistant","text":"Den store lysestaken koster tre hundre og seksti kroner.","zh":"那个大烛台要 360 克朗。","words":[[0,3,39.8,40.44,"den@ty-den-definite"],[4,9,40.44,40.9,"store"],[10,20,40.9,41.98,"lysestaken"],[21,27,41.98,42.76,"koster"],[28,31,42.76,43.24,"tre"],[32,38,43.24,43.64,"hundre"],[39,41,43.64,43.78,"og"],[42,48,43.78,44.24,"seksti"],[49,55,44.24,44.76,"kroner"]]},{"id":8,"start":45.5,"end":47.76,"speaker":"Olav","text":"Jeg vil gjerne kjøpe en hvit fugl.","zh":"我想买一只白色的小鸟。","words":[[0,3,45.5,45.66,"jeg"],[4,7,45.66,45.82,"vil"],[8,14,45.82,46.32,"gjerne"],[15,20,46.32,46.86,"kjøpe"],[21,23,46.86,47.02,"en"],[24,28,47.02,47.32,"hvit"],[29,33,47.32,47.76,"fugl"]]},{"id":9,"start":48.02,"end":49.72,"speaker":"Assistant","text":"Jeg skal pakke den inn.","zh":"我帮您包起来。","words":[[0,3,48.02,48.38,"jeg"],[4,8,48.38,48.76,"skal"],[9,14,48.76,49.26,"pakke"],[15,18,49.26,49.46,"den@ty-den-object"],[19,22,49.46,49.72,"inn"]]}],"lexicon":{"billig":{"lemma":"billig","zh":"便宜的","pos":"形容词","ref":"ty-conversation-6-002","clip":null},"de":{"lemma":"de","zh":"它们","pos":"代词","ref":"ty-conversation-6-005","clip":null,"form":"复数主格"},"de@ty-de-definite":{"lemma":"de","zh":"这些；那些（与形容词构成复数定指）","pos":"定冠词","ref":"ty-conversation-6-005","clip":null,"form":"复数","contextual":true,"baseKey":"de","surface":"de"},"de@ty-de-pronoun":{"lemma":"de","zh":"它们（指裤子或纪念品）","pos":"代词","ref":"ty-conversation-6-005","clip":null,"form":"复数主格","contextual":true,"baseKey":"de","surface":"de"},"den":{"lemma":"den","zh":"它（指前面的旅游指南）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性"},"den@ty-den-definite":{"lemma":"den","zh":"那个（与形容词一起构成单数定指）","pos":"定冠词","ref":"ty-conversation-4-003","clip":null,"form":"通性","contextual":true,"baseKey":"den","surface":"den"},"den@ty-den-object":{"lemma":"den","zh":"它（指买下的白色小鸟）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性宾格","conte