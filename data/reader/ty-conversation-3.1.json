{"id":"ty-conversation-3.1","bookId":"ty-conversation-guide","readingId":"3.1","title":"Asking the way","audio":"audio/ty-conversation/3.1.mp3","duration":46.23675,"synthetic":false,"sentences":[{"id":0,"start":1.13,"end":5.055,"speaker":"Girl","text":"Unnskyld, vet du hvor Nationalgalleriet er?","zh":"打扰一下，你知道国家美术馆在哪里吗？","words":[[0,8,1.13,1.635,"unnskyld"],[10,13,2.31,2.615,"vet"],[14,16,2.65,2.815,"du"],[17,21,3.07,3.315,"hvor"],[22,39,3.49,4.755,"nationalgalleriet"],[40,42,4.83,5.055,"er@ty-be-location"]]},{"id":1,"start":6.39,"end":9.695,"speaker":"Olav","text":"Ja. Du er i Karl Johans gate.","zh":"知道。你现在在卡尔·约翰大街。","words":[[0,2,6.39,6.535,"ja"],[4,6,7.59,7.735,"du"],[7,9,7.85,8.115,"er@ty-be-location"],[10,11,8.31,8.415,"i@ty-place"],[12,16,8.43,8.742,"karl"],[17,23,8.742,9.273,"johans"],[24,28,9.273,9.695,"gate"]]},{"id":2,"start":10.99,"end":12.055,"speaker":"Olav","text":"Gå rett frem.","zh":"一直往前走。","words":[[0,2,10.99,11.115,"gå@ty-walk-imperative"],[3,7,11.21,11.555,"rett@ty-straight"],[8,12,11.81,12.055,"frem"]]},{"id":3,"start":13.21,"end":15.435,"speaker":"Olav","text":"Stortinget er til venstre.","zh":"议会大厦在左边。","words":[[0,10,13.21,13.995,"stortinget"],[11,13,14.61,14.752,"er@ty-be-location"],[14,17,14.752,14.915,"til"],[18,25,14.93,15.435,"venstre"]]},{"id":4,"start":16.61,"end":19.035,"speaker":"Girl","text":"Jeg vet hvor Stortinget er.","zh":"我知道议会大厦在哪里。","words":[[0,3,16.61,16.795,"jeg"],[4,7,16.87,17.215,"vet"],[8,12,17.39,17.635,"hvor"],[13,23,17.91,18.635,"stortinget"],[24,26,18.79,19.035,"er@ty-be-location"]]},{"id":5,"start":20.39,"end":22.695,"speaker":"Olav","text":"Du ser Slottet rett frem.","zh":"你会看见正前方的王宫。","words":[[0,2,20.39,20.535,"du"],[3,6,20.59,20.835,"ser"],[7,14,21.19,21.715,"slottet"],[15,19,22.13,22.435,"rett@ty-straight"],[20,24,22.45,22.695,"frem"]]},{"id":6,"start":23.77,"end":24.855,"speaker":"Olav","text":"Gå til høyre.","zh":"向右拐。","words":[[0,2,23.77,23.915,"gå@ty-walk-imperative"],[3,6,24.07,24.255,"til"],[7,12,24.49,24.855,"høyre"]]},{"id":7,"start":26.23,"end":28.975,"speaker":"Olav","text":"Nationalgalleriet er til venstre.","zh":"国家美术馆在左边。","words":[[0,17,26.23,27.395,"nationalgalleriet"],[18,20,28.17,28.312,"er@ty-be-location"],[21,24,28.312,28.475,"til"],[25,32,28.51,28.975,"venstre"]]},{"id":8,"start":30.21,"end":33.455,"speaker":"Girl","text":"Takk. Nå vet jeg hvor jeg skal gå.","zh":"谢谢。我现在知道该怎么走了。","words":[[0,4,30.21,30.495,"takk"],[6,8,31.29,31.435,"nå@ty-now"],[9,12,31.69,31.982,"vet"],[13,16,31.982,32.175,"jeg"],[17,21,32.39,32.655,"hvor"],[22,25,32.85,33.032,"jeg"],[26,30,33.032,33.255,"skal"],[31,33,33.31,33.455,"gå@ty-walk-infinitive"]]},{"id":9,"start":34.75,"end":36.175,"speaker":"Olav","text":"Jeg skal gå med deg.","zh":"我和你一起走吧。","words":[[0,3,34.75,34.935,"jeg"],[4,8,34.99,35.235,"skal"],[9,11,35.29,35.435,"gå@ty-walk-infinitive"],[12,15,35.75,35.975,"med@ty-with-person"],[16,19,35.99,36.175,"deg"]]},{"id":10,"start":36.85,"end":37.835,"speaker":"Girl","text":"Tusen takk!","zh":"太感谢了！","words":[[0,5,36.85,37.395,"tusen"],[6,10,37.51,37.835,"takk"]]},{"id":11,"start":39.79,"end":42.695,"speaker":"Girl","text":"Jeg vil gjerne gå til Nationalgalleriet.","zh":"我很想去国家美术馆。","words":[[0,3,39.79,39.995,"jeg"],[4,7,40.01,40.175,"vil"],[8,14,40.23,40.635,"gjerne"],[15,17,40.93,41.095,"gå@ty-walk-infinitive"],[18,21,41.37,41.555,"til"],[22,39,41.61,42.695,"nationalgalleriet"]]},{"id":12,"start":43.91,"end":44.815,"speaker":"Olav","text":"Jeg også!","zh":"我也是！","words":[[0,3,43.91,44.155,"jeg"],[4,8,44.45,44.815,"også"]]}],"lexicon":{"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-location":{"lemma":"være","zh":"在（某处）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"e