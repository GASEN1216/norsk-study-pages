{"id":"ty-conversation-3.1","bookId":"ty-conversation-guide","readingId":"3.1","title":"Asking the way","audio":"audio/ty-conversation/3.1.mp3","duration":46.23675,"synthetic":false,"sentences":[{"id":0,"start":1.18,"end":5.16,"speaker":"Girl","text":"Unnskyld, vet du hvor Nationalgalleriet er?","zh":"打扰一下，你知道国家美术馆在哪里吗？","words":[[0,8,1.18,2.14,"unnskyld"],[10,13,2.32,2.64,"vet"],[14,16,2.64,3.1,"du"],[17,21,3.1,3.54,"hvor"],[22,39,3.54,4.82,"nationalgalleriet"],[40,42,4.82,5.16,"er@ty-be-location"]]},{"id":1,"start":6.34,"end":9.8,"speaker":"Olav","text":"Ja. Du er i Karl Johans gate.","zh":"知道。你现在在卡尔·约翰大街。","words":[[0,2,6.34,6.88,"ja"],[4,6,7.48,7.82,"du"],[7,9,7.82,8.26,"er@ty-be-location"],[10,11,8.26,8.52,"i@ty-place"],[12,16,8.52,8.8,"karl"],[17,23,8.8,9.34,"johans"],[24,28,9.34,9.8,"gate"]]},{"id":2,"start":11.02,"end":12.98,"speaker":"Olav","text":"Gå rett frem.","zh":"一直往前走。","words":[[0,2,11.02,11.24,"gå@ty-walk-imperative"],[3,7,11.24,11.9,"rett@ty-straight"],[8,12,11.9,12.98,"frem"]]},{"id":3,"start":13.46,"end":15.54,"speaker":"Olav","text":"Stortinget er til venstre.","zh":"议会大厦在左边。","words":[[0,10,13.46,14.46,"stortinget"],[11,13,14.46,14.82,"er@ty-be-location"],[14,17,14.82,15.04,"til"],[18,25,15.04,15.54,"venstre"]]},{"id":4,"start":16.6,"end":19.24,"speaker":"Girl","text":"Jeg vet hvor Stortinget er.","zh":"我知道议会大厦在哪里。","words":[[0,3,16.6,16.9,"jeg"],[4,7,16.9,17.32,"vet"],[8,12,17.32,17.96,"hvor"],[13,23,17.96,18.86,"stortinget"],[24,26,18.86,19.24,"er@ty-be-location"]]},{"id":5,"start":20.4,"end":23.56,"speaker":"Olav","text":"Du ser Slottet rett frem.","zh":"你会看见正前方的王宫。","words":[[0,2,20.4,20.62,"du"],[3,6,20.62,21.16,"ser"],[7,14,21.16,22.16,"slottet"],[15,19,22.16,22.6,"rett@ty-straight"],[20,24,22.6,23.56,"frem"]]},{"id":6,"start":23.86,"end":25.22,"speaker":"Olav","text":"Gå til høyre.","zh":"向右拐。","words":[[0,2,23.86,24.08,"gå@ty-walk-imperative"],[3,6,24.08,24.52,"til"],[7,12,24.52,25.22,"høyre"]]},{"id":7,"start":26.32,"end":29.1,"speaker":"Olav","text":"Nationalgalleriet er til venstre.","zh":"国家美术馆在左边。","words":[[0,17,26.32,27.98,"nationalgalleriet"],[18,20,27.98,28.38,"er@ty-be-location"],[21,24,28.38,28.56,"til"],[25,32,28.56,29.1,"venstre"]]},{"id":8,"start":30.32,"end":33.72,"speaker":"Girl","text":"Takk. Nå vet jeg hvor jeg skal gå.","zh":"谢谢。我现在知道该怎么走了。","words":[[0,4,30.32,31.12,"takk"],[6,8,31.14,31.7,"nå@ty-now"],[9,12,31.7,32.02,"vet"],[13,16,32.02,32.38,"jeg"],[17,21,32.38,32.76,"hvor"],[22,25,32.76,33.08,"jeg"],[26,30,33.08,33.32,"skal"],[31,33,33.32,33.72,"gå@ty-walk-infinitive"]]},{"id":9,"start":34.8,"end":36.64,"speaker":"Olav","text":"Jeg skal gå med deg.","zh":"我和你一起走吧。","words":[[0,3,34.8,35.04,"jeg"],[4,8,35.04,35.3,"skal"],[9,11,35.3,35.72,"gå@ty-walk-infinitive"],[12,15,35.72,36.02,"med@ty-with-person"],[16,19,36.02,36.64,"deg"]]},{"id":10,"start":37.02,"end":38.94,"speaker":"Girl","text":"Tusen takk!","zh":"太感谢了！","words":[[0,5,37.02,37.6,"tusen"],[6,10,37.6,38.94,"takk"]]},{"id":11,"start":39.68,"end":43.36,"speaker":"Girl","text":"Jeg vil gjerne gå til Nationalgalleriet.","zh":"我很想去国家美术馆。","words":[[0,3,39.68,40.04,"jeg"],[4,7,40.04,40.28,"vil"],[8,14,40.28,40.94,"gjerne"],[15,17,40.94,41.28,"gå@ty-walk-infinitive"],[18,21,41.28,41.66,"til"],[22,39,41.66,43.36,"nationalgalleriet"]]},{"id":12,"start":44.0,"end":44.86,"speaker":"Olav","text":"Jeg også!","zh":"我也是！","words":[[0,3,44.0,44.42,"jeg"],[4,8,44.42,44.86,"også"]]}],"lexicon":{"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-location":{"lemma":"være","zh":"在（某处）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"frem":{"lemma":"frem","zh":"向前；前方（rett frem：正前方）","pos":"副词","ref":null,"clip":null},"g