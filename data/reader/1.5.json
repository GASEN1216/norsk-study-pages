{"id":"1.5","title":"Yrkestekst: Jeg er lærer","audio":"audio/1.5.mp3","duration":44.01,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":6.27,"text":"1.5 Yrke: Jeg er lærer","heading":true,"zh":"1.5 职业：我是老师","words":[[0,3,0.15,1.08,"1.5"],[4,8,2.64,3.14,"yrke"],[10,13,4.45,4.97,"jeg"],[14,16,4.97,5.47,"er"],[17,22,5.47,6.19,"lærer~37398342c31f"]]},{"id":1,"start":8.23,"end":11.93,"text":"Jeg heter Håvard og er lærer.","zh":"我叫霍瓦尔，是一名老师。","words":[[0,3,8.31,8.68,"jeg"],[4,9,8.68,9.2,"heter"],[10,16,9.2,9.9,"håvard"],[17,19,9.9,10.56,"og"],[20,22,10.56,11.02,"er"],[23,28,11.02,11.85,"lærer~37398342c31f"]]},{"id":2,"start":12.75,"end":15.14,"text":"Jeg underviser i norsk.","zh":"我教挪威语。","words":[[0,3,12.83,13.14,"jeg"],[4,14,13.14,14.1,"underviser"],[15,16,14.1,14.42,"i~38dad6ff72ac"],[17,22,14.42,15.06,"norsk~4de5d75feae1"]]},{"id":3,"start":15.76,"end":18.2,"text":"Det er en fantastisk jobb.","zh":"这是一份很棒的工作。","words":[[0,3,15.84,16.12,"det"],[4,6,16.12,16.54,"er"],[7,9,16.54,16.82,"en~a939a9e56dc5"],[10,20,16.82,17.78,"fantastisk"],[21,25,17.78,18.11,"jobb"]]},{"id":4,"start":18.87,"end":21.61,"text":"Jeg møter folk fra mange land.","zh":"我会遇见来自许多国家的人。","words":[[0,3,18.95,19.24,"jeg"],[4,9,19.24,19.88,"møter~706cbd2ac765"],[10,14,19.88,20.26,"folk"],[15,18,20.26,20.66,"fra"],[19,24,20.66,21.04,"mange"],[25,29,21.04,21.53,"land"]]},{"id":5,"start":24.05,"end":27.83,"text":"Nå er det pause. Hva gjør dere?","speaker":"Håvard","zh":"现在是休息时间。你们做什么？","words":[[0,2,24.13,24.44,"nå~d531d47a7712"],[3,5,24.44,24.8,"er"],[6,9,24.8,24.92,"det"],[10,15,24.92,25.2,"pause"],[17,20,26.6,27.12,"hva"],[21,25,27.12,27.42,"gjør"],[26,30,27.42,27.75,"dere"]]},{"id":6,"start":28.89,"end":31.36,"text":"Jeg drikker te i pausen.","speaker":"Viola","zh":"我休息时喝茶。","words":[[0,3,28.97,29.38,"jeg"],[4,11,29.38,29.9,"drikker~8bc6fe28e25c"],[12,14,29.9,30.2,"te"],[15,16,30.2,30.6,"i~cdd8a4a3d8b1"],[17,23,30.6,31.28,"pausen"]]},{"id":7,"start":32.61,"end":34.95,"text":"Jeg drikker kaffe i pausen.","speaker":"Marek","zh":"我休息时喝咖啡。","words":[[0,3,32.69,32.99,"jeg"],[4,11,32.99,33.41,"drikker~8bc6fe28e25c"],[12,17,33.41,33.97,"kaffe"],[18,19,33.97,34.25,"i~cdd8a4a3d8b1"],[20,26,34.25,34.87,"pausen"]]},{"id":8,"start":36.15,"end":38.69,"text":"Jeg spiser mat i pausen.","speaker":"Biniam","zh":"我休息时吃东西。","words":[[0,3,36.23,36.62,"jeg"],[4,10,36.62,37.3,"spiser"],[11,14,37.3,37.68,"mat"],[15,16,37.68,38.04,"i~cdd8a4a3d8b1"],[17,23,38.04,38.61,"pausen"]]},{"id":9,"start":38.8,"end":43.3,"text":"Jeg snakker med Biniam i pausen.","speaker":"Sompit","zh":"我休息时和比尼亚姆聊天。","words":[[0,3,39.58,40.62,"jeg"],[4,11,40.62,41.42,"snakker"],[12,15,41.42,41.62,"med"],[16,22,41.62,42.24,"biniam"],[23,24,42.24,42.56,"i~cdd8a4a3d8b1"],[25,31,42.56,43.22,"pausen"]]}],"lexicon":{"1.5":{"lemma":"1.5","zh":"第 1.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"biniam":{"lemma":"Biniam","zh":"比尼亚姆（人名）","pos":"专名","ref":"1-021","clip":"pronunciation/e8a134405844f1e3c9ba.mp3"},"dere":{"lemma":"dere","zh":"你们（主格和宾格同形）","pos":"代词","ref":"1-052","clip":"pronunciation/63f86c0bc4fdac62d92b.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时","clip":"pronunciation/665ab7c0b1f21648dfe4.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke","form":"复数不定"}]},"en":{"lemma":"en","zh":"一（个）（阳性不定冠词）；一","pos":"冠词／数词","form":"阳性","ref":"1-106","clip":"pronunciation/dbd3a49d0d906b4ed921.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"fantastisk":{"lemma":"fantastisk","zh":"极好的；很棒的；精彩的","pos":"形容词","ref":"1-117","clip":"pronunciation/a0f4dbc30b0ee5fd0895.mp3"},"folk":{"lemma":"folk","zh":"人","pos":"名词","ref":"1