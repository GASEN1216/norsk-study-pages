{"id":"11.5","title":"Yrkestekst: Jeg er turistguide","audio":"audio/11.5.mp3","duration":87.52,"synthetic":false,"sentences":[{"id":0,"start":0.47,"end":5.97,"text":"11.5 Yrke: Jeg er turistguide","heading":true,"zh":"11.5 职业：我是导游","words":[[0,4,0.47,1.67,"11.5"],[5,9,2.42,2.96,"yrke"],[11,14,4.09,4.53,"jeg"],[15,17,4.53,4.89,"er"],[18,29,4.89,5.89,"turistguide"]]},{"id":1,"start":8.79,"end":10.77,"text":"Jeg er turistguide.","zh":"我是导游。","words":[[0,3,8.85,9.3,"jeg"],[4,6,9.3,9.66,"er"],[7,18,9.66,10.62,"turistguide"]]},{"id":2,"start":11.56,"end":16.42,"text":"Hver sommer møter jeg turister og viser dem rundt i sentrum.","zh":"每年夏天我都会接待游客，带他们在市中心四处参观。","words":[[0,4,11.62,12.14,"hver"],[5,11,12.14,12.71,"sommer"],[12,17,12.82,13.34,"møter~13bceae2de3b"],[18,21,13.34,13.6,"jeg"],[22,30,13.6,14.42,"turister"],[31,33,14.42,14.58,"og"],[34,39,14.58,14.98,"viser~70438fbfcfd6"],[40,43,14.98,15.2,"dem"],[44,49,15.2,15.58,"rundt~08788d8498e1"],[50,51,15.58,15.7,"i"],[52,59,15.7,16.27,"sentrum"]]},{"id":3,"start":17.64,"end":21.49,"text":"Jeg forteller om byens historie og om alle bygningene.","zh":"我给他们讲这座城市的历史和所有的建筑。","words":[[0,3,17.7,17.92,"jeg"],[4,13,17.92,18.44,"forteller"],[14,16,18.44,18.58,"om~52c0bdc828db"],[17,22,18.58,18.96,"byens"],[23,31,18.96,19.73,"historie"],[32,34,20.1,20.24,"og"],[35,37,20.24,20.4,"om~52c0bdc828db"],[38,42,20.4,20.64,"alle~6873d9584096"],[43,53,20.64,21.34,"bygningene"]]},{"id":4,"start":22.64,"end":26.91,"text":"Jeg snakker flytende engelsk, tysk og fransk.","zh":"我能说流利的英语、德语和法语。","words":[[0,3,22.7,23.02,"jeg"],[4,11,23.02,23.46,"snakker"],[12,20,23.46,24.22,"flytende"],[21,28,24.22,25.11,"engelsk~220c678f9536"],[30,34,25.36,25.99,"tysk~0c554eadba73"],[35,37,26.18,26.28,"og"],[38,44,26.28,26.76,"fransk~17dd7082ab95"]]},{"id":5,"start":27.66,"end":33.21,"text":"Turistene spør om alt mulig rart, og jeg svarer så godt jeg kan.","zh":"游客们会问各种稀奇古怪的问题，我尽我所能地回答。","words":[[0,9,27.71,28.46,"turistene"],[10,14,28.46,28.76,"spør"],[15,17,28.76,29.08,"om~52c0bdc828db"],[18,21,29.08,29.6,"alt"],[22,27,29.6,30.0,"mulig~2d187e59fdf9"],[28,32,30.0,30.55,"rart~43b4cd592dd9"],[34,36,31.12,31.26,"og"],[37,40,31.26,31.66,"jeg"],[41,47,31.66,32.22,"svarer"],[48,50,32.22,32.36,"så~fdaf63413085"],[51,55,32.36,32.64,"godt~28a24c509f3c"],[56,59,32.64,32.78,"jeg"],[60,63,32.78,33.06,"kan"]]},{"id":6,"start":36.85,"end":38.83,"text":"En turistguide i Tromsø.","zh":"特罗姆瑟的一位导游。","words":[[0,2,36.91,37.26,"en~a939a9e56dc5"],[3,14,37.26,38.04,"turistguide"],[15,16,38.04,38.12,"i"],[17,23,38.12,38.68,"tromsø"]]},{"id":7,"start":40.75,"end":47.63,"text":"Tromsø er den største byen i Nord-Norge, og byen kalles også Nordens Paris.","speaker":"Turistguide","zh":"特罗姆瑟是北挪威最大的城市，它也被称为“北方的巴黎”。","words":[[0,6,40.81,41.48,"tromsø"],[7,9,41.48,41.62,"er"],[10,13,41.62,41.8,"den~5f413bef0ba1"],[14,21,41.8,42.32,"største~cf448fdd1a9c"],[22,26,42.32,42.68,"byen"],[27,28,42.68,42.78,"i"],[29,39,42.78,43.55,"nord-norge"],[41,43,44.18,44.36,"og"],[44,48,44.36,44.78,"byen"],[49,55,44.78,45.18,"kalles"],[56,60,45.18,45.67,"også"],[61,68,46.08,46.8,"nordens"],[69,74,46.8,47.48,"paris"]]},{"id":8,"start":48.81,"end":50.95,"text":"Hvor mange innbyggere er det her?","speaker":"Turist","zh":"这里有多少居民？","words":[[0,4,48.88,49.14,"hvor~c956fb20e4f1"],[5,10,49.14,49.62,"mange"],[11,21,49.62,50.2,"innbyggere"],[22,24,50.2,50.34,"er"],[25,28,50.34,50.48,"det"],[29,32,50.48,50.8,"her"]]},{"id":9,"start":51.95,"end":60.08,"text":"Det er cirka 75 000 innbyggere. Her til høyre ser dere Ishavskatedralen.","speaker":"Turistguide","zh":"大约有7.5万居民。在右边，你们可以看到北极大教堂。","words":[[0,3,52.02,52.22,"det"],[4,6,52.22,52.4,"er"],[7,12,52.4,52.92,"cirka"],[13,15,52.92,53.72,"75"],[16,19,53.72,54.14,"000~bde53e235bd3"],[20,30,54.14,54.84,"innbyggere"],[32,35,56.26,56.48,"her"],[36,39,56.48,56.66,"til~689d644feee8"],[40,45,56.66,57.21,"høyre"],[46,49,57.64,57.86,"ser"],[50,54,57.86,58.3,"dere"],[55,71,58.4,59.93,"ishavskatedralen"]]},{"id":10,"start":61.53,"end":67.87,"text":"Å, den var flott. Vi er litt sultne nå. Hvor kan vi finne de beste restaurantene?","speaker":"Turist","zh":"哦，它真漂亮。我们现在有点饿了。在哪里能找到最好的餐厅？","words":[[0,1,61.59,61.9,"å~496a48c13525"],[3,6,61.9,62.14,"den"],[7,10,62.14,62.32,"var"],[11,16,62.32,62.94,"flott"],[18,20,63.84,63.94,"vi"],[21,23,63.94,64.04,"er"],[24,28,64.04,64.26,"litt~54360be2a478"],[29,35,64.26,64.9,"sultne"],[36,38,64.9,65.2,"nå~d531d47a7712"],[40,44,65.62,65.88,"hvor"],[45,48,65.88,66.08,"kan"],[49,51,66.08,66.22,"vi"],[52,57,66.22,66.5,"finne"],[58,60,66.5,66.64,"de~d251aa490218"],[61,66,66.64,66.94,"beste~93f2e4b8bc18"],[67,80,66.94,67.72,"restaurantene"]]},{"id":11,"start":69.03,"end":71.88,"text":"Det er mange gode restauranter i sentrum.","speaker":"Turistguide","zh":"市中心有很多好餐厅。","words":[[0,3,69.09,69.28,"det"],[4,6,69.28,69.52,"er"],[7,12,69.52,70.06,"mange"],[13,17,70.06,70.32,"gode"],[18,30,70.32,71.1,"restauranter"],[31,32,71.1,71.2,"i"],[33,40,71.2,71.73,"sentrum"]]},{"id":12,"start":73.06,"end":75.45,"text":"Hva liker folk best å gjøre her?","speaker":"Turist","zh":"人们最喜欢在这里做什么？","words":[[0,3,73.12,73.28,"hva"],[4,9,73.28,73.68,"liker"],[10,14,73.68,73.98,"folk"],[15,19,73.98,74.38,"best~fbe395e1504f"],[20,21,74.38,74.62,"å~0583da7a620a"],[22,27,74.62,74.94,"gjøre"],[28,31,74.94,75.3,"her"]]},{"id":13,"start":76.77,"end":86.24,"text":"Mange liker å dra på tur i den fantastiske naturen. Om vinteren prøver både innbyggere og turister å fotografere nordlyset.","speaker":"Turistguide","zh":"很多人喜欢到美妙的大自然中远足。冬天，居民和游客都会尝试拍摄北极光。","words":[[0,5,76.83,77.38,"mange"],[6,11,77.38,77.82,"liker"],[12,13,77.82,77.9,"å~0583da7a620a"],[14,17,77.9,78.14,"dra"],[18,20,78.14,78.32,"på~73ca144777d2"],[21,24,78.32,78.58,"tur"],[25,26,78.58,78.68,"i"],[27,30,78.68,78.84,"den~5f413bef0ba1"],[31,42,78.84,79.64,"fantastiske"],[43,50,79.64,80.36,"naturen"],[52,54,81.22,81.38,"om~1e753acc270b"],[55,63,81.38,82.12,"vinteren"],[64,70,82.22,82.64,"prøver~6c0afa2c7cab"],[71,75,82.64,82.92,"både"],[76,86,82.92,83.68,"