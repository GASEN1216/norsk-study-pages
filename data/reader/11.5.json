{"id":"11.5","title":"Yrkestekst: Jeg er turistguide","audio":"audio/11.5.mp3","duration":87.52,"synthetic":false,"sentences":[{"id":0,"start":0.47,"end":5.97,"text":"11.5 Yrke: Jeg er turistguide","heading":true,"zh":"11.5 职业：我是导游","words":[[0,4,0.47,1.67,"11.5"],[5,9,2.42,2.96,"yrke"],[11,14,4.09,4.53,"jeg"],[15,17,4.53,4.89,"er"],[18,29,4.89,5.89,"turistguide"]]},{"id":1,"start":8.75,"end":10.71,"text":"Jeg er turistguide.","zh":"我是导游。","words":[[0,3,8.83,9.19,"jeg"],[4,6,9.19,9.53,"er"],[7,18,9.53,10.63,"turistguide"]]},{"id":2,"start":11.53,"end":16.35,"text":"Hver sommer møter jeg turister og viser dem rundt i sentrum.","zh":"每年夏天我都会接待游客，带他们在市中心四处参观。","words":[[0,4,11.61,12.05,"hver"],[5,11,12.05,12.53,"sommer"],[12,17,12.53,13.29,"møter~13bceae2de3b"],[18,21,13.29,13.49,"jeg"],[22,30,13.49,14.15,"turister"],[31,33,14.15,14.51,"og"],[34,39,14.51,14.95,"viser~70438fbfcfd6"],[40,43,14.95,15.09,"dem"],[44,49,15.09,15.41,"rundt~08788d8498e1"],[50,51,15.41,15.65,"i"],[52,59,15.65,16.27,"sentrum"]]},{"id":3,"start":17.59,"end":21.44,"text":"Jeg forteller om byens historie og om alle bygningene.","zh":"我给他们讲这座城市的历史和所有的建筑。","words":[[0,3,17.68,17.85,"jeg"],[4,13,17.85,18.31,"forteller"],[14,16,18.31,18.53,"om~52c0bdc828db"],[17,22,18.53,18.91,"byens"],[23,31,18.91,19.59,"historie"],[32,34,19.59,20.23,"og"],[35,37,20.23,20.39,"om~52c0bdc828db"],[38,42,20.39,20.53,"alle~6873d9584096"],[43,53,20.53,21.36,"bygningene"]]},{"id":4,"start":22.61,"end":26.85,"text":"Jeg snakker flytende engelsk, tysk og fransk.","zh":"我能说流利的英语、德语和法语。","words":[[0,3,22.69,22.94,"jeg"],[4,11,22.94,23.34,"snakker"],[12,20,23.34,24.04,"flytende"],[21,28,24.04,24.92,"engelsk~220c678f9536"],[30,34,25.32,25.8,"tysk~0c554eadba73"],[35,37,25.8,26.24,"og"],[38,44,26.24,26.77,"fransk~17dd7082ab95"]]},{"id":5,"start":27.62,"end":33.17,"text":"Turistene spør om alt mulig rart, og jeg svarer så godt jeg kan.","zh":"游客们会问各种稀奇古怪的问题，我尽我所能地回答。","words":[[0,9,27.7,28.36,"turistene"],[10,14,28.36,28.64,"spør"],[15,17,28.64,28.86,"om~52c0bdc828db"],[18,21,28.86,29.38,"alt"],[22,27,29.38,29.96,"mulig~2d187e59fdf9"],[28,32,29.96,30.28,"rart~43b4cd592dd9"],[34,36,30.98,31.22,"og"],[37,40,31.22,31.52,"jeg"],[41,47,31.52,32.12,"svarer"],[48,50,32.12,32.3,"så~fdaf63413085"],[51,55,32.3,32.6,"godt~28a24c509f3c"],[56,59,32.6,32.74,"jeg"],[60,63,32.74,33.09,"kan"]]},{"id":6,"start":36.81,"end":38.78,"text":"En turistguide i Tromsø.","zh":"特罗姆瑟的一位导游。","words":[[0,2,36.89,37.07,"en~a939a9e56dc5"],[3,14,37.07,37.99,"turistguide"],[15,16,37.99,38.15,"i"],[17,23,38.15,38.7,"tromsø"]]},{"id":7,"start":39.01,"end":47.58,"text":"Tromsø er den største byen i Nord-Norge, og byen kalles også Nordens Paris.","speaker":"Turistguide","zh":"特罗姆瑟是北挪威最大的城市，它也被称为“北方的巴黎”。","words":[[0,6,40.44,41.36,"tromsø"],[7,9,41.36,41.58,"er"],[10,13,41.58,41.68,"den~5f413bef0ba1"],[14,21,41.68,42.18,"største~cf448fdd1a9c"],[22,26,42.18,42.64,"byen"],[27,28,42.64,42.72,"i"],[29,39,42.72,43.28,"nord-norge"],[41,43,43.82,44.3,"og"],[44,48,44.3,44.72,"byen"],[49,55,44.72,45.02,"kalles"],[56,60,45.02,45.46,"også"],[61,68,45.46,46.72,"nordens"],[69,74,46.72,47.5,"paris"]]},{"id":8,"start":48.77,"end":50.89,"text":"Hvor mange innbyggere er det her?","speaker":"Turist","zh":"这里有多少居民？","words":[[0,4,48.85,49.08,"hvor~c956fb20e4f1"],[5,10,49.08,49.34,"mange"],[11,21,49.34,50.12,"innbyggere"],[22,24,50.12,50.32,"er"],[25,28,50.32,50.42,"det"],[29,32,50.42,50.81,"her"]]},{"id":9,"start":51.92,"end":60.02,"text":"Det er cirka 75 000 innbyggere. Her til høyre ser dere Ishavskatedralen.","speaker":"Turistguide","zh":"大约有7.5万居民。在右边，你们可以看到北极大教堂。","words":[[0,3,52.0,52.19,"det"],[4,6,52.19,52.33,"er"],[7,12,52.33,52.77,"cirka"],[13,15,52.77,54.03,"75"],[16,19,52.77,54.03,"000~bde53e235bd3"],[20,30,54.03,54.63,"innbyggere"],[32,35,56.13,56.41,"her"],[36,39,56.41,56.57,"til~689d644feee8"],[40,45,56.57,57.09,"høyre"],[46,49,57.09,57.79,"ser"],[50,54,57.79,58.01,"dere"],[55,71,58.01,59.94,"ishavskatedralen"]]},{"id":10,"start":61.5,"end":67.81,"text":"Å, den var flott. Vi er litt sultne nå. Hvor kan vi finne de beste restaurantene?","speaker":"Turist","zh":"哦，它真漂亮。我们现在有点饿了。在哪里能找到最好的餐厅？","words":[[0,1,61.58,61.75,"å~496a48c13525"],[3,6,61.85,62.07,"den"],[7,10,62.07,62.25,"var"],[11,16,62.25,62.63,"flott"],[18,20,63.31,63.91,"vi"],[21,23,63.91,63.99,"er"],[24,28,63.99,64.17,"litt~54360be2a478"],[29,35,64.17,64.79,"sultne"],[36,38,64.79,65.05,"nå~d531d47a7712"],[40,44,65.59,65.81,"hvor"],[45,48,65.81,66.01,"kan"],[49,51,66.01,66.17,"vi"],[52,57,66.17,66.45,"finne"],[58,60,66.45,66.59,"de~d251aa490218"],[61,66,66.59,66.79,"beste~93f2e4b8bc18"],[67,80,66.79,67.73,"restaurantene"]]},{"id":11,"start":68.99,"end":71.82,"text":"Det er mange gode restauranter i sentrum.","speaker":"Turistguide","zh":"市中心有很多好餐厅。","words":[[0,3,69.07,69.28,"det"],[4,6,69.28,69.38,"er"],[7,12,69.38,69.86,"mange"],[13,17,69.86,70.24,"gode"],[18,30,70.24,70.9,"restauranter"],[31,32,70.9,71.16,"i"],[33,40,71.16,71.74,"sentrum"]]},{"id":12,"start":73.02,"end":75.39,"text":"Hva liker folk best å gjøre her?","speaker":"Turist","zh":"人们最喜欢在这里做什么？","words":[[0,3,73.1,73.21,"hva"],[4,9,73.21,73.59,"liker"],[10,14,73.59,73.81,"folk"],[15,19,73.81,74.15,"best~fbe395e1504f"],[20,21,74.15,74.51,"å~0583da7a620a"],[22,27,74.51,74.83,"gjøre"],[28,31,74.83,75.31,"her"]]},{"id":13,"start":76.48,"end":86.17,"text":"Mange liker å dra på tur i den fantastiske naturen. Om vinteren prøver både innbyggere og turister å fotografere nordlyset.","speaker":"Turistguide","zh":"很多人喜欢到美妙的大自然中远足。冬天，居民和游客都会尝试拍摄北极光。","words":[[0,5,76.48,77.29,"mange"],[6,11,77.29,77.77,"liker"],[12,13,77.77,77.87,"å~0583da7a620a"],[14,17,77.87,78.03,"dra"],[18,20,78.03,78.19,"på~73ca144777d2"],[21,24,78.19,78.49,"tur"],[25,26,78.49,78.67,"i"],[27,30,78.67,78.75,"den~5f413bef0ba1"],[31,42,78.75,79.57,"fantastiske"],[43,50,79.57,80.21,"naturen"],[52,54,80.96,81.32,"om~1e753acc270b"],[55,63,81.32,82.1,"vinteren"],[64,70,82.1,82.56,"prøver~6c0afa2c7cab"],[71,75,82.56,82.78,"båd