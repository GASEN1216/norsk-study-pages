{"id":"pa-vei-5.E","bookId":"pa-vei-textbook","readingId":"5.E","title":"På kafé","audio":"audio/pa-vei/5.E.mp3","duration":134.808,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.48,"end":3.505,"text":"E. På kafé","zh":"E. 在咖啡馆","words":[[0,1,1.48,1.86,"e"],[3,5,2.94,3.085,"på"],[6,10,3.16,3.505,"kafé"]]},{"id":1,"start":7.18,"end":8.285,"text":"Vil dere bestille nå?","zh":"你们现在要点单吗？","words":[[0,3,7.18,7.345,"vil"],[4,8,7.36,7.645,"dere"],[9,17,7.66,8.162,"bestille"],[18,20,8.162,8.285,"nå"]],"speaker":"Servitøren"},{"id":2,"start":9.124,"end":13.869,"text":"Ja takk. En kopp te med sitron og et glass vann.","zh":"好的，谢谢。一杯柠檬茶和一杯水。","words":[[0,2,9.124,9.289,"ja"],[3,7,9.404,9.729,"takk"],[9,11,10.604,10.749,"en"],[12,16,10.784,11.069,"kopp"],[17,19,11.104,11.309,"te"],[20,23,11.504,11.669,"med"],[24,30,11.684,12.249,"sitron"],[31,33,12.884,13.006,"og"],[34,36,13.006,13.189,"et"],[37,42,13.204,13.549,"glass"],[43,47,13.584,13.869,"vann"]],"speaker":"Monica"},{"id":3,"start":15.004,"end":15.809,"text":"Jeg tar en cola.","zh":"我要一杯可乐。","words":[[0,3,15.004,15.186,"jeg"],[4,7,15.186,15.377,"tar"],[8,10,15.377,15.486,"en"],[11,15,15.486,15.809,"cola"]],"speaker":"Pablo"},{"id":4,"start":17.064,"end":18.449,"text":"Vil dere ha noe å spise?","zh":"你们想吃点什么吗？","words":[[0,3,17.064,17.206,"vil"],[4,8,17.206,17.447,"dere"],[9,11,17.447,17.589,"ha"],[12,15,17.684,17.896,"noe"],[16,17,17.896,17.986,"å"],[18,23,17.986,18.449,"spise"]],"speaker":"Servitøren"},{"id":5,"start":19.784,"end":22.209,"text":"Hva koster et smørbrød med egg?","zh":"一份鸡蛋三明治多少钱？","words":[[0,3,19.784,19.949,"hva"],[4,10,20.024,20.507,"koster"],[11,13,20.507,20.689,"et"],[14,22,20.724,21.409,"smørbrød"],[23,26,21.744,21.909,"med"],[27,30,21.924,22.209,"egg"]],"speaker":"Monica"},{"id":6,"start":23.504,"end":24.789,"text":"46 kroner.","zh":"46 克朗。","words":[[0,2,23.504,24.329,"46"],[3,9,24.364,24.789,"kroner"]],"speaker":"Servitøren"},{"id":7,"start":26.044,"end":27.269,"text":"Jeg tar et smørbrød.","zh":"我要一份三明治。","words":[[0,3,26.044,26.229,"jeg"],[4,7,26.264,26.549,"tar"],[8,10,26.564,26.746,"et"],[11,19,26.746,27.269,"smørbrød"]],"speaker":"Monica"},{"id":8,"start":28.444,"end":28.729,"text":"Og du?","zh":"你呢？","words":[[0,2,28.444,28.587,"og"],[3,5,28.587,28.729,"du"]],"speaker":"Servitøren"},{"id":9,"start":30.104,"end":30.869,"text":"Ingenting, takk.","zh":"不用了，谢谢。","words":[[0,9,30.104,30.606,"ingenting"],[11,15,30.606,30.869,"takk"]],"speaker":"Pablo"},{"id":10,"start":32.164,"end":33.249,"text":"Skal du ikke spise?","zh":"你不吃东西吗？","words":[[0,4,32.164,32.409,"skal"],[5,7,32.424,32.556,"du"],[8,12,32.556,32.746,"ikke"],[13,18,32.746,33.249,"spise"]],"speaker":"Monica"},{"id":11,"start":34.524,"end":36.129,"text":"Nei, det er for tidlig.","zh":"不，现在还太早。","words":[[0,3,34.524,34.729,"nei"],[5,8,35.364,35.516,"det"],[9,11,35.516,35.636,"er"],[12,15,35.636,35.757,"for@pa-vei-for-excess"],[16,22,35.757,36.129,"tidlig"]],"speaker":"Pablo"},{"id":12,"start":37.084,"end":39.029,"text":"Og dessuten har jeg vondt i ei tann.","zh":"而且我有一颗牙疼。","words":[[0,2,37.084,37.227,"og"],[3,11,37.227,37.686,"dessuten"],[12,15,37.686,37.837,"har"],[16,19,37.837,37.977,"jeg"],[20,25,37.977,38.369,"vondt"],[26,27,38.484,38.576,"i"],[28,30,38.576,38.729,"ei"],[31,35,38.744,39.029,"tann"]],"speaker":"Pablo"},{"id":13,"start":40.184,"end":41.709,"text":"Da må du gå til tannlegen.","zh":"那你得去看牙医。","words":[[0,2,40.184,40.329,"da"],[3,5,40.364,40.507,"må"],[6,8,40.507,40.629,"du"],[9,11,40.644,40.789,"gå"],[12,15,40.824,40.989,"til"],[16,25,41.004,41.709,"tannlegen"]],"speaker":"Monica"},{"id":14,"start":43.184,"end":45.529,"text":"Ja, jeg skal til tannlegen på mandag.","zh":"是的，我星期一要去看牙医。","words":[[0,2,43.184,43.329,"ja"],[4,7,43.904,44.056,"jeg"],[8,12,44.056,44.249,"skal"],[13,16,44.304,44.469,"til"],[17,26,44.484,44.989,"tannlegen"],[27,29,45.024,45.149,"på"],[30,36,45.164,45.529,"mandag"]],"speaker":"Pablo"},{"id":15,"start":47.344,"end":51.349,"text":"Vær så god! En kopp te med sitron og et glass vann.","zh":"请用！一杯柠檬茶和一杯水。","words":[[0,3,47.344,47.529,"vær@pa-vei-vær-be"],[4,6,47.564,47.729,"så"],[7,10,47.744,48.029,"god"],[12,14,48.704,48.846,"en"],[15,19,48.846,49.149,"kopp"],[20,22,49.164,49.349,"te"],[23,26,49.444,49.606,"med"],[27,33,49.606,50.189,"sitron"],[34,36,50.524,50.656,"og"],[37,39,50.656,50.776,"et"],[40,45,50.776,51.049,"glass"],[46,50,51.064,51.349,"vann"]],"speaker":"Servitøren"},{"id":16,"start":52.424,"end":53.069,"text":"Mange takk.","zh":"非常感谢。","words":[[0,5,52.424,52.749,"mange"],[6,10,52.764,53.069,"takk"]],"speaker":"Monica"},{"id":17,"start":54.064,"end":54.929,"text":"Og et glass øl.","zh":"还有一杯啤酒。","words":[[0,2,54.064,54.209,"og"],[3,5,54.304,54.457,"et"],[6,11,54.457,54.749,"glass"],[12,14,54.764,54.929,"øl"]],"speaker":"Servitøren"},{"id":18,"start":56.044,"end":58.529,"text":"Et glass øl? Jeg vil ha cola!","zh":"一杯啤酒？我要的是可乐！","words":[[0,2,56.044,56.216,"et"],[3,8,56.216,56.489,"glass"],[9,11,56.564,56.729,"øl"],[13,16,57.764,57.907,"jeg"],[17,20,57.907,58.047,"vil"],[21,23,58.047,58.147,"ha"],[24,28,58.147,58.529,"cola"]],"speaker":"Pablo"},{"id":19,"start":59.92,"end":61.529,"text":"Å, beklager.","zh":"啊，抱歉。","words":[[0,1,59.92,60.32,"å"],[3,11,61.004,61.529,"beklager"]],"speaker":"Servitøren"},{"id":20,"start":62.884,"end":65.169,"text":"Unnskyld, men hvor er smørbrødet?","zh":"不好意思，三明治在哪里？","words":[[0,8,62.884,63.409,"unnskyld"],[10,13,63.884,64.049,"men"],[14,18,64.064,64.289,"hvor"],[19,21,64.304,64.469,"er"],[22,32,64.524,65.169,"smørbrødet"]],"speaker":"Monica"},{"id":21,"start":66.424,"end":69.749,"text":"Smørbrødet? Et øyeblikk!","zh":"三明治？请稍等！","words":[[0,10,66.424,67.269,"smørbrødet"],[12,14,69.144,69.337,"et"],[15,23,69.337,69.749,"øyeblikk"]],"speaker":"Servitøren"},{"id":22,"start":72.724,"end":74.149,"text":"Her er smørbrødet med egg.","zh":"这是鸡蛋三明治。","words":[[0,3,72.724,72.966,"her"],[4,6,72.966,73.109,"er"],[7,17,73.144,73.746,"smørbrødet"],[18,21,73.746,73.887,"med"],[22,25,73.887,74.149,"egg"]],"speaker":"Servitøren"},{"id":23,"start":75.184,"end":75.489,"text":"Takk.","zh":"谢谢。","words":[[0,4,75.184,75.489,"takk"]],"speaker":"Monica"},{"id":24,"start":76.784,"end":77.929,"text":"Og her er et glass øl.","zh":"这儿还有一杯啤酒。","words":[[0,2,76.784,76.906,"og"],[3,6,76.906,77.186,"her"],[7,9,77.186,77.356,"er"],[10,12,77.356,77.487,"et"],[13,18,77.487,77.746,"glass"],[19,21,77.746,77.929,"øl"]],"speaker":"Servitøren"},{"id":25,"start":78.884,"end":83.529,"text":"Øl? Nei, jeg vil ha ... Ok. Takk.","zh":"啤酒？不，我要的是……好吧，谢谢。","words":[[0,2,78.884,79.069,"øl"],[4,7,80.284,80.529,"nei"],[9,12,80.664,80.826,"jeg"],[13,16,80.826,80.966,"vil"],[17,19,80.966,81.089,"ha"],[24,26,82.644,82.869,"ok"],[28,32,83.224,83.529,"takk"]],"speaker":"Pablo"},{"id":26,"start":84.784,"end":86.369,"text":"Drikker du øl så tidlig?","zh":"你这么早就喝啤酒？","words":[[0,7,84.784,85.147,"drikker"],[8,10,85.147,85.269,"du"],[11,13,85.324,85.489,"øl"],[14,16,85.644,85.829,"så"],[17,23,86.004,86.369,"tidlig"]],"speaker":"Monica"},{"id":27,"start":87.604,"end":90.129,"text":"Ha, ha. Veldig morsomt. Skål!","zh":"哈哈，真好笑。干杯！","words":[[0,2,87.604,87.769,"ha"],[4,6,87.924,88.089,"ha"],[8,14,88.284,88.726,"veldig"],[15,22,88.726,89.229,"morsomt"],[24,28,89.824,90.129,"skål"]],"speaker":"Pablo"},{"id":28,"start":94.124,"end":94.909,"text":"Sammendrag.","zh":"摘要","words":[[0,10,94.124,94.909,"sammendrag"]]},{"id":29,"start":96.904,"end":99.249,"text":"Monica og Pablo er på kafé.","zh":"莫妮卡和巴勃罗在咖啡馆。","words":[[0,6,96.904,97.489,"monica"],[7,9,97.584,97.709,"og"],[10,15,97.744,98.289,"pablo"],[16,18,98.544,98.709,"er"],[19,21,98.724,98.849,"på"],[22,26,98.884,99.249,"kafé"]]},{"id":30,"start":100.984,"end":102.029,"text":"Pablo er tørst.","zh":"巴勃罗口渴了。","words":[[0,5,100.984,101.449,"pablo"],[6,8,101.464,101.587,"er"],[9,14,101.587,102.029,"tørst"]]},{"id":31,"start":104.004,"end":111.409,"text":"Monica er både sulten og tørst, og hun bestiller te, vann og et smørbrød med egg.","zh":"莫妮卡又饿又渴，她点了茶、水和一份鸡蛋三明治。","words":[[0,6,104.004,104.549,"monica"],[7,9,104.604,104.789,"er"],[10,14,104.804,105.049,"både"],[15,21,105.104,105.626,"sulten"],[22,24,105.626,105.727,"og"],[25,30,105.727,106.129,"tørst"],[32,34,107.244,107.356,"og"],[35,38,107.356,107.509,"hun"],[39,48,107.524,107.989,"bestiller"],[49,51,108.084,108.269,"te"],[53,57,109.164,109.509,"vann"],[58,60,110.144,110.267,"og"],[61,63,110.267,110.429,"et"],[64,72,110.464,110.996,"smørbrød"],[73,76,110.996,111.147,"med"],[77,80,111.147,111.409,"egg"]]},{"id":32,"start":113.284,"end":114.589,"text":"Pablo er ikke sulten.","zh":"巴勃罗不饿。","words":[[0,5,113.284,113.749,"pablo"],[6,8,113.784,113.936,"er"],[9,13,113.936,114.156,"ikke"],[14,20,114.156,114.589,"sulten"]]},{"id":33,"start":116.464,"end":117.909,"text":"Han har vondt i ei tann.","zh":"他有一颗牙疼。","words":[[0,3,116.464,116.649,"han"],[4,7,116.664,116.829,"har"],[8,13,116.884,117.267,"vondt"],[14,15,117.267,117.369,"i"],[16,18,117.404,117.549,"ei"],[19,23,117.564,117.909,"tann"]]},{"id":34,"start":120.104,"end":122.169,"text":"Han bestiller bare en cola.","zh":"他只点了一杯可乐。","words":[[0,3,120.104,120.289,"han"],[4,13,120.324,120.889,"bestiller"],[14,18,120.964,121.349,"bare"],[19,21,121.584,121.729,"en"],[22,26,121.764,122.169,"cola"]]},{"id":35,"start":124.564,"end":125.989,"text":"Servitøren er trøtt.","zh":"服务员很困。","words":[[0,10,124.564,125.376,"servitøren"],[11,13,125.376,125.509,"er"],[14,19,125.524,125.989,"trøtt"]]},{"id":36,"start":127.984,"end":133.149,"text":"Han kommer med vann, te og øl, men ikke med cola.","zh":"他端来了水、茶和啤酒，却没有可乐。","words":[[0,3,127.984,128.169,"han"],[4,10,128.184,128.507,"kommer"],[11,14,128.507,128.669,"med"],[15,19,128.684,129.029,"vann"],[21,23,129.564,129.769,"te"],[24,26,130.484,130.629,"og"],[27,29,130.724,130.889,"øl"],[31,34,132.064,132.229,"men"],[35,39,132.284,132.647,"ikke"],[40,43,132.647,132.806,"med"],[44,48,132.806,133.149,"cola"]]}],"lexicon":{"46":{"lemma":"46","pos":"数词","zh":"数字 46","ref":null,"clip"