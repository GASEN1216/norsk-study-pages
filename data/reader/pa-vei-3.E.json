{"id":"pa-vei-3.E","bookId":"pa-vei-textbook","readingId":"3.E","title":"I kiosken","audio":"audio/pa-vei/3.E.mp3","duration":94.766792,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.4,"end":4.665,"text":"E. I kiosken","zh":"E. 在小卖部","words":[[0,1,2.4,2.76,"e"],[3,4,3.98,4.085,"i"],[5,12,4.16,4.665,"kiosken"]]},{"id":1,"start":6.7,"end":7.225,"text":"Vær så god!","zh":"您要点什么？","words":[[0,3,6.7,6.883,"vær@pa-vei-vær-be"],[4,6,6.883,7.022,"så"],[7,10,7.022,7.225,"god"]],"speaker":"Dame"},{"id":2,"start":8.14,"end":10.025,"text":"VG og Aftenposten, takk.","zh":"请给我一份 VG 和一份《晚邮报》。","words":[[0,2,8.14,8.525,"vg"],[3,5,8.82,8.965,"og"],[6,17,8.98,9.685,"aftenposten"],[19,23,9.74,10.025,"takk"]],"speaker":"Thomas"},{"id":3,"start":11.28,"end":13.825,"text":"Beklager, men vi har ikke VG.","zh":"抱歉，我们没有 VG。","words":[[0,8,11.28,12.125,"beklager"],[10,13,12.7,12.863,"men"],[14,16,12.863,13.005,"vi"],[17,20,13.02,13.322,"har"],[21,25,13.322,13.553,"ikke"],[26,28,13.553,13.825,"vg"]],"speaker":"Dame"},{"id":4,"start":15.294,"end":16.699,"text":"Da tar jeg Dagbladet.","zh":"那我买《日报》。","words":[[0,2,15.294,15.439,"da"],[3,6,15.614,15.906,"tar"],[7,10,15.906,16.079,"jeg"],[11,20,16.114,16.699,"dagbladet"]],"speaker":"Thomas"},{"id":5,"start":17.854,"end":18.519,"text":"Noe annet?","zh":"还要别的吗？","words":[[0,3,17.854,18.079,"noe"],[4,9,18.094,18.519,"annet"]],"speaker":"Dame"},{"id":6,"start":19.834,"end":23.619,"text":"Ja, ei flaske blå Farris og ei pølse med brød.","zh":"要，一瓶蓝标 Farris 矿泉水和一个热狗。","words":[[0,2,19.834,19.999,"ja"],[4,6,20.574,20.739,"ei"],[7,13,20.774,21.179,"flaske"],[14,17,21.214,21.419,"blå"],[18,24,21.534,21.999,"farris"],[25,27,22.314,22.459,"og"],[28,30,22.654,22.779,"ei"],[31,36,22.814,23.236,"pølse"],[37,40,23.236,23.387,"med"],[41,45,23.387,23.619,"brød"]],"speaker":"Thomas"},{"id":7,"start":24.394,"end":26.879,"text":"Forresten, hvor mye koster et eple?","zh":"对了，一个苹果多少钱？","words":[[0,9,24.394,24.839,"forresten"],[11,15,25.574,25.819,"hvor"],[16,19,25.834,26.079,"mye"],[20,26,26.094,26.447,"koster"],[27,29,26.447,26.587,"et"],[30,34,26.587,26.879,"eple"]],"speaker":"Thomas"},{"id":8,"start":28.074,"end":28.859,"text":"7 kroner.","zh":"7 克朗。","words":[[0,1,28.074,28.279,"7"],[2,8,28.394,28.859,"kroner"]],"speaker":"Dame"},{"id":9,"start":30.014,"end":32.539,"text":"Jeg tar et eple - nei, to epler.","zh":"我要一个苹果——不，要两个苹果。","words":[[0,3,30.014,30.179,"jeg"],[4,7,30.194,30.486,"tar"],[8,10,30.486,30.617,"et"],[11,15,30.617,30.919,"eple"],[18,21,31.234,31.419,"nei"],[23,25,31.894,32.059,"to"],[26,31,32.194,32.539,"epler"]],"speaker":"Thomas"},{"id":10,"start":33.614,"end":34.299,"text":"Var det alt?","zh":"就这些吗？","words":[[0,3,33.614,33.776,"var"],[4,7,33.776,33.939,"det"],[8,11,33.974,34.299,"alt"]],"speaker":"Dame"},{"id":11,"start":35.554,"end":38.559,"text":"Ja, nei ... En sjokolade.","zh":"是的，不……再要一块巧克力。","words":[[0,2,35.554,35.719,"ja"],[4,7,36.634,36.839,"nei"],[12,14,37.674,37.859,"en"],[15,24,37.994,38.559,"sjokolade"]],"speaker":"Thomas"},{"id":12,"start":39.554,"end":39.999,"text":"Unnskyld?","zh":"您说什么？","words":[[0,8,39.554,39.999,"unnskyld"]],"speaker":"Dame"},{"id":13,"start":41.034,"end":43.679,"text":"En stor sjokolade. Jeg tar den der.","zh":"一大块巧克力。我要那一块。","words":[[0,2,41.034,41.179,"en"],[3,7,41.254,41.619,"stor"],[8,17,41.674,42.199,"sjokolade"],[19,22,42.874,43.037,"jeg"],[23,26,43.037,43.287,"tar"],[27,30,43.287,43.456,"den"],[31,34,43.456,43.679,"der"]],"speaker":"Thomas"},{"id":14,"start":44.674,"end":45.459,"text":"Hvor mye blir det?","zh":"一共多少钱？","words":[[0,4,44.674,44.919,"hvor"],[5,8,44.934,45.147,"mye"],[9,13,45.147,45.317,"blir"],[14,17,45.317,45.459,"det"]],"speaker":"Thomas"},{"id":15,"start":46.114,"end":48.859,"text":"Det blir 125 kroner.","zh":"一共 125 克朗。","words":[[0,3,46.114,46.299,"det"],[4,8,46.454,46.859,"blir"],[9,12,47.014,48.299,"125"],[13,19,48.434,48.859,"kroner"]],"speaker":"Dame"},{"id":16,"start":51.754,"end":52.439,"text":"Sammendrag.","zh":"摘要","words":[[0,10,51.754,52.439,"sammendrag"]]},{"id":17,"start":54.404,"end":60.729,"text":"Thomas og Irina sitter i en park, og Irina sender en melding til en gammel venn.","zh":"托马斯和伊丽娜坐在公园里，伊丽娜在给一位老朋友发消息。","words":[[0,6,54.404,54.969,"thomas"],[7,9,55.004,55.149,"og"],[10,15,55.164,55.709,"irina"],[16,22,55.784,56.136,"sitter"],[23,24,56.136,56.227,"i"],[25,27,56.227,56.367,"en"],[28,32,56.367,56.769,"park"],[34,36,57.924,58.049,"og"],[37,42,58.064,58.549,"irina"],[43,49,58.604,58.947,"sender"],[50,52,58.947,59.069,"en"],[53,60,59.124,59.629,"melding"],[61,64,59.704,59.867,"til"],[65,67,59.867,60.009,"en"],[68,74,60.024,60.429,"gammel"],[75,79,60.444,60.729,"venn"]]},{"id":18,"start":63.044,"end":65.769,"text":"Thomas er litt sjalu og går i kiosken.","zh":"托马斯有点吃醋，便去了小卖部。","words":[[0,6,63.044,63.509,"thomas"],[7,9,63.524,63.686,"er"],[10,14,63.686,63.897,"litt"],[15,20,63.897,64.229,"sjalu"],[21,23,64.904,65.017,"og"],[24,27,65.017,65.197,"går"],[28,29,65.197,65.289,"i"],[30,37,65.304,65.769,"kiosken"]]},{"id":19,"start":67.594,"end":75.979,"text":"Der kjøper han to aviser, ei flaske mineralvann, to epler og ei pølse med brød.","zh":"他在那里买了两份报纸、一瓶矿泉水、两个苹果和一个热狗。","words":[[0,3,67.594,67.859,"der"],[4,10,67.894,68.267,"kjøper"],[11,14,68.267,68.419,"han"],[15,17,68.454,68.639,"to"],[18,24,68.814,69.379,"aviser"],[26,28,70.614,70.759,"ei"],[29,35,70.794,71.186,"flaske"],[36,47,71.186,71.919,"mineralvann"],[49,51,73.154,73.319,"to"],[52,57,73.454,73.939,"epler"],[58,60,74.814,74.947,"og"],[61,63,74.947,75.079,"ei"],[64,69,75.114,75.577,"pølse"],[70,73,75.577,75.727,"med"],[74,78,75.727,75.979,"brød"]]},{"id":20,"start":78.074,"end":79.219,"text":"Han tenker på Irina.","zh":"他想到了伊丽娜。","words":[[0,3,78.074,78.239,"han"],[4,10,78.254,78.617,"tenker@pa-vei-extra-0"],[11,13,78.617,78.759,"på"],[14,19,78.774,79.219,"irina"]]},{"id":21,"start":81.254,"end":86.699,"text":"Hun har lyst på sjokolade, og Thomas kjøper en stor sjokolade til henne.","zh":"她想吃巧克力，于是托马斯给她买了一大块巧克力。