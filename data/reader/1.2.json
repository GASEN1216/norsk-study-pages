{"id":"1.2","title":"Hva heter du?","audio":"audio/1.2.mp3","duration":171.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.75,"text":"1.2 Hva heter du?","heading":true,"zh":"1.2 你叫什么名字？","words":[[0,3,0.15,1.13,"1.2"],[4,7,2.36,2.78,"hva"],[8,13,2.78,3.24,"heter"],[14,16,3.24,3.67,"du"]]},{"id":1,"start":5.63,"end":8.9,"text":"Hei! Hva heter du?","speaker":"Sompit","zh":"你好！你叫什么名字？","words":[[0,3,5.71,6.2,"hei"],[5,8,7.43,7.79,"hva"],[9,14,7.79,8.23,"heter"],[15,17,8.23,8.82,"du"]]},{"id":2,"start":10.37,"end":14.73,"text":"Jeg heter Biniam. Hva heter du?","speaker":"Biniam","zh":"我叫比尼亚姆。你叫什么名字？","words":[[0,3,10.45,10.9,"jeg"],[4,9,10.9,11.42,"heter"],[10,16,11.42,12.02,"biniam"],[18,21,13.21,13.67,"hva"],[22,27,13.67,14.15,"heter"],[28,30,14.15,14.65,"du"]]},{"id":3,"start":15.09,"end":16.24,"text":"Sompit.","speaker":"Sompit","zh":"松皮特。","words":[[0,6,15.17,16.16,"sompit"]]},{"id":4,"start":17.71,"end":20.37,"text":"Unnskyld, jeg forstår ikke.","speaker":"Biniam","zh":"不好意思，我没听懂。","words":[[0,8,17.79,18.28,"unnskyld"],[10,13,19.12,19.44,"jeg"],[14,21,19.44,19.92,"forstår"],[22,26,19.92,20.29,"ikke"]]},{"id":5,"start":21.7,"end":23.97,"text":"Jeg heter Sompit.","speaker":"Sompit","zh":"我叫松皮特。","words":[[0,3,21.78,22.19,"jeg"],[4,9,22.19,22.93,"heter"],[10,16,22.93,23.89,"sompit"]]},{"id":6,"start":25.01,"end":30.7,"text":"Å ja, nå forstår jeg. Du heter Sompit.","speaker":"Biniam","zh":"哦，现在我明白了。你叫松皮特。","words":[[0,1,25.09,25.52,"å~496a48c13525"],[2,4,25.52,25.82,"ja"],[6,8,26.34,26.84,"nå~d531d47a7712"],[9,16,26.84,27.42,"forstår"],[17,20,27.42,27.66,"jeg"],[22,24,28.6,29.12,"du"],[25,30,29.12,29.66,"heter"],[31,37,29.66,30.62,"sompit"]]},{"id":7,"start":30.93,"end":33.63,"text":"Ja, det er riktig.","speaker":"Sompit","zh":"是的，没错。","words":[[0,2,31.01,31.44,"ja"],[4,7,32.2,32.52,"det"],[8,10,32.52,32.88,"er"],[11,17,32.88,33.55,"riktig"]]},{"id":8,"start":35.98,"end":39.42,"text":"Jeg heter Viola. Hva heter du?","speaker":"Viola","zh":"我叫维奥拉。你叫什么名字？","words":[[0,3,36.06,36.42,"jeg"],[4,9,36.42,36.8,"heter"],[10,15,36.8,37.28,"viola"],[17,20,37.28,38.64,"hva"],[21,26,38.64,38.98,"heter"],[27,29,38.98,39.34,"du"]]},{"id":9,"start":40.21,"end":42.48,"text":"Jeg heter Yousef.","speaker":"Yousef","zh":"我叫优素福。","words":[[0,3,40.29,40.72,"jeg"],[4,9,40.72,41.34,"heter"],[10,16,41.34,42.4,"yousef"]]},{"id":10,"start":43.47,"end":45.87,"text":"Unnskyld, kan du gjenta?","speaker":"Viola","zh":"不好意思，你能再说一遍吗？","words":[[0,8,43.55,44.06,"unnskyld"],[10,13,44.7,45.04,"kan"],[14,16,45.04,45.18,"du"],[17,23,45.18,45.79,"gjenta"]]},{"id":11,"start":46.75,"end":49.1,"text":"Jeg heter Yousef.","speaker":"Yousef","zh":"我叫优素福。","words":[[0,3,46.83,47.36,"jeg"],[4,9,47.36,48.0,"heter"],[10,16,48.0,49.02,"yousef"]]},{"id":12,"start":50.05,"end":51.78,"text":"Hvordan staver du det?","speaker":"Viola","zh":"这个你怎么拼写？","words":[[0,7,50.13,50.67,"hvordan"],[8,14,50.67,51.15,"staver"],[15,17,51.15,51.35,"du"],[18,21,51.35,51.7,"det"]]},{"id":13,"start":52.8,"end":59.98,"text":"Y-O-U-S-E-F. Forstår du?","speaker":"Yousef","zh":"Y-O-U-S-E-F。你明白了吗？","words":[[0,1,52.88,53.24,"#letter:Y"],[2,3,53.24,54.22,"#letter:O"],[4,5,54.22,55.22,"#letter:U"],[6,7,55.22,56.16,"#letter:S"],[8,9,56.16,57.14,"#letter:E"],[10,11,57.14,58.3,"#letter:F"],[13,20,58.96,59.6,"forstår"],[21,23,59.6,59.9,"du"]]},{"id":14,"start":61.06,"end":64.98,"text":"Ja, tusen takk! Nå forstår jeg.","speaker":"Viola","zh":"是的，非常感谢！现在我明白了。","words":[[0,2,61.14,61.52,"ja"],[4,9,62.06,62.59,"tusen"],[10,14,62.59,62.98,"takk"],[16,18,63.65,64.06,"nå~d531d47a7712"],[19,26,64.06,64.58,"forstår"],[27,30,64.58,64.9,"jeg"]]},{"id":15,"start":68.9,"end":70.19,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,68.98,70.11,"sammendrag"]]},{"id":16,"start":72.21,"end":75.85,"text":"Sompit og Biniam snakker sammen.","zh":"松皮特和比尼亚姆在交谈。","words":[[0,6,72.29,73.17,"sompit"],[7,9,73.17,73.56,"og"],[10,16,73.56,73.98,"biniam"],[17,24,74.2,75.11,"snakker"],[25,31,75.11,75.77,"sammen"]]},{"id":17,"start":75.86,"end":80.02,"text":"Biniam forstår ikke.","zh":"比尼亚姆没听懂。","words":[[0,6,75.94,77.88,"biniam"],[7,14,78.6,79.24,"forstår"],[15,19,79.24,79.94,"ikke"]]},{"id":18,"start":81.29,"end":83.11,"text":"Sompit gjentar.","zh":"松皮特重复一遍。","words":[[0,6,81.37,82.04,"sompit"],[7,14,82.04,83.03,"gjentar"]]},{"id":19,"start":84.86,"end":88.1,"text":"Viola og Yousef snakker sammen.","zh":"维奥拉和优素福在交谈。","words":[[0,5,84.94,85.58,"viola"],[6,8,85.58,85.88,"og"],[9,15,85.88,86.58,"yousef"],[16,23,86.58,87.36,"snakker"],[24,30,87.36,88.02,"sammen"]]},{"id":20,"start":89.39,"end":93.93,"text":"Yousef staver, og Viola forstår.","zh":"优素福拼读出来，维奥拉听懂了。","words":[[0,6,89.47,90.16,"yousef"],[7,13,90.16,90.8,"staver"],[15,17,90.8,92.16,"og"],[18,23,92.16,92.84,"viola"],[24,31,92.84,93.85,"forstår"]]},{"id":21,"start":98.26,"end":99.5,"text":"Alfabetet","subheading":true,"zh":"字母表","words":[[0,9,98.34,99.42,"alfabetet"]]},{"id":22,"start":100.97,"end":101.48,"text":"A","zh":"字母 A","words":[[0,1,101.05,101.4,"#letter:A"]]},{"id":23,"start":103.23,"end":103.73,"text":"B","zh":"字母 B","words":[[0,1,103.31,103.65,"#letter:B"]]},{"id":24,"start":105.58,"end":106.28,"text":"C","zh":"字母 C","words":[[0,1,105.66,106.2,"#letter:C"]]},{"id":25,"start":108.37,"end":108.9,"text":"D","zh":"字母 D","words":[[0,1,108.45,108.82,"#letter:D"]]},{"id":26,"start":111.03,"end":111.55,"text":"E","zh":"字母 E","words":[[0,1,111.11,111.47,"#letter:E"]]},{"id":27,"start":113.46,"end":114.05,"text":"F","zh":"字母 F","words":[[0,1,113.54,113.97,"#letter:F"]]},{"id":28,"start":115.91,"end":116.47,"text":"G","zh":"字母 G","words":[[0,1,115.99,116.39,"#letter:G"]]},{"id":29,"start":118.19,"end":118.8,"text":"H","zh":"字母 H","words":[[0,1,118.27,118.72,"#letter:H"]]},{"id":30,"start":120.73,"end":121.3,"text":"I","zh":"字母 I","words":[[0,1,120.81,121.22,"#letter:I"]]},{"id":31,"start":123.09,"end":123.78,"text":"J","zh":"字母 J","words":[[0,1,123.17,123.7,"#letter:J"]]},{"id":32,"start":125.55,"end":126.2,"text":"