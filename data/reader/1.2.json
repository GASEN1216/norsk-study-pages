{"id":"1.2","title":"Hva heter du?","audio":"audio/1.2.mp3","duration":171.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.75,"text":"1.2 Hva heter du?","heading":true,"zh":"1.2 你叫什么名字？","words":[[0,3,0.15,1.13,"1.2"],[4,7,2.36,2.78,"hva"],[8,13,2.78,3.24,"heter"],[14,16,3.24,3.67,"du"]]},{"id":1,"start":5.74,"end":8.96,"text":"Hei! Hva heter du?","speaker":"Sompit","zh":"你好！你叫什么名字？","words":[[0,3,5.79,6.28,"hei"],[5,8,7.58,7.92,"hva"],[9,14,7.92,8.5,"heter"],[15,17,8.5,8.8,"du"]]},{"id":2,"start":10.46,"end":14.82,"text":"Jeg heter Biniam. Hva heter du?","speaker":"Biniam","zh":"我叫比尼亚姆。你叫什么名字？","words":[[0,3,10.52,11.04,"jeg"],[4,9,11.04,11.58,"heter"],[10,16,11.58,12.26,"biniam"],[18,21,13.42,13.8,"hva"],[22,27,13.8,14.34,"heter"],[28,30,14.34,14.67,"du"]]},{"id":3,"start":15.26,"end":16.29,"text":"Sompit.","speaker":"Sompit","zh":"松皮特。","words":[[0,6,15.32,16.14,"sompit"]]},{"id":4,"start":17.74,"end":20.43,"text":"Unnskyld, jeg forstår ikke.","speaker":"Biniam","zh":"不好意思，我没听懂。","words":[[0,8,17.8,18.52,"unnskyld"],[10,13,19.3,19.54,"jeg"],[14,21,19.54,20.0,"forstår"],[22,26,20.0,20.28,"ikke"]]},{"id":5,"start":21.73,"end":23.97,"text":"Jeg heter Sompit.","speaker":"Sompit","zh":"我叫松皮特。","words":[[0,3,21.79,22.42,"jeg"],[4,9,22.42,23.18,"heter"],[10,16,23.18,23.82,"sompit"]]},{"id":6,"start":25.05,"end":30.73,"text":"Å ja, nå forstår jeg. Du heter Sompit.","speaker":"Biniam","zh":"哦，现在我明白了。你叫松皮特。","words":[[0,1,25.11,25.45,"å~496a48c13525"],[2,4,25.6,25.93,"ja"],[6,8,26.58,26.98,"nå~d531d47a7712"],[9,16,26.98,27.52,"forstår"],[17,20,27.52,27.89,"jeg"],[22,24,28.88,29.28,"du"],[25,30,29.28,29.9,"heter"],[31,37,29.9,30.59,"sompit"]]},{"id":7,"start":31.03,"end":33.54,"text":"Ja, det er riktig.","speaker":"Sompit","zh":"是的，没错。","words":[[0,2,31.09,31.54,"ja"],[4,7,32.32,32.74,"det"],[8,10,32.74,32.92,"er"],[11,17,32.92,33.39,"riktig"]]},{"id":8,"start":36.02,"end":39.5,"text":"Jeg heter Viola. Hva heter du?","speaker":"Viola","zh":"我叫维奥拉。你叫什么名字？","words":[[0,3,36.08,36.52,"jeg"],[4,9,36.52,36.98,"heter"],[10,15,36.98,37.63,"viola"],[17,20,38.42,38.7,"hva"],[21,26,38.7,39.08,"heter"],[27,29,39.08,39.35,"du"]]},{"id":9,"start":40.24,"end":42.55,"text":"Jeg heter Yousef.","speaker":"Yousef","zh":"我叫优素福。","words":[[0,3,40.3,40.84,"jeg"],[4,9,40.98,41.62,"heter"],[10,16,41.74,42.41,"yousef"]]},{"id":10,"start":43.51,"end":45.93,"text":"Unnskyld, kan du gjenta?","speaker":"Viola","zh":"不好意思，你能再说一遍吗？","words":[[0,8,43.57,44.27,"unnskyld"],[10,13,44.86,45.1,"kan"],[14,16,45.1,45.26,"du"],[17,23,45.26,45.78,"gjenta"]]},{"id":11,"start":46.79,"end":49.16,"text":"Jeg heter Yousef.","speaker":"Yousef","zh":"我叫优素福。","words":[[0,3,46.85,47.39,"jeg"],[4,9,47.66,48.32,"heter"],[10,16,48.32,49.01,"yousef"]]},{"id":12,"start":50.09,"end":51.84,"text":"Hvordan staver du det?","speaker":"Viola","zh":"这个你怎么拼写？","words":[[0,7,50.15,50.78,"hvordan"],[8,14,50.78,51.22,"staver"],[15,17,51.22,51.4,"du"],[18,21,51.4,51.69,"det"]]},{"id":13,"start":52.84,"end":60.09,"text":"Y-O-U-S-E-F. Forstår du?","speaker":"Yousef","zh":"Y-O-U-S-E-F。你明白了吗？","words":[[0,1,52.9,53.21,"#letter:Y"],[2,3,53.92,54.2,"#letter:O"],[4,5,54.84,55.12,"#letter:U"],[6,7,55.86,56.44,"#letter:S"],[8,9,56.94,57.21,"#letter:E"],[10,11,58.12,59.22,"#letter:F"],[13,20,59.22,59.66,"forstår"],[21,23,59.66,59.94,"du"]]},{"id":14,"start":61.09,"end":65.04,"text":"Ja, tusen takk! Nå forstår jeg.","speaker":"Viola","zh":"是的，非常感谢！现在我明白了。","words":[[0,2,61.16,61.59,"ja"],[4,9,62.22,62.68,"tusen"],[10,14,62.68,63.16,"takk"],[16,18,63.88,64.22,"nå~d531d47a7712"],[19,26,64.22,64.68,"forstår"],[27,30,64.68,64.89,"jeg"]]},{"id":15,"start":68.94,"end":70.24,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,69.0,70.09,"sammendrag"]]},{"id":16,"start":72.25,"end":75.91,"text":"Sompit og Biniam snakker sammen.","zh":"松皮特和比尼亚姆在交谈。","words":[[0,6,72.31,73.38,"sompit"],[7,9,73.38,73.74,"og"],[10,16,73.74,74.52,"biniam"],[17,24,74.66,75.26,"snakker"],[25,31,75.26,75.76,"sammen"]]},{"id":17,"start":76.88,"end":80.08,"text":"Biniam forstår ikke.","zh":"比尼亚姆没听懂。","words":[[0,6,76.94,77.98,"biniam"],[7,14,78.76,79.52,"forstår"],[15,19,79.52,79.93,"ikke"]]},{"id":18,"start":81.33,"end":83.17,"text":"Sompit gjentar.","zh":"松皮特重复一遍。","words":[[0,6,81.39,82.32,"sompit"],[7,14,82.32,83.02,"gjentar"]]},{"id":19,"start":84.89,"end":88.09,"text":"Viola og Yousef snakker sammen.","zh":"维奥拉和优素福在交谈。","words":[[0,5,84.95,85.72,"viola"],[6,8,85.72,85.98,"og"],[9,15,85.98,86.74,"yousef"],[16,23,86.98,87.48,"snakker"],[24,30,87.48,87.94,"sammen"]]},{"id":20,"start":89.43,"end":93.99,"text":"Yousef staver, og Viola forstår.","zh":"优素福拼读出来，维奥拉听懂了。","words":[[0,6,89.49,90.3,"yousef"],[7,13,90.3,91.08,"staver"],[15,17,91.9,92.18,"og"],[18,23,92.36,93.08,"viola"],[24,31,93.24,93.84,"forstår"]]},{"id":21,"start":98.29,"end":99.56,"text":"Alfabetet","subheading":true,"zh":"字母表","words":[[0,9,98.35,99.41,"alfabetet"]]},{"id":22,"start":100.97,"end":101.48,"text":"A","zh":"字母 A","words":[[0,1,101.05,101.4,"#letter:A"]]},{"id":23,"start":103.23,"end":103.73,"text":"B","zh":"字母 B","words":[[0,1,103.31,103.65,"#letter:B"]]},{"id":24,"start":105.58,"end":106.28,"text":"C","zh":"字母 C","words":[[0,1,105.66,106.2,"#letter:C"]]},{"id":25,"start":108.37,"end":108.9,"text":"D","zh":"字母 D","words":[[0,1,108.45,108.82,"#letter:D"]]},{"id":26,"start":111.03,"end":111.55,"text":"E","zh":"字母 E","words":[[0,1,111.11,111.47,"#letter:E"]]},{"id":27,"start":113.46,"end":114.05,"text":"F","zh":"字母 F","words":[[0,1,113.54,113.97,"#letter:F"]]},{"id":28,"start":115.91,"end":116.47,"text":"G","zh":"字母 G","words":[[0,1,115.99,116.39,"#letter:G"]]},{"id":29,"start":118.19,"end":118.8,"text":"H","zh":"字母 H","words":[[0,1,118.27,118.72,"#letter:H"]]},{"id":30,"start":120.73,"end":121.3,"text":"I","zh":"字母 I","words":[[0,1,120.81,121.22,"#letter:I"]]},{"id":31,"start":123.09,"end":123.78,"text":"J","zh":"字母 J","words":[[0,1,123.17,123.7,"#letter:J"]]},{"id":32,"start":125.55,"end":126.2,"text