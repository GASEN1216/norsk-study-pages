{"id":"pa-vei-6.C","bookId":"pa-vei-textbook","readingId":"6.C","title":"Kristian var i Telemark","audio":"audio/pa-vei/6.C.mp3","duration":52.968,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.74,"end":5.445,"text":"C. Kristian var i Telemark","zh":"C. 克里斯蒂安去了泰勒马克","words":[[0,1,1.74,2.24,"c"],[3,11,3.52,4.185,"kristian"],[12,15,4.22,4.463,"var"],[16,17,4.463,4.565,"i"],[18,26,4.64,5.445,"telemark"]]},{"id":1,"start":7.58,"end":9.625,"text":"Kristian reiste på bilferie.","zh":"克里斯蒂安开车去度假。","words":[[0,8,7.58,8.225,"kristian"],[9,15,8.3,8.742,"reiste"],[16,18,8.742,8.865,"på"],[19,27,8.92,9.625,"bilferie"]]},{"id":2,"start":10.94,"end":13.485,"text":"Først kjørte han til en venn i Kragerø.","zh":"他先开车去克拉格勒看一位朋友。","words":[[0,5,10.94,11.385,"først"],[6,12,11.58,11.963,"kjørte"],[13,16,11.963,12.125,"han"],[17,20,12.16,12.325,"til"],[21,23,12.34,12.465,"en"],[24,28,12.52,12.825,"venn"],[29,30,12.88,12.985,"i"],[31,38,13.0,13.485,"kragerø"]]},{"id":3,"start":14.99,"end":17.975,"text":"Kragerø er en koselig, liten by ved kysten.","zh":"克拉格勒是一个舒适宜人的海滨小城。","words":[[0,7,14.99,15.575,"kragerø"],[8,10,15.63,15.773,"er"],[11,13,15.773,15.915,"en"],[14,21,15.93,16.615,"koselig"],[23,28,16.65,17.095,"liten"],[29,31,17.11,17.255,"by"],[32,35,17.39,17.553,"ved"],[36,42,17.553,17.975,"kysten"]]},{"id":4,"start":19.41,"end":24.075,"text":"Men været var elendig, og de satt inne og spilte kort hver dag.","zh":"不过天气很糟，他们每天都待在屋里打牌。","words":[[0,3,19.41,19.595,"men"],[4,9,19.69,20.133,"været"],[10,13,20.133,20.395,"var"],[14,21,20.49,21.095,"elendig"],[23,25,21.59,21.723,"og"],[26,28,21.723,21.855,"de"],[29,33,21.89,22.175,"satt"],[34,38,22.21,22.535,"inne"],[39,41,22.57,22.683,"og"],[42,48,22.683,23.035,"spilte"],[49,53,23.07,23.455,"kort@pa-vei-kort-cards"],[54,58,23.51,23.782,"hver"],[59,62,23.782,24.075,"dag"]]},{"id":5,"start":25.87,"end":29.255,"text":"Etter to uker dro de på bluesfestival på Notodden.","zh":"两周后，他们去了诺托登的布鲁斯音乐节。","words":[[0,5,25.87,26.155,"etter"],[6,8,26.17,26.355,"to"],[9,13,26.47,26.875,"uker"],[14,17,26.93,27.115,"dro"],[18,20,27.17,27.295,"de"],[21,23,27.31,27.435,"på"],[24,37,27.51,28.515,"bluesfestival"],[38,40,28.53,28.672,"på"],[41,49,28.672,29.255,"notodden"]]},{"id":6,"start":30.25,"end":31.535,"text":"Der hadde de det fint.","zh":"他们在那里过得很愉快。","words":[[0,3,30.25,30.553,"der"],[4,9,30.553,30.802,"hadde"],[10,12,30.802,30.932,"de"],[13,16,30.932,31.075,"det"],[17,21,31.09,31.535,"fint"]]},{"id":7,"start":32.61,"end":38.895,"text":"De hørte på musikk fra morgen til kveld, drakk øl og snakket med andre bluesinteresserte.","zh":"他们从早到晚听音乐、喝啤酒，和其他布鲁斯爱好者聊天。","words":[[0,2,32.61,32.735,"de"],[3,8,32.75,33.062,"hørte"],[9,11,33.062,33.195,"på"],[12,18,33.23,33.735,"musikk"],[19,22,33.79,33.975,"fra"],[23,29,34.01,34.463,"morgen"],[30,33,34.463,34.615,"til"],[34,39,34.63,34.955,"kveld"],[41,46,35.51,35.835,"drakk"],[47,49,35.91,36.075,"øl"],[50,52,36.63,36.755,"og"],[53,60,36.79,37.203,"snakket"],[61,64,37.203,37.335,"med"],[65,70,37.35,37.755,"andre"],[71,88,37.79,38.895,"bluesinteresserte"]]},{"id":8,"start":40.19,"end":47.095,"text":"Det var mye folk overalt, i gatene og på klubbene, og det var ikke lett å finne et sted å overnatte.","zh":"到处都是人，街上和俱乐部里都是，找个过夜的地方并不容易。","words":[[0,3,40.19,40.323,"det"],[4,7,40.323,40.495,"var"],[8,11,40.51,40.855,"mye"],[12,16,40.89,41.275,"folk"],[17,24,41.41,42.075,"overalt"],[26,27,42.47,42.575,"i"],[28,34,42.61,43.215,"gatene"],[35,37,43.27,43.382,"og"],[38,40,43.382,43.513,"på"],[41,49,43.513,43.955,"klubbene"],[51,53,44.57,44.703,"og"],[54,57,44.703,44.823,"det"],[58,61,44.823,45.013,"var"],[62,66,45.013,45.233,"ikke"],[67,71,45.233,45.513,"lett"],[72,73,45.513,45.612,"å"],[74,79,45.612,45.913,"finne"],[80,82,45.913,46.072,"et"],[83,87,46.072,46.382,"sted"],[88,89,46.382,46.475,"å"],[90,99,46.53,47.095,"overnatte"]]},{"id":9,"start":48.23,"end":51.335,"text":"Heldigvis fikk de plass på en campingplass i nærheten.","zh":"幸好，他们在附近的一处露营地找到了空位。","words":[[0,