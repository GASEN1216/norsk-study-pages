{"id":"ty-conversation-2.1","bookId":"ty-conversation-guide","readingId":"2.1","title":"Making a telephone call","audio":"audio/ty-conversation/2.1.mp3","duration":41.247354,"synthetic":false,"sentences":[{"id":0,"start":7.99,"end":8.315,"speaker":"Kari","text":"Hallo!","zh":"喂！","words":[[0,5,7.99,8.315,"hallo"]]},{"id":1,"start":10.03,"end":11.935,"speaker":"Olav","text":"Hei! Det er Olav.","zh":"你好！我是奥拉夫。","words":[[0,3,10.03,10.275,"hei"],[5,8,11.09,11.252,"det@ty-phone"],[9,11,11.252,11.395,"er"],[12,16,11.47,11.935,"olav"]]},{"id":2,"start":13.03,"end":14.195,"speaker":"Kari","text":"Hei, Olav!","zh":"你好，奥拉夫！","words":[[0,3,13.03,13.315,"hei"],[5,9,13.69,14.195,"olav"]]},{"id":3,"start":15.55,"end":17.075,"speaker":"Olav","text":"Jeg vil gjerne treffe deg.","zh":"我想和你见个面。","words":[[0,3,15.55,15.752,"jeg"],[4,7,15.752,15.915,"vil"],[8,14,15.97,16.395,"gjerne"],[15,21,16.49,16.873,"treffe"],[22,25,16.873,17.075,"deg"]]},{"id":4,"start":18.57,"end":19.515,"speaker":"Kari","text":"Ikke i dag.","zh":"今天不行。","words":[[0,4,18.57,18.935,"ikke"],[5,6,18.99,19.095,"i@ty-time"],[7,10,19.13,19.515,"dag"]]},{"id":5,"start":20.71,"end":21.515,"speaker":"Olav","text":"Hvorfor ikke?","zh":"为什么不行？","words":[[0,7,20.71,21.172,"hvorfor"],[8,12,21.172,21.515,"ikke"]]},{"id":6,"start":23.03,"end":24.595,"speaker":"Kari","text":"Det er fredag idag.","zh":"今天是星期五。","words":[[0,3,23.03,23.235,"det@ty-impersonal"],[4,6,23.25,23.415,"er"],[7,13,23.47,24.035,"fredag"],[14,18,24.15,24.595,"idag"]]},{"id":7,"start":25.67,"end":26.355,"speaker":"Kari","text":"Jeg jobber.","zh":"我要上班。","words":[[0,3,25.67,25.875,"jeg"],[4,10,25.91,26.355,"jobber@ty-work"]]},{"id":8,"start":27.43,"end":28.655,"speaker":"Olav","text":"Hva med i morgen?","zh":"明天怎么样？","words":[[0,3,27.43,27.615,"hva"],[4,7,27.73,27.935,"med"],[8,9,28.05,28.175,"i@ty-time"],[10,16,28.21,28.655,"morgen"]]},{"id":9,"start":29.47,"end":32.595,"speaker":"Kari","text":"Fint! Det er lørdag i morgen.","zh":"好啊！明天是星期六。","words":[[0,4,29.47,29.935,"fint"],[6,9,30.75,30.935,"det@ty-impersonal"],[10,12,30.99,31.155,"er"],[13,19,31.19,31.795,"lørdag"],[20,21,32.07,32.172,"i@ty-time"],[22,28,32.172,32.595,"morgen"]]},{"id":10,"start":33.13,"end":34.015,"speaker":"Kari","text":"Jeg jobber ikke.","zh":"我不上班。","words":[[0,3,33.13,33.335,"jeg"],[4,10,33.37,33.712,"jobber@ty-work"],[11,15,33.712,34.015,"ikke"]]},{"id":11,"start":35.23,"end":37.135,"speaker":"Olav","text":"Fint! Lunsj?","zh":"太好了！一起吃午饭？","words":[[0,4,35.23,35.615,"fint"],[6,11,36.73,37.135,"lunsj"]]},{"id":12,"start":38.31,"end":41.155,"speaker":"Kari","text":"Ja. Jeg vil gjerne treffe deg.","zh":"好啊。我也想和你见个面。","words":[[0,2,38.31,38.495,"ja"],[4,7,39.53,39.735,"jeg"],[8,11,39.77,39.935,"vil"],[12,18,39.99,40.435,"gjerne"],[19,25,40.49,40.915,"treffe"],[26,29,40.93,41.155,"deg"]]}],"lexicon":{"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-impersonal":{"lemma":"det","zh":"形式主语（用于说明今天是星期几，本词无须单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-phone":{"lemma":"det","zh":"（Det er Olav.）这是奥拉夫；电话中介绍自己","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"fint":{"lemma":"fin","zh":"好；太好了（表示赞同）","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"中性"},"fredag":{"lemma":"fredag","zh":"星期五","pos":"名词","ref":"ty-conversation-2-003","clip":null},"gjerne":{"lemma":"gjerne","zh":"乐意（vil gjerne：想要）","pos":"副词","ref":"3-081","clip":null},"hallo":{"lemma":"hallo","zh":"喂（接电话时的招呼）","pos":"感叹词","ref":"ty-conversation-2-005","clip":null},"hei":{"lemma":"hei","zh":"你好","pos":"感叹词","ref":"ty-conversation-1-009","clip":null},"hva":{"lemma":"hva","zh":"什么","pos":"疑问代词","ref":"ty-conversation-1-013","clip":null},"hvorfor":{"lemma":"hvorfor","zh":"为什么","pos":"疑问副词","ref":"ty-conversation-1-014","clip":null},"i":{"lemma":"i","zh":"在","pos":"介词","ref":"ty-conversation-1-015","clip":null},"i@ty-time":{"lemma":"i","zh":"（i dag / i morgen）今天／明天中的时间介词","pos":"介词","ref":"ty-conversation-1-015","clip":null,"contextual":true,"baseKey":"i","surface":"i"},"idag":{"lemma":"i dag","zh":"今天","pos":"副词","ref":"ty-conversation-2-009","clip":null},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-016","clip":null},"ja":{"lemma":"ja","zh":"是的；好的","pos":"感叹词","ref":"ty-conversation-1-017","clip":null},"jeg":{"lemma":"jeg","zh":"我","pos":"代词","ref":"ty-conversation-1-018","clip":null,"form":"主格"},"jobber":{"lemma":"jobbe","zh":"工作；上班","pos":"动词","ref":"ty-conversation-2-011","clip":null,"form":"现在时"},"jobber@ty-work":{"lemma":"jobbe","zh":"工作；上班","pos":"动词","ref":"ty-conversation-2-011","clip":null,"form":"现在时","contextual":true,"baseKey":"jobber","surface":"jobber"},"lunsj":{"lemma":"lunsj","zh":"午餐","pos":"名词","ref":"ty-conversation-2-014","clip":null},"lørdag":{"lemma":"lørdag","zh":"星期六","pos":"名词","ref":"ty-conversation-2-013","clip":null},"med":{"lemma":"med","zh":"（Hva med …?）……怎么样","pos":"介词","ref":"ty-conversation-3-007","clip":null},"morgen":{"lemma":"morgen","zh":"（i morgen）明天","pos":"名词","ref":"basics:time:morgen","clip":null},"olav":{"lemma":"Olav","zh":"奥拉夫（人名）","pos":"专名","ref":null,"clip":null},"treffe":{"lemma":"treffe","zh":"见面；碰面","pos":"动词","ref":"ty-conversation-2-018","clip":null,"form":"不定式"},"vil":{"lemma":"ville","zh":"想；想要","pos":"情态动词","ref":"ty-conversation-3-024","clip":null,"form":"现在时"}}}
