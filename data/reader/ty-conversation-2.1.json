{"id":"ty-conversation-2.1","bookId":"ty-conversation-guide","readingId":"2.1","title":"Making a telephone call","audio":"audio/ty-conversation/2.1.mp3","duration":41.247354,"synthetic":false,"sentences":[{"id":0,"start":7.38,"end":8.42,"speaker":"Kari","text":"Hallo!","zh":"喂！","words":[[0,5,7.38,8.42,"hallo"]]},{"id":1,"start":10.16,"end":12.38,"speaker":"Olav","text":"Hei! Det er Olav.","zh":"你好！我是奥拉夫。","words":[[0,3,10.16,10.9,"hei"],[5,8,11.16,11.34,"det@ty-phone"],[9,11,11.34,11.48,"er"],[12,16,11.48,12.38,"olav"]]},{"id":2,"start":13.2,"end":14.54,"speaker":"Kari","text":"Hei, Olav!","zh":"你好，奥拉夫！","words":[[0,3,13.2,13.76,"hei"],[5,9,13.82,14.54,"olav"]]},{"id":3,"start":15.56,"end":17.52,"speaker":"Olav","text":"Jeg vil gjerne treffe deg.","zh":"我想和你见个面。","words":[[0,3,15.56,15.78,"jeg"],[4,7,15.78,16.02,"vil"],[8,14,16.02,16.54,"gjerne"],[15,21,16.54,16.9,"treffe"],[22,25,16.9,17.52,"deg"]]},{"id":4,"start":18.64,"end":19.64,"speaker":"Kari","text":"Ikke i dag.","zh":"今天不行。","words":[[0,4,18.64,19.04,"ikke"],[5,6,19.04,19.28,"i@ty-time"],[7,10,19.28,19.64,"dag"]]},{"id":5,"start":20.8,"end":21.58,"speaker":"Olav","text":"Hvorfor ikke?","zh":"为什么不行？","words":[[0,7,20.8,21.28,"hvorfor"],[8,12,21.28,21.58,"ikke"]]},{"id":6,"start":22.84,"end":24.84,"speaker":"Kari","text":"Det er fredag idag.","zh":"今天是星期五。","words":[[0,3,22.84,23.36,"det@ty-impersonal"],[4,6,23.36,23.58,"er"],[7,13,23.58,24.2,"fredag"],[14,18,24.2,24.84,"idag"]]},{"id":7,"start":25.72,"end":26.46,"speaker":"Kari","text":"Jeg jobber.","zh":"我要上班。","words":[[0,3,25.72,25.94,"jeg"],[4,10,25.94,26.46,"jobber@ty-work"]]},{"id":8,"start":26.46,"end":28.7,"speaker":"Olav","text":"Hva med i morgen?","zh":"明天怎么样？","words":[[0,3,26.46,27.66,"hva"],[4,7,27.66,28.04,"med"],[8,9,28.04,28.38,"i@ty-time"],[10,16,28.38,28.7,"morgen"]]},{"id":9,"start":29.54,"end":32.68,"speaker":"Kari","text":"Fint! Det er lørdag i morgen.","zh":"好啊！明天是星期六。","words":[[0,4,29.54,30.04,"fint"],[6,9,30.82,31.04,"det@ty-impersonal"],[10,12,31.04,31.26,"er"],[13,19,31.26,32.02,"lørdag"],[20,21,32.02,32.32,"i@ty-time"],[22,28,32.32,32.68,"morgen"]]},{"id":10,"start":33.1,"end":34.34,"speaker":"Kari","text":"Jeg jobber ikke.","zh":"我不上班。","words":[[0,3,33.1,33.4,"jeg"],[4,10,33.4,33.76,"jobber@ty-work"],[11,15,33.76,34.34,"ikke"]]},{"id":11,"start":35.34,"end":37.16,"speaker":"Olav","text":"Fint! Lunsj?","zh":"太好了！一起吃午饭？","words":[[0,4,35.34,35.94,"fint"],[6,11,36.8,37.16,"lunsj"]]},{"id":12,"start":38.32,"end":41.22,"speaker":"Kari","text":"Ja. Jeg vil gjerne treffe deg.","zh":"好啊。我也想和你见个面。","words":[[0,2,38.32,38.82,"ja"],[4,7,39.5,39.78,"jeg"],[8,11,39.78,40.08,"vil"],[12,18,40.08,40.58,"gjerne"],[19,25,40.58,40.98,"treffe"],[26,29,40.98,41.22,"deg"]]}],"lexicon":{"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-impersonal":{"lemma":"det","zh":"形式主语（用于说明今天是星期几，本词无须单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-phone":{"lemma":"det","zh":"（Det er Olav.）这是奥拉夫；电话中介绍自己","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"fint":{"lemma":"fin","zh":"好；太好了（表示赞同）","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"中性"},"fredag":{"lemma":"fredag","zh":"星期五","pos":"名词","ref":"ty-conversation-2-003","clip":null},"gjerne":{"lemma":"gjerne","zh":"乐意（vil gjerne：想要）","pos":"副词","ref":"3-081","clip":null},"hallo":{"lemma":"hallo","zh":"喂（接电话时的招呼）","pos":"感叹词","ref":"ty-conversation-2-005","clip":null},"hei":{"lemma":"hei","zh":"你好","pos":"感叹词","ref":"ty-conversation-1-009","clip":null},"hva":{"lemma":"hva","zh":"什么","pos":"疑问代词","ref":"ty-conversation-1-013","clip":null},"hvorfor":{"lemma":"hvorfor","zh":"为什么","pos":"疑问副词","ref":"ty-conversation-1-014","clip":null},"i":{"lemma":"i","zh":"在","pos":"介词","ref":"ty-conversation-1-015","clip":null},"i@ty-time":{"lemma":"i","zh":"（i dag / i morgen）今天／明天中的时间介词","pos":"介词","ref":"ty-conversation-1-015","clip":null,"contextual":true,"baseKey":"i","surface":"i"},"idag":{"lemma":"i dag","zh":"今天","pos":"副词","ref":"ty-conversation-2-009","clip":null},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-016","clip":null},"ja":{"lemma":"ja","zh":"是的；好的","pos":"感叹词","ref":"ty-conversation-1-017","clip":null},"jeg":{"lemma":"jeg","zh":"我","pos":"代词","ref":"ty-conversation-1-018","clip":null,"form":"主格"},"jobber":{"lemma":"jobbe","zh":"工作；上班","pos":"动词","ref":"ty-conversation-2-011","clip":null,"form":"现在时"},"jobber@ty-work":{"lemma":"jobbe","zh":"工作；上班","pos":"动词","ref":"ty-conversation-2-011","clip":null,"form":"现在时","contextual":true,"baseKey":"jobber","surface":"jobber"},"lunsj":{"lemma":"lunsj","zh":"午餐","pos":"名词","ref":"ty-conversation-2-014","clip":null},"lørdag":{"lemma":"lørdag","zh":"星期六","pos":"名词","ref":"ty-conversation-2-013","clip":null},"med":{"lemma":"med","zh":"（Hva med …?）……怎么样","pos":"介词","ref":"ty-conversation-3-007","clip":null},"morgen":{"lemma":"morgen","zh":"（i morgen）明天","pos":"名词","ref":"basics:time:morgen","clip":null},"olav":{"lemma":"Olav","zh":"奥拉夫（人名）","pos":"专名","ref":null,"clip":null},"treffe":{"lemma":"treffe","zh":"见面；碰面","pos":"动词","ref":"ty-conversation-2-018","clip":null,"form":"不定式"},"vil":{"lemma":"ville","zh":"想；想要","pos":"情态动词","ref":"ty-conversation-3-024","clip":null,"form":"现在时"}}}
