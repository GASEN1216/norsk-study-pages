{"id":"8.4","title":"Marit handler til bursdagsmiddag","audio":"audio/8.4.mp3","duration":152.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.06,"text":"8.4 Marit handler til bursdagsmiddag","heading":true,"zh":"8.4 玛丽特为生日晚宴采购","words":[[0,3,0.15,1.26,"8.4"],[4,9,2.61,3.05,"marit"],[10,17,3.05,3.53,"handler"],[18,21,3.53,3.83,"til~d2dc28e242e8"],[22,36,3.83,4.98,"bursdagsmiddag"]]},{"id":1,"start":6.78,"end":12.55,"text":"Marit skal feire bursdag i kveld, og noen gode venner kommer på besøk.","zh":"玛丽特今晚要庆祝生日，几个好朋友要来做客。","words":[[0,5,6.84,7.44,"marit"],[6,10,7.44,7.74,"skal"],[11,16,7.74,8.1,"feire"],[17,24,8.1,8.62,"bursdag"],[25,26,8.62,8.7,"i~6e0a15a5aae1"],[27,32,8.7,9.18,"kveld"],[34,36,9.82,10.08,"og"],[37,41,10.08,10.44,"noen~c766e2ef794d"],[42,46,10.44,10.76,"gode"],[47,53,10.76,11.29,"venner"],[54,60,11.4,11.72,"kommer"],[61,63,11.72,11.86,"på~6e578d9937bb"],[64,69,11.86,12.4,"besøk"]]},{"id":2,"start":13.65,"end":18.85,"text":"Hun vil lage en god middag til gjestene, men først må hun handle.","zh":"她想给客人们做一顿美味的晚餐，但她得先去买东西。","words":[[0,3,13.71,14.12,"hun"],[4,7,14.12,14.32,"vil"],[8,12,14.32,14.74,"lage"],[13,15,14.74,14.92,"en~a939a9e56dc5"],[16,19,14.92,15.18,"god"],[20,26,15.18,15.6,"middag"],[27,30,15.6,15.78,"til"],[31,39,15.78,16.39,"gjestene"],[41,44,17.2,17.42,"men"],[45,50,17.42,17.96,"først"],[51,53,17.96,18.1,"må"],[54,57,18.1,18.3,"hun"],[58,64,18.3,18.7,"handle"]]},{"id":3,"start":20.12,"end":26.59,"text":"Marit drar til butikken, og Håvard blir hjemme for å rydde og støvsuge.","zh":"玛丽特去商店，霍瓦尔留在家里收拾屋子、吸尘。","words":[[0,5,20.18,20.88,"marit"],[6,10,20.88,21.3,"drar"],[11,14,21.3,21.5,"til"],[15,23,21.5,22.18,"butikken"],[25,27,23.06,23.2,"og"],[28,34,23.2,23.89,"håvard"],[35,39,24.0,24.24,"blir"],[40,46,24.24,24.76,"hjemme"],[47,50,24.76,24.92,"for~caaedf1d2285"],[51,52,24.92,25.02,"å~0583da7a620a"],[53,58,25.02,25.54,"rydde"],[59,61,25.54,25.7,"og"],[62,70,25.7,26.44,"støvsuge"]]},{"id":4,"start":28.03,"end":34.31,"text":"Han har lyst til å bake ei bursdagskake til Marit, for hun elsker kaker.","zh":"他想给玛丽特烤一个生日蛋糕，因为她最爱吃蛋糕了。","words":[[0,3,28.09,28.48,"han"],[4,7,28.48,28.68,"har"],[8,12,28.68,29.08,"lyst~b499524f55a4"],[13,16,29.08,29.26,"til~99ccdd3453b0"],[17,18,29.26,29.38,"å~0583da7a620a"],[19,23,29.38,29.86,"bake"],[24,26,29.86,30.0,"ei~47aa2d18e376"],[27,39,30.0,30.88,"bursdagskake"],[40,43,30.88,31.06,"til"],[44,49,31.06,31.63,"marit"],[51,54,32.46,32.7,"for~1b22712a94b1"],[55,58,32.7,33.06,"hun"],[59,65,33.06,33.72,"elsker"],[66,71,33.72,34.16,"kaker"]]},{"id":5,"start":36.59,"end":38.55,"text":"Marit er i butikken.","zh":"玛丽特在商店里。","words":[[0,5,36.66,37.42,"marit"],[6,8,37.42,37.72,"er"],[9,10,37.72,37.82,"i"],[11,19,37.82,38.41,"butikken"]]},{"id":6,"start":39.34,"end":45.2,"text":"Hun har ei lang handleliste, for hun skal servere en tre-retters middag.","zh":"她有一张长长的购物清单，因为她要准备一顿三道菜的晚餐。","words":[[0,3,39.4,39.82,"hun"],[4,7,39.82,40.12,"har"],[8,10,40.12,40.36,"ei~47aa2d18e376"],[11,15,40.36,40.78,"lang"],[16,27,40.78,41.66,"handleliste"],[29,32,42.3,42.52,"for~1b22712a94b1"],[33,36,42.52,42.8,"hun"],[37,41,42.8,43.08,"skal"],[42,49,43.08,43.64,"servere"],[50,52,43.64,43.82,"en~a939a9e56dc5"],[53,64,43.82,44.6,"tre-retters"],[65,71,44.6,45.05,"middag"]]},{"id":7,"start":46.66,"end":52.57,"text":"Til forrett vil hun lage ei deilig, varm gulrotsuppe med koriander.","zh":"前菜她想做一道美味的热胡萝卜汤，配香菜。","words":[[0,3,46.72,46.98,"til~a4df720bde1b"],[4,11,46.98,47.63,"forrett"],[12,15,48.0,48.16,"vil"],[16,19,48.16,48.34,"hun"],[20,24,48.34,48.82,"lage"],[25,27,48.82,49.08,"ei~47aa2d18e376"],[28,34,49.08,49.78,"deilig"],[36,40,49.78,50.26,"varm"],[41,52,50.26,51.3,"gulrotsuppe"],[53,56,51.56,51.76,"med~d8ba6b92e79b"],[57,66,51.76,52.42,"koriander"]]},{"id":8,"start":53.73,"end":61.52,"text":"Til hovedrett skal hun lage fårikål, og hun vil servere is med friske bær til dessert.","zh":"主菜她要做羊肉炖卷心菜，甜点她想上冰淇淋配新鲜浆果。","words":[[0,3,53.8,54.08,"til~9144540fda7e"],[4,13,54.08,54.88,"hovedrett"],[14,18,55.16,55.4,"skal"],[19,22,55.4,55.54,"hun"],[23,27,55.54,55.9,"lage"],[28,35,55.9,56.63,"fårikål"],[37,39,57.54,57.72,"og"],[40,43,57.72,58.02,"hun"],[44,47,58.02,58.24,"vil"],[48,55,58.24,58.78,"servere"],[56,58,58.78,59.31,"is"],[59,62,59.6,59.78,"med~1989cc008a86"],[63,69,59.78,60.26,"friske"],[70,73,60.26,60.78,"bær"],[74,77,60.78,60.94,"til~e8046f16be75"],[78,85,60.94,61.38,"dessert"]]},{"id":9,"start":63.2,"end":70.04,"text":"Hun finner gulrøtter, koriander, kål og poteter i grønnsaksdisken.","zh":"她在蔬菜柜台找到了胡萝卜、香菜、卷心菜和土豆。","words":[[0,3,63.27,63.56,"hun"],[4,10,63.56,64.0,"finner"],[11,20,64.0,64.78,"gulrøtter"],[22,31,65.28,66.1,"koriander"],[33,36,66.66,67.18,"kål"],[37,39,67.56,67.7,"og"],[40,47,67.7,68.54,"poteter"],[48,49,68.74,68.84,"i"],[50,65,68.84,69.89,"grønnsaksdisken"]]},{"id":10,"start":71.53,"end":76.9,"text":"Så går hun til kjøttdisken, men hun finner ikke lammekjøtt.","zh":"然后她去肉类柜台，但没找到羊肉。","words":[[0,2,71.59,71.92,"så~4a7ed2bb1489"],[3,6,71.92,72.12,"går"],[7,10,72.12,72.34,"hun"],[11,14,72.34,72.56,"til"],[15,26,72.56,73.44,"kjøttdisken"],[28,31,74.36,74.8,"men"],[32,35,75.08,75.4,"hun"],[36,42,75.4,75.76,"finner"],[43,47,75.76,76.06,"ikke"],[48,58,76.06,76.75,"lammekjøtt"]]},{"id":11,"start":78.86,"end":81.86,"text":"Unnskyld, har dere ferskt lammekjøtt?","speaker":"Marit","zh":"请问，你们有新鲜羊肉吗？","words":[[0,8,78.92,79.6,"unnskyld"],[10,13,79.76,79.92,"har"],[14,18,79.92,80.28,"dere"],[19,25,80.28,80.9,"ferskt"],[26,36,80.9,81.71,"lammekjøtt"]]},{"id":12,"start":82.85,"end":88.41,"text":"Ja, vent litt. Vi har mer på lager. Jeg skal hente til deg.","speaker":"Butikkmedarbeider","zh":"有，请稍等。库房里还有。我去给你拿。","words":[[0,2,82.91,83.3,"ja"],[4,8,83.4,83.66,"vent"],[9,13,83.66,84.12,"litt~54360be2a478"],[15,17,85.0,85.14,"vi"],[18,21,85.14,85.42,"har"],[22,25,85.42,85.7,"mer~6e9e1ecc8b41"],[26,28,85.7,85.86,"på~c65b2967336d"],[29,34,85.86,86.44,"lager~ca680d5824c2"],[36,39,86.88,87.12,"jeg"],[40,44,87.12,87.48,"skal"],[45,50,87.48,87.84,"hente"],[51,54,87.84,88.0,"til"],[55,58,88.0,88.26,"deg"]]},{"id":13,"start":89.2,"end":91.75,"text":"Takk. Hva koster det?","speaker":"Marit","zh":"谢谢。多少钱？","words":[[0,4,89.27,89.76,"takk"],[6,9,90.66,90.92,"hva"],[10,16,90.92,91.32,"koster"],[17,20,91.32,91.6,"det"]]},{"id":14,"start":92.81,"end":95.64,"text":"Det koster 150 kroner per kilo.","speaker":"Butikkmedarbeider","zh":"每公斤150克朗。","words":[[0,3,92.88,93.02,"det"],[4,10,93.02,93.5,"koster"],[11,14,93.5,94.36,"150"],[15,21,94.36,94.82,"kroner"],[22,25,94.82,95.08,"per"],[26,30,95.08,95.48,"kilo"]]},{"id":15,"start":97.5,"end":100.24,"text":"Marit går videre til isdisken.","zh":"玛丽特接着走到冰淇淋柜。","words":[[0,5,97.56,98.2,"marit"],[6,9,98.2,98.42,"går"],[10,16,98.42,98.96,"videre"],[17,20,98.96,99.26,"til"],[21,29,99.26,100.09,"isdisken"]]},{"id":16,"start":101.14,"end":103.36,"text":"Der finner hun vaniljeis.","zh":"她在那儿找到了香草冰淇淋。","words":[[0,3,101.2,101.68,"der"],[4,10,101.68,101.96,"finner"],[11,14,101.96,102.32,"hun"],[15,24,102.32,103.2,"vaniljeis"]]},{"id":17,"start":104.42,"end":108.25,"text":"Til slutt går hun til kassa for å betale varene.","zh":"最后她去收银台为买的东西付款。","words":[[0,3,104.48,104.7,"til~670533c5eb47"],[4,9,104.7,105.16,"slutt"],[10,13,105.16,105.4,"går"],[14,17,105.4,105.56,"hun"],[18,21,105.56,105.76,"til"],[22,27,105.76,106.32,"kassa"],[28,31,106.76,106.94,"for~caaedf1d2285"],[32,33,106.94,107.04,"å~0583da7a620a"],[34,40,107.04,107.6,"betale"],[41,47,107.6,108.1,"varene"]]},{"id":18,"start":109.95,"end":110.7,"text":"Pose?","speaker":"Butikkmedarbeider","zh":"要袋子吗？","words":[[0,4,110.01,110.55,"pose"]]},{"id":19,"start":111.59,"end":113.54,"text":"Ja, tre poser takk.","speaker":"Marit","zh":"要，三个袋子，谢谢。","words":[[0,2,111.65,112.04,"ja"],[4,7,112.26,112.64,"tre"],[8,13,112.64,113.02,"poser"],[14,18,113.02,113.39,"takk"]]},{"id":20,"start":114.32,"end":120.2,"text":"Det blir 986 kroner. Kvittering?","speaker":"Butikkmedarbeider","zh":"一共986克朗。要收据吗？","words":[[0,3,114.38,114.64,"det"],[4,8,114.64,115.26,"blir~8e63c9b279ae"],[9,12,115.26,117.12,"986"],[13,19,117.12,117.68,"kroner"],[21,31,119.46,120.05,"kvittering"]]},{"id":21,"start":121.28,"end":122.05,"text":"Nei takk.","speaker":"Marit","zh":"不用，谢谢。","words":[[0,3,121.34,121.6,"nei"],[4,8,121.6,121.9,"takk"]]},{"id":22,"start":123.06,"end":124.55,"text":"Ha en fin dag videre!","speaker":"Butikkmedarbeider","zh":"祝你今天接下来过得愉快！","words":[[0,2,123.12,123.32,"ha~809c3683ae58"],[3,5,123.32,123.48,"en~a939a9e56dc5"],[6,9,123.48,123.74,"fin"],[10,13,123.74,124.02,"dag"],[14,20,124.02,124.4,"videre~3757b46114c1"]]},{"id":23,"start":125.48,"end":127.93,"text":"Takk, i like måte, og god helg!","speaker":"Marit","zh":"谢谢，你也是，周末愉快！","words":[[0,4,125.54,125.86,"takk"],[6,7,125.86,125.94,"i~d931e4e5d506"],[8,12,125.94,126.28,"like~96c08a97a401"],[13,17,126.28,126.8,"måte~e6eb4b458deb"],[19,21,127.06,127.18,"og"],[22,25,127.18,127.4,"god"],[26,30,127.4,127.78,"helg"]]},{"id":24,"start":129.31,"end":131.56,"text":"Marit kommer hjem med varene.","zh":"玛丽特带着买的东西回到家。","words":[[0,5,129.38,130.04,"marit"],[6,12,130.04,130.36,"kommer"],[13,17,130.36,130.76,"hjem~d6e7695d7250"],[18,21,130.76,130.94,"med~b16745e3c54b"],[22,28,130.94,131.41,"varene"]]},{"id":25,"start":132.41,"end":138.42,"text":"Det er helt ryddig på kjøkkenet, men Håvard har mye mel i skjegget.","zh":"厨房收拾得干干净净，可霍瓦尔的胡子上沾满了面粉。","words":[[0,3,132.47,132.76,"det"],[4,6,132.76,133.04,"er"],[7,11,133.04,133.56,"helt~c1cd679c6e3f"],[12,18,133.56,133.94,"ryddig"],[19,21,133.94,134.08,"på"],[22,31,134.08,134.68,"kjøkkenet"],[33,36,135.56,135.82,"men"],[37,43,135.82,136.47,"håvard"],[44,47,136.72,136.98,"har"],[48,51,136.98,137.38,"mye~cc164d0dc3da"],[52,55,137.38,137.72,"mel"],[56,57,137.72,137.8,"i"],[58,66,137.8,138.27,"skjegget"]]},{"id":26,"start":139.7,"end":142.72,"text":"Han smiler og ser lur ut.","zh":"他笑着，一脸狡黠。","words":[[0,3,139.76,140.16,"han"],[4,10,140.16,140.98,"smiler"],[11,13,141.28,141.5,"og"],[14,17,141.5,141.86,"ser~c704049d5306"],[18,21,141.86,142.2,"lur"],[