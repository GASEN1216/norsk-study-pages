{"id":"8.4","title":"Marit handler til bursdagsmiddag","audio":"audio/8.4.mp3","duration":152.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.06,"text":"8.4 Marit handler til bursdagsmiddag","heading":true,"zh":"8.4 玛丽特为生日晚宴采购","words":[[0,3,0.15,1.26,"8.4"],[4,9,2.61,3.05,"marit"],[10,17,3.05,3.53,"handler"],[18,21,3.53,3.83,"til~d2dc28e242e8"],[22,36,3.83,4.98,"bursdagsmiddag"]]},{"id":1,"start":6.74,"end":12.48,"text":"Marit skal feire bursdag i kveld, og noen gode venner kommer på besøk.","zh":"玛丽特今晚要庆祝生日，几个好朋友要来做客。","words":[[0,5,6.82,7.36,"marit"],[6,10,7.36,7.6,"skal"],[11,16,7.6,8.02,"feire"],[17,24,8.02,8.5,"bursdag"],[25,26,8.5,8.68,"i~6e0a15a5aae1"],[27,32,8.68,8.9,"kveld"],[34,36,9.5,10.0,"og"],[37,41,10.0,10.36,"noen~c766e2ef794d"],[42,46,10.36,10.68,"gode"],[47,53,10.68,11.1,"venner"],[54,60,11.1,11.6,"kommer"],[61,63,11.6,11.82,"på~6e578d9937bb"],[64,69,11.82,12.4,"besøk"]]},{"id":2,"start":13.62,"end":18.79,"text":"Hun vil lage en god middag til gjestene, men først må hun handle.","zh":"她想给客人们做一顿美味的晚餐，但她得先去买东西。","words":[[0,3,13.71,13.98,"hun"],[4,7,13.98,14.24,"vil"],[8,12,14.24,14.6,"lage"],[13,15,14.6,14.84,"en~a939a9e56dc5"],[16,19,14.84,15.08,"god"],[20,26,15.08,15.52,"middag"],[27,30,15.52,15.7,"til"],[31,39,15.7,16.18,"gjestene"],[41,44,16.66,17.32,"men"],[45,50,17.32,17.72,"først"],[51,53,17.72,18.08,"må"],[54,57,18.08,18.22,"hun"],[58,64,18.22,18.71,"handle"]]},{"id":3,"start":20.1,"end":26.52,"text":"Marit drar til butikken, og Håvard blir hjemme for å rydde og støvsuge.","zh":"玛丽特去商店，霍瓦尔留在家里收拾屋子、吸尘。","words":[[0,5,20.18,20.75,"marit"],[6,10,20.75,21.17,"drar"],[11,14,21.17,21.41,"til"],[15,23,21.41,21.97,"butikken"],[25,27,22.65,23.13,"og"],[28,34,23.13,23.67,"håvard"],[35,39,23.67,24.15,"blir"],[40,46,24.15,24.59,"hjemme"],[47,50,24.59,24.87,"for~caaedf1d2285"],[51,52,24.87,24.99,"å~0583da7a620a"],[53,58,24.99,25.37,"rydde"],[59,61,25.37,25.63,"og"],[62,70,25.63,26.43,"støvsuge"]]},{"id":4,"start":27.99,"end":34.25,"text":"Han har lyst til å bake ei bursdagskake til Marit, for hun elsker kaker.","zh":"他想给玛丽特烤一个生日蛋糕，因为她最爱吃蛋糕了。","words":[[0,3,28.07,28.37,"han"],[4,7,28.37,28.59,"har"],[8,12,28.59,28.95,"lyst~b499524f55a4"],[13,16,28.95,29.19,"til~99ccdd3453b0"],[17,18,29.19,29.33,"å~0583da7a620a"],[19,23,29.33,29.69,"bake"],[24,26,29.69,29.93,"ei~47aa2d18e376"],[27,39,29.93,30.73,"bursdagskake"],[40,43,30.73,30.99,"til"],[44,49,30.99,31.43,"marit"],[51,54,32.16,32.64,"for~1b22712a94b1"],[55,58,32.64,32.86,"hun"],[59,65,32.86,33.64,"elsker"],[66,71,33.64,34.17,"kaker"]]},{"id":5,"start":36.56,"end":38.49,"text":"Marit er i butikken.","zh":"玛丽特在商店里。","words":[[0,5,36.64,37.13,"marit"],[6,8,37.13,37.59,"er"],[9,10,37.59,37.79,"i"],[11,19,37.79,38.41,"butikken"]]},{"id":6,"start":39.3,"end":45.13,"text":"Hun har ei lang handleliste, for hun skal servere en tre-retters middag.","zh":"她有一张长长的购物清单，因为她要准备一顿三道菜的晚餐。","words":[[0,3,39.38,39.69,"hun"],[4,7,39.69,39.99,"har"],[8,10,39.99,40.25,"ei~47aa2d18e376"],[11,15,40.25,40.57,"lang"],[16,27,40.57,41.37,"handleliste"],[29,32,42.13,42.45,"for~1b22712a94b1"],[33,36,42.45,42.71,"hun"],[37,41,42.71,42.97,"skal"],[42,49,42.97,43.49,"servere"],[50,52,43.49,43.75,"en~a939a9e56dc5"],[53,64,43.75,44.45,"tre-retters"],[65,71,44.45,45.05,"middag"]]},{"id":7,"start":46.62,"end":52.52,"text":"Til forrett vil hun lage ei deilig, varm gulrotsuppe med koriander.","zh":"前菜她想做一道美味的热胡萝卜汤，配香菜。","words":[[0,3,46.7,46.89,"til~a4df720bde1b"],[4,11,46.89,47.41,"forrett"],[12,15,47.41,48.11,"vil"],[16,19,48.11,48.29,"hun"],[20,24,48.29,48.63,"lage"],[25,27,48.63,48.97,"ei~47aa2d18e376"],[28,34,48.97,49.61,"deilig"],[36,40,49.81,50.15,"varm"],[41,52,50.15,51.15,"gulrotsuppe"],[53,56,51.15,51.69,"med~d8ba6b92e79b"],[57,66,51.69,52.44,"koriander"]]},{"id":8,"start":53.7,"end":61.47,"text":"Til hovedrett skal hun lage fårikål, og hun vil servere is med friske bær til dessert.","zh":"主菜她要做羊肉炖卷心菜，甜点她想上冰淇淋配新鲜浆果。","words":[[0,3,53.78,54.02,"til~9144540fda7e"],[4,13,54.02,54.6,"hovedrett"],[14,18,54.6,55.32,"skal"],[19,22,55.32,55.52,"hun"],[23,27,55.52,55.76,"lage"],[28,35,55.76,56.46,"fårikål"],[37,39,57.47,57.63,"og"],[40,43,57.63,57.89,"hun"],[44,47,57.89,58.11,"vil"],[48,55,58.11,58.63,"servere"],[56,58,58.63,58.99,"is"],[59,62,58.99,59.67,"med~1989cc008a86"],[63,69,59.67,60.19,"friske"],[70,73,60.19,60.53,"bær"],[74,77,60.53,60.59,"til~e8046f16be75"],[78,85,60.59,61.39,"dessert"]]},{"id":9,"start":62.0,"end":69.96,"text":"Hun finner gulrøtter, koriander, kål og poteter i grønnsaksdisken.","zh":"她在蔬菜柜台找到了胡萝卜、香菜、卷心菜和土豆。","words":[[0,3,62.92,63.38,"hun"],[4,10,63.38,63.84,"finner"],[11,20,63.84,64.54,"gulrøtter"],[22,31,65.24,65.78,"koriander"],[33,36,66.6,67.0,"kål"],[37,39,67.0,67.64,"og"],[40,47,67.64,68.26,"poteter"],[48,49,68.26,68.78,"i"],[50,65,68.78,69.88,"grønnsaksdisken"]]},{"id":10,"start":71.03,"end":76.84,"text":"Så går hun til kjøttdisken, men hun finner ikke lammekjøtt.","zh":"然后她去肉类柜台，但没找到羊肉。","words":[[0,2,71.11,71.81,"så~4a7ed2bb1489"],[3,6,71.81,72.09,"går"],[7,10,72.09,72.23,"hun"],[11,14,72.23,72.45,"til"],[15,26,72.45,73.19,"kjøttdisken"],[28,31,74.12,74.6,"men"],[32,35,74.6,75.28,"hun"],[36,42,75.28,75.7,"finner"],[43,47,75.7,75.94,"ikke"],[48,58,75.94,76.76,"lammekjøtt"]]},{"id":11,"start":78.82,"end":81.8,"text":"Unnskyld, har dere ferskt lammekjøtt?","speaker":"Marit","zh":"请问，你们有新鲜羊肉吗？","words":[[0,8,78.9,79.33,"unnskyld"],[10,13,79.69,79.91,"har"],[14,18,79.91,80.13,"dere"],[19,25,80.13,80.71,"ferskt"],[26,36,80.71,81.72,"lammekjøtt"]]},{"id":12,"start":82.81,"end":88.34,"text":"Ja, vent litt. Vi har mer på lager. Jeg skal hente til deg.","speaker":"Butikkmedarbeider","zh":"有，请稍等。库房里还有。我去给你拿。","words":[[0,2,82.89,83.22,"ja"],[4,8,83.34,83.54,"vent"],[9,13,83.54,83.86,"litt~54360be2a478"],[15,17,84.8,85.1,"vi"],[18,21,85.1,85.32,"har"],[22,25,85.32,85.6,"mer~6e9e1ecc8b41"],[26,28,85.6,85.8,"på~c65b2967336d"],[29,34,85.8,86.22,"lager~ca680d5824c2"],[36,39,86.86,87.0,"jeg"],[40,44,87.0,87.26,"skal"],[45,50,87.26,87.68,"hente"],[51,54,87.68,87.92,"til"],[55,58,87.92,88.26,"deg"]]},{"id":13,"start":88.91,"end":91.64,"text":"Takk. Hva koster det?","speaker":"Marit","zh":"谢谢。多少钱？","words":[[0,4,88.91,89.6,"takk"],[6,9,90.48,90.84,"hva"],[10,16,90.84,91.24,"koster"],[17,20,91.24,91.56,"det"]]},{"id":14,"start":92.8,"end":95.7,"text":"Det koster 150 kroner per kilo.","speaker":"Butikkmedarbeider","zh":"每公斤150克朗。","words":[[0,3,92.88,92.97,"det"],[4,10,92.97,93.37,"koster"],[11,14,93.37,94.15,"150"],[15,21,94.15,94.75,"kroner"],[22,25,94.75,94.97,"per"],[26,30,94.97,95.62,"kilo"]]},{"id":15,"start":97.47,"end":100.17,"text":"Marit går videre til isdisken.","zh":"玛丽特接着走到冰淇淋柜。","words":[[0,5,97.55,98.1,"marit"],[6,9,98.1,98.3,"går"],[10,16,98.3,98.82,"videre"],[17,20,98.82,99.12,"til"],[21,29,99.12,100.09,"isdisken"]]},{"id":16,"start":100.65,"end":103.29,"text":"Der finner hun vaniljeis.","zh":"她在那儿找到了香草冰淇淋。","words":[[0,3,100.8,101.54,"der"],[4,10,101.54,101.9,"finner"],[11,14,101.9,102.1,"hun"],[15,24,102.1,103.21,"vaniljeis"]]},{"id":17,"start":104.38,"end":108.17,"text":"Til slutt går hun til kassa for å betale varene.","zh":"最后她去收银台为买的东西付款。","words":[[0,3,104.46,104.61,"til~670533c5eb47"],[4,9,104.61,105.01,"slutt"],[10,13,105.01,105.29,"går"],[14,17,105.29,105.51,"hun"],[18,21,105.51,105.67,"til"],[22,27,105.67,106.05,"kassa"],[28,31,106.52,106.88,"for~caaedf1d2285"],[32,33,106.88,107.0,"å~0583da7a620a"],[34,40,107.0,107.42,"betale"],[41,47,107.42,108.09,"varene"]]},{"id":18,"start":109.91,"end":110.62,"text":"Pose?","speaker":"Butikkmedarbeider","zh":"要袋子吗？","words":[[0,4,109.99,110.54,"pose"]]},{"id":19,"start":111.55,"end":113.48,"text":"Ja, tre poser takk.","speaker":"Marit","zh":"要，三个袋子，谢谢。","words":[[0,2,111.63,111.87,"ja"],[4,7,112.29,112.53,"tre"],[8,13,112.53,112.83,"poser"],[14,18,112.83,113.4,"takk"]]},{"id":20,"start":113.54,"end":120.14,"text":"Det blir 986 kroner. Kvittering?","speaker":"Butikkmedarbeider","zh":"一共986克朗。要收据吗？","words":[[0,3,114.03,114.55,"det"],[4,8,114.55,115.03,"blir~8e63c9b279ae"],[9,12,115.03,116.97,"986"],[13,19,116.97,117.47,"kroner"],[21,31,119.32,120.06,"kvittering"]]},{"id":21,"start":121.24,"end":122.0,"text":"Nei takk.","speaker":"Marit","zh":"不用，谢谢。","words":[[0,3,121.32,121.54,"nei"],[4,8,121.54,121.92,"takk"]]},{"id":22,"start":123.02,"end":124.48,"text":"Ha en fin dag videre!","speaker":"Butikkmedarbeider","zh":"祝你今天接下来过得愉快！","words":[[0,2,123.1,123.25,"ha~809c3683ae58"],[3,5,123.25,123.45,"en~a939a9e56dc5"],[6,9,123.45,123.63,"fin"],[10,13,123.63,123.89,"dag"],[14,20,123.89,124.4,"videre~3757b46114c1"]]},{"id":23,"start":125.44,"end":127.88,"text":"Takk, i like måte, og god helg!","speaker":"Marit","zh":"谢谢，你也是，周末愉快！","words":[[0,4,125.52,125.86,"takk"],[6,7,125.86,125.94,"i~d931e4e5d506"],[8,12,125.94,126.18,"like~96c08a97a401"],[13,17,126.18,126.38,"måte~e6eb4b458deb"],[19,21,127.08,127.12,"og"],[22,25,127.12,127.34,"god"],[26,30,127.34,127.8,"helg"]]},{"id":24,"start":129.27,"end":131.51,"text":"Marit kommer hjem med varene.","zh":"玛丽特带着买的东西回到家。","words":[[0,5,129.35,129.92,"marit"],[6,12,129.92,130.2,"kommer"],[13,17,130.2,130.62,"hjem~d6e7695d7250"],[18,21,130.62,130.86,"med~b16745e3c54b"],[22,28,130.86,131.43,"varene"]]},{"id":25,"start":132.38,"end":138.35,"text":"Det er helt ryddig på kjøkkenet, men Håvard har mye mel i skjegget.","zh":"厨房收拾得干干净净，可霍瓦尔的胡子上沾满了面粉。","words":[[0,3,132.46,132.7,"det"],[4,6,132.7,132.9,"er"],[7,11,132.9,133.42,"helt~c1cd679c6e3f"],[12,18,133.42,133.86,"ryddig"],[19,21,133.86,134.02,"på"],[22,31,134.02,134.48,"kjøkkenet"],[33,36,135.34,135.7,"men"],[37,43,135.7,136.26,"håvard"],[44,47,136.26,136.84,"har"],[48,51,136.84,137.28,"mye~cc164d0dc3da"],[52,55,137.28,137.6,"mel"],[56,57,137.6,137.78,"i"],[58,66,137.78,138.28,"skjegget"]]},{"id":26,"start":139.68,"end":142.64,"text":"Han smiler og ser lur ut.","zh":"他笑着，一脸狡黠。","words":[[0,3,139.76,140.04,"han"],[4,10,140.04,140.72,"smiler"],[11,13,140.72,141.4,"og"],[14,17,141.4,141.68,"ser~c704049d5306"],[18,21,14