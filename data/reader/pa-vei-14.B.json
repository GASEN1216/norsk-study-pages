{"id":"pa-vei-14.B","bookId":"pa-vei-textbook","readingId":"14.B","title":"Liv dekker bordet","audio":"audio/pa-vei/14.B.mp3","duration":65.184,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.08,"end":6.885,"text":"Marie har nittiårsdag, og Johanna har invitert til stor bursdagsfest.","zh":"玛丽过九十岁生日，约翰娜邀请大家参加盛大的生日聚会。","words":[[0,5,1.08,1.645,"marie"],[6,9,1.76,2.025,"har"],[10,21,2.14,3.065,"nittiårsdag"],[23,25,3.58,3.725,"og"],[26,33,3.74,4.285,"johanna"],[34,37,4.38,4.545,"har"],[38,46,4.58,5.245,"invitert"],[47,50,5.28,5.465,"til"],[51,55,5.6,6.045,"stor"],[56,68,6.06,6.885,"bursdagsfest"]]},{"id":1,"start":8.34,"end":14.165,"text":"Nå lager hun eplekake mens Liv, en av tvillingene, dekker bordet.","zh":"现在，她在做苹果蛋糕，双胞胎中的莉芙在摆餐具。","words":[[0,2,8.34,8.485,"nå"],[3,8,8.66,9.043,"lager"],[9,12,9.043,9.225,"hun"],[13,21,9.34,10.085,"eplekake"],[22,26,10.6,10.925,"mens"],[27,30,10.98,11.325,"liv@pa-vei-liv-name"],[32,34,11.94,12.152,"en@pa-vei-en-one"],[35,37,12.152,12.252,"av"],[38,49,12.252,12.845,"tvillingene@pa-vei-extra-23"],[51,57,13.46,13.805,"dekker"],[58,64,13.82,14.165,"bordet"]]},{"id":2,"start":15.9,"end":18.105,"text":"Liv legger en hvit duk på bordet.","zh":"莉芙在桌上铺了一块白桌布。","words":[[0,3,15.9,16.285,"liv@pa-vei-liv-life"],[4,10,16.32,16.645,"legger"],[11,13,16.66,16.805,"en"],[14,18,16.84,17.263,"hvit"],[19,22,17.263,17.625,"duk"],[23,25,17.66,17.782,"på"],[26,32,17.782,18.105,"bordet"]]},{"id":3,"start":19.08,"end":21.425,"text":"Den hvite duken er veldig gammel.","zh":"这块白桌布很旧了。","words":[[0,3,19.08,19.265,"den@pa-vei-den-definite"],[4,9,19.28,19.725,"hvite"],[10,15,19.74,20.185,"duken"],[16,18,20.28,20.485,"er"],[19,25,20.62,21.093,"veldig"],[26,32,21.093,21.425,"gammel"]]},{"id":4,"start":22.76,"end":26.925,"text":"Den har Marie fått av sin mor for lenge, lenge siden.","zh":"这是很久很久以前，玛丽的母亲送给她的。","words":[[0,3,22.76,22.965,"den"],[4,7,23.06,23.245,"har"],[8,13,23.26,23.705,"marie"],[14,18,23.76,24.023,"fått@pa-vei-extra-21"],[19,21,24.023,24.165,"av"],[22,25,24.28,24.625,"sin"],[26,29,24.64,24.945,"mor"],[30,33,25.28,25.465,"for@pa-vei-for-excess"],[34,39,25.62,26.185,"lenge"],[41,46,26.24,26.565,"lenge"],[47,52,26.6,26.925,"siden"]]},{"id":5,"start":29.06,"end":32.245,"text":"Liv setter små og store tallerkener på bordet.","zh":"莉芙把大小盘子摆在桌上。","words":[[0,3,29.06,29.405,"liv@pa-vei-liv-life"],[4,10,29.46,29.845,"setter@pa-vei-extra-22"],[11,14,29.92,30.165,"små"],[15,17,30.46,30.605,"og"],[18,23,30.64,31.085,"store"],[24,35,31.1,31.725,"tallerkener"],[36,38,31.78,31.902,"på"],[39,45,31.902,32.245,"bordet"]]},{"id":6,"start":33.62,"end":36.125,"text":"De små tallerkenene er til forretten.","zh":"小盘子用来盛前菜。","words":[[0,2,33.62,33.765,"de@pa-vei-de-definite"],[3,6,33.86,34.085,"små"],[7,19,34.24,34.945,"tallerkenene"],[20,22,35.06,35.225,"er"],[23,26,35.24,35.425,"til"],[27,36,35.5,36.125,"forretten"]]},{"id":7,"start":36.96,"end":39.245,"text":"De store er til hovedretten.","zh":"大盘子用来盛主菜。","words":[[0,2,36.96,37.105,"de@pa-vei-de-definite"],[3,8,37.18,37.665,"store"],[9,11,38.1,38.282,"er"],[12,15,38.282,38.465,"til"],[16,27,38.52,39.245,"hovedretten"]]},{"id":8,"start":40.74,"end":43.365,"text":"Hun henter også høye og lave glass.","zh":"她还拿来高玻璃杯和矮玻璃杯。","words":[[0,3,40.74,40.925,"hun"],[4,10,40.94,41.293,"henter"],[11,15,41.293,41.585,"også"],[16,20,41.72,42.165,"høye"],[21,23,42.4,42.545,"og"],[24,28,42.64,43.043,"lave"],[29,34,43.043,43.365,"glass"]]},{"id":9,"start":44.42,"end":50.725,"text":"De lave glassene er til vann, og de høye glassene er til mineralvann eller vin.","zh":"矮杯子用来喝水，高杯子用来喝矿泉水或葡萄酒。","words":[[0,2,44.42,44.565,"de@pa-vei-de-definite"],[3,7,44.7,45.125,"lave"],[8,16,45.14,45.605,"glassene@pa-vei-extra-19"],[17,19,45.64,45.793,"er"],[20,23,45.793,45.965,"til"],[24,28,46.0,46.305,"vann"],[30,32,47.0,47.125,"og"],[33,35,47.14,47.285,"de@pa-vei-de-definite"],[36,40,47.36,47.725,"høye"],[41,49,47.74,48.205,"glassene@pa-vei-extra-20"],[50,52,48.62,48.803,"er"],[53,56,48.803,48.965,"til"],[57,68,49.0,49.825,"mineralvann"],[69,74,50.06,50.345,"eller"],[75,78,50.38,50.725,"vin"]]},{"id":10,"start":52.49,"end":55.275,"text":"Oldemora hennes er glad i et glass vin.","zh":"她的曾祖母喜欢喝一杯葡萄酒。","words":[[0,8,52.49,53.212,"oldemora"],[9,15,53.212,53.655,"hennes"],[16,18,53.79,53.955,"er"],[19,23,54.03,54.375,"glad"],[24,25,54.39,54.495,"i"],[26,28,54.51,54.653,"et"],[29,34,54.653,54.935,"glass"],[35,38,54.95,55.275,"vin"]]},{"id":11,"start":56.77,"end":59.455,"text":"På bordet er det også blomster og lys.","zh":"桌上还有鲜花和蜡烛。","words":[[0,2,56.77,56.915,"på"],[3,9,56.95,57.375,"bordet"],[10,12,57.47,57.623,"er"],[13,16,57.623,57.773,"det"],[17,21,57.773,58.035,"også"],[22,30,58.09,58.775,"blomster"],[31,33,58.89,59.035,"og"],[34,37,59.05,59.455,"lys@pa-vei-lys-candles"]]},{"id":12,"start":60.85,"end":62.375,"text":"Nå kan gjestene komme.","zh":"现在可以迎接客人了。","words":[[0,2,60.85,60.995,"nå"],[3,6,61.17,61.395,"kan"],[7,15,61.49,62.035,"gjestene"],[16,21,62.07,62.375,"komme"]]}],"lexicon":{"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"blomster":{"lemma":"blomst","zh":"花（复数）","pos":"名词","ref":"basics:seasons:blomster","form":"复数不定","clip":null},"bordet":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","form":"单数定指","clip":null},"bursdagsfest":{"lemma":"bursdagsfest","zh":"生日聚会","pos":"名词","ref":"8-076","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"de@pa-vei-de-definite":{"lemma":"de","pos":"定冠词","zh":"这些；那些（形容词前的复数定冠词）","ref":null,"clip":null,"contextual":true,"baseKey":"de","surface":"de"},"dekker":{"lemma":"dekke","pos":"动词","zh":"摆放餐具（dekke bordet）","ref":null,"clip":null,"form":"现在时"},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"den@pa-vei-den-definite":{"lemma":"den","pos":"定冠词","zh":"这个；那个（形容词或序数词前的通性定冠词）","ref":null,"clip":null,"contextual":true,"baseKey":"den","surface":"den"},"det":{"lemma":"det","zh":"这；它","pos":"代词