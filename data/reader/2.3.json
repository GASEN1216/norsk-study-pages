{"id":"2.3","title":"Jeg savner dem","audio":"audio/2.3.mp3","duration":156.38,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.14,"text":"2.3 Jeg savner dem","heading":true,"zh":"2.3 我想念他们","words":[[0,3,0.15,1.07,"2.3"],[4,7,1.1,2.06,"jeg"],[8,14,2.06,2.6,"savner"],[15,18,2.6,3.06,"dem"]]},{"id":1,"start":5.99,"end":8.5,"text":"Viola er på biblioteket.","zh":"维奥拉在图书馆。","words":[[0,5,6.04,6.9,"viola"],[6,8,7.04,7.36,"er"],[9,11,7.36,7.5,"på"],[12,23,7.5,8.35,"biblioteket"]]},{"id":2,"start":9.53,"end":15.0,"text":"Hun låner ei norsk-italiensk ordbok og sitter på lesesalen.","zh":"她借了一本挪威语—意大利语词典，坐在阅览室里。","words":[[0,3,9.59,9.9,"hun"],[4,9,9.9,10.5,"låner~799af70eadda"],[10,12,10.5,10.68,"ei~47aa2d18e376"],[13,28,10.68,12.06,"norsk-italiensk~4ccb5900aceb"],[29,35,12.06,12.79,"ordbok"],[36,38,13.16,13.34,"og"],[39,45,13.34,13.86,"sitter"],[46,48,13.86,14.04,"på"],[49,58,14.04,14.85,"lesesalen"]]},{"id":3,"start":16.24,"end":18.25,"text":"Ei jente kommer bort til henne.","zh":"一个女孩走到她跟前。","words":[[0,2,16.3,16.52,"ei~47aa2d18e376"],[3,8,16.52,17.12,"jente"],[9,15,17.12,17.46,"kommer"],[16,20,17.46,17.68,"bort~ece857f4337f"],[21,24,17.68,17.82,"til"],[25,30,17.82,18.11,"henne"]]},{"id":4,"start":20.18,"end":23.2,"text":"Hei! Lærer du italiensk?","speaker":"Synne","zh":"你好！你在学意大利语吗？","words":[[0,3,20.23,20.7,"hei"],[5,10,21.52,21.84,"lærer~0769c7af9c2d"],[11,13,21.84,22.12,"du"],[14,23,22.12,23.05,"italiensk~7d9db500feea"]]},{"id":5,"start":23.64,"end":30.34,"text":"Nei, men jeg er italiensk. Jeg er au pair og lærer norsk.","speaker":"Viola","zh":"不是，不过我是意大利人。我是互惠生（住家保姆），正在学挪威语。","words":[[0,3,23.7,24.31,"nei"],[5,8,24.94,25.16,"men"],[9,12,25.16,25.54,"jeg"],[13,15,25.68,26.24,"er"],[16,25,26.24,27.23,"italiensk~7c30b65a690f"],[27,30,28.02,28.22,"jeg"],[31,33,28.22,28.44,"er"],[34,36,28.44,28.6,"au"],[37,41,28.6,29.26,"pair"],[42,44,29.26,29.38,"og"],[45,50,29.38,29.72,"lærer~0769c7af9c2d"],[51,56,29.72,30.19,"norsk~4de5d75feae1"]]},{"id":6,"start":31.04,"end":34.13,"text":"Jeg er norsk, men jeg liker Italia!","speaker":"Synne","zh":"我是挪威人，但我喜欢意大利！","words":[[0,3,31.09,31.42,"jeg"],[4,6,31.42,31.54,"er"],[7,12,31.54,32.22,"norsk~300c0d0c4f59"],[14,17,32.52,32.66,"men"],[18,21,32.66,32.84,"jeg"],[22,27,32.84,33.32,"liker"],[28,34,33.32,33.98,"italia"]]},{"id":7,"start":34.66,"end":36.52,"text":"Snakker du italiensk?","speaker":"Viola","zh":"你会说意大利语吗？","words":[[0,7,34.72,35.18,"snakker"],[8,10,35.18,35.46,"du"],[11,20,35.46,36.38,"italiensk~7d9db500feea"]]},{"id":8,"start":36.98,"end":42.23,"text":"Nei, men jeg forstår litt. Pizza, pasta og mafia.","speaker":"Synne","zh":"不会，但我能听懂一点。披萨、意大利面和黑手党。","words":[[0,3,37.04,37.52,"nei"],[5,8,37.98,38.12,"men"],[9,12,38.12,38.26,"jeg"],[13,20,38.26,38.84,"forstår"],[21,25,38.84,39.35,"litt~462e893626a5"],[27,32,39.88,40.59,"pizza"],[34,39,40.72,41.38,"pasta"],[40,42,41.38,41.5,"og"],[43,48,41.5,42.08,"mafia"]]},{"id":9,"start":44.5,"end":46.74,"text":"Jeg liker italiensk pizza.","speaker":"Synne","zh":"我喜欢意大利披萨。","words":[[0,3,44.56,44.8,"jeg"],[4,9,44.8,45.22,"liker"],[10,19,45.22,46.08,"italiensk~7c30b65a690f"],[20,25,46.08,46.59,"pizza"]]},{"id":10,"start":47.43,"end":52.05,"text":"Jeg liker ikke norsk pizza. Hva heter du?","speaker":"Viola","zh":"我不喜欢挪威披萨。你叫什么名字？","words":[[0,3,47.49,47.94,"jeg"],[4,9,47.94,48.3,"liker"],[10,14,48.3,48.74,"ikke"],[15,20,48.74,49.2,"norsk~300c0d0c4f59"],[21,26,49.2,49.81,"pizza"],[28,31,51.04,51.34,"hva"],[32,37,51.34,51.68,"heter"],[38,40,51.68,51.91,"du"]]},{"id":11,"start":52.48,"end":53.85,"text":"Jeg heter Synne.","speaker":"Synne","zh":"我叫辛妮。","words":[[0,3,52.55,52.8,"jeg"],[4,9,52.8,53.2,"heter"],[10,15,53.2,53.7,"synne"]]},{"id":12,"start":54.31,"end":58.45,"text":"Jeg heter Viola. Hyggelig å hilse på deg!","speaker":"Viola","zh":"我叫维奥拉。很高兴认识你！","words":[[0,3,54.38,54.78,"jeg"],[4,9,54.78,55.32,"heter"],[10,15,55.32,55.95,"viola"],[17,25,57.04,57.42,"hyggelig"],[26,27,57.42,57.54,"å~0583da7a620a"],[28,33,57.54,57.9,"hilse"],[34,36,57.9,58.02,"på~4d7f4608a94e"],[37,40,58.02,58.3,"deg"]]},{"id":13,"start":59.83,"end":61.65,"text":"Når kom du til Norge?","speaker":"Synne","zh":"你什么时候来挪威的？","words":[[0,3,59.89,60.26,"når~a56a1c61425b"],[4,7,60.26,60.52,"kom~a03d8aa690db"],[8,10,60.52,60.7,"du"],[11,14,60.7,60.92,"til"],[15,20,60.92,61.5,"norge~546b56e35dd5"]]},{"id":14,"start":62.28,"end":63.87,"text":"Jeg kom i mars.","speaker":"Viola","zh":"我三月来的。","words":[[0,3,62.34,62.78,"jeg"],[4,7,62.78,63.14,"kom~a03d8aa690db"],[8,9,63.14,63.26,"i"],[10,14,63.26,63.72,"mars"]]},{"id":15,"start":64.42,"end":66.3,"text":"Du er god i norsk!","speaker":"Synne","zh":"你的挪威语很好！","words":[[0,2,64.48,64.76,"du"],[3,5,64.76,65.06,"er"],[6,9,65.06,65.46,"god~80d8d2a3389b"],[10,11,65.46,65.6,"i~2f0e448f7280"],[12,17,65.6,66.15,"norsk~4de5d75feae1"]]},{"id":16,"start":66.9,"end":71.56,"text":"Tusen takk! Hva gjør du på biblioteket?","speaker":"Viola","zh":"非常感谢！你在图书馆做什么？","words":[[0,5,66.96,67.56,"tusen"],[6,10,67.56,68.08,"takk"],[12,15,69.44,69.7,"hva"],[16,20,69.7,69.96,"gjør"],[21,23,69.96,70.22,"du"],[24,26,70.22,70.4,"på"],[27,38,70.4,71.41,"biblioteket"]]},{"id":17,"start":72.09,"end":78.04,"text":"Jeg leser og gjør lekser. Jeg har test i morgen. Liker du Norge?","speaker":"Synne","zh":"我在看书、做作业。我明天有考试。你喜欢挪威吗？","words":[[0,3,72.15,72.44,"jeg"],[4,9,72.44,73.06,"leser"],[10,12,73.06,73.18,"og"],[13,17,73.18,73.38,"gjør"],[18,24,73.38,74.08,"lekser"],[26,29,74.7,74.86,"jeg"],[30,33,74.86,75.04,"har"],[34,38,75.04,75.44,"test"],[39,40,75.44,75.52,"i~46dcc9198d6d"],[41,47,75.52,76.12,"morgen~a09fa253039f"],[49,54,76.96,77.32,"liker"],[55,57,77.32,77.46,"du"],[58,63,77.46,77.89,"norge~546b56e35dd5"]]},{"id":18,"start":78.48,"end":87.17,"text":"Ja, men jeg savner venner og familie. Jeg snakker med dem på Skype, og de ringer til meg.","speaker":"Viola","zh":"喜欢，但我想念朋友和家人。我在 Skype 上和他们聊天，他们也给我打电话。","words":[[0,2,78.54,78.96,"ja"],[4,7,80.08,80.26,"men"],[8,11,80.26,80.54,"jeg"],[12,18,80.54,81.06,"savner"],[19,25,81.06,81.48,"venner"],[26,28,81.48,81.64,"og"],[29,36,81.64,82.4,"familie"],[38,41,83.62,83.9,"jeg"],[42,49,83.9,84.3,"snakker"],[50,53,84.3,84.46,"med"],[54,57,84.46,84.66,"dem"],[58,60,84.66,84.82,"på~acc985c9313f"],[61,66,84.82,85.48,"skype"],[68,70,85.88,86.02,"og"],[71,73,86.02,86.22,"de"],[74,80,86.22,86.54,"ringer~2a328146b7c5"],[81,84,86.54,86.74,"til~e7e10aca9191"],[85,88,86.74,87.02,"meg"]]},{"id":19,"start":88.38,"end":91.2,"text":"Skal vi gå på kafé og drikke kaffe en dag?","speaker":"Synne","zh":"我们哪天一起去咖啡馆喝咖啡好吗？","words":[[0,4,88.44,88.72,"skal~d1b9dc119407"],[5,7,88.72,88.82,"vi"],[8,10,88.82,89.0,"gå"],[11,13,89.0,89.16,"på~3ac21efb6a73"],[14,18,89.16,89.8,"kafé"],[19,21,89.8,89.9,"og"],[22,28,89.9,90.2,"drikke~f9439ee27976"],[29,34,90.2,90.62,"kaffe"],[35,37,90.62,90.76,"en~a939a9e56dc5"],[38,41,90.76,91.05,"dag~4cbe30580433"]]},{"id":20,"start":91.56,"end":96.37,"text":"Å ja! Det vil jeg. Har du et telefonnummer?","speaker":"Viola","zh":"哦，好啊！我很愿意。你有电话号码吗？","words":[[0,1,91.62,91.8,"å~0583da7a620a"],[2,4,91.8,92.14,"ja"],[6,9,92.76,93.02,"det~c301a564b27c"],[10,13,93.02,93.22,"vil~318e128ecce9"],[14,17,93.22,93.62,"jeg"],[19,22,94.64,94.82,"har"],[23,25,94.82,95.0,"du"],[26,28,95.0,95.36,"et~054dde72f37b"],[29,42,95.36,96.22,"telefonnummer"]]},{"id":21,"start":97.1,"end":103.17,"text":"998 78 899","speaker":"Synne","zh":"998 78 899（电话号码）","words":[[0,3,97.18,98.69,"998"],[4,6,99.67,100.88,"78"],[7,10,101.69,103.09,"899"]]},{"id":22,"start":103.92,"end":106.18,"text":"Unnskyld, kan du gjenta?","speaker":"Viola","zh":"不好意思，你能再说一遍吗？","words":[[0,8,103.98,104.7,"unnskyld"],[10,13,105.04,105.28,"kan"],[14,16,105.28,105.42,"du"],[17,23,105.42,106.03,"gjenta"]]},{"id":23,"start":107.75,"end":116.18,"text":"998 78 899","speaker":"Synne","zh":"998 78 899（电话号码）","words":[[0,3,107.83,109.57,"998"],[4,6,110.94,112.48,"78"],[7,10,113.89,116.1,"899"]]},{"id":24,"start":117.05,"end":120.27,"text":"Takk! Jeg sender deg en SMS.","speaker":"Viola","zh":"谢谢！我给你发条短信。","words":[[0,4,117.11,117.72,"takk"],[6,9,118.46,118.72,"jeg"],[10,16,118.72,119.0,"sender"],[17,20,119.0,119.24,"deg"],[21,23,119.24,119.5,"en~a939a9e56dc5"],[24,27,119.5,120.12,"sms"]]},{"id":25,"start":124.3,"end":125.56,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,124.36,125.41,"sammendrag"]]},{"id":26,"start":127.07,"end":131.65,"text":"Viola møter ei norsk jente på biblioteket.","zh":"维奥拉在图书馆遇见一个挪威女孩。","words":[[0,5,127.13,127.88,"viola"],[6,11,128.22,128.74,"møter~af568d886d8f"],[12,14,128.74,128.92,"ei~47aa2d18e376"],[15,20,128.92,129.42,"norsk~300c0d0c4f59"],[21,26,129.42,130.14,"jente"],[27,29,130.14,130.52,"på"],[30,41,130.52,131.5,"biblioteket"]]},{"id":27,"start":132.84,"end":134.65,"text":"Hun heter Synne.","zh":"她叫辛妮。","words":[[0,3,132.91,133.26,"hun"],[4,9,133.26,134.0,"heter"],[10,15,134.0,134.5,"synne"]]},{"id":28,"start":135.28,"end":136.81,"text":"De snakker sammen.","zh":"她们在交谈。","words":[[0,2,135.34,135.74,"de"],[3,10,135.74,136.22,"snakker"],[11,17,136.22,136.66,"sammen"]]},{"id":29,"start":140.77,"end":145.4,"text":"Unnskyld, Håvard, hva betyr V2-regelen?","zh":"不好意思，霍瓦尔，V2 规则是什么意思？","words":[[0,8,140.85,141.4,"unnskyld"],[10,16,141.42,141.82,"håvard"],[18,21,142.76,143.12,"hva"],[22,27,143.12,143.7,"betyr"],[28,38,143.7,145.32,"v2-regelen"]]},{"id":30,"start":145.91,"end":152.75,"text":"V2-regelen betyr at verb har plass nummer to i en setning!","zh":"V2 规则的意思是：动词在句子中处于第二位！","words":[[0,10,145.98,148.08,"v2-regelen"],[11,16,148.08,148.68,"betyr"],[17,19,148.68,148.88,"at"],[20,24,148.88,149.32,"verb"],[25,28,149.32,150.04,"har"],[29,34,150.04,150.52,"plass"],[35,41,150.52,151.04,"nummer"],[42,44,151.04,151.38,"to"],[45,46,151.42,151.94,"i"],[47,49,151.94,152.08,"en~a939a9e56dc5"],[50,57,152.08,152.67,"setning"]]}],"lexicon":{"2.3":{"lemma":"2.3","zh":"第 2.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"78":{"lemma":"sju åtte","zh":"78（电话号码的一组，逐位读作 sju åtte）","pos":"数词","ref":null,"clip":null,"kind":"number"},"899":{"