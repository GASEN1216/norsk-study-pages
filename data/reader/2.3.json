{"id":"2.3","title":"Jeg savner dem","audio":"audio/2.3.mp3","duration":156.38,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.14,"text":"2.3 Jeg savner dem","heading":true,"zh":"2.3 我想念他们","words":[[0,3,0.15,1.07,"2.3"],[4,7,1.1,2.06,"jeg"],[8,14,2.06,2.6,"savner"],[15,18,2.6,3.06,"dem"]]},{"id":1,"start":5.91,"end":8.42,"text":"Viola er på biblioteket.","zh":"维奥拉在图书馆。","words":[[0,5,5.99,6.67,"viola"],[6,8,6.67,7.25,"er"],[9,11,7.25,7.43,"på"],[12,23,7.43,8.34,"biblioteket"]]},{"id":2,"start":9.51,"end":14.92,"text":"Hun låner ei norsk-italiensk ordbok og sitter på lesesalen.","zh":"她借了一本挪威语—意大利语词典，坐在阅览室里。","words":[[0,3,9.59,9.79,"hun"],[4,9,9.79,10.31,"låner~799af70eadda"],[10,12,10.31,10.59,"ei~47aa2d18e376"],[13,28,10.59,11.95,"norsk-italiensk~4ccb5900aceb"],[29,35,11.95,12.49,"ordbok"],[36,38,12.49,13.25,"og"],[39,45,13.25,13.51,"sitter"],[46,48,13.51,13.97,"på"],[49,58,13.97,14.84,"lesesalen"]]},{"id":3,"start":15.53,"end":18.2,"text":"Ei jente kommer bort til henne.","zh":"一个女孩走到她跟前。","words":[[0,2,15.9,16.5,"ei~47aa2d18e376"],[3,8,16.54,16.94,"jente"],[9,15,16.94,17.28,"kommer"],[16,20,17.28,17.62,"bort~ece857f4337f"],[21,24,17.62,17.78,"til"],[25,30,17.78,18.12,"henne"]]},{"id":4,"start":20.14,"end":23.15,"text":"Hei! Lærer du italiensk?","speaker":"Synne","zh":"你好！你在学意大利语吗？","words":[[0,3,20.22,20.64,"hei"],[5,10,21.32,21.74,"lærer~0769c7af9c2d"],[11,13,21.74,22.0,"du"],[14,23,22.0,23.07,"italiensk~7d9db500feea"]]},{"id":5,"start":23.61,"end":30.29,"text":"Nei, men jeg er italiensk. Jeg er au pair og lærer norsk.","speaker":"Viola","zh":"不是，不过我是意大利人。我是互惠生（住家保姆），正在学挪威语。","words":[[0,3,23.69,24.16,"nei"],[5,8,24.62,25.02,"men"],[9,12,25.02,25.36,"jeg"],[13,15,25.36,25.96,"er"],[16,25,25.96,27.04,"italiensk~7c30b65a690f"],[27,30,27.7,28.14,"jeg"],[31,33,28.14,28.3,"er"],[34,36,28.3,28.58,"au"],[37,41,28.58,28.86,"pair"],[42,44,28.86,29.34,"og"],[45,50,29.34,29.62,"lærer~0769c7af9c2d"],[51,56,29.62,30.21,"norsk~4de5d75feae1"]]},{"id":6,"start":30.7,"end":34.05,"text":"Jeg er norsk, men jeg liker Italia!","speaker":"Synne","zh":"我是挪威人，但我喜欢意大利！","words":[[0,3,30.7,31.3,"jeg"],[4,6,31.3,31.5,"er"],[7,12,31.5,32.02,"norsk~300c0d0c4f59"],[14,17,32.34,32.62,"men"],[18,21,32.62,32.78,"jeg"],[22,27,32.78,33.24,"liker"],[28,34,33.24,33.97,"italia"]]},{"id":7,"start":34.62,"end":36.47,"text":"Snakker du italiensk?","speaker":"Viola","zh":"你会说意大利语吗？","words":[[0,7,34.7,35.14,"snakker"],[8,10,35.14,35.34,"du"],[11,20,35.34,35.74,"italiensk~7d9db500feea"]]},{"id":8,"start":36.47,"end":42.17,"text":"Nei, men jeg forstår litt. Pizza, pasta og mafia.","speaker":"Synne","zh":"不会，但我能听懂一点。披萨、意大利面和黑手党。","words":[[0,3,36.58,37.38,"nei"],[5,8,37.68,38.08,"men"],[9,12,38.08,38.22,"jeg"],[13,20,38.22,38.72,"forstår"],[21,25,38.72,39.04,"litt~462e893626a5"],[27,32,39.66,40.38,"pizza"],[34,39,40.68,41.02,"pasta"],[40,42,41.02,41.46,"og"],[43,48,41.46,42.09,"mafia"]]},{"id":9,"start":42.31,"end":46.7,"text":"Jeg liker italiensk pizza.","speaker":"Synne","zh":"我喜欢意大利披萨。","words":[[0,3,43.92,44.72,"jeg"],[4,9,44.72,45.14,"liker"],[10,19,45.14,46.0,"italiensk~7c30b65a690f"],[20,25,46.0,46.62,"pizza"]]},{"id":10,"start":47.39,"end":52.0,"text":"Jeg liker ikke norsk pizza. Hva heter du?","speaker":"Viola","zh":"我不喜欢挪威披萨。你叫什么名字？","words":[[0,3,47.47,47.84,"jeg"],[4,9,47.84,48.26,"liker"],[10,14,48.26,48.48,"ikke"],[15,20,48.48,49.14,"norsk~300c0d0c4f59"],[21,26,49.14,49.42,"pizza"],[28,31,50.72,51.26,"hva"],[32,37,51.26,51.56,"heter"],[38,40,51.56,51.92,"du"]]},{"id":11,"start":52.44,"end":53.79,"text":"Jeg heter Synne.","speaker":"Synne","zh":"我叫辛妮。","words":[[0,3,52.52,52.76,"jeg"],[4,9,52.76,53.0,"heter"],[10,15,53.0,53.71,"synne"]]},{"id":12,"start":54.28,"end":58.39,"text":"Jeg heter Viola. Hyggelig å hilse på deg!","speaker":"Viola","zh":"我叫维奥拉。很高兴认识你！","words":[[0,3,54.36,54.7,"jeg"],[4,9,54.7,55.08,"heter"],[10,15,55.08,55.6,"viola"],[17,25,56.89,57.39,"hyggelig"],[26,27,57.39,57.49,"å~0583da7a620a"],[28,33,57.49,57.85,"hilse"],[34,36,57.85,57.97,"på~4d7f4608a94e"],[37,40,57.97,58.31,"deg"]]},{"id":13,"start":59.79,"end":61.57,"text":"Når kom du til Norge?","speaker":"Synne","zh":"你什么时候来挪威的？","words":[[0,3,59.87,60.13,"når~a56a1c61425b"],[4,7,60.13,60.39,"kom~a03d8aa690db"],[8,10,60.39,60.59,"du"],[11,14,60.59,60.81,"til"],[15,20,60.81,61.49,"norge~546b56e35dd5"]]},{"id":14,"start":62.24,"end":63.81,"text":"Jeg kom i mars.","speaker":"Viola","zh":"我三月来的。","words":[[0,3,62.32,62.68,"jeg"],[4,7,62.68,62.96,"kom~a03d8aa690db"],[8,9,62.96,63.22,"i"],[10,14,63.22,63.73,"mars"]]},{"id":15,"start":64.38,"end":66.24,"text":"Du er god i norsk!","speaker":"Synne","zh":"你的挪威语很好！","words":[[0,2,64.46,64.68,"du"],[3,5,64.68,64.92,"er"],[6,9,64.92,65.32,"god~80d8d2a3389b"],[10,11,65.32,65.54,"i~2f0e448f7280"],[12,17,65.54,66.16,"norsk~4de5d75feae1"]]},{"id":16,"start":66.84,"end":71.51,"text":"Tusen takk! Hva gjør du på biblioteket?","speaker":"Viola","zh":"非常感谢！你在图书馆做什么？","words":[[0,5,66.92,67.48,"tusen"],[6,10,67.7,67.86,"takk"],[12,15,68.9,69.64,"hva"],[16,20,69.64,69.86,"gjør"],[21,23,69.86,70.1,"du"],[24,26,70.1,70.32,"på"],[27,38,70.32,71.43,"biblioteket"]]},{"id":17,"start":72.01,"end":77.98,"text":"Jeg leser og gjør lekser. Jeg har test i morgen. Liker du Norge?","speaker":"Synne","zh":"我在看书、做作业。我明天有考试。你喜欢挪威吗？","words":[[0,3,72.09,72.36,"jeg"],[4,9,72.36,73.0,"leser"],[10,12,73.0,73.14,"og"],[13,17,73.14,73.34,"gjør"],[18,24,73.34,73.86,"lekser"],[26,29,74.5,74.82,"jeg"],[30,33,74.82,74.96,"har"],[34,38,74.96,75.32,"test"],[39,40,75.32,75.5,"i~46dcc9198d6d"],[41,47,75.5,75.7,"morgen~a09fa253039f"],[49,54,76.74,77.22,"liker"],[55,57,77.22,77.42,"du"],[58,63,77.42,77.9,"norge~546b56e35dd5"]]},{"id":18,"start":78.43,"end":87.08,"text":"Ja, men jeg savner venner og familie. Jeg snakker med dem på Skype, og de ringer til meg.","speaker":"Viola","zh":"喜欢，但我想念朋友和家人。我在 Skype 上和他们聊天，他们也给我打电话。","words":[[0,2,78.51,78.88,"ja"],[4,7,79.78,80.24,"men"],[8,11,80.24,80.42,"jeg"],[12,18,80.42,80.9,"savner"],[19,25,80.9,81.4,"venner"],[26,28,81.4,81.56,"og"],[29,36,81.56,82.2,"familie"],[38,41,83.46,83.76,"jeg"],[42,49,83.76,84.2,"snakker"],[50,53,84.2,84.4,"med"],[54,57,84.4,84.56,"dem"],[58,60,84.56,84.76,"på~acc985c9313f"],[61,66,84.76,85.12,"skype"],[68,70,85.68,85.98,"og"],[71,73,85.98,86.14,"de"],[74,80,86.14,86.5,"ringer~2a328146b7c5"],[81,84,86.5,86.64,"til~e7e10aca9191"],[85,88,86.64,87.0,"meg"]]},{"id":19,"start":87.41,"end":90.94,"text":"Skal vi gå på kafé og drikke kaffe en dag?","speaker":"Synne","zh":"我们哪天一起去咖啡馆喝咖啡好吗？","words":[[0,4,88.01,88.65,"skal~d1b9dc119407"],[5,7,88.65,88.79,"vi"],[8,10,88.79,88.93,"gå"],[11,13,88.93,89.09,"på~3ac21efb6a73"],[14,18,89.09,89.63,"kafé"],[19,21,89.63,89.87,"og"],[22,28,89.87,90.13,"drikke~f9439ee27976"],[29,34,90.13,90.49,"kaffe"],[35,37,90.49,90.73,"en~a939a9e56dc5"],[38,41,90.73,90.94,"dag~4cbe30580433"]]},{"id":20,"start":91.06,"end":96.31,"text":"Å ja! Det vil jeg. Har du et telefonnummer?","speaker":"Viola","zh":"哦，好啊！我很愿意。你有电话号码吗？","words":[[0,1,91.06,91.71,"å~0583da7a620a"],[2,4,91.71,92.01,"ja"],[6,9,92.57,92.93,"det~c301a564b27c"],[10,13,92.93,93.15,"vil~318e128ecce9"],[14,17,93.15,93.35,"jeg"],[19,22,94.49,94.79,"har"],[23,25,94.79,94.93,"du"],[26,28,94.93,95.17,"et~054dde72f37b"],[29,42,95.17,96.23,"telefonnummer"]]},{"id":21,"start":97.1,"end":103.17,"text":"998 78 899","speaker":"Synne","zh":"998 78 899（电话号码）","words":[[0,3,97.18,98.69,"998"],[4,6,99.67,100.88,"78"],[7,10,101.69,103.09,"899"]]},{"id":22,"start":103.88,"end":106.12,"text":"Unnskyld, kan du gjenta?","speaker":"Viola","zh":"不好意思，你能再说一遍吗？","words":[[0,8,103.96,104.4,"unnskyld"],[10,13,104.9,105.22,"kan"],[14,16,105.22,105.36,"du"],[17,23,105.36,106.04,"gjenta"]]},{"id":23,"start":107.75,"end":116.18,"text":"998 78 899","speaker":"Synne","zh":"998 78 899（电话号码）","words":[[0,3,107.83,109.57,"998"],[4,6,110.94,112.48,"78"],[7,10,113.89,116.1,"899"]]},{"id":24,"start":117.01,"end":120.21,"text":"Takk! Jeg sender deg en SMS.","speaker":"Viola","zh":"谢谢！我给你发条短信。","words":[[0,4,117.09,117.6,"takk"],[6,9,118.26,118.64,"jeg"],[10,16,118.64,118.96,"sender"],[17,20,118.96,119.12,"deg"],[21,23,119.12,119.38,"en~a939a9e56dc5"],[24,27,119.38,120.13,"sms"]]},{"id":25,"start":124.27,"end":125.52,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,124.35,125.44,"sammendrag"]]},{"id":26,"start":127.03,"end":131.6,"text":"Viola møter ei norsk jente på biblioteket.","zh":"维奥拉在图书馆遇见一个挪威女孩。","words":[[0,5,127.11,127.62,"viola"],[6,11,128.26,128.62,"møter~af568d886d8f"],[12,14,128.64,128.86,"ei~47aa2d18e376"],[15,20,128.86,129.34,"norsk~300c0d0c4f59"],[21,26,129.34,129.92,"jente"],[27,29,129.92,130.38,"på"],[30,41,130.38,131.52,"biblioteket"]]},{"id":27,"start":132.41,"end":134.59,"text":"Hun heter Synne.","zh":"她叫辛妮。","words":[[0,3,132.49,133.17,"hun"],[4,9,133.17,133.49,"heter"],[10,15,133.49,134.52,"synne"]]},{"id":28,"start":135.24,"end":136.75,"text":"De snakker sammen.","zh":"她们在交谈。","words":[[0,2,135.32,135.63,"de"],[3,10,135.63,136.15,"snakker"],[11,17,136.15,136.67,"sammen"]]},{"id":29,"start":140.77,"end":145.4,"text":"Unnskyld, Håvard, hva betyr V2-regelen?","zh":"不好意思，霍瓦尔，V2 规则是什么意思？","words":[[0,8,140.85,141.4,"unnskyld"],[10,16,141.42,141.82,"håvard"],[18,21,142.76,143.12,"hva"],[22,27,143.12,143.7,"betyr"],[28,38,143.7,145.32,"v2-regelen"]]},{"id":30,"start":145.91,"end":152.75,"text":"V2-regelen betyr at verb har plass nummer to i en setning!","zh":"V2 规则的意思是：动词在句子中处于第二位！","words":[[0,10,145.98,148.08,"v2-regelen"],[11,16,148.08,148.68,"betyr"],[17,19,148.68,148.88,"at"],[20,24,148.88,149.32,"verb"],[25,28,149.32,150.04,"har"],[29,34,150.04,150.52,"plass"],[35,41,150.52,151.04,"nummer"],[42,44,151.04,151.38,"to"],[45,46,151.42,151.94,"i"],[47,49,151.94,152.08,"en~a939a9e56dc5"],[50,57,152.08,152.67,"setning"]]}],"lexicon":{"2.3":{"lemma":"2.3","zh":"第 2.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"78":{"lemma":"sju åtte","zh":"78（电话号码的一组，逐位读作 sju åtte）","pos":"数词","ref":null,"clip":null,"kin