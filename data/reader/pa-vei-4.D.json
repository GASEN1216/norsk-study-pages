{"id":"pa-vei-4.D","bookId":"pa-vei-textbook","readingId":"4.D","title":"Hjem til middag","audio":"audio/pa-vei/4.D.mp3","duration":66.164042,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.52,"end":4.045,"text":"D. Hjem til middag","zh":"D. 回家吃晚饭","words":[[0,1,1.52,2.0,"d"],[3,7,3.16,3.365,"hjem"],[8,11,3.44,3.605,"til"],[12,18,3.62,4.045,"middag"]]},{"id":1,"start":5.8,"end":9.045,"text":"Etter jobben henter Henrik Emma på skolen.","zh":"下班后，亨里克去学校接埃玛。","words":[[0,5,5.8,6.225,"etter"],[6,12,6.26,6.685,"jobben"],[13,19,6.88,7.345,"henter"],[20,26,7.4,7.905,"henrik"],[27,31,8.02,8.325,"emma"],[32,34,8.42,8.565,"på"],[35,41,8.6,9.045,"skolen"]]},{"id":2,"start":10.28,"end":12.865,"text":"Så drar de sammen til butikken og handler.","zh":"然后他们一起去商店买东西。","words":[[0,2,10.28,10.445,"så"],[3,7,10.54,10.793,"drar"],[8,10,10.793,10.925,"de"],[11,17,10.98,11.365,"sammen"],[18,21,11.4,11.565,"til"],[22,30,11.58,12.185,"butikken"],[31,33,12.28,12.405,"og"],[34,41,12.42,12.865,"handler"]]},{"id":3,"start":14.474,"end":17.399,"text":"De kjøper fiskeboller og blomkål til middag.","zh":"他们买了鱼丸和花椰菜作为晚餐。","words":[[0,2,14.474,14.619,"de"],[3,9,14.714,15.139,"kjøper"],[10,21,15.194,15.939,"fiskeboller"],[22,24,16.034,16.179,"og"],[25,32,16.214,16.839,"blomkål"],[33,36,16.854,17.017,"til"],[37,43,17.017,17.399,"middag"]]},{"id":4,"start":18.754,"end":21.839,"text":"Henrik lager middag, og Emma dekker bordet.","zh":"亨里克做晚饭，埃玛摆餐具。","words":[[0,6,18.754,19.236,"henrik"],[7,12,19.236,19.537,"lager"],[13,19,19.537,19.959,"middag"],[21,23,20.494,20.639,"og"],[24,28,20.714,21.019,"emma"],[29,35,21.194,21.496,"dekker"],[36,42,21.496,21.839,"bordet"]]},{"id":5,"start":23.254,"end":26.619,"text":"Hun er sulten og får en fiskebolle av Henrik.","zh":"她饿了，亨里克给了她一个鱼丸。","words":[[0,3,23.254,23.439,"hun"],[4,6,23.474,23.619,"er"],[7,13,23.654,24.199,"sulten"],[14,16,24.614,24.739,"og"],[17,20,24.774,25.037,"får"],[21,23,25.037,25.179,"en"],[24,34,25.254,26.019,"fiskebolle"],[35,37,26.034,26.176,"av"],[38,44,26.176,26.619,"henrik"]]},{"id":6,"start":29.054,"end":31.339,"text":"Marianne henter Jonas i barnehagen.","zh":"玛丽安娜去幼儿园接约纳斯。","words":[[0,8,29.054,29.659,"marianne"],[9,15,29.734,30.139,"henter"],[16,21,30.154,30.657,"jonas"],[22,23,30.657,30.747,"i"],[24,34,30.747,31.339,"barnehagen"]]},{"id":7,"start":32.414,"end":34.359,"text":"Han er trøtt og litt sur.","zh":"他很困，有点闹脾气。","words":[[0,3,32.414,32.619,"han"],[4,6,32.694,32.859,"er"],[7,12,32.934,33.419,"trøtt"],[13,15,33.594,33.719,"og"],[16,20,33.734,33.999,"litt"],[21,24,34.034,34.359,"sur"]]},{"id":8,"start":36.554,"end":41.339,"text":"Hjemme er maten ferdig, og de spiser middag og snakker sammen.","zh":"家里的饭已经做好了，他们边吃晚饭边聊天。","words":[[0,6,36.554,36.939,"hjemme"],[7,9,37.034,37.199,"er"],[10,15,37.234,37.739,"maten"],[16,22,37.794,38.199,"ferdig"],[24,26,38.794,38.939,"og"],[27,29,38.954,39.099,"de"],[30,36,39.134,39.559,"spiser"],[37,43,39.574,40.059,"middag"],[44,46,40.414,40.539,"og"],[47,54,40.574,40.979,"snakker"],[55,61,41.014,41.339,"sammen"]]},{"id":9,"start":43.494,"end":45.819,"text":"Etter middag drikker foreldrene kaffe.","zh":"晚饭后，父母俩喝咖啡。","words":[[0,5,43.494,43.839,"etter"],[6,12,43.854,44.299,"middag"],[13,20,44.354,44.739,"drikker"],[21,31,44.774,45.419,"foreldrene"],[32,37,45.454,45.819,"kaffe"]]},{"id":10,"start":46.994,"end":52.859,"text":"Marianne sitter i sofaen og leser avisen, og Henrik sitter i en stol og leser ei bok.","zh":"玛丽安娜坐在沙发上看报，亨里克坐在椅子上看书。","words":[[0,8,46.994,47.559,"marianne"],[9,15,47.594,47.927,"sitter"],[16,17,47.927,48.017,"i"],[18,24,48.017,48.559,"sofaen"],[25,27,48.594,48.707,"og"],[28,33,48.707,49.026,"leser"],[34,40,49.026,49.499,"avisen"],[42,44,50.154,50.299,"og"],[45,51,50.314,50.759,"henrik"],[52,58,50.774,51.087,"sitter"],[59,60,51.087,51.186,"i"],[61,63,51.186,51.319,"en"],[64,68,51.354,51.719,"stol"],[69,71,51.834,51.966,"og"],[72,77,51.966,52.326,"leser"],[78,80,52.326,52.459,"ei"],[81,84,52.474,52.859,"bok"]]},{"id":11,"start":53.854,"end":55.199,"text":"Barna leker på gulvet.","zh":"孩子们在地板上玩。","words":[[0,5,53.854,54.239,"barna"],[6,11,54.274,54.699,"leker"],[12,14,54.714,54.837,"på"],[15,21,54.837,55.199,"gulvet"]]},{"id":12,"start":57.134,"end":60.179,"text":"Emma har lekser, og Marianne hjelper henne.","zh":"埃玛有家庭作业，玛丽安娜帮她做。","words":[[0,4,57.134,57.479,"emma"],[5,8,57.574,57.759,"har"],[9,15,57.794,58.239,"lekser"],[17,19,58.854,58.996,"og"],[20,28,58.996,59.559,"marianne"],[29,36,59.574,59.947,"hjelper"],[37,42,59.947,60.179,"henne"]]},{"id":13,"start":61.514,"end":64.259,"text":"Etterpå leser Henrik et eventyr for barna.","zh":"之后，亨里克给孩子们读一个童话故事。","words":[[0,7,61.514,61.979,"etterpå"],[8,13,62.074,62.459,"leser"],[14,20,62.474,62.916,"henrik"],[21,23,62.916,63.079,"et"],[24,31,63.114,63.739,"eventyr"],[32,35,63.774,63.939,"for"],[36,41,63.954,64.259,"barna"]]}],"lexicon":{"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"avisen":{"lemma":"avis","pos":"名词","zh":"报纸","ref":null,"clip":null,"form":"单数定指"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"blomkål":{"lemma":"blomkål","zh":"菜花；花椰菜","pos":"名词","ref":"pa-vei-4-095","clip":null},"bok":{"lemma":"bok","zh":"书","pos":"名词","ref":"pa-vei-4-080","clip":null},"bordet":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","form":"单数定指","clip":null},"butikken":{"lemma":"butikk","zh":"商店","pos":"名词","ref":"6-086","form":"单数定指","clip":null},"d":{"lemma":"D","pos":"字母","zh":"字母 D","ref":null,"clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"dekker":{"lemma":"dekke","pos":"动词","zh":"摆放餐具（dekke bordet）","ref":null,"clip":null,"form":"现在时"},"drar":{"lemma":"dra","zh":"离开；去（dra 的现在时）","pos":"动词","ref":"pa-vei-4-092","form":"现在时","clip":null},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词",