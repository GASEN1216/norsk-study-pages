{"id":"pa-vei-1.D","bookId":"pa-vei-textbook","readingId":"1.D","title":"På norskkurs","audio":"audio/pa-vei/1.D.mp3","duration":110.840021,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.74,"end":4.685,"text":"D. På norskkurs","zh":"D. 在挪威语课上","words":[[0,1,2.74,3.14,"d"],[3,5,3.72,3.865,"på"],[6,15,3.96,4.685,"norskkurs"]]},{"id":1,"start":7.1,"end":9.605,"text":"Hvilke språk snakker du, Safer?","zh":"萨费尔，你会说哪些语言？","words":[[0,6,7.1,7.525,"hvilke"],[7,12,7.6,8.205,"språk"],[13,20,8.38,8.765,"snakker"],[21,23,8.8,8.945,"du"],[25,30,9.16,9.605,"safer"]],"speaker":"Anne"},{"id":2,"start":10.58,"end":13.165,"text":"Jeg snakker somali og italiensk.","zh":"我会说索马里语和意大利语。","words":[[0,3,10.58,10.785,"jeg"],[4,11,10.82,11.265,"snakker"],[12,18,11.36,11.945,"somali"],[19,21,12.32,12.465,"og"],[22,31,12.5,13.165,"italiensk"]],"speaker":"Safer"},{"id":3,"start":14.59,"end":15.835,"text":"Og du, Haifa?","zh":"海法，你呢？","words":[[0,2,14.59,14.715,"og"],[3,5,14.81,14.975,"du"],[7,12,15.41,15.835,"haifa"]],"speaker":"Anne"},{"id":4,"start":16.93,"end":21.155,"text":"Jeg snakker arabik... Unnskyld, hva heter det på norsk?","zh":"我会说阿拉比克……不好意思，这个用挪威语怎么说？","words":[[0,3,16.93,17.135,"jeg"],[4,11,17.15,17.572,"snakker"],[12,18,17.572,18.235,"arabik"],[22,30,19.17,19.595,"unnskyld"],[32,35,19.97,20.155,"hva"],[36,41,20.17,20.492,"heter"],[42,45,20.492,20.635,"det"],[46,48,20.67,20.792,"på"],[49,54,20.792,21.155,"norsk"]],"speaker":"Haifa"},{"id":5,"start":21.85,"end":22.975,"text":"Arabisk.","zh":"阿拉伯语。","words":[[0,7,21.85,22.975,"arabisk"]],"speaker":"Anne"},{"id":6,"start":23.91,"end":26.435,"text":"Jeg snakker arabisk og engelsk.","zh":"我会说阿拉伯语和英语。","words":[[0,3,23.91,24.115,"jeg"],[4,11,24.13,24.595,"snakker"],[12,19,24.67,25.435,"arabisk"],[20,22,25.69,25.835,"og"],[23,30,25.89,26.435,"engelsk"]],"speaker":"Haifa"},{"id":7,"start":27.77,"end":29.515,"text":"Snakker du engelsk, Pablo?","zh":"巴勃罗，你会说英语吗？","words":[[0,7,27.77,28.155,"snakker"],[8,10,28.19,28.355,"du"],[11,18,28.57,29.095,"engelsk"],[20,25,29.11,29.515,"pablo"]],"speaker":"Anne"},{"id":8,"start":30.73,"end":33.175,"text":"Nei, jeg snakker ikke engelsk.","zh":"不，我不会说英语。","words":[[0,3,30.73,30.935,"nei"],[5,8,31.65,31.835,"jeg"],[9,16,31.89,32.255,"snakker"],[17,21,32.31,32.635,"ikke"],[22,29,32.67,33.175,"engelsk"]],"speaker":"Pablo"},{"id":9,"start":33.73,"end":35.215,"text":"Jeg snakker bare spansk.","zh":"我只会说西班牙语。","words":[[0,3,33.73,33.915,"jeg"],[4,11,33.97,34.355,"snakker"],[12,16,34.41,34.755,"bare"],[17,23,34.77,35.215,"spansk"]],"speaker":"Pablo"},{"id":10,"start":36.55,"end":38.415,"text":"Jeg forstår også litt spansk.","zh":"我也能听懂一点西班牙语。","words":[[0,3,36.55,36.735,"jeg"],[4,11,36.77,37.195,"forstår"],[12,16,37.23,37.535,"også"],[17,21,37.57,37.815,"litt"],[22,28,37.83,38.415,"spansk"]],"speaker":"Gloria"},{"id":11,"start":39.41,"end":44.035,"text":"Jeg kommer fra Filippinene og snakker filippinsk og engelsk.","zh":"我来自菲律宾，会说菲律宾语和英语。","words":[[0,3,39.41,39.615,"jeg"],[4,10,39.65,39.935,"kommer"],[11,14,39.97,40.135,"fra"],[15,26,40.17,40.955,"filippinene"],[27,29,41.35,41.472,"og"],[30,37,41.472,41.915,"snakker"],[38,48,42.03,42.855,"filippinsk"],[49,51,43.25,43.395,"og"],[52,59,43.43,44.035,"engelsk"]],"speaker":"Gloria"},{"id":12,"start":45.49,"end":46.415,"text":"Og du, Irina?","zh":"伊琳娜，你呢？","words":[[0,2,45.49,45.615,"og"],[3,5,45.67,45.815,"du"],[7,12,45.97,46.415,"irina"]],"speaker":"Anne"},{"id":13,"start":47.65,"end":51.115,"text":"Jeg kommer fra Latvia og snakker latvisk og tysk.","zh":"我来自拉脱维亚，会说拉脱维亚语和德语。","words":[[0,3,47.65,47.835,"jeg"],[4,10,47.85,48.112,"kommer"],[11,14,48.112,48.275,"fra"],[15,21,48.29,48.795,"latvia"],[22,24,49.29,49.415,"og"],[25,32,49.47,49.835,"snakker"],[33,40,49.85,50.435,"latvisk"],[41,43,50.57,50.695,"og"],[44,48,50.73,51.115,"tysk"]],"speaker":"Irina"},{"id":14,"start":52.13,"end":53.855,"text":"Jeg forstår litt russisk også.","zh":"我也能听懂一点俄语。","words":[[0,3,52.13,52.293,"jeg"],[4,11,52.293,52.635,"forstår"],[12,16,52.77,53.055,"litt"],[17,24,53.09,53.593,"russisk"],[25,29,53.593,53.855,"også"]],"speaker":"Irina"},{"id":15,"start":55.25,"end":57.355,"text":"Forstår du også russisk, Monica?","zh":"莫妮卡，你也能听懂俄语吗？","words":[[0,7,55.25,55.655,"forstår"],[8,10,55.71,55.855,"du"],[11,15,56.05,56.335,"også"],[16,23,56.35,56.895,"russisk"],[25,31,56.97,57.355,"monica"]],"speaker":"Anne"},{"id":16,"start":58.55,"end":62.955,"text":"Nei, men jeg snakker polsk og litt tysk.","zh":"不能，不过我会说波兰语和一点德语。","words":[[0,3,58.55,58.815,"nei"],[5,8,59.89,60.043,"men"],[9,12,60.043,60.195,"jeg"],[13,20,60.21,60.615,"snakker"],[21,26,60.67,61.255,"polsk"],[27,29,61.79,61.915,"og"],[30,34,61.93,62.295,"litt"],[35,39,62.53,62.955,"tysk"]],"speaker":"Monica"},{"id":17,"start":64.33,"end":66.355,"text":"Og så snakker dere norsk!","zh":"而且你们还会说挪威语！","words":[[0,2,64.33,64.475,"og"],[3,5,64.57,64.755,"så"],[6,13,65.01,65.433,"snakker"],[14,18,65.433,65.695,"dere"],[19,24,65.83,66.355,"norsk"]],"speaker":"Anne"},{"id":18,"start":67.13,"end":69.035,"text":"Ja, men ikke mye.","zh":"是的，不过会得不多。","words":[[0,2,67.13,67.295,"ja"],[4,7,67.93,68.115,"men"],[8,12,68.29,68.635,"ikke"],[13,16,68.71,69.035,"mye"]],"speaker":"Irina"},{"id":19,"start":74.03,"end":74.755,"text":"Sammendrag.","zh":"内容概要。","words":[[0,10,74.03,74.755,"sammendrag"]]},{"id":20,"start":77.14,"end":79.185,"text":"Safer går på norskkurs.","zh":"萨费尔在上挪威语课程。","words":[[0,5,77.14,77.745,"safer"],[6,9,77.86,78.125,"går"],[10,12,78.18,78.325,"på"],[13,22,78.42,79.185,"norskkurs"]]},{"id":21,"start":81.08,"end":84.465,"text":"Gloria og Irina er også på norskkurs.","zh":"格洛丽娅和伊琳娜也在上挪威语课程。","words":[[0,6,81.08,81.705,"gloria"],[7,9,81.84,81.985,"og"],[10,15,82.06,82.585,"irina"],[16,18,82.92,83.145,"er"],[19,23,83.28,83.645,"også"],[24,26,83.68,83.825,"på"],[27,36,83.84,84.465,"norskkurs"]]},{"id":22,"start":86.14,"end":87.625,"text":"De snakker med Anne.","zh":"他们在和安妮说话。","words":[[0,2,86.14,86.285,"de"],[3,10,86.52,86.985,"snakker"],[11,14,87.0,87.185,"med"],[15,19,87.28,87.625,"anne"]]},{"id":23,"start":89.13,"end":90.235,"text":"Hun er lærer.","zh":"她是一名老师。","words":[[0,3,89.13,89.335,"hun"],[4,6,89.49,89.675,"er"],[7,12,89.73,90.235,"lærer"]]},{"id":24,"start":92.79,"end":98.595,"text":"Gloria er fra Filippinene og snakker filippinsk og engelsk.","zh":"格洛丽娅来自菲律宾，会说菲律宾语和英语。","words":[[0,6,92.79,93.375,"gloria"],[7,9,93.45,93.635,"er"],[10,13,93.69,93.875,"fra"],[14,25,93.91,94.755,"filippinene"],[26,28,95.47,95.615,"og"],[29,36,95.71,96.155,"snakker"],[37,47,96.21,97.215,"filippinsk"],[48,50,97.65,97.775,"og"],[51,58,97.91,98.595,"engelsk"]]},{"id":25,"start":100.45,"end":105.275,"text":"Irina kommer fra Latvia og snakker latvisk og tysk.","zh":"伊琳娜来自拉脱维亚，会说拉脱维亚语和德语。","words":[[0,5,100.45,100.995,"irina"],[6,12,101.09,101.435,"kommer"],[13,16,101.45,101.635,"fra"],[17,23,101.69,102.215,"latvia"],[24,26,102.79,102.935,"og"],[27,34,103.03,103.475,"snakker"],[35,42,103.55,104.275,"latvisk"],[43,45,104.55,104.695,"og"],[46,50,104.81,105.275,"tysk"]]},{"id":26,"start":106.79,"end":108.915,"text":"De snakker også litt norsk.","zh":"他们也会说一点挪威语。","words":[[0,2,106.79,106.935,"de"],[3,10,107.03,107.435,"snakker"],[11,15,107.55,107.895,"også"],[16,20,108.03,108.375,"litt"],[21,26,108.49,108.915,"norsk"]]}],"lexicon":{"anne":{"lemma":"Anne","pos":"专名","zh":"安妮（人名）","ref":null,"clip":null},"arabik":{"lemma":"arabisk","pos":"名词","zh":"阿拉伯语（说话人尝试说出语言名称时的口语片段）","ref":null,"clip":null},"arabisk":{"lemma":"arabisk","pos":"名词","zh":"阿拉伯语","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"d":{"lemma":"D","pos":"字母","zh":"字母 D","ref":null,"clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"dere":{"lemma":"dere","zh":"你们","pos":"代词","ref":"ty-conversation-4-004","clip":null,"form":"主格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","r