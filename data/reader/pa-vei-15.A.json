{"id":"pa-vei-15.A","bookId":"pa-vei-textbook","readingId":"15.A","title":"Hva driver dere med?","audio":"audio/pa-vei/15.A.mp3","duration":102.528,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.86,"end":4.945,"text":"Monica har invitert noen av vennene sine fra norskkurset på besøk.","zh":"莫妮卡邀请了几位挪威语班的朋友来做客。","words":[[0,6,0.86,1.405,"monica"],[7,10,1.46,1.643,"har"],[11,19,1.643,2.232,"invitert"],[20,24,2.232,2.513,"noen"],[25,27,2.513,2.633,"av"],[28,35,2.633,3.025,"vennene"],[36,40,3.06,3.353,"sine"],[41,44,3.353,3.522,"fra"],[45,56,3.522,4.265,"norskkurset"],[57,59,4.32,4.443,"på"],[60,65,4.443,4.945,"besøk"]]},{"id":1,"start":6.58,"end":8.425,"text":"Det er så hyggelig å se dere igjen!","zh":"再次见到你们真高兴！","words":[[0,3,6.58,6.745,"det"],[4,6,6.76,6.965,"er"],[7,9,6.98,7.125,"så"],[10,18,7.2,7.643,"hyggelig"],[19,20,7.643,7.745,"å"],[21,23,7.78,7.945,"se"],[24,28,8.0,8.182,"dere"],[29,34,8.182,8.425,"igjen"]],"speaker":"Monica"},{"id":2,"start":9.3,"end":11.885,"text":"I like måte. Det er lenge siden sist.","zh":"我们也一样。好久不见了。","words":[[0,1,9.3,9.405,"i"],[2,6,9.44,9.822,"like@pa-vei-like-same"],[7,11,9.822,10.145,"måte"],[13,16,10.78,10.922,"det"],[17,19,10.922,11.033,"er"],[20,25,11.033,11.303,"lenge"],[26,31,11.303,11.543,"siden"],[32,36,11.543,11.885,"sist"]],"speaker":"Safer"},{"id":3,"start":12.704,"end":13.909,"text":"Hva gjør du nå, Monica?","zh":"莫妮卡，你现在在做什么？","words":[[0,3,12.704,12.857,"hva"],[4,8,12.857,13.046,"gjør"],[9,11,13.046,13.189,"du"],[12,14,13.264,13.409,"nå"],[16,22,13.524,13.909,"monica"]],"speaker":"Haifa"},{"id":4,"start":15.004,"end":17.029,"text":"Jeg jobber heltid på et hotell.","zh":"我在一家酒店做全职工作。","words":[[0,3,15.004,15.186,"jeg"],[4,10,15.186,15.549,"jobber"],[11,17,15.604,16.229,"heltid"],[18,20,16.324,16.456,"på"],[21,23,16.456,16.596,"et"],[24,30,16.596,17.029,"hotell"]],"speaker":"Monica"},{"id":5,"start":18.044,"end":22.289,"text":"Og dere da, hva driver dere med? Har du fått jobb, Pablo?","zh":"你们呢，现在在做什么？巴勃罗，你找到工作了吗？","words":[[0,2,18.044,18.169,"og"],[3,7,18.184,18.486,"dere"],[8,10,18.486,18.629,"da"],[12,15,19.244,19.407,"hva"],[16,22,19.407,19.706,"driver@pa-vei-extra-59"],[23,27,19.706,19.947,"dere"],[28,31,19.947,20.109,"med"],[33,36,21.044,21.216,"har"],[37,39,21.216,21.327,"du"],[40,44,21.327,21.556,"fått@pa-vei-extra-60"],[45,49,21.556,21.849,"jobb"],[51,56,21.944,22.289,"pablo"]],"speaker":"Monica"},{"id":6,"start":23.624,"end":25.709,"text":"Nei, men jeg har søkt mange slags jobber.","zh":"还没有，不过我申请过很多种工作。","words":[[0,3,23.624,23.849,"nei"],[5,8,24.124,24.256,"men"],[9,12,24.256,24.337,"jeg"],[13,16,24.337,24.466,"har"],[17,21,24.466,24.849,"søkt"],[22,27,24.864,25.166,"mange"],[28,33,25.166,25.407,"slags"],[34,40,25.407,25.709,"jobber"]],"speaker":"Pablo"},{"id":7,"start":26.344,"end":27.709,"text":"Jeg har lyst til å bli journalist.","zh":"我想当记者。","words":[[0,3,26.344,26.467,"jeg"],[4,7,26.467,26.566,"har"],[8,12,26.566,26.746,"lyst@pa-vei-lyst-desire"],[13,16,26.746,26.857,"til"],[17,18,26.857,26.916,"å"],[19,22,26.916,27.049,"bli"],[23,33,27.104,27.709,"journalist"]],"speaker":"Pablo"},{"id":8,"start":28.424,"end":30.289,"text":"Har du erfaring fra slikt arbeid?","zh":"你有这方面的工作经验吗？","words":[[0,3,28.424,28.616,"har"],[4,6,28.616,28.729,"du"],[7,15,28.744,29.309,"erfaring"],[16,19,29.324,29.509,"fra"],[20,25,29.624,29.936,"slikt"],[26,32,29.936,30.289,"arbeid"]],"speaker":"Haifa"},{"id":9,"start":31.064,"end":34.749,"text":"Ja, jeg skriver litt om Skandinavia i et argentinsk blad.","zh":"有，我为一家阿根廷杂志写一些关于斯堪的纳维亚的文章。","words":[[0,2,31.064,31.209,"ja"],[4,7,31.564,31.727,"jeg"],[8,15,31.727,32.136,"skriver"],[16,20,32.136,32.367,"litt"],[21,23,32.367,32.509,"om"],[24,35,32.564,33.289,"skandinavia"],[36,37,33.404,33.509,"i"],[38,40,33.524,33.666,"et"],[41,51,33.666,34.427,"argentinsk"],[52,56,34.427,34.749,"blad"]],"speaker":"Pablo"},{"id":10,"start":36.424,"end":41.869,"text":"Jeg søker også jobber. Da jeg bodde i Somalia, jobbet jeg med regnskap i et firma.","zh":"我也在找工作。住在索马里的时候，我在一家公司做会计工作。","words":[[0,3,36.424,36.609,"jeg"],[4,9,36.624,36.969,"søker"],[10,14,36.984,37.269,"også"],[15,21,37.284,37.589,"jobber"],[23,25,38.464,38.587,"da"],[26,29,38.587,38.746,"jeg"],[30,35,38.746,39.049,"bodde"],[36,37,39.064,39.169,"i"],[38,45,39.184,39.769,"somalia"],[47,53,40.224,40.507,"jobbet"],[54,57,40.507,40.617,"jeg"],[58,61,40.617,40.737,"med"],[62,70,40.737,41.369,"regnskap"],[71,72,41.384,41.477,"i"],[73,75,41.477,41.587,"et"],[76,81,41.587,41.869,"firma"]],"speaker":"Safer"},{"id":11,"start":43.304,"end":44.649,"text":"Hva holder du på med, Haifa?","zh":"海法，你在忙什么？","words":[[0,3,43.304,43.457,"hva"],[4,10,43.457,43.737,"holder@pa-vei-extra-58"],[11,13,43.737,43.869,"du"],[14,16,43.964,44.109,"på"],[17,20,44.124,44.287,"med"],[22,27,44.287,44.649,"haifa"]],"speaker":"Monica"},{"id":12,"start":45.804,"end":48.629,"text":"Jeg skal studere. Jeg har lyst til å bli politi.","zh":"我准备读书，我想当警察。","words":[[0,3,45.804,45.986,"jeg"],[4,8,45.986,46.209,"skal"],[9,16,46.304,46.769,"studere"],[18,21,47.384,47.526,"jeg"],[22,25,47.526,47.636,"har"],[26,30,47.636,47.846,"lyst@pa-vei-lyst-desire"],[31,34,47.846,47.986,"til"],[35,36,47.986,48.067,"å"],[37,40,48.067,48.209,"bli"],[41,47,48.284,48.629,"politi"]],"speaker":"Haifa"},{"id":13,"start":49.404,"end":50.989,"text":"Politi! Hvorfor det?","zh":"警察！为什么？","words":[[0,6,49.404,49.849,"politi"],[8,15,50.524,50.846,"hvorfor"],[16,19,50.846,50.989,"det"]],"speaker":"Pablo"},{"id":14,"start":51.664,"end":54.289,"text":"Det er en viktig jobb, og jeg liker utfordringer.","zh":"这是一份重要的工作，而且我喜欢挑战。","words":[[0,3,51.664,51.806,"det"],[4,6,51.806,51.907,"er"],[7,9,51.907,52.026,"en"],[10,16,52.026,52.377,"viktig"],[17,21,52.377,52.629,"jobb"],[23,25,53.044,53.147,"og"],[26,29,53.147,53.276,"jeg"],[30,35,53.276,53.629,"liker"],[36,48,53.644,54.289,"utfordringer"]],"speaker":"Haifa"},{"id":15,"start":54.944,"end":58.889,"text":"Men først må jeg ta førerkort. Jeg skal ta kjøretimer nå.","zh":"不过我得先考驾照。我现在要开始上驾驶课。","words":[[0,3,54.944,55.209,"men"],[4,9,55.464,55.757,"først"],[10,12,55.757,55.856,"må"],[13,16,55.856,55.986,"jeg"],[17,19,55.986,56.109,"ta"],[20,29,56.184,56.889,"førerkort"],[31,34,57.644,57.787,"jeg"],[35,39,57.787,57.966,"skal"],[40,42,57.966,58.129,"ta"],[43,53,58.244,58.776,"kjøretimer"],[54,56,58.776,58.889,"nå"]],"speaker":"Haifa"},{"id":16,"start":59.844,"end":61.629,"text":"Leser du teoridelen på norsk?","zh":"你用挪威语学习理论部分吗？","words":[[0,5,59.844,60.206,"leser"],[6,8,60.206,60.309,"du"],[9,19,60.384,61.147,"teoridelen"],[20,22,61.147,61.269,"på"],[23,28,61.284,61.629,"norsk"]],"speaker":"Safer"},{"id":17,"start":62.264,"end":65.869,"text":"Ja, og det er ganske vanskelig. Det er mange nye ord.","zh":"是的，相当难，有很多生词。","words":[[0,2,62.264,62.409,"ja"],[4,6,62.904,62.996,"og"],[7,10,62.996,63.106,"det"],[11,13,63.106,63.197,"er"],[14,20,63.197,63.576,"ganske"],[21,30,63.576,64.029,"vanskelig"],[32,35,64.624,64.776,"det"],[36,38,64.776,64.889,"er"],[39,44,64.904,65.329,"mange"],[45,48,65.344,65.629,"nye"],[49,52,65.644,65.869,"ord"]],"speaker":"Haifa"},{"id":18,"start":66.824,"end":74.069,"text":"Enig. Det er ikke lett. Jeg tok førerkort for en stund siden, og jeg måtte ta teoriprøven flere ganger.","zh":"同意，确实不容易。我前一阵子拿到驾照，理论考试考了好几次。","words":[[0,4,66.824,67.149,"enig"],[6,9,68.024,68.166,"det"],[10,12,68.166,68.267,"er"],[13,17,68.267,68.447,"ikke"],[18,22,68.447,68.709,"lett"],[24,27,69.784,69.936,"jeg"],[28,31,69.936,70.129,"tok"],[32,41,70.144,70.726,"førerkort"],[42,45,70.726,70.876,"for"],[46,48,70.876,70.977,"en"],[49,54,70.977,71.237,"stund"],[55,60,71.237,71.529,"siden"],[62,64,71.984,72.106,"og"],[65,68,72.106,72.227,"jeg"],[69,74,72.227,72.457,"måtte"],[75,77,72.457,72.589,"ta"],[78,89,72.624,73.349,"teoriprøven"],[90,95,73.424,73.767,"flere"],[96,102,73.767,74.069,"ganger"]],"speaker":"Safer"},{"id":19,"start":75.124,"end":79.109,"text":"Har du sjekket på nettet? Der finnes det tester som du kan ta for å øve deg.","zh":"你在网上查过吗？网上有可以练习的测试。","words":[[0,3,75.124,75.246,"har"],[4,6,75.246,75.367,"du"],[7,14,75.367,75.716,"sjekket@pa-vei-extra-57"],[15,17,75.716,75.816,"på"],[18,24,75.816,76.129,"nettet"],[26,29,76.804,77.017,"der"],[30,36,77.017,77.216,"finnes"],[37,40,77.216,77.329,"det"],[41,47,77.344,77.737,"tester"],[48,51,77.737,77.876,"som"],[52,54,77.876,77.977,"du"],[55,58,77.977,78.126,"kan"],[59,61,78.126,78.269,"ta"],[62,65,78.384,78.526,"for"],[66,67,78.526,78.629,"å"],[68,71,78.684,78.957,"øve"],[72,75,78.957,79.109,"deg"]],"speaker":"Pablo"},{"id":20,"start":79.924,"end":82.009,"text":"Det visste jeg ikke. Takk for tipset!","zh":"我还不知道。谢谢提醒！","words":[[0,3,79.924,80.109,"det"],[4,10,80.124,80.386,"visste"],[11,14,80.386,80.487,"jeg"],[15,19,80.487,80.709,"ikke"],[21,25,81.304,81.517,"takk"],[26,29,81.517,81.636,"for"],[30,36,81.636,82.009,"tipset"]],"speaker":"Haifa"},{"id":21,"start":83.364,"end":87.269,"text":"Jeg skal hilse fra Anne, læreren vår. Jeg møtte henne i byen i går.","zh":"我们的老师安妮让我向你们问好。我昨天在城里遇见她了。","words":[[0,3,83.364,83.487,"jeg"],[4,8,83.487,83.636,"skal"],[9,14,83.636,83.916,"hilse"],[15,18,83.916,84.069,"fra"],[19,23,84.084,84.349,"anne"],[25,32,84.644,85.007,"læreren"],[33,36,85.007,85.169,"vår"],[38,41,86.024,86.156,"jeg"],[42,47,86.156,86.397,"møtte"],[48,53,86.397,86.629,"henne"],[54,55,86.644,86.746,"i"],[56,60,86.746,87.026,"byen"],[61,62,87.026,87.096,"i"],[63,66,87.096,87.269,"går"]],"speaker":"Safer"},{"id":22,"start":88.484,"end":91.429,"text":"Så hyggelig. Det var fint på norskkurset.","zh":"真好。上挪威语课的时候很开心。","words":[[0,2,88.484,88.629,"så"],[3,11,88.684,89.129,"hyggelig"],[13,16,89.884,90.017,"det"],[17,20,90.017,90.169,"var"],[21,25,90.244,90.609,"fint"],[26,28,90.624,90.749,"på"],[29,40,90.764,91.429,"norskkurset"]],"speaker":"Monica"},{"id":23,"start":92.464,"end":97.049,"text":"Ja, jeg savner skolen av og til. Men nå gleder jeg meg til å komme i jobb.","zh":"是啊，我有时会想念学校。不过我现在很期待开始工作。","words":[[0,2,92.464,92.629,"ja"],[4,7,93.244,93.4