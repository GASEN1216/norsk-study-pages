{"id":"pa-vei-11.B","bookId":"pa-vei-textbook","readingId":"11.B","title":"En ny time hos legen","audio":"audio/pa-vei/11.B.mp3","duration":141.864,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.98,"end":2.485,"text":"Legesenteret, vær så god!","zh":"这里是医疗中心，您好！","words":[[0,12,0.98,1.845,"legesenteret"],[14,17,2.04,2.183,"vær@pa-vei-vær-be"],[18,20,2.183,2.292,"så"],[21,24,2.292,2.485,"god"]],"speaker":"Legesekretær"},{"id":1,"start":3.6,"end":6.885,"text":"Hei. Jeg vil gjerne bestille en time hos legen.","zh":"你好。我想预约看医生。","words":[[0,3,3.6,3.825,"hei"],[5,8,4.72,4.862,"jeg"],[9,12,4.862,4.982,"vil"],[13,19,4.982,5.213,"gjerne"],[20,28,5.213,5.672,"bestille"],[29,31,5.672,5.805,"en"],[32,36,5.82,6.242,"time"],[37,40,6.242,6.463,"hos"],[41,46,6.463,6.885,"legen"]],"speaker":"Terje"},{"id":2,"start":8.14,"end":9.525,"text":"Hvem er fastlegen din?","zh":"你的固定家庭医生是谁？","words":[[0,4,8.14,8.385,"hvem"],[5,7,8.4,8.565,"er"],[8,17,8.6,9.312,"fastlegen"],[18,21,9.312,9.525,"din"]],"speaker":"Legesekretær"},{"id":3,"start":10.66,"end":11.265,"text":"Løten.","zh":"勒滕。","words":[[0,5,10.66,11.265,"løten"]],"speaker":"Terje"},{"id":4,"start":12.588,"end":14.153,"text":"Hva er fødselsdatoen?","zh":"你的出生日期是什么时候？","words":[[0,3,12.588,12.753,"hva"],[4,6,12.868,13.073,"er"],[7,20,13.148,14.153,"fødselsdatoen"]],"speaker":"Legesekretær"},{"id":5,"start":15.428,"end":18.053,"text":"14.03.1984.","zh":"1984 年 3 月 14 日。","words":[[0,10,15.428,18.053,"14.03.1984"]],"speaker":"Terje"},{"id":6,"start":19.168,"end":20.013,"text":"Og hva gjelder det?","zh":"你有什么问题？","words":[[0,2,19.168,19.313,"og"],[3,6,19.368,19.533,"hva"],[7,14,19.568,19.87,"gjelder"],[15,18,19.87,20.013,"det"]],"speaker":"Legesekretær"},{"id":7,"start":21.088,"end":26.693,"text":"Jeg føler meg dårlig. Jeg er trøtt og kvalm og klarer ikke å konsentrere meg.","zh":"我觉得不舒服。我很疲倦、恶心，无法集中注意力。","words":[[0,3,21.088,21.253,"jeg"],[4,9,21.288,21.59,"føler"],[10,13,21.59,21.753,"meg"],[14,20,21.808,22.253,"dårlig"],[22,25,23.028,23.18,"jeg"],[26,28,23.18,23.31,"er"],[29,34,23.31,23.7,"trøtt"],[35,37,23.7,23.831,"og"],[38,43,23.831,24.193,"kvalm"],[44,46,24.668,24.813,"og"],[47,53,24.828,25.333,"klarer"],[54,58,25.348,25.653,"ikke"],[59,60,25.688,25.793,"å"],[61,72,25.828,26.52,"konsentrere"],[73,76,26.52,26.693,"meg"]],"speaker":"Terje"},{"id":8,"start":28.388,"end":35.373,"text":"Legen er dessverre veldig opptatt, men du kan få en time klokka halv tolv, fredag den 13.","zh":"很抱歉，医生非常忙。不过可以给你安排在 13 日星期五十一点半。","words":[[0,5,28.388,28.773,"legen"],[6,8,28.788,28.921,"er"],[9,18,28.921,29.511,"dessverre"],[19,25,29.511,29.791,"veldig"],[26,33,29.791,30.273,"opptatt"],[35,38,30.728,30.891,"men"],[39,41,30.891,31.02,"du"],[42,45,31.02,31.193,"kan"],[46,48,31.288,31.433,"få"],[49,51,31.608,31.753,"en"],[52,56,31.828,32.233,"time"],[57,63,32.248,32.593,"klokka"],[64,68,32.808,33.173,"halv"],[69,73,33.268,33.653,"tolv"],[75,81,34.028,34.621,"fredag"],[82,85,34.621,34.773,"den@pa-vei-den-definite"],[86,88,34.808,35.373,"13"]],"speaker":"Legesekretær"},{"id":9,"start":36.548,"end":37.273,"text":"Ikke før?","zh":"不能早点吗？","words":[[0,4,36.548,36.853,"ikke"],[5,8,36.948,37.273,"før"]],"speaker":"Terje"},{"id":10,"start":38.328,"end":40.533,"text":"Dessverre, det er umulig.","zh":"抱歉，没办法。","words":[[0,9,38.328,38.893,"dessverre"],[11,14,39.588,39.773,"det"],[15,17,39.888,40.073,"er"],[18,24,40.128,40.533,"umulig"]],"speaker":"Legesekretær"},{"id":11,"start":43.148,"end":44.253,"text":"Fredag 13.:","zh":"13 日，星期五：","words":[[0,6,43.148,43.653,"fredag"],[7,9,43.708,44.253,"13"]]},{"id":12,"start":45.888,"end":48.253,"text":"Nå, føler du deg fremdeles dårlig?","zh":"那么，你还是觉得不舒服吗？","words":[[0,2,45.888,46.013,"nå"],[4,9,46.688,47.001,"føler"],[10,12,47.001,47.111,"du"],[13,16,47.111,47.273,"deg"],[17,26,47.288,47.96,"fremdeles"],[27,33,47.96,48.253,"dårlig"]],"speaker":"Doktor Løten"},{"id":13,"start":49.208,"end":53.613,"text":"Ja, jeg trenger medisin. Jeg blir ikke frisk.","zh":"是的，我需要吃药。我一直好不了。","words":[[0,2,49.208,49.373,"ja"],[4,7,50.408,50.57,"jeg"],[8,15,50.57,50.99,"trenger"],[16,23,50.99,51.693,"medisin"],[25,28,52.448,52.613,"jeg"],[29,33,52.628,52.9,"blir"],[34,38,52.9,53.153,"ikke"],[39,44,53.188,53.613,"frisk"]],"speaker":"Terje"},{"id":14,"start":54.648,"end":58.773,"text":"Du trenger ikke medisin, men du er i dårlig form. Trener du?","zh":"你不需要吃药，不过你的身体状态不好。你锻炼吗？","words":[[0,2,54.648,54.773,"du"],[3,10,54.828,55.18,"trenger"],[11,15,55.18,55.38,"ikke"],[16,23,55.38,55.953,"medisin"],[25,28,56.248,56.4,"men"],[29,31,56.4,56.501,"du"],[32,34,56.501,56.63,"er"],[35,36,56.63,56.733,"i"],[37,43,56.748,57.073,"dårlig"],[44,48,57.108,57.413,"form"],[50,56,58.268,58.66,"trener"],[57,59,58.66,58.773,"du"]],"speaker":"Doktor Løten"},{"id":15,"start":60.208,"end":63.953,"text":"Før jogget jeg litt, men nå føler jeg meg så slapp.","zh":"以前我偶尔慢跑，不过现在我觉得很没精神。","words":[[0,3,60.208,60.493,"før"],[4,10,60.548,60.96,"jogget"],[11,14,60.96,61.1,"jeg"],[15,19,61.1,61.353,"litt"],[21,24,62.288,62.421,"men"],[25,27,62.421,62.553,"nå"],[28,33,62.628,62.99,"føler"],[34,37,62.99,63.13,"jeg"],[38,41,63.13,63.273,"meg"],[42,44,63.308,63.453,"så"],[45,50,63.528,63.953,"slapp"]],"speaker":"Terje"},{"id":16,"start":64.968,"end":67.053,"text":"Jeg har tenkt å begynne på treningsstudio.","zh":"我打算开始去健身房。","words":[[0,3,64.968,65.111,"jeg"],[4,7,65.111,65.24,"har"],[8,13,65.24,65.541,"tenkt"],[14,15,65.541,65.63,"å"],[16,23,65.63,65.941,"begynne"],[24,26,65.941,66.073,"på"],[27,41,66.108,67.053,"treningsstudio"]],"speaker":"Terje"},{"id":17,"start":68.288,"end":71.513,"text":"En god idé. Hvordan er det med kostholdet?","zh":"好主意。你的饮食怎么样？","words":[[0,2,68.288,68.453,"en"],[3,6,68.528,68.813,"god"],[7,10,68.868,69.093,"idé"],[12,19,70.048,70.393,"hvordan"],[20,22,70.408,70.541,"er"],[23,26,70.541,70.671,"det"],[27,30,70.671,70.793,"med"],[31,41,70.808,71.513,"kostholdet"]],"speaker":"Doktor Løten"},{"id":18,"start":72.208,"end":73.193,"text":"Spiser du sunt?","zh":"你吃得健康吗？","words":[[0,6,72.208,72.701,"spiser"],[7,9,72.701,72.813,"du"],[10,14,72.828,73.193,"sunt"]],"speaker":"Doktor Løten"},{"id":19,"start":74.408,"end":82.473,"text":"Sunt? Tja, jeg vet ikke. Jeg er glad i alt som er søtt, men jeg spiser da salat også.","zh":"健康吗？嗯，我不知道。我喜欢一切甜食，不过我也吃沙拉啊。","words":[[0,4,74.408,74.833,"sunt"],[6,9,75.948,76.153,"tja"],[11,14,76.828,76.99,"jeg"],[15,18,76.99,77.231,"vet"],[19,23,77.231,77.453,"ikke"],[25,28,78.368,78.541,"jeg"],[29,31,78.541,78.65,"er"],[32,36,78.65,78.88,"glad"],[37,38,78.88,78.96,"i"],[39,42,78.96,79.201,"alt"],[43,46,79.201,79.353,"som"],[47,49,79.368,79.49,"er"],[50,54,79.49,79.833,"søtt"],[56,59,80.588,80.75,"men"],[60,63,80.75,80.913,"jeg"],[64,70,80.948,81.4,"spiser"],[71,73,81.4,81.533,"da"],[74,79,81.708,82.21,"salat"],[80,84,82.21,82.473,"også"]],"speaker":"Terje"},{"id":20,"start":83.798,"end":89.163,"text":"Kutt ut cola, sjokolade og kaker. Du vil merke stor forskjell.","zh":"戒掉可乐、巧克力和蛋糕。你会发现很大的变化。","words":[[0,4,83.798,84.141,"kutt"],[5,7,84.141,84.361,"ut"],[8,12,84.361,84.723,"cola"],[14,23,85.018,85.663,"sjokolade"],[24,26,86.038,86.171,"og"],[27,32,86.171,86.623,"kaker"],[34,36,87.398,87.541,"du"],[37,40,87.541,87.68,"vil"],[41,46,87.68,88.023,"merke"],[47,51,88.218,88.643,"stor"],[52,61,88.738,89.163,"forskjell"]],"speaker":"Doktor Løten"},{"id":21,"start":90.418,"end":91.923,"text":"Skal jeg leve på salat?","zh":"难道我只能靠沙拉过日子？","words":[[0,4,90.418,90.62,"skal"],[5,8,90.62,90.78,"jeg"],[9,13,90.78,91.123,"leve"],[14,16,91.158,91.283,"på"],[17,22,91.398,91.923,"salat"]],"speaker":"Terje"},{"id":22,"start":93.008,"end":101.653,"text":"Nei da, men spis mer grønnsaker, frukt, grovt brød, fisk og egg. Og begynn å trene.","zh":"当然不是，不过要多吃蔬菜、水果、全麦面包、鱼和鸡蛋，还要开始锻炼。","words":[[0,3,93.008,93.253,"nei"],[4,6,93.368,93.513,"da"],[8,11,94.108,94.253,"men"],[12,16,94.308,94.673,"spis"],[17,20,94.708,94.993,"mer"],[21,31,95.088,95.733,"grønnsaker"],[33,38,96.188,96.633,"frukt"],[40,45,97.168,97.613,"grovt"],[46,50,97.628,97.913,"brød"],[52,56,98.608,99.073,"fisk"],[57,59,99.348,99.473,"og"],[60,63,99.508,99.753,"egg"],[65,67,100.528,100.65,"og"],[68,74,100.65,101.013,"begynn"],[75,76,101.068,101.173,"å"],[77,82,101.188,101.653,"trene"]],"speaker":"Doktor Løten"},{"id":23,"start":102.908,"end":106.913,"text":"Så kjedelig! Det er akkurat som å høre mora mi.","zh":"真没意思！简直就像在听我妈妈说话。","words":[[0,2,102.908,103.073,"så"],[3,11,103.208,103.813,"kjedelig"],[13,16,104.848,105.001,"det"],[17,19,105.001,105.133,"er"],[20,27,105.208,105.831,"akkurat"],[28,31,105.831,105.971,"som@pa-vei-som-like"],[32,33,105.971,106.06,"å"],[34,38,106.06,106.353,"høre"],[39,43,106.408,106.77,"mora"],[44,46,106.77,106.913,"mi"]],"speaker":"Terje"},{"id":24,"start":108.208,"end":110.333,"text":"Mora di? Hvordan har hun det?","zh":"你妈妈？她身体怎么样？","words":[[0,4,108.208,108.55,"mora"],[5,7,108.55,108.693,"di"],[9,16,109.448,109.77,"hvordan"],[17,20,109.77,109.951,"har"],[21,24,109.951,110.153,"hun"],[25,28,110.168,110.333,"det"]],"speaker":"Doktor Løten"},{"id":25,"start":111.648,"end":113.113,"text":"Hun er frisk som en fisk.","zh":"她健康得很。","words":[[0,3,111.648,111.813,"hun"],[4,6,111.868,112.053,"er"],[7,12,112.068,112.451,"frisk"],[13,16,112.451,112.613,"som@pa-vei-som-like"],[17,19,112.628,112.75,"en"],[20,24,112.75,113.113,"fisk"]],"speaker":"Terje"},{"id":26,"start":114.408,"end":116.533,"text":"Jeg synes du skal høre på mora di.","zh":"我觉得你应该听你妈妈的话。","words":[[0,3,114.408,114.653,"jeg"],[4,9,114.788,115.25,"synes"],[10,12,115.25,115.37,"du"],[13,17,115.37,115.593,"skal"],[18,22,115.628,115.91,"høre"],[23,25,115.91,116.053,"på"],[26,30,116.088,116.41,"mora"],[31,33,116.41,116.533,"di"]],"speaker":"Doktor Løten"},{"id":27,"start":122.728,"end":123.973,"text":"Hva er faren din, Jens?","zh":"延斯，你爸爸是做什么的？","words":[[0,3,122.728,122.913,"hva"],[4,6,122.988,123.131,"er"],[7,12,123.131,123.46,"faren"],[13,16,123.46,123.641,"din"],[18,22,123.641,123.973,"jens"]]},{"id":28,"start":124.608,"end":125.273,"text":"Han er syk.","zh":"他生病了。","words":[[0,3,124.608,124.781,"han"],[4,6,124.781,124.913,"er"],[7,10,124.928,125.273,"syk"]]},{"id":29,"start":126.088,"end":127.473,"text":"Jeg mener: Hva gjør han?","zh":"我的意思是：他做什么？","words":[[0,3,126.088,126.261,"jeg"],[4,9,126.261,126.573,"mener"],[11,14,126.708,126.873,"hva"],[15,19,126.968,127.27,"gjør"],[20,23,127.27,127.473,"han"]]},{"id":30,"start":128.128,"end":128.713,"text":"Han hoster.","zh":"他咳嗽。","words":[[0,3,128.128,128.291,"han"],[4,10,128.291,128.713,"hoster"]]},{"id":31,"start":129.468,"end":131.073,"text":"Men hva gjør han når han er frisk?","zh":"可是，他身体好的时候做什么？","words":[[0,3,129.468,129.63,"men"],[4,7,129.63,129.773,"hva"],[8,12,129.788,130.0,"gjør"],[13,16,130.0,130.141,"han"],[17,20,130.141,130.28,"når@pa-vei-når-when"],[21,24,130.28,130.421,"han"],[25,27,130.421,130.573,"er"],[28,33,130.628,131.073,"frisk"]]},{"id":32,"start":131.588,"end":132.713,"text":"Da hoster han ikke.","zh":"那时他不咳嗽。","words":[[0,2,131.588,131.733,"da"],[3,9,132.008,132.341,"hoster"],[10,13,132.341,132.46,"han"],[14,18,132.46,132.713,"ikke"]]},{"id":33,"start":133.04,"end":137.993,"text":"Å! Men forstår du ikke!? Jeg vil bare vite hva faren din er når han ikke er syk.","zh":"唉！你怎么不明白呢！？我只是想知道，你爸爸没生病时是什么样的。","words":[[0,1,133.04,133.56,"å"],[3,6,133.588,133.753,"men"],[7,14,133.768,134.201,"forstår"],[15,17,134.201,134.313,"du"],[18,22,134.328,134.573,"ikke"],[25,28,134.888,135.031,"jeg"],[29,32,135.031,135.171,"vil"],[33,37,135.171,135.413,"bare"],[38,42,135.448,135.8,"vite"],[43,46,135.8,135.953,"hva"],[47,52,136.048,136.39,"faren"],[53,56,136.39,136.593,"din"],[57,59,136.608,136.8,"er"],[60,63,136.8,136.953,"når@pa-vei-når-when"],[64,67,136.968,137.153,"han"],[68,72,137.188,137.481,"ikke"],[73,75,137.481,137.611,"er"],[76,79,137.611,137.993,"syk"]]},{"id":34,"start":138.648,"end":140.013,"text":"Da er han selvfølgelig frisk.","zh":"那他当然是健康的。","words":[[0,2,138.648,138.793,"da"],[3,5,138.808,138.96,"er"],[6,9,138.96,139.101,"han"],[1