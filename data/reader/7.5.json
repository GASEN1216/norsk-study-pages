{"id":"7.5","title":"Yrkestekst: Jeg er bussjåfør","audio":"audio/7.5.mp3","duration":79.11,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.83,"text":"7.5 Yrke: Jeg er bussjåfør","heading":true,"zh":"7.5 职业：我是公交车司机","words":[[0,3,0.15,1.29,"7.5"],[4,8,2.42,2.86,"yrke"],[10,13,4.24,4.54,"jeg"],[14,16,4.54,4.94,"er"],[17,26,4.94,5.75,"bussjåfør"]]},{"id":1,"start":8.62,"end":10.49,"text":"Jeg er bussjåfør.","zh":"我是公交车司机。","words":[[0,3,8.7,9.07,"jeg"],[4,6,9.07,9.47,"er"],[7,16,9.47,10.41,"bussjåfør"]]},{"id":2,"start":11.82,"end":16.09,"text":"Jeg jobber alene, men jeg møter mange passasjerer.","zh":"我一个人工作，但会遇到很多乘客。","words":[[0,3,11.9,12.12,"jeg"],[4,10,12.12,12.5,"jobber~003ddb6d77e6"],[11,16,12.5,13.06,"alene"],[18,21,13.8,13.94,"men"],[22,25,13.94,14.12,"jeg"],[26,31,14.12,14.66,"møter~0b9e8705aec3"],[32,37,14.66,14.98,"mange"],[38,49,14.98,16.02,"passasjerer"]]},{"id":3,"start":16.76,"end":17.87,"text":"Det er hyggelig.","zh":"这很愉快。","words":[[0,3,16.84,17.08,"det"],[4,6,17.08,17.26,"er"],[7,15,17.26,17.79,"hyggelig"]]},{"id":4,"start":18.82,"end":23.24,"text":"Jeg smiler, og jeg hilser alltid på passasjerene.","zh":"我面带微笑，总是跟乘客们打招呼。","words":[[0,3,18.9,19.19,"jeg"],[4,10,19.19,19.87,"smiler"],[12,14,20.37,20.51,"og"],[15,18,20.51,20.67,"jeg"],[19,25,20.67,21.27,"hilser"],[26,32,21.27,21.87,"alltid~867f85a8b647"],[33,35,21.87,22.31,"på~588ffe6c89d8"],[36,48,22.31,23.16,"passasjerene"]]},{"id":5,"start":24.39,"end":28.98,"text":"Mange har månedskort, men noen kjøper enkeltbillett.","zh":"很多人有月票，但也有人买单程票。","words":[[0,5,24.47,24.84,"mange"],[6,9,24.84,25.1,"har"],[10,20,25.1,25.8,"månedskort"],[22,25,26.5,26.64,"men"],[26,30,26.64,27.18,"noen~8e23a4fd3f2f"],[31,37,27.18,27.6,"kjøper"],[38,51,27.6,28.9,"enkeltbillett"]]},{"id":6,"start":30.11,"end":32.86,"text":"Du kan også kjøpe billett på mobilen.","zh":"你也可以用手机买票。","words":[[0,2,30.19,30.38,"du"],[3,6,30.38,30.56,"kan"],[7,11,30.56,31.02,"også"],[12,17,31.02,31.38,"kjøpe"],[18,25,31.38,31.86,"billett"],[26,28,31.86,32.12,"på"],[29,36,32.12,32.78,"mobilen"]]},{"id":7,"start":34.6,"end":36.31,"text":"På bussen","zh":"在公交车上","words":[[0,2,34.91,35.67,"på"],[3,9,35.67,36.23,"bussen"]]},{"id":8,"start":38.26,"end":40.34,"text":"Går denne bussen til sentrum?","speaker":"Passasjer","zh":"这辆车去市中心吗？","words":[[0,3,38.34,38.6,"går~f010b28fdfbc"],[4,9,38.6,39.0,"denne"],[10,16,39.0,39.34,"bussen"],[17,20,39.34,39.56,"til"],[21,28,39.56,40.26,"sentrum"]]},{"id":9,"start":41.4,"end":42.89,"text":"Ja, det stemmer.","speaker":"Bussjåfør","zh":"对，没错。","words":[[0,2,41.48,41.73,"ja"],[4,7,42.07,42.21,"det"],[8,15,42.21,42.81,"stemmer"]]},{"id":10,"start":44.15,"end":45.22,"text":"Når går den?","speaker":"Passasjer","zh":"什么时候开？","words":[[0,3,44.23,44.55,"når~a56a1c61425b"],[4,7,44.55,44.83,"går~acdc34f0eefd"],[8,11,44.83,45.14,"den"]]},{"id":11,"start":46.65,"end":48.4,"text":"Den går om fem minutter.","speaker":"Bussjåfør","zh":"五分钟后开。","words":[[0,3,46.73,47.0,"den"],[4,7,47.0,47.22,"går~acdc34f0eefd"],[8,10,47.22,47.42,"om~f6ebebe27cc0"],[11,14,47.42,47.7,"fem"],[15,23,47.7,48.32,"minutter"]]},{"id":12,"start":49.34,"end":51.06,"text":"Hvor lang tid tar det dit?","speaker":"Passasjer","zh":"到那儿要多长时间？","words":[[0,4,49.42,49.66,"hvor~8598699b9b8d"],[5,9,49.66,49.88,"lang"],[10,13,49.88,50.2,"tid"],[14,17,50.2,50.44,"tar~376c12518b59"],[18,21,50.44,50.54,"det"],[22,25,50.54,50.98,"dit"]]},{"id":13,"start":52.0,"end":53.96,"text":"Det tar tjue minutter.","speaker":"Bussjåfør","zh":"要二十分钟。","words":[[0,3,52.08,52.34,"det"],[4,7,52.34,52.68,"tar~376c12518b59"],[8,12,52.68,53.26,"tjue"],[13,21,53.26,53.88,"minutter"]]},{"id":14,"start":56.23,"end":57.43,"text":"I Trondheim","zh":"在特隆赫姆","words":[[0,1,56.31,56.58,"i"],[2,11,56.58,57.35,"trondheim"]]},{"id":15,"start":59.0,"end":61.84,"text":"Vi dro til Trondheim for første gang i helga.","zh":"周末我们第一次去了特隆赫姆。","words":[[0,2,59.08,59.28,"vi"],[3,6,59.28,59.42,"dro"],[7,10,59.42,59.58,"til"],[11,20,59.58,60.22,"trondheim"],[21,24,60.22,60.64,"for~bc28b61aa84c"],[25,31,60.64,61.02,"første"],[32,36,61.02,61.2,"gang"],[37,38,61.2,61.34,"i~16f1f6aa6ab5"],[39,44,61.34,61.76,"helga"]]},{"id":16,"start":62.84,"end":65.04,"text":"Trondheim er en veldig fin by.","zh":"特隆赫姆是一座非常美的城市。","words":[[0,9,62.92,63.5,"trondheim"],[10,12,63.5,63.7,"er"],[13,15,63.7,63.9,"en~a939a9e56dc5"],[16,22,63.9,64.28,"veldig"],[23,26,64.28,64.56,"fin"],[27,29,64.56,64.96,"by"]]},{"id":17,"start":65.04,"end":67.42,"text":"Hvordan reiste dere dit?","zh":"你们是怎么去的？","words":[[0,7,65.11,66.1,"hvordan"],[8,14,66.1,66.54,"reiste"],[15,19,66.54,66.8,"dere"],[20,23,66.8,67.34,"dit"]]},{"id":18,"start":68.1,"end":71.3,"text":"Vi reiste med toget, og det var kjempefint.","zh":"我们坐火车去的，一路上棒极了。","words":[[0,2,68.18,68.42,"vi"],[3,9,68.42,68.84,"reiste"],[10,13,68.84,69.02,"med~a7d4af26146c"],[14,19,69.02,69.6,"toget"],[21,23,69.8,69.88,"og"],[24,27,69.88,69.95,"det"],[28,31,69.95,70.06,"var"],[32,42,70.06,71.22,"kjempefint"]]},{"id":19,"start":71.3,"end":74.35,"text":"Hva gjorde dere i Trondheim?","zh":"你们在特隆赫姆做了什么？","words":[[0,3,72.1,72.78,"hva"],[4,10,72.78,73.2,"gjorde"],[11,15,73.2,73.52,"dere"],[16,17,73.52,73.66,"i"],[18,27,73.66,74.27,"trondheim"]]},{"id":20,"start":74.47,"end":78.39,"text":"Vi besøkte Nidarosdomen, og den var flott.","zh":"我们参观了尼达罗斯大教堂，它非常壮观。","words":[[0,2,74.47,75.41,"vi"],[3,10,75.41,75.91,"besøkte"],[11,23,75.91,76.85,"nidarosdomen"],[25,27,77.33,77.47,"og"],[28,31,77.47,77.63,"den"],[32,35,77.63,77.77,"var"],[36,41,77.77,78.31,"flott"]]}],"lexicon":{"7.5":{"lemma":"7.5","zh":"第 7.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alene":{"lemma":"alene","zh":"独自一人","pos":"副词","ref":"2-054","clip":"pronunciation/3c24fdbe3fdf986a62b0.mp3"},"alltid":{"lemma":"alltid","zh":"总是；一直","pos":"副词","ref":"basics:frequency:alltid","clip":"pronunciation/fca234bf04bff719be01.mp3"},"besøkte":{"lemma":"besøke","zh":"拜访；看望；参观","pos":"动词","ref":"6-049","form":"过去时","clip":null},"billett":{"lemma":"billett","zh":"票"