{"id":"pa-vei-7.A","bookId":"pa-vei-textbook","readingId":"7.A","title":"Emma må ha nye sko","audio":"audio/pa-vei/7.A.mp3","duration":105.228,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.78,"end":3.325,"text":"A. Emma må ha nye sko","zh":"A. 艾玛需要新鞋","words":[[0,1,0.78,1.16,"a"],[3,7,2.12,2.422,"emma"],[8,10,2.422,2.545,"må"],[11,13,2.58,2.725,"ha"],[14,17,2.74,3.025,"nye"],[18,21,3.08,3.325,"sko"]]},{"id":1,"start":5.6,"end":6.525,"text":"Har du det travelt?","zh":"你忙吗？","words":[[0,3,5.6,5.742,"har"],[4,6,5.742,5.853,"du"],[7,10,5.853,6.002,"det"],[11,18,6.002,6.525,"travelt"]],"speaker":"Marianne"},{"id":2,"start":7.34,"end":7.705,"text":"Nei.","zh":"不忙。","words":[[0,3,7.34,7.705,"nei"]],"speaker":"Henrik"},{"id":3,"start":8.68,"end":9.3,"text":"Hvordan det?","zh":"怎么了？","words":[[0,7,8.68,8.992,"hvordan"],[8,11,8.992,9.3,"det"]],"speaker":"Henrik"},{"id":4,"start":10.09,"end":14.415,"text":"Emma må ha nye sko, og jeg må gjøre ferdig en rapport til i morgen.","zh":"埃玛需要买新鞋，而我得在明天之前完成一份报告。","words":[[0,4,10.09,10.415,"emma"],[5,7,10.49,10.635,"må"],[8,10,10.71,10.855,"ha"],[11,14,10.87,11.152,"nye"],[15,18,11.152,11.355,"sko"],[20,22,11.99,12.135,"og"],[23,26,12.15,12.395,"jeg"],[27,29,12.43,12.555,"må"],[30,35,12.57,12.835,"gjøre"],[36,42,12.85,13.143,"ferdig"],[43,45,13.143,13.242,"en"],[46,53,13.242,13.695,"rapport"],[54,57,13.89,14.032,"til"],[58,59,14.032,14.123,"i"],[60,66,14.123,14.415,"morgen"]],"speaker":"Marianne"},{"id":5,"start":15.21,"end":17.095,"text":"Kan du bli med henne i butikken?","zh":"你能陪她去商店吗？","words":[[0,3,15.21,15.415,"kan"],[4,6,15.53,15.695,"du"],[7,10,15.85,16.035,"bli"],[11,14,16.07,16.223,"med"],[15,20,16.223,16.475,"henne"],[21,22,16.51,16.612,"i"],[23,31,16.612,17.095,"butikken"]],"speaker":"Marianne"},{"id":6,"start":18.05,"end":18.195,"text":"Nå?","zh":"现在？","words":[[0,2,18.05,18.195,"nå"]],"speaker":"Henrik"},{"id":7,"start":19.29,"end":22.375,"text":"Nei, nå vil jeg lese avisen og slappe av.","zh":"不行，我现在想看看报纸，休息一下。","words":[[0,3,19.29,19.615,"nei"],[5,7,20.27,20.415,"nå"],[8,11,20.49,20.652,"vil"],[12,15,20.652,20.835,"jeg"],[16,20,20.85,21.233,"lese"],[21,27,21.233,21.742,"avisen"],[28,30,21.742,21.843,"og"],[31,37,21.843,22.212,"slappe"],[38,40,22.212,22.375,"av"]],"speaker":"Henrik"},{"id":8,"start":23.07,"end":23.815,"text":"Jeg er sliten.","zh":"我很累。","words":[[0,3,23.07,23.223,"jeg"],[4,6,23.223,23.352,"er"],[7,13,23.352,23.815,"sliten"]],"speaker":"Henrik"},{"id":9,"start":25.11,"end":26.715,"text":"Sliten eller lat?","zh":"是累，还是懒？","words":[[0,6,25.11,25.695,"sliten"],[7,12,25.97,26.255,"eller"],[13,16,26.29,26.715,"lat"]],"speaker":"Marianne"},{"id":10,"start":27.73,"end":28.315,"text":"Sliten.","zh":"累。","words":[[0,6,27.73,28.315,"sliten"]],"speaker":"Henrik"},{"id":11,"start":29.47,"end":32.095,"text":"Det var mange kjedelige møter på skolen i dag.","zh":"今天学校里开了很多无聊的会。","words":[[0,3,29.47,29.622,"det"],[4,7,29.622,29.775,"var"],[8,13,29.81,30.255,"mange"],[14,23,30.31,30.835,"kjedelige"],[24,29,30.85,31.233,"møter"],[30,32,31.233,31.373,"på"],[33,39,31.373,31.792,"skolen"],[40,41,31.792,31.883,"i"],[42,45,31.883,32.095,"dag"]],"speaker":"Henrik"},{"id":12,"start":33.61,"end":35.195,"text":"Dessuten er klokka halv fem.","zh":"而且已经四点半了。","words":[[0,8,33.61,34.162,"dessuten"],[9,11,34.162,34.293,"er"],[12,18,34.293,34.615,"klokka"],[19,23,34.65,34.955,"halv"],[24,27,34.99,35.195,"fem"]],"speaker":"Henrik"},{"id":13,"start":35.97,"end":37.415,"text":"Butikkene stenger snart.","zh":"商店很快就要关门了。","words":[[0,9,35.97,36.535,"butikkene"],[10,17,36.59,37.013,"stenger"],[18,23,37.013,37.415,"snart"]],"speaker":"Henrik"},{"id":14,"start":38.41,"end":40.655,"text":"Skobutikken er åpen til klokka seks.","zh":"鞋店开到六点。","words":[[0,11,38.41,39.123,"skobutikken"],[12,14,39.123,39.275,"er"],[15,19,39.33,39.752,"åpen"],[20,23,39.752,39.892,"til"],[24,30,39.892,40.195,"klokka"],[31,35,40.27,40.655,"seks"]],"speaker":"Marianne"},{"id":15,"start":41.61,"end":43.135,"text":"Kan vi ikke gjøre det i morgen?","zh":"我们明天去不行吗？","words":[[0,3,41.61,41.812,"kan"],[4,6,41.812,41.933,"vi"],[7,11,41.933,42.133,"ikke"],[12,17,42.133,42.413,"gjøre"],[18,21,42.413,42.532,"det"],[22,23,42.532,42.623,"i"],[24,30,42.623,43.135,"morgen"]],"speaker":"Henrik"},{"id":16,"start":45.25,"end":47.775,"text":"Hun trenger nye sko i dag, Henrik.","zh":"亨里克，她今天就需要新鞋。","words":[[0,3,45.25,45.415,"hun"],[4,11,45.45,45.935,"trenger"],[12,15,45.97,46.315,"nye"],[16,19,46.37,46.595,"sko"],[20,21,46.71,46.835,"i"],[22,25,46.89,47.235,"dag"],[27,33,47.27,47.775,"henrik"]],"speaker":"Marianne"},{"id":17,"start":48.27,"end":50.395,"text":"Hun skal i bursdagsselskap i morgen.","zh":"她明天要参加生日聚会。","words":[[0,3,48.27,48.415,"hun"],[4,8,48.49,48.755,"skal"],[9,10,48.79,48.915,"i"],[11,26,48.95,49.892,"bursdagsselskap"],[27,28,49.892,49.983,"i"],[29,35,49.983,50.395,"morgen"]],"speaker":"Marianne"},{"id":18,"start":51.39,"end":54.315,"text":"Jeg skal gjøre det, men du maser for mye.","zh":"我会去的，不过你太唠叨了。","words":[[0,3,51.39,51.555,"jeg"],[4,8,51.61,51.955,"skal"],[9,14,52.07,52.373,"gjøre"],[15,18,52.373,52.535,"det"],[20,23,53.05,53.203,"men"],[24,26,53.203,53.335,"du"],[27,32,53.39,53.892,"maser"],[33,36,53.892,54.062,"for@pa-vei-for-excess"],[37,40,54.062,54.315,"mye"]],"speaker":"Henrik"},{"id":19,"start":55.43,"end":56.755,"text":"Det gjør jeg ikke!","zh":"我才没有！","words":[[0,3,55.43,55.635,"det"],[4,8,55.79,56.075,"gjør"],[9,12,56.09,56.295,"jeg"],[13,17,56.39,56.755,"ikke"]],"speaker":"Marianne"},{"id":20,"start":57.89,"end":62.955,"text":"Og så må du kjøpe toalettpapir, brød, en agurk og litt brokkoli.","zh":"你还得买卫生纸、面包、一根黄瓜和一点西兰花。","words":[[0,2,57.89,58.035,"og"],[3,5,58.15,58.295,"så"],[6,8,58.49,58.615,"må"],[9,11,58.65,58.795,"du"],[12,17,58.85,59.235,"kjøpe"],[18,30,59.29,60.195,"toalettpapir"],[32,36,60.47,60.875,"brød"],[38,40,61.27,61.442,"en"],[41,46,61.442,61.915,"agurk"],[47,49,62.09,62.235,"og"],[50,54,62.33,62.562,"litt"],[55,63,62.562,62.955,"brokkoli"]],"speaker":"Marianne"},{"id":21,"start":63.91,"end":65.435,"text":"Jeg kjøpte toalettpapir i går.","zh":"我昨天买过卫生纸了。","words":[[0,3,63.91,64.075,"jeg"],[4,10,64.09,64.412,"kjøpte"],[11,23,64.412,65.113,"toalettpapir"],[24,25,65.113,65.203,"i"],[26,29,65.203,65.435,"går"]],"speaker":"Henrik"},{"id":22,"start":66.13,"end":67.135,"text":"Det ligger i skapet.","zh":"在柜子里。","words":[[0,3,66.13,66.273,"det"],[4,10,66.273,66.562,"ligger"],[11,12,66.562,66.653,"i"],[13,19,66.653,67.135,"skapet"]],"speaker":"Henrik"},{"id":23,"start":68.12,"end":69.835,"text":"Å, det så jeg ikke.","zh":"哦，我没看见。","words":[[0,1,68.12,68.4,"å"],[3,6,68.97,69.155,"det"],[7,9,69.27,69.415,"så@pa-vei-så-saw"],[10,13,69.45,69.602,"jeg"],[14,18,69.602,69.835,"ikke"]],"speaker":"Marianne"},{"id":24,"start":73.45,"end":74.215,"text":"Sammendrag.","zh":"摘要","words":[[0,10,73.45,74.215,"sammendrag"]]},{"id":25,"start":76.12,"end":82.265,"text":"Emma må ha nye sko, men Henrik har ikke lyst til å bli med henne i butikken.","zh":"埃玛需要买新鞋，可亨里克不想陪她去商店。","words":[[0,4,76.12,76.485,"emma"],[5,7,76.54,76.665,"må"],[8,10,76.72,76.845,"ha"],[11,14,76.9,77.205,"nye"],[15,18,77.26,77.505,"sko"],[20,23,79.04,79.225,"men"],[24,30,79.32,79.812,"henrik"],[31,34,79.812,79.953,"har"],[35,39,79.953,80.185,"ikke"],[40,44,80.24,80.605,"lyst@pa-vei-lyst-desire"],[45,48,80.62,80.803,"til"],[49,50,80.803,80.903,"å"],[51,54,80.903,81.085,"bli"],[55,58,81.22,81.362,"med"],[59,64,81.362,81.625,"henne"],[65,66,81.66,81.762,"i"],[67,75,81.762,82.265,"butikken"]]},{"id":26,"start":83.66,"end":85.665,"text":"Han har mange unnskyldninger.","zh":"他有很多借口。","words":[[0,3,83.66,83.865,"han"],[4,7,83.98,84.245,"har"],[8,13,84.4,84.885,"mange"],[14,28,84.98,85.665,"unnskyldninger"]]},{"id":27,"start":87.32,"end":93.065,"text":"Det var mye å gjøre på jobben, og nå er han sliten og vil lese avisen.","zh":"工作上有很多事要做，现在他累了，想看看报纸。","words":[[0,3,87.32,87.463,"det"],[4,7,87.463,87.645,"var"],[8,11,87.66,87.953,"mye"],[12,13,87.953,88.042,"å"],[14,19,88.042,88.405,"gjøre"],[20,22,88.44,88.565,"på"],[23,29,88.62,88.985,"jobben"],[31,33,90.08,90.225,"og"],[34,36,90.24,90.385,"nå"],[37,39,90.56,90.733,"er"],[40,43,90.733,90.885,"han"],[44,50,90.96,91.505,"sliten"],[51,53,92.0,92.132,"og"],[54,57,92.132,92.282,"vil"],[58,62,92.282,92.602,"lese"],[63,69,92.602,93.065,"avisen"]]},{"id":28,"start":94.46,"end":96.445,"text":"Dessuten stenger butikkene snart.","zh":"而且商店很快就要关门了。","words":[[0,8,94.46,95.025,"dessuten"],[9,16,95.1,95.602,"stenger"],[17,26,95.602,96.123,"butikkene"],[27,32,96.123,96.445,"snart"]]},{"id":29,"start":98.42,"end":103.245,"text":"Marianne blir irritert, og til slutt må Henrik dra i butikken.","zh":"玛丽安娜生气了，最后亨里克只好去商店。","words":[[0,8,98.42,98.963,"marianne"],[9,13,98.963,99.185,"blir"],[14,22,99.24,99.905,"irritert"],[24,26,101.2,101.343,"og"],[27,30,101.343,101.502,"til"],[31,36,101.502,101.805,"slutt"],[37,39,101.86,102.005,"må"],[40,46,102.12,102.523,"henrik"],[47,50,102.523,102.685,"dra"],[51,52,102.72,102.812,"i"],[53,61,102.812,103.245,"butikken"]]}],"lexicon":{"a":{"lemma":"A","pos":"字母","zh":"字母 A","ref":null,"clip":null},"agurk":{"lemma":"agurk","zh":"黄瓜","pos":"名词","ref":"basics:groceries:agurk","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"avisen":{"lemma":"avis","pos":"名词","zh":"报纸","ref":null,"clip":null,"form":"单数定指"},"bli":{"lemma":"bli","pos":"动词","zh":"变成；成为；留下","ref":null,"clip":null,"form":"不定式"},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"brokkoli":{"lemma":"brokkoli","zh":"西兰花","pos":"名词","ref":"basics:groceries:brokkoli","clip":null},"brød":{"lemma":"brød","zh":"面包","pos":"名词","ref":"ty-conversation-5-005","clip":null},"bursdagsselskap":{"lemma":"bursdagsselskap","zh":"生日聚会","pos":"名词","ref":"pa-vei-7-051","clip":null},"butikken":{"lemma":"butikk","zh":"商店","pos":"名词","ref":"6-086","form":"单数定指","clip":null},"butikkene":{"lemma":"butikk","zh":"商店","pos":"名词","ref":"6-086",