{"id":"pa-vei-5.song","bookId":"pa-vei-textbook","readingId":"5.song","title":"Hvem skal bake, og hvem vil smake?","audio":"audio/pa-vei/5.song.mp3","duration":90.739333,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.92,"end":5.365,"text":"Hvem skal bake, og hvem vil smake?","zh":"谁来烤面包，谁想尝一尝？","words":[[0,4,1.92,2.165,"hvem"],[5,9,2.28,2.505,"skal"],[10,14,2.54,3.005,"bake"],[16,18,4.02,4.165,"og"],[19,23,4.18,4.445,"hvem"],[24,27,4.54,4.725,"vil"],[28,33,4.8,5.365,"smake"]]},{"id":1,"start":7.786,"end":14.991,"text":"En katt, ei mus og ei høne bor sammen. En dag sier høna:","zh":"一只猫、一只老鼠和一只母鸡住在一起。一天，母鸡说：","words":[[0,2,7.786,8.011,"en"],[3,7,8.086,8.531,"katt"],[9,11,9.106,9.271,"ei"],[12,15,9.346,9.791,"mus"],[16,18,10.126,10.271,"og"],[19,21,10.286,10.431,"ei"],[22,26,10.486,10.891,"høne"],[27,30,11.286,11.611,"bor"],[31,37,11.686,12.031,"sammen"],[39,41,13.646,13.871,"en"],[42,45,13.886,14.231,"dag"],[46,50,14.286,14.651,"sier"],[51,55,14.666,14.991,"høna"]]},{"id":2,"start":16.826,"end":20.191,"text":"– Vi har ikke mat i huset. Nå må vi bake.","zh":"“家里没吃的了。现在我们得烤点东西。”","words":[[2,4,16.826,16.951,"vi"],[5,8,17.006,17.269,"har"],[9,13,17.269,17.511,"ikke"],[14,17,17.526,17.868,"mat"],[18,19,17.868,17.968,"i"],[20,25,17.968,18.331,"huset"],[27,29,19.086,19.231,"nå"],[30,32,19.346,19.491,"må"],[33,35,19.546,19.671,"vi"],[36,40,19.726,20.191,"bake"]]},{"id":3,"start":21.826,"end":23.991,"text":"– Ja, det må vi, sier katten.","zh":"“是啊，是得烤了。”猫说。","words":[[2,4,21.826,21.991,"ja"],[6,9,22.266,22.431,"det"],[10,12,22.466,22.611,"må"],[13,15,22.726,22.851,"vi"],[17,21,23.326,23.591,"sier"],[22,28,23.606,23.991,"katten"]]},{"id":4,"start":25.206,"end":27.491,"text":"– Ja, det må vi, sier musa.","zh":"“是啊，是得烤了。”老鼠说。","words":[[2,4,25.206,25.371,"ja"],[6,9,25.706,25.871,"det"],[10,12,25.926,26.071,"må"],[13,15,26.206,26.331,"vi"],[17,21,26.826,27.108,"sier"],[22,26,27.108,27.491,"musa"]]},{"id":5,"start":29.766,"end":32.391,"text":"– Hvem skal gå etter mel? spør høna.","zh":"“谁去拿面粉？”母鸡问。","words":[[2,6,29.766,30.011,"hvem"],[7,11,30.086,30.291,"skal"],[12,14,30.346,30.491,"gå"],[15,20,30.546,30.831,"etter@pa-vei-extra-2"],[21,24,30.846,31.191,"mel"],[26,30,31.726,32.011,"spør"],[31,35,32.046,32.391,"høna"]]},{"id":6,"start":33.986,"end":35.811,"text":"– Ikke jeg, sier katten.","zh":"“我不去。”猫说。","words":[[2,6,33.986,34.291,"ikke"],[7,10,34.326,34.571,"jeg"],[12,16,35.106,35.391,"sier"],[17,23,35.406,35.811,"katten"]]},{"id":7,"start":36.786,"end":38.571,"text":"– Ikke jeg, sier musa.","zh":"“我不去。”老鼠说。","words":[[2,6,36.786,37.091,"ikke"],[7,10,37.126,37.391,"jeg"],[12,16,37.906,38.209,"sier"],[17,21,38.209,38.571,"musa"]]},{"id":8,"start":40.366,"end":42.411,"text":"– Da må jeg gå, sier høna.","zh":"“那么得我去了。”母鸡说。","words":[[2,4,40.366,40.511,"da"],[5,7,40.626,40.771,"må"],[8,11,40.826,41.051,"jeg"],[12,14,41.106,41.251,"gå"],[16,20,41.806,42.108,"sier"],[21,25,42.108,42.411,"høna"]]},{"id":9,"start":44.546,"end":46.491,"text":"Høna kommer tilbake med mel.","zh":"母鸡带着面粉回来了。","words":[[0,4,44.546,44.951,"høna"],[5,11,45.046,45.359,"kommer"],[12,19,45.359,45.989,"tilbake"],[20,23,45.989,46.159,"med"],[24,27,46.159,46.491,"mel"]]},{"id":10,"start":48.466,"end":51.491,"text":"– Hvem skal bake kaka? spør høna.","zh":"“谁来烤蛋糕？”母鸡问。","words":[[2,6,48.466,48.711,"hvem"],[7,11,48.806,49.031,"skal"],[12,16,49.106,49.551,"bake"],[17,21,49.586,49.971,"kaka"],[23,27,50.846,51.131,"spør"],[28,32,51.166,51.491,"høna"]]},{"id":11,"start":53.166,"end":54.971,"text":"– Ikke jeg, sier katten.","zh":"“我不烤。”猫说。","words":[[2,6,53.166,53.471,"ikke"],[7,10,53.506,53.751,"jeg"],[12,16,54.286,54.551,"sier"],[17,23,54.566,54.971,"katten"]]},{"id":12,"start":56.126,"end":57.951,"text":"– Ikke jeg, sier musa.","zh":"“我不烤。”老鼠说。","words":[[2,6,56.126,56.411,"ikke"],[7,10,56.466,56.711,"jeg"],[12,16,57.286,57.569,"sier"],[17,21,57.569,57.951,"musa"]]},{"id":13,"start":59.686,"end":65.551,"text":"– Da må jeg gjøre det, sier høna, og så lager hun ei kake og steker den.","zh":"“那么得我来做了。”母鸡说，接着她做了一个蛋糕，把它烤熟了。","words":[[2,4,59.686,59.831,"da"],[5,7,59.926,60.071,"må"],[8,11,60.126,60.331,"jeg"],[12,17,60.386,60.659,"gjøre"],[18,21,60.659,60.811,"det"],[23,27,61.146,61.431,"sier"],[28,32,61.446,61.791,"høna"],[34,36,62.506,62.651,"og"],[37,39,62.706,62.851,"så"],[40,45,62.946,63.359,"lager"],[46,49,63.359,63.508,"hun"],[50,52,63.508,63.691,"ei"],[53,57,63.706,64.151,"kake"],[58,60,64.706,64.831,"og"],[61,67,64.886,65.409,"steker"],[68,71,65.409,65.551,"den"]]},{"id":14,"start":67.926,"end":70.491,"text":"Kaka er ferdig og ligger på bordet.","zh":"蛋糕做好了，放在桌子上。","words":[[0,4,67.926,68.411,"kaka"],[5,7,68.526,68.711,"er"],[8,14,68.786,69.211,"ferdig"],[15,17,69.446,69.571,"og"],[18,24,69.586,69.951,"ligger@pa-vei-extra-1"],[25,27,69.986,70.111,"på"],[28,34,70.126,70.491,"bordet"]]},{"id":15,"start":72.406,"end":75.211,"text":"– Hvem vil spise kaka? spør høna.","zh":"“谁想吃蛋糕？”母鸡问。","words":[[2,6,72.406,72.651,"hvem"],[7,10,72.726,72.911,"vil"],[11,16,72.986,73.591,"spise"],[17,21,73.626,74.071,"kaka"],[23,27,74.566,74.851,"spør"],[28,32,74.886,75.211,"høna"]]},{"id":16,"start":76.526,"end":78.291,"text":"– Det vil jeg, sier katten.","zh":"“我想吃。”猫说。","words":[[2,5,76.526,76.711,"det"],[6,9,76.746,76.911,"vil"],[10,13,76.986,77.231,"jeg"],[15,19,77.626,77.888,"sier"],[20,26,77.888,78.291,"katten"]]},{"id":17,"start":79.126,"end":80.911,"text":"– Det vil jeg, sier musa.","zh":"“我想吃。”老鼠说。","words":[[2,5,79.126,79.311,"det"],[6,9,79.326,79.491,"vil"],[10,13,79.566,79.811,"jeg"],[15,19,80.206,80.488,"sier"],[20,24,80.488,80.911,"musa"]]},{"id":18,"start":82.226,"end":88.711,"text":"– Nei, det vil jeg, det, sier høna, og så spiser hun opp hele kaka.","zh":"“不，是我要吃。”母鸡说，然后她把整个蛋糕都吃掉了。","words":[[2,5,82.226,82.531,"nei"],[7,10,83.066,83.271,"det"],[11,14,83.426,83.631,"vil"],[15,18,83.826,84.051,"jeg"],[20,23,84.086,84.271,"det"],[25,29,84.766,85.069,"sier"],[30,34,85.069,85.391,"høna"],[36,38,86.126,86.271,"og"],[39,41,8