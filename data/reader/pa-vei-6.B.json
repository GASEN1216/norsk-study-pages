{"id":"pa-vei-6.B","bookId":"pa-vei-textbook","readingId":"6.B","title":"Berit var i Trøndelag","audio":"audio/pa-vei/6.B.mp3","duration":90.696,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.5,"end":5.165,"text":"B. Berit var i Trøndelag","zh":"B. 贝丽特去了特伦德拉格","words":[[0,1,1.5,2.04,"b"],[3,8,3.38,3.942,"berit"],[9,12,3.942,4.162,"var"],[13,14,4.162,4.265,"i"],[15,24,4.32,5.165,"trøndelag"]]},{"id":1,"start":7.76,"end":10.945,"text":"I sommerferien var Berit i Trøndelag.","zh":"暑假时，贝丽特去了特伦德拉格。","words":[[0,1,7.76,7.865,"i"],[2,14,8.0,8.945,"sommerferien"],[15,18,9.0,9.265,"var"],[19,24,9.34,9.945,"berit"],[25,26,10.04,10.145,"i"],[27,36,10.2,10.945,"trøndelag"]]},{"id":2,"start":12.372,"end":16.957,"text":"Først tok hun tog til Trondheim, for der har hun mange venner.","zh":"她先乘火车去了特隆赫姆，因为她在那里有很多朋友。","words":[[0,5,12.372,12.797,"først"],[6,9,13.012,13.284,"tok"],[10,13,13.284,13.437,"hun"],[14,17,13.512,13.897,"tog"],[18,21,13.912,14.097,"til"],[22,31,14.152,14.717,"trondheim"],[33,36,15.372,15.534,"for@pa-vei-for-because"],[37,40,15.534,15.797,"der"],[41,44,15.832,16.035,"har"],[45,48,16.035,16.197,"hun"],[49,54,16.252,16.595,"mange"],[55,61,16.595,16.957,"venner"]]},{"id":3,"start":18.472,"end":22.337,"text":"Etterpå reiste hun med buss til Namsos for å fiske laks.","zh":"之后她乘长途汽车去纳姆索斯钓鲑鱼。","words":[[0,7,18.472,18.977,"etterpå"],[8,14,19.092,19.445,"reiste"],[15,18,19.445,19.614,"hun"],[19,22,19.614,19.777,"med"],[23,27,19.792,20.137,"buss"],[28,31,20.192,20.357,"til"],[32,38,20.392,21.077,"namsos"],[39,42,21.332,21.485,"for"],[43,44,21.485,21.577,"å"],[45,50,21.592,21.955,"fiske"],[51,55,21.955,22.337,"laks"]]},{"id":4,"start":23.632,"end":26.517,"text":"Billetten kjøpte hun på bussterminalen i Trondheim.","zh":"车票是她在特隆赫姆的长途汽车站买的。","words":[[0,9,23.632,24.197,"billetten"],[10,16,24.272,24.645,"kjøpte"],[17,20,24.645,24.797,"hun"],[21,23,24.832,24.957,"på"],[24,38,24.992,25.915,"bussterminalen"],[39,40,25.915,26.005,"i"],[41,50,26.005,26.517,"trondheim"]]},{"id":5,"start":29.532,"end":31.237,"text":"Går det buss til Namsos?","zh":"有去纳姆索斯的长途汽车吗？","words":[[0,3,29.532,29.724,"går"],[4,7,29.724,29.877,"det"],[8,12,29.932,30.297,"buss"],[13,16,30.372,30.537,"til"],[17,23,30.552,31.237,"namsos"]],"speaker":"Berit"},{"id":6,"start":32.552,"end":34.077,"text":"Ja, det gjør det.","zh":"有的。","words":[[0,2,32.552,32.717,"ja"],[4,7,33.452,33.617,"det"],[8,12,33.692,33.915,"gjør"],[13,16,33.915,34.077,"det"]],"speaker":"Ekspeditør"},{"id":7,"start":35.072,"end":41.337,"text":"Det går buss klokka 08.00, 12.00 og 14.30.","zh":"八点、十二点和十四点三十分都有车。","words":[[0,3,35.072,35.237,"det"],[4,7,35.252,35.457,"går"],[8,12,35.472,35.817,"buss"],[13,19,35.932,36.337,"klokka"],[20,25,36.732,37.637,"08.00"],[27,32,38.372,39.257,"12.00"],[33,35,40.192,40.334,"og"],[36,41,40.334,41.337,"14.30"]],"speaker":"Ekspeditør"},{"id":8,"start":42.652,"end":46.837,"text":"Går bussen direkte til Namsos, eller må jeg bytte underveis?","zh":"汽车直达纳姆索斯吗，还是我得中途换车？","words":[[0,3,42.652,42.957,"går"],[4,10,43.032,43.397,"bussen"],[11,18,43.412,43.924,"direkte"],[19,22,43.924,44.064,"til"],[23,29,44.064,44.637,"namsos"],[31,36,45.212,45.474,"eller"],[37,39,45.474,45.597,"må"],[40,43,45.612,45.794,"jeg"],[44,49,45.794,46.157,"bytte"],[50,59,46.172,46.837,"underveis"]],"speaker":"Berit"},{"id":9,"start":48.252,"end":49.597,"text":"Den går direkte.","zh":"直达。","words":[[0,3,48.252,48.457,"den"],[4,7,48.552,48.837,"går"],[8,15,49.032,49.597,"direkte"]],"speaker":"Ekspeditør"},{"id":10,"start":51.112,"end":52.417,"text":"Hvor lang tid tar det?","zh":"需要多长时间？","words":[[0,4,51.112,51.355,"hvor"],[5,9,51.355,51.617,"lang"],[10,13,51.692,52.017,"tid"],[14,17,52.052,52.264,"tar"],[18,21,52.264,52.417,"det"]],"speaker":"Berit"},{"id":11,"start":53.412,"end":55.377,"text":"Tre timer og tre kvarter.","zh":"三小时四十五分钟。","words":[[0,3,53.412,53.617,"tre"],[4,9,53.772,54.157,"timer"],[10,12,54.492,54.617,"og"],[13,16,54.652,54.857,"tre"],[17,24,54.952,55.377,"kvarter"]],"speaker":"Ekspeditør"},{"id":12,"start":57.092,"end":60.357,"text":"Jeg vil gjerne ha en billett til bussen klokka 12.","zh":"我想买一张十二点那班车的票。","words":[[0,3,57.092,57.297,"jeg"],[4,7,57.332,57.477,"vil"],[8,14,57.492,57.897,"gjerne"],[15,17,57.932,58.057,"ha"],[18,20,58.132,58.264,"en"],[21,28,58.264,58.637,"billett"],[29,32,58.792,58.997,"til"],[33,39,59.032,59.417,"bussen"],[40,46,59.552,59.917,"klokka"],[47,49,60.032,60.357,"12"]],"speaker":"Berit"},{"id":13,"start":61.232,"end":62.437,"text":"Er det noe ledig da?","zh":"那班还有空位吗？","words":[[0,2,61.232,61.395,"er"],[3,6,61.395,61.514,"det"],[7,10,61.514,61.697,"noe"],[11,16,61.712,62.237,"ledig"],[17,19,62.292,62.437,"da"]],"speaker":"Berit"},{"id":14,"start":63.672,"end":64.957,"text":"Ja, det er det.","zh":"有的。","words":[[0,2,63.672,63.817,"ja"],[4,7,64.372,64.557,"det"],[8,10,64.632,64.794,"er"],[11,14,64.794,64.957,"det"]],"speaker":"Ekspeditør"},{"id":15,"start":65.712,"end":66.737,"text":"Det er god plass.","zh":"空位很多。","words":[[0,3,65.712,65.875,"det"],[4,6,65.875,66.037,"er"],[7,10,66.092,66.337,"god"],[11,16,66.392,66.737,"plass"]],"speaker":"Ekspeditør"},{"id":16,"start":67.792,"end":71.217,"text":"Vil du ha én vei eller tur-retur?","zh":"您要单程票还是往返票？","words":[[0,3,67.792,67.945,"vil"],[4,6,67.945,68.065,"du"],[7,9,68.065,68.197,"ha"],[10,12,68.352,68.657,"én"],[13,16,68.732,68.937,"vei"],[17,22,69.532,69.877,"eller"],[23,32,70.212,71.217,"tur-retur"]],"speaker":"Ekspeditør"},{"id":17,"start":72.582,"end":73.447,"text":"Én vei, takk.","zh":"单程票，谢谢。","words":[[0,2,72.582,72.827,"én"],[3,6,72.882,73.107,"vei"],[8,12,73.142,73.447,"takk"]],"speaker":"Berit"},{"id":18,"start":74.462,"end":75.387,"text":"Hva koster det?","zh":"多少钱？","words":[[0,3,74.462,74.627,"hva"],[4,10,74.742,75.225,"koster"],[11,14,75.225,75.387,"det"]],"speaker":"Berit"},{"id":19,"start":77.142,"end":78.707,"text":"350 kroner.","zh":"三百五十克朗。","words":[[0,3,77.142,78.307,"350"],[4,10,78.322,78.707,"kroner"]],"speaker":"Ekspeditør"}