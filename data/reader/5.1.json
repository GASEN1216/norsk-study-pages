{"id":"5.1","title":"Liker du været i Norge?","audio":"audio/5.1.mp3","duration":162.35,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.78,"text":"5.1 Liker du været i Norge?","heading":true,"zh":"5.1 你喜欢挪威的天气吗？","words":[[0,3,0.15,1.4,"5.1"],[4,9,2.28,3.04,"liker"],[10,12,3.04,3.32,"du"],[13,18,3.32,3.8,"været"],[19,20,3.8,4.16,"i"],[21,26,4.16,4.7,"norge~546b56e35dd5"]]},{"id":1,"start":6.73,"end":11.73,"text":"Nordmenn snakker mye om været og ser ofte på yr.no.","zh":"挪威人很爱谈论天气，也经常看 yr.no（天气预报网站）。","words":[[0,8,6.79,7.46,"nordmenn"],[9,16,7.46,8.02,"snakker"],[17,20,8.02,8.42,"mye~933c5a923198"],[21,23,8.42,8.58,"om~52c0bdc828db"],[24,29,8.58,9.1,"været"],[30,32,9.38,9.52,"og"],[33,36,9.52,9.9,"ser"],[37,41,9.9,10.5,"ofte"],[42,44,10.64,10.9,"på~fab38a6838d6"],[45,50,10.9,11.73,"yr.no"]]},{"id":2,"start":13.43,"end":15.47,"text":"Vi spør fem på gata:","zh":"我们在街头问了五个人：","words":[[0,2,13.49,13.94,"vi"],[3,7,13.94,14.38,"spør"],[8,11,14.38,14.7,"fem"],[12,14,14.7,14.82,"på"],[15,19,14.82,15.32,"gata"]]},{"id":3,"start":16.06,"end":19.04,"text":"Liker du været og årstidene i Norge?","zh":"你喜欢挪威的天气和四季吗？","words":[[0,5,16.12,16.6,"liker"],[6,8,16.6,16.76,"du"],[9,14,16.76,17.38,"været"],[15,17,17.38,17.68,"og"],[18,27,17.68,18.4,"årstidene"],[28,29,18.4,18.48,"i"],[30,35,18.48,18.89,"norge~546b56e35dd5"]]},{"id":4,"start":21.13,"end":22.65,"text":"Casper 10 år","subheading":true,"zh":"卡斯珀，10岁","words":[[0,6,21.19,21.9,"casper"],[7,9,21.9,22.18,"10"],[10,12,22.18,22.5,"år~22379c2e8e96"]]},{"id":5,"start":24.57,"end":25.99,"text":"Jeg elsker snø.","zh":"我很爱雪。","words":[[0,3,24.62,24.96,"jeg"],[4,10,24.96,25.48,"elsker"],[11,14,25.48,25.84,"snø~c3b53aee92b5"]]},{"id":6,"start":26.55,"end":28.85,"text":"Om vinteren kan jeg leke ute i snøen.","zh":"冬天我可以在外面玩雪。","words":[[0,2,26.61,26.8,"om~1e753acc270b"],[3,11,26.8,27.28,"vinteren"],[12,15,27.28,27.42,"kan"],[16,19,27.42,27.56,"jeg"],[20,24,27.56,27.92,"leke"],[25,28,27.92,28.2,"ute"],[29,30,28.2,28.3,"i"],[31,36,28.3,28.7,"snøen"]]},{"id":7,"start":29.39,"end":31.8,"text":"Jeg pleier å gå på ski og lage snømann.","zh":"我通常会去滑雪、堆雪人。","words":[[0,3,29.45,29.64,"jeg"],[4,10,29.64,29.88,"pleier"],[11,12,29.88,29.96,"å~0583da7a620a"],[13,15,29.96,30.1,"gå"],[16,18,30.1,30.3,"på~8a7f538934a2"],[19,22,30.3,30.68,"ski"],[23,25,30.78,30.88,"og"],[26,30,30.88,31.16,"lage"],[31,38,31.16,31.66,"snømann"]]},{"id":8,"start":32.43,"end":33.77,"text":"Det er fint om vinteren.","zh":"冬天很美好。","words":[[0,3,32.49,32.62,"det"],[4,6,32.62,32.76,"er"],[7,11,32.76,33.1,"fint"],[12,14,33.1,33.22,"om~1e753acc270b"],[15,23,33.22,33.62,"vinteren"]]},{"id":9,"start":35.93,"end":38.16,"text":"Enrico 45 år","subheading":true,"zh":"恩里科，45岁","words":[[0,6,35.99,36.88,"enrico"],[7,9,37.08,37.7,"45"],[10,12,37.7,38.02,"år~22379c2e8e96"]]},{"id":10,"start":39.33,"end":41.67,"text":"Det er alltid kaldt i Norge!","zh":"挪威总是很冷！","words":[[0,3,39.39,39.6,"det"],[4,6,39.6,39.76,"er"],[7,13,39.76,40.26,"alltid~867f85a8b647"],[14,19,40.26,40.94,"kaldt"],[20,21,40.94,41.06,"i"],[22,27,41.06,41.52,"norge~546b56e35dd5"]]},{"id":11,"start":42.53,"end":46.81,"text":"Om vinteren er det glatt på veien, og det er vanskelig å gå.","zh":"冬天路面很滑，走路很困难。","words":[[0,2,42.59,42.84,"om~1e753acc270b"],[3,11,42.84,43.44,"vinteren"],[12,14,43.44,43.54,"er"],[15,18,43.54,43.72,"det"],[19,24,43.72,44.12,"glatt"],[25,27,44.12,44.28,"på"],[28,33,44.28,44.76,"veien"],[35,37,44.76,45.03,"og"],[38,41,45.16,45.36,"det"],[42,44,45.36,45.58,"er"],[45,54,45.58,46.2,"vanskelig"],[55,56,46.2,46.3,"å~0583da7a620a"],[57,59,46.3,46.66,"gå"]]},{"id":12,"start":47.76,"end":50.97,"text":"Det er kaldt fra september til mai.","zh":"从九月到五月都很冷。","words":[[0,3,47.82,48.0,"det"],[4,6,48.0,48.26,"er"],[7,12,48.26,48.74,"kaldt"],[13,16,48.74,48.98,"fra"],[17,26,48.98,50.04,"september"],[27,30,50.04,50.4,"til"],[31,34,50.4,50.82,"mai"]]},{"id":13,"start":53.2,"end":55.27,"text":"Gro 65 år","subheading":true,"zh":"格罗，65岁","words":[[0,3,53.27,53.76,"gro"],[4,6,54.14,54.84,"65"],[7,9,54.84,55.12,"år~22379c2e8e96"]]},{"id":14,"start":56.32,"end":60.31,"text":"Om vinteren reiser jeg til Spania.","zh":"冬天我去西班牙。","words":[[0,2,56.38,56.72,"om~1e753acc270b"],[3,11,56.72,57.58,"vinteren"],[12,18,58.12,58.74,"reiser~d4c00f360a8a"],[19,22,58.74,59.16,"jeg"],[23,26,59.28,59.56,"til"],[27,33,59.56,60.16,"spania~89c4d85e54ca"]]},{"id":15,"start":61.24,"end":65.96,"text":"Jeg bor i Spania fra oktober til mars.","zh":"从十月到三月我住在西班牙。","words":[[0,3,61.3,61.7,"jeg"],[4,7,61.7,62.14,"bor"],[8,9,62.14,62.28,"i"],[10,16,62.28,62.99,"spania~89c4d85e54ca"],[17,20,63.26,63.56,"fra"],[21,28,63.56,64.58,"oktober"],[29,32,64.94,65.38,"til"],[33,37,65.38,65.81,"mars"]]},{"id":16,"start":67.21,"end":73.78,"text":"Om sommeren reiser jeg hjem til Norge og er sammen med barn og barnebarn.","zh":"夏天我回挪威，和孩子、孙辈们在一起。","words":[[0,2,67.27,67.62,"om~1438adee3ecf"],[3,11,67.62,68.3,"sommeren"],[12,18,68.6,69.08,"reiser~e23df5abc819"],[19,22,69.08,69.28,"jeg"],[23,27,69.28,69.78,"hjem~633d8ddb7250"],[28,31,69.78,70.0,"til"],[32,37,70.0,70.58,"norge~546b56e35dd5"],[38,40,70.96,71.1,"og"],[41,43,71.1,71.36,"er"],[44,50,71.36,71.76,"sammen"],[51,54,71.76,72.02,"med"],[55,59,72.02,72.7,"barn"],[60,62,72.84,72.98,"og"],[63,72,72.98,73.63,"barnebarn"]]},{"id":17,"start":74.54,"end":78.87,"text":"Det pleier å være fint vær i Norge om sommeren.","zh":"挪威夏天的天气通常很好。","words":[[0,3,74.6,74.78,"det"],[4,10,74.78,75.38,"pleier"],[11,12,75.38,75.52,"å~0583da7a620a"],[13,17,75.52,76.02,"være"],[18,22,76.02,76.48,"fint"],[23,26,76.48,77.0,"vær~c9ef13faaa9b"],[27,28,77.14,77.26,"i"],[29,34,77.26,77.84,"norge~546b56e35dd5"],[35,37,77.94,78.16,"om~1438adee3ecf"],[38,46,78.16,78.72,"sommeren"]]},{"id":18,"start":81.0,"end":83.0,"text":"Daniela 40 år","subheading":true,"zh":"丹妮拉，40岁","words":[[0,7,81.06,81.9,"daniela"],[8,10,82.24,82.58,"40"],[11,13,82.58,82.85,"år~22379c2e8e96"]]},{"id":19,"start":84.21,"end":86.99,"text":"Jeg liker været i Norge om sommeren.","zh":"我喜欢挪威夏天的天气。","words":[[0,3,84.27,84.64,"jeg"],[4,9,84.64,85.16,"liker"],[10,15,85.16,85.58,"været"],[16,17,85.58,85.68,"i"],[18,23,85.68,86.1,"norge~546b56e35dd5"],[24,26,86.1,86.34,"om~1438adee3ecf"],[27,35,86.34,86.84,"sommeren"]]},{"id":20,"start":87.86,"end":91.17,"text":"Det er ikke så varmt, og det er frisk luft.","zh":"不太热，空气也很清新。","words":[[0,3,87.92,88.08,"det"],[4,6,88.08,88.26,"er"],[7,11,88.26,88.5,"ikke"],[12,14,88.5,88.68,"så~c37729440b95"],[15,20,88.68,89.36,"varmt"],[22,24,89.62,89.72,"og"],[25,28,89.72,89.84,"det"],[29,31,89.84,90.06,"er"],[32,37,90.06,90.56,"frisk~5a1c3b2d7231"],[38,42,90.56,91.02,"luft"]]},{"id":21,"start":92.17,"end":94.66,"text":"I hjemlandet er det veldig varmt.","zh":"在我的祖国，天气非常热。","words":[[0,1,92.23,92.58,"i"],[2,12,92.58,93.22,"hjemlandet"],[13,15,93.22,93.36,"er"],[16,19,93.36,93.56,"det"],[20,26,93.56,93.98,"veldig"],[27,32,93.98,94.51,"varmt"]]},{"id":22,"start":95.6,"end":98.69,"text":"Folk i Norge koser seg om sommeren.","zh":"挪威人夏天过得很惬意。","words":[[0,4,95.66,96.06,"folk"],[5,6,96.06,96.16,"i"],[7,12,96.16,96.8,"norge~546b56e35dd5"],[13,18,96.8,97.34,"koser"],[19,22,97.34,97.72,"seg"],[23,25,97.88,98.06,"om~1438adee3ecf"],[26,34,98.06,98.54,"sommeren"]]},{"id":23,"start":100.98,"end":103.25,"text":"Petter 54 år","subheading":true,"zh":"佩特，54岁","words":[[0,6,101.04,101.68,"petter"],[7,9,102.1,102.84,"54"],[10,12,102.84,103.1,"år~22379c2e8e96"]]},{"id":24,"start":104.38,"end":110.08,"text":"Jeg liker alle årstidene i Norge, for det er fint med forandring.","zh":"我喜欢挪威的每个季节，因为有变化挺好的。","words":[[0,3,104.44,104.8,"jeg"],[4,9,104.8,105.4,"liker"],[10,14,105.4,105.82,"alle~6873d9584096"],[15,24,105.82,106.5,"årstidene"],[25,26,106.5,106.62,"i"],[27,32,106.62,107.14,"norge~546b56e35dd5"],[34,37,107.94,108.24,"for~a05c87659379"],[38,41,108.24,108.38,"det"],[42,44,108.38,108.58,"er"],[45,49,108.58,109.08,"fint"],[50,53,109.08,109.32,"med~3bfd63955297"],[54,64,109.32,109.93,"forandring"]]},{"id":25,"start":111.29,"end":125.05,"text":"Jeg elsker å trene ute. Om våren, sommeren og høsten pleier jeg å løpe og sykle, og om vinteren pleier jeg å gå på ski.","zh":"我热爱在户外锻炼。春天、夏天和秋天我通常跑步、骑自行车，冬天我通常去滑雪。","words":[[0,3,111.35,111.76,"jeg"],[4,10,111.76,112.46,"elsker"],[11,12,112.46,112.58,"å~0583da7a620a"],[13,18,112.58,113.02,"trene"],[19,22,113.02,113.5,"ute"],[24,26,114.62,114.86,"om~0f47c1b5a328"],[27,32,114.86,115.46,"våren"],[34,42,115.88,116.58,"sommeren"],[43,45,116.9,117.06,"og"],[46,52,117.06,117.66,"høsten"],[53,59,118.34,118.74,"pleier"],[60,63,118.74,119.04,"jeg"],[64,65,119.04,119.18,"å~0583da7a620a"],[66,70,119.18,119.86,"løpe"],[71,73,120.06,120.2,"og"],[74,79,120.2,120.82,"sykle"],[81,83,121.74,122.04,"og"],[84,86,122.04,122.2,"om~1e753acc270b"],[87,95,122.2,122.96,"vinteren"],[96,102,123.34,123.68,"pleier"],[103,106,123.68,124.08,"jeg"],[107,108,124.08,124.18,"å~0583da7a620a"],[109,111,124.18,124.38,"gå"],[112,114,124.38,124.54,"på~8a7f538934a2"],[115,118,124.54,124.9,"ski"]]},{"id":26,"start":126.24,"end":128.86,"text":"Nordmenn er født med ski på beina.","zh":"挪威人生来脚上就踩着滑雪板。","words":[[0,8,126.3,127.0,"nordmenn"],[9,11,127.0,127.26,"er"],[12,16,127.26,127.68,"født"],[17,20,127.68,127.86,"med"],[21,24,127.86,128.2,"ski"],[25,27,128.2,128.34,"på"],[28,33,128.34,128.71,"beina"]]},{"id":27,"start":133.05,"end":133.78,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,133.11,133.63,"fakta"]]},{"id":28,"start":134.92,"end":136.66,"text":"Nordmenn i utlandet","subheading":true,"zh":"在国外的挪威人","words":[[0,8,134.98,135.66,"nordmenn"],[9,10,135.66,135.88,"i"],[11,19,135.88,136.51,"utlandet"]]},{"id":29,"start":138.0,"end":141.69,"text":"Det bor over 35 000 nordmenn i Sverige.","zh":"有超过35 000名挪威人住在瑞典。","words":[[0,3,138.06,138.26,"det"],[4,7,138.26,138.62,"bor"],[8,12,138.62,139.14,"over"],[13,15,139.14,139.92,"35"],[16,19,139.92,140.4,"000~b0055c9cddec"],[20,28,140.4,140.94,"nordmenn"],[29,30,140.94,141.08,"i"],[31,38,141.08,141.54,"sverige"]]},{"id":30,"start":143.01,"end":147.33,"text":"