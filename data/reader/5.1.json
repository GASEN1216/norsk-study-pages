{"id":"5.1","title":"Liker du været i Norge?","audio":"audio/5.1.mp3","duration":162.35,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.78,"text":"5.1 Liker du været i Norge?","heading":true,"zh":"5.1 你喜欢挪威的天气吗？","words":[[0,3,0.15,1.4,"5.1"],[4,9,2.28,3.04,"liker"],[10,12,3.04,3.32,"du"],[13,18,3.32,3.8,"været"],[19,20,3.8,4.16,"i"],[21,26,4.16,4.7,"norge~546b56e35dd5"]]},{"id":1,"start":6.67,"end":12.3,"text":"Nordmenn snakker mye om været og ser ofte på yr.no.","zh":"挪威人很爱谈论天气，也经常看 yr.no（天气预报网站）。","words":[[0,8,6.75,7.3,"nordmenn"],[9,16,7.3,7.86,"snakker"],[17,20,7.86,8.34,"mye~933c5a923198"],[21,23,8.34,8.54,"om~52c0bdc828db"],[24,29,8.54,8.9,"været"],[30,32,8.9,9.48,"og"],[33,36,9.48,9.7,"ser"],[37,41,9.7,10.34,"ofte"],[42,44,10.34,10.76,"på~fab38a6838d6"],[45,50,10.76,12.22,"yr.no"]]},{"id":2,"start":13.4,"end":15.41,"text":"Vi spør fem på gata:","zh":"我们在街头问了五个人：","words":[[0,2,13.48,13.82,"vi"],[3,7,13.82,14.2,"spør"],[8,11,14.2,14.58,"fem"],[12,14,14.58,14.78,"på"],[15,19,14.78,15.33,"gata"]]},{"id":3,"start":16.02,"end":18.99,"text":"Liker du været og årstidene i Norge?","zh":"你喜欢挪威的天气和四季吗？","words":[[0,5,16.1,16.54,"liker"],[6,8,16.54,16.7,"du"],[9,14,16.7,17.12,"været"],[15,17,17.12,17.56,"og"],[18,27,17.56,18.32,"årstidene"],[28,29,18.32,18.46,"i"],[30,35,18.46,18.91,"norge~546b56e35dd5"]]},{"id":4,"start":21.1,"end":22.58,"text":"Casper 10 år","subheading":true,"zh":"卡斯珀，10岁","words":[[0,6,21.18,21.74,"casper"],[7,9,21.74,22.12,"10"],[10,12,22.12,22.5,"år~22379c2e8e96"]]},{"id":5,"start":24.53,"end":25.94,"text":"Jeg elsker snø.","zh":"我很爱雪。","words":[[0,3,24.61,24.79,"jeg"],[4,10,24.79,25.43,"elsker"],[11,14,25.43,25.86,"snø~c3b53aee92b5"]]},{"id":6,"start":26.51,"end":28.8,"text":"Om vinteren kan jeg leke ute i snøen.","zh":"冬天我可以在外面玩雪。","words":[[0,2,26.59,26.75,"om~1e753acc270b"],[3,11,26.75,27.23,"vinteren"],[12,15,27.23,27.39,"kan"],[16,19,27.39,27.51,"jeg"],[20,24,27.51,27.81,"leke"],[25,28,27.81,28.15,"ute"],[29,30,28.15,28.25,"i"],[31,36,28.25,28.72,"snøen"]]},{"id":7,"start":29.35,"end":31.75,"text":"Jeg pleier å gå på ski og lage snømann.","zh":"我通常会去滑雪、堆雪人。","words":[[0,3,29.43,29.61,"jeg"],[4,10,29.61,29.81,"pleier"],[11,12,29.81,29.93,"å~0583da7a620a"],[13,15,29.93,30.05,"gå"],[16,18,30.05,30.19,"på~8a7f538934a2"],[19,22,30.19,30.57,"ski"],[23,25,30.57,30.85,"og"],[26,30,30.85,31.03,"lage"],[31,38,31.03,31.67,"snømann"]]},{"id":8,"start":32.41,"end":33.71,"text":"Det er fint om vinteren.","zh":"冬天很美好。","words":[[0,3,32.49,32.62,"det"],[4,6,32.62,32.72,"er"],[7,11,32.72,33.0,"fint"],[12,14,33.0,33.18,"om~1e753acc270b"],[15,23,33.18,33.63,"vinteren"]]},{"id":9,"start":35.91,"end":38.1,"text":"Enrico 45 år","subheading":true,"zh":"恩里科，45岁","words":[[0,6,35.98,36.67,"enrico"],[7,9,36.67,37.37,"45"],[10,12,37.37,38.02,"år~22379c2e8e96"]]},{"id":10,"start":39.29,"end":41.63,"text":"Det er alltid kaldt i Norge!","zh":"挪威总是很冷！","words":[[0,3,39.37,39.54,"det"],[4,6,39.54,39.68,"er"],[7,13,39.68,40.14,"alltid~867f85a8b647"],[14,19,40.14,40.8,"kaldt"],[20,21,40.8,41.02,"i"],[22,27,41.02,41.55,"norge~546b56e35dd5"]]},{"id":11,"start":42.49,"end":46.74,"text":"Om vinteren er det glatt på veien, og det er vanskelig å gå.","zh":"冬天路面很滑，走路很困难。","words":[[0,2,42.57,42.76,"om~1e753acc270b"],[3,11,42.76,43.4,"vinteren"],[12,14,43.4,43.52,"er"],[15,18,43.52,43.64,"det"],[19,24,43.64,44.0,"glatt"],[25,27,44.0,44.22,"på"],[28,33,44.22,44.66,"veien"],[35,37,44.88,45.0,"og"],[38,41,45.0,45.28,"det"],[42,44,45.28,45.48,"er"],[45,54,45.48,46.1,"vanskelig"],[55,56,46.1,46.26,"å~0583da7a620a"],[57,59,46.26,46.66,"gå"]]},{"id":12,"start":47.73,"end":50.89,"text":"Det er kaldt fra september til mai.","zh":"从九月到五月都很冷。","words":[[0,3,47.8,47.96,"det"],[4,6,47.96,48.12,"er"],[7,12,48.12,48.7,"kaldt"],[13,16,48.7,48.9,"fra"],[17,26,48.9,49.7,"september"],[27,30,49.7,50.22,"til"],[31,34,50.22,50.81,"mai"]]},{"id":13,"start":51.03,"end":55.19,"text":"Gro 65 år","subheading":true,"zh":"格罗，65岁","words":[[0,3,52.54,53.68,"gro"],[4,6,53.68,54.56,"65"],[7,9,54.56,55.11,"år~22379c2e8e96"]]},{"id":14,"start":56.29,"end":60.26,"text":"Om vinteren reiser jeg til Spania.","zh":"冬天我去西班牙。","words":[[0,2,56.37,56.6,"om~1e753acc270b"],[3,11,56.6,57.58,"vinteren"],[12,18,57.69,58.61,"reiser~d4c00f360a8a"],[19,22,58.61,58.83,"jeg"],[23,26,58.83,59.39,"til"],[27,33,59.39,60.18,"spania~89c4d85e54ca"]]},{"id":15,"start":61.21,"end":65.9,"text":"Jeg bor i Spania fra oktober til mars.","zh":"从十月到三月我住在西班牙。","words":[[0,3,61.29,61.55,"jeg"],[4,7,61.55,61.83,"bor"],[8,9,61.83,62.21,"i"],[10,16,62.21,62.75,"spania~89c4d85e54ca"],[17,20,62.75,63.37,"fra"],[21,28,63.37,64.25,"oktober"],[29,32,64.25,65.11,"til"],[33,37,65.11,65.82,"mars"]]},{"id":16,"start":67.17,"end":73.71,"text":"Om sommeren reiser jeg hjem til Norge og er sammen med barn og barnebarn.","zh":"夏天我回挪威，和孩子、孙辈们在一起。","words":[[0,2,67.25,67.43,"om~1438adee3ecf"],[3,11,67.43,68.17,"sommeren"],[12,18,68.17,68.97,"reiser~e23df5abc819"],[19,22,68.97,69.17,"jeg"],[23,27,69.17,69.53,"hjem~633d8ddb7250"],[28,31,69.53,69.89,"til"],[32,37,69.89,70.33,"norge~546b56e35dd5"],[38,40,70.33,71.03,"og"],[41,43,71.03,71.19,"er"],[44,50,71.19,71.71,"sammen"],[51,54,71.71,71.85,"med"],[55,59,71.85,72.43,"barn"],[60,62,72.43,72.91,"og"],[63,72,72.91,73.63,"barnebarn"]]},{"id":17,"start":73.84,"end":78.78,"text":"Det pleier å være fint vær i Norge om sommeren.","zh":"挪威夏天的天气通常很好。","words":[[0,3,73.84,74.71,"det"],[4,10,74.71,75.25,"pleier"],[11,12,75.25,75.47,"å~0583da7a620a"],[13,17,75.47,75.75,"være"],[18,22,75.75,76.37,"fint"],[23,26,76.37,76.75,"vær~c9ef13faaa9b"],[27,28,76.75,77.21,"i"],[29,34,77.21,77.61,"norge~546b56e35dd5"],[35,37,77.61,78.07,"om~1438adee3ecf"],[38,46,78.07,78.7,"sommeren"]]},{"id":18,"start":80.98,"end":82.93,"text":"Daniela 40 år","subheading":true,"zh":"丹妮拉，40岁","words":[[0,7,81.06,81.73,"daniela"],[8,10,82.14,82.49,"40"],[11,13,82.49,82.85,"år~22379c2e8e96"]]},{"id":19,"start":84.17,"end":86.92,"text":"Jeg liker været i Norge om sommeren.","zh":"我喜欢挪威夏天的天气。","words":[[0,3,84.25,84.48,"jeg"],[4,9,84.48,85.1,"liker"],[10,15,85.1,85.46,"været"],[16,17,85.46,85.64,"i"],[18,23,85.64,85.94,"norge~546b56e35dd5"],[24,26,85.94,86.28,"om~1438adee3ecf"],[27,35,86.28,86.84,"sommeren"]]},{"id":20,"start":87.5,"end":91.11,"text":"Det er ikke så varmt, og det er frisk luft.","zh":"不太热，空气也很清新。","words":[[0,3,87.64,88.04,"det"],[4,6,88.04,88.2,"er"],[7,11,88.2,88.4,"ikke"],[12,14,88.4,88.62,"så~c37729440b95"],[15,20,88.62,89.08,"varmt"],[22,24,89.42,89.72,"og"],[25,28,89.72,89.82,"det"],[29,31,89.82,89.96,"er"],[32,37,89.96,90.46,"frisk~5a1c3b2d7231"],[38,42,90.46,91.03,"luft"]]},{"id":21,"start":92.12,"end":94.59,"text":"I hjemlandet er det veldig varmt.","zh":"在我的祖国，天气非常热。","words":[[0,1,92.2,92.5,"i"],[2,12,92.5,93.16,"hjemlandet"],[13,15,93.16,93.34,"er"],[16,19,93.34,93.46,"det"],[20,26,93.46,93.9,"veldig"],[27,32,93.9,94.52,"varmt"]]},{"id":22,"start":95.55,"end":98.63,"text":"Folk i Norge koser seg om sommeren.","zh":"挪威人夏天过得很惬意。","words":[[0,4,95.63,96.0,"folk"],[5,6,96.0,96.14,"i"],[7,12,96.14,96.48,"norge~546b56e35dd5"],[13,18,96.48,97.28,"koser"],[19,22,97.28,97.52,"seg"],[23,25,97.52,98.0,"om~1438adee3ecf"],[26,34,98.0,98.55,"sommeren"]]},{"id":23,"start":100.95,"end":103.18,"text":"Petter 54 år","subheading":true,"zh":"佩特，54岁","words":[[0,6,101.03,101.51,"petter"],[7,9,102.01,102.45,"54"],[10,12,102.45,103.1,"år~22379c2e8e96"]]},{"id":24,"start":104.34,"end":110.01,"text":"Jeg liker alle årstidene i Norge, for det er fint med forandring.","zh":"我喜欢挪威的每个季节，因为有变化挺好的。","words":[[0,3,104.42,104.69,"jeg"],[4,9,104.69,105.19,"liker"],[10,14,105.19,105.65,"alle~6873d9584096"],[15,24,105.65,106.43,"årstidene"],[25,26,106.43,106.59,"i"],[27,32,106.59,106.89,"norge~546b56e35dd5"],[34,37,107.81,108.11,"for~a05c87659379"],[38,41,108.11,108.33,"det"],[42,44,108.33,108.47,"er"],[45,49,108.47,108.87,"fint"],[50,53,108.87,109.21,"med~3bfd63955297"],[54,64,109.21,109.93,"forandring"]]},{"id":25,"start":111.23,"end":124.95,"text":"Jeg elsker å trene ute. Om våren, sommeren og høsten pleier jeg å løpe og sykle, og om vinteren pleier jeg å gå på ski.","zh":"我热爱在户外锻炼。春天、夏天和秋天我通常跑步、骑自行车，冬天我通常去滑雪。","words":[[0,3,111.31,111.5,"jeg"],[4,10,111.5,112.4,"elsker"],[11,12,112.4,112.52,"å~0583da7a620a"],[13,18,112.52,112.92,"trene"],[19,22,112.92,113.22,"ute"],[24,26,113.22,113.82,"om~0f47c1b5a328"],[27,32,113.82,115.2,"våren"],[34,42,115.8,116.62,"sommeren"],[43,45,116.62,117.0,"og"],[46,52,117.0,117.38,"høsten"],[53,59,118.18,118.7,"pleier"],[60,63,118.7,118.9,"jeg"],[64,65,118.9,119.16,"å~0583da7a620a"],[66,70,119.16,119.6,"løpe"],[71,73,119.6,120.14,"og"],[74,79,120.14,120.52,"sykle"],[81,83,121.52,121.94,"og"],[84,86,121.94,122.16,"om~1e753acc270b"],[87,95,122.16,122.86,"vinteren"],[96,102,122.86,123.64,"pleier"],[103,106,123.64,123.82,"jeg"],[107,108,123.82,124.14,"å~0583da7a620a"],[109,111,124.14,124.3,"gå"],[112,114,124.3,124.48,"på~8a7f538934a2"],[115,118,124.48,124.87,"ski"]]},{"id":26,"start":126.2,"end":128.8,"text":"Nordmenn er født med ski på beina.","zh":"挪威人生来脚上就踩着滑雪板。","words":[[0,8,126.28,126.84,"nordmenn"],[9,11,126.84,127.12,"er"],[12,16,127.12,127.54,"født"],[17,20,127.54,127.78,"med"],[21,24,127.78,128.08,"ski"],[25,27,128.08,128.28,"på"],[28,33,128.28,128.72,"beina"]]},{"id":27,"start":133.01,"end":133.72,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,133.09,133.64,"fakta"]]},{"id":28,"start":134.89,"end":136.61,"text":"Nordmenn i utlandet","subheading":true,"zh":"在国外的挪威人","words":[[0,8,134.97,135.48,"nordmenn"],[9,10,135.48,135.78,"i"],[11,19,135.78,136.53,"utlandet"]]},{"id":29,"start":137.96,"end":141.64,"text":"Det bor over 35 000 nordmenn i Sverige.","zh":"有超过35 000名挪威人住在瑞典。","words":[[0,3,138.04,138.18,"det"],[4,7,138.18,138.44,"bor"],[8,12,138.44,138.96,"over"],[13,15,138.96,140.26,"35"],[16,19,138.96,140.26,"000~b0055c9cddec"],[20,28,140.26,140.76,"nordmenn"],[29,30,140.76,141.02,"i"],[31,38,141.02,141.56,"sverige"]]},{"id":30,"start":142.96,"end":147