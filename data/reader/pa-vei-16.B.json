{"id":"pa-vei-16.B","bookId":"pa-vei-textbook","readingId":"16.B","title":"Skolen i Norge · Timeplan","audio":"audio/pa-vei/16.B.mp3","duration":151.896,"synthetic":false,"audioLabel":"课表录音讲解 · 文字按录音整理","sentences":[{"id":0,"start":1.24,"end":3.385,"text":"Timeplan for klasse 3B.","zh":"三年级 B 班课程表。","words":[[0,8,1.24,2.045,"timeplan"],[9,12,2.28,2.445,"for"],[13,19,2.46,2.805,"klasse"],[20,22,2.86,3.385,"3b"]]},{"id":1,"start":4.84,"end":6.585,"text":"Elev: Jasmin.","zh":"学生：亚斯明。","words":[[0,4,4.84,5.345,"elev"],[6,12,5.98,6.585,"jasmin"]]},{"id":2,"start":9.2,"end":12.545,"text":"Første time starter kvart over åtte hver dag.","zh":"每天第一节课八点十五分开始。","words":[[0,6,9.2,9.625,"første"],[7,11,9.66,10.065,"time@pa-vei-extra-116"],[12,19,10.44,10.865,"starter"],[20,25,10.92,11.345,"kvart"],[26,30,11.4,11.645,"over"],[31,35,11.68,12.045,"åtte"],[36,40,12.06,12.293,"hver"],[41,44,12.293,12.545,"dag"]]},{"id":3,"start":13.872,"end":16.537,"text":"Alle timene varer i 45 minutter.","zh":"每节课四十五分钟。","words":[[0,4,13.872,14.137,"alle"],[5,11,14.192,14.637,"timene@pa-vei-extra-110"],[12,17,14.692,15.117,"varer"],[18,19,15.272,15.397,"i"],[20,22,15.432,16.017,"45"],[23,31,16.052,16.537,"minutter"]]},{"id":4,"start":18.132,"end":23.197,"text":"Jasmin har fem timer hver dag, og hun slutter på skolen klokka ett.","zh":"亚斯明每天上五节课，下午一点放学。","words":[[0,6,18.132,18.715,"jasmin"],[7,10,18.715,18.897,"har"],[11,14,18.992,19.237,"fem"],[15,20,19.392,19.797,"timer@pa-vei-extra-119"],[21,25,19.812,20.044,"hver"],[26,29,20.044,20.337,"dag"],[31,33,21.092,21.224,"og"],[34,37,21.224,21.377,"hun"],[38,45,21.412,21.874,"slutter"],[46,48,21.874,21.997,"på"],[49,55,22.012,22.457,"skolen"],[56,62,22.492,22.777,"klokka"],[63,66,22.852,23.197,"ett"]]},{"id":5,"start":24.692,"end":27.597,"text":"Men på fredag slutter hun en time tidligere.","zh":"不过，星期五她提前一节课放学。","words":[[0,3,24.692,24.857,"men"],[4,6,24.872,24.997,"på"],[7,13,25.072,25.657,"fredag"],[14,21,25.992,26.374,"slutter"],[22,25,26.374,26.517,"hun"],[26,28,26.592,26.817,"en"],[29,33,26.832,27.095,"time@pa-vei-extra-120"],[34,43,27.095,27.597,"tidligere"]]},{"id":6,"start":28.752,"end":32.297,"text":"Da er hun ferdig på skolen allerede kvart over tolv.","zh":"那天她十二点十五分就放学了。","words":[[0,2,28.752,28.897,"da"],[3,5,28.992,29.125,"er"],[6,9,29.125,29.277,"hun"],[10,16,29.332,29.704,"ferdig"],[17,19,29.704,29.837,"på"],[20,26,29.852,30.277,"skolen"],[27,35,30.792,31.237,"allerede"],[36,41,31.292,31.677,"kvart"],[42,46,31.732,31.974,"over"],[47,51,31.974,32.297,"tolv"]]},{"id":7,"start":34.472,"end":40.137,"text":"På mandag har hun norsk i to timer, og så har hun en time engelsk.","zh":"星期一，她先上两节挪威语课，然后上一节英语课。","words":[[0,2,34.472,34.617,"på"],[3,9,34.672,35.237,"mandag"],[10,13,35.392,35.575,"har"],[14,17,35.575,35.717,"hun"],[18,23,35.752,36.217,"norsk"],[24,25,36.292,36.417,"i"],[26,28,36.432,36.597,"to"],[29,34,36.672,37.037,"timer@pa-vei-extra-123"],[36,38,37.992,38.137,"og"],[39,41,38.232,38.377,"så"],[42,45,38.532,38.725,"har"],[46,49,38.725,38.877,"hun"],[50,52,38.952,39.197,"en"],[53,57,39.232,39.557,"time@pa-vei-extra-124"],[58,65,39.592,40.137,"engelsk"]]},{"id":8,"start":41.792,"end":45.517,"text":"Så kommer storefri, som varer i 50 minutter.","zh":"接着是五十分钟的大课间。","words":[[0,2,41.792,41.937,"så"],[3,9,41.992,42.297,"kommer"],[10,18,42.332,42.877,"storefri"],[20,23,43.852,44.037,"som"],[24,29,44.052,44.424,"varer"],[30,31,44.424,44.517,"i"],[32,34,44.572,45.037,"50"],[35,43,45.052,45.517,"minutter"]]},{"id":9,"start":47.252,"end":53.457,"text":"Da skal elevene spise, og de har mer tid til å leke enn i de andre friminuttene.","zh":"学生们这时吃饭，而且比其他课间有更多时间玩耍。","words":[[0,2,47.252,47.397,"da"],[3,7,47.492,47.737,"skal"],[8,15,47.772,48.337,"elevene"],[16,21,48.392,48.877,"spise"],[23,25,49.932,50.055,"og"],[26,28,50.055,50.175,"de"],[29,32,50.175,50.357,"har"],[33,36,50.372,50.637,"mer"],[37,40,50.692,50.957,"tid"],[41,44,50.972,51.135,"til"],[45,46,51.135,51.255,"å"],[47,51,51.255,51.717,"leke"],[52,55,52.052,52.225,"enn"],[56,57,52.225,52.294,"i"],[58,60,52.294,52.417,"de"],[61,66,52.432,52.757,"andre"],[67,79,52.772,53.457,"friminuttene"]]},{"id":10,"start":55.592,"end":62.477,"text":"Etter storefri har Jasmin RLE, det vil si religion, livssyn og etikk.","zh":"大课间后，亚斯明上 RLE 课，也就是宗教、人生观和伦理课。","words":[[0,5,55.592,55.997,"etter"],[6,14,56.012,56.597,"storefri"],[15,18,56.972,57.215,"har"],[19,25,57.215,57.797,"jasmin"],[26,29,58.052,58.597,"rle"],[31,34,59.412,59.544,"det"],[35,38,59.544,59.697,"vil"],[39,41,59.772,59.937,"si"],[42,50,60.172,60.777,"religion"],[52,59,61.132,61.717,"livssyn"],[60,62,61.912,62.025,"og"],[63,68,62.025,62.477,"etikk"]]},{"id":11,"start":63.772,"end":66.217,"text":"Den siste timen på mandag er musikk.","zh":"星期一最后一节是音乐课。","words":[[0,3,63.772,63.957,"den@pa-vei-den-definite"],[4,9,64.012,64.377,"siste"],[10,15,64.392,64.755,"timen@pa-vei-extra-112"],[16,18,64.755,64.894,"på"],[19,25,64.894,65.377,"mandag"],[26,28,65.572,65.734,"er"],[29,35,65.734,66.217,"musikk"]]},{"id":12,"start":68.752,"end":76.077,"text":"På tirsdag har hun matematikk, RLE, to timer norsk, og siste time er gym.","zh":"星期二，她上数学、RLE、两节挪威语课，最后一节是体育。","words":[[0,2,68.752,68.897,"på"],[3,10,68.932,69.497,"tirsdag"],[11,14,69.512,69.704,"har"],[15,18,69.704,69.855,"hun"],[19,29,69.855,70.577,"matematikk"],[31,34,71.252,71.797,"rle"],[36,38,72.812,72.957,"to"],[39,44,73.052,73.357,"timer@pa-vei-extra-127"],[45,50,73.372,73.777,"norsk@pa-vei-norsk-adjective"],[52,54,74.532,74.677,"og"],[55,60,74.692,75.114,"siste"],[61,65,75.114,75.497,"time@pa-vei-extra-128"],[66,68,75.672,75.817,"er"],[69,72,75.852,76.077,"gym"]]},{"id":13,"start":77.932,"end":86.837,"text":"På onsdag har hun også matematikk i første time, så samfunnsfag, og i tredje og fjerde time har hun kunst og håndverk.","zh":"星期三，第一节也是数学，然后是社会课；第三、第四节是美术与手工课。","words":[[0,2,77.932,78.077,"på"],[3,9,78.172,78.674,"onsdag"],[10,13,78.674,78.834,"har"],[14,17,78.834,78.977,"hun"],[18,22,78.992,79.315,"også"],[23,33,79.315,79.994,"matematikk"],[34,35,79.994,80.095,"i"],[36,42,80.095,80.465,"første"],[43,47,80.465,80.777,"time@pa-vei-extra-125"],[49,51,81.832,81.977,"så"],[52,63,82.032,82.797,"samfunnsfag"],[65,67,83.632,83.757,"og"],[68,69,83.772,83.877,"i"],[70,76,83.912,84.417,"tredje"],[77,79,84.452,84.595,"og"],[80,86,84.595,85.017,"fjerde"],[87,91,85.032,85.397,"time@pa-vei-extra-126"],[92,95,85.412,85.555,"har"],[96,99,85.555,85.697,"hun"],[100,105,85.772,86.225,"kunst"],[106,108,86.225,86.314,"og"],[109,117,86.314,86.837,"håndverk"]]},{"id":14,"start":88.632,"end":91.617,"text":"Den siste timen på onsdag er norsk og IKT.","zh":"星期三最后一节是挪威语和信息通信技术课。","words":[[0,3,88.632,88.797,"den@pa-vei-den-definite"],[4,9,88.872,89.297,"siste"],[10,15,89.312,89.715,"timen@pa-vei-extra-113"],[16,18,89.715,89.857,"på"],[19,25,89.932,90.457,"onsdag"],[26,28,90.492,90.635,"er"],[29,34,90.635,91.054,"norsk@pa-vei-norsk-adjective"],[35,37,91.054,91.197,"og"],[38,41,91.212,91.617,"ikt"]]},{"id":15,"start":93.232,"end":97.497,"text":"IKT betyr informasjons- og kommunikasjonsteknologi.","zh":"IKT 表示信息与通信技术。","words":[[0,3,93.232,93.657,"ikt"],[4,9,94.152,94.577,"betyr"],[10,22,94.692,95.697,"informasjons"],[24,26,95.732,95.857,"og"],[27,50,95.872,97.497,"kommunikasjonsteknologi"]]},{"id":16,"start":100.332,"end":102.957,"text":"På torsdag er første time samfunnsfag.","zh":"星期四第一节是社会课。","words":[[0,2,100.332,100.477,"på"],[3,10,100.552,101.137,"torsdag"],[11,13,101.192,101.337,"er"],[14,20,101.372,101.734,"første"],[21,25,101.734,102.077,"time@pa-vei-extra-129"],[26,37,102.112,102.957,"samfunnsfag"]]},{"id":17,"start":103.952,"end":109.697,"text":"Så kommer en time norsk, og i tredje time er det matematikk og IKT sammen.","zh":"然后是一节挪威语课，第三节把数学和信息通信技术结合起来上。","words":[[0,2,103.952,104.117,"så"],[3,9,104.172,104.484,"kommer"],[10,12,104.484,104.614,"en"],[13,17,104.614,104.937,"time@pa-vei-extra-130"],[18,23,104.952,105.377,"norsk"],[25,27,106.012,106.144,"og"],[28,29,106.144,106.234,"i"],[30,36,106.234,106.674,"tredje"],[37,41,106.674,107.037,"time@pa-vei-extra-131"],[42,44,107.132,107.255,"er"],[45,48,107.255,107.385,"det"],[49,59,107.385,108.157,"matematikk"],[60,62,108.412,108.537,"og"],[63,66,108.632,109.097,"ikt"],[67,73,109.312,109.697,"sammen"]]},{"id":18,"start":111.572,"end":116.237,"text":"Etter storefri har hun naturfag, og i siste time er det gym.","zh":"大课间后是自然科学课，最后一节是体育。","words":[[0,5,111.572,111.937,"etter"],[6,14,111.992,112.597,"storefri"],[15,18,112.692,112.885,"har"],[19,22,112.885,113.014,"hun"],[23,31,113.014,113.797,"naturfag"],[33,35,114.612,114.734,"og"],[36,37,114.734,114.837,"i"],[38,43,114.892,115.297,"siste"],[44,48,115.312,115.677,"time@pa-vei-extra-114"],[49,51,115.752,115.874,"er"],[52,55,115.874,115.997,"det"],[56,59,116.012,116.237,"gym"]]},{"id":19,"start":118.632,"end":127.157,"text":"På fredag har klassen matematikk i første time, så har de norsk, og i tredje time har de lesetime.","zh":"星期五，班上第一节上数学，接着是挪威语，第三节是阅读课。","words":[[0,2,118.632,118.757,"på"],[3,9,118.852,119.497,"fredag"],[10,13,119.772,119.937,"har"],[14,21,119.952,120.334,"klassen"],[22,32,120.334,121.075,"matematikk"],[33,34,121.075,121.165,"i"],[35,41,121.165,121.494,"første"],[42,46,121.494,121.797,"time@pa-vei-extra-121"],[48,50,122.952,123.117,"så"],[51,54,123.132,123.275,"har"],[55,57,123.275,123.397,"de"],[58,63,123.412,123.857,"norsk"],[65,67,124.712,124.834,"og"],[68,69,124.834,124.937,"i"],[70,76,124.972,125.397,"tredje"],[77,81,125.412,125.757,"time@pa-vei-extra-122"],[82,85,126.092,126.245,"har"],[86,88,126.245,126.357,"de"],[89,97,126.432,127.157,"lesetime"]]},{"id":20,"start":128.512,"end":137.217,"text":"Da leser de enten en bok sammen i klassen og snakker om den, eller læreren bestemmer at alle får lese hver sin bok.","zh":"那时他们要么全班一起读一本书并加以讨论，要么由老师决定让每个人各读一本书。","words":[[0,2,128.512,128.657,"da"],[3,8,128.752,129.154,"leser"],[9,11,129.154,129.277,"de"],[12,17,129.372,129.897,"enten"],[18,20,130.212,130.377,"en"],[21,24,130.412,130.797,"