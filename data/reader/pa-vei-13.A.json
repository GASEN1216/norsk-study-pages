{"id":"pa-vei-13.A","bookId":"pa-vei-textbook","readingId":"13.A","title":"Kollektiv eller egen leilighet?","audio":"audio/pa-vei/13.A.mp3","duration":92.4,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.9,"end":3.025,"text":"Hans-Olav studerer i Bergen.","zh":"汉斯·奥拉夫在卑尔根读书。","words":[[0,9,0.9,1.805,"hans-olav"],[10,18,1.86,2.473,"studerer"],[19,20,2.473,2.565,"i"],[21,27,2.58,3.025,"bergen"]]},{"id":1,"start":4.66,"end":8.725,"text":"Han bor sammen med fire andre studenter i et kollektiv.","zh":"他和另外四名学生合租。","words":[[0,3,4.66,4.845,"han"],[4,7,4.92,5.205,"bor"],[8,14,5.28,5.643,"sammen"],[15,18,5.643,5.785,"med"],[19,23,5.86,6.285,"fire"],[24,29,6.38,6.745,"andre"],[30,39,6.76,7.365,"studenter"],[40,41,7.88,7.985,"i"],[42,44,8.0,8.152,"et"],[45,54,8.152,8.725,"kollektiv"]]},{"id":2,"start":10.296,"end":14.681,"text":"Til sammen betaler de 25 000 kroner i leie per måned.","zh":"他们每月一共支付 25 000 克朗房租。","words":[[0,3,10.296,10.481,"til"],[4,10,10.576,11.021,"sammen"],[11,18,11.036,11.549,"betaler"],[19,21,11.549,11.661,"de"],[22,28,11.756,12.941,"25 000"],[29,35,12.976,13.481,"kroner"],[36,37,13.536,13.649,"i"],[38,42,13.649,14.001,"leie@pa-vei-leie-rent"],[43,46,14.036,14.261,"per@pa-vei-per-each"],[47,52,14.296,14.681,"måned"]]},{"id":3,"start":16.576,"end":19.781,"text":"Leiligheten er stor og ligger ganske sentralt.","zh":"公寓很大，位置也相当靠近市中心。","words":[[0,11,16.576,17.288,"leiligheten"],[12,14,17.288,17.421,"er"],[15,19,17.456,17.841,"stor"],[20,22,18.296,18.419,"og"],[23,29,18.419,18.761,"ligger"],[30,36,18.776,19.178,"ganske"],[37,45,19.178,19.781,"sentralt"]]},{"id":4,"start":21.396,"end":25.981,"text":"Den har fem soverom, men bare ett kjøkken og ett bad.","zh":"公寓有五间卧室，但只有一间厨房和一间浴室。","words":[[0,3,21.396,21.549,"den"],[4,7,21.549,21.721,"har"],[8,11,21.796,22.041,"fem"],[12,19,22.196,22.681,"soverom"],[21,24,23.716,23.901,"men"],[25,29,23.916,24.141,"bare"],[30,33,24.216,24.481,"ett"],[34,41,24.496,24.921,"kjøkken"],[42,44,25.236,25.381,"og"],[45,48,25.396,25.621,"ett"],[49,52,25.636,25.981,"bad"]]},{"id":5,"start":27.596,"end":30.801,"text":"Hans-Olav betaler 1/5 av leia.","zh":"汉斯·奥拉夫支付五分之一的房租。","words":[[0,9,27.596,28.381,"hans-olav"],[10,17,28.396,29.041,"betaler"],[18,21,29.236,30.281,"1/5"],[22,24,30.376,30.519,"av"],[25,29,30.519,30.801,"leia"]]},{"id":6,"start":32.236,"end":36.561,"text":"Han synes husleia er for høy og har lyst til å flytte for seg selv.","zh":"他觉得房租太高，想搬出去自己住。","words":[[0,3,32.236,32.401,"han"],[4,9,32.456,32.838,"synes"],[10,17,32.838,33.481,"husleia"],[18,20,33.516,33.668,"er"],[21,24,33.668,33.841,"for@pa-vei-for-excess"],[25,28,33.876,34.121,"høy"],[29,31,34.816,34.948,"og"],[32,35,34.948,35.088,"har"],[36,40,35.088,35.329,"lyst@pa-vei-lyst-desire"],[41,44,35.329,35.469,"til"],[45,46,35.469,35.558,"å"],[47,53,35.558,35.909,"flytte"],[54,57,35.909,36.069,"for"],[58,61,36.069,36.241,"seg"],[62,66,36.276,36.561,"selv"]]},{"id":7,"start":38.096,"end":42.341,"text":"Han snakker med Asgeir, en av de andre studentene i kollektivet.","zh":"他和室友阿斯盖尔聊起这件事。","words":[[0,3,38.096,38.261,"han"],[4,11,38.296,38.648,"snakker"],[12,15,38.648,38.799,"med"],[16,22,38.799,39.301,"asgeir"],[24,26,40.096,40.269,"en@pa-vei-en-one"],[27,29,40.269,40.379,"av"],[30,32,40.379,40.481,"de@pa-vei-de-definite"],[33,38,40.536,40.881,"andre"],[39,49,40.896,41.581,"studentene"],[50,51,41.656,41.748,"i"],[52,63,41.748,42.341,"kollektivet"]]},{"id":8,"start":44.496,"end":45.341,"text":"Vil du flytte?","zh":"你想搬家吗？","words":[[0,3,44.496,44.659,"vil"],[4,6,44.659,44.801,"du"],[7,13,44.816,45.341,"flytte"]],"speaker":"Asgeir"},{"id":9,"start":46.476,"end":49.021,"text":"Ja, jeg har lyst til å bo for meg selv.","zh":"是的，我想自己住。","words":[[0,2,46.476,46.621,"ja"],[4,7,47.296,47.448,"jeg"],[8,11,47.448,47.578,"har"],[12,16,47.578,47.838,"lyst@pa-vei-lyst-desire"],[17,20,47.838,47.978,"til"],[21,22,47.978,48.081,"å"],[23,25,48.096,48.241,"bo"],[26,29,48.356,48.538,"for"],[30,33,48.538,48.701,"meg"],[34,38,48.736,49.021,"selv"]],"speaker":"Hans-Olav"},{"id":10,"start":50.136,"end":50.661,"text":"Hvorfor det?","zh":"为什么？","words":[[0,7,50.136,50.519,"hvorfor"],[8,11,50.519,50.661,"det"]],"speaker":"Asgeir"},{"id":11,"start":51.976,"end":56.861,"text":"For det første er det ganske dyrt å bo her, og for det andre er det for mye bråk.","zh":"首先，住在这里相当贵；其次，这里太吵了。","words":[[0,3,51.976,52.118,"for"],[4,7,52.118,52.239,"det@pa-vei-det-definite"],[8,14,52.239,52.561,"første"],[15,17,52.576,52.689,"er"],[18,21,52.689,52.808,"det"],[22,28,52.808,53.221,"ganske"],[29,33,53.256,53.609,"dyrt"],[34,35,53.609,53.698,"å"],[36,38,53.698,53.841,"bo"],[39,42,53.956,54.161,"her"],[44,46,55.176,55.279,"og"],[47,50,55.279,55.389,"for"],[51,54,55.389,55.508,"det@pa-vei-det-definite"],[55,60,55.508,55.779,"andre@pa-vei-andre-second"],[61,63,55.779,55.898,"er"],[64,67,55.898,56.028,"det"],[68,71,56.028,56.168,"for@pa-vei-for-excess"],[72,75,56.168,56.398,"mye"],[76,80,56.398,56.861,"bråk"]],"speaker":"Hans-Olav"},{"id":12,"start":57.656,"end":59.561,"text":"Jeg MÅ klare eksamen nå i vår.","zh":"我今年春天必须通过考试。","words":[[0,3,57.656,57.841,"jeg"],[4,6,57.876,58.001,"må"],[7,12,58.176,58.549,"klare"],[13,20,58.549,59.078,"eksamen"],[21,23,59.078,59.218,"nå"],[24,25,59.218,59.308,"i"],[26,29,59.308,59.561,"vår@pa-vei-vår-spring"]],"speaker":"Hans-Olav"},{"id":13,"start":60.736,"end":63.141,"text":"Vil du kjøpe noe, eller vil du leie?","zh":"你想买房还是租房？","words":[[0,3,60.736,60.898,"vil"],[4,6,60.898,61.021,"du"],[7,12,61.056,61.508,"kjøpe"],[13,16,61.508,61.761,"noe"],[18,23,62.256,62.478,"eller"],[24,27,62.478,62.621,"vil"],[28,30,62.636,62.781,"du"],[31,35,62.796,63.141,"leie"]],"speaker":"Asgeir"},{"id":14,"start":64.736,"end":65.481,"text":"Hva tror du?","zh":"你觉得呢？","words":[[0,3,64.736,64.901,"hva"],[4,8,64.956,65.339,"tror"],[9,11,65.339,65.481,"du"]],"speaker":"Hans-Olav"},{"id":15,"start":66.596,"end":69.001,"text":"Jeg har ikke råd til å kjøpe en leilighet.","zh":"我买不起公寓。","words":[[0,3,66.596,66.749,"jeg"],[4,7,66.749,66.899,"har"],[8,12,66.899,67.108,"ikke"],[13,16,67.108,67.341,"råd"],[17,20,67.356,67.521,"til"],[21,22,67.536,67.641,"å"],[23,28,67.816,68.328,"kjøpe"],[29,31,68.328,68.448,"en"],[32,41,68.448,69.001,"leilighet"]],"speaker":"Hans-Olav"},{"id":16,"start":70.436,"end":71.801,"text":"Har du sett noe du liker?","zh":"你看到喜欢的房子了吗？","words":[[0,3,70.436,70.608,"har"],[4,6,70.608,70.721,"du"],[7,11,70.776,71.078,"sett"],[12,15,71.078,71.288,"noe"],[16,18,71.288,71.421,"du"],[19,24,71.436,71.801,"liker"]],"speaker":"Asgeir"},{"id":17,"start":72.836,"end":79.461,"text":"Jeg så en annonse i går på en 1-roms leilighet. 5600,- i måneden.","zh":"我昨天看到一则单间公寓的广告，每月 5600 克朗。","words":[[0,3,72.836,73.001,"jeg"],[4,6,73.036,73.201,"så@pa-vei-så-saw"],[7,9,73.236,73.358,"en"],[10,17,73.358,73.828,"annonse"],[18,19,73.828,73.928,"i"],[20,23,73.928,74.241,"går"],[24,26,74.816,74.939,"på"],[27,29,74.939,75.081,"en"],[30,36,75.236,75.798,"1-roms"],[37,46,75.798,76.361,"leilighet"],[48,52,77.656,78.868,"5600"],[55,56,78.868,78.948,"i"],[57,64,78.948,79.461,"måneden"]],"speaker":"Hans-Olav"},{"id":18,"start":80.896,"end":82.441,"text":"Det er mer enn du betaler her.","zh":"这比你在这里付的还多。","words":[[0,3,80.896,81.081,"det"],[4,6,81.096,81.228,"er"],[7,10,81.228,81.448,"mer"],[11,14,81.448,81.599,"enn"],[15,17,81.599,81.719,"du"],[18,25,81.719,82.198,"betaler"],[26,29,82.198,82.441,"her"]],"speaker":"Asgeir"},{"id":19,"start":83.616,"end":87.201,"text":"Jeg vet det, men da slipper jeg å dele badet med andre.","zh":"我知道，不过那样就不用和别人共用浴室了。","words":[[0,3,83.616,83.769,"jeg"],[4,7,83.769,84.048,"vet"],[8,11,84.048,84.201,"det"],[13,16,85.236,85.368,"men"],[17,19,85.368,85.481,"da"],[20,27,85.516,85.838,"slipper"],[28,31,85.838,85.948,"jeg"],[32,33,85.948,86.048,"å"],[34,38,86.048,86.298,"dele"],[39,44,86.298,86.678,"badet"],[45,48,86.678,86.801,"med"],[49,54,86.816,87.201,"andre"]],"speaker":"Hans-Olav"},{"id":20,"start":88.076,"end":90.901,"text":"Fint. Da kommer jeg og dusjer hos deg!","zh":"好啊。那我就去你那里洗澡！","words":[[0,4,88.076,88.421,"fint"],[6,8,89.236,89.381,"da"],[9,15,89.476,89.799,"kommer"],[16,19,89.799,89.959,"jeg"],[20,22,89.959,90.101,"og"],[23,29,90.116,90.529,"dusjer"],[30,33,90.529,90.709,"hos"],[34,37,90.709,90.901,"deg"]],"speaker":"Asgeir"}],"lexicon":{"1-roms":{"lemma":"ettroms","pos":"形容词","zh":"单间的；一居室的","ref":null,"clip":null},"1/5":{"lemma":"1/5","pos":"分数","zh":"五分之一","ref":null,"clip":null},"25 000":{"lemma":"25 000","pos":"数词","zh":"二万五千","ref":null,"clip":null},"5600":{"lemma":"5600","pos":"数词","zh":"数字 5600","ref":null,"clip":null},"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"andre@pa-vei-andre-second":{"lemma":"annen","pos":"序数词","zh":"第二条","ref":null,"clip":null,"contextual":true,"baseKey":"andre","surface":"andre"},"annonse":{"lemma":"annonse","zh":"广告","pos":"名词","ref":"pa-vei-13-020","clip":null},"asgeir":{"lemma":"Asgeir","pos":"专名","zh":"阿斯盖尔（人名）","ref":null,"clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"bad":{"lemma":"bad","zh":"浴室","pos":"名词","ref":"ty-conversation-9-003","clip":null},"badet":{"lemma":"bad","pos":"名词","form":"单数定指","zh":"浴室；卫生间（bad 的定指）","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"betaler":{"lemma":"betale","zh":"付款","pos":"动词","ref":"ty-conversation-9-004","clip":null,"form":"现在时"},"bo":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"不定式","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"bråk":{"lemma":"bråk","zh":"吵闹；噪音","pos":"名词","ref":"pa-vei-13-016","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"de@pa-vei-de-definite":{"lemma":"de","pos":"定冠词","zh":"这些；