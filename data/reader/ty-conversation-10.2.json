{"id":"ty-conversation-10.2","bookId":"ty-conversation-guide","readingId":"10.2","title":"Going home","audio":"audio/ty-conversation/10.2.mp3","duration":50.599184,"synthetic":false,"sentences":[{"id":0,"start":16.83,"end":18.535,"speaker":"Kari","text":"Hallo, Kari her.","zh":"喂，我是卡里。","words":[[0,5,16.83,17.135,"hallo"],[7,11,17.73,18.135,"kari"],[12,15,18.25,18.535,"her"]]},{"id":1,"start":18.65,"end":20.555,"speaker":"Olav","text":"Hei Kari! Dette er Olav.","zh":"你好，卡里！我是奥拉夫。","words":[[0,3,18.65,18.855,"hei"],[4,8,18.89,19.215,"kari"],[10,15,19.85,20.102,"dette@ty-dette-phone"],[16,18,20.102,20.223,"er@ty-be-identity"],[19,23,20.223,20.555,"olav"]]},{"id":2,"start":21.09,"end":23.455,"speaker":"Kari","text":"Hei Olav! Takk for sist!","zh":"你好，奥拉夫！上次见面很愉快！","words":[[0,3,21.09,21.395,"hei"],[4,8,21.53,22.035,"olav"],[10,14,22.57,22.833,"takk"],[15,18,22.833,22.992,"for@ty-for-thanks"],[19,23,22.992,23.455,"sist"]]},{"id":3,"start":23.83,"end":25.035,"speaker":"Olav","text":"Det var en hyggelig lunsj.","zh":"那顿午餐吃得很愉快。","words":[[0,3,23.83,23.972,"det@ty-det-lunch"],[4,7,23.972,24.142,"var"],[8,10,24.142,24.252,"en"],[11,19,24.252,24.642,"hyggelig"],[20,25,24.642,25.035,"lunsj"]]},{"id":4,"start":26.03,"end":29.415,"speaker":"Kari","text":"Og en fin restaurant. Hvordan har du det?","zh":"餐馆也很不错。你最近怎么样？","words":[[0,2,26.03,26.175,"og"],[3,5,26.21,26.355,"en"],[6,9,26.45,26.755,"fin"],[10,20,26.77,27.375,"restaurant"],[22,29,28.47,28.835,"hvordan"],[30,33,28.91,29.122,"har@ty-have-wellbeing"],[34,36,29.122,29.242,"du"],[37,40,29.242,29.415,"det@ty-det-wellbeing"]]},{"id":5,"start":29.61,"end":32.375,"speaker":"Olav","text":"Fint. Men jeg skal reise i morgen tidlig.","zh":"很好。不过我明天一早就要走了。","words":[[0,4,29.61,29.955,"fint@ty-fint-wellbeing"],[6,9,30.93,31.115,"men"],[10,13,31.15,31.273,"jeg"],[14,18,31.273,31.432,"skal"],[19,24,31.432,31.782,"reise"],[25,26,31.782,31.852,"i@ty-time"],[27,33,31.852,32.052,"morgen"],[34,40,32.052,32.375,"tidlig@ty-early-morning"]]},{"id":6,"start":32.81,"end":34.095,"speaker":"Kari","text":"Er ferien over?","zh":"假期结束了吗？","words":[[0,2,32.81,33.035,"er@ty-be-description"],[3,9,33.13,33.575,"ferien"],[10,14,33.65,34.095,"over@ty-over-ended"]]},{"id":7,"start":34.65,"end":38.315,"speaker":"Olav","text":"Ja. Jeg reiser til Bodø. Det er en jobb for avisen.","zh":"是的。我去博德，是为报社出差。","words":[[0,2,34.65,34.795,"ja"],[4,7,35.37,35.555,"jeg"],[8,14,35.57,35.903,"reiser"],[15,18,35.903,36.032,"til"],[19,23,36.032,36.355,"bodø"],[25,28,37.31,37.453,"det@ty-det-task"],[29,31,37.453,37.532,"er@ty-be-identity"],[32,34,37.532,37.633,"en"],[35,39,37.633,37.823,"jobb"],[40,43,37.823,37.953,"for@ty-for-paper-work"],[44,50,37.953,38.315,"avisen"]]},{"id":8,"start":38.93,"end":39.735,"speaker":"Kari","text":"Reiser du med fly?","zh":"你坐飞机去吗？","words":[[0,6,38.93,39.273,"reiser"],[7,9,39.273,39.382,"du"],[10,13,39.382,39.532,"med@ty-with-vehicle"],[14,17,39.532,39.735,"fly"]]},{"id":9,"start":40.21,"end":42.115,"speaker":"Olav","text":"Ja, flyet går klokken halv åtte.","zh":"是的，飞机七点半起飞。","words":[[0,2,40.21,40.355,"ja"],[4,9,40.71,41.022,"flyet"],[10,13,41.022,41.255,"går@ty-flight-departure"],[14,21,41.29,41.615,"klokken"],[22,26,41.63,41.862,"halv"],[27,31,41.862,42.115,"åtte"]]},{"id":10,"start":42.65,"end":44.435,"speaker":"Kari","text":"Jeg vil gjerne treffe deg igjen.","zh":"我想再见到你。","words":[[0,3,42.65,42.875,"jeg"],[4,7,42.89,43.095,"vil"],[8,14,43.17,43.535,"gjerne"],[15,21,43.61,43.953,"treffe"],[22,25,43.953,44.135,"deg"],[26,31,44.15,44.435,"igjen"]]},{"id":11,"start":45.01,"end":47.135,"speaker":"Olav","text":"Jeg også. Jeg skal ringe til deg.","zh":"我也是。我会给你打电话。","words":[[0,3,45.01,45.255,"jeg"],[4,8,45.43,45.735,"også"],[10,13,46.21,46.362,"jeg"],[14,18,46.362,46.532,"skal"],[19,24,46.532,46.812,"ringe"],[25,28,46.812,46.953,"til@ty-telephone-to"],[29,32,46.953,47.135,"deg"]]},{"id":12,"start":47.57,"end":48.615,"speaker":"Kari","text":"Ha det bra, Olav!","zh":"再见，奥拉夫！","words":[[0,2,47.57,47.715,"ha@ty-farewell-ha"],[3,6,47.75,47.903,"det@ty-farewell-det"],[7,10,47.903,48.075,"bra@ty-farewell-bra"],[12,16,48.15,48.615,"olav"]]},{"id":13,"start":49.03,"end":49.635,"speaker":"Olav","text":"Hei hei, Kari!","zh":"再见，卡里！","words":[[0,3,49.03,49.192,"hei@ty-farewell-hei"],[4,7,49.192,49.355,"hei@ty-farewell-hei"],[9,13,49.37,49.635,"kari"]]}],"lexicon":{"avisen":{"lemma":"avis","zh":"报社（指为报社做的工作）","pos":"名词","ref":"ty-conversation-4-001","clip":null,"form":"单数定指"},"bodø":{"lemma":"Bodø","zh":"博德（挪威城市）","pos":"专名","ref":null,"clip":null},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"bra@ty-farewell-bra":{"lemma":"bra","zh":"好（Ha det bra!：再见）","pos":"副词","ref":"pa-vei-2-018","clip":null,"contextual":true,"baseKey":"bra","surface":"bra"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-lunch":{"lemma":"det","zh":"那（指上次一起吃午饭的经历）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-det-task":{"lemma":"det","zh":"这（指去博德的行程）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-det-wellbeing":{"lemma":"det","zh":"（Hvordan har du det?）问候近况用语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-farewell-det":{"lemma":"det","zh":"（Ha det bra!）道别语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性"},"dette@ty-dette-phone":{"lemma":"dette","zh":"（Dette er Olav.）电话里介绍自己：我是奥拉夫","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性","contextual":true,"baseKey":"dette","surface":"dette"},"