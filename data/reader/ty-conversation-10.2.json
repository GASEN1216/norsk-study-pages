{"id":"ty-conversation-10.2","bookId":"ty-conversation-guide","readingId":"10.2","title":"Going home","audio":"audio/ty-conversation/10.2.mp3","duration":50.599184,"synthetic":false,"sentences":[{"id":0,"start":16.5,"end":18.5,"speaker":"Kari","text":"Hallo, Kari her.","zh":"喂，我是卡里。","words":[[0,5,16.5,17.16,"hallo"],[7,11,17.64,18.12,"kari"],[12,15,18.12,18.5,"her"]]},{"id":1,"start":18.66,"end":20.52,"speaker":"Olav","text":"Hei Kari! Dette er Olav.","zh":"你好，卡里！我是奥拉夫。","words":[[0,3,18.66,18.88,"hei"],[4,8,18.9,19.18,"kari"],[10,15,19.66,20.04,"dette@ty-dette-phone"],[16,18,20.04,20.2,"er@ty-be-identity"],[19,23,20.2,20.52,"olav"]]},{"id":2,"start":20.92,"end":23.24,"speaker":"Kari","text":"Hei Olav! Takk for sist!","zh":"你好，奥拉夫！上次见面很愉快！","words":[[0,3,20.92,21.48,"hei"],[4,8,21.56,22.02,"olav"],[10,14,22.56,22.82,"takk"],[15,18,22.82,22.94,"for@ty-for-thanks"],[19,23,22.94,23.24,"sist"]]},{"id":3,"start":23.76,"end":25.04,"speaker":"Olav","text":"Det var en hyggelig lunsj.","zh":"那顿午餐吃得很愉快。","words":[[0,3,23.76,23.98,"det@ty-det-lunch"],[4,7,23.98,24.1,"var"],[8,10,24.1,24.24,"en"],[11,19,24.24,24.62,"hyggelig"],[20,25,24.62,25.04,"lunsj"]]},{"id":4,"start":25.88,"end":29.44,"speaker":"Kari","text":"Og en fin restaurant. Hvordan har du det?","zh":"餐馆也很不错。你最近怎么样？","words":[[0,2,25.88,26.2,"og"],[3,5,26.2,26.44,"en"],[6,9,26.44,26.68,"fin"],[10,20,26.68,27.16,"restaurant"],[22,29,28.18,28.84,"hvordan"],[30,33,28.84,29.1,"har@ty-have-wellbeing"],[34,36,29.1,29.26,"du"],[37,40,29.26,29.44,"det@ty-det-wellbeing"]]},{"id":5,"start":29.6,"end":32.3,"speaker":"Olav","text":"Fint. Men jeg skal reise i morgen tidlig.","zh":"很好。不过我明天一早就要走了。","words":[[0,4,29.6,29.86,"fint@ty-fint-wellbeing"],[6,9,30.68,31.1,"men"],[10,13,31.1,31.28,"jeg"],[14,18,31.28,31.4,"skal"],[19,24,31.4,31.76,"reise"],[25,26,31.76,31.84,"i@ty-time"],[27,33,31.84,31.96,"morgen"],[34,40,31.96,32.3,"tidlig@ty-early-morning"]]},{"id":6,"start":32.7,"end":34.02,"speaker":"Kari","text":"Er ferien over?","zh":"假期结束了吗？","words":[[0,2,32.7,33.04,"er@ty-be-description"],[3,9,33.04,33.56,"ferien"],[10,14,33.56,34.02,"over@ty-over-ended"]]},{"id":7,"start":34.2,"end":38.28,"speaker":"Olav","text":"Ja. Jeg reiser til Bodø. Det er en jobb for avisen.","zh":"是的。我去博德，是为报社出差。","words":[[0,2,34.2,34.98,"ja"],[4,7,35.48,35.62,"jeg"],[8,14,35.62,35.92,"reiser"],[15,18,35.92,36.08,"til"],[19,23,36.08,36.46,"bodø"],[25,28,37.44,37.5,"det@ty-det-task"],[29,31,37.5,37.58,"er@ty-be-identity"],[32,34,37.58,37.66,"en"],[35,39,37.66,37.94,"jobb"],[40,43,37.94,38.02,"for@ty-for-paper-work"],[44,50,38.02,38.28,"avisen"]]},{"id":8,"start":38.66,"end":39.82,"speaker":"Kari","text":"Reiser du med fly?","zh":"你坐飞机去吗？","words":[[0,6,38.66,39.24,"reiser"],[7,9,39.24,39.36,"du"],[10,13,39.36,39.5,"med@ty-with-vehicle"],[14,17,39.5,39.82,"fly"]]},{"id":9,"start":40.14,"end":42.12,"speaker":"Olav","text":"Ja, flyet går klokken halv åtte.","zh":"是的，飞机七点半起飞。","words":[[0,2,40.14,40.36,"ja"],[4,9,40.68,41.02,"flyet"],[10,13,41.02,41.2,"går@ty-flight-departure"],[14,21,41.2,41.6,"klokken"],[22,26,41.6,41.84,"halv"],[27,31,41.84,42.12,"åtte"]]},{"id":10,"start":42.46,"end":44.5,"speaker":"Kari","text":"Jeg vil gjerne treffe deg igjen.","zh":"我想再见到你。","words":[[0,3,42.46,42.84,"jeg"],[4,7,42.84,43.14,"vil"],[8,14,43.14,43.56,"gjerne"],[15,21,43.56,43.92,"treffe"],[22,25,43.92,44.1,"deg"],[26,31,44.1,44.5,"igjen"]]},{"id":11,"start":44.96,"end":47.12,"speaker":"Olav","text":"Jeg også. Jeg skal ringe til deg.","zh":"我也是。我会给你打电话。","words":[[0,3,44.96,45.3,"jeg"],[4,8,45.3,45.7,"også"],[10,13,46.1,46.36,"jeg"],[14,18,46.36,46.48,"skal"],[19,24,46.48,46.8,"ringe"],[25,28,46.8,46.94,"til@ty-telephone-to"],[29,32,46.94,47.12,"deg"]]},{"id":12,"start":47.5,"end":48.64,"speaker":"Kari","text":"Ha det bra, Olav!","zh":"再见，奥拉夫！","words":[[0,2,47.5,47.76,"ha@ty-farewell-ha"],[3,6,47.76,47.88,"det@ty-farewell-det"],[7,10,47.88,48.08,"bra@ty-farewell-bra"],[12,16,48.18,48.64,"olav"]]},{"id":13,"start":49.04,"end":49.62,"speaker":"Olav","text":"Hei hei, Kari!","zh":"再见，卡里！","words":[[0,3,49.04,49.24,"hei@ty-farewell-hei"],[4,7,49.24,49.4,"hei@ty-farewell-hei"],[9,13,49.42,49.62,"kari"]]}],"lexicon":{"avisen":{"lemma":"avis","zh":"报社（指为报社做的工作）","pos":"名词","ref":"ty-conversation-4-001","clip":null,"form":"单数定指"},"bodø":{"lemma":"Bodø","zh":"博德（挪威城市）","pos":"专名","ref":null,"clip":null},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"bra@ty-farewell-bra":{"lemma":"bra","zh":"好（Ha det bra!：再见）","pos":"副词","ref":"pa-vei-2-018","clip":null,"contextual":true,"baseKey":"bra","surface":"bra"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-lunch":{"lemma":"det","zh":"那（指上次一起吃午饭的经历）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-det-task":{"lemma":"det","zh":"这（指去博德的行程）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-det-wellbeing":{"lemma":"det","zh":"（Hvordan har du det?）问候近况用语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-farewell-det":{"lemma":"det","zh":"（Ha det bra!）道别语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性"},"dette@ty-dette-phone":{"lemma":"dette","zh":"（Dette er Olav.）电话里介绍自己：我是奥拉夫","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性","contextual":true,"baseKey":"dette","surface":"dette"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005"