{"id":"5.2","title":"På stranda","audio":"audio/5.2.mp3","duration":172.93,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.4,"text":"5.2 På stranda","heading":true,"zh":"5.2 在海滩上","words":[[0,3,0.15,1.22,"5.2"],[4,6,2.49,2.73,"på"],[7,14,2.73,3.32,"stranda"]]},{"id":1,"start":5.0,"end":7.32,"text":"Det er lørdag 5. juli.","zh":"今天是7月5日，星期六。","words":[[0,3,5.08,5.24,"det"],[4,6,5.24,5.44,"er"],[7,13,5.44,5.98,"lørdag"],[14,15,5.98,6.76,"5~f89fdbc7a8fd"],[17,21,6.76,7.24,"juli"]]},{"id":2,"start":8.11,"end":11.77,"text":"Været er nydelig, og det er 25 grader.","zh":"天气好极了，有25度。","words":[[0,5,8.19,8.66,"været"],[6,8,8.66,8.96,"er"],[9,16,8.96,9.62,"nydelig"],[18,20,10.16,10.22,"og"],[21,24,10.22,10.34,"det"],[25,27,10.34,10.46,"er"],[28,30,10.46,11.0,"25"],[31,37,11.0,11.69,"grader"]]},{"id":3,"start":12.77,"end":15.27,"text":"Mange mennesker koser seg på stranda.","zh":"很多人在海滩上尽情享受。","words":[[0,5,12.85,13.24,"mange"],[6,15,13.24,13.82,"mennesker"],[16,21,13.82,14.3,"koser"],[22,25,14.3,14.52,"seg"],[26,28,14.52,14.72,"på"],[29,36,14.72,15.19,"stranda"]]},{"id":4,"start":16.45,"end":19.61,"text":"Bjørnar har fri fra jobben og er på stranda.","zh":"比约纳尔不用上班，正在海滩上。","words":[[0,7,16.53,17.11,"bjørnar"],[8,11,17.11,17.43,"har"],[12,15,17.43,17.79,"fri"],[16,19,17.79,17.97,"fra"],[20,26,17.97,18.41,"jobben"],[27,29,18.41,18.73,"og"],[30,32,18.73,18.89,"er"],[33,35,18.89,19.07,"på"],[36,43,19.07,19.53,"stranda"]]},{"id":5,"start":20.51,"end":25.53,"text":"Han skal møte Håvard og Marit, og Marit har med ei venninne.","zh":"他要和霍瓦尔、玛丽特见面，玛丽特还带了一位女性朋友。","words":[[0,3,20.59,20.86,"han"],[4,8,20.86,21.14,"skal"],[9,13,21.14,21.62,"møte~5c5ca137ac81"],[14,20,21.62,22.14,"håvard"],[21,23,22.14,22.36,"og"],[24,29,22.36,22.92,"marit"],[31,33,23.46,23.76,"og"],[34,39,23.76,24.2,"marit"],[40,43,24.2,24.5,"har"],[44,47,24.5,24.66,"med~dbefb023722e"],[48,50,24.66,24.9,"ei~47aa2d18e376"],[51,59,24.9,25.45,"venninne"]]},{"id":6,"start":27.54,"end":33.68,"text":"Hallo! Så hyggelig å se dere. Det er deilig og varmt i dag.","speaker":"Bjørnar","zh":"你好！见到你们真高兴。今天又暖和又舒服。","words":[[0,5,27.62,28.05,"hallo"],[7,9,28.99,29.37,"så~70971dce552b"],[10,18,29.37,29.93,"hyggelig"],[19,20,29.93,30.09,"å~0583da7a620a"],[21,23,30.09,30.45,"se"],[24,28,30.45,30.75,"dere"],[30,33,31.71,32.17,"det"],[34,36,32.17,32.29,"er"],[37,43,32.29,32.81,"deilig"],[44,46,32.81,32.93,"og"],[47,52,32.93,33.33,"varmt"],[53,54,33.33,33.49,"i~de136e71704d"],[55,58,33.49,33.68,"dag"]]},{"id":7,"start":33.79,"end":40.67,"text":"Hei! Ja, nå er det fantastisk vær. Marit og jeg har ferie nå.","speaker":"Håvard","zh":"嗨！是啊，现在天气棒极了。玛丽特和我现在在放假。","words":[[0,3,33.79,35.13,"hei"],[5,7,35.71,36.11,"ja"],[9,11,36.45,36.65,"nå~d531d47a7712"],[12,14,36.65,36.91,"er"],[15,18,36.91,37.03,"det"],[19,29,37.03,37.85,"fantastisk"],[30,33,37.85,38.09,"vær~c9ef13faaa9b"],[35,40,38.89,39.45,"marit"],[41,43,39.45,39.53,"og"],[44,47,39.53,39.67,"jeg"],[48,51,39.67,39.83,"har"],[52,57,39.83,40.29,"ferie"],[58,60,40.29,40.59,"nå~d531d47a7712"]]},{"id":8,"start":41.8,"end":46.78,"text":"Vi har ferie til 10. august. Jeg vil ha fint vær hele sommeren.","speaker":"Marit","zh":"我们的假期到8月10日。我希望整个夏天都是好天气。","words":[[0,2,41.88,42.1,"vi"],[3,6,42.1,42.28,"har"],[7,12,42.28,42.74,"ferie"],[13,16,42.74,42.9,"til"],[17,19,42.9,43.38,"10~f8a681232048"],[21,27,43.38,43.8,"august"],[29,32,44.51,44.79,"jeg"],[33,36,44.79,44.93,"vil"],[37,39,44.93,45.05,"ha~ca5edb8b1cdb"],[40,44,45.05,45.35,"fint"],[45,48,45.35,45.61,"vær~c9ef13faaa9b"],[49,53,45.61,46.13,"hele"],[54,62,46.13,46.7,"sommeren"]]},{"id":9,"start":48.09,"end":55.14,"text":"Jeg skal bare ha ferie i tre uker, fra 13. juli til 4. august.","speaker":"Bjørnar","zh":"我只有三周假期，从7月13日到8月4日。","words":[[0,3,48.17,48.5,"jeg"],[4,8,48.5,48.72,"skal"],[9,13,48.72,49.16,"bare"],[14,16,49.16,49.36,"ha~ca5edb8b1cdb"],[17,22,49.36,49.86,"ferie"],[23,24,49.86,50.1,"i~6e102f50e7a5"],[25,28,50.32,50.42,"tre"],[29,33,50.42,50.88,"uker"],[35,38,51.54,51.98,"fra"],[39,41,51.98,52.72,"13~c7aff887542f"],[43,47,52.72,53.0,"juli"],[48,51,53.68,53.84,"til"],[52,53,53.84,54.5,"4~619e2cc2ad54"],[55,61,54.5,55.06,"august"]]},{"id":10,"start":55.83,"end":60.15,"text":"Du må hilse på venninna til Marit. Hun heter Ingrid.","speaker":"Håvard","zh":"你得跟玛丽特的朋友打个招呼。她叫英格丽。","words":[[0,2,55.91,56.14,"du"],[3,5,56.14,56.3,"må"],[6,11,56.3,56.76,"hilse"],[12,14,56.76,56.94,"på~588ffe6c89d8"],[15,23,56.94,57.42,"venninna"],[24,27,57.43,57.58,"til~8de1a9181f86"],[28,33,57.58,58.04,"marit"],[35,38,58.78,59.12,"hun"],[39,44,59.12,59.42,"heter"],[45,51,59.42,60.07,"ingrid"]]},{"id":11,"start":61.03,"end":67.32,"text":"Hei, Ingrid! Hyggelig å hilse på deg. Er du også lærer?","speaker":"Bjørnar","zh":"你好，英格丽！很高兴认识你。你也是老师吗？","words":[[0,3,61.11,61.52,"hei"],[5,11,61.68,61.86,"ingrid"],[13,21,62.82,63.62,"hyggelig"],[22,23,63.62,64.04,"å~0583da7a620a"],[24,29,64.04,64.5,"hilse"],[30,32,64.5,64.66,"på~588ffe6c89d8"],[33,36,64.66,64.88,"deg"],[38,40,65.98,66.16,"er"],[41,43,66.16,66.32,"du"],[44,48,66.32,66.64,"også"],[49,54,66.64,67.24,"lærer~5a8d077d35fc"]]},{"id":12,"start":68.09,"end":70.96,"text":"Hei! Nei, jeg er frisør.","speaker":"Ingrid","zh":"你好！不是，我是理发师。","words":[[0,3,68.17,68.54,"hei"],[5,8,68.98,69.48,"nei"],[10,13,69.86,70.04,"jeg"],[14,16,70.04,70.16,"er"],[17,23,70.16,70.88,"frisør"]]},{"id":13,"start":71.92,"end":73.28,"text":"Har du også ferie?","speaker":"Bjørnar","zh":"你也在放假吗？","words":[[0,3,72.0,72.21,"har"],[4,6,72.21,72.39,"du"],[7,11,72.39,72.69,"også"],[12,17,72.69,73.2,"ferie"]]},{"id":14,"start":74.7,"end":81.64,"text":"Nei, jeg har ikke ferie, men jeg har fri i dag. Jeg har lyst til å være på stranda hele dagen.","speaker":"Ingrid","zh":"没有，我没放假，不过今天我休息。我想在海滩上待一整天。","words":[[0,3,74.78,75.15,"nei"],[5,8,75.61,75.75,"jeg"],[9,12,75.75,75.93,"har"],[13,17,75.93,76.13,"ikke"],[18,23,76.13,76.67,"ferie"],[25,28,77.03,77.31,"men"],[29,32,77.31,77.51,"jeg"],[33,36,77.51,77.69,"har"],[37,40,77.69,77.99,"fri"],[41,42,77.99,78.09,"i~de136e71704d"],[43,46,78.09,78.33,"dag"],[48,51,79.15,79.33,"jeg"],[52,55,79.33,79.47,"har"],[56,60,79.47,79.69,"lyst~b499524f55a4"],[61,64,79.72,79.81,"til~99ccdd3453b0"],[65,66,79.81,79.93,"å~0583da7a620a"],[67,71,79.93,80.09,"være"],[72,74,80.09,80.27,"på"],[75,82,80.27,80.65,"stranda"],[83,87,80.65,80.97,"hele"],[88,93,80.97,81.56,"dagen"]]},{"id":15,"start":82.65,"end":86.95,"text":"Vi må kose oss på stranda i dag, for det blir regn i morgen.","speaker":"Bjørnar","zh":"我们今天得在海滩上好好享受，因为明天会下雨。","words":[[0,2,82.73,82.96,"vi"],[3,5,82.96,83.16,"må"],[6,10,83.16,83.6,"kose"],[11,14,83.6,83.8,"oss"],[15,17,83.8,84.0,"på"],[18,25,84.0,84.46,"stranda"],[26,27,84.46,84.58,"i~de136e71704d"],[28,31,84.58,84.76,"dag"],[33,36,85.44,85.62,"for~a05c87659379"],[37,40,85.62,85.76,"det"],[41,45,85.76,85.92,"blir"],[46,50,85.92,86.3,"regn"],[51,52,86.3,86.42,"i~46dcc9198d6d"],[53,59,86.42,86.87,"morgen"]]},{"id":16,"start":87.73,"end":94.19,"text":"Typisk norsk sommer! En dag skinner sola, og neste dag regner det.","speaker":"Ingrid","zh":"典型的挪威夏天！一天阳光灿烂，第二天就下雨。","words":[[0,6,87.81,88.52,"typisk"],[7,12,88.52,88.94,"norsk~300c0d0c4f59"],[13,19,88.94,89.42,"sommer"],[21,23,90.02,90.48,"en~a939a9e56dc5"],[24,27,90.48,90.76,"dag"],[28,35,90.76,91.28,"skinner~ff65c9cf260b"],[36,40,91.28,91.52,"sola"],[42,44,92.26,92.48,"og"],[45,50,92.48,92.9,"neste~1a5863e01a71"],[51,54,92.9,93.34,"dag"],[55,61,93.34,93.8,"regner"],[62,65,93.8,94.11,"det"]]},{"id":17,"start":94.33,"end":97.33,"text":"Ja, det er sant.","speaker":"Bjørnar","zh":"是啊，确实如此。","words":[[0,2,94.69,95.71,"ja"],[4,7,96.11,96.47,"det"],[8,10,96.47,96.63,"er"],[11,15,96.63,97.25,"sant"]]},{"id":18,"start":98.37,"end":103.46,"text":"Nå har jeg lyst til å bade. Jeg er varm. Vil dere også bade?","speaker":"Ingrid","zh":"现在我想去游泳。我好热。你们也想游泳吗？","words":[[0,2,98.45,98.75,"nå~d531d47a7712"],[3,6,98.75,98.93,"har"],[7,10,98.93,99.05,"jeg"],[11,15,99.05,99.29,"lyst~b499524f55a4"],[16,19,99.29,99.43,"til~99ccdd3453b0"],[20,21,99.43,99.53,"å~0583da7a620a"],[22,26,99.53,99.85,"bade"],[28,31,100.5,100.82,"jeg"],[32,34,100.82,100.98,"er"],[35,39,100.98,101.46,"varm"],[41,44,101.96,102.24,"vil"],[45,49,102.24,102.46,"dere"],[50,54,102.46,102.88,"også"],[55,59,102.88,103.38,"bade"]]},{"id":19,"start":104.7,"end":106.96,"text":"Nei, jeg vil slappe av.","speaker":"Håvard","zh":"不了，我想放松一下。","words":[[0,3,104.78,105.22,"nei"],[5,8,105.84,106.04,"jeg"],[9,12,106.04,106.18,"vil"],[13,19,106.18,106.56,"slappe~75bc27ca2f9a"],[20,22,106.56,106.88,"av~6aef60c561bf"]]},{"id":20,"start":108.03,"end":109.74,"text":"Jeg har lyst til å sole meg.","speaker":"Marit","zh":"我想晒晒太阳。","words":[[0,3,108.11,108.33,"jeg"],[4,7,108.33,108.51,"har"],[8,12,108.51,108.75,"lyst~b499524f55a4"],[13,16,108.75,108.89,"til~99ccdd3453b0"],[17,18,108.89,108.99,"å~0583da7a620a"],[19,23,108.99,109.25,"sole"],[24,27,109.25,109.66,"meg"]]},{"id":21,"start":111.01,"end":114.63,"text":"Jeg vil gjerne bade, Ingrid. Kommer du?","speaker":"Bjørnar","zh":"我很想去游泳，英格丽。你来吗？","words":[[0,3,111.09,111.39,"jeg"],[4,7,111.39,111.61,"vil"],[8,14,111.61,112.05,"gjerne"],[15,19,112.05,112.37,"bade"],[21,27,112.53,112.71,"ingrid"],[29,35,113.96,114.32,"kommer"],[36,38,114.32,114.55,"du"]]},{"id":22,"start":119.03,"end":120.07,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,119.11,119.99,"sammendrag"]]},{"id":23,"start":121.25,"end":124.53,"text":"Det er 5. juli og sommer i Norge.","zh":"今天是7月5日，挪威正值夏天。","words":[[0,3,121.33,121.6,"det"],[4,6,121.6,121.96,"er"],[7,8,121.96,122.52,"5~f89fdbc7a8fd"],[10,14,122.52,122.88,"juli"],[15,17,122.88,123.2,"og"],[18,24,123.2,123.78,"sommer"],[25,26,123.78,124.0,"i"],[27,32,124.0,124.45,"norge~546b56e35dd5"]]},{"id":24,"start":126.32,"end":128.64,"text":"Håvard og Marit har ferie.","zh":"霍瓦尔和玛丽特在放假。","words":[[0,6,126.4,127.02,"håvard"],[7,9,127.02,127.16,"og"],[10,15,127.16,127.72,"marit"],[16,19,127.72,127.96,"har"],[20,25,127.96,128.56,"ferie"]]},{"id":25,"start":130.41,"end":134.0,"text":"De drar til stranda sammen med venninna til Marit.","zh":"他们和玛丽特的朋友一起去海滩。","words":[[0,2,130.49,130.68,"de"],[3,7,130.68,131.0,"drar"],[8,11,131.0,131.18,"til"],[12,19,131.18,131.72,"stranda"],[20,26,131.72,132.28,"sammen"],[27,30,132.28,132.5,"med"],[31,39,132.5,133.04,"venninna"],[40,43,133.04,133.04,"til~8de1a9181f86"],[44,49,133.04,133.92,"marit"]]},{"id":26,"start":134.86,"end":138.17,"text":"Hun heter Ingrid og jobber som frisør.","zh":"她叫英格丽，是理发师。","words":[[0,3,134.94,135.15,"hun"],[4,9,135.15,135.45,"heter"],[10,16,135.45,135.95,"ingrid"],[17,19,135.95,136.83,"og"],[20,26,136.84,137.22,"jobber~003ddb6d77e6"],[27,30,137.22,137.46,"som~90f492b4f2ff"],[31,37,137.46,138.09,"frisør"]]},{"id":27,"start":139.38,"end":141.18,"text":"De skal møte Bjørnar.","zh":"他们要和比约纳尔见面。","words":[[0,2,139.46,139.7,"de"],[3,7,139.7,139.96,"skal"],[8,12,139.96,140.44,"møte~5c5ca137ac81"],[13,20,140.44,141.1,"bjørnar"]]},{"id":28,"start":142.37,"end":147.03,"text":"Det er fantastisk sommervær i dag, og de koser seg på stranda.","zh":"今天的夏日天气好极了，他们在海滩上玩得很开心。","words":[[0,3,142.44,142.65,"det"],[4,6,142.65,142.83,"er"],[7,17,142.83,143.81,"fantastisk"],[18,27,143.81,144.41,"sommervær"],[28,29,144.41,144.57,"i~de136e71704d"],[30,33,144.57,144.75,"dag"],[35,37,145.19,145.35,"og"],[38,40,145.35,145.47,"de"],[41,46,145.47,145.99,"koser"],[47,50,145.99,146.21,"seg"],[51,53,146.21,146.45,"på"],[54,61,146.45,146.95,"stranda"]]},{"id":29,"start":148.6,"end":151.26,"text":"Bjørnar møter Ingrid for første gang.","zh":"比约纳尔第一次见到英格丽。","words":[[0,7,148.68,149.17,"bjørnar"],[8,13,149.17,149.71,"møter~8f944f539693"],[14,20,149.71,150.13,"ingrid"],[21,24,150.13,150.37,"for~772bdd1eccf0"],[25,31,150.37,150.79,"første"],[32,36,150.79,151.18,"gang"]]},{"id":30,"start":152.3,"end":157.05,"text":"Bjørnar og Ingrid har ikke ferie nå, men de har fri i dag.","zh":"比约纳尔和英格丽现在都没放假，但他们今天休息。","words":[[0,7,152.38,152.88,"bjørnar"],[8,10,152.88,153.14,"og"],[11,17,153.14,153.48,"ingrid"],[18,21,153.48,153.76,"har"],[22,26,153.76,154.12,"ikke"],[27,32,154.12,154.6,"ferie"],[33,35,154.6,154.86,"nå~d531d47a7712"],[37,40,155.34,155.48,"men"],[41,43,155.48,155.6,"de"],[44,47,155.6,155.78,"har"],[48,51,155.78,156.22,"fri"],[52,53,156.22,156.5,"i~de136e71704d"],[54,57,156.5,156.97,"dag"]]},{"id":31,"start":158.4,"end":161.75,"text":"Ingrid har lyst til å bade, for hun er varm.","zh":"英格丽想去游泳，因为她很热。","words":[[0,6,158.48,158.8,"ingrid"],[7,10,158.8,159.04,"har"],[11,15,159.04,159.36,"lyst~b499524f55a4"],[16,19,159.36,159.6,"til~99ccdd3453b0"],[20,21,159.6,159.7,"å~0583da7a620a"],[22,26,159.7,160.04,"bade"],[28,31,160.56,160.8,"for~a05c87659379"],[32,35,160.8,161.0,"hun"],[36,38,161.0,161.16,"er"],[39,43,161.16,161.67,"varm"]]},{"id":32,"start":162.73,"end":168.86,"text":"Håvard og Marit vil ikke være med, men Bjørnar vil gjerne bade med Ingrid.","zh":"霍瓦尔和玛丽特不想一起去，但比约纳尔很想和英格丽一起游泳。","words":[[0,6,162.81,163.3,"håvard"],[7,9,163.3,163.48,"og"],[10,15,163.48,164.06,"marit"],[16,19,164.06,164.46,"vil"],[20,24,164.46,164.76,"ikke"],[25,29,164.76,165.02,"være"],[30,33,165.02,165.24,"med~ec12f15cf236"],[35,38,165.66,165.98,"men"],[39,46,165.98,166.66,"bjørnar"],[47,50,166.66,167.2,"vil"],[51,57,167.2,167.58,"gjerne"],[58,62,167.58,168.0,"bade"],[63,66,168.0,168.32,"med"],[67,73,168.32,168.78,"ingrid"]]}],"lexicon":{"10":{"lemma":"10","zh":"数字 10","pos":"数词","ref":"basics:numbers:ti","clip":null,"kind":"number"},"13":{"lemma":"13","zh":"数字 13","pos":"数词","ref":"basics:numbers:tretten","clip":null,"kind":"number"},"25":{"lemma":"25","zh":"数字 25","pos":"数词","ref":"basics:numbers:tjuefem","clip":null,"kind":"number"},"4":{"lemma":"4","zh":"数字 4","pos":"数词","ref":"basics:numbers:fire","clip":null,"kind":"number"},"5":{"lemma":"5","zh":"数字 5","pos":"数词","ref":"basics:numbers:fem","clip":null,"kind":"number"},"5.2":{"lemma":"5.2","zh":"第 5.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"august":{"lemma":"august","zh":"八月","pos":"名词","ref":"2-029","clip":"pronunciation/c2afdd38565b01f278bc.mp3"},"av":{"lemma