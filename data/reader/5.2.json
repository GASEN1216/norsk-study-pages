{"id":"5.2","title":"På stranda","audio":"audio/5.2.mp3","duration":172.93,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.4,"text":"5.2 På stranda","heading":true,"zh":"5.2 在海滩上","words":[[0,3,0.15,1.22,"5.2"],[4,6,2.49,2.73,"på"],[7,14,2.73,3.32,"stranda"]]},{"id":1,"start":5.02,"end":7.38,"text":"Det er lørdag 5. juli.","zh":"今天是7月5日，星期六。","words":[[0,3,5.08,5.3,"det"],[4,6,5.3,5.54,"er"],[7,13,5.54,6.24,"lørdag"],[14,15,6.24,6.64,"5~f89fdbc7a8fd"],[17,21,6.82,7.22,"juli"]]},{"id":2,"start":8.15,"end":11.82,"text":"Været er nydelig, og det er 25 grader.","zh":"天气好极了，有25度。","words":[[0,5,8.21,8.78,"været"],[6,8,8.78,9.04,"er"],[9,16,9.04,9.82,"nydelig"],[18,20,10.12,10.22,"og"],[21,24,10.22,10.36,"det"],[25,27,10.36,10.56,"er"],[28,30,10.56,11.2,"25"],[31,37,11.2,11.67,"grader"]]},{"id":3,"start":12.8,"end":15.32,"text":"Mange mennesker koser seg på stranda.","zh":"很多人在海滩上尽情享受。","words":[[0,5,12.86,13.36,"mange"],[6,15,13.36,13.94,"mennesker"],[16,21,13.94,14.36,"koser"],[22,25,14.36,14.64,"seg"],[26,28,14.64,14.78,"på"],[29,36,14.78,15.17,"stranda"]]},{"id":4,"start":16.48,"end":19.66,"text":"Bjørnar har fri fra jobben og er på stranda.","zh":"比约纳尔不用上班，正在海滩上。","words":[[0,7,16.54,17.3,"bjørnar"],[8,11,17.3,17.54,"har"],[12,15,17.54,17.84,"fri"],[16,19,17.84,18.02,"fra"],[20,26,18.02,18.64,"jobben"],[27,29,18.64,18.76,"og"],[30,32,18.76,18.98,"er"],[33,35,18.98,19.1,"på"],[36,43,19.1,19.52,"stranda"]]},{"id":5,"start":20.54,"end":25.58,"text":"Han skal møte Håvard og Marit, og Marit har med ei venninne.","zh":"他要和霍瓦尔、玛丽特见面，玛丽特还带了一位女性朋友。","words":[[0,3,20.6,20.96,"han"],[4,8,20.96,21.26,"skal"],[9,13,21.26,21.72,"møte~5c5ca137ac81"],[14,20,21.72,22.26,"håvard"],[21,23,22.26,22.4,"og"],[24,29,22.4,23.18,"marit"],[31,33,23.66,23.8,"og"],[34,39,23.8,24.32,"marit"],[40,43,24.32,24.58,"har"],[44,47,24.58,24.76,"med~dbefb023722e"],[48,50,24.76,24.92,"ei~47aa2d18e376"],[51,59,24.92,25.43,"venninne"]]},{"id":6,"start":27.57,"end":34.04,"text":"Hallo! Så hyggelig å se dere. Det er deilig og varmt i dag.","speaker":"Bjørnar","zh":"你好！见到你们真高兴。今天又暖和又舒服。","words":[[0,5,27.63,28.18,"hallo"],[7,9,29.24,29.46,"så~70971dce552b"],[10,18,29.46,30.0,"hyggelig"],[19,20,30.0,30.2,"å~0583da7a620a"],[21,23,30.2,30.54,"se"],[24,28,30.54,31.02,"dere"],[30,33,32.04,32.2,"det"],[34,36,32.2,32.34,"er"],[37,43,32.34,32.86,"deilig"],[44,46,32.86,33.0,"og"],[47,52,33.0,33.44,"varmt"],[53,54,33.44,33.52,"i~de136e71704d"],[55,58,33.52,33.89,"dag"]]},{"id":7,"start":34.69,"end":40.73,"text":"Hei! Ja, nå er det fantastisk vær. Marit og jeg har ferie nå.","speaker":"Håvard","zh":"嗨！是啊，现在天气棒极了。玛丽特和我现在在放假。","words":[[0,3,34.75,35.26,"hei"],[5,7,35.92,36.23,"ja"],[9,11,36.5,36.78,"nå~d531d47a7712"],[12,14,36.78,36.94,"er"],[15,18,36.94,37.12,"det"],[19,29,37.12,37.9,"fantastisk"],[30,33,37.9,38.31,"vær~c9ef13faaa9b"],[35,40,39.1,39.48,"marit"],[41,43,39.48,39.56,"og"],[44,47,39.56,39.72,"jeg"],[48,51,39.72,39.9,"har"],[52,57,39.9,40.34,"ferie"],[58,60,40.34,40.59,"nå~d531d47a7712"]]},{"id":8,"start":41.84,"end":46.84,"text":"Vi har ferie til 10. august. Jeg vil ha fint vær hele sommeren.","speaker":"Marit","zh":"我们的假期到8月10日。我希望整个夏天都是好天气。","words":[[0,2,41.9,42.18,"vi"],[3,6,42.18,42.4,"har"],[7,12,42.4,42.8,"ferie"],[13,16,42.8,43.0,"til"],[17,19,43.0,43.4,"10~f8a681232048"],[21,27,43.4,44.13,"august"],[29,32,44.68,44.82,"jeg"],[33,36,44.82,44.98,"vil"],[37,39,44.98,45.14,"ha~ca5edb8b1cdb"],[40,44,45.14,45.46,"fint"],[45,48,45.46,45.76,"vær~c9ef13faaa9b"],[49,53,45.76,46.24,"hele"],[54,62,46.24,46.69,"sommeren"]]},{"id":9,"start":48.12,"end":55.19,"text":"Jeg skal bare ha ferie i tre uker, fra 13. juli til 4. august.","speaker":"Bjørnar","zh":"我只有三周假期，从7月13日到8月4日。","words":[[0,3,48.19,48.56,"jeg"],[4,8,48.56,48.88,"skal"],[9,13,48.88,49.26,"bare"],[14,16,49.26,49.46,"ha~ca5edb8b1cdb"],[17,22,49.46,50.02,"ferie"],[23,24,50.02,50.16,"i~6e102f50e7a5"],[25,28,50.16,50.54,"tre"],[29,33,50.54,51.09,"uker"],[35,38,51.78,52.1,"fra"],[39,41,52.1,52.78,"13~c7aff887542f"],[43,47,52.78,53.3,"juli"],[48,51,53.68,53.98,"til"],[52,53,53.98,54.54,"4~619e2cc2ad54"],[55,61,54.54,55.04,"august"]]},{"id":10,"start":55.87,"end":60.21,"text":"Du må hilse på venninna til Marit. Hun heter Ingrid.","speaker":"Håvard","zh":"你得跟玛丽特的朋友打个招呼。她叫英格丽。","words":[[0,2,55.93,56.18,"du"],[3,5,56.18,56.42,"må"],[6,11,56.42,56.84,"hilse"],[12,14,56.84,57.04,"på~588ffe6c89d8"],[15,23,57.04,57.5,"venninna"],[24,27,57.5,57.66,"til~8de1a9181f86"],[28,33,57.66,58.26,"marit"],[35,38,58.98,59.16,"hun"],[39,44,59.16,59.62,"heter"],[45,51,59.62,60.06,"ingrid"]]},{"id":11,"start":61.06,"end":67.41,"text":"Hei, Ingrid! Hyggelig å hilse på deg. Er du også lærer?","speaker":"Bjørnar","zh":"你好，英格丽！很高兴认识你。你也是老师吗？","words":[[0,3,61.12,61.7,"hei"],[5,11,61.7,62.31,"ingrid"],[13,21,63.18,63.7,"hyggelig"],[22,23,63.7,63.98,"å~0583da7a620a"],[24,29,64.2,64.56,"hilse"],[30,32,64.56,64.7,"på~588ffe6c89d8"],[33,36,64.7,65.08,"deg"],[38,40,66.06,66.22,"er"],[41,43,66.22,66.48,"du"],[44,48,66.48,66.8,"også"],[49,54,66.8,67.25,"lærer~5a8d077d35fc"]]},{"id":12,"start":68.13,"end":71.01,"text":"Hei! Nei, jeg er frisør.","speaker":"Ingrid","zh":"你好！不是，我是理发师。","words":[[0,3,68.19,68.66,"hei"],[5,8,69.16,69.64,"nei"],[10,13,69.88,70.08,"jeg"],[14,16,70.08,70.22,"er"],[17,23,70.22,70.86,"frisør"]]},{"id":13,"start":71.96,"end":73.36,"text":"Har du også ferie?","speaker":"Bjørnar","zh":"你也在放假吗？","words":[[0,3,72.02,72.24,"har"],[4,6,72.24,72.48,"du"],[7,11,72.48,72.8,"også"],[12,17,72.8,73.21,"ferie"]]},{"id":14,"start":74.73,"end":81.73,"text":"Nei, jeg har ikke ferie, men jeg har fri i dag. Jeg har lyst til å være på stranda hele dagen.","speaker":"Ingrid","zh":"没有，我没放假，不过今天我休息。我想在海滩上待一整天。","words":[[0,3,74.8,75.3,"nei"],[5,8,75.64,75.8,"jeg"],[9,12,75.8,75.98,"har"],[13,17,75.98,76.24,"ikke"],[18,23,76.24,76.86,"ferie"],[25,28,77.16,77.38,"men"],[29,32,77.38,77.54,"jeg"],[33,36,77.54,77.78,"har"],[37,40,77.78,78.04,"fri"],[41,42,78.04,78.12,"i~de136e71704d"],[43,46,78.12,78.62,"dag"],[48,51,79.24,79.38,"jeg"],[52,55,79.38,79.52,"har"],[56,60,79.52,79.76,"lyst~b499524f55a4"],[61,64,79.76,79.9,"til~99ccdd3453b0"],[65,66,79.9,79.98,"å~0583da7a620a"],[67,71,79.98,80.18,"være"],[72,74,80.18,80.34,"på"],[75,82,80.34,80.72,"stranda"],[83,87,80.72,81.1,"hele"],[88,93,81.1,81.58,"dagen"]]},{"id":15,"start":82.69,"end":87.01,"text":"Vi må kose oss på stranda i dag, for det blir regn i morgen.","speaker":"Bjørnar","zh":"我们今天得在海滩上好好享受，因为明天会下雨。","words":[[0,2,82.75,83.02,"vi"],[3,5,83.02,83.26,"må"],[6,10,83.26,83.68,"kose"],[11,14,83.68,83.9,"oss"],[15,17,83.9,84.04,"på"],[18,25,84.04,84.5,"stranda"],[26,27,84.5,84.56,"i~de136e71704d"],[28,31,84.56,85.04,"dag"],[33,36,85.48,85.64,"for~a05c87659379"],[37,40,85.64,85.78,"det"],[41,45,85.78,85.98,"blir"],[46,50,85.98,86.36,"regn"],[51,52,86.36,86.44,"i~46dcc9198d6d"],[53,59,86.44,86.86,"morgen"]]},{"id":16,"start":87.77,"end":94.24,"text":"Typisk norsk sommer! En dag skinner sola, og neste dag regner det.","speaker":"Ingrid","zh":"典型的挪威夏天！一天阳光灿烂，第二天就下雨。","words":[[0,6,87.83,88.6,"typisk"],[7,12,88.6,89.0,"norsk~300c0d0c4f59"],[13,19,89.0,89.64,"sommer"],[21,23,90.18,90.52,"en~a939a9e56dc5"],[24,27,90.52,90.92,"dag"],[28,35,90.92,91.34,"skinner~ee34a8ef9f73"],[36,40,91.34,91.84,"sola"],[42,44,92.32,92.56,"og"],[45,50,92.56,93.1,"neste~1a5863e01a71"],[51,54,93.1,93.48,"dag"],[55,61,93.48,93.86,"regner"],[62,65,93.86,94.09,"det"]]},{"id":17,"start":95.4,"end":97.37,"text":"Ja, det er sant.","speaker":"Bjørnar","zh":"是啊，确实如此。","words":[[0,2,95.46,95.84,"ja"],[4,7,96.28,96.54,"det"],[8,10,96.54,96.7,"er"],[11,15,96.7,97.22,"sant"]]},{"id":18,"start":98.41,"end":103.51,"text":"Nå har jeg lyst til å bade. Jeg er varm. Vil dere også bade?","speaker":"Ingrid","zh":"现在我想去游泳。我好热。你们也想游泳吗？","words":[[0,2,98.47,98.82,"nå~d531d47a7712"],[3,6,98.82,98.98,"har"],[7,10,98.98,99.12,"jeg"],[11,15,99.12,99.32,"lyst~b499524f55a4"],[16,19,99.32,99.48,"til~99ccdd3453b0"],[20,21,99.48,99.56,"å~0583da7a620a"],[22,26,99.56,100.16,"bade"],[28,31,100.68,100.9,"jeg"],[32,34,100.9,101.04,"er"],[35,39,101.04,101.56,"varm"],[41,44,102.12,102.28,"vil"],[45,49,102.28,102.66,"dere"],[50,54,102.66,102.94,"også"],[55,59,102.94,103.36,"bade"]]},{"id":19,"start":104.74,"end":107.03,"text":"Nei, jeg vil slappe av.","speaker":"Håvard","zh":"不了，我想放松一下。","words":[[0,3,104.8,105.36,"nei"],[5,8,105.92,106.08,"jeg"],[9,12,106.08,106.26,"vil"],[13,19,106.26,106.66,"slappe~75bc27ca2f9a"],[20,22,106.66,106.88,"av~6aef60c561bf"]]},{"id":20,"start":108.07,"end":109.8,"text":"Jeg har lyst til å sole meg.","speaker":"Marit","zh":"我想晒晒太阳。","words":[[0,3,108.13,108.42,"jeg"],[4,7,108.42,108.58,"har"],[8,12,108.58,108.78,"lyst~b499524f55a4"],[13,16,108.78,108.94,"til~99ccdd3453b0"],[17,18,108.94,109.04,"å~0583da7a620a"],[19,23,109.04,109.36,"sole"],[24,27,109.36,109.65,"meg"]]},{"id":21,"start":111.05,"end":114.69,"text":"Jeg vil gjerne bade, Ingrid. Kommer du?","speaker":"Bjørnar","zh":"我很想去游泳，英格丽。你来吗？","words":[[0,3,111.11,111.46,"jeg"],[4,7,111.46,111.66,"vil"],[8,14,111.66,112.14,"gjerne"],[15,19,112.14,112.56,"bade"],[21,27,112.56,113.1,"ingrid"],[29,35,114.06,114.34,"kommer"],[36,38,114.34,114.54,"du"]]},{"id":22,"start":119.06,"end":120.14,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,119.12,119.99,"sammendrag"]]},{"id":23,"start":121.42,"end":124.6,"text":"Det er 5. juli og sommer i Norge.","zh":"今天是7月5日，挪威正值夏天。","words":[[0,3,121.48,121.78,"det"],[4,6,121.78,122.12,"er"],[7,8,122.12,122.56,"5~f89fdbc7a8fd"],[10,14,122.56,123.06,"juli"],[15,17,123.06,123.34,"og"],[18,24,123.34,123.92,"sommer"],[25,26,123.92,124.02,"i"],[27,32,124.02,124.45,"norge~546b56e35dd5"]]},{"id":24,"start":126.49,"end":128.7,"text":"Håvard og Marit har ferie.","zh":"霍瓦尔和玛丽特在放假。","words":[[0,6,126.55,127.08,"håvard"],[7,9,127.08,127.2,"og"],[10,15,127.2,127.82,"marit"],[16,19,127.82,128.04,"har"],[20,25,128.04,128.55,"ferie"]]},{"id":25,"start":130.44,"end":134.06,"text":"De drar til stranda sammen med venninna til Marit.","zh":"他们和玛丽特的朋友一起去海滩。","words":[[0,2,130.5,130.78,"de"],[3,7,130.78,131.06,"drar"],[8,11,131.06,131.3,"til"],[12,19,131.3,131.94,"stranda"],[20,26,131.94,132.36,"sammen"],[27,30,132.36,132.58,"med"],[31,39,132.58,133.12,"venninna"],[40,43,133.12,133.32,"til~8de1a9181f86"],[44,49,133.32,133.91,"marit"]]},{"id":26,"start":134.89,"end":138.22,"text":"Hun heter Ingrid og jobber som frisør.","zh":"她叫英格丽，是理发师。","words":[[0,3,134.95,135.3,"hun"],[4,9,135.3,135.68,"heter"],[10,16,135.68,136.28,"ingrid"],[17,19,136.76,136.9,"og"],[20,26,136.9,137.32,"jobber~003ddb6d77e6"],[27,30,137.32,137.56,"som~90f492b4f2ff"],[31,37,137.56,138.07,"frisør"]]},{"id":27,"start":139.41,"end":141.24,"text":"De skal møte Bjørnar.","zh":"他们要和比约纳尔见面。","words":[[0,2,139.47,139.8,"de"],[3,7,139.8,140.12,"skal"],[8,12,140.12,140.54,"møte~5c5ca137ac81"],[13,20,140.54,141.09,"bjørnar"]]},{"id":28,"start":142.47,"end":147.09,"text":"Det er fantastisk sommervær i dag, og de koser seg på stranda.","zh":"今天的夏日天气好极了，他们在海滩上玩得很开心。","words":[[0,3,142.53,142.7,"det"],[4,6,142.7,142.94,"er"],[7,17,142.94,143.88,"fantastisk"],[18,27,143.88,144.5,"sommervær"],[28,29,144.5,144.58,"i~de136e71704d"],[30,33,144.58,145.02,"dag"],[35,37,145.24,145.38,"og"],[38,40,145.38,145.56,"de"],[41,46,145.56,146.04,"koser"],[47,50,146.04,146.36,"seg"],[51,53,146.36,146.5,"på"],[54,61,146.5,146.94,"stranda"]]},{"id":29,"start":148.63,"end":151.31,"text":"Bjørnar møter Ingrid for første gang.","zh":"比约纳尔第一次见到英格丽。","words":[[0,7,148.69,149.32,"bjørnar"],[8,13,149.32,149.84,"møter~8f944f539693"],[14,20,149.84,150.26,"ingrid"],[21,24,150.26,150.48,"for~772bdd1eccf0"],[25,31,150.48,150.84,"første"],[32,36,150.84,151.16,"gang"]]},{"id":30,"start":152.32,"end":157.06,"text":"Bjørnar og Ingrid har ikke ferie nå, men de har fri i dag.","zh":"比约纳尔和英格丽现在都没放假，但他们今天休息。","words":[[0,7,152.38,153.04,"bjørnar"],[8,10,153.04,153.2,"og"],[11,17,153.2,153.62,"ingrid"],[18,21,153.62,153.9,"har"],[22,26,153.9,154.26,"ikke"],[27,32,154.26,154.72,"ferie"],[33,35,154.72,155.03,"nå~d531d47a7712"],[37,40,155.38,155.52,"men"],[41,43,155.52,155.64,"de"],[44,47,155.64,155.88,"har"],[48,51,155.88,156.24,"fri"],[52,53,156.42,156.54,"i~de136e71704d"],[54,57,156.54,156.91,"dag"]]},{"id":31,"start":158.43,"end":161.81,"text":"Ingrid har lyst til å bade, for hun er varm.","zh":"英格丽想去游泳，因为她很热。","words":[[0,6,158.49,158.98,"ingrid"],[7,10,158.98,159.12,"har"],[11,15,159.12,159.48,"lyst~b499524f55a4"],[16,19,159.48,159.66,"til~99ccdd3453b0"],[20,21,159.66,159.74,"å~0583da7a620a"],[22,26,159.74,160.31,"bade"],[28,31,160.7,160.9,"for~a05c87659379"],[32,35,160.9,161.08,"hun"],[36,38,161.08,161.26,"er"],[39,43,161.26,161.66,"varm"]]},{"id":32,"start":162.76,"end":168.93,"text":"Håvard og Marit vil ikke være med, men Bjørnar vil gjerne bade med Ingrid.","zh":"霍瓦尔和玛丽特不想一起去，但比约纳尔很想和英格丽一起游泳。","words":[[0,6,162.82,163.4,"håvard"],[7,9,163.4,163.54,"og"],[10,15,163.54,164.28,"marit"],[16,19,164.28,164.56,"vil"],[20,24,164.56,164.84,"ikke"],[25,29,164.84,165.14,"være"],[30,33,165.14,165.48,"med~ec12f15cf236"],[35,38,165.74,166.12,"men"],[39,46,166.12,166.88,"bjørnar"],[47,50,167.06,167.26,"vil"],[51,57,167.26,167.64,"gjerne"],[58,62,167.64,168.2,"bade"],[63,66,168.2,168.4,"med"],[67,73,168.4,168.78,"ingrid"]]}],"lexicon":{"10":{"lemma":"10","zh":"数字 10","pos":"数词","ref":"basics:numbers:ti","clip":null,"kind":"number"},"13":{"lemma":"13","zh":"数字 13","pos":"数词","ref":"basics:numbers:tretten","clip":null,"kind":"number"},"25":{"lemma":"25","zh":"数字 25","pos":"数词","ref":"basics:numbers:tjuefem","clip":null,"kind":"number"},"4":{"lemma":"4","zh":"数字 4","pos":"数词","ref":"basics:numbers:fire","clip":null,"kind":"number"},"5":{"lemma":"5","zh":"数字 5","pos":"数词","ref":"basics:numbers:fem","clip":null,"kind":"number"},"5.2":{"lemma":"5.2","zh":"第 5.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"august":{"lemma":"august","zh":"八月","pos":"名词","ref":"2-029","clip":"pronunciation/c2afdd38565b01f278bc.mp3"},"av":{"lemma":"av","zh":"……的；从；由","po