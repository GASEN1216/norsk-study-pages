{"id":"pa-vei-2.C","bookId":"pa-vei-textbook","readingId":"2.C","title":"Hvordan går det?","audio":"audio/pa-vei/2.C.mp3","duration":103.416,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.52,"end":4.905,"text":"C. Hvordan går det?","zh":"C. 最近怎么样？","words":[[0,1,2.52,3.06,"c"],[3,10,4.04,4.445,"hvordan"],[11,14,4.5,4.752,"går"],[15,18,4.752,4.905,"det"]]},{"id":1,"start":6.9,"end":7.765,"text":"Hallo Haifa!","zh":"你好，海法！","words":[[0,5,6.9,7.245,"hallo"],[6,11,7.36,7.765,"haifa"]],"speaker":"Torunn"},{"id":2,"start":8.78,"end":9.485,"text":"Hei Torunn!","zh":"嗨，托伦！","words":[[0,3,8.78,8.985,"hei"],[4,10,9.02,9.485,"torunn"]],"speaker":"Haifa"},{"id":3,"start":10.52,"end":13.025,"text":"Dette er Magnus. Han kommer fra Bergen.","zh":"这位是马格努斯。他来自卑尔根。","words":[[0,5,10.52,10.762,"dette"],[6,8,10.762,10.873,"er"],[9,15,10.873,11.345,"magnus"],[17,20,11.94,12.092,"han"],[21,27,12.092,12.373,"kommer"],[28,31,12.373,12.545,"fra"],[32,38,12.64,13.025,"bergen"]],"speaker":"Haifa"},{"id":4,"start":13.85,"end":14.935,"text":"Han jobber på en ...","zh":"他在一家……工作。","words":[[0,3,13.85,14.015,"han"],[4,10,14.27,14.593,"jobber"],[11,13,14.593,14.715,"på"],[14,16,14.77,14.935,"en"]],"speaker":"Haifa"},{"id":5,"start":16.45,"end":17.635,"text":"Hva heter det på norsk?","zh":"这个用挪威语怎么说？","words":[[0,3,16.45,16.615,"hva"],[4,9,16.69,16.972,"heter"],[10,13,16.972,17.102,"det"],[14,16,17.102,17.215,"på"],[17,22,17.23,17.635,"norsk"]],"speaker":"Haifa"},{"id":6,"start":18.71,"end":19.875,"text":"Et verksted.","zh":"修理厂。","words":[[0,2,18.71,18.995,"et"],[3,11,19.19,19.875,"verksted"]],"speaker":"Magnus"},{"id":7,"start":20.82,"end":23.535,"text":"Å ja! Han jobber på et verksted.","zh":"啊，对！他在一家修理厂工作。","words":[[0,1,20.82,20.98,"å"],[2,4,21.01,21.175,"ja"],[6,9,21.91,22.115,"han"],[10,16,22.31,22.615,"jobber"],[17,19,22.63,22.752,"på"],[20,22,22.752,22.915,"et"],[23,31,22.95,23.535,"verksted"]],"speaker":"Haifa"},{"id":8,"start":24.94,"end":27.105,"text":"Hei! Hyggelig å hilse på deg!","zh":"你好！很高兴认识你！","words":[[0,3,24.94,25.045,"hei"],[5,13,25.9,26.352,"hyggelig"],[14,15,26.352,26.433,"å"],[16,21,26.433,26.782,"hilse"],[22,24,26.782,26.905,"på"],[25,28,26.92,27.105,"deg"]],"speaker":"Magnus"},{"id":9,"start":27.94,"end":31.005,"text":"I like måte. Hvordan går det, Haifa?","zh":"我也一样。海法，你最近怎么样？","words":[[0,1,27.94,28.045,"i"],[2,6,28.06,28.383,"like@pa-vei-like-same"],[7,11,28.383,28.765,"måte"],[13,20,29.74,30.145,"hvordan"],[21,24,30.18,30.453,"går"],[25,28,30.453,30.605,"det"],[30,35,30.66,31.005,"haifa"]],"speaker":"Torunn"},{"id":10,"start":32.36,"end":35.365,"text":"Takk, bare bra. Og hvordan har du det?","zh":"谢谢，挺好的。你过得怎么样？","words":[[0,4,32.36,32.685,"takk"],[6,10,32.92,33.153,"bare"],[11,14,33.153,33.325,"bra"],[16,18,34.24,34.385,"og"],[19,26,34.54,34.862,"hvordan"],[27,30,34.862,35.013,"har"],[31,33,35.013,35.125,"du"],[34,37,35.18,35.365,"det"]],"speaker":"Haifa"},{"id":11,"start":36.41,"end":39.015,"text":"Ikke så verst. Men jeg jobber for mye.","zh":"还不错。不过我工作太多了。","words":[[0,4,36.41,36.712,"ikke"],[5,7,36.712,36.855,"så"],[8,13,36.89,37.255,"verst"],[15,18,37.73,37.882,"men"],[19,22,37.882,38.055,"jeg"],[23,29,38.07,38.455,"jobber"],[30,33,38.49,38.672,"for@pa-vei-for-excess"],[34,37,38.672,39.015,"mye"]],"speaker":"Torunn"},{"id":12,"start":40.35,"end":41.235,"text":"Hva gjør du?","zh":"你是做什么工作的？","words":[[0,3,40.35,40.535,"hva"],[4,8,40.73,41.055,"gjør"],[9,11,41.09,41.235,"du"]],"speaker":"Magnus"},{"id":13,"start":42.41,"end":46.035,"text":"Jeg jobber på en restaurant. Jeg er kelner.","zh":"我在一家餐馆工作。我是服务员。","words":[[0,3,42.41,42.615,"jeg"],[4,10,42.69,43.115,"jobber"],[11,13,43.17,43.315,"på"],[14,16,43.37,43.515,"en"],[17,27,43.55,44.095,"restaurant"],[29,32,45.11,45.295,"jeg"],[33,35,45.31,45.455,"er"],[36,42,45.49,46.035,"kelner"]],"speaker":"Torunn"},{"id":14,"start":47.57,"end":49.995,"text":"Og du, Haifa? Studerer du?","zh":"海法，你呢？你在读书吗？","words":[[0,2,47.57,47.692,"og"],[3,5,47.692,47.835,"du"],[7,12,47.87,48.235,"haifa"],[14,22,49.29,49.873,"studerer"],[23,25,49.873,49.995,"du"]],"speaker":"Torunn"},{"id":15,"start":51.51,"end":52.755,"text":"Jeg går på norskkurs.","zh":"我在上挪威语课程。","words":[[0,3,51.51,51.735,"jeg"],[4,7,51.83,52.032,"går"],[8,10,52.032,52.155,"på"],[11,20,52.19,52.755,"norskkurs"]],"speaker":"Haifa"},{"id":16,"start":53.81,"end":54.615,"text":"Hvordan går det?","zh":"学得怎么样？","words":[[0,7,53.81,54.175,"hvordan"],[8,11,54.19,54.415,"går"],[12,15,54.43,54.615,"det"]],"speaker":"Torunn"},{"id":17,"start":55.81,"end":57.835,"text":"Ganske bra. Jeg lærer mye.","zh":"相当不错。我学到了很多。","words":[[0,6,55.81,56.172,"ganske"],[7,10,56.172,56.315,"bra"],[12,15,57.11,57.273,"jeg"],[16,21,57.273,57.573,"lærer@pa-vei-lærer-learns"],[22,25,57.573,57.835,"mye"]],"speaker":"Haifa"},{"id":18,"start":62.89,"end":63.635,"text":"Sammendrag.","zh":"摘要","words":[[0,10,62.89,63.635,"sammendrag"]]},{"id":19,"start":65.31,"end":68.275,"text":"Haifa og Magnus snakker sammen.","zh":"海法和马格努斯在聊天。","words":[[0,5,65.31,65.875,"haifa"],[6,8,66.07,66.215,"og"],[9,15,66.27,66.875,"magnus"],[16,23,67.35,67.835,"snakker"],[24,30,67.91,68.275,"sammen"]]},{"id":20,"start":69.77,"end":73.395,"text":"Torunn kommer, og hun hilser på Magnus.","zh":"托伦过来了，和马格努斯打招呼。","words":[[0,6,69.77,70.395,"torunn"],[7,13,70.43,70.835,"kommer"],[15,17,71.55,71.695,"og"],[18,21,71.75,71.995,"hun"],[22,28,72.11,72.695,"hilser"],[29,31,72.73,72.855,"på"],[32,38,72.87,73.395,"magnus"]]},{"id":21,"start":75.51,"end":79.795,"text":"Torunn har det ganske bra, men hun jobber mye.","zh":"托伦过得挺好，不过她工作很多。","words":[[0,6,75.51,76.115,"torunn"],[7,10,76.19,76.453,"har"],[11,14,76.453,76.615,"det"],[15,21,76.63,77.195,"ganske"],[22,25,77.21,77.395,"bra"],[27,30,78.41,78.595,"men"],[31,34,78.63,78.815,"hun"],[35,41,78.89,79.355,"jobber"],[42,45,79.43,79.795,"mye"]]},{"id":22,"start":81.85,"end":83.945,"text":"Hun jobber på en restaurant.","zh":"她在一家餐馆工作。","words":[[0,3,81.85,82.075,"hun"],[4,10,82.21,82.635,"jobber"],[11,13,82.67,82.815,"på"],[14,16,82.85,82.995,"en"],[17,27,83.01,83.945,"restaurant"]]},{"id":23,"start":85.61,"end":88.115,"text":"Magnus jobber på et verksted.","zh":"马格努斯在一家修理厂工作。","words":[[0,6,85.61,86.235,"magnus"],[7,13,86.63,86.995,"jobber"],[14,16,87.05,87.175,"på"],[17,19,87.21,87.375,"et"],[20,28,87.39,88.115,"verksted"]]},{"id":24,"start":90.17,"end":92.215,"text":"Haifa går på norskkurs.","zh":"海法在上挪威语课程。","words":[[0,5,90.17,90.715,"haifa"],[6,9,91.01,91.255,"går"],[10,12,91.31,91.455,"på"],[13,22,91.51,92.215,"norskkurs"]]},{"id":25,"start":93.73,"end":95.195,"text":"Der lærer hun mye.","zh":"她在那里学到了很多。","words":[[0,3,93.73,94.095,"der"],[4,9,94.15,94.593,"lærer@pa-vei-lærer-learns"],[10,13,94.593,94.775,"hun"],[14,17,94.85,95.195,"mye"]]},{"id":26,"start":96.99,"end":100.595,"text":"De snakker norsk sammen, og det går fint.","zh":"他们用挪威语交谈，聊得很顺利。","words":[[0,2,96.99,97.135,"de"],[3,10,97.29,97.695,"snakker"],[11,16,97.75,98.095,"norsk@pa-vei-norsk-adjective"],[17,23,98.13,98.475,"sammen"],[25,27,99.27,99.415,"og"],[28,31,99.51,99.695,"det"],[32,35,99.77,100.035,"går"],[36,40,100.13,100.595,"fint"]]}],"lexicon":{"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"c":{"lemma":"C","pos":"字母","zh":"字母 C","ref":null,"clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form"