{"id":"pa-vei-16.E","bookId":"pa-vei-textbook","readingId":"16.E","title":"Rett til utdanning","audio":"audio/pa-vei/16.E.mp3","duration":104.976,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.1,"end":1.885,"text":"Grunnskolen","zh":"基础教育","words":[[0,11,1.1,1.885,"grunnskolen"]]},{"id":1,"start":4.54,"end":8.765,"text":"Barna her i landet begynner på skolen det året som de fyller seks år.","zh":"这个国家的孩子在满六岁的那一年开始上学。","words":[[0,5,4.54,4.945,"barna"],[6,9,4.98,5.192,"her"],[10,11,5.192,5.293,"i"],[12,18,5.293,5.625,"landet"],[19,27,5.82,6.182,"begynner"],[28,30,6.182,6.305,"på"],[31,37,6.32,6.785,"skolen"],[38,41,6.8,6.965,"det"],[42,46,7.04,7.322,"året"],[47,50,7.322,7.463,"som"],[51,53,7.463,7.585,"de"],[54,60,7.64,8.025,"fyller@pa-vei-extra-141"],[61,65,8.14,8.545,"seks"],[66,68,8.56,8.765,"år"]]},{"id":2,"start":10.158,"end":14.923,"text":"Barnetrinnet varer i sju år og ungdomstrinnet i tre år.","zh":"小学阶段七年，初中阶段三年。","words":[[0,12,10.158,11.063,"barnetrinnet@pa-vei-extra-144"],[13,18,11.338,11.64,"varer@pa-vei-extra-145"],[19,20,11.64,11.743,"i"],[21,24,11.838,12.043,"sju"],[25,27,12.158,12.343,"år"],[28,30,12.858,12.983,"og"],[31,45,13.038,13.783,"ungdomstrinnet@pa-vei-extra-146"],[46,47,14.038,14.143,"i"],[48,51,14.238,14.543,"tre"],[52,54,14.718,14.923,"år"]]},{"id":3,"start":16.338,"end":20.603,"text":"Barnetrinnet og ungdomstrinnet til sammen kaller vi grunnskolen.","zh":"小学阶段和初中阶段合起来，称为基础教育。","words":[[0,12,16.338,17.123,"barnetrinnet@pa-vei-extra-142"],[13,15,17.198,17.343,"og"],[16,30,17.398,18.181,"ungdomstrinnet@pa-vei-extra-143"],[31,34,18.181,18.343,"til"],[35,41,18.458,18.903,"sammen"],[42,48,19.318,19.7,"kaller"],[49,51,19.7,19.823,"vi"],[52,63,19.898,20.603,"grunnskolen"]]},{"id":4,"start":21.688,"end":26.093,"text":"Grunnskolen er obligatorisk, og skolen er gratis.","zh":"基础教育属于义务教育，学校免费。","words":[[0,11,21.688,22.313,"grunnskolen"],[12,14,22.408,22.653,"er"],[15,27,22.828,23.893,"obligatorisk"],[29,31,24.508,24.633,"og"],[32,38,24.648,25.093,"skolen"],[39,41,25.368,25.553,"er"],[42,48,25.568,26.093,"gratis"]]},{"id":5,"start":28.408,"end":29.533,"text":"Videregående","zh":"高中阶段教育","words":[[0,12,28.408,29.533,"videregående"]]},{"id":6,"start":30.968,"end":35.113,"text":"Etter grunnskolen kan elevene begynne på videregående skole.","zh":"完成基础教育后，学生可以进入高中阶段学校。","words":[[0,5,30.968,31.393,"etter"],[6,17,31.448,32.293,"grunnskolen"],[18,21,32.368,32.553,"kan"],[22,29,32.568,33.113,"elevene"],[30,37,33.168,33.613,"begynne"],[38,40,33.628,33.773,"på"],[41,53,33.888,34.77,"videregående"],[54,59,34.77,35.113,"skole"]]},{"id":7,"start":36.588,"end":44.113,"text":"Alle har rett til en plass i videregående opplæring, og nesten alle fortsetter på skolen etter grunnskolen.","zh":"人人都有接受高中阶段教育的权利，几乎所有人在完成基础教育后都会继续上学。","words":[[0,4,36.588,36.953,"alle"],[5,8,37.008,37.213,"har"],[9,13,37.228,37.531,"rett"],[14,17,37.531,37.693,"til"],[18,20,37.708,37.833,"en"],[21,26,37.868,38.253,"plass"],[27,28,38.348,38.473,"i"],[29,41,38.568,39.27,"videregående"],[42,51,39.27,39.793,"opplæring@pa-vei-extra-140"],[53,55,40.428,40.573,"og"],[56,62,40.648,41.013,"nesten"],[63,67,41.088,41.433,"alle"],[68,78,41.488,42.09,"fortsetter"],[79,81,42.09,42.233,"på"],[82,88,42.248,42.733,"skolen"],[89,94,43.048,43.433,"etter"],[95,106,43.448,44.113,"grunnskolen"]]},{"id":8,"start":45.588,"end":47.093,"text":"Skolen er gratis.","zh":"学校免费。","words":[[0,6,45.588,46.073,"skolen"],[7,9,46.168,46.393,"er"],[10,16,46.448,47.093,"gratis"]]},{"id":9,"start":48.548,"end":52.673,"text":"På videregående skole må man velge mellom ulike programmer.","zh":"在高中阶段，学生需要选择不同的课程方向。","words":[[0,2,48.548,48.693,"på"],[3,15,48.788,49.613,"videregående"],[16,21,49.628,50.013,"skole"],[22,24,50.088,50.233,"må"],[25,28,50.248,50.413,"man"],[29,34,50.468,50.953,"velge"],[35,41,50.988,51.353,"mellom"],[42,47,51.468,52.093,"ulike"],[48,58,52.108,52.673,"programmer"]]},{"id":10,"start":54.248,"end":60.733,"text":"Hvis man vil utdanne seg til et praktisk yrke, velger man et yrkesfaglig program.","zh":"如果想学习一门实用职业，就选择职业教育课程。","words":[[0,4,54.248,54.511,"hvis"],[5,8,54.511,54.66,"man"],[9,12,54.66,54.813,"vil"],[13,20,54.928,55.433,"utdanne"],[21,24,55.448,55.653,"seg"],[25,28,55.688,55.873,"til"],[29,31,55.888,56.053,"et"],[32,40,56.068,56.733,"praktisk@pa-vei-extra-150"],[41,45,56.748,57.113,"yrke"],[47,53,57.968,58.35,"velger"],[54,57,58.35,58.533,"man"],[58,60,58.668,58.853,"et"],[61,72,59.008,60.313,"yrkesfaglig"],[73,80,60.328,60.733,"program@pa-vei-extra-151"]]},{"id":11,"start":62.628,"end":66.693,"text":"Undervisningen er en kombinasjon av teori og praksis.","zh":"教学结合理论与实践。","words":[[0,14,62.628,63.473,"undervisningen"],[15,17,63.508,63.671,"er"],[18,20,63.671,63.793,"en"],[21,32,63.828,64.713,"kombinasjon"],[33,35,64.828,64.993,"av"],[36,41,65.048,65.513,"teori"],[42,44,65.928,66.073,"og"],[45,52,66.128,66.693,"praksis"]]},{"id":12,"start":68.548,"end":74.713,"text":"Etter to år på skolen kan man ha arbeidspraksis i en bedrift i to år.","zh":"在学校学习两年后，可以在企业实习两年。","words":[[0,5,68.548,68.853,"etter"],[6,8,68.868,69.053,"to"],[9,11,69.268,69.493,"år"],[12,14,69.548,69.693,"på"],[15,21,69.708,70.133,"skolen"],[22,25,70.588,70.77,"kan"],[26,29,70.77,70.93,"man"],[30,32,70.93,71.073,"ha"],[33,47,71.288,72.473,"arbeidspraksis"],[48,49,72.588,72.693,"i"],[50,52,72.748,72.873,"en"],[53,60,72.888,73.513,"bedrift"],[61,62,73.868,73.973,"i"],[63,65,74.088,74.273,"to"],[66,68,74.468,74.713,"år"]]},{"id":13,"start":76.248,"end":88.973,"text":"Da blir man kvalifisert til å jobbe som frisør, snekker, elektriker, mekaniker, kokk, barne- og ungdomsarbeider eller andre praktiske yrker.","zh":"这样就能具备资格，成为美发师、木工、电工、机械修理工、厨师、儿童及青少年服务工作者，或从事其他实用职业。","words":[[0,2,76.248,76.393,"da"],[3,7,76.508,76.733,"blir"],[8,11,76.748,76.933,"man"],[12,23,77.008,77.74,"kvalifisert@pa-vei-extra-147"],[24,27,77.74,77.88,"til"],[28,29,77.88,77.973,"å"],[30,35,77.988,78.333,"jobbe"],[36,39,78.368,78.593,"som@pa-vei-som-as"],[40,46,78.688,79.353,"frisør"],[48,55,79.928,80.513,"snekker"],[57,67,81.048,81.853,"elektriker"],[69,78,82.328,83.153,"mekaniker"],[80,84,83.828,84.233,"kokk"],[86,91,85.008,85.351,"barne"],[93,95,85.351,85.513,"og"],[96,111,85.528,86.453,"ungdomsarbeider"],[112,117,87.108,87.393,"eller"],[118,123,87.468,87.873,"andre"],[124,133,87.928,88.553,"praktiske"],[134,139,88.568,88.973,"yrker"]]},{"id":14,"start":90.848,"end":101.373,"text":"Hvis man vil studere ved universitet eller høyskole etter videregående skole, velger man et studieforberedende program med mer vekt på teori.","zh":"如果想在高中毕业后进入大学或高等学院，就选择更注重理论的升学预备课程。","words":[[0,4,90.848,91.111,"hvis"],[5,8,91.111,91.27,"man"],[9,12,91.27,91.433,"vil"],[13,20,91.468,91.971,"studere"],[21,24,91.971,92.113,"ved"],[25,36,92.128,93.071,"universitet"],[37,42,93.071,93.333,"eller"],[43,51,93.348,94.133,"høyskole"],[52,57,94.468,94.873,"etter"],[58,70,94.888,95.581,"videregående"],[71,76,95.581,95.933,"skole"],[78,84,96.668,97.03,"velger"],[85,88,97.03,97.193,"man"],[89,91,97.248,97.433,"et"],[92,110,97.488,98.891,"studieforberedende"],[111,118,98.891,99.293,"program@pa-vei-extra-148"],[119,122,99.928,100.093,"med"],[123,126,100.168,100.473,"mer"],[127,131,100.508,100.821,"vekt@pa-vei-extra-149"],[132,134,100.821,100.953,"på"],[135,140,100.968,101.373,"teori"]]},{"id":15,"start":102.708,"end":103.973,"text":"Det tar tre år.","zh":"这类课程需要三年。","words":[[0,3,102.708,102.893,"det"],[4,7,102.968,103.273,"tar"],[8,11,103.408,103.633,"tre"],[12,14,103.748,103.973,"år"]]}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"arbeidspraksis":{"lemma":"arbeidspraksis","zh":"工作实习","pos":"名词","ref":"pa-vei-16-093","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":nu