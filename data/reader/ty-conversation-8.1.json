{"id":"ty-conversation-8.1","bookId":"ty-conversation-guide","readingId":"8.1","title":"Meeting the family","audio":"audio/ty-conversation/8.1.mp3","duration":52.349388,"synthetic":false,"sentences":[{"id":0,"start":16.77,"end":19.135,"speaker":"Martin","text":"Hei Olav! Velkommen til oss!","zh":"你好，奥拉夫！欢迎来我们家！","words":[[0,3,16.77,16.995,"hei"],[4,8,17.13,17.495,"olav"],[10,19,18.03,18.635,"velkommen"],[20,23,18.71,18.873,"til"],[24,27,18.873,19.135,"oss"]]},{"id":1,"start":20.05,"end":21.675,"speaker":"Olav","text":"Hei! Fint å se deg.","zh":"你好！很高兴见到你。","words":[[0,3,20.05,20.335,"hei"],[5,9,20.87,21.203,"fint@ty-fint-greeting"],[10,11,21.203,21.292,"å"],[12,14,21.292,21.435,"se@ty-see-person"],[15,18,21.49,21.675,"deg"]]},{"id":2,"start":22.41,"end":25.995,"speaker":"Martin","text":"Dette er min kone, Marit. Hun er lærer.","zh":"这是我妻子玛丽特。她是老师。","words":[[0,5,22.41,22.755,"dette@ty-dette-introduction"],[6,8,22.83,22.962,"er@ty-be-identity"],[9,12,22.962,23.155,"min"],[13,17,23.17,23.595,"kone"],[19,24,23.83,24.295,"marit"],[26,29,24.95,25.155,"hun"],[30,32,25.37,25.535,"er@ty-be-identity"],[33,38,25.57,25.995,"lærer"]]},{"id":3,"start":27.15,"end":27.855,"speaker":"Olav","text":"Hei, Marit!","zh":"你好，玛丽特！","words":[[0,3,27.15,27.375,"hei"],[5,10,27.39,27.855,"marit"]]},{"id":4,"start":28.47,"end":32.035,"speaker":"Martin","text":"Og dette er vår datter, Ingrid. Hun er seks år.","zh":"这是我们的女儿英格丽。她六岁了。","words":[[0,2,28.47,28.595,"og"],[3,8,28.61,28.995,"dette@ty-dette-introduction"],[9,11,29.11,29.252,"er@ty-be-identity"],[12,15,29.252,29.413,"vår"],[16,22,29.413,29.775,"datter"],[24,30,29.93,30.315,"ingrid"],[32,35,30.85,31.055,"hun"],[36,38,31.17,31.335,"er@ty-be-age"],[39,43,31.41,31.755,"seks"],[44,46,31.81,32.035,"år"]]},{"id":5,"start":32.81,"end":34.195,"speaker":"Olav","text":"Fint å se deg, Ingrid!","zh":"很高兴见到你，英格丽！","words":[[0,4,32.81,33.153,"fint@ty-fint-greeting"],[5,6,33.153,33.255,"å"],[7,9,33.33,33.535,"se@ty-see-person"],[10,13,33.63,33.815,"deg"],[15,21,33.85,34.195,"ingrid"]]},{"id":6,"start":34.99,"end":38.115,"speaker":"Martin","text":"Vår sønn er der borte. Han er tretten år.","zh":"我们的儿子在那边。他十三岁了。","words":[[0,3,34.99,35.175,"vår"],[4,8,35.25,35.555,"sønn"],[9,11,35.77,35.915,"er@ty-be-location"],[12,15,35.93,36.212,"der"],[16,21,36.212,36.535,"borte"],[23,26,37.09,37.273,"han"],[27,29,37.273,37.413,"er@ty-be-age"],[30,37,37.413,37.795,"tretten"],[38,40,37.93,38.115,"år"]]},{"id":7,"start":39.27,"end":42.735,"speaker":"Olav","text":"En gutt og en pike. Det er en fin familie.","zh":"一个男孩，一个女孩。真是美满的一家。","words":[[0,2,39.27,39.472,"en"],[3,7,39.472,39.815,"gutt"],[8,10,39.95,40.095,"og"],[11,13,40.11,40.352,"en"],[14,18,40.352,40.775,"pike"],[20,23,41.49,41.633,"det@ty-det-family"],[24,26,41.633,41.743,"er@ty-be-identity"],[27,29,41.743,41.875,"en"],[30,33,41.95,42.255,"fin"],[34,41,42.27,42.735,"familie"]]},{"id":8,"start":43.71,"end":47.235,"speaker":"Martin","text":"Ingrid er lik meg, men Sverre er lik Marit.","zh":"英格丽像我，而斯韦雷像玛丽特。","words":[[0,6,43.71,44.155,"ingrid"],[7,9,44.19,44.335,"er@ty-be-resemblance"],[10,13,44.35,44.675,"lik"],[14,17,44.71,44.935,"meg@ty-meg-object"],[19,22,45.37,45.555,"men"],[23,29,45.59,45.975,"sverre"],[30,32,46.35,46.492,"er@ty-be-resemblance"],[33,36,46.492,46.755,"lik"],[37,42,46.79,47.235,"marit"]]},{"id":9,"start":48.29,"end":49.955,"speaker":"Olav","text":"Jeg vil gjerne møte Sverre.","zh":"我想认识一下斯韦雷。","words":[[0,3,48.29,48.495,"jeg"],[4,7,48.51,48.675,"vil"],[8,14,48.71,49.075,"gjerne"],[15,19,49.13,49.572,"møte"],[20,26,49.572,49.955,"sverre"]]},{"id":10,"start":50.95,"end":52.235,"speaker":"Olav","text":"Jeg vil gjerne snakke med ham.","zh":"我想和他聊聊。","words":[[0,3,50.95,51.103,"jeg"],[4,7,51.103,51.233,"vil"],[8,14,51.233,51.575,"gjerne"],[15,21,51.61,51.953,"snakke"],[22,25,51.953,52.073,"med@ty-with-person"],[26,29,52.073,52.235,"ham"]]}],"lexicon":{"borte":{"lemma":"borte","zh":"那边（der borte：在那边）","pos":"副词","ref":null,"clip":null},"datter":{"lemma":"datter","zh":"女儿","pos":"名词","ref":"ty-conversation-8-002","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-family":{"lemma":"det","zh":"这（指刚才介绍的一家人）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性"},"dette@ty-dette-introduction":{"lemma":"dette","zh":"这（介绍家人）","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性","contextual":true,"baseKey":"dette","surface":"dette"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-age":{"lemma":"være","zh":"年龄是（……岁）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"er@ty-be-identity":{"lemma":"være","zh":"是","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"er@ty-be-location":{"lemma":"være","zh":"在（某处）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"er@ty-be-resemblance":{"lemma":"være","zh":"（er lik）与……相像","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"familie":{"lemma":"familie","zh":"家庭","pos":"名词","ref":"ty-conversation-8-005","clip":null},"fin":{"lemma":"fin","zh":"好的；美好的","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"通性"},"fint":{"lemma":"fin","zh":"好；太好了（表示赞同）","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"中性"},"fint@ty-fint-greeti