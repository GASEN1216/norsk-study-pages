{"id":"ty-conversation-8.1","bookId":"ty-conversation-guide","readingId":"8.1","title":"Meeting the family","audio":"audio/ty-conversation/8.1.mp3","duration":52.349388,"synthetic":false,"sentences":[{"id":0,"start":16.32,"end":19.36,"speaker":"Martin","text":"Hei Olav! Velkommen til oss!","zh":"你好，奥拉夫！欢迎来我们家！","words":[[0,3,16.32,17.04,"hei"],[4,8,17.18,17.5,"olav"],[10,19,18.06,18.72,"velkommen"],[20,23,18.72,18.96,"til"],[24,27,18.96,19.36,"oss"]]},{"id":1,"start":20.18,"end":21.9,"speaker":"Olav","text":"Hei! Fint å se deg.","zh":"你好！很高兴见到你。","words":[[0,3,20.18,20.76,"hei"],[5,9,20.88,21.24,"fint@ty-fint-greeting"],[10,11,21.24,21.38,"å"],[12,14,21.38,21.52,"se@ty-see-person"],[15,18,21.52,21.9,"deg"]]},{"id":2,"start":22.54,"end":26.44,"speaker":"Martin","text":"Dette er min kone, Marit. Hun er lærer.","zh":"这是我妻子玛丽特。她是老师。","words":[[0,5,22.54,22.82,"dette@ty-dette-introduction"],[6,8,22.82,23.0,"er@ty-be-identity"],[9,12,23.0,23.22,"min"],[13,17,23.22,23.76,"kone"],[19,24,23.76,24.68,"marit"],[26,29,25.04,25.28,"hun"],[30,32,25.28,25.64,"er@ty-be-identity"],[33,38,25.64,26.44,"lærer"]]},{"id":3,"start":27.2,"end":27.9,"speaker":"Olav","text":"Hei, Marit!","zh":"你好，玛丽特！","words":[[0,3,27.2,27.54,"hei"],[5,10,27.56,27.9,"marit"]]},{"id":4,"start":28.5,"end":32.12,"speaker":"Martin","text":"Og dette er vår datter, Ingrid. Hun er seks år.","zh":"这是我们的女儿英格丽。她六岁了。","words":[[0,2,28.5,28.78,"og"],[3,8,28.78,29.12,"dette@ty-dette-introduction"],[9,11,29.12,29.28,"er@ty-be-identity"],[12,15,29.28,29.44,"vår"],[16,22,29.44,29.94,"datter"],[24,30,29.94,30.32,"ingrid"],[32,35,30.94,31.14,"hun"],[36,38,31.14,31.44,"er@ty-be-age"],[39,43,31.44,31.86,"seks"],[44,46,31.86,32.12,"år"]]},{"id":5,"start":32.78,"end":34.22,"speaker":"Olav","text":"Fint å se deg, Ingrid!","zh":"很高兴见到你，英格丽！","words":[[0,4,32.78,33.16,"fint@ty-fint-greeting"],[5,6,33.16,33.42,"å"],[7,9,33.42,33.66,"se@ty-see-person"],[10,13,33.66,33.86,"deg"],[15,21,33.86,34.22,"ingrid"]]},{"id":6,"start":35.02,"end":38.2,"speaker":"Martin","text":"Vår sønn er der borte. Han er tretten år.","zh":"我们的儿子在那边。他十三岁了。","words":[[0,3,35.02,35.28,"vår"],[4,8,35.28,35.72,"sønn"],[9,11,35.72,35.98,"er@ty-be-location"],[12,15,35.98,36.3,"der"],[16,21,36.3,36.6,"borte"],[23,26,37.06,37.3,"han"],[27,29,37.3,37.46,"er@ty-be-age"],[30,37,37.46,37.92,"tretten"],[38,40,37.92,38.2,"år"]]},{"id":7,"start":39.26,"end":42.82,"speaker":"Olav","text":"En gutt og en pike. Det er en fin familie.","zh":"一个男孩，一个女孩。真是美满的一家。","words":[[0,2,39.26,39.52,"en"],[3,7,39.52,39.98,"gutt"],[8,10,39.98,40.16,"og"],[11,13,40.16,40.44,"en"],[14,18,40.44,40.84,"pike"],[20,23,41.52,41.68,"det@ty-det-family"],[24,26,41.68,41.78,"er@ty-be-identity"],[27,29,41.78,42.04,"en"],[30,33,42.04,42.3,"fin"],[34,41,42.3,42.82,"familie"]]},{"id":8,"start":42.82,"end":47.48,"speaker":"Martin","text":"Ingrid er lik meg, men Sverre er lik Marit.","zh":"英格丽像我，而斯韦雷像玛丽特。","words":[[0,6,42.82,44.16,"ingrid"],[7,9,44.16,44.42,"er@ty-be-resemblance"],[10,13,44.42,44.7,"lik"],[14,17,44.7,45.08,"meg@ty-meg-object"],[19,22,45.48,45.68,"men"],[23,29,45.68,46.14,"sverre"],[30,32,46.14,46.6,"er@ty-be-resemblance"],[33,36,46.6,46.82,"lik"],[37,42,46.82,47.48,"marit"]]},{"id":9,"start":48.34,"end":50.22,"speaker":"Olav","text":"Jeg vil gjerne møte Sverre.","zh":"我想认识一下斯韦雷。","words":[[0,3,48.34,48.54,"jeg"],[4,7,48.54,48.78,"vil"],[8,14,48.78,49.16,"gjerne"],[15,19,49.16,49.62,"møte"],[20,26,49.62,50.22,"sverre"]]},{"id":10,"start":50.96,"end":52.3,"speaker":"Olav","text":"Jeg vil gjerne snakke med ham.","zh":"我想和他聊聊。","words":[[0,3,50.96,51.14,"jeg"],[4,7,51.14,51.3,"vil"],[8,14,51.3,51.68,"gjerne"],[15,21,51.68,52.0,"snakke"],[22,25,52.0,52.12,"med@ty-with-person"],[26,29,52.12,52.3,"ham"]]}],"lexicon":{"borte":{"lemma":"borte","zh":"那边（der borte：在那边）","pos":"副词","ref":null,"clip":null},"datter":{"lemma":"datter","zh":"女儿","pos":"名词","ref":"ty-conversation-8-002","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-0