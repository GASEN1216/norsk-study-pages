{"id":"8.2","title":"Bjørnar liker å gå på loppemarked","audio":"audio/8.2.mp3","duration":141.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.56,"text":"8.2 Bjørnar liker å gå på loppemarked","heading":true,"zh":"8.2 比约纳尔喜欢逛跳蚤市场","words":[[0,3,0.15,1.24,"8.2"],[4,11,2.78,3.28,"bjørnar"],[12,17,3.28,4.02,"liker"],[18,19,4.02,4.22,"å~0583da7a620a"],[20,22,4.22,4.42,"gå"],[23,25,4.42,4.58,"på~6481cec2877e"],[26,37,4.58,5.48,"loppemarked"]]},{"id":1,"start":7.22,"end":12.54,"text":"Det er søndag, og Bjørnar er på loppemarked på en skole i byen.","zh":"今天是星期天，比约纳尔在城里一所学校举办的跳蚤市场上。","words":[[0,3,7.3,7.52,"det"],[4,6,7.52,7.72,"er"],[7,13,7.72,8.34,"søndag"],[15,17,8.86,8.98,"og"],[18,25,8.98,9.48,"bjørnar"],[26,28,9.48,9.9,"er"],[29,31,9.9,10.14,"på"],[32,43,10.14,10.96,"loppemarked"],[44,46,10.96,11.24,"på"],[47,49,11.24,11.38,"en~a939a9e56dc5"],[50,55,11.38,11.78,"skole"],[56,57,11.78,11.98,"i"],[58,62,11.98,12.46,"byen"]]},{"id":2,"start":13.59,"end":21.36,"text":"Han liker å kjøpe gamle, fine ting på loppemarked, og nå trenger han noen stoler til kjøkkenet.","zh":"他喜欢在跳蚤市场买些漂亮的旧东西，现在他需要几把厨房用的椅子。","words":[[0,3,13.67,13.97,"han"],[4,9,13.97,14.47,"liker"],[10,11,14.47,14.6,"å~0583da7a620a"],[12,17,14.6,15.04,"kjøpe"],[18,23,15.04,15.57,"gamle"],[25,29,15.57,15.91,"fine"],[30,34,15.91,16.3,"ting"],[35,37,16.3,16.57,"på"],[38,49,16.57,17.38,"loppemarked"],[51,53,18.04,18.23,"og"],[54,56,18.23,18.5,"nå~d531d47a7712"],[57,64,18.5,19.09,"trenger"],[65,68,19.09,19.32,"han"],[69,73,19.32,19.86,"noen~c766e2ef794d"],[74,80,19.86,20.41,"stoler"],[81,84,20.41,20.7,"til"],[85,94,20.7,21.28,"kjøkkenet"]]},{"id":3,"start":23.12,"end":26.74,"text":"På loppemarkedet selger de mange gamle møbler.","zh":"跳蚤市场上卖很多旧家具。","words":[[0,2,23.2,23.3,"på"],[3,16,23.3,24.34,"loppemarkedet"],[17,23,24.34,24.98,"selger~f868073ed2a9"],[24,26,24.98,25.14,"de"],[27,32,25.14,25.42,"mange"],[33,38,25.42,26.0,"gamle"],[39,45,26.0,26.66,"møbler"]]},{"id":4,"start":27.62,"end":34.12,"text":"De har også mange forskjellige ting, som klær, bøker, glass og servise.","zh":"他们还有各种各样的东西，比如衣服、书、玻璃杯和餐具。","words":[[0,2,27.7,27.82,"de"],[3,6,27.82,27.95,"har"],[7,11,27.95,28.25,"også"],[12,17,28.25,28.64,"mange"],[18,30,28.64,29.25,"forskjellige"],[31,35,29.25,29.61,"ting"],[37,40,29.61,30.34,"som~113dc5fb7c78"],[41,45,30.34,31.09,"klær"],[47,52,31.52,32.2,"bøker"],[54,59,32.66,33.02,"glass"],[60,62,33.02,33.34,"og"],[63,70,33.34,34.04,"servise"]]},{"id":5,"start":34.15,"end":36.78,"text":"Det er mye folk der.","zh":"那里人很多。","words":[[0,3,35.12,35.51,"det"],[4,6,35.51,35.62,"er"],[7,10,35.62,36.06,"mye~cc164d0dc3da"],[11,15,36.06,36.34,"folk"],[16,19,36.34,36.7,"der"]]},{"id":6,"start":37.54,"end":41.78,"text":"Noen går bare og kikker, men noen handler mye.","zh":"有些人只是逛逛看看，有些人则买很多东西。","words":[[0,4,37.62,38.09,"noen~8e23a4fd3f2f"],[5,8,38.09,38.31,"går"],[9,13,38.31,38.63,"bare"],[14,16,38.63,38.81,"og"],[17,23,38.81,39.13,"kikker"],[25,28,39.9,40.16,"men"],[29,33,40.16,40.81,"noen~8e23a4fd3f2f"],[34,41,40.81,41.13,"handler"],[42,45,41.13,41.7,"mye~933c5a923198"]]},{"id":7,"start":43.31,"end":46.15,"text":"Hei, Bjørnar! Er du også her i dag?","speaker":"Ingrid","zh":"嗨，比约纳尔！你今天也在这儿？","words":[[0,3,43.39,43.7,"hei"],[5,12,43.76,44.1,"bjørnar"],[14,16,44.82,44.98,"er"],[17,19,44.98,45.2,"du"],[20,24,45.2,45.52,"også"],[25,28,45.52,45.66,"her"],[29,30,45.66,45.8,"i~de136e71704d"],[31,34,45.8,46.07,"dag"]]},{"id":8,"start":47.04,"end":54.41,"text":"Hei, Ingrid! Så hyggelig å se deg. Leter du etter noe spesielt?","speaker":"Bjørnar","zh":"嗨，英格丽！见到你真高兴。你在找什么特别的东西吗？","words":[[0,3,47.12,47.63,"hei"],[5,11,47.69,47.95,"ingrid"],[13,15,49.01,49.45,"så~886058c79950"],[16,24,49.45,49.97,"hyggelig"],[25,26,49.97,50.13,"å~0583da7a620a"],[27,29,50.13,50.35,"se"],[30,33,50.35,50.63,"deg"],[35,40,52.18,52.74,"leter"],[41,43,52.74,52.92,"du"],[44,49,52.92,53.2,"etter~b63576d203db"],[50,53,53.2,53.44,"noe"],[54,62,53.44,54.33,"spesielt~a2e400cb9ca0"]]},{"id":9,"start":55.09,"end":58.98,"text":"Ja, jeg har så lyst til å kjøpe et nytt bord til leiligheten.","speaker":"Ingrid","zh":"是啊，我特别想给公寓买一张新桌子。","words":[[0,2,55.09,55.56,"ja"],[4,7,55.95,56.05,"jeg"],[8,11,56.05,56.19,"har"],[12,14,56.19,56.34,"så~648557b705d0"],[15,19,56.34,56.59,"lyst~b499524f55a4"],[20,23,56.59,56.73,"til~99ccdd3453b0"],[24,25,56.73,56.8,"å~0583da7a620a"],[26,31,56.8,57.2,"kjøpe"],[32,34,57.2,57.3,"et~054dde72f37b"],[35,39,57.3,57.62,"nytt"],[40,44,57.62,57.8,"bord"],[45,48,57.8,58.12,"til"],[49,60,58.12,58.9,"leiligheten"]]},{"id":10,"start":59.46,"end":60.68,"text":"Det er mye fint her.","zh":"这里有很多好东西。","words":[[0,3,59.54,59.65,"det"],[4,6,59.65,59.7,"er"],[7,10,59.7,60.01,"mye~cc164d0dc3da"],[11,15,60.01,60.27,"fint"],[16,19,60.27,60.6,"her"]]},{"id":11,"start":60.74,"end":68.28,"text":"Ja, det er mange fine møbler her. Jeg leter etter stoler til kjøkkenbordet.","speaker":"Bjørnar","zh":"是啊，这里有很多漂亮的家具。我在找配厨房餐桌的椅子。","words":[[0,2,60.98,61.82,"ja"],[4,7,62.06,62.16,"det"],[8,10,62.16,62.34,"er"],[11,16,62.34,62.76,"mange"],[17,21,62.76,63.04,"fine"],[22,28,63.04,63.52,"møbler"],[29,32,63.52,63.78,"her"],[34,37,65.09,65.44,"jeg"],[38,43,65.44,65.95,"leter"],[44,49,65.95,66.28,"etter~b63576d203db"],[50,56,66.28,66.95,"stoler"],[57,60,66.95,67.28,"til"],[61,74,67.28,68.2,"kjøkkenbordet"]]},{"id":12,"start":69.5,"end":72.45,"text":"Jeg så noen fine kjøkkenstoler der borte.","speaker":"Ingrid","zh":"我在那边看到了几把不错的厨房椅子。","words":[[0,3,69.58,69.82,"jeg"],[4,6,69.82,70.16,"så~cf8ba6a9aa04"],[7,11,70.16,70.42,"noen~c766e2ef794d"],[12,16,70.42,70.7,"fine"],[17,30,70.7,71.48,"kjøkkenstoler"],[31,34,71.48,71.88,"der"],[35,40,71.88,72.38,"borte~cb7d143048ae"]]},{"id":13,"start":72.5,"end":80.97,"text":"Det er mange stoler på loppemarkedet, og Bjørnar finner fire billige stoler.","zh":"跳蚤市场上有很多椅子，比约纳尔找到了四把便宜的椅子。","words":[[0,3,74.76,75.18,"det"],[4,6,75.18,75.32,"er"],[7,12,75.32,75.7,"mange"],[13,19,75.7,76.3,"stoler"],[20,22,76.3,76.56,"på"],[23,36,76.56,77.36,"loppemarkedet"],[38,40,77.88,78.22,"og"],[41,48,78.22,78.76,"bjørnar"],[49,55,78.76,79.32,"finner"],[56,60,79.32,79.7,"fire"],[61,68,79.7,80.28,"billige"],[69,75,80.28,80.89,"stoler"]]},{"id":14,"start":82.09,"end":87.12,"text":"Ingrid kjøper mange brukte bøker og et gammelt, fint bord.","zh":"英格丽买了很多旧书，还有一张漂亮的旧桌子。","words":[[0,6,82.17,82.57,"ingrid"],[7,13,82.57,83.31,"kjøper"],[14,19,83.31,83.63,"mange"],[20,26,83.63,84.17,"brukte~3819a7ece11c"],[27,32,84.17,84.63,"bøker"],[33,35,85.19,85.51,"og"],[36,38,85.51,85.67,"et~054dde72f37b"],[39,46,85.67,86.15,"gammelt"],[48,52,86.27,86.51,"fint"],[53,57,86.51,87.04,"bord"]]},{"id":15,"start":88.61,"end":93.54,"text":"Bjørnar har tilhenger på bilen og kjører bordet hjem til Ingrid.","zh":"比约纳尔的车上挂着拖车，他开车把桌子送到了英格丽家。","words":[[0,7,88.69,89.11,"bjørnar"],[8,11,89.11,89.39,"har"],[12,21,89.39,90.2,"tilhenger"],[22,24,90.2,90.41,"på"],[25,30,90.41,90.86,"bilen"],[31,33,90.86,91.34,"og"],[34,40,91.34,91.86,"kjører"],[41,47,91.86,92.28,"bordet"],[48,52,92.28,92.72,"hjem~219ed50dcc52"],[53,56,92.72,92.97,"til"],[57,63,92.97,93.46,"ingrid"]]},{"id":16,"start":94.56,"end":99.08,"text":"Han hjelper henne med å bære det inn, for det er litt tungt.","zh":"他帮她把桌子搬进去，因为桌子有点重。","words":[[0,3,94.64,94.83,"han"],[4,11,94.83,95.36,"hjelper"],[12,17,95.36,95.67,"henne"],[18,21,95.67,95.97,"med~41eec44f57d5"],[22,23,95.97,96.14,"å~0583da7a620a"],[24,28,96.14,96.47,"bære"],[29,32,96.47,96.64,"det"],[33,36,96.64,96.86,"inn"],[38,41,97.25,97.47,"for~1b22712a94b1"],[42,45,97.47,97.66,"det"],[46,48,97.66,97.92,"er"],[49,53,97.92,98.28,"litt~54360be2a478"],[54,59,98.28,99.0,"tungt"]]},{"id":17,"start":101.18,"end":102.91,"text":"Tusen takk for hjelpen, Bjørnar!","speaker":"Ingrid","zh":"非常感谢你的帮忙，比约纳尔！","words":[[0,5,101.26,101.62,"tusen"],[6,10,101.62,101.8,"takk"],[11,14,101.8,101.96,"for~713e6b1d2094"],[15,22,101.96,102.28,"hjelpen"],[24,31,102.38,102.83,"bjørnar"]]},{"id":18,"start":103.89,"end":109.02,"text":"Bare hyggelig, men kan du kanskje hjelpe meg med en ting?","speaker":"Bjørnar","zh":"不客气，不过你能不能也帮我一个忙？","words":[[0,4,103.97,104.4,"bare~44a0f28ba28c"],[5,13,104.4,104.86,"hyggelig~81cac59a5f58"],[15,18,105.83,106.17,"men"],[19,22,106.17,106.92,"kan"],[23,25,106.92,107.17,"du"],[26,33,107.17,107.61,"kanskje"],[34,40,107.61,108.11,"hjelpe"],[41,44,108.11,108.31,"meg"],[45,48,108.31,108.55,"med~41eec44f57d5"],[49,51,108.55,108.67,"en~a939a9e56dc5"],[52,56,108.67,108.94,"ting"]]},{"id":19,"start":109.87,"end":112.86,"text":"Ja, gjerne. Hva tenker du på?","speaker":"Ingrid","zh":"好啊，乐意帮忙。你说的是什么事？","words":[[0,2,109.95,110.33,"ja"],[4,10,110.45,110.89,"gjerne"],[12,15,111.45,111.79,"hva"],[16,22,111.79,112.33,"tenker"],[23,25,112.33,112.47,"du"],[26,28,112.47,112.78,"på~2246356e1d74"]]},{"id":20,"start":113.87,"end":118.89,"text":"Jeg trenger å klippe håret. Har du en ledig time en dag?","speaker":"Bjørnar","zh":"我需要剪头发。你哪天有空档可以预约吗？","words":[[0,3,113.95,114.32,"jeg"],[4,11,114.32,114.8,"trenger"],[12,13,114.8,114.94,"å~0583da7a620a"],[14,20,114.94,115.24,"klippe"],[21,26,115.24,115.62,"håret"],[28,31,116.89,117.31,"har"],[32,34,117.31,117.47,"du"],[35,37,117.47,117.65,"en~a939a9e56dc5"],[38,43,117.65,118.03,"ledig"],[44,48,118.03,118.33,"time~c3556719ddb6"],[49,51,118.33,118.51,"en~a939a9e56dc5"],[52,55,118.51,118.81,"dag"]]},{"id":21,"start":119.85,"end":125.7,"text":"Ja, selvfølgelig! Jeg kan klippe deg, og du kan hjelpe meg med å finne en ny bil!","speaker":"Ingrid","zh":"当然可以！我给你剪头发，你帮我找一辆新车！","words":[[0,2,119.93,120.19,"ja"],[4,16,120.25,121.01,"selvfølgelig"],[18,21,121.53,121.95,"jeg"],[22,25,121.95,122.11,"kan"],[26,32,122.11,122.39,"klippe"],[33,36,122.39,122.63,"deg"],[38,40,123.09,123.23,"og"],[41,43,123.23,123.43,"du"],[44,47,123.43,123.57,"kan"],[48,54,123.57,123.89,"hjelpe"],[55,58,123.89,124.17,"meg"],[59,62,124.17,124.53,"med~41eec44f57d5"],[63,64,124.53,124.63,"å~0583da7a620a"],[65,70,124.63,124.89,"finne"],[71,73,124.89,125.09,"en~a939a9e56dc5"],[74,76,125.09,125.25,"ny"],[77,80,125.25,125.62,"bil"]]},{"id":22,"start":126.6,"end":128.96,"text":"Ja, det er en avtale!","speaker":"Bjørnar","zh":"好，一言为定！","words":[[0,2,126.68,126.95,"ja"],[4,7,127.42,127.64,"det"],[8,10,127.64,128.03,"er"],[11,13,128.03,128.16,"en~a939a9e56dc5"],[14,20,128.16,128.88,"avtale"]]},{"id":23,"start":130.06,"end":131.72,"text":"Hvilke dager passer?","speaker":"Ingrid","zh":"哪几天方便？","words":[[0,6,130.14,130.69,"hvilke"],[7,12,130.69,131.13,"dager"],[13,19,131.13,131.64,"passer"]]},{"id":24,"start":132.68,"end":134.35,"text":"Fredag eller lørdag.","speaker":"Bjørnar","zh":"星期五或星期六。","words":[[0,6,132.76,133.52,"fredag"],[7,12,133.52,133.74,"eller"],[13,19,133.74,134.27,"lørdag"]]},{"id":25,"start":135.42,"end":137.61,"text":"Ok. Jeg ringer deg i morgen.","speaker":"Ingrid","zh":"好的。我明天给你打电话。","words":[[0,2,135.5,135.82,"ok"],[4,7,136.32,136.48,"jeg"],[8,14,136.48,136.84,"ringer~2a328146b7c5"],[15,18,136.84,136.98,"deg"],[19,20,136.98,137.16,"i~46dcc9198d6d"],[21,27,137.16,137.53,"morgen"]]}],"lexicon":{"8.2":{"lemma":"8.2","zh":"第 8.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"avtale":{"lemma":"avtale","zh":"约定；预约；协议","pos":"名词","ref":"8-052","clip":"pronunciation/d517012e6195bf97a203.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","clip":"pronunciation/c03f6631cf7e0e1bcbd0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":"pronunciation/8310b03324c5d3e20cdc.mp3"},"billige":{"lemma":"billig","zh":"便宜的","pos":"形容词","ref":"8-022","form":"复数/定指","clip":null},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"bord":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","clip":"pronunciation/723eb5074aa9baa4b755.mp3"},"bordet":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","form":"单数定指","clip":null},"borte":{"lemma":"borte","zh":"不在；离开","pos":"副词","re