{"id":"pa-vei-14.C","bookId":"pa-vei-textbook","readingId":"14.C","title":"Johannas eplekake","audio":"audio/pa-vei/14.C.mp3","duration":78.24,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.02,"end":1.725,"text":"2 egg","zh":"2 个鸡蛋","words":[[0,1,1.02,1.205,"2"],[2,5,1.44,1.725,"egg"]]},{"id":1,"start":2.98,"end":4.925,"text":"1 1/2 dl sukker","zh":"1.5 分升糖","words":[[0,1,2.98,3.232,"1"],[2,5,3.232,3.782,"1/2"],[6,8,3.782,4.505,"dl"],[9,15,4.56,4.925,"sukker"]]},{"id":2,"start":6.9,"end":8.445,"text":"50 g margarin","zh":"50 克人造黄油","words":[[0,2,6.9,7.365,"50"],[3,4,7.38,7.625,"g@pa-vei-extra-155"],[5,13,7.82,8.445,"margarin"]]},{"id":3,"start":10.28,"end":12.765,"text":"1 1/2 dl lettmelk","zh":"1.5 分升低脂牛奶","words":[[0,1,10.28,10.572,"1"],[2,5,10.572,11.165,"1/2"],[6,8,11.32,12.005,"dl"],[9,17,12.2,12.765,"lettmelk"]]},{"id":4,"start":14.684,"end":16.629,"text":"3 dl hvetemel","zh":"3 分升小麦面粉","words":[[0,1,14.684,14.949,"3"],[2,4,15.104,15.869,"dl"],[5,13,15.984,16.629,"hvetemel"]]},{"id":5,"start":18.544,"end":20.349,"text":"2 teskjeer bakepulver","zh":"2 茶匙泡打粉","words":[[0,1,18.544,18.729,"2"],[2,10,18.924,19.609,"teskjeer"],[11,21,19.624,20.349,"bakepulver"]]},{"id":6,"start":21.864,"end":22.609,"text":"2 epler","zh":"2 个苹果","words":[[0,1,21.864,22.029,"2"],[2,7,22.184,22.609,"epler"]]},{"id":7,"start":23.964,"end":27.249,"text":"1 spiseskje sukker og 1 teskje kanel","zh":"1 汤匙糖和 1 茶匙肉桂粉","words":[[0,1,23.964,24.189,"1"],[2,11,24.244,24.809,"spiseskje"],[12,18,24.884,25.309,"sukker"],[19,21,25.924,26.069,"og"],[22,23,26.124,26.329,"1"],[24,30,26.384,26.827,"teskje"],[31,36,26.827,27.249,"kanel"]]},{"id":8,"start":30.504,"end":32.769,"text":"Pisk eggedosis av egg og sukker.","zh":"将鸡蛋和糖搅打至蓬松。","words":[[0,4,30.504,30.849,"pisk"],[5,14,30.864,31.649,"eggedosis"],[15,17,31.804,31.969,"av"],[18,21,32.004,32.249,"egg"],[22,24,32.264,32.386,"og"],[25,31,32.386,32.769,"sukker"]]},{"id":9,"start":35.304,"end":37.829,"text":"Hell i smeltet margarin