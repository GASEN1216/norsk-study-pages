{"id":"pa-vei-8.story","bookId":"pa-vei-textbook","readingId":"8.story","title":"Tor med hammeren","audio":"audio/pa-vei/8.story.mp3","duration":36.744,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.06,"end":3.825,"text":"Tor er en gammel germansk gud.","zh":"托尔是一位古老的日耳曼神。","words":[[0,3,1.06,1.465,"tor"],[4,6,1.74,1.882,"er"],[7,9,1.882,2.025,"en"],[10,16,2.08,2.565,"gammel"],[17,25,2.58,3.385,"germansk"],[26,29,3.5,3.825,"gud"]]},{"id":1,"start":4.94,"end":6.305,"text":"Han er gud for været.","zh":"他是掌管天气的神。","words":[[0,3,4.94,5.145,"han"],[4,6,5.16,5.305,"er"],[7,10,5.34,5.645,"gud"],[11,14,5.66,5.845,"for"],[15,20,5.88,6.305,"været"]]},{"id":2,"start":8.04,"end":10.925,"text":"Tor er stor og sterk og hjelpsom.","zh":"托尔高大、强壮，而且乐于助人。","words":[[0,3,8.04,8.365,"tor"],[4,6,8.42,8.565,"er"],[7,11,8.64,9.045,"stor"],[12,14,9.36,9.505,"og"],[15,20,9.54,10.085,"sterk"],[21,23,10.26,10.383,"og"],[24,32,10.383,10.925,"hjelpsom"]]},{"id":3,"start":12.3,"end":13.405,"text":"Men han blir ofte sint.","zh":"不过他常常发怒。","words":[[0,3,12.3,12.453,"men"],[4,7,12.453,12.572,"han"],[8,12,12.572,12.773,"blir"],[13,17,12.773,13.005,"ofte"],[18,22,13.04,13.405,"sint"]]},{"id":4,"start":14.996,"end":17.121,"text":"Da kaster han en hammer på fienden.","zh":"这时，他就把一把锤子掷向敌人。","words":[[0,2,14.996,15.121,"da"],[3,9,15.176,15.619,"kaster"],[10,13,15.619,15.761,"han"],[14,16,15.776,15.921,"en"],[17,23,15.976,16.441,"hammer"],[24,26,16.476,16.621,"på"],[27,34,16.636,17.121,"fienden"]]},{"id":5,"start":18.976,"end":23.881,"text":"Hammeren treffer alltid – og den kommer alltid tilbake til Tor etterpå!","zh":"锤子总能击中目标，而且之后总会回到托尔手里！","words":[[0,8,18.976,19.438,"hammeren"],[9,16,19.438,19.781,"treffer"],[17,23,19.876,20.341,"alltid"],[26,28,21.396,21.529,"og"],[29,32,21.529,21.678,"den"],[33,39,21.678,21.961,"kommer"],[40,46,22.016,22.389,"alltid"],[47,54,22.389,22.998,"tilbake"],[55,58,22.998,23.161,"til"],[59,62,23.196,23.468,"tor"],[63,70,23.468,23.881,"etterpå"]]},{"id":6,"start":26.216,"end":30.441,"text":"Tor kjører over himmelen i ei vogn med to geitebukker foran.","zh":"托尔乘着一辆由两只公山羊拉着的车，穿越天空。","words":[[0,3,26.216,26.541,"tor"],[4,10,26.596,27.041,"kjører"],[11,15,27.096,27.379,"over"],[16,24,27.379,27.881,"himmelen"],[25,26,27.956,28.059,"i"],[27,29,28.059,28.201,"ei"],[30,34,28.256,28.601,"vogn"],[35,38,28.936,29.081,"med"],[39,41,29.096,29.261,"to"],[42,53,29.336,30.139,"geitebukker"],[54,59,30.139,30.441,"foran"]]},{"id":7,"start":31.916,"end":35.781,"text":"Han lager mye bråk, og da blir det torden.","zh":"他发出很大的响声，于是便有了雷声。","words":[[0,3,31.916,32.081,"han"],[4,9,32.116,32.541,"lager"],[10,13,32.616,33.021,"mye"],[14,18,33.036,33.461,"bråk"],[20,22,34.236,34.381,"og"],[23,25,34.436,34.601,"da"],[26,30,34.936,35.148,"blir"],[31,34,35.148,35.301,"det"],[35,41,35.316,35.781,"torden"]]}],"lexicon":{"alltid":{"lemma":"alltid","pos":"副词","zh":"总是；一直","ref":null,"clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"bråk":{"lemma":"bråk","zh":"吵闹；噪音","pos":"名词","ref":"pa-vei-13-016","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"ei":{"lemma":"ei","pos":"冠词","form":"阴性","zh":"一（个）（阴性不定冠词）","ref":null,"clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"etterpå":{"lemma":"etterpå","zh":"之后","pos":"副词","ref":"4-030","clip":null},"fienden":{"lemma":"fiende","pos":"名词","zh":"敌人","ref":null,"clip":null,"form":"单数定指"},"for":{"lemma":"for","pos":"介词","zh":"为；对于；因为（依结构而定）","ref":null,"clip":null},"foran":{"lemma":"foran","pos":"介词","zh":"在……前面","ref":null,"clip":null},"gammel":{"lemma":"gammel","zh":"旧的；年老的","pos":"形容词","ref":"8-023","clip":null},"geitebukker":{"lemma":"geitebukk","pos":"名词","zh":"公山羊","ref":null,"clip":null,"form":"复数不定"},"germansk":{"lemma":"germansk","pos":"形容词","zh":"日耳曼的","ref":null,"clip":null},"gud":{"lemma":"gud","pos":"名词","zh":"神","ref":null,"clip":null},"hammer":{"lemma":"hammer","zh":"锤子","pos":"名词","ref":"9-125","clip":null},"hammeren":{"lemma":"hammer","zh":"锤子","pos":"名词","ref":"9-125","form":"单数定指","clip":null},"han":{"lemma":"han","zh":"他","pos":"代词","ref":"ty-conversation-8-008","clip":null,"form":"主格"},"himmelen":{"lemma":"himmel","pos":"名词","zh":"天空","ref":null,"clip":null,"form":"单数定指"},"hjelpsom":{"lemma":"hjelpsom","pos":"形容词","zh":"乐于助人的","ref":null,"clip":null},"i":{"lemma":"i","pos":"介词","zh":"在；于","ref":null,"clip":null},"kaster":{"lemma":"kaste","pos":"动词","zh":"扔；投掷","ref":null,"clip":null,"form":"现在时"},"kjører":{"lemma":"kjøre","zh":"开车；驾驶（kjøre 的现在时）","pos":"动词","ref":"pa-vei-4-088","form":"现在时","clip":null},"kommer":{"lemma":"komme","pos":"动词","zh":"来；到达","ref":null,"clip":null,"form":"现在时"},"lager":{"lemma":"lage","pos":"动词","zh":"做；制作","ref":null,"clip":null,"form":"现在时"},"med":{"lemma":"med","pos":"介词","zh":"和；与；带有；用","ref":null,"clip":null},"men":{"lemma":"men","zh":"但是","pos":"连词","ref":"ty-conversation-8-017","clip":null},"mye":{"lemma":"mye","pos":"数量词","zh":"许多；很（用于不可数数量或程度）","ref":null,"clip":null},"ofte":{"lemma":"ofte","zh":"经常","pos":"副词","ref":"4-083","clip":null},"og":{"lemma":"og","zh":"和；（Og du?）那你呢","pos":"连词","ref":"ty-conversation-1-021","clip":null},"over":{"lemma":"over","pos":"介词","zh":"在……上方；经过；超过","ref":null,"clip":null},"på":{"lemma":"på","zh":"在","pos":"介词","ref":"ty-conversation-1-022","clip":null},"sint":{"lemma":"sint","zh":"生气的","pos":"形容词","ref":"basics:feelings:sint","clip":null},"sterk":{"lemma":"sterk","zh":"强壮的；坚强的","pos":"形容词","ref":"pa-vei-14-067","clip":null},"stor":{"lemma":"stor","zh":"大的","pos":"形容词","ref":"ty-conversation-4-025","clip":null},"til":{"lemma":"til","zh":"到；往","pos":"介词","ref":"ty-conversation-3-020","clip":null},"tilbake":{"lemma":"tilbake","zh":"回来；返回","pos":"副词","ref":"ty-conversation-7-022","clip":null},"to":{"lemma":"to","zh":"二；两","pos":"数词","ref":"ty-conversation-11-024","clip":null},"tor":{"lemma":"Tor","pos":"专名","zh":"托尔（北欧神话中的雷神）","ref":null,"clip":null},"torden":{"lemma":"torden","zh":"雷","pos":"名词","ref":"basics:weather:torden","clip":null},"treffer":{"lemma":"treffe","zh":"遇见；碰见；击中","pos":"动词","ref":"9-054","form":"现在时","clip":null},"vogn":{"lemma":"vogn","pos":"名词","zh":"车；车厢","ref":null,"clip":null},"været":{"lemma":"vær","zh":"天气","pos":"名词","ref":"basics:weather:vær","form":"单数定指","clip":null}}}
