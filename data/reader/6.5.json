{"id":"6.5","title":"Yrkestekst: Jeg er hotellmedarbeider","audio":"audio/6.5.mp3","duration":113.52,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":6.57,"text":"6.5 Yrke: Jeg er hotellmedarbeider","heading":true,"zh":"6.5 职业：我是酒店员工","words":[[0,3,0.15,1.46,"6.5"],[4,8,2.46,2.88,"yrke"],[10,13,4.25,4.59,"jeg"],[14,16,4.59,4.99,"er"],[17,34,4.99,6.49,"hotellmedarbeider"]]},{"id":1,"start":8.62,"end":11.55,"text":"Jeg drømmer om å få jobb på et hotell.","zh":"我梦想在酒店找到工作。","words":[[0,3,8.7,9.13,"jeg"],[4,11,9.13,9.71,"drømmer~7b5338107788"],[12,14,9.71,9.95,"om~c3b51230349d"],[15,16,9.95,10.05,"å~0583da7a620a"],[17,19,10.05,10.21,"få~65b84e08cd43"],[20,24,10.21,10.55,"jobb"],[25,27,10.55,10.71,"på"],[28,30,10.71,10.85,"et~054dde72f37b"],[31,37,10.85,11.47,"hotell"]]},{"id":2,"start":12.5,"end":18.62,"text":"Nå har jeg språkpraksis som hotellmedarbeider og lærer litt om forskjellige yrker på et hotell.","zh":"现在我在做酒店员工的语言实习，也了解一些酒店里的各种职业。","words":[[0,2,12.58,12.85,"nå~d531d47a7712"],[3,6,12.85,13.11,"har"],[7,10,13.11,13.23,"jeg"],[11,23,13.23,14.29,"språkpraksis"],[24,27,14.29,14.63,"som~c709a39948bf"],[28,45,14.63,15.83,"hotellmedarbeider"],[46,48,15.83,16.15,"og"],[49,54,16.15,16.47,"lærer~0769c7af9c2d"],[55,59,16.47,16.67,"litt~462e893626a5"],[60,62,16.67,16.83,"om~52c0bdc828db"],[63,75,16.83,17.41,"forskjellige"],[76,81,17.41,17.81,"yrker"],[82,84,17.81,17.97,"på"],[85,87,17.97,18.09,"et~054dde72f37b"],[88,94,18.09,18.54,"hotell"]]},{"id":3,"start":19.89,"end":23.18,"text":"Jeg lærer mange nye ord og møter mange nordmenn.","zh":"我学到很多新词，也认识很多挪威人。","words":[[0,3,19.97,20.13,"jeg"],[4,9,20.13,20.43,"lærer~0769c7af9c2d"],[10,15,20.43,20.77,"mange"],[16,19,20.77,21.13,"nye"],[20,23,21.13,21.43,"ord"],[24,26,21.43,21.85,"og"],[27,32,21.85,22.23,"møter~f35e22745555"],[33,38,22.23,22.51,"mange"],[39,47,22.51,23.1,"nordmenn"]]},{"id":4,"start":24.14,"end":25.8,"text":"Jeg har hyggelige kollegaer.","zh":"我的同事们都很友好。","words":[[0,3,24.22,24.37,"jeg"],[4,7,24.37,24.51,"har"],[8,17,24.51,25.11,"hyggelige"],[18,27,25.11,25.72,"kollegaer"]]},{"id":5,"start":26.65,"end":28.39,"text":"De hjelper meg med språket.","zh":"他们帮我学语言。","words":[[0,2,26.73,26.99,"de"],[3,10,26.99,27.43,"hjelper"],[11,14,27.43,27.61,"meg"],[15,18,27.61,27.77,"med"],[19,26,27.77,28.31,"språket"]]},{"id":6,"start":28.68,"end":34.11,"text":"Noen dager jobber jeg i resepsjonen, og andre dager vasker jeg hotellrom.","zh":"有些日子我在前台工作，另一些日子我打扫酒店客房。","words":[[0,4,28.76,29.13,"noen~c766e2ef794d"],[5,10,29.13,29.53,"dager"],[11,17,29.53,30.11,"jobber~003ddb6d77e6"],[18,21,30.11,30.27,"jeg"],[22,23,30.27,30.37,"i"],[24,35,30.37,31.07,"resepsjonen"],[37,39,31.57,31.79,"og"],[40,45,31.79,32.11,"andre~0c69ef1e750c"],[46,51,32.11,32.53,"dager"],[52,58,32.53,33.13,"vasker~d85e5ad2a7d7"],[59,62,33.13,33.25,"jeg"],[63,72,33.25,34.03,"hotellrom"]]},{"id":7,"start":34.99,"end":38.23,"text":"Hva heter det på norsk?","speaker":"Hawa","zh":"这个用挪威语怎么说？","words":[[0,3,35.73,36.69,"hva"],[4,9,36.69,37.15,"heter"],[10,13,37.15,37.47,"det"],[14,16,37.47,37.63,"på~28f277571376"],[17,22,37.63,38.15,"norsk~4de5d75feae1"]]},{"id":8,"start":39.09,"end":40.99,"text":"Det er ei dyne.","speaker":"Kollega","zh":"这是一床被子。","words":[[0,3,39.17,39.49,"det"],[4,6,39.49,39.81,"er"],[7,9,39.81,40.13,"ei~47aa2d18e376"],[10,14,40.13,40.91,"dyne"]]},{"id":9,"start":42.8,"end":44.62,"text":"Hva heter det på norsk?","speaker":"Hawa","zh":"这个用挪威语怎么说？","words":[[0,3,42.88,43.09,"hva"],[4,9,43.09,43.37,"heter"],[10,13,43.37,43.79,"det"],[14,16,43.79,44.05,"på~28f277571376"],[17,22,44.05,44.54,"norsk~4de5d75feae1"]]},{"id":10,"start":45.71,"end":47.44,"text":"Det er et håndkle.","speaker":"Kollega","zh":"这是一条毛巾。","words":[[0,3,45.79,46.15,"det"],[4,6,46.15,46.43,"er"],[7,9,46.43,46.63,"et~054dde72f37b"],[10,17,46.63,47.36,"håndkle"]]},{"id":11,"start":50.41,"end":55.96,"text":"godinorsk.blogg.no","zh":"godinorsk.blogg.no（博客）","words":[[0,18,50.49,55.88,"godinorsk.blogg.no"]]},{"id":12,"start":57.95,"end":63.43,"text":"En dag i uka har jeg språkpraksis. Jeg jobber på et hotell.","zh":"我每周有一天做语言实习。我在一家酒店工作。","words":[[0,2,58.03,58.33,"en~a939a9e56dc5"],[3,6,58.33,58.55,"dag"],[7,8,58.55,58.73,"i~82e4f1cd42dc"],[9,12,58.73,59.17,"uka"],[13,16,59.17,59.65,"har"],[17,20,59.65,59.79,"jeg"],[21,33,59.79,60.95,"språkpraksis"],[35,38,61.87,62.23,"jeg"],[39,45,62.23,62.51,"jobber~003ddb6d77e6"],[46,48,62.51,62.69,"på"],[49,51,62.69,62.81,"et~054dde72f37b"],[52,58,62.81,63.35,"hotell"]]},{"id":13,"start":64.45,"end":69.64,"text":"Jeg støvsuger, tørker støv og vasker gulv og toaletter.","zh":"我用吸尘器打扫、擦灰，还清洗地板和厕所。","words":[[0,3,64.53,64.74,"jeg"],[4,13,64.74,65.66,"støvsuger"],[15,21,66.3,66.66,"tørker"],[22,26,66.66,67.24,"støv"],[27,29,67.24,67.78,"og"],[30,36,67.78,68.2,"vasker~0b7a00b6cd11"],[37,41,68.2,68.72,"gulv"],[42,44,68.72,68.88,"og"],[45,54,68.88,69.56,"toaletter"]]},{"id":14,"start":70.43,"end":72.41,"text":"På jobben har jeg en god kollega.","zh":"工作上我有一个好同事。","words":[[0,2,70.51,70.62,"på"],[3,9,70.62,71.02,"jobben"],[10,13,71.02,71.26,"har"],[14,17,71.26,71.38,"jeg"],[18,20,71.38,71.5,"en~a939a9e56dc5"],[21,24,71.5,71.74,"god"],[25,32,71.74,72.33,"kollega"]]},{"id":15,"start":72.8,"end":74.44,"text":"Han hjelper meg med språket.","zh":"他帮我学语言。","words":[[0,3,72.88,73.08,"han"],[4,11,73.08,73.44,"hjelper"],[12,15,73.44,73.62,"meg"],[16,19,73.62,73.76,"med"],[20,27,73.76,74.36,"språket"]]},{"id":16,"start":76.24,"end":79.32,"text":"Vi snakker norsk sammen, og det liker jeg.","zh":"我们一起说挪威语，我很喜欢这样。","words":[[0,2,76.32,76.49,"vi"],[3,10,76.49,76.83,"snakker"],[11,16,76.83,77.25,"norsk~4de5d75feae1"],[17,23,77.25,77.65,"sammen"],[25,27,78.13,78.39,"og"],[28,31,78.39,78.63,"det"],[32,37,78.63,79.01,"liker"],[38,41,79.01,79.24,"jeg"]]},{"id":17,"start":80.05,"end":81.39,"text":"Det går bra på jobben.","zh":"工作进展顺利。","words":[[0,3,80.13,80.23,"det"],[4,7,80.23,80.39,"går~c99701312eeb"],[8,11,80.39,80.71,"bra~9ed229260de6"],[12,14,80.71,80.89,"på"],[15,21,80.89,81.31,"jobben"]]},{"id":18,"start":82.12,"end":84.14,"text":"I går jobbet jeg i restauranten.","zh":"昨天我在餐厅工作。","words":[[0,1,82.2,82.39,"i~6dd791e81ade"],[2,5,82.39,82.55,"går~19c0ec0c547b"],[6,12,82.55,82.93,"jobbet"],[13,16,82.93,83.15,"jeg"],[17,18,83.15,83.33,"i"],[19,31,83.33,84.06,"restauranten"]]},{"id":19,"start":85.81,"end":86.69,"text":"Kommentar","subheading":true,"zh":"评论","words":[[0,9,85.89,86.61,"kommentar"]]},{"id":20,"start":88.53,"end":89.69,"text":"Hei Hawa.","zh":"嗨，哈娃。","words":[[0,3,88.61,89.02,"hei"],[4,8,89.22,89.61,"hawa"]]},{"id":21,"start":90.03,"end":91.33,"text":"Fint bilde!","zh":"照片真好看！","words":[[0,4,90.11,90.56,"fint"],[5,10,90.56,91.25,"bilde"]]},{"id":22,"start":91.71,"end":95.28,"text":"Hilsen Sompit på norskkurs. Smilefjes.","zh":"挪威语班的松皮特 敬上。（笑脸）","words":[[0,6,91.79,92.28,"hilsen"],[7,13,92.28,92.94,"sompit"],[14,16,92.94,93.18,"på"],[17,26,93.18,93.74,"norskkurs"],[28,37,94.4,95.2,"smilefjes"]]},{"id":23,"start":97.02,"end":98.08,"text":"Hei Hawa.","zh":"嗨，哈娃。","words":[[0,3,97.1,97.46,"hei"],[4,8,97.52,98.0,"hawa"]]},{"id":24,"start":98.46,"end":99.73,"text":"Du er flink.","zh":"你真棒。","words":[[0,2,98.54,98.76,"du"],[3,5,98.76,98.94,"er"],[6,11,98.94,99.65,"flink"]]},{"id":25,"start":99.93,"end":100.67,"text":"Hjerte.","zh":"（爱心）。","words":[[0,6,100.01,100.59,"hjerte"]]},{"id":26,"start":101.11,"end":102.6,"text":"Du har en bra blogg.","zh":"你的博客很不错。","words":[[0,2,101.19,101.34,"du"],[3,6,101.34,101.54,"har"],[7,9,101.54,101.72,"en~a939a9e56dc5"],[10,13,101.72,101.94,"bra~bbb83846e29f"],[14,19,101.94,102.52,"blogg"]]},{"id":27,"start":102.98,"end":104.14,"text":"Hilsen Viola.","zh":"维奥拉 敬上。","words":[[0,6,103.06,103.52,"hilsen"],[7,12,103.52,104.06,"viola"]]},{"id":28,"start":106.32,"end":110.65,"text":"Hei Sompit og Viola, tusen takk. Smilefjes.","zh":"嗨，松皮特和维奥拉，非常感谢。（笑脸）","words":[[0,3,106.4,106.82,"hei"],[4,10,107.02,107.44,"sompit"],[11,13,107.44,107.64,"og"],[14,19,107.64,108.06,"viola"],[21,26,108.58,108.96,"tusen"],[27,31,108.96,109.46,"takk"],[33,42,109.68,110.3,"smilefjes"]]},{"id":29,"start":110.66,"end":111.99,"text":"Hjerte, hjerte.","zh":"（爱心）（爱心）。","words":[[0,6,110.8,111.12,"hjerte"],[8,14,111.38,111.91,"hjerte"]]}],"lexicon":{"6.5":{"lemma":"6.5","zh":"第 6.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre","clip":"pronunciation/bd01b0b648c2c64eb1bd.mp3","ambiguous":true,"candidates":[{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre"},{"lemma":"andre","zh":"第二","pos":"序数词","ref":"basics:ordinals:andre"},{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式"}]},"bilde":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","clip":"pronunciation/99f9e61e48617bf3a743.mp3"},"blogg":{"lemma":"blogg","zh":"博客","pos":"名词","ref":"1-083","clip":"pronunciation/05cb9f53016184e96b58.mp3"},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"dager":{"lemma":"dag","zh":"天；日子","pos":"名词","form":"复数不定","ref":"basics:time:dag","clip":null},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"drømmer":{"lemma":"drømme","zh":"梦想；梦见（drømme om）","pos":"动词","form":"现在时","ref":"9-017","clip":null,"ambiguous":true,"candidates":[{"lemma":"drømme","zh":"梦想；梦见（drømme om）","pos":"动词","ref":"9-017","form":"现在时"},{"lemma":"drøm","zh":"梦想","pos":"名词","ref":"14-030","form":"复数不定"}]},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"dyne":{"lemma":"dyne","zh":"被子","pos":"名词","ref":"6-118","clip":"pronunciation/b2353a8bfb2d8c2cef4a.mp3"},"e