{"id":"6.4","title":"Når kom du til Norge?","audio":"audio/6.4.mp3","duration":165.53,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.17,"text":"6.4 Når kom du til Norge?","heading":true,"zh":"6.4 你是什么时候来挪威的？","words":[[0,3,0.15,1.34,"6.4"],[4,7,1.83,2.75,"når~a56a1c61425b"],[8,11,2.75,3.01,"kom~a03d8aa690db"],[12,14,3.01,3.29,"du"],[15,18,3.29,3.55,"til"],[19,24,3.55,4.09,"norge~546b56e35dd5"]]},{"id":1,"start":6.54,"end":9.22,"text":"Hawa er i butikken og handler.","zh":"哈娃在商店里买东西。","words":[[0,4,6.6,7.28,"hawa"],[5,7,7.28,7.54,"er"],[8,9,7.54,7.64,"i"],[10,18,7.64,8.46,"butikken"],[19,21,8.46,8.62,"og"],[22,29,8.62,9.07,"handler"]]},{"id":2,"start":10.41,"end":15.38,"text":"Hun har dårlig tid, for bussen går snart, og hun må betale.","zh":"她时间很紧，因为公交车马上就要开了，而她还得付钱。","words":[[0,3,10.47,10.88,"hun"],[4,7,10.88,11.14,"har"],[8,14,11.14,11.5,"dårlig~677e1deee0c0"],[15,18,11.5,12.0,"tid"],[20,23,12.46,12.66,"for~1b22712a94b1"],[24,30,12.66,13.02,"bussen"],[31,34,13.02,13.28,"går~43b7c4e9e92b"],[35,40,13.28,13.84,"snart"],[42,44,14.1,14.22,"og"],[45,48,14.22,14.44,"hun"],[49,51,14.44,14.7,"må"],[52,58,14.7,15.23,"betale"]]},{"id":3,"start":16.73,"end":20.83,"text":"Det er kø i butikken, og Hawa rekker ikke bussen.","zh":"商店里排着队，哈娃没赶上公交车。","words":[[0,3,16.79,17.02,"det"],[4,6,17.02,17.26,"er"],[7,9,17.26,17.66,"kø"],[10,11,17.66,17.76,"i"],[12,20,17.76,18.43,"butikken"],[22,24,19.02,19.14,"og"],[25,29,19.14,19.68,"hawa"],[30,36,19.68,20.02,"rekker"],[37,41,20.02,20.24,"ikke"],[42,48,20.24,20.68,"bussen"]]},{"id":4,"start":22.75,"end":27.19,"text":"Etterpå står Hawa på bussholdeplassen og ser etter bussen.","zh":"之后，哈娃站在公交车站张望着找公交车。","words":[[0,7,22.8,23.46,"etterpå"],[8,12,23.46,23.78,"står"],[13,17,23.78,24.22,"hawa"],[18,20,24.22,24.4,"på"],[21,37,24.4,25.52,"bussholdeplassen"],[38,40,25.84,26.02,"og"],[41,44,26.02,26.36,"ser"],[45,50,26.36,26.62,"etter~4167b5f3ddfe"],[51,57,26.62,27.04,"bussen"]]},{"id":5,"start":28.32,"end":32.1,"text":"En bil stopper, og ei dame snakker til Hawa.","zh":"一辆车停了下来，一位女士跟哈娃说话。","words":[[0,2,28.38,28.66,"en~a939a9e56dc5"],[3,6,28.66,29.02,"bil"],[7,14,29.02,29.59,"stopper"],[16,18,30.22,30.4,"og"],[19,21,30.4,30.58,"ei~47aa2d18e376"],[22,26,30.58,31.12,"dame"],[27,34,31.12,31.5,"snakker"],[35,38,31.5,31.66,"til"],[39,43,31.66,31.95,"hawa"]]},{"id":6,"start":33.65,"end":40.39,"text":"Hei, du går i klassen til Håvard, ikke sant? Jeg heter Marit og er samboeren til Håvard.","speaker":"Marit","zh":"你好，你是霍瓦尔班上的吧？我叫玛丽特，是霍瓦尔的同居伴侣。","words":[[0,3,33.71,34.17,"hei"],[5,7,34.66,34.9,"du"],[8,11,34.9,35.1,"går~40df3bcf82da"],[12,13,35.1,35.18,"i"],[14,21,35.18,35.58,"klassen"],[22,25,35.58,35.78,"til~8de1a9181f86"],[26,32,35.78,36.22,"håvard"],[34,38,36.22,36.42,"ikke"],[39,43,36.42,36.89,"sant~97286c740188"],[45,48,37.74,37.88,"jeg"],[49,54,37.88,38.2,"heter"],[55,60,38.2,38.84,"marit"],[61,63,38.84,38.96,"og"],[64,66,38.96,39.08,"er"],[67,76,39.08,39.68,"samboeren"],[77,80,39.68,39.84,"til~8de1a9181f86"],[81,87,39.84,40.24,"håvard"]]},{"id":7,"start":41.63,"end":50.19,"text":"Jeg heter Hawa. Hyggelig å hilse på deg. Jeg kom for sent og mistet bussen. Nå må jeg vente i en time.","speaker":"Hawa","zh":"我叫哈娃。很高兴认识你。我来晚了，错过了公交车。现在我得等一个小时。","words":[[0,3,41.7,41.98,"jeg"],[4,9,41.98,42.36,"heter"],[10,14,42.36,42.89,"hawa"],[16,24,43.56,43.98,"hyggelig"],[25,26,43.98,44.08,"å~0583da7a620a"],[27,32,44.08,44.42,"hilse"],[33,35,44.42,44.56,"på~588ffe6c89d8"],[36,39,44.56,44.91,"deg"],[41,44,45.86,46.06,"jeg"],[45,48,46.06,46.26,"kom~a03d8aa690db"],[49,52,46.26,46.46,"for~79c080957b12"],[53,57,46.46,46.84,"sent"],[58,60,46.84,46.92,"og"],[61,67,46.92,47.34,"mistet"],[68,74,47.34,47.89,"bussen"],[76,78,48.54,48.66,"nå~d531d47a7712"],[79,81,48.66,48.8,"må"],[82,85,48.8,48.96,"jeg"],[86,91,48.96,49.26,"vente"],[92,93,49.26,49.34,"i~c5353f834e0f"],[94,96,49.34,49.5,"en~a939a9e56dc5"],[97,101,49.5,50.04,"time"]]},{"id":8,"start":51.3,"end":54.3,"text":"Jeg kjører hjem nå. Vil du sitte på med meg?","speaker":"Marit","zh":"我现在开车回家。你要搭我的车吗？","words":[[0,3,51.37,51.6,"jeg"],[4,10,51.6,51.96,"kjører"],[11,15,51.96,52.2,"hjem~d6e7695d7250"],[16,18,52.2,52.52,"nå~d531d47a7712"],[20,23,53.0,53.16,"vil"],[24,26,53.16,53.3,"du"],[27,32,53.3,53.58,"sitte~3d9d9887dce1"],[33,35,53.58,53.74,"på~4902f40449cc"],[36,39,53.74,53.86,"med"],[40,43,53.86,54.15,"meg"]]},{"id":9,"start":55.51,"end":57.98,"text":"Ja, takk. Det vil jeg gjerne.","speaker":"Hawa","zh":"好的，谢谢。我很乐意。","words":[[0,2,55.57,55.86,"ja"],[4,8,55.86,56.34,"takk"],[10,13,56.9,57.08,"det"],[14,17,57.08,57.22,"vil"],[18,21,57.22,57.4,"jeg"],[22,28,57.4,57.84,"gjerne"]]},{"id":10,"start":59.97,"end":63.7,"text":"Hawa og Marit sitter i bilen og snakker sammen.","zh":"哈娃和玛丽特坐在车里聊天。","words":[[0,4,60.03,60.6,"hawa"],[5,7,60.6,60.74,"og"],[8,13,60.74,61.45,"marit"],[14,20,61.78,62.12,"sitter"],[21,22,62.12,62.2,"i"],[23,28,62.2,62.6,"bilen"],[29,31,62.6,62.72,"og"],[32,39,62.72,63.12,"snakker"],[40,46,63.12,63.55,"sammen"]]},{"id":11,"start":65.53,"end":67.2,"text":"Når kom du til Norge?","speaker":"Marit","zh":"你是什么时候来挪威的？","words":[[0,3,65.59,65.94,"når~a56a1c61425b"],[4,7,65.94,66.22,"kom~a03d8aa690db"],[8,10,66.22,66.38,"du"],[11,14,66.38,66.56,"til"],[15,20,66.56,67.05,"norge~546b56e35dd5"]]},{"id":12,"start":68.11,"end":81.15,"text":"Jeg kom til Norge for et år siden. Først bodde jeg på mottak i et halvt år. For fem måneder siden flyttet jeg til Eide, og for tre måneder siden begynte jeg på norskkurs.","speaker":"Hawa","zh":"我是一年前来挪威的。起初我在难民接待中心住了半年。五个月前我搬到了艾德，三个月前开始上挪威语课。","words":[[0,3,68.17,68.5,"jeg"],[4,7,68.5,68.74,"kom~a03d8aa690db"],[8,11,68.74,68.94,"til"],[12,17,68.94,69.32,"norge~546b56e35dd5"],[18,21,69.32,69.48,"for~d0291af9704a"],[22,24,69.48,69.68,"et~054dde72f37b"],[25,27,69.68,69.92,"år"],[28,33,69.92,70.46,"siden~9a3d2d89a980"],[35,40,71.36,71.72,"først"],[41,46,71.72,71.98,"bodde"],[47,50,71.98,72.14,"jeg"],[51,53,72.14,72.28,"på"],[54,60,72.28,72.86,"mottak"],[61,62,72.86,72.94,"i~64b450927f8b"],[63,65,72.94,73.14,"et~054dde72f37b"],[66,71,73.14,73.56,"halvt"],[72,74,73.56,73.96,"år"],[76,79,74.78,75.08,"for~d0291af9704a"],[80,83,75.08,75.54,"fem"],[84,91,75.54,76.02,"måneder"],[92,97,76.02,76.52,"siden~9a3d2d89a980"],[98,105,76.68,77.04,"flyttet"],[106,109,77.04,77.18,"jeg"],[110,113,77.18,77.42,"til"],[114,118,77.42,77.96,"eide~328ed7806158"],[120,122,78.12,78.26,"og"],[123,126,78.26,78.44,"for~d0291af9704a"],[127,130,78.44,78.76,"tre"],[131,138,78.76,79.18,"måneder"],[139,144,79.18,79.72,"siden~9a3d2d89a980"],[145,152,79.72,80.04,"begynte"],[153,156,80.04,80.2,"jeg"],[157,159,80.2,80.34,"på~a5541dd316b7"],[160,169,80.34,81.0,"norskkurs"]]},{"id":13,"start":82.33,"end":83.73,"text":"Du er god i norsk.","speaker":"Marit","zh":"你挪威语很好。","words":[[0,2,82.39,82.6,"du"],[3,5,82.6,82.76,"er"],[6,9,82.76,83.04,"god~6c18eace3e93"],[10,11,83.04,83.16,"i~794b026d6474"],[12,17,83.16,83.58,"norsk~4de5d75feae1"]]},{"id":14,"start":85.34,"end":98.49,"text":"Tusen takk. Jeg liker å lære norsk. Håvard er en flink lærer. For noen uker siden begynte jeg i språkpraksis på hotellet i sentrum. Jeg har lyst til å jobbe på hotell.","speaker":"Hawa","zh":"非常感谢。我喜欢学挪威语。霍瓦尔是个很棒的老师。几周前我开始在市中心的酒店做语言实习。我想在酒店工作。","words":[[0,5,85.41,85.86,"tusen"],[6,10,85.86,86.34,"takk"],[12,15,86.92,87.12,"jeg"],[16,21,87.12,87.54,"liker"],[22,23,87.54,87.64,"å~0583da7a620a"],[24,28,87.64,87.92,"lære"],[29,34,87.92,88.44,"norsk~4de5d75feae1"],[36,42,89.12,89.58,"håvard"],[43,45,89.58,89.72,"er"],[46,48,89.72,89.9,"en~a939a9e56dc5"],[49,54,89.9,90.32,"flink"],[55,60,90.32,90.88,"lærer~5a8d077d35fc"],[62,65,91.8,91.94,"for~d0291af9704a"],[66,70,91.94,92.18,"noen~c766e2ef794d"],[71,75,92.18,92.52,"uker"],[76,81,92.52,93.1,"siden~9a3d2d89a980"],[82,89,93.1,93.48,"begynte"],[90,93,93.48,93.6,"jeg"],[94,95,93.6,93.7,"i"],[96,108,93.7,94.7,"språkpraksis"],[109,111,94.7,94.84,"på"],[112,120,94.84,95.3,"hotellet"],[121,122,95.3,95.4,"i"],[123,130,95.4,96.0,"sentrum"],[132,135,96.76,96.92,"jeg"],[136,139,96.92,97.04,"har"],[140,144,97.04,97.24,"lyst~b499524f55a4"],[145,148,97.24,97.4,"til~99ccdd3453b0"],[149,150,97.4,97.48,"å~0583da7a620a"],[151,156,97.48,97.74,"jobbe"],[157,159,97.74,97.88,"på"],[160,166,97.88,98.34,"hotell"]]},{"id":15,"start":99.92,"end":104.15,"text":"Jeg håper du får jobb. Hva gjorde du i hjemlandet?","speaker":"Marit","zh":"希望你能找到工作。你在祖国时做什么？","words":[[0,3,99.98,100.14,"jeg"],[4,9,100.14,100.56,"håper"],[10,12,100.56,100.74,"du"],[13,16,100.74,100.98,"får"],[17,21,100.98,101.44,"jobb"],[23,26,102.4,102.66,"hva"],[27,33,102.66,103.06,"gjorde"],[34,36,103.06,103.24,"du"],[37,38,103.24,103.32,"i"],[39,49,103.32,104.0,"hjemlandet"]]},{"id":16,"start":105.55,"end":121.66,"text":"Jeg jobbet ikke i Somalia. Jeg studerte økonomi, og i helgene hjalp jeg mamma og pappa. I fritida likte jeg å være sammen med venner. Noen ganger laget jeg mat sammen med mamma. Det likte jeg godt.","speaker":"Hawa","zh":"我在索马里没有工作。我学的是经济学，周末帮爸爸妈妈的忙。空闲时我喜欢和朋友们在一起。有时我和妈妈一起做饭。我很喜欢那样。","words":[[0,3,105.61,106.0,"jeg"],[4,10,106.0,106.52,"jobbet"],[11,15,106.52,106.98,"ikke"],[16,17,106.98,107.12,"i"],[18,25,107.12,107.8,"somalia"],[27,30,108.18,108.34,"jeg"],[31,39,108.34,109.06,"studerte"],[40,47,109.06,109.72,"økonomi"],[49,51,110.24,110.36,"og"],[52,53,110.36,110.48,"i~898371af17e5"],[54,61,110.48,111.2,"helgene"],[62,67,111.38,111.7,"hjalp"],[68,71,111.7,111.86,"jeg"],[72,77,111.86,112.28,"mamma"],[78,80,112.28,112.4,"og"],[81,86,112.4,112.92,"pappa"],[88,89,113.72,113.88,"i"],[90,97,113.88,114.6,"fritida"],[98,103,114.72,115.04,"likte"],[104,107,115.04,115.22,"jeg"],[108,109,115.22,115.3,"å~0583da7a620a"],[110,114,115.3,115.54,"være"],[115,121,115.54,115.84,"sammen"],[122,125,115.84,115.98,"med"],[126,132,115.98,116.52,"venner"],[134,138,117.22,117.58,"noen~c766e2ef794d"],[139,145,117.58,118.16,"ganger"],[146,151,118.16,118.46,"laget~8790a82fb4ba"],[152,155,118.46,118.62,"jeg"],[156,159,118.62,118.96,"mat"],[160,166,118.96,119.26,"sammen"],[167,170,119.26,119.38,"med"],[171,176,119.38,119.86,"mamma"],[178,181,120.54,120.74,"det"],[182,187,120.74,121.02,"likte"],[188,191,121.02,121.18,"jeg"],[192,196,121.18,121.51,"godt~fbb8ecd3db7d"]]},{"id":17,"start":122.72,"end":130.28,"text":"Så hyggelig. Jeg liker også å lage mat. Nå er vi framme. Ha en fortsatt fin dag!","speaker":"Marit","zh":"真好。我也喜欢做饭。我们到了。祝你今天剩下的时间也过得愉快！","words":[[0,2,122.78,123.02,"så~f9f9625b612b"],[3,11,123.02,123.66,"hyggelig"],[13,16,124.36,124.62,"jeg"],[17,22,124.62,124.96,"liker"],[23,27,124.96,125.24,"også"],[28,29,125.24,125.32,"å~0583da7a620a"],[30,34,125.32,125.6,"lage"],[35,38,125.6,126.08,"mat"],[40,42,126.96,127.22,"nå~d531d47a7712"],[43,45,127.22,127.34,"er"],[46,48,127.34,127.5,"vi"],[49,55,127.5,128.02,"framme"],[57,59,128.76,128.94,"ha~809c3683ae58"],[60,62,128.94,129.1,"en~a939a9e56dc5"],[63,71,129.1,129.54,"fortsatt"],[72,75,129.54,129.78,"fin"],[76,79,129.78,130.12,"dag"]]},{"id":18,"start":131.54,"end":135.7,"text":"Takk i like måte! Vi ses! Takk for skyssen!","speaker":"Hawa","zh":"你也是！回头见！谢谢你载我！","words":[[0,4,131.6,132.0,"takk"],[5,6,132.0,132.1,"i"],[7,11,132.1,132.4,"like~96c08a97a401"],[12,16,132.4,132.9,"måte"],[18,20,133.56,133.78,"vi"],[21,24,133.78,134.31,"ses~b099a1904a4e"],[26,30,134.76,135.0,"takk"],[31,34,135.0,135.12,"for~713e6b1d2094"],[35,42,135.12,135.55,"skyssen"]]},{"id":19,"start":138.94,"end":140.08,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,139.0,139.93,"sammendrag"]]},{"id":20,"start":141.73,"end":148.08,"text":"Hawa handlet etter skolen, men hun hadde dårlig tid og mistet bussen hjem.","zh":"哈娃放学后去买东西，但她时间很紧，错过了回家的公交车。","words":[[0,4,141.79,142.38,"hawa"],[5,12,142.38,143.0,"handlet"],[13,18,143.0,143.38,"etter"],[19,25,143.38,143.98,"skolen"],[27,30,144.36,144.76,"men"],[31,34,144.76,144.96,"hun"],[35,40,144.96,145.3,"hadde"],[41,47,145.3,145.72,"dårlig~677e1deee0c0"],[48,51,145.72,146.24,"tid"],[52,54,146.5,146.62,"og"],[55,61,146.62,147.14,"mistet"],[62,68,147.14,147.58,"bussen"],[69,73,147.58,147.93,"hjem~9aae29640139"]]},{"id":21,"start":149.37,"end":153.71,"text":"Hawa får skyss med Marit, samboeren til Håvard.","zh":"哈娃搭上了玛丽特的便车，玛丽特是霍瓦尔的同居伴侣。","words":[[0,4,149.43,150.14,"hawa"],[5,8,150.14,150.42,"får"],[9,14,150.42,150.74,"skyss"],[15,18,150.74,150.92,"med"],[19,24,150.92,151.66,"marit"],[26,35,152.08,152.82,"samboeren"],[36,39,152.82,153.08,"til~8de1a9181f86"],[40,46,153.08,153.56,"håvard"]]},{"id":22,"start":154.9,"end":162.13,"text":"Hawa og Marit snakket sammen, og Hawa fortalte om norskkurset og språkpraksisen på hotellet.","zh":"哈娃和玛丽特聊了起来，哈娃讲了她的挪威语课和在酒店的语言实习。","words":[[0,4,154.96,155.54,"hawa"],[5,7,155.54,155.66,"og"],[8,13,155.66,156.18,"marit"],[14,21,156.18,156.64,"snakket"],[22,28,156.64,157.2,"sammen"],[30,32,157.58,157.84,"og"],[33,37,157.84,158.32,"hawa"],[38,46,158.32,158.9,"fortalte"],[47,49,158.9,159.06,"om~52c0bdc828db"],[50,61,159.06,159.98,"norskkurset"],[62,64,159.98,160.16,"og"],[65,79,160.16,161.28,"språkpraksisen"],[80,82,161.28,161.4,"på"],[83,91,161.4,161.98,"hotellet"]]}],"lexicon":{"6.4":{"lemma":"6.4","zh":"第 6.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"begynte":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","form":"过去时","clip":null},"betale":{"lemma":"betale","zh":"付钱；付款；支付","pos":"动词","ref":"6-091","clip":"pronunciation/9621dcd6288462bc93ec.mp3"},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","clip":"pronunciation/c03f6631cf7e0e1bcbd0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":"pronunciation/8310b03324c5d3e20cdc.mp3"},"bodde":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"6-073","form":"过去时","clip":null},"bussen":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","form":"单数定指","clip":null},"bussholdeplassen":{"lemma":"bussholdeplass","zh":"公交车站","pos":"名词","ref":"6-094","form":"单数定指","clip":null},"butikken":{"lemma":"butikk","zh":"商店","pos":"名词","ref":"6-086","form":"单数定指","clip":null},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","cli