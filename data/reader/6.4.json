{"id":"6.4","title":"Når kom du til Norge?","audio":"audio/6.4.mp3","duration":165.53,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.17,"text":"6.4 Når kom du til Norge?","heading":true,"zh":"6.4 你是什么时候来挪威的？","words":[[0,3,0.15,1.34,"6.4"],[4,7,1.83,2.75,"når~a56a1c61425b"],[8,11,2.75,3.01,"kom~a03d8aa690db"],[12,14,3.01,3.29,"du"],[15,18,3.29,3.55,"til"],[19,24,3.55,4.09,"norge~546b56e35dd5"]]},{"id":1,"start":6.5,"end":9.17,"text":"Hawa er i butikken og handler.","zh":"哈娃在商店里买东西。","words":[[0,4,6.58,7.06,"hawa"],[5,7,7.06,7.46,"er"],[8,9,7.46,7.6,"i"],[10,18,7.6,8.16,"butikken"],[19,21,8.16,8.56,"og"],[22,29,8.56,9.09,"handler"]]},{"id":2,"start":10.38,"end":15.31,"text":"Hun har dårlig tid, for bussen går snart, og hun må betale.","zh":"她时间很紧，因为公交车马上就要开了，而她还得付钱。","words":[[0,3,10.46,10.68,"hun"],[4,7,10.68,11.0,"har"],[8,14,11.0,11.42,"dårlig~677e1deee0c0"],[15,18,11.42,11.72,"tid"],[20,23,12.36,12.56,"for~1b22712a94b1"],[24,30,12.56,12.96,"bussen"],[31,34,12.96,13.14,"går~43b7c4e9e92b"],[35,40,13.14,13.58,"snart"],[42,44,14.14,14.16,"og"],[45,48,14.16,14.34,"hun"],[49,51,14.34,14.58,"må"],[52,58,14.58,15.23,"betale"]]},{"id":3,"start":16.69,"end":20.75,"text":"Det er kø i butikken, og Hawa rekker ikke bussen.","zh":"商店里排着队，哈娃没赶上公交车。","words":[[0,3,16.77,16.96,"det"],[4,6,16.96,17.16,"er"],[7,9,17.16,17.52,"kø"],[10,11,17.52,17.7,"i"],[12,20,17.7,18.2,"butikken"],[22,24,18.86,19.12,"og"],[25,29,19.12,19.5,"hawa"],[30,36,19.5,19.94,"rekker"],[37,41,19.94,20.18,"ikke"],[42,48,20.18,20.67,"bussen"]]},{"id":4,"start":22.71,"end":27.13,"text":"Etterpå står Hawa på bussholdeplassen og ser etter bussen.","zh":"之后，哈娃站在公交车站张望着找公交车。","words":[[0,7,22.79,23.32,"etterpå"],[8,12,23.32,23.66,"står"],[13,17,23.66,24.14,"hawa"],[18,20,24.14,24.34,"på"],[21,37,24.34,25.22,"bussholdeplassen"],[38,40,25.22,25.94,"og"],[41,44,25.94,26.26,"ser"],[45,50,26.26,26.54,"etter~4167b5f3ddfe"],[51,57,26.54,27.05,"bussen"]]},{"id":5,"start":28.29,"end":32.04,"text":"En bil stopper, og ei dame snakker til Hawa.","zh":"一辆车停了下来，一位女士跟哈娃说话。","words":[[0,2,28.38,28.59,"en~a939a9e56dc5"],[3,6,28.59,28.85,"bil"],[7,14,28.85,29.35,"stopper"],[16,18,30.13,30.33,"og"],[19,21,30.33,30.49,"ei~47aa2d18e376"],[22,26,30.49,30.89,"dame"],[27,34,30.89,31.47,"snakker"],[35,38,31.47,31.59,"til"],[39,43,31.59,31.96,"hawa"]]},{"id":6,"start":33.61,"end":40.34,"text":"Hei, du går i klassen til Håvard, ikke sant? Jeg heter Marit og er samboeren til Håvard.","speaker":"Marit","zh":"你好，你是霍瓦尔班上的吧？我叫玛丽特，是霍瓦尔的同居伴侣。","words":[[0,3,33.69,34.11,"hei"],[5,7,34.59,34.79,"du"],[8,11,34.79,35.03,"går~40df3bcf82da"],[12,13,35.03,35.17,"i"],[14,21,35.17,35.43,"klassen"],[22,25,35.43,35.67,"til~8de1a9181f86"],[26,32,35.67,36.19,"håvard"],[34,38,36.19,36.31,"ikke"],[39,43,36.31,36.55,"sant~97286c740188"],[45,48,37.63,37.83,"jeg"],[49,54,37.83,38.03,"heter"],[55,60,38.03,38.69,"marit"],[61,63,38.91,38.93,"og"],[64,66,38.93,38.99,"er"],[67,76,38.99,39.63,"samboeren"],[77,80,39.63,39.77,"til~8de1a9181f86"],[81,87,39.77,40.26,"håvard"]]},{"id":7,"start":41.6,"end":50.12,"text":"Jeg heter Hawa. Hyggelig å hilse på deg. Jeg kom for sent og mistet bussen. Nå må jeg vente i en time.","speaker":"Hawa","zh":"我叫哈娃。很高兴认识你。我来晚了，错过了公交车。现在我得等一个小时。","words":[[0,3,41.68,41.94,"jeg"],[4,9,41.94,42.24,"heter"],[10,14,42.24,42.64,"hawa"],[16,24,43.38,43.96,"hyggelig"],[25,26,43.96,44.04,"å~0583da7a620a"],[27,32,44.04,44.38,"hilse"],[33,35,44.38,44.52,"på~588ffe6c89d8"],[36,39,44.52,44.7,"deg"],[41,44,45.65,46.01,"jeg"],[45,48,46.01,46.17,"kom~a03d8aa690db"],[49,52,46.17,46.37,"for~79c080957b12"],[53,57,46.37,46.65,"sent"],[58,60,46.65,46.89,"og"],[61,67,46.89,47.27,"mistet"],[68,74,47.27,47.69,"bussen"],[76,78,48.35,48.63,"nå~d531d47a7712"],[79,81,48.63,48.75,"må"],[82,85,48.75,48.89,"jeg"],[86,91,48.89,49.21,"vente"],[92,93,49.21,49.33,"i~c5353f834e0f"],[94,96,49.33,49.33,"en~a939a9e56dc5"],[97,101,49.33,50.04,"time"]]},{"id":8,"start":50.45,"end":54.24,"text":"Jeg kjører hjem nå. Vil du sitte på med meg?","speaker":"Marit","zh":"我现在开车回家。你要搭我的车吗？","words":[[0,3,51.02,51.52,"jeg"],[4,10,51.52,51.9,"kjører"],[11,15,51.9,52.14,"hjem~d6e7695d7250"],[16,18,52.14,52.38,"nå~d531d47a7712"],[20,23,52.86,53.12,"vil"],[24,26,53.12,53.26,"du"],[27,32,53.26,53.44,"sitte~3d9d9887dce1"],[33,35,53.44,53.66,"på~4902f40449cc"],[36,39,53.66,53.82,"med"],[40,43,53.82,54.16,"meg"]]},{"id":9,"start":55.47,"end":58.03,"text":"Ja, takk. Det vil jeg gjerne.","speaker":"Hawa","zh":"好的，谢谢。我很乐意。","words":[[0,2,55.55,55.79,"ja"],[4,8,55.79,56.15,"takk"],[10,13,56.77,57.03,"det"],[14,17,57.03,57.19,"vil"],[18,21,57.19,57.33,"jeg"],[22,28,57.33,57.95,"gjerne"]]},{"id":10,"start":59.93,"end":63.64,"text":"Hawa og Marit sitter i bilen og snakker sammen.","zh":"哈娃和玛丽特坐在车里聊天。","words":[[0,4,60.01,60.49,"hawa"],[5,7,60.49,60.69,"og"],[8,13,60.69,61.25,"marit"],[14,20,61.25,61.99,"sitter"],[21,22,61.99,62.17,"i"],[23,28,62.17,62.51,"bilen"],[29,31,62.51,62.67,"og"],[32,39,62.67,63.03,"snakker"],[40,46,63.03,63.56,"sammen"]]},{"id":11,"start":65.5,"end":67.15,"text":"Når kom du til Norge?","speaker":"Marit","zh":"你是什么时候来挪威的？","words":[[0,3,65.58,65.83,"når~a56a1c61425b"],[4,7,65.83,66.07,"kom~a03d8aa690db"],[8,10,66.07,66.29,"du"],[11,14,66.29,66.47,"til"],[15,20,66.47,67.07,"norge~546b56e35dd5"]]},{"id":12,"start":68.07,"end":81.09,"text":"Jeg kom til Norge for et år siden. Først bodde jeg på mottak i et halvt år. For fem måneder siden flyttet jeg til Eide, og for tre måneder siden begynte jeg på norskkurs.","speaker":"Hawa","zh":"我是一年前来挪威的。起初我在难民接待中心住了半年。五个月前我搬到了艾德，三个月前开始上挪威语课。","words":[[0,3,68.15,68.41,"jeg"],[4,7,68.41,68.61,"kom~a03d8aa690db"],[8,11,68.61,68.81,"til"],[12,17,68.81,69.21,"norge~546b56e35dd5"],[18,21,69.21,69.41,"for~d0291af9704a"],[22,24,69.41,69.59,"et~054dde72f37b"],[25,27,69.59,69.81,"år"],[28,33,69.81,70.17,"siden~9a3d2d89a980"],[35,40,71.25,71.67,"først"],[41,46,71.67,71.95,"bodde"],[47,50,71.95,72.07,"jeg"],[51,53,72.07,72.23,"på"],[54,60,72.23,72.75,"mottak"],[61,62,72.75,72.91,"i~64b450927f8b"],[63,65,72.91,73.05,"et~054dde72f37b"],[66,71,73.05,73.47,"halvt"],[72,74,73.47,73.73,"år"],[76,79,74.37,74.93,"for~d0291af9704a"],[80,83,74.93,75.43,"fem"],[84,91,75.43,75.95,"måneder"],[92,97,75.95,76.29,"siden~9a3d2d89a980"],[98,105,76.29,77.01,"flyttet"],[106,109,77.01,77.11,"jeg"],[110,113,77.11,77.29,"til"],[114,118,77.29,77.71,"eide~328ed7806158"],[120,122,78.09,78.19,"og"],[123,126,78.19,78.37,"for~d0291af9704a"],[127,130,78.37,78.63,"tre"],[131,138,78.67,79.11,"måneder"],[139,144,79.11,79.43,"siden~9a3d2d89a980"],[145,152,79.43,80.01,"begynte"],[153,156,80.01,80.13,"jeg"],[157,159,80.13,80.27,"på~a5541dd316b7"],[160,169,80.27,81.01,"norskkurs"]]},{"id":13,"start":82.29,"end":83.67,"text":"Du er god i norsk.","speaker":"Marit","zh":"你挪威语很好。","words":[[0,2,82.37,82.53,"du"],[3,5,82.53,82.69,"er"],[6,9,82.69,82.95,"god~6c18eace3e93"],[10,11,82.95,83.11,"i~794b026d6474"],[12,17,83.11,83.59,"norsk~4de5d75feae1"]]},{"id":14,"start":85.31,"end":98.42,"text":"Tusen takk. Jeg liker å lære norsk. Håvard er en flink lærer. For noen uker siden begynte jeg i språkpraksis på hotellet i sentrum. Jeg har lyst til å jobbe på hotell.","speaker":"Hawa","zh":"非常感谢。我喜欢学挪威语。霍瓦尔是个很棒的老师。几周前我开始在市中心的酒店做语言实习。我想在酒店工作。","words":[[0,5,85.39,85.82,"tusen"],[6,10,85.82,86.08,"takk"],[12,15,86.76,87.02,"jeg"],[16,21,87.02,87.5,"liker"],[22,23,87.5,87.62,"å~0583da7a620a"],[24,28,87.62,87.84,"lære"],[29,34,87.84,88.24,"norsk~4de5d75feae1"],[36,42,89.04,89.52,"håvard"],[43,45,89.52,89.66,"er"],[46,48,89.66,89.84,"en~a939a9e56dc5"],[49,54,89.84,90.18,"flink"],[55,60,90.18,90.64,"lærer~5a8d077d35fc"],[62,65,91.48,91.92,"for~d0291af9704a"],[66,70,91.92,92.08,"noen~c766e2ef794d"],[71,75,92.08,92.44,"uker"],[76,81,92.44,92.8,"siden~9a3d2d89a980"],[82,89,92.8,93.42,"begynte"],[90,93,93.42,93.56,"jeg"],[94,95,93.56,93.72,"i"],[96,108,93.72,94.64,"språkpraksis"],[109,111,94.64,94.78,"på"],[112,120,94.78,95.3,"hotellet"],[121,122,95.3,95.34,"i"],[123,130,95.34,95.78,"sentrum"],[132,135,96.59,96.85,"jeg"],[136,139,96.85,96.99,"har"],[140,144,96.99,97.21,"lyst~b499524f55a4"],[145,148,97.21,97.33,"til~99ccdd3453b0"],[149,150,97.33,97.41,"å~0583da7a620a"],[151,156,97.41,97.67,"jobbe"],[157,159,97.67,97.81,"på"],[160,166,97.81,98.34,"hotell"]]},{"id":15,"start":99.87,"end":104.09,"text":"Jeg håper du får jobb. Hva gjorde du i hjemlandet?","speaker":"Marit","zh":"希望你能找到工作。你在祖国时做什么？","words":[[0,3,99.95,100.09,"jeg"],[4,9,100.09,100.51,"håper"],[10,12,100.51,100.67,"du"],[13,16,100.67,100.91,"får"],[17,21,100.91,101.25,"jobb"],[23,26,101.87,102.57,"hva"],[27,33,102.57,102.89,"gjorde"],[34,36,102.89,103.19,"du"],[37,38,103.19,103.31,"i"],[39,49,103.31,104.01,"hjemlandet"]]},{"id":16,"start":105.5,"end":121.6,"text":"Jeg jobbet ikke i Somalia. Jeg studerte økonomi, og i helgene hjalp jeg mamma og pappa. I fritida likte jeg å være sammen med venner. Noen ganger laget jeg mat sammen med mamma. Det likte jeg godt.","speaker":"Hawa","zh":"我在索马里没有工作。我学的是经济学，周末帮爸爸妈妈的忙。空闲时我喜欢和朋友们在一起。有时我和妈妈一起做饭。我很喜欢那样。","words":[[0,3,105.58,105.86,"jeg"],[4,10,105.86,106.36,"jobbet"],[11,15,106.36,106.7,"ikke"],[16,17,106.7,107.06,"i"],[18,25,107.06,107.5,"somalia"],[27,30,107.98,108.24,"jeg"],[31,39,108.24,108.86,"studerte"],[40,47,108.86,109.52,"økonomi"],[49,51,110.12,110.32,"og"],[52,53,110.32,110.44,"i~898371af17e5"],[54,61,110.44,110.98,"helgene"],[62,67,110.98,111.66,"hjalp"],[68,71,111.66,111.76,"jeg"],[72,77,111.76,112.14,"mamma"],[78,80,112.14,112.28,"og"],[81,86,112.28,112.7,"pappa"],[88,89,113.57,113.79,"i"],[90,97,113.79,114.39,"fritida"],[98,103,114.39,115.01,"likte"],[104,107,115.01,115.15,"jeg"],[108,109,115.15,115.25,"å~0583da7a620a"],[110,114,115.25,115.43,"være"],[115,121,115.43,115.79,"sammen"],[122,125,115.79,115.93,"med"],[126,132,115.93,116.27,"venner"],[134,138,117.09,117.49,"noen~c766e2ef794d"],[139,145,117.49,117.91,"ganger"],[146,151,117.91,118.43,"laget~8790a82fb4ba"],[152,155,118.43,118.55,"jeg"],[156,159,118.55,118.79,"mat"],[160,166,118.79,119.21,"sammen"],[167,170,119.21,119.33,"med"],[171,176,119.33,119.67,"mamma"],[178,181,120.29,120.67,"det"],[182,187,120.67,120.99,"likte"],[188,191,120.99,121.11,"jeg"],[192,196,121.11,121.52,"godt~fbb8ecd3db7d"]]},{"id":17,"start":122.68,"end":130.23,"text":"Så hyggelig. Jeg liker også å lage mat. Nå er vi framme. Ha en fortsatt fin dag!","speaker":"Marit","zh":"真好。我也喜欢做饭。我们到了。祝你今天剩下的时间也过得愉快！","words":[[0,2,122.76,122.96,"så~f9f9625b612b"],[3,11,122.96,123.48,"hyggelig"],[13,16,124.14,124.56,"jeg"],[17,22,124.56,124.9,"liker"],[23,27,124.9,125.18,"også"],[28,29,125.18,125.32,"å~0583da7a620a"],[30,34,125.32,125.54,"lage"],[35,38,125.54,125.78,"mat"],[40,42,126.42,127.14,"nå~d531d47a7712"],[43,45,127.14,127.3,"er"],[46,48,127.3,127.44,"vi"],[49,55,127.44,127.86,"framme"],[57,59,128.64,128.86,"ha~809c3683ae58"],[60,62,128.86,129.02,"en~a939a9e56dc5"],[63,71,129.02,129.44,"fortsatt"],[72,75,129.44,129.7,"fin"],[76,79,129.7,130.15,"dag"]]},{"id":18,"start":131.43,"end":135.65,"text":"Takk i like måte! Vi ses! Takk for skyssen!","speaker":"Hawa","zh":"你也是！回头见！谢谢你载我！","words":[[0,4,131.51,131.97,"takk"],[5,6,131.97,132.07,"i"],[7,11,132.07,132.31,"like~96c08a97a401"],[12,16,132.31,132.57,"måte"],[18,20,133.39,133.71,"vi"],[21,24,133.71,133.97,"ses~b099a1904a4e"],[26,30,134.65,134.97,"takk"],[31,34,134.97,135.09,"for~713e6b1d2094"],[35,42,135.09,135.57,"skyssen"]]},{"id":19,"start":138.9,"end":140.01,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,138.98,139.93,"sammendrag"]]},{"id":20,"start":141.49,"end":148.03,"text":"Hawa handlet etter skolen, men hun hadde dårlig tid og mistet bussen hjem.","zh":"哈娃放学后去买东西，但她时间很紧，错过了回家的公交车。","words":[[0,4,141.57,142.13,"hawa"],[5,12,142.13,142.83,"handlet"],[13,18,142.83,143.29,"etter"],[19,25,143.29,143.71,"skolen"],[27,30,144.21,144.55,"men"],[31,34,144.55,144.87,"hun"],[35,40,144.87,145.17,"hadde"],[41,47,145.17,145.61,"dårlig~677e1deee0c0"],[48,51,145.61,145.93,"tid"],[52,54,145.93,146.57,"og"],[55,61,146.57,147.03,"mistet"],[62,68,147.03,147.51,"bussen"],[69,73,147.51,147.95,"hjem~9aae29640139"]]},{"id":21,"start":149.33,"end":153.66,"text":"Hawa får skyss med Marit, samboeren til Håvard.","zh":"哈娃搭上了玛丽特的便车，玛丽特是霍瓦尔的同居伴侣。","words":[[0,4,149.41,149.91,"hawa"],[5,8,149.91,150.39,"får"],[9,14,150.39,150.63,"skyss"],[15,18,150.63,150.85,"med"],[19,24,150.85,151.49,"marit"],[26,35,151.97,152.71,"samboeren"],[36,39,152.71,152.94,"til~8de1a9181f86"],[40,46,152.97,153.58,"håvard"]]},{"id":22,"start":154.86,"end":162.07,"text":"Hawa og Marit snakket sammen, og Hawa fortalte om norskkurset og språkpraksisen på hotellet.","zh":"哈娃和玛丽特聊了起来，哈娃讲了她的挪威语课和在酒店的语言实习。","words":[[0,4,154.94,155.39,"hawa"],[5,7,155.39,155.61,"og"],[8,13,155.61,156.09,"marit"],[14,21,156.09,156.55,"snakket"],[22,28,156.55,157.01,"sammen"],[30,32,157.49,157.73,"og"],[33,37,157.73,158.17,"hawa"],[38,46,158.17,158.85,"fortalte"],[47,49,158.85,158.99,"om~52c0bdc828db"],[50,61,158.99,159.73,"norskkurset"],[62,64,159.73,160.07,"og"],[65,79,160.07,161.17,"språkpraksisen"],[80,82,161.17,161.35,"på"],[83,91,161.35,161.99,"hotellet"]]}],"lexicon":{"6.4":{"lemma":"6.4","zh":"第 6.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"begynte":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","form":"过去时","clip":null},"betale":{"lemma":"betale","zh":"支付","pos":"动词","ref":"6-091","clip":"pronunciation/9621dcd6288462bc93ec.mp3"},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","clip":"pronunciation/c03f6631cf7e0e1bcbd0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":"pronunciation/8310b03324c5d3e20cdc.mp3"},"bodde":{"lemma":"bo","zh":"居住","pos":"动词","ref":"6-073","form":"过去时","clip":null},"bussen":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","form":"单数定指","clip":null},"bussholdeplassen":{"lemma":"bussholdeplass","zh":"公交车站","pos":"名词","ref":"6-094","form":"单数定指","clip":null},"butikken":{"lemma":"butikk","zh":"商店","pos":"名词","ref":"6-086","form":"单数定指","clip":null},"d