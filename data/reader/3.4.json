{"id":"3.4","title":"Skal vi gå på konsert?","audio":"audio/3.4.mp3","duration":112.85,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.87,"text":"3.4 Skal vi gå på konsert?","heading":true,"zh":"3.4 我们去听音乐会好吗？","words":[[0,3,0.15,1.15,"3.4"],[4,8,2.78,3.28,"skal~d1b9dc119407"],[9,11,3.28,3.56,"vi"],[12,14,3.56,3.88,"gå"],[15,17,3.88,4.26,"på~770498f5459a"],[18,25,4.26,4.79,"konsert"]]},{"id":1,"start":7.21,"end":8.59,"text":"Det er fredag.","zh":"今天是星期五。","words":[[0,3,7.29,7.46,"det"],[4,6,7.46,7.72,"er"],[7,13,7.72,8.51,"fredag"]]},{"id":2,"start":9.36,"end":12.72,"text":"Viola og Synne møter hverandre på kafé.","zh":"维奥拉和辛妮在咖啡馆见面。","words":[[0,5,9.44,9.96,"viola"],[6,8,9.96,10.18,"og"],[9,14,10.18,10.68,"synne"],[15,20,10.68,11.46,"møter~be23d49fc565"],[21,30,11.46,11.98,"hverandre"],[31,33,11.98,12.14,"på"],[34,38,12.14,12.64,"kafé"]]},{"id":3,"start":13.65,"end":15.22,"text":"De skal drikke kaffe.","zh":"她们要喝咖啡。","words":[[0,2,13.73,13.93,"de"],[3,7,13.93,14.27,"skal"],[8,14,14.27,14.67,"drikke~f9439ee27976"],[15,20,14.67,15.14,"kaffe"]]},{"id":4,"start":16.86,"end":20.02,"text":"Hei, Viola! Hvordan har du det?","speaker":"Synne","zh":"你好，维奥拉！你过得怎么样？","words":[[0,3,16.95,17.26,"hei"],[5,10,17.36,17.64,"viola"],[12,19,18.6,19.18,"hvordan"],[20,23,19.18,19.5,"har~106d9d66c05d"],[24,26,19.5,19.66,"du"],[27,30,19.66,19.94,"det~aef4434dacc8"]]},{"id":5,"start":20.26,"end":23.27,"text":"Bare bra, takk! Og du?","speaker":"Viola","zh":"挺好的，谢谢！你呢？","words":[[0,4,20.62,21.3,"bare~fd8ffd1acaa7"],[5,8,21.3,21.64,"bra~bbb83846e29f"],[10,14,21.64,22.04,"takk"],[16,18,22.46,22.84,"og"],[19,21,22.84,23.19,"du"]]},{"id":6,"start":23.43,"end":26.43,"text":"Fint. Hyggelig å se deg igjen.","speaker":"Synne","zh":"很好。很高兴又见到你。","words":[[0,4,23.51,24.04,"fint"],[6,14,24.76,25.4,"hyggelig"],[15,16,25.4,25.54,"å~0583da7a620a"],[17,19,25.54,25.8,"se~85de1b6be884"],[20,23,25.8,25.94,"deg"],[24,29,25.94,26.35,"igjen"]]},{"id":7,"start":26.88,"end":31.82,"text":"I like måte. Jeg vil gjerne ha en kaffe med melk.","speaker":"Viola","zh":"我也一样。我想要一杯加牛奶的咖啡。","words":[[0,1,26.96,27.16,"i~d6ed51d0f507"],[2,6,27.16,27.54,"like~96c08a97a401"],[7,11,27.54,27.9,"måte~3d36e9b6a7d5"],[13,16,29.34,29.7,"jeg"],[17,20,29.7,29.88,"vil"],[21,27,29.88,30.2,"gjerne"],[28,30,30.2,30.34,"ha~7724ec04e04d"],[31,33,30.34,30.54,"en~a939a9e56dc5"],[34,39,30.54,31.0,"kaffe"],[40,43,31.0,31.2,"med~daa215ce5c1c"],[44,48,31.2,31.74,"melk"]]},{"id":8,"start":32.69,"end":34.5,"text":"Jeg vil ha en svart kaffe.","speaker":"Synne","zh":"我要一杯黑咖啡。","words":[[0,3,32.77,33.01,"jeg"],[4,7,33.01,33.15,"vil"],[8,10,33.15,33.31,"ha~7724ec04e04d"],[11,13,33.31,33.49,"en~a939a9e56dc5"],[14,19,33.49,33.93,"svart~4918cb21840d"],[20,25,33.93,34.42,"kaffe"]]},{"id":9,"start":36.15,"end":40.01,"text":"De kjøper kaffe og sitter og snakker sammen.","zh":"她们买了咖啡，坐着聊天。","words":[[0,2,36.23,36.42,"de"],[3,9,36.42,36.84,"kjøper"],[10,15,36.84,37.16,"kaffe"],[16,18,37.28,38.14,"og"],[19,25,38.14,38.48,"sitter"],[26,28,38.48,38.9,"og"],[29,36,38.9,39.38,"snakker"],[37,43,39.38,39.93,"sammen"]]},{"id":10,"start":41.71,"end":43.53,"text":"Hva gjør du i fritida?","speaker":"Viola","zh":"你空闲时间做什么？","words":[[0,3,41.79,42.02,"hva"],[4,8,42.02,42.22,"gjør"],[9,11,42.22,42.44,"du"],[12,13,42.44,42.68,"i"],[14,21,42.68,43.45,"fritida"]]},{"id":11,"start":44.27,"end":47.2,"text":"Jeg liker musikk, dans og ski.","speaker":"Synne","zh":"我喜欢音乐、跳舞和滑雪。","words":[[0,3,44.35,44.52,"jeg"],[4,9,44.52,44.78,"liker"],[10,16,44.78,45.42,"musikk"],[18,22,45.82,46.12,"dans"],[23,25,46.12,46.74,"og"],[26,29,46.74,47.12,"ski"]]},{"id":12,"start":47.89,"end":55.24,"text":"Jeg liker også musikk og dans, og jeg spiller volleyball. Jeg kan ikke gå på ski.","speaker":"Viola","zh":"我也喜欢音乐和跳舞，我还打排球。我不会滑雪。","words":[[0,3,47.97,48.3,"jeg"],[4,9,48.3,48.7,"liker"],[10,14,48.7,49.06,"også"],[15,21,49.06,49.56,"musikk"],[22,24,49.56,49.86,"og"],[25,29,49.86,50.14,"dans"],[31,33,50.98,51.24,"og"],[34,37,51.24,51.42,"jeg"],[38,45,51.42,51.78,"spiller"],[46,56,51.78,52.36,"volleyball"],[58,61,53.68,53.88,"jeg"],[62,65,53.88,54.1,"kan~b3293f875aa1"],[66,70,54.1,54.34,"ikke"],[71,73,54.34,54.56,"gå~e27a7c6796c6"],[74,76,54.56,54.74,"på~8a7f538934a2"],[77,80,54.74,55.16,"ski"]]},{"id":13,"start":55.94,"end":60.27,"text":"Jeg kan lære deg, så kan du lære meg litt italiensk.","speaker":"Synne","zh":"我可以教你，然后你可以教我一点意大利语。","words":[[0,3,56.02,56.22,"jeg"],[4,7,56.22,56.38,"kan"],[8,12,56.38,56.78,"lære~0d35715fc16b"],[13,16,56.78,56.98,"deg"],[18,20,57.68,57.92,"så~a2c280cf08a5"],[21,24,57.92,58.1,"kan"],[25,27,58.1,58.3,"du"],[28,32,58.3,58.58,"lære~0d35715fc16b"],[33,36,58.58,58.78,"meg"],[37,41,58.78,59.1,"litt~462e893626a5"],[42,51,59.1,60.19,"italiensk~7d9db500feea"]]},{"id":14,"start":60.58,"end":61.66,"text":"God idé.","speaker":"Viola","zh":"好主意。","words":[[0,3,60.66,61.0,"god"],[4,7,61.0,61.58,"idé"]]},{"id":15,"start":62.5,"end":66.88,"text":"Jeg skal på konsert med to venner i morgen. Vil du bli med?","speaker":"Synne","zh":"我明天要和两个朋友去听音乐会。你想一起去吗？","words":[[0,3,62.58,62.76,"jeg"],[4,8,62.76,62.98,"skal~0145ff0d5f10"],[9,11,62.98,63.2,"på~ed9a55b95b8e"],[12,19,63.2,63.76,"konsert"],[20,23,63.76,64.06,"med"],[24,26,64.06,64.28,"to"],[27,33,64.28,64.7,"venner"],[34,35,64.7,64.88,"i~46dcc9198d6d"],[36,42,64.88,65.06,"morgen~a09fa253039f"],[44,47,65.74,66.16,"vil"],[48,50,66.16,66.28,"du"],[51,54,66.28,66.48,"bli~d071b4cb1ffe"],[55,58,66.48,66.8,"med~8534c443abec"]]},{"id":16,"start":67.4,"end":70.16,"text":"Ja, gjerne! Hvem spiller?","speaker":"Viola","zh":"好啊，很乐意！谁来演出？","words":[[0,2,67.48,67.78,"ja"],[4,10,67.84,68.34,"gjerne"],[12,16,69.23,69.53,"hvem"],[17,24,69.53,70.15,"spiller~e14cf3009764"]]},{"id":17,"start":70.23,"end":73.33,"text":"Admiral P. Han spiller reggae.","speaker":"Synne","zh":"Admiral P。他演奏雷鬼音乐。","words":[[0,7,70.23,71.04,"admiral"],[8,9,71.04,71.5,"p"],[11,14,72.16,72.42,"han"],[15,22,72.42,72.68,"spiller~82e614fb357a"],[23,29,72.68,73.25,"reggae"]]},{"id":18,"start":73.83,"end":79.47,"text":"Bra! Jeg liker reggae. Hvor skal konserten være?","speaker":"Viola","zh":"太好了！我喜欢雷鬼。音乐会在哪里举行？","words":[[0,3,73.91,74.44,"bra~bbb83846e29f"],[5,8,75.12,75.54,"jeg"],[9,14,75.54,76.08,"liker"],[15,21,76.08,76.46,"reggae"],[23,27,77.63,77.97,"hvor"],[28,32,77.97,78.23,"skal"],[33,42,78.23,78.71,"konserten"],[43,47,78.71,79.39,"være~f338fce625e2"]]},{"id":19,"start":79.88,"end":81.52,"text":"I parken i sentrum.","speaker":"Synne","zh":"在市中心的公园里。","words":[[0,1,79.96,80.09,"i"],[2,8,80.09,80.63,"parken"],[9,10,80.63,80.79,"i"],[11,18,80.79,81.44,"sentrum"]]},{"id":20,"start":82.56,"end":85.53,"text":"Vi snakkes i morgen. Ha det bra!","speaker":"Viola","zh":"明天再聊。再见！","words":[[0,2,82.64,82.81,"vi"],[3,10,82.81,83.25,"snakkes~388b29feb9d6"],[11,12,83.25,83.43,"i~46dcc9198d6d"],[13,19,83.43,83.67,"morgen~a09fa253039f"],[21,23,84.59,84.85,"ha~f5b6194409e1"],[24,27,84.85,84.97,"det~58cfefde490a"],[28,31,84.97,85.45,"bra~9ed229260de6"]]},{"id":21,"start":89.32,"end":90.43,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,89.4,90.35,"sammendrag"]]},{"id":22,"start":91.56,"end":95.08,"text":"Viola og Synne drikker kaffe og snakker sammen.","zh":"维奥拉和辛妮边喝咖啡边聊天。","words":[[0,5,91.64,92.13,"viola"],[6,8,92.13,92.37,"og"],[9,14,92.37,92.81,"synne"],[15,22,92.81,93.25,"drikker~8bc6fe28e25c"],[23,28,93.25,93.69,"kaffe"],[29,31,93.69,94.05,"og"],[32,39,94.05,94.49,"snakker"],[40,46,94.49,95.0,"sammen"]]},{"id":23,"start":96.28,"end":102.01,"text":"Synne skal gå på konsert med to venner i morgen, og Viola vil bli med.","zh":"辛妮明天要和两个朋友去听音乐会，维奥拉想一起去。","words":[[0,5,96.36,96.87,"synne"],[6,10,96.87,97.23,"skal"],[11,13,97.23,97.47,"gå"],[14,16,97.47,97.63,"på~770498f5459a"],[17,24,97.63,98.15,"konsert"],[25,28,98.15,98.37,"med"],[29,31,98.37,98.57,"to"],[32,38,98.57,99.05,"venner"],[39,40,99.05,99.19,"i~46dcc9198d6d"],[41,47,99.19,99.41,"morgen~a09fa253039f"],[49,51,100.12,100.34,"og"],[52,57,100.34,100.68,"viola"],[58,61,100.68,101.44,"vil"],[62,65,101.44,101.7,"bli~d071b4cb1ffe"],[66,69,101.7,101.93,"med~8534c443abec"]]},{"id":24,"start":103.17,"end":108.95,"text":"En reggae-artist skal spille i parken, og Viola liker reggae.","zh":"一位雷鬼歌手要在公园演出，而维奥拉喜欢雷鬼。","words":[[0,2,103.25,103.56,"en~a939a9e56dc5"],[3,16,103.56,104.48,"reggae-artist~3f20426c115b"],[17,21,104.48,104.94,"skal"],[22,28,104.94,105.32,"spille~91486374771b"],[29,30,105.32,105.46,"i"],[31,37,105.46,105.98,"parken"],[39,41,107.12,107.22,"og"],[42,47,107.22,107.6,"viola"],[48,53,107.6,108.34,"liker"],[54,60,108.34,108.87,"reggae"]]}],"lexicon":{"3.4":{"lemma":"3.4","zh":"第 3.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"admiral":{"lemma":"Admiral P","zh":"Admiral P（挪威雷鬼歌手艺名）","pos":"专名","ref":null,"clip":null},"bare":{"lemma":"bare","zh":"只；仅仅","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bli":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"不定式","clip":"pronunciation/5f2c0653c7f703abf9ac.mp3"},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"dans":{"lemma":"dans","zh":"舞蹈","pos":"名词","ref":"3-088","clip":"pronunciation/0b135e8de8f42b4baddb.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"deg":{"lemma":"deg","zh":"你（单数宾格）","pos":"代词","ref":"basics:pronouns:deg","clip":"pronunciation/f8b61df211696e11c220.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"drikke":{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式","clip":"pronunciation/61cfa514e9f801ac82b5.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke"}]},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现在时","