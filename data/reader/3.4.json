{"id":"3.4","title":"Skal vi gå på konsert?","audio":"audio/3.4.mp3","duration":112.85,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.87,"text":"3.4 Skal vi gå på konsert?","heading":true,"zh":"3.4 我们去听音乐会好吗？","words":[[0,3,0.15,1.15,"3.4"],[4,8,2.78,3.28,"skal~d1b9dc119407"],[9,11,3.28,3.56,"vi"],[12,14,3.56,3.88,"gå"],[15,17,3.88,4.26,"på~770498f5459a"],[18,25,4.26,4.79,"konsert"]]},{"id":1,"start":7.24,"end":8.63,"text":"Det er fredag.","zh":"今天是星期五。","words":[[0,3,7.29,7.56,"det"],[4,6,7.56,7.84,"er"],[7,13,7.84,8.48,"fredag"]]},{"id":2,"start":9.39,"end":12.79,"text":"Viola og Synne møter hverandre på kafé.","zh":"维奥拉和辛妮在咖啡馆见面。","words":[[0,5,9.46,10.1,"viola"],[6,8,10.1,10.22,"og"],[9,14,10.22,10.86,"synne"],[15,20,11.08,11.52,"møter~be23d49fc565"],[21,30,11.52,12.04,"hverandre"],[31,33,12.04,12.2,"på"],[34,38,12.2,12.64,"kafé"]]},{"id":3,"start":13.62,"end":15.29,"text":"De skal drikke kaffe.","zh":"她们要喝咖啡。","words":[[0,2,13.69,14.0,"de"],[3,7,14.0,14.4,"skal"],[8,14,14.4,14.74,"drikke~f9439ee27976"],[15,20,14.74,15.13,"kaffe"]]},{"id":4,"start":16.91,"end":20.09,"text":"Hei, Viola! Hvordan har du det?","speaker":"Synne","zh":"你好，维奥拉！你过得怎么样？","words":[[0,3,16.96,17.34,"hei"],[5,10,17.34,17.97,"viola"],[12,19,18.86,19.28,"hvordan"],[20,23,19.28,19.56,"har~106d9d66c05d"],[24,26,19.56,19.7,"du"],[27,30,19.7,19.94,"det~aef4434dacc8"]]},{"id":5,"start":20.87,"end":23.32,"text":"Bare bra, takk! Og du?","speaker":"Viola","zh":"挺好的，谢谢！你呢？","words":[[0,4,20.93,21.44,"bare~fd8ffd1acaa7"],[5,8,21.44,21.74,"bra~bbb83846e29f"],[10,14,21.74,22.23,"takk"],[16,18,22.74,22.88,"og"],[19,21,22.88,23.18,"du"]]},{"id":6,"start":23.48,"end":26.49,"text":"Fint. Hyggelig å se deg igjen.","speaker":"Synne","zh":"很好。很高兴又见到你。","words":[[0,4,23.54,24.36,"fint"],[6,14,24.92,25.48,"hyggelig"],[15,16,25.48,25.62,"å~0583da7a620a"],[17,19,25.62,25.86,"se~85de1b6be884"],[20,23,25.86,26.02,"deg"],[24,29,26.02,26.34,"igjen"]]},{"id":7,"start":26.95,"end":31.86,"text":"I like måte. Jeg vil gjerne ha en kaffe med melk.","speaker":"Viola","zh":"我也一样。我想要一杯加牛奶的咖啡。","words":[[0,1,27.01,27.24,"i~d6ed51d0f507"],[2,6,27.24,27.68,"like~96c08a97a401"],[7,11,27.68,28.25,"måte~3d36e9b6a7d5"],[13,16,29.54,29.76,"jeg"],[17,20,29.76,29.94,"vil"],[21,27,29.94,30.26,"gjerne"],[28,30,30.26,30.4,"ha~7724ec04e04d"],[31,33,30.4,30.72,"en~a939a9e56dc5"],[34,39,30.72,31.12,"kaffe"],[40,43,31.12,31.28,"med~daa215ce5c1c"],[44,48,31.28,31.71,"melk"]]},{"id":8,"start":32.72,"end":34.55,"text":"Jeg vil ha en svart kaffe.","speaker":"Synne","zh":"我要一杯黑咖啡。","words":[[0,3,32.78,33.06,"jeg"],[4,7,33.06,33.2,"vil"],[8,10,33.2,33.36,"ha~7724ec04e04d"],[11,13,33.36,33.56,"en~a939a9e56dc5"],[14,19,33.56,34.0,"svart~4918cb21840d"],[20,25,34.0,34.41,"kaffe"]]},{"id":9,"start":36.18,"end":40.08,"text":"De kjøper kaffe og sitter og snakker sammen.","zh":"她们买了咖啡，坐着聊天。","words":[[0,2,36.24,36.52,"de"],[3,9,36.52,37.0,"kjøper"],[10,15,37.0,37.53,"kaffe"],[16,18,38.06,38.2,"og"],[19,25,38.2,38.72,"sitter"],[26,28,38.72,38.98,"og"],[29,36,38.98,39.48,"snakker"],[37,43,39.48,39.93,"sammen"]]},{"id":10,"start":41.74,"end":43.59,"text":"Hva gjør du i fritida?","speaker":"Viola","zh":"你空闲时间做什么？","words":[[0,3,41.8,42.08,"hva"],[4,8,42.08,42.28,"gjør"],[9,11,42.28,42.58,"du"],[12,13,42.58,42.76,"i"],[14,21,42.76,43.44,"fritida"]]},{"id":11,"start":44.29,"end":47.26,"text":"Jeg liker musikk, dans og ski.","speaker":"Synne","zh":"我喜欢音乐、跳舞和滑雪。","words":[[0,3,44.35,44.54,"jeg"],[4,9,44.54,44.82,"liker"],[10,16,44.82,45.55,"musikk"],[18,22,45.86,46.48,"dans"],[23,25,46.66,46.8,"og"],[26,29,46.8,47.11,"ski"]]},{"id":12,"start":47.93,"end":55.21,"text":"Jeg liker også musikk og dans, og jeg spiller volleyball. Jeg kan ikke gå på ski.","speaker":"Viola","zh":"我也喜欢音乐和跳舞，我还打排球。我不会滑雪。","words":[[0,3,47.99,48.38,"jeg"],[4,9,48.38,48.8,"liker"],[10,14,48.8,49.12,"også"],[15,21,49.12,49.78,"musikk"],[22,24,49.78,49.9,"og"],[25,29,49.9,50.49,"dans"],[31,33,51.16,51.26,"og"],[34,37,51.26,51.5,"jeg"],[38,45,51.5,51.94,"spiller"],[46,56,51.94,52.63,"volleyball"],[58,61,53.76,53.94,"jeg"],[62,65,53.94,54.18,"kan~b3293f875aa1"],[66,70,54.18,54.44,"ikke"],[71,73,54.44,54.64,"gå~e27a7c6796c6"],[74,76,54.64,54.8,"på~8a7f538934a2"],[77,80,54.8,55.06,"ski"]]},{"id":13,"start":55.98,"end":60.33,"text":"Jeg kan lære deg, så kan du lære meg litt italiensk.","speaker":"Synne","zh":"我可以教你，然后你可以教我一点意大利语。","words":[[0,3,56.04,56.28,"jeg"],[4,7,56.28,56.48,"kan"],[8,12,56.48,56.84,"lære~0d35715fc16b"],[13,16,56.84,57.2,"deg"],[18,20,57.82,57.96,"så~a2c280cf08a5"],[21,24,57.96,58.16,"kan"],[25,27,58.16,58.38,"du"],[28,32,58.38,58.66,"lære~0d35715fc16b"],[33,36,58.66,58.96,"meg"],[37,41,58.96,59.26,"litt~462e893626a5"],[42,51,59.26,60.18,"italiensk~7d9db500feea"]]},{"id":14,"start":60.62,"end":61.7,"text":"God idé.","speaker":"Viola","zh":"好主意。","words":[[0,3,60.68,61.12,"god"],[4,7,61.12,61.55,"idé"]]},{"id":15,"start":62.55,"end":66.93,"text":"Jeg skal på konsert med to venner i morgen. Vil du bli med?","speaker":"Synne","zh":"我明天要和两个朋友去听音乐会。你想一起去吗？","words":[[0,3,62.61,62.86,"jeg"],[4,8,62.86,63.14,"skal~0145ff0d5f10"],[9,11,63.14,63.28,"på~ed9a55b95b8e"],[12,19,63.28,63.98,"konsert"],[20,23,63.98,64.14,"med"],[24,26,64.14,64.36,"to"],[27,33,64.36,64.82,"venner"],[34,35,64.82,64.9,"i~46dcc9198d6d"],[36,42,64.9,65.46,"morgen~a09fa253039f"],[44,47,66.02,66.2,"vil"],[48,50,66.2,66.34,"du"],[51,54,66.34,66.52,"bli~d071b4cb1ffe"],[55,58,66.52,66.78,"med~8534c443abec"]]},{"id":16,"start":67.44,"end":70.29,"text":"Ja, gjerne! Hvem spiller?","speaker":"Viola","zh":"好啊，很乐意！谁来演出？","words":[[0,2,67.5,67.88,"ja"],[4,10,67.88,68.52,"gjerne"],[12,16,69.32,69.68,"hvem"],[17,24,69.68,70.14,"spiller~e14cf3009764"]]},{"id":17,"start":70.67,"end":73.39,"text":"Admiral P. Han spiller reggae.","speaker":"Synne","zh":"Admiral P。他演奏雷鬼音乐。","words":[[0,7,70.73,71.28,"admiral"],[8,9,71.28,71.56,"p"],[11,14,72.26,72.48,"han"],[15,22,72.48,72.8,"spiller~82e614fb357a"],[23,29,72.8,73.24,"reggae"]]},{"id":18,"start":73.86,"end":79.52,"text":"Bra! Jeg liker reggae. Hvor skal konserten være?","speaker":"Viola","zh":"太好了！我喜欢雷鬼。音乐会在哪里举行？","words":[[0,3,73.92,74.52,"bra~bbb83846e29f"],[5,8,75.36,75.68,"jeg"],[9,14,75.68,76.12,"liker"],[15,21,76.12,76.78,"reggae"],[23,27,77.76,78.08,"hvor"],[28,32,78.08,78.36,"skal"],[33,42,78.36,78.92,"konserten"],[43,47,78.92,79.37,"være~f338fce625e2"]]},{"id":19,"start":79.92,"end":81.58,"text":"I parken i sentrum.","speaker":"Synne","zh":"在市中心的公园里。","words":[[0,1,79.98,80.16,"i"],[2,8,80.16,80.74,"parken"],[9,10,80.74,80.84,"i"],[11,18,80.84,81.43,"sentrum"]]},{"id":20,"start":82.59,"end":85.58,"text":"Vi snakkes i morgen. Ha det bra!","speaker":"Viola","zh":"明天再聊。再见！","words":[[0,2,82.66,82.88,"vi"],[3,10,82.88,83.38,"snakkes~388b29feb9d6"],[11,12,83.38,83.48,"i~46dcc9198d6d"],[13,19,83.48,84.02,"morgen~a09fa253039f"],[21,23,84.7,84.88,"ha~f5b6194409e1"],[24,27,84.88,85.02,"det~58cfefde490a"],[28,31,85.02,85.46,"bra~9ed229260de6"]]},{"id":21,"start":89.35,"end":90.49,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,89.41,90.34,"sammendrag"]]},{"id":22,"start":91.59,"end":95.18,"text":"Viola og Synne drikker kaffe og snakker sammen.","zh":"维奥拉和辛妮边喝咖啡边聊天。","words":[[0,5,91.66,92.26,"viola"],[6,8,92.26,92.4,"og"],[9,14,92.4,92.96,"synne"],[15,22,92.96,93.34,"drikker~8bc6fe28e25c"],[23,28,93.34,93.9,"kaffe"],[29,31,93.9,94.12,"og"],[32,39,94.12,94.58,"snakker"],[40,46,94.58,95.03,"sammen"]]},{"id":23,"start":96.31,"end":102.07,"text":"Synne skal gå på konsert med to venner i morgen, og Viola vil bli med.","zh":"辛妮明天要和两个朋友去听音乐会，维奥拉想一起去。","words":[[0,5,96.38,97.12,"synne"],[6,10,97.12,97.38,"skal"],[11,13,97.38,97.58,"gå"],[14,16,97.58,97.72,"på~770498f5459a"],[17,24,97.72,98.28,"konsert"],[25,28,98.28,98.44,"med"],[29,31,98.44,98.68,"to"],[32,38,98.68,99.12,"venner"],[39,40,99.12,99.22,"i~46dcc9198d6d"],[41,47,99.22,99.72,"morgen~a09fa253039f"],[49,51,100.24,100.36,"og"],[52,57,100.36,101.0,"viola"],[58,61,101.3,101.52,"vil"],[62,65,101.52,101.74,"bli~d071b4cb1ffe"],[66,69,101.74,101.92,"med~8534c443abec"]]},{"id":24,"start":103.21,"end":109.02,"text":"En reggae-artist skal spille i parken, og Viola liker reggae.","zh":"一位雷鬼歌手要在公园演出，而维奥拉喜欢雷鬼。","words":[[0,2,103.27,103.68,"en~a939a9e56dc5"],[3,16,103.68,104.76,"reggae-artist~3f20426c115b"],[17,21,104.76,105.04,"skal"],[22,28,105.04,105.42,"spille~91486374771b"],[29,30,105.42,105.52,"i"],[31,37,105.52,106.18,"parken"],[39,41,107.12,107.24,"og"],[42,47,107.24,107.88,"viola"],[48,53,107.88,108.48,"liker"],[54,60,108.48,108.87,"reggae"]]}],"lexicon":{"3.4":{"lemma":"3.4","zh":"第 3.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"admiral":{"lemma":"Admiral P","zh":"Admiral P（挪威雷鬼歌手艺名）","pos":"专名","ref":null,"clip":null},"bare":{"lemma":"bare","zh":"只；仅仅","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bli":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"不定式","clip":"pronunciation/5f2c0653c7f703abf9ac.mp3"},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"dans":{"lemma":"dans","zh":"舞蹈","pos":"名词","ref":"3-088","clip":"pronunciation/0b135e8de8f42b4baddb.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"deg":{"lemma":"deg","zh":"你（单数宾格）","pos":"代词","ref":"basics:pronouns:deg","clip":"pronunciation/f8b61df211696e11c220.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"drikke":{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式","clip":"pronunciation/61cfa514e9f801ac82b5.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke"}]},"drikker":{"lemma":"drikke","zh":"喝（drikke 的现在时）","pos":"动词","ref":"1-092","form":"现