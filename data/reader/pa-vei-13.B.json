{"id":"pa-vei-13.B","bookId":"pa-vei-textbook","readingId":"13.B","title":"Unnskyld, hvor er ...?","audio":"audio/pa-vei/13.B.mp3","duration":96.168,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.06,"end":3.585,"text":"Hans-Olav drar for å se på leiligheten.","zh":"汉斯·奥拉夫去看公寓。","words":[[0,9,1.06,1.862,"hans-olav"],[10,14,1.862,2.165,"drar"],[15,18,2.2,2.353,"for"],[19,20,2.353,2.445,"å"],[21,23,2.5,2.685,"se"],[24,26,2.8,2.922,"på"],[27,38,2.922,3.585,"leiligheten"]]},{"id":1,"start":5.6,"end":10.345,"text":"Han finner ikke ut hvor Egelundveien er og stopper en mann:","zh":"他找不到艾格伦路，于是拦住一位男士：","words":[[0,3,5.6,5.785,"han"],[4,10,5.86,6.183,"finner"],[11,15,6.183,6.425,"ikke"],[16,18,6.52,6.825,"ut"],[19,23,6.84,7.065,"hvor"],[24,36,7.34,8.405,"egelundveien"],[37,39,8.48,8.725,"er"],[40,42,9.38,9.525,"og"],[43,50,9.54,9.963,"stopper"],[51,53,9.963,10.082,"en"],[54,58,10.082,10.345,"mann"]]},{"id":2,"start":12.376,"end":16.381,"text":"Unnskyld, men vet du hvor Egelundveien ligger?","zh":"不好意思，您知道艾格伦路在哪里吗？","words":[[0,8,12.376,12.901,"unnskyld"],[10,13,13.936,14.101,"men"],[14,17,14.136,14.369,"vet"],[18,20,14.369,14.479,"du"],[21,25,14.479,14.721,"hvor"],[26,38,14.936,16.001,"egelundveien"],[39,45,16.016,16.381,"ligger"]],"speaker":"Hans-Olav"},{"id":3,"start":17.276,"end":18.801,"text":"Det er visst ikke så langt herfra.","zh":"听说离这里不远。","words":[[0,3,17.276,17.428,"det"],[4,6,17.428,17.529,"er"],[7,12,17.529,17.709,"visst"],[13,17,17.709,17.909,"ikke"],[18,20,17.909,18.041,"så"],[21,26,18.056,18.381,"langt"],[27,33,18.396,18.801,"herfra"]],"speaker":"Hans-Olav"},{"id":4,"start":20.376,"end":27.941,"text":"Egelundveien? Nei, dessverre. Men kanskje du kan spørre i bokhandelen?","zh":"艾格伦路？抱歉，我不知道。不过也许你可以去书店问问？","words":[[0,12,20.376,21.521,"egelundveien"],[14,17,22.896,23.241,"nei"],[19,28,23.836,24.341,"dessverre"],[30,33,25.176,25.401,"men"],[34,41,25.776,26.118,"kanskje"],[42,44,26.118,26.241,"du"],[45,48,26.256,26.441,"kan"],[49,55,26.536,27.001,"spørre"],[56,57,27.056,27.161,"i"],[58,69,27.176,27.941,"bokhandelen"]],"speaker":"Mannen"},{"id":5,"start":29.576,"end":33.561,"text":"Den ligger på den andre siden av torget, ved siden av postkontoret.","zh":"书店在广场另一边，邮局旁边。","words":[[0,3,29.576,29.801,"den"],[4,10,29.856,30.148,"ligger"],[11,13,30.148,30.261,"på"],[14,17,30.276,30.441,"den@pa-vei-den-definite"],[18,23,30.516,30.841,"andre@pa-vei-andre-other"],[24,29,30.876,31.169,"siden@pa-vei-siden-side"],[30,32,31.169,31.288,"av"],[33,39,31.288,31.681,"torget"],[41,44,32.276,32.439,"ved"],[45,50,32.439,32.728,"siden@pa-vei-siden-side"],[51,53,32.728,32.829,"av"],[54,66,32.829,33.561,"postkontoret"]],"speaker":"Mannen"},{"id":6,"start":34.64,"end":38.101,"text":"Å ja, der ser jeg den. Takk skal du ha.","zh":"哦，我看到它了。谢谢您。","words":[[0,1,34.64,34.74,"å"],[2,4,34.776,34.921,"ja"],[6,9,35.936,36.139,"der"],[10,13,36.139,36.358,"ser"],[14,17,36.358,36.489,"jeg"],[18,21,36.489,36.641,"den"],[23,27,37.436,37.668,"takk"],[28,32,37.668,37.838,"skal"],[33,35,37.838,37.959,"du"],[36,38,37.959,38.101,"ha"]],"speaker":"Hans-Olav"},{"id":7,"start":38.946,"end":41.691,"text":"Forresten, er det en minibank i nærheten?","zh":"对了，附近有自动取款机吗？","words":[[0,9,38.946,39.431,"forresten"],[11,13,39.946,40.069,"er"],[14,17,40.069,40.189,"det"],[18,20,40.189,40.288,"en"],[21,29,40.288,41.051,"minibank"],[30,31,41.066,41.159,"i"],[32,40,41.159,41.691,"nærheten"]],"speaker":"Hans-Olav"},{"id":8,"start":43.306,"end":49.151,"text":"Ja, det er en minibank rett utenfor matbutikken, til høyre for bokhandelen.","zh":"有，食品店外面就有一台，在书店右边。","words":[[0,2,43.306,43.451,"ja"],[4,7,44.326,44.491,"det"],[8,10,44.506,44.711,"er"],[11,13,44.746,44.891,"en"],[14,22,44.906,45.471,"minibank"],[23,27,45.586,45.911,"rett"],[28,35,45.986,46.468,"utenfor"],[36,47,46.468,47.191,"matbutikken"],[49,52,47.706,47.871,"til"],[53,58,47.886,48.291,"høyre"],[59,62,48.306,48.468,"for"],[63,74,48.468,49.151,"bokhandelen"]],"speaker":"Mannen"},{"id":9,"start":50.356,"end":52.201,"text":"Fint, takk for hjelpen.","zh":"太好了，谢谢您的帮助。","words":[[0,4,50.356,50.701,"fint"],[6,10,51.476,51.689,"takk"],[11,14,51.689,51.819,"for"],[15,22,51.819,52.201,"hjelpen"]],"speaker":"Hans-Olav"},{"id":10,"start":53.376,"end":54.181,"text":"Bare hyggelig.","zh":"不客气。","words":[[0,4,53.376,53.739,"bare"],[5,13,53.739,54.181,"hyggelig"]],"speaker":"Mannen"},{"id":11,"start":56.156,"end":57.161,"text":"I bokhandelen:","zh":"在书店里：","words":[[0,1,56.156,56.261,"i"],[2,13,56.376,57.161,"bokhandelen"]]},{"id":12,"start":58.916,"end":61.361,"text":"Hei. Kan jeg spørre deg om noe?","zh":"你好。我能问你一件事吗？","words":[[0,3,58.916,59.161,"hei"],[5,8,60.296,60.469,"kan"],[9,12,60.469,60.609,"jeg"],[13,19,60.609,60.898,"spørre"],[20,23,60.898,61.028,"deg"],[24,26,61.028,61.129,"om"],[27,30,61.129,61.361,"noe"]],"speaker":"Hans-Olav"},{"id":13,"start":62.676,"end":63.781,"text":"Ja, selvfølgelig.","zh":"当然可以。","words":[[0,2,62.676,62.841,"ja"],[4,16,63.036,63.781,"selvfølgelig"]],"speaker":"Selger"},{"id":14,"start":64.816,"end":68.881,"text":"Jeg leter etter Egelundveien. Vet du hvor det er?","zh":"我在找艾格伦路。你知道在哪里吗？","words":[[0,3,64.816,64.969,"jeg"],[4,9,64.969,65.309,"leter"],[10,15,65.309,65.581,"etter"],[16,28,65.756,66.821,"egelundveien"],[30,33,68.076,68.319,"vet"],[34,36,68.319,68.418,"du"],[37,41,68.418,68.579,"hvor"],[42,45,68.579,68.709,"det"],[46,48,68.709,68.881,"er"]],"speaker":"Hans-Olav"},{"id":15,"start":70.516,"end":77.681,"text":"Egelundveien? Nei - jo, det vet jeg. Det er like i nærheten.","zh":"艾格伦路？不……哦，我知道了。就在附近。","words":[[0,12,70.516,71.681,"egelundveien"],[14,17,72.916,73.381,"nei"],[20,22,74.296,74.461,"jo"],[24,27,74.896,75.081,"det"],[28,31,75.116,75.388,"vet"],[32,35,75.388,75.601,"jeg"],[37,40,76.376,76.561,"det"],[41,43,76.596,76.741,"er"],[44,48,76.756,77.108,"like@pa-vei-like-equally"],[49,50,77.108,77.178,"i"],[51,59,77.178,77.681,"nærheten"]],"speaker":"Selger"},{"id":16,"start":78.656,"end":82.341,"text":"Du går rett fram og tar til venstre i lyskrysset.","zh":"你一直往前走，到红绿灯路口左转。","words":[[0,2,78.656,78.801,"du"],[3,6,78.876,79.081,"går"],[7,11,79.096,79.441,"rett"],[12,16,79.476,79.781,"fram"],[17,19,80.356,80.478,"og"],[20,23,80.478,80.678,"tar"],[24,27,80.678,80.841,"til"],[28,35,80.916,81.461,"venstre"],[36,37,81.536,81.661,"i"],[38,48,81.676,82.341,"lyskrysset"]],"speaker":"Selger"},{"id":17,"start":83.336,"end":87.701,"text":"Så tar du andre vei til høyre. Da kommer du til en skole.","zh":"然后在第二条路右转，就会到一所学校。","words":[[0,2,83.336,83.481,"så"],[3,6,83.616,83.809,"tar"],[7,9,83.809,83.921,"du"],[10,15,84.056,84.418,"andre@pa-vei-andre-second"],[16,19,84.418,84.641,"vei"],[20,23,84.796,84.961,"til"],[24,29,84.996,85.321,"høyre"],[31,33,86.116,86.261,"da"],[34,40,86.396,86.678,"kommer"],[41,43,86.678,86.801,"du"],[44,47,86.976,87.159,"til"],[48,50,87.159,87.301,"en"],[51,56,87.336,87.701,"skole"]],"speaker":"Selger"},{"id":18,"start":88.876,"end":91.561,"text":"Egelundveien ligger rett bak skolen.","zh":"艾格伦路就在学校后面。","words":[[0,12,88.876,89.741,"egelundveien"],[13,19,90.056,90.361,"ligger"],[20,24,90.376,90.741,"rett"],[25,28,90.816,91.141,"bak"],[29,35,91.176,91.561,"skolen"]],"speaker":"Selger"},{"id":19,"start":92.576,"end":93.281,"text":"Takk skal du ha.","zh":"谢谢你。","words":[[0,4,92.576,92.839,"takk"],[5,9,92.839,93.018,"skal"],[10,12,93.018,93.138,"du"],[13,15,93.138,93.281,"ha"]],"speaker":"Hans-Olav"},{"id":20,"start":94.136,"end":95.001,"text":"Ingen årsak.","zh":"不客气。","words":[[0,5,94.136,94.478,"ingen"],[6,11,94.478,95.001,"årsak"]],"speaker":"Selger"}],"lexicon":{"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"andre@pa-vei-andre-other":{"lemma":"annen","pos":"限定词","zh":"另一个；另一侧的","ref":null,"clip":null,"form":"定指形式","contextual":true,"baseKey":"andre","surface":"andre"},"andre@pa-vei-andre-second":{"lemma":"annen","pos":"序数词","zh":"第二条","ref":null,"clip":null,"contextual":true,"baseKey":"andre","surface":"andre"},"av":{"lemma":"av","pos":