{"id":"14.3","title":"Arbeidsliv","audio":"audio/14.3.mp3","duration":198.19,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.51,"text":"14.3 Arbeidsliv","heading":true,"zh":"14.3 职场生活","words":[[0,4,0.15,1.41,"14.3"],[5,15,2.44,3.43,"arbeidsliv"]]},{"id":1,"start":5.24,"end":7.33,"text":"Heltid eller deltid","subheading":true,"zh":"全职还是兼职","words":[[0,6,5.32,5.89,"heltid"],[7,12,5.89,6.57,"eller"],[13,19,6.57,7.25,"deltid"]]},{"id":2,"start":8.72,"end":11.97,"text":"Du kan jobbe heltid eller deltid.","zh":"你可以做全职，也可以做兼职。","words":[[0,2,8.8,9.1,"du"],[3,6,9.1,9.32,"kan"],[7,12,9.32,9.72,"jobbe"],[13,19,9.72,10.34,"heltid"],[20,25,10.34,11.16,"eller"],[26,32,11.16,11.89,"deltid"]]},{"id":3,"start":13.08,"end":21.38,"text":"Heltid betyr at du jobber 100 prosent, mens deltid betyr at du jobber mindre enn 100 prosent.","zh":"全职是指你的工作量为百分之百，而兼职是指工作量少于百分之百。","words":[[0,6,13.16,13.74,"heltid"],[7,12,13.74,14.2,"betyr"],[13,15,14.2,14.5,"at"],[16,18,14.5,14.7,"du"],[19,25,14.7,15.08,"jobber~003ddb6d77e6"],[26,29,15.08,15.48,"100"],[30,37,15.48,15.94,"prosent"],[39,43,17.04,17.36,"mens~1bd95ccc2ca0"],[44,50,17.36,17.98,"deltid"],[51,56,17.98,18.84,"betyr"],[57,59,18.84,19.1,"at"],[60,62,19.1,19.3,"du"],[63,69,19.3,19.6,"jobber~003ddb6d77e6"],[70,76,19.6,20.18,"mindre~de6a1e042610"],[77,80,20.18,20.42,"enn"],[81,84,20.42,20.72,"100"],[85,92,20.72,21.3,"prosent"]]},{"id":4,"start":22.07,"end":29.23,"text":"Hvis du jobber heltid, er normal arbeidstid 37,5 timer i uka.","zh":"如果你做全职，正常工作时间是每周37.5小时。","words":[[0,4,22.15,22.75,"hvis"],[5,7,22.75,22.99,"du"],[8,14,22.99,23.35,"jobber~003ddb6d77e6"],[15,21,23.35,23.89,"heltid"],[23,25,24.59,24.83,"er"],[26,32,24.83,25.29,"normal"],[33,43,25.29,26.06,"arbeidstid"],[44,48,26.06,27.98,"37,5~7433aa7f8dd6"],[49,54,27.98,28.5,"timer"],[55,56,28.5,28.76,"i~82e4f1cd42dc"],[57,60,28.76,29.15,"uka"]]},{"id":5,"start":31.09,"end":31.8,"text":"Overtid","subheading":true,"zh":"加班","words":[[0,7,31.17,31.8,"overtid"]]},{"id":6,"start":31.92,"end":38.67,"text":"Du jobber overtid hvis du jobber mer enn det som står i kontrakten din.","zh":"如果你的工作时间超过合同里规定的时长，就是加班。","words":[[0,2,31.92,32.86,"du"],[3,9,33.67,34.03,"jobber~003ddb6d77e6"],[10,17,34.03,34.77,"overtid"],[18,22,34.86,35.64,"hvis"],[23,25,35.64,35.86,"du"],[26,32,35.86,36.18,"jobber~003ddb6d77e6"],[33,36,36.18,36.56,"mer~6e9e1ecc8b41"],[37,40,36.56,36.96,"enn"],[41,44,36.96,37.04,"det~84a7b0ee970b"],[45,48,37.04,37.24,"som~b7970b8f941e"],[49,53,37.24,37.54,"står~5f6469308688"],[54,55,37.54,37.7,"i"],[56,66,37.7,38.24,"kontrakten"],[67,70,38.24,38.59,"din"]]},{"id":7,"start":40.63,"end":42.91,"text":"Midlertidig og fast jobb","subheading":true,"zh":"临时工作和固定工作","words":[[0,11,40.71,41.65,"midlertidig"],[12,14,41.65,42.03,"og"],[15,19,42.03,42.37,"fast"],[20,24,42.37,42.83,"jobb"]]},{"id":8,"start":44.49,"end":48.9,"text":"Hvis du har fast jobb, har du jobben på ubestemt tid.","zh":"如果你有固定工作，这份工作就没有期限。","words":[[0,4,44.57,44.92,"hvis"],[5,7,44.92,45.14,"du"],[8,11,45.14,45.34,"har"],[12,16,45.34,45.74,"fast"],[17,21,45.74,46.12,"jobb"],[23,26,46.78,47.04,"har"],[27,29,47.04,47.18,"du"],[30,36,47.18,47.6,"jobben"],[37,39,47.6,47.84,"på~5b32eac62e71"],[40,48,47.84,48.6,"ubestemt"],[49,52,48.6,48.9,"tid"]]},{"id":9,"start":49.02,"end":57.73,"text":"Hvis du har midlertidig jobb, er du kanskje vikar for en som er syk, eller en som har permisjon.","zh":"如果你做的是临时工作，你也许是在替生病或休假的人代班。","words":[[0,4,49.02,49.02,"hvis"],[5,7,49.56,50.68,"du"],[8,11,50.68,50.86,"har"],[12,23,50.86,51.56,"midlertidig"],[24,28,51.56,51.88,"jobb"],[30,32,52.7,52.9,"er"],[33,35,52.9,53.0,"du"],[36,43,53.0,53.36,"kanskje"],[44,49,53.36,53.86,"vikar"],[50,53,53.86,54.08,"for~6535850c9574"],[54,56,54.08,54.32,"en~878d8179c654"],[57,60,54.32,54.46,"som~b7970b8f941e"],[61,63,54.46,54.66,"er"],[64,67,54.66,55.2,"syk"],[69,74,55.7,56.04,"eller"],[75,77,56.04,56.34,"en~878d8179c654"],[78,81,56.34,56.54,"som~b7970b8f941e"],[82,85,56.54,56.8,"har~9509ca982d4a"],[86,95,56.8,57.65,"permisjon"]]},{"id":10,"start":58.86,"end":64.07,"text":"Mange begynner i en midlertidig stilling og får fast jobb etter hvert.","zh":"很多人从临时职位做起，慢慢地得到固定工作。","words":[[0,5,58.94,59.34,"mange"],[6,14,59.34,60.02,"begynner"],[15,16,60.02,60.4,"i"],[17,19,60.4,60.54,"en~a939a9e56dc5"],[20,31,60.54,61.1,"midlertidig"],[32,40,61.1,61.48,"stilling"],[41,43,61.48,62.32,"og"],[44,47,62.32,62.52,"får"],[48,52,62.52,62.88,"fast"],[53,57,62.88,63.26,"jobb"],[58,63,63.26,63.6,"etter~9028ac83292c"],[64,69,63.6,63.99,"hvert~5df3e1bfc36b"]]},{"id":11,"start":66.1,"end":67.62,"text":"Skriftlig avtale","subheading":true,"zh":"书面协议","words":[[0,9,66.18,66.89,"skriftlig"],[10,16,66.89,67.55,"avtale"]]},{"id":12,"start":69.01,"end":74.39,"text":"Alle som har jobb i Norge, skal ha en skriftlig arbeidsavtale.","zh":"在挪威工作的每个人都应该有一份书面劳动合同。","words":[[0,4,69.09,69.42,"alle~e07a1d2b507c"],[5,8,69.42,69.64,"som~b7970b8f941e"],[9,12,69.64,69.84,"har"],[13,17,69.84,70.18,"jobb"],[18,19,70.18,70.34,"i"],[20,25,70.34,70.7,"norge~546b56e35dd5"],[27,31,71.32,71.48,"skal"],[32,34,71.48,71.8,"ha~ca5edb8b1cdb"],[35,37,71.8,72.48,"en~a939a9e56dc5"],[38,47,72.48,73.14,"skriftlig"],[48,61,73.28,74.31,"arbeidsavtale"]]},{"id":13,"start":74.78,"end":79.68,"text":"Der skal det blant annet stå noe om lønn og arbeidstid.","zh":"合同里应该写明工资和工作时间等内容。","words":[[0,3,75.04,75.68,"der"],[4,8,75.68,76.02,"skal"],[9,12,76.02,76.18,"det~5e977a82af29"],[13,18,76.18,76.36,"blant"],[19,24,76.36,76.82,"annet~22b0cdbc569b"],[25,28,76.82,77.08,"stå~96ff481cd401"],[29,32,77.08,77.48,"noe"],[33,35,77.48,77.66,"om~52c0bdc828db"],[36,40,77.66,78.0,"lønn"],[41,43,78.0,78.56,"og"],[44,54,78.56,79.6,"arbeidstid"]]},{"id":14,"start":82.0,"end":83.45,"text":"Lønn og skatt","subheading":true,"zh":"工资和税","words":[[0,4,82.08,82.56,"lønn"],[5,7,82.56,82.84,"og"],[8,13,82.84,83.37,"skatt"]]},{"id":15,"start":84.57,"end":88.17,"text":"Det er vanlig å få lønn en gang i måneden.","zh":"通常每个月发一次工资。","words":[[0,3,84.65,84.82,"det~5e977a82af29"],[4,6,84.82,84.96,"er"],[7,13,84.96,85.5,"vanlig"],[14,15,85.5,85.74,"å~0583da7a620a"],[16,18,85.74,85.9,"få~65b84e08cd43"],[19,23,85.9,86.32,"lønn"],[24,26,86.32,87.0,"en~a939a9e56dc5"],[27,31,87.0,87.24,"gang"],[32,33,87.24,87.44,"i~5ce45f6bd4ca"],[34,41,87.44,88.09,"måneden"]]},{"id":16,"start":89.26,"end":92.19,"text":"Noen prosent av lønna di er skatt.","zh":"你工资中有一定百分比是税款。","words":[[0,4,89.34,89.72,"noen~c766e2ef794d"],[5,12,89.72,90.26,"prosent"],[13,15,90.26,90.44,"av"],[16,21,90.44,90.76,"lønna"],[22,24,90.76,91.04,"di"],[25,27,91.04,91.58,"er"],[28,33,91.58,92.11,"skatt"]]},{"id":17,"start":93.33,"end":97.9,"text":"Normal skatt av lønn i Norge er ca. 30 prosent.","zh":"在挪威，工资的一般税率约为百分之三十。","words":[[0,6,93.41,93.87,"normal"],[7,12,93.87,94.31,"skatt"],[13,15,94.31,94.55,"av"],[16,20,94.55,94.81,"lønn"],[21,22,94.81,94.93,"i"],[23,28,94.93,95.27,"norge~546b56e35dd5"],[29,31,95.27,96.11,"er"],[32,34,96.11,96.39,"ca"],[36,38,96.39,97.23,"30"],[39,46,97.23,97.82,"prosent"]]},{"id":18,"start":98.94,"end":104.63,"text":"Hvis du har høy lønn, betaler du mer skatt enn hvis du har lav lønn.","zh":"工资高的话，你交的税比工资低时多。","words":[[0,4,99.02,99.72,"hvis"],[5,7,99.72,99.86,"du"],[8,11,99.86,100.02,"har"],[12,15,100.02,100.3,"høy"],[16,20,100.3,100.6,"lønn"],[22,29,101.32,101.76,"betaler"],[30,32,101.76,101.92,"du"],[33,36,101.92,102.2,"mer~564a1acc2512"],[37,42,102.2,102.68,"skatt"],[43,46,102.68,103.34,"enn"],[47,51,103.34,103.56,"hvis"],[52,54,103.56,103.7,"du"],[55,58,103.7,103.84,"har"],[59,62,103.84,104.1,"lav"],[63,67,104.1,104.55,"lønn"]]},{"id":19,"start":105.8,"end":111.17,"text":"Du betaler ikke skatt hvis du tjener mindre enn 50 000 kroner i året.","zh":"如果你一年挣的钱少于五万克朗，就不用交税。","words":[[0,2,105.88,106.07,"du"],[3,10,106.07,106.49,"betaler"],[11,15,106.49,106.73,"ikke"],[16,21,106.73,107.15,"skatt"],[22,26,107.47,107.85,"hvis"],[27,29,107.85,107.97,"du"],[30,36,107.97,108.39,"tjener~47e94063925c"],[37,43,108.39,108.91,"mindre~de6a1e042610"],[44,47,108.91,109.16,"enn"],[48,50,109.16,110.01,"50~a59dd42ee3c5"],[51,54,109.16,110.01,"000~c5f93a3d36d2"],[55,61,110.01,110.53,"kroner"],[62,63,110.53,110.71,"i~9e7c0275f90a"],[64,68,110.71,111.09,"året"]]},{"id":20,"start":113.05,"end":113.92,"text":"Fravær","subheading":true,"zh":"缺勤","words":[[0,6,113.12,113.84,"fravær"]]},{"id":21,"start":115.05,"end":116.51,"text":"Søke permisjon","subheading":true,"zh":"申请休假","words":[[0,4,115.13,115.6,"søke"],[5,14,115.6,116.43,"permisjon"]]},{"id":22,"start":118.15,"end":121.61,"text":"Sjefen din bestemmer over deg i arbeidstida di.","zh":"在工作时间里，你的老板有权安排你。","words":[[0,6,118.23,118.68,"sjefen"],[7,10,118.68,118.92,"din"],[11,20,118.92,119.64,"bestemmer"],[21,25,119.64,119.92,"over~83781d313f95"],[26,29,119.92,120.18,"deg"],[30,31,120.18,120.56,"i"],[32,43,120.56,121.26,"arbeidstida"],[44,46,121.26,121.53,"di"]]},{"id":23,"start":122.81,"end":129.58,"text":"Det betyr at du må møte presis hver dag og gi beskjed hvis du ikke kan komme på jobb en dag.","zh":"这意味着你每天必须准时到岗，如果哪天不能来上班，要告知一声。","words":[[0,3,122.89,123.06,"det"],[4,9,123.06,123.42,"betyr"],[10,12,123.42,123.86,"at"],[13,15,123.86,124.06,"du"],[16,18,124.06,124.2,"må"],[19,23,124.2,124.52,"møte~6793098bfe72"],[24,30,124.52,125.1,"presis"],[31,35,125.1,125.48,"hver"],[36,39,125.48,125.72,"dag"],[40,42,125.72,126.46,"og"],[43,45,126.46,126.62,"gi"],[46,53,126.62,127.04,"beskjed"],[54,58,127.04,127.58,"hvis"],[59,61,127.58,127.7,"du"],[62,66,127.7,127.92,"ikke"],[67,70,127.92,128.12,"kan"],[71,76,128.12,128.36,"komme"],[77,79,128.36,128.58,"på~c4e2bba6d7de"],[80,84,128.58,128.92,"jobb"],[85,87,128.92,129.12,"en~a939a9e56dc5"],[88,91,129.12,129.5,"dag"]]},{"id":24,"start":131.0,"end":137.04,"text":"Du har plikt til å levere permisjonssøknad hvis du vet at du må være borte fra jobben.","zh":"如果你知道自己必须离开工作岗位，就有义务提交休假申请。","words":[[0,2,131.08,131.29,"du"],[3,6,131.29,131.47,"har"],[7,12,131.47,131.83,"plikt"],[13,16,131.83,132.19,"til~ac9a157f26ec"],[17,18,132.19,132.27,"å~0583da7a620a"],[19,25,132.27,132.63,"levere"],[26,42,132.63,133.89,"permisjonssøknad"],[43,47,133.91,134.71,"hvis"],[48,50,134.71,134.87,"du"],[51,54,134.87,135.17,"vet"],[55,57,135.17,135.57,"at"],[58,60,135.57,135.69,"du"],[61,63,135.69,135.79,"må"],[64,68,135.79,135.99,"være"],[69,74,135.99,136.31,"borte"],[75,78,136.31,136.53,"fra"],[79,85,136.53,136.97,"jobben"]]},{"id":25,"start":138.84,"end":145.61,"text":"Hvis du må gå til lege eller tannlege i arbeidstida, må du søke om permisjon på forhånd.","zh":"如果你需要在工作时间去看医生或牙医，必须提前申请休假。","words":[[0,4,138.92,139.21,"hvis"],[5,7,139.21,139.35,"du"],[8,10,139.35,139.49,"må"],[11,13,139.49,139.71,"gå"],[14,17,139.71,139.94,"til"],[18,22,139.95,140.47,"lege"],[23,28,140.47,140.87,"eller"],[29,37,140.87,141.57,"tannlege"],[38,39,141.57,141.77,"i"],[40,51,141.77,142.39,"arbeidstida"],[53,55,143.25,143.47,"må"],[56,58,143.47,143.63,"du"],[59,63,143.63,143.97,"søke"],[64,66,143.97,144.15,"om~e442de0b3aae"],[67,76,144.15,144.75,"permisjon"],[77,79,144.75,144.99,"på~6520a7015304"],[80,87,144.99,145.53,"forhånd"]]},{"id":26,"start":145.91,"end":158.23,"text":"Hvis du ikke er medlem i Den norske kirke, kan du få to dager permisjon uten lønn hvert år for å feire høytider i andre religioner.","zh":"如果你不是挪威教会的成员，每年可以请两天无薪假，用来庆祝其他宗教的节日。","words":[[0,4,147.21,147.75,"hvis"],[5,7,147.75,147.91,"du"],[8,12,147.91,148.13,"ikke"],[13,15,148.13,148.31,"er"],[16,22,148.31,148.77,"medlem"],[23,24,148.77,149.05,"i~4182992fc0f8"],[25,28,149.05,149.13,"den~0147543fc72b"],[29,35,149.13,149.51,"norske~9163373929c5"],[36,41,149.51,149.95,"kirke~4d1948f7e123"],[43,46,150.89,151.09,"kan"],[47,49,151.09,151.27,"du"],[50,52,151.27,151.43,"få~65b84e08cd43"],[53,55,151.49,151.75,"to"],[56,61,151.75,152.13,"dager"],[62,71,152.13,152.79,"permisjon"],[72,76,152.79,153.39,"uten"],[77,81,153.39,153.71,"lønn"],[82,87,153.71,154.41,"hvert"],[88,90,154.41,154.71,"år"],[91,94,154.71,155.47,"for~6bd3c0f13dd3"],[95,96,155.47,155.57,"å~0583da7a620a"],[97,102,155.57,155.87,"feire"],[103,111,155.87,156.51,"høytider"],[112,113,156.51,156.97,"i~4bf7cac0bc7a"],[114,119,156.97,157.39,"andre~0c69ef1e750c"],[120,130,157.39,158.15,"religioner"]]},{"id":27,"start":159.81,"end":160.87,"text":"Egenmelding","subheading":true,"zh":"病假自报","words":[[0,11,159.88,160.79,"egenmelding"]]},{"id":28,"start":162.11,"end":168.67,"text":"Hvis du har vært syk, må du fylle ut et egenmeldingsskjema når du kommer tilbake på jobb.","zh":"如果你生过病，回来上班时必须填写一份病假自报表。","words":[[0,4,162.19,162.51,"hvis"],[5,7,162.51,162.67,"du"],[8,11,162.67,162.89,"har~8b9792170cca"],[12,16,162.89,163.05,"vært"],[17,20,163.05,163.53,"syk"],[22,24,164.03,164.15,"må"],[25,27,164.15,164.29,"du"],[28,33,164.29,164.67,"fylle"],[34,36,164.67,164.95,"ut~5be1faece46e"],[37,39,164.95,165.43,"et~054dde72f37b"],[40,58,165.43,166.65,"egenmeldingsskjema"],[59,62,166.65,167.23,"når~8cac549467d0"],[63,65,167.23,167.33,"du"],[66,72,167.33,167.55,"kommer"],[73,80,167.55,167.95,"tilbake"],[81,83,167.95,168.21,"på~b12cb441b0ce"],[84,88,168.21,168.59,"jobb"]]},{"id":29,"start":169.71,"end":174.53,"text":"Du må også levere egenmelding hvis du har vært hjemme med syke barn.","zh":"如果你因为孩子生病而待在家里，也必须提交病假自报。","words":[[0,2,169.79,169.96,"du"],[3,5,169.96,170.06,"må"],[6,10,170.06,170.34,"også"],[11,17,170.34,170.8,"levere"],[18,29,170.8,171.52,"egenmelding"],[30,34,171.52,172.34,"hvis"],[35,37,172.34,172.48,"du"],[38,41,172.48,172.64,"har~8b9792170cca"],[42,46,172.64,172.82,"vært"],[47,53,172.82,173.22,"hjemme"],[54,57,173.22,173.46,"med"],[58,62,173.46,174.02,"syke"],[63,67,174.02,174.45,"barn"]]},{"id":30,"start":175.74,"end":180.25,"text":"Spør sjefen din om reglene for egenmelding på din arbeidsplass.","zh":"向你的老板询问你们单位关于病假自报的规定。","words":[[0,4,175.82,176.18,"spør"],[5,11,176.18,176.68,"sjefen"],[12,15,176.68,176.86,"din"],[16,18,176.86,177.12,"om~52c0bdc828db"],[19,26,177.12,177.6,"reglene"],[27,30,177.6,177.86,"for~433a9a8360f9"],[31,42,177.86,178.5,"egenmelding"],[43,45,178.5,179.02,"på"],[46,49,179.02,179.3,"din"],[50,62,179.3,180.17,"arbeidsplass"]]},{"id":31,"start":182.26,"end":188.33,"text":"Hvis du er syk mer enn tre dager, må du få sykemelding fra en lege.","zh":"如果你病了超过三天，就必须找医生开病假证明。","words":[[0,4,182.34,182.66,"hvis"],[5,7,182.66,182.84,"du"],[8,10,182.84,183.0,"er"],[11,14,183.0,183.52,"syk"],[15,18,183.52,184.18,"mer~6e9e1ecc8b41"],[19,22,184.18,184.46,"enn"],[23,26,184.46,184.64,"tre"],[27,32,184.64,185.06,"dager"],[34,36,185.75,186.11,"må"],[37,39,186.11,186.23,"du"],[40,42,186.23,186.41,"få~65b84e08cd43"],[43,54,186.41,187.25,"sykemelding"],[55,58,187.25,187.61,"fra"],[59,61,187.61,187.79,"en~a939a9e56dc5"],[62,66,187.79,188.25,"lege"]]},{"id":32,"start":189.5,"end":194.66,"text":"Du kan få sykemelding av legen hvis legen mener at du trenger det.","zh":"如果医生认为你需要，你就可以从医生那里拿到病假证明。","words":[[0,2,189.58,189.82,"du"],[3,6,189.82,190.06,"kan"],[7,9,190.06,190.24,"få~65b84e08cd43"],[10,21,190.24,191.0,"sykemelding"],[22,24,191.0,191.26,"av~e99d12aa736a"],[25,30,191.26,191.58,"legen"],[31,35,192.18,192.48,"hvis"],[36,41,192.48,192.98,"legen"],[42,47,192.98,193.52,"mener"],[48,50,193.52,193.84,"at"],[51,53,193.84,194.04,"du"],[54,61,194.04,194.36,"trenger"],[62,65,194.36,194.58,"det"]]}],"lexicon":{"000":{"lemma":"tusen","zh":"千（大数字的千位分组，与前面的数字合读）","pos":"数词","ref":null,"clip":null,"kind":"number","form":""},"100":{"lemma":"100","zh":"数字 100","pos":"数词","ref":"basics:numbers:hundre","clip":null,"kind":"number"},"14.3":{"lemma":"14.3","zh":"第 14.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"30":{"lemma":"30","zh":"数字 30","pos":"数词","ref":"basics:numbers:tretti","clip":null,"kind":"number"},"37,5":{"lemma":"37,5","zh":"37,5","pos":"数字","ref":null,"clip":null,"kind":"number"},"50":{"lemma":"50","zh":"数字 50","pos":"数词","ref":"basics:numbers:femti","clip":null,"kind":"number"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；