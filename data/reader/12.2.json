{"id":"12.2","title":"Jeg føler meg litt dårlig","audio":"audio/12.2.mp3","duration":203.09,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.12,"text":"12.2 Jeg føler meg litt dårlig","heading":true,"zh":"12.2 我感觉有点不舒服","words":[[0,4,0.15,1.06,"12.2"],[5,8,1.84,2.44,"jeg"],[9,14,2.44,2.92,"føler"],[15,18,2.92,3.1,"meg"],[19,23,3.1,3.4,"litt~54360be2a478"],[24,30,3.4,4.04,"dårlig"]]},{"id":1,"start":5.88,"end":8.14,"text":"Bjørnar er hjemme hos Ingrid.","zh":"比约纳尔在英格丽家。","words":[[0,7,5.94,6.76,"bjørnar"],[8,10,6.76,6.92,"er"],[11,17,6.92,7.34,"hjemme"],[18,21,7.34,7.58,"hos"],[22,28,7.58,7.99,"ingrid"]]},{"id":2,"start":8.89,"end":11.29,"text":"De sitter og spiser frokost.","zh":"他们正坐着吃早饭。","words":[[0,2,8.96,9.3,"de"],[3,9,9.3,9.76,"sitter"],[10,12,9.76,9.94,"og"],[13,19,9.94,10.4,"spiser"],[20,27,10.4,11.14,"frokost"]]},{"id":3,"start":14.1,"end":16.24,"text":"Skal vi gå ut og spise i kveld?","speaker":"Ingrid","zh":"我们今晚出去吃饭好吗？","words":[[0,4,14.16,14.46,"skal"],[5,7,14.46,14.68,"vi"],[8,10,14.68,14.86,"gå"],[11,13,14.86,15.08,"ut"],[14,16,15.08,15.32,"og"],[17,22,15.32,15.7,"spise"],[23,24,15.7,15.76,"i~b771fab22ceb"],[25,30,15.76,16.09,"kveld"]]},{"id":4,"start":17.54,"end":21.58,"text":"Jeg … jeg tror ikke at jeg orker. Jeg føler meg litt dårlig.","speaker":"Bjørnar","zh":"我……我觉得我没力气去。我感觉有点不舒服。","words":[[0,3,17.62,17.94,"jeg"],[6,9,17.94,17.98,"jeg"],[10,14,18.2,18.24,"tror"],[15,19,18.24,18.42,"ikke"],[20,22,18.42,18.56,"at"],[23,26,18.56,18.68,"jeg"],[27,32,18.68,19.06,"orker"],[34,37,19.82,20.08,"jeg"],[38,43,20.08,20.48,"føler"],[44,47,20.48,20.7,"meg"],[48,52,20.7,20.96,"litt~54360be2a478"],[53,59,20.96,21.5,"dårlig"]]},{"id":5,"start":22.89,"end":25.77,"text":"Du ser litt blek ut. Er du syk?","speaker":"Ingrid","zh":"你看起来脸色有点苍白。你病了吗？","words":[[0,2,22.95,23.22,"du"],[3,6,23.22,23.46,"ser~926a4d79c96e"],[7,11,23.46,23.66,"litt~54360be2a478"],[12,16,23.66,24.04,"blek"],[17,19,24.04,24.45,"ut~5961721b496c"],[21,23,24.86,24.96,"er"],[24,26,24.96,25.14,"du"],[27,30,25.14,25.62,"syk"]]},{"id":6,"start":27.18,"end":31.63,"text":"Jeg vet ikke, men jeg har hodepine og vondt i nakken.","speaker":"Bjørnar","zh":"我不知道，不过我头疼，脖子也疼。","words":[[0,3,27.23,27.46,"jeg"],[4,7,27.46,27.76,"vet"],[8,12,27.76,28.2,"ikke"],[14,17,29.06,29.22,"men"],[18,21,29.22,29.36,"jeg"],[22,25,29.36,29.6,"har"],[26,34,29.6,30.38,"hodepine"],[35,37,30.38,30.64,"og"],[38,43,30.64,30.96,"vondt"],[44,45,30.96,31.04,"i"],[46,52,31.04,31.48,"nakken"]]},{"id":7,"start":32.88,"end":34.62,"text":"Hvor lenge har du følt deg sånn?","speaker":"Ingrid","zh":"你这样感觉多久了？","words":[[0,4,32.94,33.18,"hvor~89609d84930b"],[5,10,33.18,33.44,"lenge"],[11,14,33.44,33.54,"har~8b9792170cca"],[15,17,33.54,33.78,"du"],[18,22,33.78,34.04,"følt"],[23,26,34.04,34.2,"deg"],[27,31,34.2,34.48,"sånn"]]},{"id":8,"start":36.02,"end":39.27,"text":"I ei uke, og det er litt verre i dag.","speaker":"Bjørnar","zh":"一个星期了，今天更严重一点。","words":[[0,1,36.1,36.27,"i~81345d92b30d"],[2,4,36.27,36.51,"ei~47aa2d18e376"],[5,8,36.51,36.93,"uke"],[10,12,37.75,37.93,"og"],[13,16,37.93,38.05,"det"],[17,19,38.05,38.13,"er"],[20,24,38.13,38.33,"litt~54360be2a478"],[25,30,38.33,38.73,"verre~36ef7c6c8275"],[31,32,38.73,38.83,"i"],[33,36,38.83,39.19,"dag"]]},{"id":9,"start":40.88,"end":44.8,"text":"Jeg synes at du skal ringe til fastlegen din og bestille en time.","speaker":"Ingrid","zh":"我觉得你应该给你的家庭医生打电话预约一下。","words":[[0,3,40.94,41.22,"jeg"],[4,9,41.22,41.64,"synes"],[10,12,41.64,41.74,"at"],[13,15,41.74,41.88,"du"],[16,20,41.88,42.04,"skal~9d805d69ec96"],[21,26,42.04,42.34,"ringe"],[27,30,42.34,42.5,"til"],[31,40,42.5,43.08,"fastlegen"],[41,44,43.08,43.54,"din"],[45,47,43.54,43.64,"og"],[48,56,43.64,44.06,"bestille"],[57,59,44.06,44.18,"en~a939a9e56dc5"],[60,64,44.18,44.65,"time~5959e4e2d751"]]},{"id":10,"start":46.31,"end":50.84,"text":"Jeg tror at det går over. Jeg føler meg sikkert bedre i morgen.","speaker":"Bjørnar","zh":"我觉得会好的。我明天肯定会感觉好些。","words":[[0,3,46.38,46.62,"jeg"],[4,8,46.62,46.96,"tror"],[9,11,46.96,47.06,"at"],[12,15,47.06,47.22,"det"],[16,19,47.22,47.5,"går~7feba0b290da"],[20,24,47.5,47.98,"over~da985d642412"],[26,29,48.82,49.0,"jeg"],[30,35,49.0,49.32,"føler"],[36,39,49.32,49.48,"meg"],[40,47,49.48,49.86,"sikkert~2de72e2f7742"],[48,53,49.86,50.22,"bedre~712146b6b6d7"],[54,55,50.22,50.32,"i~4f108c27c9d2"],[56,62,50.32,50.7,"morgen~709e4ceb9c48"]]},{"id":11,"start":52.12,"end":53.88,"text":"Det kan være noe alvorlig.","speaker":"Ingrid","zh":"可能是什么严重的病。","words":[[0,3,52.18,52.38,"det"],[4,7,52.38,52.72,"kan"],[8,12,52.72,52.98,"være"],[13,16,52.98,53.16,"noe"],[17,25,53.16,53.73,"alvorlig"]]},{"id":12,"start":55.3,"end":58.88,"text":"Greit, jeg skal ringe legen i morgen.","speaker":"Bjørnar","zh":"好吧，我明天给医生打电话。","words":[[0,5,55.36,55.98,"greit"],[7,10,57.16,57.34,"jeg"],[11,15,57.34,57.62,"skal"],[16,21,57.62,57.92,"ringe"],[22,27,57.92,58.32,"legen"],[28,29,58.32,58.38,"i~4f108c27c9d2"],[30,36,58.38,58.73,"morgen~709e4ceb9c48"]]},{"id":13,"start":60.93,"end":66.14,"text":"Bjørnar ringer fastlegen, og legen hans har en ledig time.","zh":"比约纳尔给家庭医生打了电话，他的医生正好有一个空的预约时段。","words":[[0,7,60.99,61.84,"bjørnar"],[8,14,61.84,62.24,"ringer~c99b480c47cb"],[15,24,62.24,63.12,"fastlegen"],[26,28,63.84,63.98,"og"],[29,34,63.98,64.36,"legen"],[35,39,64.36,64.74,"hans"],[40,43,64.74,64.96,"har"],[44,46,64.96,65.14,"en~a939a9e56dc5"],[47,52,65.14,65.56,"ledig"],[53,57,65.56,65.98,"time~5959e4e2d751"]]},{"id":14,"start":67.48,"end":71.79,"text":"Legen undersøker Bjørnar grundig og tar blodprøver.","zh":"医生给比约纳尔做了全面检查，还抽血化验。","words":[[0,5,67.54,68.16,"legen"],[6,16,68.16,68.78,"undersøker"],[17,24,68.78,69.38,"bjørnar"],[25,32,69.38,70.06,"grundig"],[33,35,70.5,70.62,"og"],[36,39,70.62,70.9,"tar~b12885b3e985"],[40,50,70.9,71.64,"blodprøver"]]},{"id":15,"start":72.74,"end":74.44,"text":"Han finner ingenting.","zh":"他什么也没查出来。","words":[[0,3,72.8,73.2,"han"],[4,10,73.2,73.62,"finner"],[11,20,73.62,74.29,"ingenting"]]},{"id":16,"start":76.55,"end":80.82,"text":"Det er ikke noe alvorlig. Stresser du mye?","speaker":"Lege","zh":"没什么严重的。你压力大吗？","words":[[0,3,76.61,77.0,"det"],[4,6,77.2,77.38,"er"],[7,11,77.38,77.66,"ikke"],[12,15,77.66,77.92,"noe~b588e475953c"],[16,24,77.92,78.64,"alvorlig"],[26,34,79.5,80.0,"stresser"],[35,37,80.0,80.3,"du"],[38,41,80.3,80.67,"mye~933c5a923198"]]},{"id":17,"start":82.22,"end":94.29,"text":"Nei, men jeg jobber veldig mye og har barna mine annenhver uke. Dessuten er jeg mye i garasjen om kveldene, og jeg hjelper ofte vennene mine i helgene.","speaker":"Bjørnar","zh":"不大，不过我工作很多，而且每隔一周要带孩子。另外我晚上经常待在车库里，周末还常常帮朋友的忙。","words":[[0,3,82.28,82.86,"nei"],[5,8,83.66,83.86,"men"],[9,12,83.86,84.06,"jeg"],[13,19,84.06,84.56,"jobber~ab83dbee3ee4"],[20,26,84.56,84.88,"veldig"],[27,30,84.88,85.32,"mye~933c5a923198"],[31,33,85.64,85.76,"og"],[34,37,85.76,86.02,"har"],[38,43,86.02,86.42,"barna"],[44,48,86.42,86.72,"mine"],[49,58,86.72,87.2,"annenhver"],[59,62,87.2,87.68,"uke"],[64,72,88.76,89.4,"dessuten"],[73,75,89.4,89.5,"er"],[76,79,89.5,89.68,"jeg"],[80,83,89.68,90.02,"mye~933c5a923198"],[84,85,90.02,90.12,"i"],[86,94,90.12,90.68,"garasjen"],[95,97,90.68,90.78,"om~3a9f4eb45714"],[98,106,90.78,91.4,"kveldene"],[108,110,91.78,91.88,"og"],[111,114,91.88,92.04,"jeg"],[115,122,92.04,92.5,"hjelper"],[123,127,92.5,92.82,"ofte"],[128,135,92.82,93.28,"vennene"],[136,140,93.28,93.54,"mine"],[141,142,93.54,93.62,"i"],[143,150,93.62,94.14,"helgene"]]},{"id":18,"start":95.51,"end":98.07,"text":"Jeg har kanskje litt mye å gjøre.","speaker":"Bjørnar","zh":"我也许事情有点多。","words":[[0,3,95.57,95.8,"jeg"],[4,7,95.8,96.16,"har~4fa74cb61537"],[8,15,96.16,96.58,"kanskje"],[16,20,96.58,96.88,"litt~54360be2a478"],[21,24,96.88,97.32,"mye~cc164d0dc3da"],[25,26,97.32,97.44,"å~0583da7a620a"],[27,32,97.44,97.92,"gjøre"]]},{"id":19,"start":99.9,"end":100.88,"text":"Trener du?","speaker":"Lege","zh":"你锻炼吗？","words":[[0,6,99.96,100.42,"trener~777c4d52cb35"],[7,9,100.42,100.73,"du"]]},{"id":20,"start":102.1,"end":104.99,"text":"Ja, jeg løper flere ganger i uka.","speaker":"Bjørnar","zh":"锻炼，我每周跑好几次步。","words":[[0,2,102.16,102.56,"ja"],[4,7,102.9,103.1,"jeg"],[8,13,103.1,103.68,"løper"],[14,19,103.68,104.0,"flere"],[20,26,104.0,104.34,"ganger~3045db79f07e"],[27,28,104.34,104.44,"i~82e4f1cd42dc"],[29,32,104.44,104.84,"uka"]]},{"id":21,"start":106.36,"end":111.75,"text":"Det er bra at du trener, men når slapper du av?","speaker":"Lege","zh":"你锻炼是好事，但你什么时候放松呢？","words":[[0,3,106.42,106.7,"det"],[4,6,106.7,106.94,"er"],[7,10,106.94,107.4,"bra~bbb83846e29f"],[11,13,107.4,107.66,"at"],[14,16,107.66,107.9,"du"],[17,23,107.9,108.52,"trener~777c4d52cb35"],[25,28,109.58,109.98,"men"],[29,32,110.36,110.76,"når~a56a1c61425b"],[33,40,110.76,111.16,"slapper"],[41,43,111.16,111.32,"du"],[44,46,111.32,111.6,"av~e2175249f92f"]]},{"id":22,"start":113.11,"end":121.32,"text":"Jeg slapper av sammen med Ingrid, ei dame som jeg har blitt kjent med. Vi ler mye og koser oss sammen.","speaker":"Bjørnar","zh":"我和英格丽在一起时会放松，她是我认识的一位女士。我们常常一起开怀大笑，过得很惬意。","words":[[0,3,113.17,113.68,"jeg"],[4,11,113.68,114.14,"slapper"],[12,14,114.14,114.38,"av~e2175249f92f"],[15,21,114.38,114.7,"sammen"],[22,25,114.7,114.9,"med"],[26,32,114.9,115.52,"ingrid"],[34,36,115.96,116.18,"ei~47aa2d18e376"],[37,41,116.18,116.66,"dame"],[42,45,116.66,116.84,"som~b7970b8f941e"],[46,49,116.84,116.96,"jeg"],[50,53,116.96,117.14,"har~8b9792170cca"],[54,59,117.14,117.32,"blitt"],[60,65,117.32,117.62,"kjent~43c3ae802868"],[66,69,117.62,117.96,"med~c94aad168705"],[71,73,118.76,118.94,"vi"],[74,77,118.94,119.32,"ler"],[78,81,119.32,119.74,"mye~933c5a923198"],[82,84,119.74,120.04,"og"],[85,90,120.14,120.62,"koser~0ea4b0a540f9"],[91,94,120.62,120.8,"oss"],[95,101,120.8,121.17,"sammen"]]},{"id":23,"start":122.09,"end":123.2,"text":"Det er bra.","speaker":"Lege","zh":"那很好。","words":[[0,3,122.16,122.52,"det"],[4,6,122.52,122.66,"er"],[7,10,122.66,123.05,"bra~bbb83846e29f"]]},{"id":24,"start":123.88,"end":127.21,"text":"Ja, men hvorfor har jeg vondt i nakken?","speaker":"Bjørnar","zh":"是啊，可我为什么脖子疼呢？","words":[[0,2,123.94,124.3,"ja"],[4,7,125.0,125.24,"men"],[8,15,125.24,125.78,"hvorfor"],[16,19,125.78,125.9,"har"],[20,23,125.9,126.08,"jeg"],[24,29,126.08,126.4,"vondt"],[30,31,126.4,126.54,"i"],[32,38,126.54,127.06,"nakken"]]},{"id":25,"start":128.28,"end":147.08,"text":"Jeg tror at du stresser for mye. Du bør bestille time hos en fysioterapeut, og du må huske å slappe av. Du kan kjøpe smertestillende på apoteket. Jeg synes også at du skal være mer sammen med Ingrid.","speaker":"Lege","zh":"我觉得你压力太大了。你应该预约一位物理治疗师，还要记得放松。你可以在药店买止痛药。我也觉得你应该多和英格丽在一起。","words":[[0,3,128.34,128.78,"jeg"],[4,8,128.78,129.24,"tror"],[9,11,129.24,129.48,"at"],[12,14,129.48,129.8,"du"],[15,23,129.8,130.4,"stresser"],[24,27,130.4,130.58,"for~79c080957b12"],[28,31,130.58,131.02,"mye~933c5a923198"],[33,35,132.0,132.26,"du"],[36,39,132.26,132.52,"bør"],[40,48,132.52,133.04,"bestille"],[49,53,133.04,133.52,"time~5959e4e2d751"],[54,57,133.52,133.72,"hos"],[58,60,133.72,133.94,"en~a939a9e56dc5"],[61,74,133.94,135.03,"fysioterapeut"],[76,78,135.86,136.0,"og"],[79,81,136.0,136.16,"du"],[82,84,136.16,136.38,"må"],[85,90,136.38,136.88,"huske"],[91,92,136.88,137.04,"å~0583da7a620a"],[93,99,137.04,137.46,"slappe~f12305fe3dd8"],[100,102,137.46,137.81,"av~e2175249f92f"],[104,106,138.88,139.06,"du"],[107,110,139.06,139.32,"kan"],[111,116,139.32,139.72,"kjøpe"],[117,132,139.72,140.62,"smertestillende"],[133,135,140.62,140.9,"på"],[136,144,140.9,141.8,"apoteket"],[146,149,143.32,143.6,"jeg"],[150,155,143.6,143.96,"synes"],[156,160,143.96,144.44,"også"],[161,163,144.58,144.84,"at"],[164,166,144.84,145.02,"du"],[167,171,145.02,145.28,"skal~9d805d69ec96"],[172,176,145.28,145.6,"være"],[177,180,145.6,146.0,"mer~6e9e1ecc8b41"],[181,187,146.0,146.34,"sammen"],[188,191,146.34,146.52,"med"],[192,198,146.52,146.93,"ingrid"]]},{"id":26,"start":149.75,"end":152.34,"text":"Bjørnar går ut og setter seg i bilen.","zh":"比约纳尔走出去，坐进车里。","words":[[0,7,149.81,150.48,"bjørnar"],[8,11,150.48,150.72,"går"],[12,14,150.72,151.04,"ut"],[15,17,151.04,151.18,"og"],[18,24,151.18,151.52,"setter"],[25,28,151.52,151.7,"seg"],[29,30,151.7,151.8,"i"],[31,36,151.8,152.19,"bilen"]]},{"id":27,"start":153.12,"end":155.17,"text":"Han tenker på det som legen sa.","zh":"他想着医生说的话。","words":[[0,3,153.19,153.42,"han"],[4,10,153.42,153.82,"tenker"],[11,13,153.82,153.96,"på~f448aab940e8"],[14,17,153.96,154.16,"det~271e8c2ecbf0"],[18,21,154.16,154.34,"som~b7970b8f941e"],[22,27,154.34,154.74,"legen"],[28,30,154.74,155.02,"sa"]]},{"id":28,"start":156.28,"end":162.24,"text":"Nå skal han jobbe litt mindre og kose seg litt mer sammen med Ingrid.","zh":"现在他要少工作一点，多和英格丽一起享受惬意时光。","words":[[0,2,156.34,156.84,"nå~d531d47a7712"],[3,7,156.84,157.08,"skal"],[8,11,157.08,157.26,"han"],[12,17,157.26,157.72,"jobbe"],[18,22,157.72,158.0,"litt~54360be2a478"],[23,29,158.0,158.53,"mindre~d474ccc355d9"],[30,32,159.08,159.26,"og"],[33,37,159.26,159.74,"kose~c5fcca31741a"],[38,41,159.74,159.96,"seg"],[42,46,159.96,160.26,"litt~54360be2a478"],[47,50,160.26,160.68,"mer~6e9e1ecc8b41"],[51,57,161.1,161.52,"sammen"],[58,61,161.52,161.72,"med"],[62,68,161.72,162.09,"ingrid"]]},{"id":29,"start":165.64,"end":166.78,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,165.7,166.63,"sammendrag"]]},{"id":30,"start":168.0,"end":172.57,"text":"Bjørnar føler seg dårlig, og han har vondt i hodet og nakken.","zh":"比约纳尔感觉不舒服，他头疼，脖子也疼。","words":[[0,7,168.06,168.66,"bjørnar"],[8,13,168.66,169.02,"føler"],[14,17,169.02,169.22,"seg"],[18,24,169.22,169.81,"dårlig"],[26,28,170.3,170.56,"og"],[29,32,170.56,170.72,"han"],[33,36,170.72,170.94,"har"],[37,42,170.94,171.28,"vondt"],[43,44,171.28,171.38,"i"],[45,50,171.38,171.8,"hodet"],[51,53,171.8,171.9,"og"],[54,60,171.9,172.42,"nakken"]]},{"id":31,"start":173.29,"end":175.45,"text":"Det har blitt verre den siste uka.","zh":"最近一周变得更严重了。","words":[[0,3,173.35,173.48,"det"],[4,7,173.48,173.6,"har~8b9792170cca"],[8,13,173.6,173.86,"blitt"],[14,19,173.86,174.34,"verre~36ef7c6c8275"],[20,23,174.34,174.54,"den~ddf7fa00bf05"],[24,29,174.54,174.92,"siste"],[30,33,174.92,175.3,"uka"]]},{"id":32,"start":176.53,"end":180.21,"text":"Ingrid synes at han skal bestille en time hos fastlegen.","zh":"英格丽觉得他应该在家庭医生那里预约。","words":[[0,6,176.59,177.22,"ingrid"],[7,12,177.22,177.54,"synes"],[13,15,177.54,177.66,"at"],[16,19,177.66,177.86,"han"],[20,24,177.86,178.14,"skal~9d805d69ec96"],[25,33,178.14,178.58,"bestille"],[34,36,178.58,178.74,"en~a939a9e56dc5"],[37,41,178.74,179.12,"time"],[42,45,179.12,179.34,"hos"],[46,55,179.34,180.06,"fastlegen"]]},{"id":33,"start":181.28,"end":187.84,"text":"Legen spør om Bjørnar stresser for mye, og sier at han bør gå til fysioterapeut.","zh":"医生问比约纳尔是不是压力太大，并说他应该去看物理治疗师。","words":[[0,5,181.34,182.06,"legen"],[6,10,182.06,182.36,"spør"],[11,13,182.36,182.52,"om~744a29d3d900"],[14,21,182.52,183.08,"bjørnar"],[22,30,183.08,183.64,"stresser"],[31,34,183.64,183.78,"for~79c080957b12"],[35,38,183.78,184.2,"mye~933c5a923198"],[40,42,184.66,184.8,"og"],[43,47,184.8,185.16,"sier"],[48,50,185.16,185.32,"at"],[51,54,185.32,185.54,"han"],[55,58,185.54,185.78,"bør"],[59,61,185.78,186.04,"gå"],[62,65,186.04,186.34,"til"],[66,79,186.34,187.69,"fysioterapeut"]]},{"id":34,"start":189.18,"end":195.2,"text":"Legen sier også at Bjørnar må huske å slappe av mer og være oftere sammen med Ingrid.","zh":"医生还说比约纳尔必须记得多放松，并更常和英格丽在一起。","words":[[0,5,189.24,189.84,"legen"],[6,10,189.84,190.16,"sier"],[11,15,190.16,190.58,"også"],[16,18,190.58,190.76,"at"],[19,26,190.76,191.24,"bjørnar"],[27,29,191.24,191.4,"må"],[30,35,191.4,191.82,"huske"],[36,37,191.82,191.96,"å~0583da7a620a"],[38,44,191.96,192.42,"slappe~f12305fe3dd8"],[45,47,192.42,192.58,"av~e2175249f92f"],[48,51,192.58,192.98,"mer~6e9e1ecc8b41"],[52,54,193.32,193.46,"og"],[55,59,193.46,193.7,"være"],[60,66,193.7,194.18,"oftere"],[67,73,194.18,194.5,"sammen"],[74,77,194.5,194.66,"med"],[78,84,194.66,195.05,"ingrid"]]},{"id":35,"start":196.23,"end":199.59,"text":"Bjørnar gleder seg til å være mer sammen med henne.","zh":"比约纳尔盼着能更多地和她在一起。","words":[[0,7,196.29,197.0,"bjørnar"],[8,14,197.0,197.5,"gleder"],[15,18,197.5,197.82,"seg"],[19,22,197.82,198.0,"til~053dd24981ff"],[23,24,198.0,198.1,"å~0583da7a620a"],[25,29,198.1,198.34,"være"],[30,33,198.34,198.66,"mer~6e9e1ecc8b41"],[34,40,198.66,198.98,"sammen"],[41,44,198.98,199.1,"med"],[45,50,199.1,199.44,"henne"]]}],"lexicon":{"12.2":{"lemma":"12.2","zh":"第 12.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alvorlig":{"lemma":"alvorlig","zh":"严重的；认真的","pos":"形容词","ref":"12-049","clip":"pronunciation/96c2d3aa893495449eac.mp3"},"annenhver":{"lemma":"annenhver","zh":"每隔一个","pos":"限定词","ref":"4-024","clip":"pronunciation/4d88951ffa5fb057d4e7.mp3"},"apoteket":{"lemma":"apotek","zh":"药房","pos":"名词","ref":"12-056","form":"单数定指","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":"pronunciation/b1d6b91b67c2afa5e322.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"bedre":{"lemma":"god","zh":"更好（god／bra 的比较级）","pos":"形容词／副词","form":"比较级","ref":"8-009","clip":null},"bestille":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","clip":"pronunciation/e2e34eab95ffd4810bf0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":"pronunciation/8310b03324c5d3e20cdc.mp3"},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"blek":{"lemma":"blek","zh":"苍白","pos":"形容词","ref":"12-009","clip":"pronunciation/4923b54c235315b779ad.mp3"},"blitt":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"过去分词","clip":null},"blodprøver":{"lemma":"blodprøve","zh":"验血","pos":"名词","ref":"12-052","form":"复数不定","clip":null},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"bør":{"