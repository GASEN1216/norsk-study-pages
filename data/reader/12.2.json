{"id":"12.2","title":"Jeg føler meg litt dårlig","audio":"audio/12.2.mp3","duration":203.09,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.12,"text":"12.2 Jeg føler meg litt dårlig","heading":true,"zh":"12.2 我感觉有点不舒服","words":[[0,4,0.15,1.06,"12.2"],[5,8,1.84,2.44,"jeg"],[9,14,2.44,2.92,"føler"],[15,18,2.92,3.1,"meg"],[19,23,3.1,3.4,"litt~54360be2a478"],[24,30,3.4,4.04,"dårlig"]]},{"id":1,"start":5.84,"end":8.08,"text":"Bjørnar er hjemme hos Ingrid.","zh":"比约纳尔在英格丽家。","words":[[0,7,5.92,6.52,"bjørnar"],[8,10,6.52,6.88,"er"],[11,17,6.88,7.3,"hjemme"],[18,21,7.3,7.5,"hos"],[22,28,7.5,8.0,"ingrid"]]},{"id":2,"start":8.86,"end":11.19,"text":"De sitter og spiser frokost.","zh":"他们正坐着吃早饭。","words":[[0,2,8.94,9.22,"de"],[3,9,9.22,9.5,"sitter"],[10,12,9.5,9.86,"og"],[13,19,9.86,10.3,"spiser"],[20,27,10.3,11.11,"frokost"]]},{"id":3,"start":14.06,"end":16.18,"text":"Skal vi gå ut og spise i kveld?","speaker":"Ingrid","zh":"我们今晚出去吃饭好吗？","words":[[0,4,14.14,14.38,"skal"],[5,7,14.38,14.58,"vi"],[8,10,14.58,14.84,"gå"],[11,13,14.84,14.98,"ut"],[14,16,14.98,15.24,"og"],[17,22,15.24,15.62,"spise"],[23,24,15.62,15.78,"i~b771fab22ceb"],[25,30,15.78,16.1,"kveld"]]},{"id":4,"start":17.54,"end":21.58,"text":"Jeg … jeg tror ikke at jeg orker. Jeg føler meg litt dårlig.","speaker":"Bjørnar","zh":"我……我觉得我没力气去。我感觉有点不舒服。","words":[[0,3,17.62,17.94,"jeg"],[6,9,17.94,17.98,"jeg"],[10,14,18.2,18.24,"tror"],[15,19,18.24,18.42,"ikke"],[20,22,18.42,18.56,"at"],[23,26,18.56,18.68,"jeg"],[27,32,18.68,19.06,"orker"],[34,37,19.82,20.08,"jeg"],[38,43,20.08,20.48,"føler"],[44,47,20.48,20.7,"meg"],[48,52,20.7,20.96,"litt~54360be2a478"],[53,59,20.96,21.5,"dårlig"]]},{"id":5,"start":22.86,"end":25.72,"text":"Du ser litt blek ut. Er du syk?","speaker":"Ingrid","zh":"你看起来脸色有点苍白。你病了吗？","words":[[0,2,22.94,23.11,"du"],[3,6,23.11,23.39,"ser~926a4d79c96e"],[7,11,23.39,23.61,"litt~54360be2a478"],[12,16,23.61,23.99,"blek"],[17,19,23.99,24.21,"ut~5961721b496c"],[21,23,24.77,24.93,"er"],[24,26,24.93,25.09,"du"],[27,30,25.09,25.64,"syk"]]},{"id":6,"start":27.15,"end":31.57,"text":"Jeg vet ikke, men jeg har hodepine og vondt i nakken.","speaker":"Bjørnar","zh":"我不知道，不过我头疼，脖子也疼。","words":[[0,3,27.23,27.41,"jeg"],[4,7,27.41,27.63,"vet"],[8,12,27.63,27.95,"ikke"],[14,17,28.77,29.17,"men"],[18,21,29.17,29.31,"jeg"],[22,25,29.31,29.53,"har"],[26,34,29.53,30.15,"hodepine"],[35,37,30.15,30.53,"og"],[38,43,30.53,30.89,"vondt"],[44,45,30.89,31.01,"i"],[46,52,31.01,31.49,"nakken"]]},{"id":7,"start":32.87,"end":34.58,"text":"Hvor lenge har du følt deg sånn?","speaker":"Ingrid","zh":"你这样感觉多久了？","words":[[0,4,32.95,33.1,"hvor~89609d84930b"],[5,10,33.1,33.32,"lenge"],[11,14,33.32,33.52,"har~8b9792170cca"],[15,17,33.52,33.66,"du"],[18,22,33.66,34.0,"følt"],[23,26,34.0,34.12,"deg"],[27,31,34.12,34.5,"sånn"]]},{"id":8,"start":36.02,"end":39.27,"text":"I ei uke, og det er litt verre i dag.","speaker":"Bjørnar","zh":"一个星期了，今天更严重一点。","words":[[0,1,36.1,36.27,"i~81345d92b30d"],[2,4,36.27,36.51,"ei~47aa2d18e376"],[5,8,36.51,36.93,"uke"],[10,12,37.75,37.93,"og"],[13,16,37.93,38.05,"det"],[17,19,38.05,38.13,"er"],[20,24,38.13,38.33,"litt~54360be2a478"],[25,30,38.33,38.73,"verre~36ef7c6c8275"],[31,32,38.73,38.83,"i"],[33,36,38.83,39.19,"dag"]]},{"id":9,"start":40.84,"end":44.74,"text":"Jeg synes at du skal ringe til fastlegen din og bestille en time.","speaker":"Ingrid","zh":"我觉得你应该给你的家庭医生打电话预约一下。","words":[[0,3,40.92,41.08,"jeg"],[4,9,41.08,41.52,"synes"],[10,12,41.52,41.72,"at"],[13,15,41.72,41.84,"du"],[16,20,41.84,41.98,"skal~9d805d69ec96"],[21,26,41.98,42.3,"ringe"],[27,30,42.3,42.4,"til"],[31,40,42.4,43.06,"fastlegen"],[41,44,43.06,43.18,"din"],[45,47,43.18,43.6,"og"],[48,56,43.6,43.98,"bestille"],[57,59,43.98,44.14,"en~a939a9e56dc5"],[60,64,44.14,44.66,"time~5959e4e2d751"]]},{"id":10,"start":46.28,"end":50.78,"text":"Jeg tror at det går over. Jeg føler meg sikkert bedre i morgen.","speaker":"Bjørnar","zh":"我觉得会好的。我明天肯定会感觉好些。","words":[[0,3,46.36,46.54,"jeg"],[4,8,46.54,46.82,"tror"],[9,11,46.82,47.06,"at"],[12,15,47.06,47.16,"det"],[16,19,47.16,47.38,"går~7feba0b290da"],[20,24,47.38,47.68,"over~da985d642412"],[26,29,48.62,48.92,"jeg"],[30,35,48.92,49.22,"føler"],[36,39,49.22,49.38,"meg"],[40,47,49.38,49.74,"sikkert~2de72e2f7742"],[48,53,49.74,50.18,"bedre~712146b6b6d7"],[54,55,50.18,50.32,"i~4f108c27c9d2"],[56,62,50.32,50.7,"morgen~709e4ceb9c48"]]},{"id":11,"start":52.08,"end":53.83,"text":"Det kan være noe alvorlig.","speaker":"Ingrid","zh":"可能是什么严重的病。","words":[[0,3,52.16,52.3,"det"],[4,7,52.3,52.58,"kan"],[8,12,52.58,52.84,"være"],[13,16,52.84,53.12,"noe"],[17,25,53.12,53.75,"alvorlig"]]},{"id":12,"start":55.25,"end":58.8,"text":"Greit, jeg skal ringe legen i morgen.","speaker":"Bjørnar","zh":"好吧，我明天给医生打电话。","words":[[0,5,55.33,55.72,"greit"],[7,10,56.97,57.27,"jeg"],[11,15,57.27,57.47,"skal"],[16,21,57.47,57.87,"ringe"],[22,27,57.87,58.21,"legen"],[28,29,58.21,58.35,"i~4f108c27c9d2"],[30,36,58.35,58.72,"morgen~709e4ceb9c48"]]},{"id":13,"start":60.89,"end":66.05,"text":"Bjørnar ringer fastlegen, og legen hans har en ledig time.","zh":"比约纳尔给家庭医生打了电话，他的医生正好有一个空的预约时段。","words":[[0,7,60.97,61.52,"bjørnar"],[8,14,61.52,62.12,"ringer~c99b480c47cb"],[15,24,62.12,62.9,"fastlegen"],[26,28,63.71,63.93,"og"],[29,34,63.93,64.29,"legen"],[35,39,64.29,64.59,"hans"],[40,43,64.59,64.89,"har"],[44,46,64.89,65.07,"en~a939a9e56dc5"],[47,52,65.07,65.49,"ledig"],[53,57,65.49,65.97,"time~5959e4e2d751"]]},{"id":14,"start":67.44,"end":71.71,"text":"Legen undersøker Bjørnar grundig og tar blodprøver.","zh":"医生给比约纳尔做了全面检查，还抽血化验。","words":[[0,5,67.52,68.04,"legen"],[6,16,68.04,68.64,"undersøker"],[17,24,68.64,69.16,"bjørnar"],[25,32,69.16,69.84,"grundig"],[33,35,69.84,70.56,"og"],[36,39,70.56,70.78,"tar~b12885b3e985"],[40,50,70.78,71.63,"blodprøver"]]},{"id":15,"start":71.82,"end":74.36,"text":"Han finner ingenting.","zh":"他什么也没查出来。","words":[[0,3,72.46,73.04,"han"],[4,10,73.04,73.52,"finner"],[11,20,73.52,74.28,"ingenting"]]},{"id":16,"start":76.51,"end":80.74,"text":"Det er ikke noe alvorlig. Stresser du mye?","speaker":"Lege","zh":"没什么严重的。你压力大吗？","words":[[0,3,76.59,76.82,"det"],[4,6,76.82,77.32,"er"],[7,11,77.32,77.56,"ikke"],[12,15,77.56,77.88,"noe~b588e475953c"],[16,24,77.88,78.4,"alvorlig"],[26,34,79.21,79.93,"stresser"],[35,37,79.93,80.17,"du"],[38,41,80.17,80.66,"mye~933c5a923198"]]},{"id":17,"start":82.18,"end":94.19,"text":"Nei, men jeg jobber veldig mye og har barna mine annenhver uke. Dessuten er jeg mye i garasjen om kveldene, og jeg hjelper ofte vennene mine i helgene.","speaker":"Bjørnar","zh":"不大，不过我工作很多，而且每隔一周要带孩子。另外我晚上经常待在车库里，周末还常常帮朋友的忙。","words":[[0,3,82.26,82.74,"nei"],[5,8,83.42,83.78,"men"],[9,12,83.78,83.98,"jeg"],[13,19,83.98,84.46,"jobber~ab83dbee3ee4"],[20,26,84.46,84.82,"veldig"],[27,30,84.82,85.08,"mye~933c5a923198"],[31,33,85.08,85.74,"og"],[34,37,85.74,85.92,"har"],[38,43,85.92,86.38,"barna"],[44,48,86.38,86.54,"mine"],[49,58,86.54,87.1,"annenhver"],[59,62,87.1,87.48,"uke"],[64,72,88.6,89.32,"dessuten"],[73,75,89.32,89.5,"er"],[76,79,89.5,89.6,"jeg"],[80,83,89.6,89.94,"mye~933c5a923198"],[84,85,89.94,90.06,"i"],[86,94,90.06,90.64,"garasjen"],[95,97,90.64,90.76,"om~3a9f4eb45714"],[98,106,90.76,91.2,"kveldene"],[108,110,91.74,91.88,"og"],[111,114,91.88,92.0,"jeg"],[115,122,92.0,92.42,"hjelper"],[123,127,92.42,92.74,"ofte"],[128,135,92.74,93.24,"vennene"],[136,140,93.24,93.44,"mine"],[141,142,93.44,93.6,"i"],[143,150,93.6,94.11,"helgene"]]},{"id":18,"start":95.47,"end":98.0,"text":"Jeg har kanskje litt mye å gjøre.","speaker":"Bjørnar","zh":"我也许事情有点多。","words":[[0,3,95.55,95.73,"jeg"],[4,7,95.73,96.05,"har~4fa74cb61537"],[8,15,96.05,96.53,"kanskje"],[16,20,96.53,96.69,"litt~54360be2a478"],[21,24,96.69,97.27,"mye~cc164d0dc3da"],[25,26,97.27,97.39,"å~0583da7a620a"],[27,32,97.39,97.92,"gjøre"]]},{"id":19,"start":99.86,"end":100.8,"text":"Trener du?","speaker":"Lege","zh":"你锻炼吗？","words":[[0,6,99.94,100.38,"trener~777c4d52cb35"],[7,9,100.38,100.72,"du"]]},{"id":20,"start":102.06,"end":104.91,"text":"Ja, jeg løper flere ganger i uka.","speaker":"Bjørnar","zh":"锻炼，我每周跑好几次步。","words":[[0,2,102.14,102.44,"ja"],[4,7,102.9,103.04,"jeg"],[8,13,103.04,103.56,"løper"],[14,19,103.56,103.92,"flere"],[20,26,103.92,104.24,"ganger~3045db79f07e"],[27,28,104.24,104.38,"i~82e4f1cd42dc"],[29,32,104.38,104.83,"uka"]]},{"id":21,"start":106.39,"end":111.67,"text":"Det er bra at du trener, men når slapper du av?","speaker":"Lege","zh":"你锻炼是好事，但你什么时候放松呢？","words":[[0,3,106.47,106.59,"det"],[4,6,106.59,106.81,"er"],[7,10,106.81,107.13,"bra~bbb83846e29f"],[11,13,107.13,107.51,"at"],[14,16,107.51,107.79,"du"],[17,23,107.79,108.23,"trener~777c4d52cb35"],[25,28,108.99,109.71,"men"],[29,32,110.29,110.57,"når~a56a1c61425b"],[33,40,110.57,111.13,"slapper"],[41,43,111.13,111.25,"du"],[44,46,111.25,111.59,"av~e2175249f92f"]]},{"id":22,"start":111.72,"end":121.27,"text":"Jeg slapper av sammen med Ingrid, ei dame som jeg har blitt kjent med. Vi ler mye og koser oss sammen.","speaker":"Bjørnar","zh":"我和英格丽在一起时会放松，她是我认识的一位女士。我们常常一起开怀大笑，过得很惬意。","words":[[0,3,112.87,113.55,"jeg"],[4,11,113.55,114.01,"slapper"],[12,14,114.01,114.25,"av~e2175249f92f"],[15,21,114.25,114.63,"sammen"],[22,25,114.63,114.79,"med"],[26,32,114.79,115.11,"ingrid"],[34,36,115.79,116.11,"ei~47aa2d18e376"],[37,41,116.11,116.51,"dame"],[42,45,116.51,116.77,"som~b7970b8f941e"],[46,49,116.77,116.91,"jeg"],[50,53,116.91,117.07,"har~8b9792170cca"],[54,59,117.07,117.23,"blitt"],[60,65,117.23,117.51,"kjent~43c3ae802868"],[66,69,117.51,117.73,"med~c94aad168705"],[71,73,118.45,118.87,"vi"],[74,77,118.87,119.23,"ler"],[78,81,119.23,119.65,"mye~933c5a923198"],[82,84,119.65,120.05,"og"],[85,90,120.05,120.59,"koser~0ea4b0a540f9"],[91,94,120.59,120.73,"oss"],[95,101,120.73,121.19,"sammen"]]},{"id":23,"start":122.07,"end":123.13,"text":"Det er bra.","speaker":"Lege","zh":"那很好。","words":[[0,3,122.15,122.41,"det"],[4,6,122.41,122.61,"er"],[7,10,122.61,123.05,"bra~bbb83846e29f"]]},{"id":24,"start":123.84,"end":126.77,"text":"Ja, men hvorfor har jeg vondt i nakken?","speaker":"Bjørnar","zh":"是啊，可我为什么脖子疼呢？","words":[[0,2,123.92,124.19,"ja"],[4,7,124.95,125.13,"men"],[8,15,125.13,125.73,"hvorfor"],[16,19,125.73,125.87,"har"],[20,23,125.87,125.97,"jeg"],[24,29,125.97,126.33,"vondt"],[30,31,126.33,126.47,"i"],[32,38,126.47,126.69,"nakken"]]},{"id":25,"start":128.24,"end":147.02,"text":"Jeg tror at du stresser for mye. Du bør bestille time hos en fysioterapeut, og du må huske å slappe av. Du kan kjøpe smertestillende på apoteket. Jeg synes også at du skal være mer sammen med Ingrid.","speaker":"Lege","zh":"我觉得你压力太大了。你应该预约一位物理治疗师，还要记得放松。你可以在药店买止痛药。我也觉得你应该多和英格丽在一起。","words":[[0,3,128.32,128.61,"jeg"],[4,8,128.61,129.01,"tror"],[9,11,129.01,129.35,"at"],[12,14,129.35,129.63,"du"],[15,23,129.63,130.31,"stresser"],[24,27,130.31,130.49,"for~79c080957b12"],[28,31,130.49,130.85,"mye~933c5a923198"],[33,35,131.8,132.14,"du"],[36,39,132.14,132.44,"bør"],[40,48,132.44,132.9,"bestille"],[49,53,132.9,133.32,"time~5959e4e2d751"],[54,57,133.32,133.66,"hos"],[58,60,133.66,133.82,"en~a939a9e56dc5"],[61,74,133.82,134.78,"fysioterapeut"],[76,78,135.41,135.95,"og"],[79,81,135.95,136.09,"du"],[82,84,136.09,136.29,"må"],[85,90,136.29,136.79,"huske"],[91,92,136.79,136.97,"å~0583da7a620a"],[93,99,136.97,137.33,"slappe~f12305fe3dd8"],[100,102,137.33,137.59,"av~e2175249f92f"],[104,106,138.74,139.0,"du"],[107,110,139.0,139.18,"kan"],[111,116,139.18,139.62,"kjøpe"],[117,132,139.62,140.5,"smertestillende"],[133,135,140.5,140.78,"på"],[136,144,140.78,141.62,"apoteket"],[146,149,143.08,143.48,"jeg"],[150,155,143.48,143.88,"synes"],[156,160,143.88,144.22,"også"],[161,163,144.22,144.72,"at"],[164,166,144.72,144.96,"du"],[167,171,144.96,145.16,"skal~9d805d69ec96"],[172,176,145.16,145.44,"være"],[177,180,145.44,145.82,"mer~6e9e1ecc8b41"],[181,187,145.82,146.28,"sammen"],[188,191,146.28,146.42,"med"],[192,198,146.42,146.94,"ingrid"]]},{"id":26,"start":149.72,"end":152.29,"text":"Bjørnar går ut og setter seg i bilen.","zh":"比约纳尔走出去，坐进车里。","words":[[0,7,149.8,150.41,"bjørnar"],[8,11,150.41,150.59,"går"],[12,14,150.59,150.91,"ut"],[15,17,150.91,151.13,"og"],[18,24,151.13,151.45,"setter"],[25,28,151.45,151.61,"seg"],[29,30,151.61,151.75,"i"],[31,36,151.75,152.21,"bilen"]]},{"id":27,"start":153.09,"end":155.1,"text":"Han tenker på det som legen sa.","zh":"他想着医生说的话。","words":[[0,3,153.17,153.35,"han"],[4,10,153.35,153.73,"tenker"],[11,13,153.73,153.91,"på~f448aab940e8"],[14,17,153.91,154.07,"det~271e8c2ecbf0"],[18,21,154.07,154.29,"som~b7970b8f941e"],[22,27,154.29,154.55,"legen"],[28,30,154.55,155.02,"sa"]]},{"id":28,"start":156.26,"end":162.18,"text":"Nå skal han jobbe litt mindre og kose seg litt mer sammen med Ingrid.","zh":"现在他要少工作一点，多和英格丽一起享受惬意时光。","words":[[0,2,156.34,156.68,"nå~d531d47a7712"],[3,7,156.68,157.0,"skal"],[8,11,157.0,157.2,"han"],[12,17,157.2,157.6,"jobbe"],[18,22,157.6,157.92,"litt~54360be2a478"],[23,29,157.92,158.32,"mindre~d474ccc355d9"],[30,32,158.35,159.17,"og"],[33,37,159.17,159.65,"kose~c5fcca31741a"],[38,41,159.65,159.85,"seg"],[42,46,159.85,160.15,"litt~54360be2a478"],[47,50,160.15,160.47,"mer~6e9e1ecc8b41"],[51,57,160.47,161.45,"sammen"],[58,61,161.45,161.63,"med"],[62,68,161.63,162.1,"ingrid"]]},{"id":29,"start":165.61,"end":166.74,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,165.69,166.66,"sammendrag"]]},{"id":30,"start":167.97,"end":172.54,"text":"Bjørnar føler seg dårlig, og han har vondt i hodet og nakken.","zh":"比约纳尔感觉不舒服，他头疼，脖子也疼。","words":[[0,7,168.05,168.51,"bjørnar"],[8,13,168.51,168.95,"føler"],[14,17,168.95,169.11,"seg"],[18,24,169.11,169.61,"dårlig"],[26,28,170.27,170.45,"og"],[29,32,170.45,170.69,"han"],[33,36,170.69,170.85,"har"],[37,42,170.85,171.23,"vondt"],[43,44,171.23,171.33,"i"],[45,50,171.33,171.75,"hodet"],[51,53,171.75,171.87,"og"],[54,60,171.87,172.46,"nakken"]]},{"id":31,"start":173.31,"end":175.37,"text":"Det har blitt verre den siste uka.","zh":"最近一周变得更严重了。","words":[[0,3,173.39,173.47,"det"],[4,7,173.47,173.55,"har~8b9792170cca"],[8,13,173.55,173.71,"blitt"],[14,19,173.71,174.25,"verre~36ef7c6c8275"],[20,23,174.25,174.45,"den~ddf7fa00bf05"],[24,29,174.45,174.81,"siste"],[30,33,174.81,175.29,"uka"]]},{"id":32,"start":176.49,"end":180.15,"text":"Ingrid synes at han skal bestille en time hos fastlegen.","zh":"英格丽觉得他应该在家庭医生那里预约。","words":[[0,6,176.57,176.9,"ingrid"],[7,12,176.9,177.44,"synes"],[13,15,177.44,177.62,"at"],[16,19,177.62,177.8,"han"],[20,24,177.8,178.04,"skal~9d805d69ec96"],[25,33,178.04,178.48,"bestille"],[34,36,178.48,178.7,"en~a939a9e56dc5"],[37,41,178.7,179.06,"time"],[42,45,179.06,179.26,"hos"],[46,55,179.26,180.07,"fastlegen"]]},{"id":33,"start":181.17,"end":187.79,"text":"Legen spør om Bjørnar stresser for mye, og sier at han bør gå til fysioterapeut.","zh":"医生问比约纳尔是不是压力太大，并说他应该去看物理治疗师。","words":[[0,5,181.25,181.9,"legen"],[6,10,181.9,182.24,"spør"],[11,13,182.24,182.44,"om~744a29d3d900"],[14,21,182.44,182.88,"bjørnar"],[22,30,182.88,183.56,"stresser"],[31,34,183.56,183.7,"for~79c080957b12"],[35,38,183.7,184.06,"mye~933c5a923198"],[40,42,184.62,184.74,"og"],[43,47,184.74,185.06,"sier"],[48,50,185.06,185.26,"at"],[51,54,185.26,185.46,"han"],[55,58,185.46,185.66,"bør"],[59,61,185.66,185.9,"gå"],[62,65,185.9,186.14,"til"],[66,79,186.14,187.71,"fysioterapeut"]]},{"id":34,"start":189.14,"end":195.14,"text":"Legen sier også at Bjørnar må huske å slappe av mer og være oftere sammen med Ingrid.","zh":"医生还说比约纳尔必须记得多放松，并更常和英格丽在一起。","words":[[0,5,189.22,189.73,"legen"],[6,10,189.73,190.05,"sier"],[11,15,190.05,190.39,"også"],[16,18,190.39,190.67,"at"],[19,26,190.67,191.07,"bjørnar"],[27,29,191.07,191.31,"må"],[30,35,191.31,191.75,"huske"],[36,37,191.75,191.89,"å~0583da7a620a"],[38,44,191.89,192.31,"slappe~f12305fe3dd8"],[45,47,192.31,192.49,"av~e2175249f92f"],[48,51,192.49,192.75,"mer~6e9e1ecc8b41"],[52,54,193.37,193.41,"og"],[55,59,193.41,193.57,"være"],[60,66,193.57,194.01,"oftere"],[67,73,194.01,194.47,"sammen"],[74,77,194.47,194.57,"med"],[78,84,194.57,195.06,"ingrid"]]},{"id":35,"start":196.2,"end":199.53,"text":"Bjørnar gleder seg til å være mer sammen med henne.","zh":"比约纳尔盼着能更多地和她在一起。","words":[[0,7,196.28,196.78,"bjørnar"],[8,14,196.78,197.44,"gleder"],[15,18,197.44,197.64,"seg"],[19,22,197.64,197.96,"til~053dd24981ff"],[23,24,197.96,198.06,"å~0583da7a620a"],[25,29,198.06,198.22,"være"],[30,33,198.22,198.5,"mer~6e9e1ecc8b41"],[34,40,198.5,198.96,"sammen"],[41,44,198.96,199.1,"med"],[45,50,199.1,199.45,"henne"]]}],"lexicon":{"12.2":{"lemma":"12.2","zh":"第 12.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alvorlig":{"lemma":"alvorlig","zh":"严重的；认真的","pos":"形容词","ref":"12-049","clip":"pronunciation/96c2d3aa893495449eac.mp3"},"annenhver":{"lemma":"annenhver","zh":"每隔一个","pos":"限定词","ref":"4-024","clip":"pronunciation/4d88951ffa5fb057d4e7.mp3"},"apoteket":{"lemma":"apotek","zh":"药房","pos":"名词","ref":"12-056","form":"单数定指","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":"pronunciation/b1d6b91b67c2afa5e322.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"bedre":{"lemma":"god","zh":"更好（god／bra 的比较级）","pos":"形容词／副词","form":"比较级","ref":"8-009","clip":null},"bestille":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","clip":"pronunciation/e2e34eab95ffd4810bf0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":"pronunciation/8310b03324c5d3e20cdc.mp3"},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"blek":{"lemma":"blek","zh":"苍白","pos":"形容词","ref":"12-009","clip":"pronunciation/4923b54c235315b779ad.mp3"},"blitt":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"过去分词","clip":null},"blodprøver":{"lemma":"blodprøve","zh":"验血","pos":"名词","ref":"12-052","form":"复数不定","clip":null},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":