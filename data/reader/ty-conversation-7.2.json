{"id":"ty-conversation-7.2","bookId":"ty-conversation-guide","readingId":"7.2","title":"Talking about likes and dislikes","audio":"audio/ty-conversation/7.2.mp3","duration":51.513469,"synthetic":false,"sentences":[{"id":0,"start":19.69,"end":21.895,"speaker":"Kari","text":"Liker du å jobbe i en avis?","zh":"你喜欢在报社工作吗？","words":[[0,5,19.69,20.112,"liker"],[6,8,20.112,20.255,"du"],[9,10,20.35,20.455,"å"],[11,16,20.49,20.875,"jobbe"],[17,18,21.01,21.115,"i@ty-place"],[19,21,21.17,21.312,"en"],[22,26,21.312,21.895,"avis"]]},{"id":1,"start":22.37,"end":24.275,"speaker":"Olav","text":"Ja, jeg liker jobben min.","zh":"喜欢，我喜欢我的工作。","words":[[0,2,22.37,22.515,"ja"],[4,7,23.01,23.195,"jeg"],[8,13,23.27,23.715,"liker"],[14,20,23.73,24.075,"jobben"],[21,24,24.09,24.275,"min"]]},{"id":2,"start":24.81,"end":26.315,"speaker":"Olav","text":"Og du? Hva gjør du?","zh":"你呢？你做什么工作？","words":[[0,2,24.81,24.953,"og"],[3,5,24.953,25.095,"du"],[7,10,25.71,25.895,"hva"],[11,15,25.93,26.155,"gjør"],[16,18,26.19,26.315,"du"]]},{"id":3,"start":27.09,"end":28.215,"speaker":"Kari","text":"Jeg er sekretær.","zh":"我是秘书。","words":[[0,3,27.09,27.295,"jeg"],[4,6,27.31,27.475,"er@ty-be-identity"],[7,15,27.49,28.215,"sekretær"]]},{"id":4,"start":29.11,"end":30.735,"speaker":"Kari","text":"På et stort kontor.","zh":"在一个大办公室里工作。","words":[[0,2,29.11,29.275,"på@ty-on-office"],[3,5,29.35,29.535,"et"],[6,11,29.59,30.075,"stort"],[12,18,30.19,30.735,"kontor"]]},{"id":5,"start":31.37,"end":33.115,"speaker":"Olav","text":"Er jobben din interessant?","zh":"你的工作有趣吗？","words":[[0,2,31.37,31.575,"er@ty-be-description"],[3,9,31.61,32.015,"jobben"],[10,13,32.05,32.375,"din"],[14,25,32.47,33.115,"interessant"]]},{"id":6,"start":33.61,"end":36.255,"speaker":"Kari","text":"Nei, den er kjedelig.","zh":"不，挺无聊的。","words":[[0,3,33.61,34.055,"nei"],[5,8,34.69,34.915,"den@ty-den-job"],[9,11,35.03,35.275,"er@ty-be-description"],[12,20,35.57,36.255,"kjedelig"]]},{"id":7,"start":36.97,"end":38.355,"speaker":"Olav","text":"Hva vil du heller gjøre?","zh":"那你更想做什么？","words":[[0,3,36.97,37.155,"hva"],[4,7,37.21,37.392,"vil"],[8,10,37.392,37.535,"du"],[11,17,37.63,37.995,"heller"],[18,23,38.01,38.355,"gjøre"]]},{"id":8,"start":39.09,"end":41.775,"speaker":"Kari","text":"Jeg vil heller reise til USA.","zh":"我更想去美国。","words":[[0,3,39.09,39.375,"jeg"],[4,7,39.47,39.655,"vil"],[8,14,39.79,40.215,"heller"],[15,20,40.23,40.715,"reise"],[21,24,40.81,41.035,"til"],[25,28,41.23,41.775,"usa"]]},{"id":9,"start":42.45,"end":44.635,"speaker":"Olav","text":"Bor du i en stor leilighet?","zh":"你住的公寓大吗？","words":[[0,3,42.45,42.712,"bor"],[4,6,42.712,42.855,"du"],[7,8,42.97,43.093,"i@ty-place"],[9,11,43.093,43.235,"en"],[12,16,43.33,43.775,"stor"],[17,26,43.99,44.635,"leilighet"]]},{"id":10,"start":45.13,"end":49.495,"speaker":"Kari","text":"Nei, leiligheten er liten. Jeg bor alene.","zh":"不大，公寓很小。我一个人住。","words":[[0,3,45.13,45.475,"nei"],[5,16,46.03,46.835,"leiligheten"],[17,19,46.91,47.055,"er@ty-be-description"],[20,25,47.09,47.595,"liten"],[27,30,48.29,48.535,"jeg"],[31,34,48.59,48.855,"bor"],[35,40,48.93,49.495,"alene"]]}],"lexicon":{"alene":{"lemma":"alene","zh":"独自；一个人","pos":"副词","ref":"ty-conversation-7-002","clip":null},"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"den":{"lemma":"den","zh":"它（指前面的旅游指南）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性"},"den@ty-den-job":{"lemma":"den","zh":"它（指工作）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性主格","contextual":true,"baseKey":"den","surface":"den"},"din":{"lemma":"din","zh":"你的","pos":"物主限定词","ref":"ty-conversation-7-005","clip":null,"form":"通性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","