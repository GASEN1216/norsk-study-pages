{"id":"ty-conversation-7.2","bookId":"ty-conversation-guide","readingId":"7.2","title":"Talking about likes and dislikes","audio":"audio/ty-conversation/7.2.mp3","duration":51.513469,"synthetic":false,"sentences":[{"id":0,"start":18.8,"end":22.02,"speaker":"Kari","text":"Liker du å jobbe i en avis?","zh":"你喜欢在报社工作吗？","words":[[0,5,18.8,20.1,"liker"],[6,8,20.1,20.38,"du"],[9,10,20.38,20.62,"å"],[11,16,20.62,20.98,"jobbe"],[17,18,20.98,21.3,"i@ty-place"],[19,21,21.3,21.44,"en"],[22,26,21.44,22.02,"avis"]]},{"id":1,"start":22.44,"end":24.46,"speaker":"Olav","text":"Ja, jeg liker jobben min.","zh":"喜欢，我喜欢我的工作。","words":[[0,2,22.44,22.64,"ja"],[4,7,22.98,23.28,"jeg"],[8,13,23.28,23.84,"liker"],[14,20,23.84,24.14,"jobben"],[21,24,24.14,24.46,"min"]]},{"id":2,"start":24.84,"end":26.6,"speaker":"Olav","text":"Og du? Hva gjør du?","zh":"你呢？你做什么工作？","words":[[0,2,24.84,25.02,"og"],[3,5,25.02,25.3,"du"],[7,10,25.78,25.96,"hva"],[11,15,25.96,26.22,"gjør"],[16,18,26.22,26.6,"du"]]},{"id":3,"start":27.02,"end":28.92,"speaker":"Kari","text":"Jeg er sekretær.","zh":"我是秘书。","words":[[0,3,27.02,27.34,"jeg"],[4,6,27.34,27.54,"er@ty-be-identity"],[7,15,27.54,28.92,"sekretær"]]},{"id":4,"start":28.92,"end":31.2,"speaker":"Kari","text":"På et stort kontor.","zh":"在一个大办公室里工作。","words":[[0,2,28.92,29.4,"på@ty-on-office"],[3,5,29.4,29.78,"et"],[6,11,29.78,30.2,"stort"],[12,18,30.2,31.2,"kontor"]]},{"id":5,"start":31.28,"end":33.08,"speaker":"Olav","text":"Er jobben din interessant?","zh":"你的工作有趣吗？","words":[[0,2,31.28,31.66,"er@ty-be-description"],[3,9,31.66,32.12,"jobben"],[10,13,32.12,32.46,"din"],[14,25,32.46,33.08,"interessant"]]},{"id":6,"start":33.78,"end":36.66,"speaker":"Kari","text":"Nei, den er kjedelig.","zh":"不，挺无聊的。","words":[[0,3,33.78,34.54,"nei"],[5,8,34.72,35.0,"den@ty-den-job"],[9,11,35.0,35.62,"er@ty-be-description"],[12,20,35.62,36.66,"kjedelig"]]},{"id":7,"start":36.98,"end":38.44,"speaker":"Olav","text":"Hva vil du heller gjøre?","zh":"那你更想做什么？","words":[[0,3,36.98,37.24,"hva"],[4,7,37.24,37.5,"vil"],[8,10,37.5,37.72,"du"],[11,17,37.72,38.02,"heller"],[18,23,38.02,38.44,"gjøre"]]},{"id":8,"start":39.02,"end":42.0,"speaker":"Kari","text":"Jeg vil heller reise til USA.","zh":"我更想去美国。","words":[[0,3,39.02,39.5,"jeg"],[4,7,39.5,39.82,"vil"],[8,14,39.82,40.26,"heller"],[15,20,40.26,40.82,"reise"],[21,24,40.82,41.3,"til"],[25,28,41.3,42.0,"usa"]]},{"id":9,"start":42.66,"end":44.76,"speaker":"Olav","text":"Bor du i en stor leilighet?","zh":"你住的公寓大吗？","words":[[0,3,42.66,42.74,"bor"],[4,6,42.74,43.06,"du"],[7,8,43.06,43.2,"i@ty-place"],[9,11,43.2,43.5,"en"],[12,16,43.5,44.02,"stor"],[17,26,44.02,44.76,"leilighet"]]},{"id":10,"start":44.76,"end":49.58,"speaker":"Kari","text":"Nei, leiligheten er liten. Jeg bor alene.","zh":"不大，公寓很小。我一个人住。","words":[[0,3,44.76,46.02,"nei"],[5,16,46.1,46.9,"leiligheten"],[17,19,46.9,47.2,"er@ty-be-description"],[20,25,47.2,47.74,"liten"],[27,30,48.3,48.58,"jeg"],[31,34,48.58,48.94,"bor"],[35,40,48.94,49.58,"alene"]]}],"lexicon":{"alene":{"lemma":"alene","zh":"独自；一个人","pos":"副词","ref":"ty-conversation-7-002","clip":null},"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"den":{"lemma":"den","zh":"它（指前面的旅游指南）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性"},"den@ty-den-job":{"lemma":"den","zh":"它（指工作）","pos":"代词","ref":"ty-conversation-4-003","clip":null,"form":"通性主格","contextual":true,"baseKey":"den","surface":"den"},"din":{"lemma":"din","zh":"你的","pos":"物主限定词","ref":"ty-conversation-7-005","clip":null,"form":"通性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-description":{"lemma":"være","zh