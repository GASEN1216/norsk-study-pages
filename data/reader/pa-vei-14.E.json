{"id":"pa-vei-14.E","bookId":"pa-vei-textbook","readingId":"14.E","title":"Å bo sammen i Norge","audio":"audio/pa-vei/14.E.mp3","duration":123.648,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.88,"end":1.105,"text":"Hei!","zh":"你好！","words":[[0,3,0.88,1.105,"hei"]],"speaker":"Forelsket"},{"id":1,"start":2.18,"end":4.885,"text":"Jeg er norsk og har bodd i Mosambik en god stund.","zh":"我是挪威人，已经在莫桑比克住了相当长一段时间。","words":[[0,3,2.18,2.365,"jeg"],[4,6,2.38,2.502,"er"],[7,12,2.502,2.925,"norsk@pa-vei-norsk-adjective"],[13,15,3.0,3.103,"og"],[16,19,3.103,3.242,"har"],[20,24,3.242,3.452,"bodd"],[25,26,3.452,3.532,"i"],[27,35,3.532,4.205,"mosambik"],[36,38,4.28,4.412,"en"],[39,42,4.412,4.585,"god"],[43,48,4.6,4.885,"stund"]],"speaker":"Forelsket"},{"id":2,"start":5.56,"end":7.865,"text":"Der har jeg truffet verdens kjekkeste mann!","zh":"在那里，我遇到了世界上最帅的男人！","words":[[0,3,5.56,5.793,"der"],[4,7,5.793,5.912,"har"],[8,11,5.912,6.022,"jeg"],[12,19,6.022,6.425,"truffet"],[20,27,6.6,7.143,"verdens"],[28,37,7.143,7.623,"kjekkeste"],[38,42,7.623,7.865,"mann"]],"speaker":"Forelsket"},{"id":3,"start":8.896,"end":13.381,"text":"Nå må jeg dra hjem igjen, men vi er forelsket og har lyst til å bo sammen i Norge.","zh":"现在我必须回国了，可是我们相爱了，想一起在挪威生活。","words":[[0,2,8.896,9.041,"nå"],[3,5,9.056,9.178,"må"],[6,9,9.178,9.299,"jeg"],[10,13,9.299,9.441,"dra"],[14,18,9.456,9.661,"hjem"],[19,24,9.696,9.941,"igjen"],[26,29,10.316,10.521,"men"],[30,32,10.716,10.838,"vi"],[33,35,10.838,10.948,"er"],[36,45,10.948,11.581,"forelsket"],[46,48,11.656,11.758,"og"],[49,52,11.758,11.858,"har"],[53,57,11.858,12.079,"lyst@pa-vei-lyst-desire"],[58,61,12.079,12.209,"til"],[62,63,12.209,12.301,"å"],[64,66,12.316,12.461,"bo"],[67,73,12.596,12.941,"sammen"],[74,75,12.976,13.069,"i"],[76,81,13.069,13.381,"norge"]],"speaker":"Forelsket"},{"id":4,"start":14.496,"end":18.741,"text":"Jeg vet at kjæresten min må ha oppholdstillatelse, og at det er vanskelig å få.","zh":"我知道，我的男朋友需要居留许可，而且很难申请到。","words":[[0,3,14.496,14.659,"jeg"],[4,7,14.659,14.899,"vet"],[8,10,14.899,15.028,"at"],[11,20,15.028,15.448,"kjæresten"],[21,24,15.448,15.579,"min"],[25,27,15.579,15.698,"må"],[28,30,15.698,15.841,"ha"],[31,49,15.916,16.941,"oppholdstillatelse"],[51,53,17.596,17.699,"og"],[54,56,17.699,17.798,"at"],[57,60,17.798,17.898,"det"],[61,63,17.898,18.001,"er"],[64,73,18.036,18.519,"vanskelig"],[74,75,18.519,18.599,"å"],[76,78,18.599,18.741,"få"]],"speaker":"Forelsket"},{"id":5,"start":19.876,"end":21.601,"text":"Hva skal vi gjøre for å få dette til?","zh":"我们该怎么做才能实现这个愿望？","words":[[0,3,19.876,20.041,"hva"],[4,8,20.056,20.239,"skal"],[9,11,20.239,20.338,"vi"],[12,17,20.338,20.661,"gjøre"],[18,21,20.756,20.898,"for"],[22,23,20.898,20.978,"å"],[24,26,20.978,21.121,"få"],[27,32,21.156,21.419,"dette"],[33,36,21.419,21.601,"til"]],"speaker":"Forelsket"},{"id":6,"start":22.556,"end":24.361,"text":"Har noen vært i en liknende situasjon?","zh":"有人遇到过类似情况吗？","words":[[0,3,22.556,22.729,"har"],[4,8,22.729,22.998,"noen"],[9,13,22.998,23.248,"vært"],[14,15,23.248,23.328,"i"],[16,18,23.328,23.438,"en"],[19,27,23.438,23.808,"liknende"],[28,37,23.808,24.361,"situasjon"]],"speaker":"Forelsket"},{"id":7,"start":25.256,"end":26.361,"text":"Takknemlig for svar.","zh":"如能回复，不胜感激。","words":[[0,10,25.256,25.901,"takknemlig"],[11,14,25.916,26.069,"for"],[15,19,26.069,26.361,"svar"]],"speaker":"Forelsket"},{"id":8,"start":30.496,"end":31.601,"text":"Til Forelsket","zh":"致“恋爱中的人”：","words":[[0,3,30.496,30.741,"til"],[4,13,30.856,31.601,"forelsket"]],"speaker":"Tulla"},{"id":9,"start":34.076,"end":39.181,"text":"Jeg kan kanskje gi deg et råd, men bare hvis dere har tenkt å gifte dere.","zh":"也许我能给你一个建议，不过前提是你们打算结婚。","words":[[0,3,34.076,34.261,"jeg"],[4,7,34.276,34.461,"kan"],[8,15,34.516,34.969,"kanskje"],[16,18,34.969,35.101,"gi@pa-vei-extra-37"],[19,22,35.116,35.281,"deg"],[23,25,35.316,35.478,"et"],[26,29,35.478,35.761,"råd"],[31,34,36.936,37.121,"men"],[35,39,37.176,37.508,"bare"],[40,44,37.508,37.728,"hvis"],[45,49,37.728,37.868,"dere"],[50,53,37.868,38.021,"har"],[54,59,38.036,38.441,"tenkt"],[60,61,38.456,38.561,"å"],[62,67,38.576,38.969,"gifte"],[68,72,38.969,39.181,"dere"]],"speaker":"Tulla"},{"id":10,"start":41.336,"end":50.541,"text":"Da kan han søke om noe som heter forlovedetillatelse i Mosambik (du kan lese mer om det på nettsidene til UDI).","zh":"那么，他可以在莫桑比克申请一种叫作“未婚夫（妻）居留许可”的许可，你可以到挪威移民局 UDI 的网站了解更多信息。","words":[[0,2,41.336,41.461,"da"],[3,6,41.496,41.678,"kan"],[7,10,41.678,41.841,"han"],[11,15,41.936,42.319,"søke"],[16,18,42.319,42.419,"om"],[19,22,42.419,42.639,"noe"],[23,26,42.639,42.781,"som"],[27,32,42.796,43.221,"heter"],[33,52,43.756,45.181,"forlovedetillatelse"],[53,54,45.696,45.799,"i"],[55,63,45.799,46.381,"mosambik"],[65,67,47.536,47.659,"du"],[68,71,47.659,47.821,"kan"],[72,76,47.876,48.261,"lese"],[77,80,48.276,48.519,"mer"],[81,83,48.519,48.629,"om"],[84,87,48.629,48.781,"det"],[88,90,48.796,48.941,"på"],[91,101,48.956,49.721,"nettsidene"],[102,105,49.916,50.101,"til"],[106,109,50.176,50.541,"udi"]],"speaker":"Tulla"},{"id":11,"start":52.156,"end":61.681,"text":"Med en slik tillatelse kan kjæresten din reise til Norge og være her i seks måneder, men i løpet av den tida må dere gifte dere.","zh":"有了这种许可，你的男朋友就可以来挪威停留六个月，不过你们必须在这段时间内结婚。","words":[[0,3,52.156,52.338,"med"],[4,6,52.338,52.481,"en"],[7,11,52.536,52.921,"slik"],[12,22,52.956,53.641,"tillatelse"],[23,26,53.996,54.181,"kan"],[27,36,54.256,54.799,"kjæresten"],[37,40,54.799,54.998,"din"],[41,46,54.998,55.379,"reise"],[47,50,55.379,55.541,"til"],[51,56,55.596,55.981,"norge"],[57,59,56.356,56.478,"og"],[60,64,56.478,56.739,"være"],[65,68,56.739,56.888,"her"],[69,70,56.888,56.981,"i"],[71,75,57.036,57.398,"seks"],[76,83,57.398,57.801,"måneder"],[85,88,58.816,59.001,"men"],[89,90,59.036,59.161,"i"],[91,96,59.196,59.678,"løpet@pa-vei-extra-40"],[97,99,59.678,59.808,"av"],[100,103,59.808,59.981,"den@pa-vei-den-definite"],[104,108,60.036,60.381,"tida"],[109,111,60.716,60.841,"må"],[112,116,60.856,61.069,"dere"],[117,122,61.069,61.428,"gifte"],[123,127,61.428,61.681,"dere"]],"speaker":"Tulla"},{"id":12,"start":65.616,"end":66.201,"text":"Hei Tulla","zh":"你好，图拉。","words":[[0,3,65.616,65.821,"hei"],[4,9,65.876,66.201,"tulla"]],"speaker":"Forelsket"},{"id":13,"start":66.936,"end":68.841,"text":"Og hvis vi ikke gifter oss?","zh":"如果我们不结婚呢？","words":[[0,2,66.936,67.081,"og"],[3,7,67.336,67.548,"hvis"],[8,10,67.548,67.661,"vi"],[11,15,67.716,68.081,"ikke"],[16,22,68.296,68.638,"gifter"],[23,26,68.638,68.841,"oss"]],"speaker":"Forelsket"},{"id":14,"start":73.036,"end":74.041,"text":"Til Forelsket","zh":"致“恋爱中的人”：","words":[[0,3,73.036,73.261,"til"],[4,13,73.356,74.041,"forelsket"]],"speaker":"Tulla"},{"id":15,"start":75.316,"end":76.901,"text":"Da må han reise fra landet.","zh":"那他就必须离开挪威。","words":[[0,2,75.316,75.461,"da"],[3,5,75.556,75.701,"må"],[6,9,75.716,75.901,"han"],[10,15,75.916,76.361,"reise"],[16,19,76.376,76.559,"fra"],[20,26,76.559,76.901,"landet"]],"speaker":"Tulla"},{"id":16,"start":81.096,"end":81.661,"text":"Hei Tulla","zh":"你好，图拉。","words":[[0,3,81.096,81.301,"hei"],[4,9,81.356,81.661,"tulla"]],"speaker":"Forelsket"},{"id":17,"start":82.496,"end":84.661,"text":"Seks måneder er altfor kort tid, synes jeg.","zh":"我觉得六个月实在太短了。","words":[[0,4,82.496,82.819,"seks"],[5,12,82.819,83.249,"måneder"],[13,15,83.249,83.381,"er"],[16,22,83.436,83.839,"altfor"],[23,27,83.839,84.058,"kort@pa-vei-kort-short"],[28,31,84.058,84.279,"tid"],[33,38,84.279,84.508,"synes"],[39,42,84.508,84.661,"jeg"]],"speaker":"Forelsket"},{"id":18,"start":85.696,"end":87.981,"text":"I Norge vil han møte mange utfordringer.","zh":"在挪威，他会面临很多挑战。","words":[[0,1,85.696,85.809,"i"],[2,7,85.809,86.161,"norge"],[8,11,86.196,86.328,"vil"],[12,15,86.328,86.448,"han"],[16,20,86.448,86.781,"møte"],[21,26,86.876,87.261,"mange"],[27,39,87.316,87.981,"utfordringer"]],"speaker":"Forelsket"},{"id":19,"start":88.896,"end":92.241,"text":"Hvordan vet vi at han vil trives - etter så kort tid?","zh":"这么短的时间之后，我们怎么知道他会不会喜欢在这里生活？","words":[[0,7,88.896,89.221,"hvordan"],[8,11,89.236,89.508,"vet"],[12,14,89.508,89.619,"vi"],[15,17,89.619,89.739,"at"],[18,21,89.739,89.849,"han"],[22,25,89.849,89.981,"vil"],[26,32,89.996,90.521,"trives"],[35,40,91.236,91.501,"etter"],[41,43,91.516,91.661,"så"],[44,48,91.736,91.989,"kort@pa-vei-kort-short"],[49,52,91.989,92.241,"tid"]],"speaker":"Forelsket"},{"id":20,"start":96.816,"end":97.801,"text":"Til Forelsket","zh":"致“恋爱中的人”：","words":[[0,3,96.816,97.021,"til"],[4,13,97.116,97.801,"forelsket"]],"speaker":"Tulla"},{"id":21,"start":99.256,"end":104.521,"text":"Enig! Et halvt år er kort tid, men slik er reglene.","zh":"同意！半年时间很短，不过规定就是这样。","words":[[0,4,99.256,99.741,"enig"],[6,8,100.996,101.181,"et"],[9,14,101.196,101.561,"halvt"],[15,17,101.576,101.801,"år"],[18,20,101.816,101.961,"er"],[21,25,101.976,102.298,"kort@pa-vei-kort-short"],[26,29,102.298,102.581,"tid"],[31,34,103.396,103.581,"men"],[35,39,103.616,103.918,"slik"],[40,42,103.918,104.089,"er"],[43,50,104.089,104.521,"reglene"]],"speaker":"Tulla"},{"id":22,"start":105.696,"end":106.901,"text":"Du må tenke deg godt om.","zh":"你必须认真想清楚。","words":[[0,2,105.696,105.809,"du"],[3,5,105.809,105.941,"må"],[6,11,105.956,106.269,"tenke"],[12,15,106.269,106.421,"deg"],[16,20,106.456,106.758,"godt"],[21,23,106.758,106.901,"om"]],"speaker":"Tulla"},{"id":23,"start":110.876,"end":111.441,"text":"Hei Tulla","zh":"你好，图拉。","words":[[0,3,110.876,111.061,"hei"],[4,9,111.116,111.441,"tulla"]],"speaker":"Forelsket"},{"id":24,"start":111.976,"end":113.041,"text":"Takk for svarene dine.","zh":"谢谢你的回复。","words":[[0,4,111.976,112.249,"takk"],[5,8,112.249,112.388,"for"],[9,16,112.388,112.809,"svarene"],[17,21,112.809,113.041,"dine"]],"speaker":"Forelsket"},{"id":25,"start":114.236,"end":116.021,"text":"Er det noen som har erfaringer her?","zh":"这里有人有相关经历吗？","words":[[0,2,114.236,114.358,"er"],[3,6,114.358,114.469,"det"],[7,11,114.469,114.749,"noen"],[12,15,114.749,114.901,"som"],[16,19,114.916,115.181,"har"],[20,30,115.216,115.838,"erfaringer"],[31,34,115.838,116.021,"her"]],"speaker":"Forelsket"},{"id":26,"start":116.856,"end":121.121,"text":"Jeg vil høre om alt, både positive og negative erfaringer.","zh":"我什么都想听，好的和不好的经历都想了解。","words":[[0,3,116.856,116.988,"jeg"],[4,7,116.988,117.108,"vil"],[8,12,117.108,117.319,"høre"],[13,15,117.319,117.441,"om"],[16,19,117.456,117.821,"alt"],[21,25,118.536,118.821,"både"],[26,34,118.836,119.441,"positive@pa-vei-extra-38"],[35,37,119.796,119.941,"og"],[38,46,119.996,120.561,"negative@pa-vei-extra-39"],[47,57,120.576,121.121,"erfaringer"]],"speaker":"Forelsket"}],"lexicon":{"alt":{"lemma":"alt","zh":"一切","pos":"代词","ref":"10-054","clip":null},"altfor":{"lemma":"altfor","zh":"太；过于","pos":"副词","ref":"pa-vei-14-085","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bo":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"不定式","clip":null},"bodd":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"过去分词","clip":null},"både":{"lemma":"både","zh":"既……又……；……和……都（både ... og）","pos":"连词","ref":"10-017","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"den@pa-vei-den-definite":{"lemma":"den","pos":"定冠词","zh":"这个；那个（形容词或序数词前的通性定冠词）","ref":null,"clip":null,"contextual":true,"baseKey":"den","surface":"den"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"dere":{"lemma":"dere","zh":"你们","pos":"代词","ref":"ty-conversation-4-004","clip":null,"form":"主格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dette":{"lemma":"de