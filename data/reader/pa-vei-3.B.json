{"id":"pa-vei-3.B","bookId":"pa-vei-textbook","readingId":"3.B","title":"Blir du med på kino?","audio":"audio/pa-vei/3.B.mp3","duration":82.344,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.48,"end":5.125,"text":"B. Blir du med på kino?","zh":"B. 你一起去看电影吗？","words":[[0,1,2.48,2.8,"b"],[3,7,3.8,4.203,"blir"],[8,10,4.203,4.325,"du"],[11,14,4.34,4.505,"med"],[15,17,4.52,4.645,"på"],[18,22,4.72,5.125,"kino"]]},{"id":1,"start":7.6,"end":9.685,"text":"Mobilen til Irina ringer:","zh":"伊琳娜的手机响了：","words":[[0,7,7.6,8.285,"mobilen"],[8,11,8.38,8.585,"til"],[12,17,8.7,9.305,"irina"],[18,24,9.32,9.685,"ringer"]]},{"id":2,"start":11.9,"end":13.945,"text":"Hallo? Det er Irina.","zh":"喂？我是伊琳娜。","words":[[0,5,11.9,12.165,"hallo"],[7,10,13.04,13.205,"det"],[11,13,13.22,13.465,"er"],[14,19,13.48,13.945,"irina"]],"speaker":"Irina"},{"id":3,"start":14.98,"end":16.005,"text":"Hei, det er Thomas.","zh":"你好，我是托马斯。","words":[[0,3,14.98,15.225,"hei"],[5,8,15.3,15.433,"det"],[9,11,15.433,15.543,"er"],[12,18,15.543,16.005,"thomas"]],"speaker":"Thomas"},{"id":4,"start":17.352,"end":19.517,"text":"Hei Thomas. Takk for sist.","zh":"嗨，托马斯。上次见面很愉快。","words":[[0,3,17.352,17.557,"hei"],[4,10,17.592,18.037,"thomas"],[12,16,18.752,18.995,"takk"],[17,20,18.995,19.154,"for"],[21,25,19.154,19.517,"sist"]],"speaker":"Irina"},{"id":5,"start":21.132,"end":24.677,"text":"I like måte. Du, blir du med på kino?","zh":"我也一样。对了，你一起去看电影吗？","words":[[0,1,21.132,21.237,"i"],[2,6,21.252,21.564,"like@pa-vei-like-same"],[7,11,21.564,21.857,"måte"],[13,15,22.832,22.977,"du"],[17,21,23.812,24.014,"blir"],[22,24,24.014,24.114,"du"],[25,28,24.114,24.255,"med"],[29,31,24.255,24.374,"på"],[32,36,24.374,24.677,"kino"]],"speaker":"Thomas"},{"id":6,"start":25.572,"end":27.417,"text":"Det går en film fra Latvia på Scala.","zh":"斯卡拉电影院正在上映一部拉脱维亚电影。","words":[[0,3,25.572,25.724,"det"],[4,7,25.724,25.884,"går"],[8,10,25.884,26.014,"en"],[11,15,26.014,26.264,"film"],[16,19,26.264,26.415,"fra"],[20,26,26.415,26.794,"latvia"],[27,29,26.794,26.937,"på"],[30,35,27.052,27.417,"scala"]],"speaker":"Thomas"},{"id":7,"start":28.712,"end":32.857,"text":"Ja, gjerne. Det har jeg lyst til. Når da?","zh":"好啊，我很想去。什么时候？","words":[[0,2,28.712,28.877,"ja"],[4,10,29.132,29.737,"gjerne"],[12,15,30.632,30.797,"det"],[16,19,30.852,31.005,"har"],[20,23,31.005,31.154,"jeg"],[24,28,31.154,31.384,"lyst@pa-vei-lyst-desire"],[29,32,31.384,31.537,"til"],[34,37,32.512,32.715,"når"],[38,40,32.715,32.857,"da"]],"speaker":"Irina"},{"id":8,"start":34.292,"end":36.277,"text":"Kan du på fredag eller lørdag?","zh":"你星期五或星期六有空吗？","words":[[0,3,34.292,34.517,"kan"],[4,6,34.532,34.675,"du"],[7,9,34.675,34.797,"på"],[10,16,34.852,35.397,"fredag"],[17,22,35.672,35.915,"eller"],[23,29,35.915,36.277,"lørdag"]],"speaker":"Thomas"},{"id":9,"start":38.112,"end":42.017,"text":"Fredag kan jeg ikke, men lørdag går bra.","zh":"星期五我不行，不过星期六可以。","words":[[0,6,38.112,38.877,"fredag"],[7,10,38.972,39.175,"kan"],[11,14,39.175,39.344,"jeg"],[15,19,39.344,39.637,"ikke"],[21,24,40.472,40.677,"men"],[25,31,40.812,41.417,"lørdag"],[32,35,41.632,41.814,"går"],[36,39,41.814,42.017,"bra"]],"speaker":"Irina"},{"id":10,"start":43.272,"end":46.957,"text":"Fint. Da kjøper jeg to billetter til lørdag klokka sju.","zh":"好。那我买两张星期六七点的票。","words":[[0,4,43.272,43.597,"fint"],[6,8,44.472,44.597,"da"],[9,15,44.692,44.995,"kjøper"],[16,19,44.995,45.117,"jeg"],[20,22,45.132,45.297,"to"],[23,32,45.352,45.794,"billetter"],[33,36,45.794,45.974,"til"],[37,43,45.974,46.317,"lørdag"],[44,50,46.412,46.717,"klokka"],[51,54,46.772,46.957,"sju"]],"speaker":"Thomas"},{"id":11,"start":47.732,"end":48.177,"text":"Vi ses!","zh":"到时见！","words":[[0,2,47.732,47.874,"vi"],[3,6,47.874,48.177,"ses"]],"speaker":"Thomas"},{"id":12,"start":49.232,"end":50.477,"text":"Ja, det gjør vi.","zh":"好的，到时见。","words":[[0,2,49.232,49.397,"ja"],[4,7,49.912,50.097,"det"],[8,12,50.112,50.355,"gjør"],[13,15,50.355,50.477,"vi"]],"speaker":"Irina"},{"id":13,"start":55.092,"end":55.797,"text":"Sammendrag.","zh":"摘要","words":[[0,10,55.092,55.797,"sammendrag"]]},{"id":14,"start":57.582,"end":61.627,"text":"Thomas ringer til Irina og inviterer henne på kino.","zh":"托马斯给伊琳娜打电话，邀请她去看电影。","words":[[0,6,57.582,58.127,"thomas"],[7,13,58.262,58.624,"ringer"],[14,17,58.624,58.807,"til"],[18,23,58.962,59.467,"irina"],[24,26,59.822,59.947,"og"],[27,36,60.022,60.805,"inviterer"],[37,42,60.805,61.044,"henne"],[43,45,61.044,61.167,"på"],[46,50,61.242,61.627,"kino"]]},{"id":15,"start":63.462,"end":68.867,"text":"Irina kommer fra Latvia, og nå går det en film fra Latvia på Scala.","zh":"伊琳娜来自拉脱维亚，现在斯卡拉电影院正在上映一部拉脱维亚电影。","words":[[0,5,63.462,63.967,"irina"],[6,12,64.062,64.407,"kommer"],[13,16,64.422,64.607,"fra"],[17,23,64.642,65.167,"latvia"],[25,27,65.822,65.967,"og"],[28,30,66.002,66.147,"nå"],[31,34,66.322,66.525,"går"],[35,38,66.525,66.665,"det"],[39,41,66.665,66.807,"en"],[42,46,66.842,67.187,"film"],[47,50,67.322,67.527,"fra"],[51,57,67.562,68.087,"latvia"],[58,60,68.202,68.347,"på"],[61,66,68.422,68.867,"scala"]]},{"id":16,"start":71.012,"end":72.197,"text":"Irina blir glad.","zh":"伊琳娜很高兴。","words":[[0,5,71.012,71.477,"irina"],[6,10,71.532,71.777,"blir"],[11,15,71.872,72.197,"glad"]]},{"id":17,"start":73.772,"end":79.957,"text":"Hun blir gjerne med på kino, og Thomas kjøper to billetter til lørdag klokka sju.","zh":"她很愿意一起去看电影，托马斯买了两张星期六七点的票。","words":[[0,3,73.772,73.977,"hun"],[4,8,74.012,74.277,"blir"],[9,15,74.292,74.737,"gjerne"],[16,19,74.752,74.977,"med"],[20,22,74.992,75.137,"på"],[23,27,75.172,75.517,"kino"],[29,31,76.272,76.397,"og"],[32,38,76.432,76.917,"thomas"],[39,45,76.932,77.297,"kjøper"],[46,48,77.332,77.517,"to"],[49,58,77.612,78.097,"billetter"],[59,62,78.472,78.657,"til"],[63,69,78.732,79.277,"lørdag"],[70,76,79.392,79.737,"klokka"],[77,80,79.772,79.957,"sju"]]}],"lexicon":{"b":{"lemma":"B","pos":"字母","zh":"字母 B","ref":null,"clip":null},"billetter":{"lemma":"billett","zh":"票","pos":"名词","ref":"7-118","form":"复数不定","clip":null},"blir":{