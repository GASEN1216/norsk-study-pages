{"id":"pa-vei-4.B","bookId":"pa-vei-textbook","readingId":"4.B","title":"Familien Bugge Dahl","audio":"audio/pa-vei/4.B.mp3","duration":132.816,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.5,"end":4.685,"text":"B. Familien Bugge Dahl","zh":"B. 布格·达尔一家","words":[[0,1,1.5,2.0,"b"],[3,11,3.2,3.885,"familien"],[12,17,3.96,4.363,"bugge"],[18,22,4.363,4.685,"dahl"]]},{"id":1,"start":6.98,"end":10.805,"text":"Marianne Bugge og Henrik Dahl er gift.","zh":"玛丽安娜·布格和亨里克·达尔结婚了。","words":[[0,8,6.98,7.645,"marianne"],[9,14,7.68,8.105,"bugge"],[15,17,8.5,8.645,"og"],[18,24,8.78,9.265,"henrik"],[25,29,9.3,9.645,"dahl"],[30,32,10.06,10.305,"er"],[33,37,10.36,10.805,"gift"]]},{"id":2,"start":12.76,"end":16.985,"text":"Marianne er 37 år og Henrik er 39.","zh":"玛丽安娜 37 岁，亨里克 39 岁。","words":[[0,8,12.76,13.365,"marianne"],[9,11,13.48,13.705,"er"],[12,14,13.8,14.425,"37"],[15,17,14.62,14.865,"år"],[18,20,15.5,15.625,"og"],[21,27,15.68,16.185,"henrik"],[28,30,16.24,16.425,"er"],[31,33,16.48,16.985,"39"]]},{"id":3,"start":19.2,"end":22.665,"text":"Marianne er konsulent og jobber på et kontor.","zh":"玛丽安娜是一名顾问，在办公室工作。","words":[[0,8,19.2,19.805,"marianne"],[9,11,19.86,20.085,"er"],[12,21,20.18,20.985,"konsulent"],[22,24,21.28,21.405,"og"],[25,31,21.44,21.805,"jobber"],[32,34,21.82,21.965,"på"],[35,37,21.98,22.163,"et"],[38,44,22.163,22.665,"kontor"]]},{"id":4,"start":24.52,"end":27.465,"text":"Henrik er lærer og jobber på en skole.","zh":"亨里克是一名老师，在学校工作。","words":[[0,6,24.52,25.005,"henrik"],[7,9,25.02,25.165,"er"],[10,15,25.22,25.665,"lærer"],[16,18,26.18,26.305,"og"],[19,25,26.34,26.682,"jobber"],[26,28,26.682,26.825,"på"],[29,31,26.84,26.985,"en"],[32,37,27.04,27.465,"skole"]]},{"id":5,"start":29.38,"end":33.125,"text":"De har to barn, ei datter og en sønn.","zh":"他们有两个孩子，一个女儿和一个儿子。","words":[[0,2,29.38,29.525,"de"],[3,6,29.64,29.885,"har"],[7,9,30.0,30.165,"to"],[10,14,30.28,30.585,"barn"],[16,18,31.34,31.505,"ei"],[19,25,31.58,32.045,"datter"],[26,28,32.4,32.525,"og"],[29,31,32.58,32.725,"en"],[32,36,32.78,33.125,"sønn"]]},{"id":6,"start":35.03,"end":37.955,"text":"Dattera heter Emma og er sju år.","zh":"女儿叫埃玛，七岁。","words":[[0,7,35.03,35.515,"dattera"],[8,13,35.61,35.995,"heter"],[14,18,36.09,36.435,"emma"],[19,21,36.87,37.015,"og"],[22,24,37.03,37.215,"er"],[25,28,37.35,37.535,"sju"],[29,31,37.71,37.955,"år"]]},{"id":7,"start":39.03,"end":40.175,"text":"Hun går på skolen.","zh":"她在上学。","words":[[0,3,39.03,39.255,"hun"],[4,7,39.31,39.555,"går"],[8,10,39.59,39.735,"på"],[11,17,39.75,40.175,"skolen"]]},{"id":8,"start":42.35,"end":43.955,"text":"Sønnen heter Jonas.","zh":"儿子叫约纳斯。","words":[[0,6,42.35,42.795,"sønnen"],[7,12,42.89,43.315,"heter"],[13,18,43.39,43.955,"jonas"]]},{"id":9,"start":45.1,"end":47.985,"text":"Han er tre år og går i barnehagen.","zh":"他三岁，在上幼儿园。","words":[[0,3,45.1,45.305,"han"],[4,6,45.42,45.625,"er"],[7,10,45.74,46.005,"tre"],[11,13,46.12,46.365,"år"],[14,16,46.8,46.925,"og"],[17,20,46.94,47.183,"går"],[21,22,47.183,47.282,"i"],[23,33,47.282,47.985,"barnehagen"]]},{"id":10,"start":49.72,"end":50.905,"text":"De har også en katt.","zh":"他们还有一只猫。","words":[[0,2,49.72,49.865,"de"],[3,6,49.94,50.142,"har"],[7,11,50.142,50.405,"også"],[12,14,50.42,50.562,"en"],[15,19,50.562,50.905,"katt"]]},{"id":11,"start":52.02,"end":54.785,"text":"Den er fire år og heter Pus.","zh":"它四岁了，叫普斯。","words":[[0,3,52.02,52.225,"den"],[4,6,52.26,52.445,"er"],[7,11,52.54,52.965,"fire"],[12,14,53.02,53.245,"år"],[15,17,53.72,53.865,"og"],[18,23,53.88,54.305,"heter"],[24,27,54.38,54.785,"pus"]]},{"id":12,"start":58.38,"end":64.285,"text":"Marianne er kona til Henrik og mora til Emma og Jonas.","zh":"玛丽安娜是亨里克的妻子，也是埃玛和约纳斯的妈妈。","words":[[0,8,58.38,59.145,"marianne"],[9,11,59.32,59.525,"er"],[12,16,59.68,60.225,"kona"],[17,20,60.3,60.485,"til"],[21,27,60.52,61.085,"henrik"],[28,30,62.02,62.165,"og"],[31,35,62.2,62.645,"mora"],[36,39,62.98,63.165,"til"],[40,44,63.26,63.565,"emma"],[45,47,63.66,63.782,"og"],[48,53,63.782,64.285,"jonas"]]},{"id":13,"start":66.5,"end":72.045,"text":"Henrik er mannen til Marianne og faren til Emma og Jonas.","zh":"亨里克是玛丽安娜的丈夫，也是埃玛和约纳斯的爸爸。","words":[[0,6,66.5,67.105,"henrik"],[7,9,67.2,67.425,"er"],[10,16,67.54,68.045,"mannen"],[17,20,68.12,68.305,"til"],[21,29,68.36,68.865,"marianne"],[30,32,69.82,69.945,"og"],[33,38,70.04,70.605,"faren"],[39,42,70.9,71.065,"til"],[43,47,71.14,71.405,"emma"],[48,50,71.46,71.593,"og"],[51,56,71.593,72.045,"jonas"]]},{"id":14,"start":74.24,"end":79.865,"text":"Emma er søstera til Jonas og dattera til Henrik og Marianne.","zh":"埃玛是约纳斯的姐姐，也是亨里克和玛丽安娜的女儿。","words":[[0,4,74.24,74.625,"emma"],[5,7,74.76,75.025,"er"],[8,15,75.18,75.845,"søstera"],[16,19,76.14,76.325,"til"],[20,25,76.34,76.845,"jonas"],[26,28,77.5,77.625,"og"],[29,36,77.68,78.165,"dattera"],[37,40,78.58,78.765,"til"],[41,47,78.8,79.282,"henrik"],[48,50,79.282,79.382,"og"],[51,59,79.382,79.865,"marianne"]]},{"id":15,"start":82.56,"end":87.865,"text":"Jonas er broren til Emma og sønnen til Henrik og Marianne.","zh":"约纳斯是埃玛的弟弟，也是亨里克和玛丽安娜的儿子。","words":[[0,5,82.56,83.165,"jonas"],[6,8,83.28,83.445,"er"],[9,15,83.54,84.125,"broren"],[16,19,84.14,84.305,"til"],[20,24,84.36,84.645,"emma"],[25,27,85.68,85.825,"og"],[28,34,85.92,86.425,"sønnen"],[35,38,86.5,86.665,"til"],[39,45,86.72,87.262,"henrik"],[46,48,87.262,87.382,"og"],[49,57,87.382,87.865,"marianne"]]},{"id":16,"start":90.32,"end":94.305,"text":"Emma og Jonas er barna til Marianne og Henrik.","zh":"埃玛和约纳斯是玛丽安娜和亨里克的孩子。","words":[[0,4,90.32,90.685,"emma"],[5,7,90.76,90.885,"og"],[8,13,90.9,91.485,"jonas"],[14,16,91.78,91.945,"er"],[17,22,92.02,92.505,"barna"],[23,26,92.84,93.025,"til"],[27,35,93.06,93.645,"marianne"],[36,38,93.68,93.822,"og"],[39,45,93.822,94.305,"henrik"]]},{"id":17,"start":96.8,"end":101.645,"text":"Marianne og Henrik er foreldrene til Emma og Jonas.","zh":"玛丽安娜和亨里克是埃玛和约纳斯的父母。","words":[[0,8,96.8,97.412,"marianne"],[9,11,97.412,97.525,"og"],[12,18,97.54,98.105,"henrik"],[19,21,98.92,99.105,"er"],[22,32,99.16,99.965,"foreldrene"],[33,36,100.3,100.485,"til"],[37,41,100.58,100.905,"emma"],[42,44,101.04,101.172,"og"],[45,50,101.172,101.645,"jonas"]]},{"id":18,"start":107.16,"end":109.985,"text":"Matpakka til Emma ligger på bordet.","zh":"埃玛带去吃的午餐放在桌上。","words":[[0,8,107.16,107.865,"matpakka"],[9,12,107.88,108.065,"til"],[13,17,108.14,108.445,"emma"],[18,24,108.96,109.385,"ligger"],[25,27,109.44,109.565,"på"],[28,34,109.6,109.985,"bordet"]]},{"id":19,"start":111.92,"end":114.285,"text":"Den ligger mellom koppen og glasset.","zh":"它放在杯子和玻璃杯之间。","words":[[0,3,111.92,112.125,"den"],[4,10,112.2,112.565,"ligger"],[11,17,112.64,113.085,"mellom"],[18,24,113.16,113.625,"koppen"],[25,27,113.72,113.863,"og"],[28,35,113.863,114.285,"glasset"]]},{"id":20,"start":116.38,"end":118.625,"text":"Skolesekken står under bordet.","zh":"书包在桌子下面。","words":[[0,11,116.38,117.305,"skolesekken"],[12,16,117.44,117.765,"står"],[17,22,117.9,118.265,"under"],[23,29,118.28,118.625,"bordet"]]},{"id":21,"start":120.54,"end":123.105,"text":"Eplet ligger på gulvet under bordet.","zh":"苹果在桌子下面的地板上。","words":[[0,5,120.54,121.002,"eplet"],[6,12,121.002,121.385,"ligger"],[13,15,121.46,121.605,"på"],[16,22,121.64,122.085,"gulvet"],[23,28,122.38,122.765,"under"],[29,35,122.78,123.105,"bordet"]]},{"id":22,"start":125.26,"end":126.785,"text":"Det er melk i glasset.","zh":"玻璃杯里有牛奶。","words":[[0,3,125.26,125.425,"det"],[4,6,125.44,125.585,"er"],[7,11,125.66,126.125,"melk"],[12,13,126.2,126.305,"i"],[14,21,126.34,126.785,"glasset"]]},{"id":23,"start":128.88,"end":130.725,"text":"Jonas står bak døra.","zh":"约纳斯站在门后面。","words":[[0,5,128.88,129.425,"jonas"],[6,10,129.64,129.965,"står"],[11,14,130.04,130.425,"bak"],[15,19,130.44,130.725,"døra"]]}],"lexicon":{"37":{"lemma":"37","pos":"数词","zh":"数字 37","ref":null,"clip":null},"39":{"lemma":"39","pos":"数词","zh":"数字 39","ref":null,"clip":null},"b":{"lemma":"B","pos":"字母","zh":"字母 B","ref":null,"clip":null},"bak":{"lemma":"bak","pos":"介词","zh":"在……后面","ref":null,"clip":null},"barn