{"id":"8.6","title":"Yrkestekst 2: Jeg er frisør","audio":"audio/8.6.mp3","duration":49.01,"synthetic":true,"sentences":[{"id":0,"start":0.18,"end":1.39,"text":"Jeg er frisør","heading":true,"zh":"我是理发师","words":[[0,3,0.26,0.5,"jeg"],[4,6,0.5,0.74,"er"],[7,13,0.74,1.3,"frisør"]]},{"id":1,"start":2.36,"end":5.8,"text":"Jeg er frisør og jobber på en frisørsalong som heter Saks & Kam.","zh":"我是理发师，在一家叫“剪刀与梳子”（Saks & Kam）的理发店工作。","words":[[0,3,2.44,2.63,"jeg"],[4,6,2.63,2.75,"er"],[7,13,2.75,3.17,"frisør"],[14,16,3.17,3.37,"og"],[17,23,3.37,3.59,"jobber~003ddb6d77e6"],[24,26,3.59,3.71,"på"],[27,29,3.71,3.81,"en~a939a9e56dc5"],[30,42,3.81,4.51,"frisørsalong"],[43,46,4.51,4.71,"som~b7970b8f941e"],[47,52,4.71,4.93,"heter"],[53,57,4.93,5.27,"saks"],[58,59,5.27,5.47,"&"],[60,63,5.47,5.72,"kam"]]},{"id":2,"start":6.81,"end":8.29,"text":"Det er en interessant jobb.","zh":"这是一份有趣的工作。","words":[[0,3,6.89,7.08,"det"],[4,6,7.08,7.26,"er"],[7,9,7.26,7.4,"en~a939a9e56dc5"],[10,21,7.4,7.8,"interessant"],[22,26,7.8,8.21,"jobb"]]},{"id":3,"start":9.34,"end":12.6,"text":"Jeg har gode kollegaer, og jeg møter mange spennende mennesker.","zh":"我有很好的同事，还能遇到很多有意思的人。","words":[[0,3,9.42,9.57,"jeg"],[4,7,9.57,9.71,"har"],[8,12,9.71,9.99,"gode"],[13,22,9.99,10.59,"kollegaer"],[24,26,10.85,11.05,"og"],[27,30,11.05,11.15,"jeg"],[31,36,11.15,11.43,"møter~0b9e8705aec3"],[37,42,11.43,11.63,"mange"],[43,52,11.63,12.01,"spennende"],[53,62,12.01,12.52,"mennesker"]]},{"id":4,"start":13.54,"end":15.71,"text":"Jeg liker veldig godt å jobbe som frisør.","zh":"我非常喜欢当理发师。","words":[[0,3,13.62,13.78,"jeg"],[4,9,13.78,14.08,"liker"],[10,16,14.08,14.34,"veldig"],[17,21,14.34,14.58,"godt~31386d5489ca"],[22,23,14.58,14.74,"å~0583da7a620a"],[24,29,14.74,14.98,"jobbe"],[30,33,14.98,15.16,"som~90f492b4f2ff"],[34,40,15.16,15.63,"frisør"]]},{"id":5,"start":16.7,"end":18.58,"text":"Mange kunder klipper seg hos oss.","zh":"很多顾客在我们这儿剪头发。","words":[[0,5,16.78,17.08,"mange"],[6,12,17.08,17.42,"kunder"],[13,20,17.42,17.86,"klipper"],[21,24,17.86,18.0,"seg"],[25,28,18.0,18.2,"hos"],[29,32,18.2,18.5,"oss"]]},{"id":6,"start":19.52,"end":22.78,"text":"Først vasker jeg håret til kundene, og etterpå klipper jeg dem.","zh":"我先给顾客洗头，然后给他们剪发。","words":[[0,5,19.6,19.92,"først"],[6,12,19.92,20.22,"vasker~4b94c156b07f"],[13,16,20.22,20.28,"jeg"],[17,22,20.28,20.64,"håret"],[23,26,20.64,20.64,"til~8de1a9181f86"],[27,34,20.64,21.02,"kundene"],[36,38,21.46,21.68,"og"],[39,46,21.68,22.06,"etterpå"],[47,54,22.06,22.4,"klipper"],[55,58,22.4,22.48,"jeg"],[59,62,22.48,22.7,"dem"]]},{"id":7,"start":23.71,"end":26.24,"text":"Kundene betaler og går hjem med ny frisyre.","zh":"顾客付完钱，顶着新发型回家。","words":[[0,7,23.79,24.2,"kundene"],[8,15,24.2,24.66,"betaler"],[16,18,24.66,24.94,"og"],[19,22,24.94,25.08,"går"],[23,27,25.08,25.26,"hjem~d6e7695d7250"],[28,31,25.26,25.4,"med"],[32,34,25.4,25.54,"ny"],[35,42,25.54,26.16,"frisyre"]]},{"id":8,"start":27.18,"end":29.61,"text":"De føler seg fine, og da blir jeg glad.","zh":"他们觉得自己变好看了，这时我就很开心。","words":[[0,2,27.26,27.42,"de"],[3,8,27.42,27.74,"føler"],[9,12,27.74,27.88,"seg"],[13,17,27.88,28.22,"fine"],[19,21,28.64,28.78,"og"],[22,24,28.78,28.94,"da~fba15067726f"],[25,29,28.94,29.12,"blir"],[30,33,29.12,29.22,"jeg"],[34,38,29.22,29.53,"glad"]]},{"id":9,"start":30.59,"end":31.6,"text":"Hos frisøren","subheading":true,"zh":"在理发店","words":[[0,3,30.67,30.86,"hos"],[4,12,30.86,31.52,"frisøren"]]},{"id":10,"start":32.56,"end":33.63,"text":"Hvordan vil du ha håret?","speaker":"Ingrid","zh":"你想剪成什么样？","words":[[0,7,32.64,32.95,"hvordan"],[8,11,32.95,33.15,"vil"],[12,14,33.15,33.27,"du"],[15,17,33.27,33.39,"ha~94f78325d58a"],[18,23,33.39,33.63,"håret"]]},{"id":11,"start":33.79,"end":37.21,"text":"Jeg pleier å ha det kort i nakken.","speaker":"Bjørnar","zh":"我一般把后颈处留短一些。","words":[[0,3,33.79,34.14,"jeg"],[4,10,34.14,34.6,"pleier"],[11,12,34.6,35.05,"å~0583da7a620a"],[13,15,35.05,35.5,"ha~7db5d6ba77a1"],[16,19,35.5,35.96,"det"],[20,24,35.96,36.41,"kort~64ac3418bd47"],[25,26,36.41,36.87,"i"],[27,33,36.87,37.21,"nakken"]]},{"id":12,"start":37.22,"end":39.55,"text":"Skal jeg klippe det kort ved ørene også?","speaker":"Ingrid","zh":"耳朵旁边也要剪短吗？","words":[[0,4,37.32,37.88,"skal"],[5,8,37.88,38.0,"jeg"],[9,15,38.0,38.28,"klippe"],[16,19,38.28,38.36,"det"],[20,24,38.36,38.6,"kort~64ac3418bd47"],[25,28,38.6,38.78,"ved"],[29,34,38.78,39.1,"ørene"],[35,39,39.1,39.47,"også"]]},{"id":13,"start":40.52,"end":44.28,"text":"Ja, takk! Hva koster det å klippe seg her?","speaker":"Bjørnar","zh":"要，谢谢！在这儿剪头发多少钱？","words":[[0,2,40.6,40.94,"ja"],[4,8,41.24,41.7,"takk"],[10,13,42.66,42.98,"hva"],[14,20,42.98,43.36,"koster"],[21,24,43.36,43.46,"det"],[25,26,43.46,43.54,"å~0583da7a620a"],[27,33,43.54,43.8,"klippe"],[34,37,43.8,43.96,"seg"],[38,41,43.96,44.2,"her"]]},{"id":14,"start":45.25,"end":48.03,"text":"Det koster 399 kroner for en herreklipp.","speaker":"Ingrid","zh":"男士理发399克朗。","words":[[0,3,45.33,45.46,"det"],[4,10,45.46,45.88,"koster"],[11,14,45.88,46.7,"399"],[15,21,46.7,47.28,"kroner"],[22,25,47.28,47.44,"for~2b0474af71b1"],[26,28,47.44,47.54,"en~a939a9e56dc5"],[29,39,47.54,47.95,"herreklipp"]]}],"lexicon":{"&":{"lemma":"&","zh":"和（符号）","pos":"符号","ref":null,"clip":null},"399":{"lemma":"399","zh":"数字 399","pos":"数词","ref":null,"clip":null,"kind":"number"},"betaler":{"lemma":"betale","zh":"支付","pos":"动词","ref":"basics:verbs:betale","form":"现在时","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":"pronunciation/9422127081333b8048f1.mp3"},"da":{"lemma":"da","zh":"那时；那么；（语气）呀；当……的时候","pos":"副词／从属连词","ref":"13-002","clip":"pronunciation/aa58b21b01d6b8a99c1a.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"dem":{"lemma":"dem","zh":"他们/她们/它们（宾格）","pos":"代词","ref":"2-074","clip":"pronunciation/5bd1269b11fc4c7c128e.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"le