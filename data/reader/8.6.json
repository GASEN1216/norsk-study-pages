{"id":"8.6","title":"Yrkestekst 2: Jeg er frisør","audio":"audio/8.6.mp3","duration":49.01,"synthetic":true,"sentences":[{"id":0,"start":0.21,"end":1.46,"text":"Jeg er frisør","heading":true,"zh":"我是理发师","words":[[0,3,0.27,0.64,"jeg"],[4,6,0.64,0.82,"er"],[7,13,0.82,1.31,"frisør"]]},{"id":1,"start":2.4,"end":5.87,"text":"Jeg er frisør og jobber på en frisørsalong som heter Saks & Kam.","zh":"我是理发师，在一家叫“剪刀与梳子”（Saks & Kam）的理发店工作。","words":[[0,3,2.46,2.68,"jeg"],[4,6,2.68,2.8,"er"],[7,13,2.8,3.3,"frisør"],[14,16,3.3,3.42,"og"],[17,23,3.42,3.64,"jobber~003ddb6d77e6"],[24,26,3.64,3.74,"på"],[27,29,3.74,3.82,"en~a939a9e56dc5"],[30,42,3.82,4.6,"frisørsalong"],[43,46,4.6,4.76,"som~b7970b8f941e"],[47,52,4.76,5.08,"heter"],[53,57,5.08,5.33,"saks"],[58,59,5.33,5.5,"&"],[60,63,5.5,5.71,"kam"]]},{"id":2,"start":6.85,"end":8.37,"text":"Det er en interessant jobb.","zh":"这是一份有趣的工作。","words":[[0,3,6.91,7.14,"det"],[4,6,7.14,7.3,"er"],[7,9,7.3,7.46,"en~a939a9e56dc5"],[10,21,7.46,8.06,"interessant"],[22,26,8.06,8.22,"jobb"]]},{"id":3,"start":9.38,"end":12.66,"text":"Jeg har gode kollegaer, og jeg møter mange spennende mennesker.","zh":"我有很好的同事，还能遇到很多有意思的人。","words":[[0,3,9.44,9.62,"jeg"],[4,7,9.62,9.78,"har"],[8,12,9.78,10.04,"gode"],[13,22,10.04,10.79,"kollegaer"],[24,26,10.96,11.06,"og"],[27,30,11.06,11.2,"jeg"],[31,36,11.2,11.48,"møter~0b9e8705aec3"],[37,42,11.48,11.76,"mange"],[43,52,11.76,12.06,"spennende"],[53,62,12.06,12.51,"mennesker"]]},{"id":4,"start":13.57,"end":15.79,"text":"Jeg liker veldig godt å jobbe som frisør.","zh":"我非常喜欢当理发师。","words":[[0,3,13.63,13.84,"jeg"],[4,9,13.84,14.14,"liker"],[10,16,14.14,14.44,"veldig"],[17,21,14.44,14.7,"godt~31386d5489ca"],[22,23,14.7,14.78,"å~0583da7a620a"],[24,29,14.78,15.04,"jobbe"],[30,33,15.04,15.22,"som~90f492b4f2ff"],[34,40,15.22,15.64,"frisør"]]},{"id":5,"start":16.73,"end":18.63,"text":"Mange kunder klipper seg hos oss.","zh":"很多顾客在我们这儿剪头发。","words":[[0,5,16.79,17.18,"mange"],[6,12,17.18,17.58,"kunder"],[13,20,17.58,17.92,"klipper"],[21,24,17.92,18.08,"seg"],[25,28,18.08,18.28,"hos"],[29,32,18.28,18.48,"oss"]]},{"id":6,"start":19.57,"end":22.84,"text":"Først vasker jeg håret til kundene, og etterpå klipper jeg dem.","zh":"我先给顾客洗头，然后给他们剪发。","words":[[0,5,19.62,19.96,"først"],[6,12,19.96,20.24,"vasker~4b94c156b07f"],[13,16,20.24,20.34,"jeg"],[17,22,20.34,20.56,"håret"],[23,26,20.56,20.7,"til~8de1a9181f86"],[27,34,20.7,21.27,"kundene"],[36,38,21.6,21.72,"og"],[39,46,21.72,22.14,"etterpå"],[47,54,22.14,22.42,"klipper"],[55,58,22.42,22.54,"jeg"],[59,62,22.54,22.7,"dem"]]},{"id":7,"start":23.75,"end":26.3,"text":"Kundene betaler og går hjem med ny frisyre.","zh":"顾客付完钱，顶着新发型回家。","words":[[0,7,23.8,24.26,"kundene"],[8,15,24.26,24.88,"betaler"],[16,18,24.88,24.98,"og"],[19,22,24.98,25.14,"går"],[23,27,25.14,25.32,"hjem~d6e7695d7250"],[28,31,25.32,25.44,"med"],[32,34,25.44,25.62,"ny"],[35,42,25.62,26.15,"frisyre"]]},{"id":8,"start":27.21,"end":29.69,"text":"De føler seg fine, og da blir jeg glad.","zh":"他们觉得自己变好看了，这时我就很开心。","words":[[0,2,27.27,27.5,"de"],[3,8,27.5,27.8,"føler"],[9,12,27.8,27.98,"seg"],[13,17,27.98,28.49,"fine"],[19,21,28.7,28.82,"og"],[22,24,28.82,29.0,"da~fba15067726f"],[25,29,29.0,29.16,"blir"],[30,33,29.16,29.3,"jeg"],[34,38,29.3,29.54,"glad"]]},{"id":9,"start":30.59,"end":31.66,"text":"Hos frisøren","subheading":true,"zh":"在理发店","words":[[0,3,30.65,30.98,"hos"],[4,12,30.98,31.52,"frisøren"]]},{"id":10,"start":32.59,"end":33.96,"text":"Hvordan vil du ha håret?","speaker":"Ingrid","zh":"你想剪成什么样？","words":[[0,7,32.66,33.02,"hvordan"],[8,11,33.02,33.2,"vil"],[12,14,33.2,33.32,"du"],[15,17,33.32,33.46,"ha~94f78325d58a"],[18,23,33.46,33.81,"håret"]]},{"id":11,"start":34.91,"end":36.69,"text":"Jeg pleier å ha det kort i nakken.","speaker":"Bjørnar","zh":"我一般把后颈处留短一些。","words":[[0,3,34.97,35.18,"jeg"],[4,10,35.18,35.52,"pleier"],[11,12,35.52,35.6,"å~0583da7a620a"],[13,15,35.6,35.7,"ha~7db5d6ba77a1"],[16,19,35.7,35.84,"det"],[20,24,35.84,36.12,"kort~64ac3418bd47"],[25,26,36.12,36.2,"i"],[27,33,36.2,36.54,"nakken"]]},{"id":12,"start":37.62,"end":39.61,"text":"Skal jeg klippe det kort ved ørene også?","speaker":"Ingrid","zh":"耳朵旁边也要剪短吗？","words":[[0,4,37.68,37.9,"skal"],[5,8,37.9,38.02,"jeg"],[9,15,38.02,38.32,"klippe"],[16,19,38.32,38.44,"det"],[20,24,38.44,38.72,"kort~64ac3418bd47"],[25,28,38.72,38.86,"ved"],[29,34,38.86,39.16,"ørene"],[35,39,39.16,39.46,"også"]]},{"id":13,"start":40.55,"end":44.37,"text":"Ja, takk! Hva koster det å klippe seg her?","speaker":"Bjørnar","zh":"要，谢谢！在这儿剪头发多少钱？","words":[[0,2,40.62,41.03,"ja"],[4,8,41.3,41.81,"takk"],[10,13,42.82,43.06,"hva"],[14,20,43.06,43.4,"koster"],[21,24,43.4,43.5,"det"],[25,26,43.5,43.56,"å~0583da7a620a"],[27,33,43.56,43.88,"klippe"],[34,37,43.88,44.02,"seg"],[38,41,44.02,44.22,"her"]]},{"id":14,"start":45.28,"end":48.17,"text":"Det koster 399 kroner for en herreklipp.","speaker":"Ingrid","zh":"男士理发399克朗。","words":[[0,3,45.34,45.52,"det"],[4,10,45.52,46.02,"koster"],[11,14,46.02,46.9,"399"],[15,21,46.9,47.36,"kroner"],[22,25,47.36,47.48,"for~2b0474af71b1"],[26,28,47.48,47.56,"en~a939a9e56dc5"],[29,39,47.56,48.02,"herreklipp"]]}],"lexicon":{"&":{"lemma":"&","zh":"和（符号）","pos":"符号","ref":null,"clip":null},"399":{"lemma":"399","zh":"数字 399","pos":"数词","ref":null,"clip":null,"kind":"number"},"betaler":{"lemma":"betale","zh":"付钱；支付","pos":"动词","ref":"basics:verbs:betale","form":"现在时","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":"pronunciation/9422127081333b8048f1.mp3"},"da":{"lemma":"da","zh":"那时；那么；（语气）呀；当……的时候","pos":"副词／从属连词","ref":"13-002","clip":"pronunciation/aa58b21b01d6b8a99c1a.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"dem":{"lemma":"dem","zh":"他们/她们/它们（宾格）","pos":"代词","ref":"2-074","clip":"pronunciation/5bd1269b11fc4c7c128e.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"lem