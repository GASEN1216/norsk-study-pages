{"id":"8.1","title":"Ingrid leter etter bil på finn.no","audio":"audio/8.1.mp3","duration":199.87,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.77,"text":"8.1 Ingrid leter etter bil på finn.no","heading":true,"zh":"8.1 英格丽在 finn.no 上找车","words":[[0,3,0.15,1.19,"8.1"],[4,10,2.17,2.68,"ingrid"],[11,16,2.68,3.16,"leter"],[17,22,3.16,3.46,"etter~b63576d203db"],[23,26,3.46,3.8,"bil"],[27,29,3.8,4.58,"på"],[30,37,4.58,4.96,"finn.no"]]},{"id":1,"start":8.08,"end":17.88,"text":"Ingrid fant en fin leilighet til leie på finn.no for en måned siden, og i forrige uke flyttet hun inn.","zh":"一个月前，英格丽在 finn.no 上找到了一套不错的出租公寓，上周她搬了进去。","words":[[0,6,8.14,8.7,"ingrid"],[7,11,8.7,9.0,"fant"],[12,14,9.0,9.22,"en~a939a9e56dc5"],[15,18,9.22,9.58,"fin"],[19,28,9.58,10.28,"leilighet"],[29,32,10.28,10.5,"til~abe973e831b7"],[33,37,10.5,11.05,"leie~c7346f915bfb"],[38,40,11.34,11.54,"på"],[41,48,11.54,12.56,"finn.no"],[49,52,12.84,13.02,"for~d0291af9704a"],[53,55,13.02,13.16,"en~a939a9e56dc5"],[56,61,13.16,13.6,"måned"],[62,67,13.6,14.08,"siden~9a3d2d89a980"],[69,71,15.2,15.4,"og"],[72,73,15.4,15.56,"i"],[74,81,15.56,16.0,"forrige"],[82,85,16.0,16.49,"uke"],[86,93,16.9,17.28,"flyttet"],[94,97,17.28,17.48,"hun"],[98,101,17.48,17.73,"inn"]]},{"id":2,"start":19.37,"end":24.49,"text":"Nå vil hun kjøpe en bruktbil, for hun har lang vei til jobben.","zh":"现在她想买一辆二手车，因为她上班的路很远。","words":[[0,2,19.43,19.8,"nå~d531d47a7712"],[3,6,19.8,19.96,"vil"],[7,10,19.96,20.18,"hun"],[11,16,20.18,20.66,"kjøpe"],[17,19,20.66,20.84,"en~a939a9e56dc5"],[20,28,20.84,21.59,"bruktbil"],[30,33,22.28,22.6,"for~1b22712a94b1"],[34,37,22.6,22.8,"hun"],[38,41,22.8,23.04,"har"],[42,46,23.04,23.44,"lang"],[47,50,23.44,23.76,"vei"],[51,54,23.76,23.94,"til"],[55,61,23.94,24.34,"jobben"]]},{"id":3,"start":25.63,"end":30.28,"text":"Hun får hjelp av faren, men han kan ikke så mye om biler.","zh":"她爸爸来帮她，但他对汽车懂得不多。","words":[[0,3,25.69,26.02,"hun"],[4,7,26.02,26.22,"får"],[8,13,26.22,26.56,"hjelp"],[14,16,26.56,26.7,"av~c11c5256beb5"],[17,22,26.7,27.27,"faren"],[24,27,28.04,28.28,"men"],[28,31,28.28,28.6,"han"],[32,35,28.6,28.88,"kan~65cb7f5b118b"],[36,40,28.88,29.16,"ikke"],[41,43,29.16,29.34,"så~8a6ad167a88f"],[44,47,29.34,29.58,"mye~cc164d0dc3da"],[48,50,29.58,29.72,"om~52c0bdc828db"],[51,56,29.72,30.13,"biler"]]},{"id":4,"start":31.29,"end":33.7,"text":"De leter på finn.no.","zh":"他们在 finn.no 上找。","words":[[0,2,31.35,31.58,"de"],[3,8,31.58,32.23,"leter"],[9,11,32.34,32.56,"på"],[12,19,32.56,33.55,"finn.no"]]},{"id":5,"start":36.02,"end":41.74,"text":"Vi skal finne en god bil til deg. Der er en fin Mercedes!","speaker":"Far","zh":"我们会给你找一辆好车的。那儿有一辆不错的奔驰！","words":[[0,2,36.08,36.56,"vi"],[3,7,36.56,36.88,"skal"],[8,13,36.88,37.28,"finne"],[14,16,37.28,37.44,"en~a939a9e56dc5"],[17,20,37.44,37.68,"god"],[21,24,37.68,37.96,"bil"],[25,28,37.96,38.12,"til"],[29,32,38.12,38.48,"deg"],[34,37,39.76,40.18,"der"],[38,40,40.18,40.36,"er"],[41,43,40.36,40.54,"en~a939a9e56dc5"],[44,47,40.54,40.84,"fin"],[48,56,40.84,41.59,"mercedes"]]},{"id":6,"start":42.53,"end":44.02,"text":"Den er i god stand.","zh":"车况很好。","words":[[0,3,42.59,42.94,"den"],[4,6,42.94,43.12,"er"],[7,8,43.12,43.22,"i~4d590f1b6b8d"],[9,12,43.22,43.48,"god"],[13,18,43.48,43.88,"stand"]]},{"id":7,"start":45.05,"end":53.96,"text":"Den er så dyr. Jeg vil ikke kjøpe en dyr bil, og den må ikke være for stor, for jeg har ikke plass i garasjen.","speaker":"Ingrid","zh":"它好贵啊。我不想买贵的车，而且车不能太大，因为我的车库放不下。","words":[[0,3,45.12,45.3,"den"],[4,6,45.3,45.48,"er"],[7,9,45.48,45.7,"så~3871b614434d"],[10,13,45.7,46.2,"dyr~46cd0091fd01"],[15,18,47.04,47.2,"jeg"],[19,22,47.2,47.4,"vil"],[23,27,47.4,47.66,"ikke"],[28,33,47.66,48.02,"kjøpe"],[34,36,48.02,48.18,"en~a939a9e56dc5"],[37,40,48.18,48.5,"dyr~46cd0091fd01"],[41,44,48.5,48.95,"bil"],[46,48,49.64,49.72,"og"],[49,52,49.72,49.92,"den"],[53,55,49.92,50.14,"må~b97ba6405a2a"],[56,60,50.14,50.36,"ikke"],[61,65,50.36,50.66,"være"],[66,69,50.66,50.82,"for~79c080957b12"],[70,74,50.82,51.35,"stor"],[76,79,52.04,52.14,"for~1b22712a94b1"],[80,83,52.14,52.3,"jeg"],[84,87,52.3,52.48,"har"],[88,92,52.48,52.7,"ikke"],[93,98,52.7,53.06,"plass"],[99,100,53.06,53.14,"i"],[101,109,53.14,53.81,"garasjen"]]},{"id":8,"start":54.76,"end":60.85,"text":"Se her! Denne bilen er ganske ny, og den har fine seter i skinn.","speaker":"Far","zh":"看这儿！这辆车挺新的，还有漂亮的真皮座椅。","words":[[0,2,54.82,55.18,"se~26e2daf31e48"],[3,6,55.18,55.66,"her"],[8,13,56.28,56.64,"denne"],[14,19,56.64,57.04,"bilen"],[20,22,57.04,57.22,"er"],[23,29,57.22,57.74,"ganske"],[30,32,57.74,58.05,"ny"],[34,36,58.64,58.78,"og"],[37,40,58.78,58.98,"den"],[41,44,58.98,59.18,"har"],[45,49,59.18,59.6,"fine"],[50,55,59.6,60.16,"seter"],[56,57,60.16,60.3,"i~7bc2ee1f0e19"],[58,63,60.3,60.7,"skinn"]]},{"id":9,"start":61.58,"end":70.99,"text":"Jeg trenger ikke fine seter, og jeg trenger ikke en ny bil. Denne bilen er også for dyr, og jeg har lyst på en rød bil.","speaker":"Ingrid","zh":"我不需要漂亮的座椅，也不需要新车。这辆车也太贵了，而且我想要一辆红色的车。","words":[[0,3,61.64,61.9,"jeg"],[4,11,61.9,62.3,"trenger"],[12,16,62.3,62.58,"ikke"],[17,21,62.58,62.94,"fine"],[22,27,62.94,63.63,"seter"],[29,31,64.12,64.2,"og"],[32,35,64.2,64.4,"jeg"],[36,43,64.4,64.82,"trenger"],[44,48,64.82,65.02,"ikke"],[49,51,65.02,65.2,"en~a939a9e56dc5"],[52,54,65.2,65.46,"ny"],[55,58,65.46,65.9,"bil"],[60,65,66.62,66.98,"denne"],[66,71,66.98,67.28,"bilen"],[72,74,67.28,67.5,"er"],[75,79,67.5,67.9,"også"],[80,83,67.9,68.08,"for~79c080957b12"],[84,87,68.08,68.52,"dyr~46cd0091fd01"],[89,91,69.3,69.4,"og"],[92,95,69.4,69.54,"jeg"],[96,99,69.54,69.64,"har"],[100,104,69.64,69.88,"lyst~b499524f55a4"],[105,107,69.88,69.98,"på~40ad664c0969"],[108,110,69.98,70.18,"en~a939a9e56dc5"],[111,114,70.18,70.5,"rød"],[115,118,70.5,70.84,"bil"]]},{"id":10,"start":71.79,"end":81.44,"text":"Er fargen så viktig, da? Du kan kjøpe en billig bil, men billige og gamle biler trenger ofte reparasjoner, vet du.","speaker":"Far","zh":"颜色有那么重要吗？你可以买辆便宜的车，可是你知道，又便宜又旧的车常常需要修理。","words":[[0,2,71.85,72.3,"er"],[3,9,72.3,72.82,"fargen"],[10,12,72.82,73.0,"så~d9d17638efa6"],[13,19,73.0,73.36,"viktig"],[21,23,73.36,73.66,"da~caaa1f71fadf"],[25,27,74.8,74.94,"du"],[28,31,74.94,75.14,"kan"],[32,37,75.14,75.5,"kjøpe"],[38,40,75.5,75.64,"en~a939a9e56dc5"],[41,47,75.64,76.0,"billig~e2a403b2a2e8"],[48,51,76.0,76.46,"bil"],[53,56,77.32,77.58,"men"],[57,64,77.58,77.98,"billige"],[65,67,77.98,78.1,"og"],[68,73,78.1,78.42,"gamle"],[74,79,78.42,78.98,"biler"],[80,87,79.4,79.74,"trenger"],[88,92,79.74,80.06,"ofte"],[93,105,80.06,80.86,"reparasjoner"],[107,110,80.86,81.04,"vet"],[111,113,81.04,81.29,"du"]]},{"id":11,"start":82.16,"end":85.36,"text":"Ja, det kan ikke du hjelpe meg med!","speaker":"Ingrid","zh":"是啊，这个你可帮不了我！","words":[[0,2,82.22,82.66,"ja"],[4,7,83.1,83.48,"det"],[8,11,83.76,83.98,"kan"],[12,16,83.98,84.24,"ikke"],[17,19,84.24,84.44,"du"],[20,26,84.44,84.76,"hjelpe"],[27,30,84.76,84.94,"meg"],[31,34,84.94,85.21,"med~41eec44f57d5"]]},{"id":12,"start":86.31,"end":89.33,"text":"Nei, jeg er ingen bilmekaniker.","speaker":"Far","zh":"是啊，我又不是汽车修理工。","words":[[0,3,86.37,86.84,"nei"],[5,8,87.38,87.6,"jeg"],[9,11,87.6,87.78,"er"],[12,17,87.78,88.18,"ingen~47148835f7bd"],[18,30,88.18,89.18,"bilmekaniker"]]},{"id":13,"start":90.33,"end":99.5,"text":"Vi finner ingen bil i dag, pappa, men jeg kjenner faktisk en bilmekaniker. Han kan kanskje hjelpe meg med å finne en god bruktbil.","speaker":"Ingrid","zh":"爸爸，我们今天是找不到车了，不过我其实认识一个汽车修理工。他也许能帮我找到一辆好的二手车。","words":[[0,2,90.39,90.62,"vi"],[3,9,90.62,91.0,"finner"],[10,15,91.0,91.32,"ingen~47148835f7bd"],[16,19,91.32,91.64,"bil"],[20,21,91.64,91.74,"i~de136e71704d"],[22,25,91.74,92.02,"dag"],[27,32,92.02,92.54,"pappa"],[34,37,93.12,93.58,"men"],[38,41,93.58,93.82,"jeg"],[42,49,93.82,94.26,"kjenner"],[50,57,94.26,94.72,"faktisk"],[58,60,94.72,94.84,"en~a939a9e56dc5"],[61,73,94.84,95.82,"bilmekaniker"],[75,78,96.46,96.68,"han"],[79,82,96.68,96.88,"kan"],[83,90,96.88,97.26,"kanskje"],[91,97,97.26,97.64,"hjelpe"],[98,101,97.64,97.94,"meg"],[102,105,97.94,98.08,"med~41eec44f57d5"],[106,107,98.08,98.2,"å~0583da7a620a"],[108,113,98.2,98.46,"finne"],[114,116,98.46,98.6,"en~a939a9e56dc5"],[117,120,98.6,98.82,"god"],[121,129,98.82,99.35,"bruktbil"]]},{"id":14,"start":100.52,"end":104.91,"text":"Det er en god idé, for jeg er ikke så flink med biler.","speaker":"Far","zh":"这是个好主意，因为我对汽车不太在行。","words":[[0,3,100.58,100.94,"det"],[4,6,100.94,101.1,"er"],[7,9,101.1,101.24,"en~a939a9e56dc5"],[10,13,101.24,101.46,"god"],[14,17,101.46,101.84,"idé"],[19,22,102.56,102.78,"for~1b22712a94b1"],[23,26,102.78,103.04,"jeg"],[27,29,103.04,103.22,"er"],[30,34,103.22,103.46,"ikke"],[35,37,103.46,103.66,"så~0ccb28b00948"],[38,43,103.66,104.08,"flink"],[44,47,104.08,104.22,"med~bd2bafa1c0bf"],[48,53,104.22,104.76,"biler"]]},{"id":15,"start":108.46,"end":109.61,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,108.52,109.46,"sammendrag"]]},{"id":16,"start":110.98,"end":115.65,"text":"Ingrid og faren ser på mange bruktbiler på finn.no.","zh":"英格丽和爸爸在 finn.no 上看了很多二手车。","words":[[0,6,111.05,111.6,"ingrid"],[7,9,111.6,111.74,"og"],[10,15,111.74,112.4,"faren"],[16,19,112.56,112.86,"ser"],[20,22,112.86,113.08,"på~fab38a6838d6"],[23,28,113.08,113.4,"mange"],[29,39,113.4,114.32,"bruktbiler"],[40,42,114.32,114.5,"på"],[43,50,114.5,115.5,"finn.no"]]},{"id":17,"start":116.78,"end":122.02,"text":"Ingrid vil kjøpe en billig og god bil, og faren prøver å hjelpe henne.","zh":"英格丽想买一辆又便宜又好的车，她爸爸尽力帮她。","words":[[0,6,116.84,117.32,"ingrid"],[7,10,117.32,117.56,"vil"],[11,16,117.56,117.96,"kjøpe"],[17,19,117.96,118.16,"en~a939a9e56dc5"],[20,26,118.16,118.6,"billig~e2a403b2a2e8"],[27,29,118.6,118.74,"og"],[30,33,118.74,119.04,"god"],[34,37,119.04,119.5,"bil"],[39,41,119.88,120.04,"og"],[42,47,120.04,120.6,"faren"],[48,54,120.6,121.12,"prøver~4307f26406c7"],[55,56,121.12,121.22,"å~0583da7a620a"],[57,63,121.22,121.56,"hjelpe"],[64,69,121.56,121.87,"henne"]]},{"id":18,"start":122.97,"end":131.16,"text":"Han finner en fin Mercedes og en ganske ny bil med fine skinnseter, men de er for dyre for henne.","zh":"他找到了一辆不错的奔驰，还有一辆带漂亮真皮座椅、挺新的车，但对她来说都太贵了。","words":[[0,3,123.03,123.4,"han"],[4,10,123.4,123.74,"finner"],[11,13,123.74,123.94,"en~a939a9e56dc5"],[14,17,123.94,124.34,"fin"],[18,26,124.34,125.24,"mercedes"],[27,29,125.64,125.78,"og"],[30,32,125.78,126.0,"en~a939a9e56dc5"],[33,39,126.0,126.52,"ganske"],[40,42,126.52,126.78,"ny"],[43,46,126.78,127.14,"bil"],[47,50,127.14,127.32,"med~c0ee0749b27a"],[51,55,127.32,127.7,"fine"],[56,66,127.7,128.62,"skinnseter"],[68,71,128.98,129.4,"men"],[72,74,129.4,129.64,"de"],[75,77,129.64,129.88,"er"],[78,81,129.88,130.06,"for~79c080957b12"],[82,86,130.06,130.48,"dyre"],[87,90,130.48,130.64,"for~dac524eb595a"],[91,96,130.64,131.0,"henne"]]},{"id":19,"start":132.16,"end":136.58,"text":"Ingrid har lyst på en billig bil, og hun trenger ikke en ny bil.","zh":"英格丽想要一辆便宜的车，她不需要新车。","words":[[0,6,132.22,132.62,"ingrid"],[7,10,132.62,132.78,"har"],[11,15,132.78,133.08,"lyst~b499524f55a4"],[16,18,133.08,133.2,"på~40ad664c0969"],[19,21,133.2,133.4,"en~a939a9e56dc5"],[22,28,133.4,133.86,"billig~e2a403b2a2e8"],[29,32,133.86,134.3,"bil"],[34,36,134.7,134.82,"og"],[37,40,134.82,135.0,"hun"],[41,48,135.0,135.4,"trenger"],[49,53,135.4,135.64,"ikke"],[54,56,135.64,135.82,"en~a939a9e56dc5"],[57,59,135.82,136.1,"ny"],[60,63,136.1,136.43,"bil"]]},{"id":20,"start":137.52,"end":145.49,"text":"Faren er ikke så flink med biler, men Ingrid kjenner en bilmekaniker, og hun vil spørre ham om hjelp.","zh":"她爸爸对汽车不太在行，但英格丽认识一个汽车修理工，她想请他帮忙。","words":[[0,5,137.58,138.1,"faren"],[6,8,138.1,138.32,"er"],[9,13,138.32,138.56,"ikke"],[14,16,138.56,138.78,"så~0ccb28b00948"],[17,22,138.78,139.24,"flink"],[23,26,139.24,139.38,"med~bd2bafa1c0bf"],[27,32,139.38,139.96,"biler"],[34,37,140.54,140.82,"men"],[38,44,140.82,141.32,"ingrid"],[45,52,141.32,141.72,"kjenner"],[53,55,141.72,141.92,"en~a939a9e56dc5"],[56,68,141.92,143.0,"bilmekaniker"],[70,72,143.46,143.58,"og"],[73,76,143.58,143.76,"hun"],[77,80,143.76,143.98,"vil"],[81,87,143.98,144.36,"spørre"],[88,91,144.36,144.7,"ham"],[92,94,144.7,144.86,"om~60c731e0e8be"],[95,100,144.86,145.34,"hjelp"]]},{"id":21,"start":149.68,"end":150.45,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,149.74,150.3,"fakta"]]},{"id":22,"start":152.04,"end":153.38,"text":"Finn.no","subheading":true,"zh":"Finn.no","words":[[0,7,152.1,153.22,"finn.no"]]},{"id":23,"start":155.03,"end":161.72,"text":"Finn.no er en veldig populær nettside for kjøp og salg, og du kan finne nesten alt der.","zh":"Finn.no 是一个非常受欢迎的买卖网站，在上面几乎什么都能找到。","words":[[0,7,155.09,156.18,"finn.no"],[8,10,156.18,156.4,"er"],[11,13,156.4,156.6,"en~a939a9e56dc5"],[14,20,156.6,157.0,"veldig"],[21,28,157.0,157.54,"populær"],[29,37,157.54,158.14,"nettside"],[38,41,158.14,158.4,"for~9df3a7c8813d"],[42,46,158.4,158.74,"kjøp~51c990ba9769"],[47,49,158.74,158.86,"og"],[50,54,158.86,159.42,"salg"],[56,58,159.72,159.84,"og"],[59,61,159.84,159.96,"du"],[62,65,159.96,160.18,"kan"],[66,71,160.18,160.5,"finne"],[72,78,160.5,160.92,"nesten"],[79,82,160.92,161.32,"alt"],[83,86,161.32,161.56,"der"]]},{"id":24,"start":162.5,"end":170.45,"text":"Du kan finne leiligheter, hus og hytter til salgs i hele Norge, og du kan finne boliger til leie.","zh":"你可以找到全挪威在售的公寓、房子和度假小屋，也可以找到出租的住房。","words":[[0,2,162.56,162.8,"du"],[3,6,162.8,163.14,"kan"],[7,12,163.14,163.5,"finne"],[13,24,163.5,164.56,"leiligheter"],[26,29,164.8,165.32,"hus"],[30,32,165.32,165.46,"og"],[33,39,165.46,166.1,"hytter"],[40,43,166.1,166.36,"til~0898551909ac"],[44,49,166.36,166.88,"salgs"],[50,51,166.88,167.08,"i"],[52,56,167.08,167.42,"hele"],[57,62,167.42,167.96,"norge~546b56e35dd5"],[64,66,168.4,168.54,"og"],[67,69,168.54,168.7,"du"],[70,73,168.7,168.92,"kan"],[74,79,168.92,169.22,"finne"],[80,87,169.22,169.72,"boliger"],[88,91,169.72,169.92,"til~abe973e831b7"],[92,96,169.92,170.3,"leie~c7346f915bfb"]]},{"id":25,"start":171.39,"end":174.94,"text":"Du kan kjøpe eller selge bruktbiler og båter.","zh":"你可以买卖二手车和船。","words":[[0,2,171.45,171.62,"du"],[3,6,171.62,171.9,"kan"],[7,12,171.9,172.48,"kjøpe"],[13,18,172.48,172.88,"eller"],[19,24,172.88,173.22,"selge"],[25,35,173.22,174.06,"bruktbiler"],[36,38,174.06,174.28,"og"],[39,44,174.28,174.78,"båter"]]},{"id":26,"start":175.77,"end":182.99,"text":"På «torget» kan du kjøpe og selge brukte møbler, klær og mange forskjellige ting.","zh":"在“市场”栏目，你可以买卖二手家具、衣服和各种各样的东西。","words":[[0,2,175.83,176.16,"på"],[4,10,176.42,177.18,"torget~2c5450b495dc"],[12,15,177.74,177.92,"kan"],[16,18,177.92,178.08,"du"],[19,24,178.08,178.6,"kjøpe"],[25,27,178.6,178.72,"og"],[28,33,178.72,179.08,"selge"],[34,40,179.08,179.62,"brukte~f9a2b7b47a6d"],[41,47,179.62,180.34,"møbler"],[49,53,180.54,181.2,"klær"],[54,56,181.36,181.5,"og"],[57,62,181.5,181.92,"mange"],[63,75,181.92,182.48,"forskjellige"],[76,80,182.48,182.84,"ting"]]},{"id":27,"start":183.88,"end":187.66,"text":"Det er også mange gratis ting under «gis bort».","zh":"在“免费赠送”栏目下还有很多免费的东西。","words":[[0,3,183.94,184.06,"det"],[4,6,184.06,184.18,"er"],[7,11,184.18,184.48,"også"],[12,17,184.48,184.82,"mange"],[18,24,184.82,185.44,"gratis~2d64ec2ad302"],[25,29,185.44,185.82,"ting"],[30,35,185.82,186.34,"under"],[37,40,186.66,187.08,"gis"],[41,45,187.08,187.51,"bort~9fb800b4015d"]]},{"id":28,"start":188.61,"end":192.04,"text":"En side på finn.no viser ledige jobber.","zh":"finn.no 上有一个页面显示空缺职位。","words":[[0,2,188.67,189.08,"en~a939a9e56dc5"],[3,7,189.08,189.44,"side"],[8,10,189.44,189.58,"på"],[11,18,189.58,190.42,"finn.no"],[19,24,190.42,190.96,"viser"],[25,31,190.96,191.4,"ledige"],[32,38,191.4,191.89,"jobber~b0bbda30cf66"]]},{"id":29,"start":192.75,"end":196.1,"text":"Du kan også finne billige reiser på nettsiden.","zh":"你还可以在这个网站上找到便宜的旅行。","words":[[0,2,192.81,193.06,"du"],[3,6,193.06,193.46,"kan"],[7,11,193.46,193.82,"også"],[12,17,193.82,194.14,"finne"],[18,25,194.14,194.54,"billige"],[26,32,194.54,195.22,"reiser~afdd583fe5fa"],[33,35,195.22,195.36,"på"],[36,45,195.36,195.95,"nettsiden"]]}],"lexicon":{"8.1":{"lemma":"