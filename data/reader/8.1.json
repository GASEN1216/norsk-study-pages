{"id":"8.1","title":"Ingrid leter etter bil på finn.no","audio":"audio/8.1.mp3","duration":199.87,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.77,"text":"8.1 Ingrid leter etter bil på finn.no","heading":true,"zh":"8.1 英格丽在 finn.no 上找车","words":[[0,3,0.15,1.19,"8.1"],[4,10,2.17,2.68,"ingrid"],[11,16,2.68,3.16,"leter"],[17,22,3.16,3.46,"etter~b63576d203db"],[23,26,3.46,3.8,"bil"],[27,29,3.8,4.58,"på"],[30,37,4.58,4.96,"finn.no"]]},{"id":1,"start":8.05,"end":17.82,"text":"Ingrid fant en fin leilighet til leie på finn.no for en måned siden, og i forrige uke flyttet hun inn.","zh":"一个月前，英格丽在 finn.no 上找到了一套不错的出租公寓，上周她搬了进去。","words":[[0,6,8.13,8.49,"ingrid"],[7,11,8.49,8.81,"fant"],[12,14,8.81,9.07,"en~a939a9e56dc5"],[15,18,9.07,9.41,"fin"],[19,28,9.41,10.13,"leilighet"],[29,32,10.13,10.39,"til~abe973e831b7"],[33,37,10.39,10.83,"leie~c7346f915bfb"],[38,40,10.83,11.41,"på"],[41,48,11.41,12.37,"finn.no"],[49,52,12.37,12.95,"for~d0291af9704a"],[53,55,12.95,13.09,"en~a939a9e56dc5"],[56,61,13.09,13.47,"måned"],[62,67,13.47,13.83,"siden~9a3d2d89a980"],[69,71,15.03,15.29,"og"],[72,73,15.29,15.47,"i"],[74,81,15.47,15.89,"forrige"],[82,85,15.89,16.33,"uke"],[86,93,16.33,17.19,"flyttet"],[94,97,17.19,17.37,"hun"],[98,101,17.37,17.74,"inn"]]},{"id":2,"start":19.33,"end":24.42,"text":"Nå vil hun kjøpe en bruktbil, for hun har lang vei til jobben.","zh":"现在她想买一辆二手车，因为她上班的路很远。","words":[[0,2,19.41,19.71,"nå~d531d47a7712"],[3,6,19.71,19.89,"vil"],[7,10,19.89,20.05,"hun"],[11,16,20.05,20.57,"kjøpe"],[17,19,20.57,20.73,"en~a939a9e56dc5"],[20,28,20.73,21.35,"bruktbil"],[30,33,22.21,22.41,"for~1b22712a94b1"],[34,37,22.41,22.73,"hun"],[38,41,22.73,22.91,"har"],[42,46,22.91,23.23,"lang"],[47,50,23.23,23.69,"vei"],[51,54,23.69,23.87,"til"],[55,61,23.87,24.34,"jobben"]]},{"id":3,"start":25.6,"end":30.23,"text":"Hun får hjelp av faren, men han kan ikke så mye om biler.","zh":"她爸爸来帮她，但他对汽车懂得不多。","words":[[0,3,25.68,25.9,"hun"],[4,7,25.9,26.12,"får"],[8,13,26.12,26.44,"hjelp"],[14,16,26.44,26.64,"av~c11c5256beb5"],[17,22,26.64,27.0,"faren"],[24,27,27.96,28.18,"men"],[28,31,28.18,28.48,"han"],[32,35,28.48,28.76,"kan~65cb7f5b118b"],[36,40,28.76,29.06,"ikke"],[41,43,29.06,29.28,"så~8a6ad167a88f"],[44,47,29.28,29.48,"mye~cc164d0dc3da"],[48,50,29.48,29.66,"om~52c0bdc828db"],[51,56,29.66,30.15,"biler"]]},{"id":4,"start":31.27,"end":33.6,"text":"De leter på finn.no.","zh":"他们在 finn.no 上找。","words":[[0,2,31.35,31.53,"de"],[3,8,31.53,31.99,"leter"],[9,11,31.99,32.45,"på"],[12,19,32.45,33.52,"finn.no"]]},{"id":5,"start":35.98,"end":41.69,"text":"Vi skal finne en god bil til deg. Der er en fin Mercedes!","speaker":"Far","zh":"我们会给你找一辆好车的。那儿有一辆不错的奔驰！","words":[[0,2,36.06,36.35,"vi"],[3,7,36.35,36.69,"skal"],[8,13,36.69,37.19,"finne"],[14,16,37.19,37.35,"en~a939a9e56dc5"],[17,20,37.35,37.59,"god"],[21,24,37.59,37.85,"bil"],[25,28,37.85,38.07,"til"],[29,32,38.07,38.25,"deg"],[34,37,39.56,40.0,"der"],[38,40,40.0,40.28,"er"],[41,43,40.28,40.46,"en~a939a9e56dc5"],[44,47,40.46,40.72,"fin"],[48,56,40.72,41.61,"mercedes"]]},{"id":6,"start":42.5,"end":43.95,"text":"Den er i god stand.","zh":"车况很好。","words":[[0,3,42.58,42.8,"den"],[4,6,42.8,43.04,"er"],[7,8,43.04,43.18,"i~4d590f1b6b8d"],[9,12,43.18,43.4,"god"],[13,18,43.4,43.87,"stand"]]},{"id":7,"start":45.02,"end":53.9,"text":"Den er så dyr. Jeg vil ikke kjøpe en dyr bil, og den må ikke være for stor, for jeg har ikke plass i garasjen.","speaker":"Ingrid","zh":"它好贵啊。我不想买贵的车，而且车不能太大，因为我的车库放不下。","words":[[0,3,45.1,45.25,"den"],[4,6,45.25,45.43,"er"],[7,9,45.43,45.59,"så~3871b614434d"],[10,13,45.59,45.95,"dyr~3cc3fe1c49bb"],[15,18,46.85,47.15,"jeg"],[19,22,47.15,47.33,"vil"],[23,27,47.33,47.53,"ikke"],[28,33,47.53,47.97,"kjøpe"],[34,36,47.97,48.11,"en~a939a9e56dc5"],[37,40,48.11,48.37,"dyr~3cc3fe1c49bb"],[41,44,48.37,48.69,"bil"],[46,48,49.45,49.69,"og"],[49,52,49.69,49.87,"den"],[53,55,49.87,50.09,"må~b97ba6405a2a"],[56,60,50.09,50.27,"ikke"],[61,65,50.27,50.53,"være"],[66,69,50.53,50.77,"for~79c080957b12"],[70,74,50.77,51.09,"stor"],[76,79,52.03,52.11,"for~1b22712a94b1"],[80,83,52.11,52.23,"jeg"],[84,87,52.23,52.43,"har"],[88,92,52.43,52.59,"ikke"],[93,98,52.59,52.93,"plass"],[99,100,52.93,53.11,"i"],[101,109,53.11,53.82,"garasjen"]]},{"id":8,"start":54.73,"end":60.79,"text":"Se her! Denne bilen er ganske ny, og den har fine seter i skinn.","speaker":"Far","zh":"看这儿！这辆车挺新的，还有漂亮的真皮座椅。","words":[[0,2,54.81,55.07,"se~26e2daf31e48"],[3,6,55.07,55.41,"her"],[8,13,56.17,56.59,"denne"],[14,19,56.59,56.97,"bilen"],[20,22,56.97,57.15,"er"],[23,29,57.15,57.65,"ganske"],[30,32,57.65,57.95,"ny"],[34,36,58.61,58.73,"og"],[37,40,58.73,58.91,"den"],[41,44,58.91,59.09,"har"],[45,49,59.09,59.47,"fine"],[50,55,59.47,60.01,"seter"],[56,57,60.01,60.23,"i~7bc2ee1f0e19"],[58,63,60.23,60.71,"skinn"]]},{"id":9,"start":60.9,"end":70.93,"text":"Jeg trenger ikke fine seter, og jeg trenger ikke en ny bil. Denne bilen er også for dyr, og jeg har lyst på en rød bil.","speaker":"Ingrid","zh":"我不需要漂亮的座椅，也不需要新车。这辆车也太贵了，而且我想要一辆红色的车。","words":[[0,3,61.25,61.77,"jeg"],[4,11,61.77,62.25,"trenger"],[12,16,62.25,62.41,"ikke"],[17,21,62.41,62.83,"fine"],[22,27,62.83,63.43,"seter"],[29,31,63.81,64.19,"og"],[32,35,64.19,64.29,"jeg"],[36,43,64.29,64.77,"trenger"],[44,48,64.77,64.97,"ikke"],[49,51,64.97,65.15,"en~a939a9e56dc5"],[52,54,65.15,65.35,"ny"],[55,58,65.35,65.59,"bil"],[60,65,66.56,66.92,"denne"],[66,71,66.92,67.26,"bilen"],[72,74,67.26,67.36,"er"],[75,79,67.36,67.78,"også"],[80,83,67.78,68.0,"for~79c080957b12"],[84,87,68.0,68.26,"dyr~3cc3fe1c49bb"],[89,91,69.25,69.39,"og"],[92,95,69.39,69.51,"jeg"],[96,99,69.51,69.63,"har"],[100,104,69.63,69.81,"lyst~b499524f55a4"],[105,107,69.81,69.95,"på~40ad664c0969"],[108,110,69.95,70.05,"en~a939a9e56dc5"],[111,114,70.05,70.37,"rød"],[115,118,70.37,70.85,"bil"]]},{"id":10,"start":71.75,"end":81.34,"text":"Er fargen så viktig, da? Du kan kjøpe en billig bil, men billige og gamle biler trenger ofte reparasjoner, vet du.","speaker":"Far","zh":"颜色有那么重要吗？你可以买辆便宜的车，可是你知道，又便宜又旧的车常常需要修理。","words":[[0,2,71.83,72.17,"er"],[3,9,72.17,72.73,"fargen"],[10,12,72.73,72.95,"så~d9d17638efa6"],[13,19,72.95,73.29,"viktig"],[21,23,73.35,73.49,"da~caaa1f71fadf"],[25,27,74.64,74.9,"du"],[28,31,74.9,75.04,"kan"],[32,37,75.04,75.44,"kjøpe"],[38,40,75.44,75.58,"en~a939a9e56dc5"],[41,47,75.58,75.94,"billig~e2a403b2a2e8"],[48,51,75.94,76.2,"bil"],[53,56,76.82,77.46,"men"],[57,64,77.46,77.92,"billige"],[65,67,77.92,78.06,"og"],[68,73,78.06,78.36,"gamle"],[74,79,78.36,78.76,"biler"],[80,87,79.3,79.68,"trenger"],[88,92,79.68,80.0,"ofte"],[93,105,80.0,80.8,"reparasjoner"],[107,110,80.86,81.0,"vet"],[111,113,81.0,81.27,"du"]]},{"id":11,"start":81.44,"end":85.29,"text":"Ja, det kan ikke du hjelpe meg med!","speaker":"Ingrid","zh":"是啊，这个你可帮不了我！","words":[[0,2,81.9,82.54,"ja"],[4,7,83.02,83.4,"det"],[8,11,83.4,83.9,"kan"],[12,16,83.9,84.12,"ikke"],[17,19,84.12,84.4,"du"],[20,26,84.4,84.7,"hjelpe"],[27,30,84.7,84.86,"meg"],[31,34,84.86,85.21,"med~41eec44f57d5"]]},{"id":12,"start":86.27,"end":89.26,"text":"Nei, jeg er ingen bilmekaniker.","speaker":"Far","zh":"是啊，我又不是汽车修理工。","words":[[0,3,86.35,86.63,"nei"],[5,8,87.25,87.51,"jeg"],[9,11,87.51,87.69,"er"],[12,17,87.69,87.99,"ingen~47148835f7bd"],[18,30,87.99,89.18,"bilmekaniker"]]},{"id":13,"start":90.29,"end":99.44,"text":"Vi finner ingen bil i dag, pappa, men jeg kjenner faktisk en bilmekaniker. Han kan kanskje hjelpe meg med å finne en god bruktbil.","speaker":"Ingrid","zh":"爸爸，我们今天是找不到车了，不过我其实认识一个汽车修理工。他也许能帮我找到一辆好的二手车。","words":[[0,2,90.37,90.52,"vi"],[3,9,90.52,90.92,"finner"],[10,15,90.92,91.16,"ingen~47148835f7bd"],[16,19,91.16,91.52,"bil"],[20,21,91.52,91.7,"i~de136e71704d"],[22,25,91.7,91.9,"dag"],[27,32,91.96,92.28,"pappa"],[34,37,93.0,93.3,"men"],[38,41,93.3,93.72,"jeg"],[42,49,93.72,94.16,"kjenner"],[50,57,94.16,94.62,"faktisk"],[58,60,94.62,94.8,"en~a939a9e56dc5"],[61,73,94.8,95.52,"bilmekaniker"],[75,78,96.22,96.64,"han"],[79,82,96.64,96.78,"kan"],[83,90,96.78,97.2,"kanskje"],[91,97,97.2,97.56,"hjelpe"],[98,101,97.56,97.78,"meg"],[102,105,97.78,98.02,"med~41eec44f57d5"],[106,107,98.02,98.14,"å~0583da7a620a"],[108,113,98.14,98.42,"finne"],[114,116,98.42,98.54,"en~a939a9e56dc5"],[117,120,98.54,98.74,"god"],[121,129,98.74,99.36,"bruktbil"]]},{"id":14,"start":100.52,"end":104.81,"text":"Det er en god idé, for jeg er ikke så flink med biler.","speaker":"Far","zh":"这是个好主意，因为我对汽车不太在行。","words":[[0,3,100.6,100.76,"det"],[4,6,100.76,101.02,"er"],[7,9,101.02,101.18,"en~a939a9e56dc5"],[10,13,101.18,101.38,"god"],[14,17,101.38,101.6,"idé"],[19,22,102.01,102.69,"for~1b22712a94b1"],[23,26,102.69,102.93,"jeg"],[27,29,102.93,103.17,"er"],[30,34,103.17,103.37,"ikke"],[35,37,103.37,103.59,"så~0ccb28b00948"],[38,43,103.59,103.95,"flink"],[44,47,103.95,104.17,"med~bd2bafa1c0bf"],[48,53,104.17,104.73,"biler"]]},{"id":15,"start":108.43,"end":109.56,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,108.51,109.48,"sammendrag"]]},{"id":16,"start":110.95,"end":115.59,"text":"Ingrid og faren ser på mange bruktbiler på finn.no.","zh":"英格丽和爸爸在 finn.no 上看了很多二手车。","words":[[0,6,111.03,111.34,"ingrid"],[7,9,111.34,111.68,"og"],[10,15,111.68,112.16,"faren"],[16,19,112.16,112.74,"ser"],[20,22,112.74,112.96,"på~fab38a6838d6"],[23,28,112.96,113.28,"mange"],[29,39,113.28,114.0,"bruktbiler"],[40,42,114.0,114.42,"på"],[43,50,114.42,115.51,"finn.no"]]},{"id":17,"start":116.42,"end":121.96,"text":"Ingrid vil kjøpe en billig og god bil, og faren prøver å hjelpe henne.","zh":"英格丽想买一辆又便宜又好的车，她爸爸尽力帮她。","words":[[0,6,116.5,117.15,"ingrid"],[7,10,117.15,117.45,"vil"],[11,16,117.45,117.87,"kjøpe"],[17,19,117.87,118.07,"en~a939a9e56dc5"],[20,26,118.07,118.51,"billig~e2a403b2a2e8"],[27,29,118.51,118.69,"og"],[30,33,118.69,118.97,"god"],[34,37,118.97,119.23,"bil"],[39,41,119.73,119.99,"og"],[42,47,119.99,120.41,"faren"],[48,54,120.41,120.95,"prøver~4307f26406c7"],[55,56,120.95,121.17,"å~0583da7a620a"],[57,63,121.17,121.53,"hjelpe"],[64,69,121.53,121.88,"henne"]]},{"id":18,"start":122.93,"end":131.09,"text":"Han finner en fin Mercedes og en ganske ny bil med fine skinnseter, men de er for dyre for henne.","zh":"他找到了一辆不错的奔驰，还有一辆带漂亮真皮座椅、挺新的车，但对她来说都太贵了。","words":[[0,3,123.01,123.27,"han"],[4,10,123.27,123.65,"finner"],[11,13,123.65,123.83,"en~a939a9e56dc5"],[14,17,123.83,124.19,"fin"],[18,26,124.19,124.59,"mercedes"],[27,29,124.59,125.73,"og"],[30,32,125.73,125.91,"en~a939a9e56dc5"],[33,39,125.91,126.43,"ganske"],[40,42,126.43,126.67,"ny"],[43,46,126.67,126.99,"bil"],[47,50,126.99,127.23,"med~c0ee0749b27a"],[51,55,127.23,127.57,"fine"],[56,66,127.57,128.27,"skinnseter"],[68,71,128.91,129.17,"men"],[72,74,129.17,129.55,"de"],[75,77,129.55,129.79,"er"],[78,81,129.79,129.99,"for~79c080957b12"],[82,86,129.99,130.39,"dyre"],[87,90,130.39,130.59,"for~dac524eb595a"],[91,96,130.59,131.02,"henne"]]},{"id":19,"start":132.12,"end":136.52,"text":"Ingrid har lyst på en billig bil, og hun trenger ikke en ny bil.","zh":"英格丽想要一辆便宜的车，她不需要新车。","words":[[0,6,132.2,132.48,"ingrid"],[7,10,132.48,132.7,"har"],[11,15,132.7,132.98,"lyst~b499524f55a4"],[16,18,132.98,133.16,"på~40ad664c0969"],[19,21,133.16,133.3,"en~a939a9e56dc5"],[22,28,133.3,133.76,"billig~e2a403b2a2e8"],[29,32,133.76,134.04,"bil"],[34,36,134.64,134.78,"og"],[37,40,134.78,134.92,"hun"],[41,48,134.92,135.34,"trenger"],[49,53,135.34,135.56,"ikke"],[54,56,135.56,135.78,"en~a939a9e56dc5"],[57,59,135.78,135.98,"ny"],[60,63,135.98,136.44,"bil"]]},{"id":20,"start":137.48,"end":145.45,"text":"Faren er ikke så flink med biler, men Ingrid kjenner en bilmekaniker, og hun vil spørre ham om hjelp.","zh":"她爸爸对汽车不太在行，但英格丽认识一个汽车修理工，她想请他帮忙。","words":[[0,5,137.56,137.95,"faren"],[6,8,137.95,138.27,"er"],[9,13,138.27,138.47,"ikke"],[14,16,138.47,138.65,"så~0ccb28b00948"],[17,22,138.65,139.09,"flink"],[23,26,139.09,139.31,"med~bd2bafa1c0bf"],[27,32,139.31,139.71,"biler"],[34,37,140.14,140.7,"men"],[38,44,140.7,141.12,"ingrid"],[45,52,141.12,141.6,"kjenner"],[53,55,141.6,141.84,"en~a939a9e56dc5"],[56,68,141.84,142.7,"bilmekaniker"],[70,72,143.4,143.54,"og"],[73,76,143.54,143.7,"hun"],[77,80,143.7,143.88,"vil"],[81,87,143.88,144.3,"spørre"],[88,91,144.3,144.58,"ham"],[92,94,144.58,144.82,"om~60c731e0e8be"],[95,100,144.82,145.37,"hjelp"]]},{"id":21,"start":149.66,"end":150.36,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,149.74,150.28,"fakta"]]},{"id":22,"start":151.89,"end":153.32,"text":"Finn.no","subheading":true,"zh":"Finn.no","words":[[0,7,151.97,153.24,"finn.no"]]},{"id":23,"start":154.97,"end":161.66,"text":"Finn.no er en veldig populær nettside for kjøp og salg, og du kan finne nesten alt der.","zh":"Finn.no 是一个非常受欢迎的买卖网站，在上面几乎什么都能找到。","words":[[0,7,155.05,155.99,"finn.no"],[8,10,155.99,156.31,"er"],[11,13,156.31,156.51,"en~a939a9e56dc5"],[14,20,156.51,156.91,"veldig"],[21,28,156.91,157.45,"populær"],[29,37,157.45,157.99,"nettside"],[38,41,157.99,158.25,"for~9df3a7c8813d"],[42,46,158.25,158.73,"kjøp~51c990ba9769"],[47,49,158.73,158.81,"og"],[50,54,158.81,159.23,"salg"],[56,58,159.71,159.81,"og"],[59,61,159.81,159.93,"du"],[62,65,159.93,160.09,"kan"],[66,71,160.09,160.43,"finne"],[72,78,160.43,160.79,"nesten"],[79,82,160.79,161.13,"alt"],[83,86,161.13,161.58,"der"]]},{"id":24,"start":162.46,"end":170.4,"text":"Du kan finne leiligheter, hus og hytter til salgs i hele Norge, og du kan finne boliger til leie.","zh":"你可以找到全挪威在售的公寓、房子和度假小屋，也可以找到出租的住房。","words":[[0,2,162.54,162.7,"du"],[3,6,162.7,162.98,"kan"],[7,12,162.98,163.4,"finne"],[13,24,163.4,164.3,"leiligheter"],[26,29,164.8,165.1,"hus"],[30,32,165.1,165.4,"og"],[33,39,165.4,165.94,"hytter"],[40,43,165.94,166.24,"til~0898551909ac"],[44,49,166.24,166.76,"salgs"],[50,51,166.76,166.98,"i"],[52,56,166.98,167.32,"hele"],[57,62,167.32,167.72,"norge~546b56e35dd5"],[64,66,168.28,168.48,"og"],[67,69,168.48,168.64,"du"],[70,73,168.64,168.82,"kan"],[74,79,168.82,169.14,"finne"],[80,87,169.14,169.64,"boliger"],[88,91,169.64,169.84,"til~abe973e831b7"],[92,96,169.84,170.32,"leie~c7346f915bfb"]]},{"id":25,"start":171.37,"end":174.87,"text":"Du kan kjøpe eller selge bruktbiler og båter.","zh":"你可以买卖二手车和船。","words":[[0,2,171.45,171.56,"du"],[3,6,171.56,171.74,"kan"],[7,12,171.74,172.34,"kjøpe"],[13,18,172.34,172.72,"eller"],[19,24,172.72,173.12,"selge"],[25,35,173.12,173.74,"bruktbiler"],[36,38,173.74,174.2,"og"],[39,44,174.2,174.79,"båter"]]},{"id":26,"start":176.31,"end":182.92,"text":"På «torget» kan du kjøpe og selge brukte møbler, klær og mange forskjellige ting.","zh":"在“市场”栏目，你可以买卖二手家具、衣服和各种各样的东西。","words":[[0,2,176.39,176.39,"på"],[4,10,176.39,177.0,"torget~2c5450b495dc"],[12,15,177.68,177.88,"kan"],[16,18,177.88,178.02,"du"],[19,24,178.02,178.52,"kjøpe"],[25,27,178.52,178.68,"og"],[28,33,178.68,179.08,"selge"],[34,40,179.08,179.56,"brukte~f9a2b7b47a6d"],[41,47,179.56,180.1,"møbler"],[49,53,180.56,180.92,"klær"],[54,56,180.92,181.42,"og"],[57,62,181.42,181.78,"mange"],[63,75,181.78,182.4,"forskjellige"],[76,80,182.4,182.84,"ting"]]},{"id":27,"start":183.86,"end":187.6,"text":"Det er også mange gratis ting under «gis bort».","zh":"在“免费赠送”栏目下还有很多免费的东西。","words":[[0,3,183.94,184.04,"det"],[4,6,184.04,184.12,"er"],[7,11,184.12,184.38,"også"],[12,17,184.38,184.6,"mange"],[18,24,184.6,185.4,"gratis~2d64ec2ad302"],[25,29,185.4,185.66,"ting"],[30,35,185.66,186.16,"under"],[37,40,186.16,186.98,"gis"],[41,45,186.98,187.52,"bort~9fb800b4015d"]]},{"id":28,"start":188.58,"end":191.98,"text":"En side på finn.no viser ledige jobber.","zh":"finn.no 上有一个页面显示空缺职位。","words":[[0,2,188.66,188.95,"en~a939a9e56dc5"],[3,7,188.95,189.25,"side"],[8,10,189.25,189.51,"på"],[11,18,189.51,190.33,"finn.no"],[19,24,190.33,190.85,"viser"],[25,31,190.85,191.31,"ledige"],[32,38,191.31,191.9,"jobber~b0bbda30cf66"]]},{"id":29,"start":192.73,"end":196.02,"text":"Du kan også finne billige reiser på nettsiden.","zh":"你还可以在这个网站上找到便宜的旅行。","words":[[0,2,192.81,192.99,"du"],[3,6,192.99,193.27,"kan"],[7,11,193.27,193.69,"også"],[12,17,193.69,194.09,"finne"],[18,25,194.09,194.47,"billige"],[26,32,194.47,195.05,"reiser~afdd583fe5fa"],[33,35,195.05,195