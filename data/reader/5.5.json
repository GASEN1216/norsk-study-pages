{"id":"5.5","title":"Yrkestekst: Jeg er barnehageassistent","audio":"audio/5.5.mp3","duration":166.88,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":6.48,"text":"5.5 Yrke: Jeg er barnehageassistent","heading":true,"zh":"5.5 职业：我是幼儿园助理","words":[[0,3,0.15,1.14,"5.5"],[4,8,2.1,2.68,"yrke"],[10,13,3.42,4.26,"jeg"],[14,16,4.26,4.76,"er"],[17,35,4.76,6.4,"barnehageassistent"]]},{"id":1,"start":9.4,"end":11.62,"text":"Jeg er barnehageassistent,","zh":"我是幼儿园助理，","words":[[0,3,9.46,9.86,"jeg"],[4,6,9.86,10.12,"er"],[7,25,10.12,11.47,"barnehageassistent"]]},{"id":2,"start":12.79,"end":16.29,"text":"og jeg jobber i en stor barnehage med mange barn.","zh":"我在一家有很多孩子的大幼儿园工作。","words":[[0,2,12.85,13.04,"og"],[3,6,13.04,13.38,"jeg"],[7,13,13.38,13.72,"jobber~003ddb6d77e6"],[14,15,13.72,13.82,"i"],[16,18,13.82,14.04,"en~a939a9e56dc5"],[19,23,14.04,14.42,"stor"],[24,33,14.42,15.16,"barnehage"],[34,37,15.16,15.48,"med~048e87586d09"],[38,43,15.48,15.8,"mange"],[44,48,15.8,16.14,"barn"]]},{"id":3,"start":18.41,"end":22.28,"text":"Barna er i barnehagen, for foreldrene er på jobb.","zh":"孩子们在幼儿园，因为父母在上班。","words":[[0,5,18.46,19.06,"barna"],[6,8,19.06,19.36,"er"],[9,10,19.36,19.56,"i"],[11,21,19.56,20.39,"barnehagen"],[23,26,20.54,20.8,"for~a05c87659379"],[27,37,20.8,21.46,"foreldrene"],[38,40,21.46,21.66,"er"],[41,43,21.66,21.82,"på"],[44,48,21.82,22.13,"jobb"]]},{"id":4,"start":24.27,"end":30.45,"text":"Jeg har mange kollegaer, både barnehagelærere og andre assistenter.","zh":"我有很多同事，既有幼儿园老师，也有其他助理。","words":[[0,3,24.32,24.54,"jeg"],[4,7,24.54,24.8,"har"],[8,13,24.8,25.24,"mange"],[14,23,25.24,26.07,"kollegaer"],[25,29,27.32,27.62,"både"],[30,45,27.62,28.94,"barnehagelærere"],[46,48,28.94,29.1,"og"],[49,54,29.1,29.52,"andre~0c69ef1e750c"],[55,66,29.52,30.3,"assistenter"]]},{"id":5,"start":32.08,"end":34.26,"text":"Vi har mange oppgaver hver dag.","zh":"我们每天有很多任务。","words":[[0,2,32.14,32.3,"vi"],[3,6,32.3,32.56,"har"],[7,12,32.56,32.96,"mange"],[13,21,32.96,33.48,"oppgaver"],[22,26,33.48,33.72,"hver"],[27,30,33.72,34.11,"dag"]]},{"id":6,"start":36.31,"end":44.71,"text":"Barna lærer mye hver dag, og vi synger, leker, tegner og gjør aktiviteter sammen med dem.","zh":"孩子们每天学到很多东西，我们和他们一起唱歌、玩耍、画画、做活动。","words":[[0,5,36.38,36.88,"barna"],[6,11,36.88,37.44,"lærer~0769c7af9c2d"],[12,15,37.44,37.78,"mye~cc164d0dc3da"],[16,20,37.78,38.04,"hver"],[21,24,38.04,38.52,"dag"],[26,28,38.9,39.02,"og"],[29,31,39.02,39.22,"vi"],[32,38,39.22,39.81,"synger"],[40,45,40.58,41.35,"leker"],[47,53,41.6,42.54,"tegner"],[54,56,42.54,42.68,"og"],[57,61,42.68,42.96,"gjør"],[62,73,42.96,43.86,"aktiviteter"],[74,80,43.86,44.16,"sammen"],[81,84,44.16,44.3,"med"],[85,88,44.3,44.56,"dem"]]},{"id":7,"start":45.7,"end":51.62,"text":"Vi må også kle på dem, skifte bleier og hjelpe dem med praktiske ting.","zh":"我们还得给他们穿衣服、换尿布，帮他们处理一些生活上的事。","words":[[0,2,45.76,46.06,"vi"],[3,5,46.06,46.36,"må"],[6,10,46.36,46.7,"også"],[11,14,46.7,47.04,"kle~804be8db9f13"],[15,17,47.04,47.2,"på~234ce18a2110"],[18,21,47.2,47.59,"dem"],[23,29,48.0,48.42,"skifte"],[30,36,48.42,49.21,"bleier"],[37,39,49.64,49.76,"og"],[40,46,49.76,50.18,"hjelpe"],[47,50,50.18,50.42,"dem"],[51,54,50.42,50.56,"med~41eec44f57d5"],[55,64,50.56,51.16,"praktiske"],[65,69,51.16,51.47,"ting"]]},{"id":8,"start":52.41,"end":56.51,"text":"Det er morsomt å jobbe med barn, og jeg trives godt.","zh":"和孩子们一起工作很有趣，我在这里过得很开心。","words":[[0,3,52.48,52.62,"det"],[4,6,52.62,52.78,"er"],[7,14,52.78,53.5,"morsomt"],[15,16,53.5,53.6,"å~0583da7a620a"],[17,22,53.6,53.9,"jobbe"],[23,26,53.9,54.04,"med"],[27,31,54.04,54.53,"barn"],[33,35,54.94,55.06,"og"],[36,39,55.06,55.32,"jeg"],[40,46,55.32,55.86,"trives"],[47,51,55.86,56.36,"godt~70e6d941005d"]]},{"id":9,"start":59.22,"end":61.0,"text":"Vinter i barnehagen.","zh":"幼儿园的冬天","words":[[0,6,59.28,60.04,"vinter"],[7,8,60.04,60.14,"i"],[9,19,60.14,60.85,"barnehagen"]]},{"id":10,"start":62.67,"end":66.94,"text":"Det er kaldt og mye snø ute. Kan vi være inne?","speaker":"Leyla","zh":"外面又冷，雪又多。我们可以待在室内吗？","words":[[0,3,62.73,62.86,"det"],[4,6,62.86,63.0,"er"],[7,12,63.0,63.74,"kaldt"],[13,15,63.74,63.84,"og"],[16,19,63.84,64.18,"mye~cc164d0dc3da"],[20,23,64.18,64.6,"snø~c3b53aee92b5"],[24,27,64.6,65.1,"ute"],[29,32,65.82,66.0,"kan"],[33,35,66.0,66.14,"vi"],[36,40,66.14,66.38,"være"],[41,45,66.38,66.78,"inne"]]},{"id":11,"start":68.17,"end":71.64,"text":"Nei, men vi må ta på mye klær.","speaker":"Kollega","zh":"不行，不过我们得多穿点衣服。","words":[[0,3,68.23,68.84,"nei"],[5,8,69.3,69.56,"men"],[9,11,69.56,69.68,"vi"],[12,14,69.68,69.88,"må"],[15,17,69.88,70.28,"ta~3aec2189c96e"],[18,20,70.28,70.6,"på~3c2ce0bc4e52"],[21,24,70.72,71.08,"mye~cc164d0dc3da"],[25,29,71.08,71.48,"klær"]]},{"id":12,"start":72.89,"end":75.18,"text":"Jeg skjønner. Det kan vi gjøre.","speaker":"Leyla","zh":"我明白了。这个我们可以做到。","words":[[0,3,72.95,73.18,"jeg"],[4,12,73.18,73.74,"skjønner"],[14,17,74.18,74.44,"det"],[18,21,74.44,74.6,"kan"],[22,24,74.6,74.7,"vi"],[25,30,74.7,75.03,"gjøre"]]},{"id":13,"start":77.95,"end":79.85,"text":"Pappa henter Markus.","zh":"爸爸来接马库斯","words":[[0,5,78.02,78.58,"pappa"],[6,12,78.58,79.12,"henter"],[13,19,79.12,79.7,"markus"]]},{"id":14,"start":81.56,"end":84.43,"text":"Hei, er du pappaen til Markus?","speaker":"Leyla","zh":"你好，你是马库斯的爸爸吗？","words":[[0,3,81.62,82.08,"hei"],[5,7,82.42,82.62,"er"],[8,10,82.62,82.88,"du"],[11,18,82.88,83.4,"pappaen"],[19,22,83.4,83.66,"til~8de1a9181f86"],[23,29,83.66,84.28,"markus"]]},{"id":15,"start":85.21,"end":87.64,"text":"Ja, jeg heter Bjørnar.","speaker":"Bjørnar","zh":"是的，我叫比约纳尔。","words":[[0,2,85.27,85.68,"ja"],[4,7,86.14,86.4,"jeg"],[8,13,86.4,86.86,"heter"],[14,21,86.86,87.49,"bjørnar"]]},{"id":16,"start":88.73,"end":92.26,"text":"Jeg heter Leyla og er ny assistent her i barnehagen.","speaker":"Leyla","zh":"我叫莱拉，是这家幼儿园新来的助理。","words":[[0,3,88.79,88.98,"jeg"],[4,9,88.98,89.28,"heter"],[10,15,89.28,89.84,"leyla"],[16,18,89.84,90.1,"og"],[19,21,90.1,90.26,"er"],[22,24,90.26,90.5,"ny"],[25,34,90.5,91.12,"assistent"],[35,38,91.12,91.34,"her"],[39,40,91.34,91.42,"i"],[41,51,91.42,92.11,"barnehagen"]]},{"id":17,"start":93.03,"end":94.63,"text":"Hyggelig å hilse på deg.","speaker":"Bjørnar","zh":"很高兴认识你。","words":[[0,8,93.09,93.54,"hyggelig"],[9,10,93.54,93.64,"å~0583da7a620a"],[11,16,93.64,94.08,"hilse"],[17,19,94.08,94.22,"på~588ffe6c89d8"],[20,23,94.22,94.48,"deg"]]},{"id":18,"start":95.63,"end":100.08,"text":"Takk i like måte. Skal du hente Markus?","speaker":"Leyla","zh":"谢谢，我也很高兴认识你。你是来接马库斯的吗？","words":[[0,4,95.69,96.02,"takk"],[5,6,96.02,96.1,"i~d931e4e5d506"],[7,11,96.1,96.4,"like~96c08a97a401"],[12,16,96.4,96.9,"måte~e6eb4b458deb"],[18,22,98.42,98.74,"skal"],[23,25,98.74,99.04,"du"],[26,31,99.04,99.36,"hente"],[32,38,99.36,99.93,"markus"]]},{"id":19,"start":100.9,"end":103.93,"text":"Ja. Han skal til tannlegen.","speaker":"Bjørnar","zh":"对。他要去看牙医。","words":[[0,2,100.96,101.36,"ja"],[4,7,102.06,102.32,"han"],[8,12,102.32,102.64,"skal~e65efaba04da"],[13,16,102.64,102.9,"til"],[17,26,102.9,103.78,"tannlegen"]]},{"id":20,"start":105.56,"end":107.2,"text":"Takk for i dag, Markus.","speaker":"Leyla","zh":"今天谢谢你啦，马库斯。","words":[[0,4,105.62,105.9,"takk"],[5,8,105.9,106.06,"for~0132b57a028e"],[9,10,106.06,106.16,"i~de136e71704d"],[11,14,106.16,106.44,"dag"],[16,22,106.44,107.05,"markus"]]},{"id":21,"start":109.89,"end":112.2,"text":"Personalmøte i barnehagen.","zh":"幼儿园的员工会议。","words":[[0,12,109.95,111.16,"personalmøte"],[13,14,111.16,111.3,"i"],[15,25,111.3,112.05,"barnehagen"]]},{"id":22,"start":114.2,"end":117.41,"text":"Nå er planen for neste måned klar.","speaker":"Kollega","zh":"下个月的计划现在定好了。","words":[[0,2,114.26,114.66,"nå~d531d47a7712"],[3,5,114.66,114.86,"er"],[6,12,114.86,115.6,"planen"],[13,16,115.6,115.8,"for~7dc1abfddf44"],[17,22,115.8,116.26,"neste~67b7b5e351a0"],[23,28,116.26,116.86,"måned"],[29,33,116.86,117.26,"klar"]]},{"id":23,"start":118.82,"end":120.77,"text":"Hva er tema denne gangen?","speaker":"Leyla","zh":"这次的主题是什么？","words":[[0,3,118.88,119.2,"hva"],[4,6,119.2,119.46,"er"],[7,11,119.46,119.92,"tema"],[12,17,119.92,120.18,"denne"],[18,24,120.18,120.62,"gangen"]]},{"id":24,"start":121.81,"end":127.96,"text":"Temaet er høst, og barna skal lære om norsk natur om høsten.","speaker":"Kollega","zh":"主题是秋天，孩子们要了解挪威秋天的大自然。","words":[[0,6,121.87,122.54,"temaet"],[7,9,122.54,122.96,"er"],[10,14,122.96,123.56,"høst"],[16,18,124.02,124.16,"og"],[19,24,124.16,124.8,"barna"],[25,29,124.8,125.04,"skal"],[30,34,125.04,125.46,"lære"],[35,37,125.46,125.8,"om~52c0bdc828db"],[38,43,125.8,126.26,"norsk~300c0d0c4f59"],[44,49,126.26,126.96,"natur"],[50,52,127.12,127.3,"om~2fdd1539ca38"],[53,59,127.3,127.81,"høsten"]]},{"id":25,"start":129.06,"end":131.31,"text":"Skal vi være ute hver dag?","speaker":"Leyla","zh":"我们每天都要待在户外吗？","words":[[0,4,129.12,129.44,"skal"],[5,7,129.44,129.58,"vi"],[8,12,129.58,129.9,"være"],[13,16,129.9,130.42,"ute"],[17,21,130.42,130.7,"hver"],[22,25,130.7,131.16,"dag"]]},{"id":26,"start":132.2,"end":136.63,"text":"I barnehagen er vi ute hver dag hele året.","speaker":"Kollega","zh":"在幼儿园，我们一年到头每天都在户外。","words":[[0,1,132.26,132.44,"i"],[2,12,132.44,133.34,"barnehagen"],[13,15,133.52,133.82,"er"],[16,18,133.82,134.02,"vi"],[19,22,134.02,134.6,"ute"],[23,27,134.6,134.98,"hver"],[28,31,134.98,135.5,"dag"],[32,36,135.6,136.14,"hele"],[37,41,136.14,136.48,"året"]]},{"id":27,"start":138.19,"end":140.09,"text":"Jeg må kjøpe varme klær.","speaker":"Leyla","zh":"我得买些保暖的衣服。","words":[[0,3,138.25,138.54,"jeg"],[4,6,138.54,138.7,"må"],[7,12,138.7,139.12,"kjøpe"],[13,18,139.12,139.5,"varme"],[19,23,139.5,139.94,"klær"]]},{"id":28,"start":141.12,"end":149.72,"text":"Ja, nordmenn pleier å si: Det finnes ikke dårlig vær, bare dårlige klær.","speaker":"Kollega","zh":"是啊，挪威人常说：没有坏天气，只有不合适的衣服。","words":[[0,2,141.19,141.59,"ja"],[4,12,142.34,143.14,"nordmenn"],[13,19,143.14,143.52,"pleier"],[20,21,143.52,143.64,"å~0583da7a620a"],[22,24,143.64,143.98,"si~c139ffdb1a59"],[26,29,144.7,144.94,"det"],[30,36,144.94,145.66,"finnes"],[37,41,145.66,146.06,"ikke"