{"id":"5.5","title":"Yrkestekst: Jeg er barnehageassistent","audio":"audio/5.5.mp3","duration":166.88,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":6.48,"text":"5.5 Yrke: Jeg er barnehageassistent","heading":true,"zh":"5.5 职业：我是幼儿园助理","words":[[0,3,0.15,1.14,"5.5"],[4,8,2.1,2.68,"yrke"],[10,13,3.42,4.26,"jeg"],[14,16,4.26,4.76,"er"],[17,35,4.76,6.4,"barnehageassistent"]]},{"id":1,"start":6.62,"end":11.57,"text":"Jeg er barnehageassistent,","zh":"我是幼儿园助理，","words":[[0,3,9.07,9.73,"jeg"],[4,6,9.73,10.01,"er"],[7,25,10.01,11.49,"barnehageassistent"]]},{"id":2,"start":12.76,"end":16.23,"text":"og jeg jobber i en stor barnehage med mange barn.","zh":"我在一家有很多孩子的大幼儿园工作。","words":[[0,2,12.84,12.97,"og"],[3,6,12.97,13.23,"jeg"],[7,13,13.23,13.61,"jobber~003ddb6d77e6"],[14,15,13.61,13.77,"i"],[16,18,13.77,14.01,"en~a939a9e56dc5"],[19,23,14.01,14.27,"stor"],[24,33,14.27,14.95,"barnehage"],[34,37,14.95,15.31,"med~048e87586d09"],[38,43,15.31,15.67,"mange"],[44,48,15.67,16.15,"barn"]]},{"id":3,"start":18.38,"end":22.23,"text":"Barna er i barnehagen, for foreldrene er på jobb.","zh":"孩子们在幼儿园，因为父母在上班。","words":[[0,5,18.46,18.83,"barna"],[6,8,18.83,19.23,"er"],[9,10,19.23,19.47,"i"],[11,21,19.47,20.09,"barnehagen"],[23,26,20.09,20.63,"for~a05c87659379"],[27,37,20.63,21.27,"foreldrene"],[38,40,21.27,21.55,"er"],[41,43,21.55,21.73,"på"],[44,48,21.73,22.14,"jobb"]]},{"id":4,"start":24.23,"end":30.39,"text":"Jeg har mange kollegaer, både barnehagelærere og andre assistenter.","zh":"我有很多同事，既有幼儿园老师，也有其他助理。","words":[[0,3,24.32,24.48,"jeg"],[4,7,24.48,24.68,"har"],[8,13,24.68,25.08,"mange"],[14,23,25.08,25.88,"kollegaer"],[25,29,27.21,27.47,"både"],[30,45,27.47,28.69,"barnehagelærere"],[46,48,28.69,29.03,"og"],[49,54,29.03,29.45,"andre~0c69ef1e750c"],[55,66,29.45,30.31,"assistenter"]]},{"id":5,"start":32.05,"end":34.21,"text":"Vi har mange oppgaver hver dag.","zh":"我们每天有很多任务。","words":[[0,2,32.13,32.25,"vi"],[3,6,32.25,32.43,"har"],[7,12,32.43,32.73,"mange"],[13,21,32.73,33.41,"oppgaver"],[22,26,33.41,33.67,"hver"],[27,30,33.67,34.13,"dag"]]},{"id":6,"start":36.29,"end":44.65,"text":"Barna lærer mye hver dag, og vi synger, leker, og gjør aktiviteter sammen med dem.","zh":"孩子们每天学到很多东西，我们和他们一起唱歌、玩耍、做活动。","words":[[0,5,36.37,36.82,"barna"],[6,11,36.82,37.3,"lærer~0769c7af9c2d"],[12,15,37.3,37.68,"mye~cc164d0dc3da"],[16,20,37.68,37.98,"hver"],[21,24,37.98,38.26,"dag"],[26,28,38.76,39.0,"og"],[29,31,39.0,39.16,"vi"],[32,38,39.16,39.64,"synger"],[40,45,40.4,41.04,"leker"],[47,49,42.15,42.63,"og"],[50,54,42.63,42.89,"gjør"],[55,66,42.89,43.71,"aktiviteter"],[67,73,43.71,44.11,"sammen"],[74,77,44.11,44.27,"med"],[78,81,44.27,44.57,"dem"]]},{"id":7,"start":45.59,"end":51.55,"text":"Vi må også kle på dem, skifte bleier og hjelpe dem med praktiske ting.","zh":"我们还得给他们穿衣服、换尿布，帮他们处理一些生活上的事。","words":[[0,2,45.67,45.97,"vi"],[3,5,45.97,46.21,"må"],[6,10,46.21,46.53,"også"],[11,14,46.53,46.85,"kle~804be8db9f13"],[15,17,46.85,47.11,"på~234ce18a2110"],[18,21,47.11,47.37,"dem"],[23,29,48.01,48.29,"skifte"],[30,36,48.29,48.99,"bleier"],[37,39,48.99,49.69,"og"],[40,46,49.69,50.09,"hjelpe"],[47,50,50.09,50.31,"dem"],[51,54,50.31,50.51,"med~41eec44f57d5"],[55,64,50.51,51.11,"praktiske"],[65,69,51.11,51.47,"ting"]]},{"id":8,"start":52.4,"end":56.12,"text":"Det er morsomt å jobbe med barn, og jeg trives godt.","zh":"和孩子们一起工作很有趣，我在这里过得很开心。","words":[[0,3,52.48,52.56,"det"],[4,6,52.56,52.68,"er"],[7,14,52.68,53.4,"morsomt"],[15,16,53.4,53.56,"å~0583da7a620a"],[17,22,53.56,53.8,"jobbe"],[23,26,53.8,53.98,"med"],[27,31,53.98,54.28,"barn"],[33,35,54.88,55.02,"og"],[36,39,55.02,55.2,"jeg"],[40,46,55.2,55.76,"trives"],[47,51,55.76,56.04,"godt~70e6d941005d"]]},{"id":9,"start":59.18,"end":60.92,"text":"Vinter i barnehagen","zh":"幼儿园的冬天","words":[[0,6,59.26,59.81,"vinter"],[7,8,59.81,60.09,"i"],[9,19,60.09,60.84,"barnehagen"]]},{"id":10,"start":62.67,"end":66.9,"text":"Kaldt og mye snø ute. Kan vi være inne?","speaker":"Leyla","zh":"外面又冷，雪又多。我们可以待在室内吗？","words":[[0,5,62.75,63.51,"kaldt"],[6,8,63.51,63.81,"og"],[9,12,63.81,64.05,"mye~cc164d0dc3da"],[13,16,64.05,64.47,"snø~c3b53aee92b5"],[17,20,64.47,64.91,"ute"],[22,25,65.69,65.95,"kan"],[26,28,65.95,66.07,"vi"],[29,33,66.07,66.27,"være"],[34,38,66.27,66.82,"inne"]]},{"id":11,"start":68.14,"end":71.58,"text":"Nei, men vi må ta på mye klær.","speaker":"Kollega","zh":"不行，不过我们得多穿点衣服。","words":[[0,3,68.22,68.71,"nei"],[5,8,69.15,69.43,"men"],[9,11,69.43,69.63,"vi"],[12,14,69.63,69.77,"må"],[15,17,69.83,70.13,"ta~3aec2189c96e"],[18,20,70.13,70.39,"på~3c2ce0bc4e52"],[21,24,70.39,71.01,"mye~cc164d0dc3da"],[25,29,71.01,71.5,"klær"]]},{"id":12,"start":72.86,"end":75.09,"text":"Jeg skjønner. Det kan vi gjøre.","speaker":"Leyla","zh":"我明白了。这个我们可以做到。","words":[[0,3,72.94,73.09,"jeg"],[4,12,73.09,73.41,"skjønner"],[14,17,73.97,74.33,"det"],[18,21,74.33,74.55,"kan"],[22,24,74.55,74.65,"vi"],[25,30,74.65,75.02,"gjøre"]]},{"id":13,"start":75.4,"end":79.78,"text":"Pappa henter Markus","zh":"爸爸来接马库斯","words":[[0,5,77.65,78.43,"pappa"],[6,12,78.43,78.97,"henter"],[13,19,78.97,79.7,"markus"]]},{"id":14,"start":82.3,"end":84.37,"text":"Er du pappaen til Markus?","speaker":"Leyla","zh":"你是马库斯的爸爸吗？","words":[[0,2,82.38,82.56,"er"],[3,5,82.56,82.78,"du"],[6,13,82.78,83.38,"pappaen"],[14,17,83.38,83.56,"til~8de1a9181f86"],[18,24,83.56,84.29,"markus"]]},{"id":15,"start":84.46,"end":87.58,"text":"Ja, jeg heter Bjørnar.","speaker":"Bjørnar","zh":"是的，我叫比约纳尔。","words":[[0,2,84.78,85.54,"ja"],[4,7,86.0,86.36,"jeg"],[8,13,86.36,86.68,"heter"],[14,21,86.68,87.5,"bjørnar"]]},{"id":16,"start":88.69,"end":92.2,"text":"Jeg heter Leyla og er ny assistent her i barnehagen.","speaker":"Leyla","zh":"我叫莱拉，是这家幼儿园新来的助理。","words":[[0,3,88.77,88.95,"jeg"],[4,9,88.95,89.19,"heter"],[10,15,89.19,89.67,"leyla"],[16,18,89.67,89.99,"og"],[19,21,89.99,90.19,"er"],[22,24,90.19,90.41,"ny"],[25,34,90.41,91.01,"assistent"],[35,38,91.01,91.27,"her"],[39,40,91.27,91.37,"i"],[41,51,91.37,92.12,"barnehagen"]]},{"id":17,"start":92.99,"end":94.53,"text":"Hyggelig å hilse på deg.","speaker":"Bjørnar","zh":"很高兴认识你。","words":[[0,8,93.07,93.47,"hyggelig"],[9,10,93.47,93.59,"å~0583da7a620a"],[11,16,93.59,94.01,"hilse"],[17,19,94.01,94.19,"på~588ffe6c89d8"],[20,23,94.19,94.45,"deg"]]},{"id":18,"start":95.53,"end":100.02,"text":"Takk i like måte. Skal du hente Markus?","speaker":"Leyla","zh":"谢谢，我也很高兴认识你。你是来接马库斯的吗？","words":[[0,4,95.61,96.01,"takk"],[5,6,96.01,96.09,"i~d931e4e5d506"],[7,11,96.09,96.31,"like~96c08a97a401"],[12,16,96.31,96.49,"måte~e6eb4b458deb"],[18,22,98.23,98.65,"skal"],[23,25,98.65,98.93,"du"],[26,31,98.93,99.23,"hente"],[32,38,99.23,99.94,"markus"]]},{"id":19,"start":100.52,"end":103.85,"text":"Ja. Han skal til tannlegen.","speaker":"Bjørnar","zh":"对。他要去看牙医。","words":[[0,2,100.52,101.19,"ja"],[4,7,101.94,102.22,"han"],[8,12,102.22,102.42,"skal~e65efaba04da"],[13,16,102.42,102.76,"til"],[17,26,102.76,103.77,"tannlegen"]]},{"id":20,"start":105.53,"end":107.14,"text":"Takk for i dag, Markus.","speaker":"Leyla","zh":"今天谢谢你啦，马库斯。","words":[[0,4,105.61,105.86,"takk"],[5,8,105.86,106.0,"for~0132b57a028e"],[9,10,106.0,106.12,"i~de136e71704d"],[11,14,106.12,106.3,"dag"],[16,22,106.4,107.06,"markus"]]},{"id":21,"start":109.85,"end":112.14,"text":"Personalmøte i barnehagen.","zh":"幼儿园的员工会议。","words":[[0,12,109.93,111.01,"personalmøte"],[13,14,111.01,111.23,"i"],[15,25,111.23,112.06,"barnehagen"]]},{"id":22,"start":114.16,"end":117.36,"text":"Nå er planen for neste måned klar.","speaker":"Kollega","zh":"下个月的计划现在定好了。","words":[[0,2,114.24,114.55,"nå~d531d47a7712"],[3,5,114.55,114.79,"er"],[6,12,114.79,115.41,"planen"],[13,16,115.41,115.73,"for~7dc1abfddf44"],[17,22,115.73,116.05,"neste~67b7b5e351a0"],[23,28,116.05,116.65,"måned"],[29,33,116.65,117.28,"klar"]]},{"id":23,"start":118.78,"end":120.71,"text":"Hva er tema denne gangen?","speaker":"Leyla","zh":"这次的主题是什么？","words":[[0,3,118.86,119.06,"hva"],[4,6,119.06,119.36,"er"],[7,11,119.36,119.76,"tema"],[12,17,119.76,120.16,"denne"],[18,24,120.16,120.63,"gangen"]]},{"id":24,"start":121.77,"end":127.9,"text":"Temaet er høst, og barna skal lære om norsk natur om høsten.","speaker":"Kollega","zh":"主题是秋天，孩子们要了解挪威秋天的大自然。","words":[[0,6,121.85,122.41,"temaet"],[7,9,122.41,122.77,"er"],[10,14,122.77,123.37,"høst"],[16,18,123.93,124.09,"og"],[19,24,124.09,124.67,"barna"],[25,29,124.67,124.95,"skal"],[30,34,124.95,125.29,"lære"],[35,37,125.29,125.59,"om~52c0bdc828db"],[38,43,125.59,126.17,"norsk~300c0d0c4f59"],[44,49,126.17,126.67,"natur"],[50,52,127.17,127.25,"om~2fdd1539ca38"],[53,59,127.25,127.82,"høsten"]]},{"id":25,"start":129.03,"end":131.26,"text":"Skal vi være ute hver dag?","speaker":"Leyla","zh":"我们每天都要待在户外吗？","words":[[0,4,129.11,129.38,"skal"],[5,7,129.38,129.52,"vi"],[8,12,129.52,129.7,"være"],[13,16,129.7,130.3,"ute"],[17,21,130.3,130.62,"hver"],[22,25,130.62,131.18,"dag"]]},{"id":26,"start":132.16,"end":136.58,"text":"I barnehagen er vi ute hver dag hele året.","speaker":"Kollega","zh":"在幼儿园，我们一年到头每天都在户外。","words":[[0,1,132.24,132.38,"i"],[2,12,132.38,133.2,"barnehagen"],[13,15,133.2,133.74,"er"],[16,18,133.74,133.92,"vi"],[19,22,133.92,134.42,"ute"],[23,27,134.42,134.9,"hver"],[28,31,134.9,135.22,"dag"],[32,36,135.22,136.02,"hele"],[37,41,136.02,136.5,"året"]]},{"id":27,"start":137.22,"end":140.03,"text":"Jeg må kjøpe varme klær.","speaker":"Leyla","zh":"我得买些保暖的衣服。","words":[[0,3,137.54,138.44,"jeg"],[4,6,138.44,138.6,"må"],[7,12,138.6,139.04,"kjøpe"],[13,18,139.04,139.44,"varme"],[19,23,139.44,139.95,"klær"]]},{"id":28,"start":141.09,"end":149.66,"text":"Ja, nordmenn pleier å si: Det finnes ikke dårlig vær, bare dårlige klær.","speaker":"Kollega","zh":"是啊，挪威人常说：没有坏天气，只有不合适的衣服。","words":[[0,2,141.17,141.54,"ja"],[4,12,142.24,142.9,"nordmenn"],[13,19,142.9,143.46,"pleier"],[20,21,143.46,143.58,"å~0583da7a620a"],[22,24,143.58,143.84,"si~c139ffdb1a59"],[26,29,144.54,144.8,"det"],[30,36,144.8,145.5,"finnes"],[37,41,145.5,145.86,"ikke"],[42,48,145.86,146.46,"dårlig"],[49,52,146.46,146.8,"vær~c9ef13faaa9b"],[54,58,147.38,147.84,"bare"],[59,66,147.84,149.02,"dårlige"],[67,71,149.02,149.58,"klær"]]},{"id":29,"start":154.02,"end":155.03,"text":"Det regner","zh":"下雨了","words":[[0,3,154.1,154.25,"det"],[4,10,154.25,154.95,"regner"]]},{"id":30,"start":156.56,"end":158.11,"text":"Det regner på gresset.","zh":"雨落在草地上。","words":[[0,3,156.64,156.76,"det"],[4,10,156.76,157.24,"regner"],[11,13,157.24,157.44,"på"],[14,21,157.44,158.03,"gresset"]]},{"id":31,"start":159.06,"end":160.37,"text":"Det regner på vei'.","zh":"雨落在路上。","words":[[0,3,159.14,159.22,"det"],[4,10,159.22,159.6,"regner"],[11,13,159.6,159.82,"på"],[14,17,159.82,160.29,"vei"]]},{"id":32,"start":161.54,"end":165.27,"text":"Det regner på taket, men ikke på meg.","zh":"雨落在屋顶上，可没落在我身上。","words":[[0,3,161.62,161.71,"det"],[4,10,161.71,162.11,"regner"],[11,13,162.11,162.33,"på"],[14,19,162.33,162.99,"taket"],[21,24,163.72,164.1,"men"],[25,29,164.1,164.52,"ikke"],[30,32,164.52,164.8,"på"],[33,36,164.8,165.19,"meg"]]}],"lexicon":{"5.5":{"lemma":"5.5","zh":"第 5.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aktiviteter":{"lemma":"aktivitet","zh":"活动","pos":"名词","ref":"5-111","form":"复数不定","clip":null},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre","clip":"pronunciation/bd01b0b648c2c64eb1bd.mp3","ambiguous":true,"candidates":[{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre"},{"lemma":"andre","zh":"第二","pos":"序数词","ref":"basics:ordinals:andre"},{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式"}]},"assistent":{"lemma":"assistent","zh":"助理","pos":"名词","ref":"5-076","clip":"pronunciation/7dc58d6db0b56c5c11eb.mp3"},"assistenter":{"lemma":"assistent","zh":"助理","pos":"名词","ref":"5-076","form":"复数不定","clip":null},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":"pronunciation/e43a7ece