{"id":"ty-conversation-4.2","bookId":"ty-conversation-guide","readingId":"4.2","title":"The tourist information office","audio":"audio/ty-conversation/4.2.mp3","duration":45.191854,"synthetic":false,"sentences":[{"id":0,"start":1.54,"end":6.38,"speaker":"Olav","text":"Hei! Vi vil gjerne ha et godt kart over Oslo.","zh":"你好！我们想要一张好用的奥斯陆地图。","words":[[0,3,1.54,2.42,"hei"],[5,7,2.82,2.9,"vi"],[8,11,2.9,3.18,"vil"],[12,18,3.18,3.84,"gjerne"],[19,21,3.84,4.02,"ha@ty-want-item"],[22,24,4.02,4.3,"et"],[25,29,4.3,4.66,"godt"],[30,34,4.66,5.04,"kart"],[35,39,5.04,5.48,"over@ty-map-over"],[40,44,5.48,6.38,"oslo"]]},{"id":1,"start":7.1,"end":8.98,"speaker":"Man","text":"Her har du et godt kart.","zh":"这张地图很好，给你。","words":[[0,3,7.1,7.3,"her"],[4,7,7.3,7.64,"har@ty-handover"],[8,10,7.64,7.86,"du"],[11,13,7.86,8.18,"et"],[14,18,8.18,8.64,"godt"],[19,23,8.64,8.98,"kart"]]},{"id":2,"start":9.72,"end":11.22,"speaker":"Man","text":"Det er gratis.","zh":"是免费的。","words":[[0,3,9.72,9.98,"det@ty-referential-det"],[4,6,9.98,10.34,"er@ty-be-description"],[7,13,10.34,11.22,"gratis@ty-gratis-adjective"]]},{"id":3,"start":12.42,"end":15.5,"speaker":"Olav","text":"Takk. Har du en Oslo-guide?","zh":"谢谢。你这里有奥斯陆旅游指南吗？","words":[[0,4,12.42,13.28,"takk"],[6,9,13.72,13.98,"har@ty-availability"],[10,12,13.98,14.2,"du"],[13,15,14.2,14.54,"en"],[16,26,14.54,15.5,"oslo-guide"]]},{"id":4,"start":15.98,"end":19.3,"speaker":"Man","text":"Ja, her er en Oslo-guide.","zh":"有，这里有一本奥斯陆旅游指南。","words":[[0,2,15.98,16.4,"ja"],[4,7,16.96,17.4,"her"],[8,10,17.4,17.78,"er@ty-be-presentation"],[11,13,17.78,18.08,"en"],[14,24,18.08,19.3,"oslo-guide"]]},{"id":5,"start":19.78,"end":21.82,"speaker":"Man","text":"Den er også gratis.","zh":"这也是免费的。","words":[[0,3,19.78,20.14,"den"],[4,6,20.14,20.52,"er@ty-be-description"],[7,11,20.52,21.04,"også"],[12,18,21.04,21.82,"gratis@ty-gratis-adjective"]]},{"id":6,"start":23.26,"end":27.14,"speaker":"Olav","text":"Takk. Har dere kort og frimerker?","zh":"谢谢。你们这里有明信片和邮票吗？","words":[[0,4,23.26,24.14,"takk"],[6,9,24.64,24.86,"har@ty-availability"],[10,14,24.86,25.32,"dere"],[15,19,25.32,25.76,"kort@ty-postcard"],[20,22,25.76,26.44,"og"],[23,32,26.44,27.14,"frimerker"]]},{"id":7,"start":27.14,"end":31.8,"speaker":"Man","text":"Ja, dere kan kjøpe kort og frimerker her.","zh":"有，你们可以在这里买明信片和邮票。","words":[[0,2,27.14,27.96,"ja"],[4,8,28.48,28.68,"dere"],[9,12,28.68,28.96,"kan"],[13,18,28.96,29.44,"kjøpe"],[19,23,29.44,29.82,"kort@ty-postcard"],[24,26,29.82,30.44,"og"],[27,36,30.44,31.2,"frimerker"],[37,40,31.2,31.8,"her"]]},{"id":8,"start":33.66,"end":35.9,"speaker":"Olav","text":"Har du en engelsk avis?","zh":"你这里有英文报纸吗？","words":[[0,3,33.66,33.92,"har@ty-availability"],[4,6,33.92,34.3,"du"],[7,9,34.3,34.66,"en"],[10,17,34.66,35.38,"engelsk@ty-english-adjective"],[18,22,35.38,35.9,"avis@ty-newspaper"]]},{"id":9,"start":36.62,"end":39.32,"speaker":"Man","text":"Nei. Du må gå til en kiosk.","zh":"没有。你得去报刊亭买。","words":[[0,3,36.62,37.38,"nei"],[5,7,37.64,37.78,"du"],[8,10,37.78,37.92,"må"],[11,13,37.92,38.16,"gå@ty-walk-infinitive"],[14,17,38.16,38.36,"til"],[18,20,38.36,38.62,"en"],[21,26,38.62,39.32,"kiosk"]]},{"id":10,"start":40.48,"end":42.18,"speaker":"Olav","text":"Takk. Ha det bra!","zh":"谢谢。再见！","words":[[0,4,40.48,41.24,"takk"],[6,8,41.54,41.76,"ha@ty-farewell-ha"],[9,12,41.76,41.9,"det@ty-farewell-det"],[13,16,41.9,42.18,"bra@ty-farewell-bra"]]},{"id":11,"start":42.72,"end":43.38,"speaker":"Man","text":"Hei hei!","zh":"再见！","words":[[0,3,42.72,43.0,"hei@ty-farewell-hei"],[4,7,43.0,43.38,"hei@ty-farewell-hei"]]}],"lexicon":{"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"avis@ty-newspaper":{"lemma":"avis","zh":"报纸","pos":"名词","ref":"ty-conversation-4-001","clip":null,"contextual":true,"baseKey":"avis","surface":"avis"},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"bra@ty-farewell-bra":{"lemma":"bra","zh":"好（Ha det bra!：再见）","pos":"副词","ref":"pa-vei-2-018","clip":null,"contex