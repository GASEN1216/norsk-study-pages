{"id":"ty-conversation-4.2","bookId":"ty-conversation-guide","readingId":"4.2","title":"The tourist information office","audio":"audio/ty-conversation/4.2.mp3","duration":45.191854,"synthetic":false,"sentences":[{"id":0,"start":1.09,"end":5.815,"speaker":"Olav","text":"Hei! Vi vil gjerne ha et godt kart over Oslo.","zh":"你好！我们想要一张好用的奥斯陆地图。","words":[[0,3,1.09,1.315,"hei"],[5,7,2.73,2.873,"vi"],[8,11,2.873,3.055,"vil"],[12,18,3.13,3.575,"gjerne"],[19,21,3.85,3.993,"ha@ty-want-item"],[22,24,3.993,4.175,"et"],[25,29,4.23,4.535,"godt"],[30,34,4.59,4.955,"kart"],[35,39,5.25,5.473,"over@ty-map-over"],[40,44,5.473,5.815,"oslo"]]},{"id":1,"start":6.91,"end":8.935,"speaker":"Man","text":"Her har du et godt kart.","zh":"这张地图很好，给你。","words":[[0,3,6.91,7.235,"her"],[4,7,7.31,7.553,"har@ty-handover"],[8,10,7.553,7.695,"du"],[11,13,7.87,8.075,"et"],[14,18,8.11,8.415,"godt"],[19,23,8.61,8.935,"kart"]]},{"id":2,"start":9.73,"end":10.875,"speaker":"Man","text":"Det er gratis.","zh":"是免费的。","words":[[0,3,9.73,9.915,"det@ty-referential-det"],[4,6,9.97,10.195,"er@ty-be-description"],[7,13,10.27,10.875,"gratis@ty-gratis-adjective"]]},{"id":3,"start":12.33,"end":15.415,"speaker":"Olav","text":"Takk. Har du en Oslo-guide?","zh":"谢谢。你这里有奥斯陆旅游指南吗？","words":[[0,4,12.33,12.655,"takk"],[6,9,13.71,13.933,"har@ty-availability"],[10,12,13.933,14.075,"du"],[13,15,14.23,14.395,"en"],[16,26,14.53,15.415,"oslo-guide"]]},{"id":4,"start":15.95,"end":18.915,"speaker":"Man","text":"Ja, her er en Oslo-guide.","zh":"有，这里有一本奥斯陆旅游指南。","words":[[0,2,15.95,16.115,"ja"],[4,7,16.99,17.315,"her"],[8,10,17.39,17.655,"er@ty-be-presentation"],[11,13,17.85,18.015,"en"],[14,24,18.11,18.915,"oslo-guide"]]},{"id":5,"start":19.79,"end":21.595,"speaker":"Man","text":"Den er også gratis.","zh":"这也是免费的。","words":[[0,3,19.79,19.995,"den"],[4,6,20.23,20.395,"er@ty-be-description"],[7,11,20.49,20.835,"også"],[12,18,21.07,21.595,"gratis@ty-gratis-adjective"]]},{"id":6,"start":22.81,"end":27.015,"speaker":"Olav","text":"Takk. Har dere kort og frimerker?","zh":"谢谢。你们这里有明信片和邮票吗？","words":[[0,4,22.81,23.175,"takk"],[6,9,24.55,24.795,"har@ty-availability"],[10,14,24.85,25.215,"dere"],[15,19,25.29,25.715,"kort@ty-postcard"],[20,22,26.17,26.355,"og"],[23,32,26.39,27.015,"frimerker"]]},{"id":7,"start":27.57,"end":31.495,"speaker":"Man","text":"Ja, dere kan kjøpe kort og frimerker her.","zh":"有，你们可以在这里买明信片和邮票。","words":[[0,2,27.57,27.735,"ja"],[4,8,28.41,28.693,"dere"],[9,12,28.693,28.855,"kan"],[13,18,28.91,29.315,"kjøpe"],[19,23,29.37,29.755,"kort@ty-postcard"],[24,26,30.11,30.255,"og"],[27,36,30.35,31.035,"frimerker"],[37,40,31.21,31.495,"her"]]},{"id":8,"start":33.61,"end":35.755,"speaker":"Olav","text":"Har du en engelsk avis?","zh":"你这里有英文报纸吗？","words":[[0,3,33.61,33.835,"har@ty-availability"],[4,6,33.91,34.055,"du"],[7,9,34.31,34.455,"en"],[10,17,34.59,35.215,"engelsk@ty-english-adjective"],[18,22,35.29,35.755,"avis@ty-newspaper"]]},{"id":9,"start":36.53,"end":38.915,"speaker":"Man","text":"Nei. Du må gå til en kiosk.","zh":"没有。你得去报刊亭买。","words":[[0,3,36.53,36.795,"nei"],[5,7,37.59,37.735,"du"],[8,10,37.75,37.892,"må"],[11,13,37.892,38.035,"gå@ty-walk-infinitive"],[14,17,38.13,38.315,"til"],[18,20,38.33,38.455,"en"],[21,26,38.49,38.915,"kiosk"]]},{"id":10,"start":40.07,"end":41.995,"speaker":"Olav","text":"Takk. Ha det bra!","zh":"谢谢。再见！","words":[[0,4,40.07,40.375,"takk"],[6,8,41.51,41.655,"ha@ty-farewell-ha"],[9,12,41.67,41.823,"det@ty-farewell-det"],[13,16,41.823,41.995,"bra@ty-farewell-bra"]]},{"id":11,"start":42.59,"end":43.075,"speaker":"Man","text":"Hei hei!","zh":"再见！","words":[[0,3,42.59,42.815,"hei@ty-farewell-hei"],[4,7,42.87,43.075,"hei@ty-farewell-hei"]]}],"lexicon":{"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"avis@ty-newspaper":{"lemma":"avis","zh":"报纸","pos":"名词","ref":"ty-conversation-4-001","clip":null,"contextual":true,"baseKey":"avis","surface":"avis"},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null}