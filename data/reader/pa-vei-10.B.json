{"id":"pa-vei-10.B","bookId":"pa-vei-textbook","readingId":"10.B","title":"Pauls historie","audio":"audio/pa-vei/10.B.mp3","duration":165.6,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.78,"end":3.005,"text":"Jeg kom til Norge for litt over tre år siden.","zh":"我三年多前来到挪威。","words":[[0,3,0.78,0.965,"jeg"],[4,7,0.98,1.165,"kom"],[8,11,1.24,1.402,"til"],[12,17,1.402,1.745,"norge"],[18,21,1.76,1.913,"for"],[22,26,1.913,2.123,"litt"],[27,31,2.123,2.312,"over"],[32,35,2.312,2.525,"tre"],[36,38,2.58,2.732,"år"],[39,44,2.732,3.005,"siden"]],"speaker":"Paul"},{"id":1,"start":3.92,"end":6.225,"text":"4. januar landet jeg på Gardermoen.","zh":"一月四日，我在加勒穆恩机场降落。","words":[[0,1,3.92,4.353,"4"],[3,9,4.353,4.845,"januar"],[10,16,5.18,5.502,"landet@pa-vei-landet-landed"],[17,20,5.502,5.623,"jeg"],[21,23,5.623,5.732,"på"],[24,34,5.732,6.225,"gardermoen"]],"speaker":"Paul"},{"id":2,"start":7.44,"end":9.965,"text":"Der var det mørkt og kaldt, og jeg frøs.","zh":"那里又黑又冷，我冷得发抖。","words":[[0,3,7.44,7.633,"der"],[4,7,7.633,7.763,"var"],[8,11,7.763,7.885,"det"],[12,17,7.9,8.305,"mørkt"],[18,20,8.4,8.533,"og"],[21,26,8.533,8.885,"kaldt"],[28,30,9.3,9.422,"og"],[31,34,9.422,9.562,"jeg"],[35,39,9.562,9.965,"frøs"]],"speaker":"Paul"},{"id":3,"start":11.146,"end":15.031,"text":"Først bodde jeg på et asylmottak på et lite sted langt ute på landet.","zh":"起初，我住在乡下一个很偏僻的小地方的难民接待中心。","words":[[0,5,11.146,11.611,"først"],[6,11,11.826,12.088,"bodde"],[12,15,12.088,12.229,"jeg"],[16,18,12.229,12.369,"på"],[19,21,12.369,12.489,"et"],[22,32,12.489,13.291,"asylmottak"],[33,35,13.346,13.459,"på"],[36,38,13.459,13.588,"et"],[39,43,13.588,13.871,"lite"],[44,48,13.886,14.209,"sted"],[49,54,14.209,14.459,"langt"],[55,58,14.459,14.639,"ute"],[59,61,14.639,14.748,"på"],[62,68,14.748,15.031,"landet@pa-vei-landet-countryside"]],"speaker":"Paul"},{"id":4,"start":16.08,"end":20.045,"text":"Jeg var glad for å være i trygghet, og jeg trente og prøvde å holde meg i form.","zh":"能身处安全的地方，我很高兴，我锻炼身体，努力保持健康。","words":[[0,3,16.08,16.222,"jeg"],[4,7,16.222,16.352,"var"],[8,12,16.352,16.583,"glad"],[13,16,16.583,16.733,"for"],[17,18,16.733,16.812,"å"],[19,23,16.812,17.002,"være"],[24,25,17.002,17.102,"i"],[26,34,17.102,17.625,"trygghet"],[36,38,18.14,18.242,"og"],[39,42,18.242,18.383,"jeg"],[43,49,18.383,18.885,"trente"],[50,52,18.92,19.042,"og"],[53,59,19.042,19.362,"prøvde"],[60,61,19.362,19.422,"å"],[62,67,19.422,19.602,"holde"],[68,71,19.602,19.733,"meg"],[72,73,19.733,19.803,"i"],[74,78,19.803,20.045,"form"]],"speaker":"Paul"},{"id":5,"start":20.98,"end":22.125,"text":"Men jeg følte meg ensom.","zh":"可我感到孤独。","words":[[0,3,20.98,21.133,"men"],[4,7,21.133,21.263,"jeg"],[8,13,21.263,21.583,"følte"],[14,17,21.583,21.723,"meg"],[18,23,21.723,22.125,"ensom"]],"speaker":"Paul"},{"id":6,"start":23.0,"end":26.505,"text":"Jeg ble deprimert, og det var vanskelig å sove om natta.","zh":"我变得抑郁，晚上很难入睡。","words":[[0,3,23.0,23.172,"jeg"],[4,7,23.172,23.305,"ble"],[8,17,23.32,24.005,"deprimert"],[19,21,24.84,24.973,"og"],[22,25,24.973,25.093,"det"],[26,29,25.093,25.233,"var"],[30,39,25.233,25.733,"vanskelig"],[40,41,25.733,25.822,"å"],[42,46,25.822,26.113,"sove"],[47,49,26.113,26.212,"om"],[50,55,26.212,26.505,"natta"]],"speaker":"Paul"},{"id":7,"start":28.28,"end":29.925,"text":"Jeg lengtet etter familien min.","zh":"我渴望和家人团聚。","words":[[0,3,28.28,28.445,"jeg"],[4,11,28.46,28.985,"lengtet"],[12,17,29.0,29.265,"etter"],[18,26,29.28,29.773,"familien"],[27,30,29.773,29.925,"min"]],"speaker":"Paul"},{"id":8,"start":30.84,"end":33.205,"text":"Jeg savnet kona mi og de to barna våre.","zh":"我想念妻子和我们的两个孩子。","words":[[0,3,30.84,31.002,"jeg"],[4,10,31.002,31.505,"savnet"],[11,15,31.52,31.883,"kona"],[16,18,31.883,32.025,"mi"],[19,21,32.26,32.373,"og"],[22,24,32.373,32.502,"de@pa-vei-de-definite"],[25,27,32.502,32.665,"to"],[28,33,32.7,32.983,"barna"],[34,38,32.983,33.205,"våre"]],"speaker":"Paul"},{"id":9,"start":35.1,"end":40.745,"text":"Men så, den 13. mars for litt over et år siden, kom endelig Michelle og barna våre hit.","zh":"后来，一年多前的三月十三日，米歇尔和我们的孩子终于来到了这里。","words":[[0,3,35.1,35.285,"men"],[4,6,35.36,35.525,"så"],[8,11,36.04,36.225,"den@pa-vei-den-definite"],[12,14,36.28,36.782,"13"],[16,20,36.782,37.085,"mars"],[21,24,37.1,37.263,"for"],[25,29,37.263,37.493,"litt"],[30,34,37.493,37.683,"over"],[35,37,37.683,37.812,"et"],[38,40,37.812,37.965,"år"],[41,46,37.98,38.265,"siden"],[48,51,38.7,38.865,"kom"],[52,59,38.96,39.422,"endelig"],[60,68,39.422,39.873,"michelle"],[69,71,39.873,39.972,"og"],[72,77,39.972,40.263,"barna"],[78,82,40.263,40.462,"våre"],[83,86,40.462,40.745,"hit"]],"speaker":"Paul"},{"id":10,"start":41.706,"end":45.531,"text":"Jeg hentet dem på Gardermoen, og vi lo og gråt og klemte hverandre.","zh":"我去加勒穆恩机场接他们，我们又笑又哭，紧紧拥抱。","words":[[0,3,41.706,41.871,"jeg"],[4,10,41.886,42.228,"hentet"],[11,14,42.228,42.349,"dem"],[15,17,42.349,42.478,"på"],[18,28,42.478,43.011,"gardermoen"],[30,32,43.326,43.439,"og"],[33,35,43.439,43.571,"vi"],[36,38,43.606,43.771,"lo"],[39,41,44.046,44.191,"og"],[42,46,44.206,44.631,"gråt"],[47,49,44.686,44.799,"og"],[50,56,44.799,45.148,"klemte"],[57,66,45.148,45.531,"hverandre"]],"speaker":"Paul"},{"id":11,"start":46.406,"end":47.471,"text":"Det var en stor dag!","zh":"那是个意义重大的日子！","words":[[0,3,46.406,46.569,"det"],[4,7,46.569,46.739,"var"],[8,10,46.739,46.871,"en"],[11,15,46.926,47.209,"stor"],[16,19,47.209,47.471,"dag"]],"speaker":"Paul"},{"id":12,"start":49.146,"end":52.411,"text":"For et halvt år siden flyttet vi hit og fikk en leilighet.","zh":"半年前，我们搬到这里，有了一套公寓。","words":[[0,3,49.146,49.319,"for"],[4,6,49.319,49.468,"et"],[7,12,49.468,49.769,"halvt"],[13,15,49.769,49.948,"år"],[16,21,49.948,50.271,"siden"],[22,29,50.406,50.788,"flyttet"],[30,32,50.788,50.889,"vi"],[33,36,50.889,51.191,"hit"],[37,39,51.466,51.588,"og"],[40,44,51.588,51.799,"fikk"],[45,47,51.799,51.909,"en"],[48,57,51.909,52.411,"leilighet"]],"speaker":"Paul"},{"id":13,"start":53.366,"end":54.711,"text":"Den ligger i femte etasje.","zh":"公寓在五楼。","words":[[0,3,53.366,53.549,"den"],[4,10,53.549,53.819,"ligger"],[11,12,53.819,53.909,"i"],[13,18,53.909,54.278,"femte"],[19,25,54.278,54.711,"etasje"]],"speaker":"Paul"},{"id":14,"start":56.006,"end":57.671,"text":"I begynnelsen kjente vi ingen her.","zh":"一开始，我们在这里谁也不认识。","words":[[0,1,56.006,56.118,"i"],[2,13,56.118,56.691,"begynnelsen"],[14,20,56.786,57.099,"kjente"],[21,23,57.099,57.211,"vi"],[24,29,57.226,57.498,"ingen"],[30,33,57.498,57.671,"her"]],"speaker":"Paul"},{"id":15,"start":58.446,"end":60.651,"text":"Men for noen uker siden var det dugnad.","zh":"不过几周前组织了一次集体义务劳动。","words":[[0,3,58.446,58.631,"men"],[4,7,58.726,58.879,"for"],[8,12,58.879,59.071,"noen"],[13,17,59.086,59.368,"uker"],[18,23,59.368,59.671,"siden"],[24,27,59.886,60.029,"var"],[28,31,60.029,60.151,"det"],[32,38,60.166,60.651,"dugnad"]],"speaker":"Paul"},{"id":16,"start":61.606,"end":65.351,"text":"Da jobbet alle familiene i blokka sammen for å gjøre det pent utenfor.","zh":"那时，楼里所有家庭一起干活，把外面的环境收拾漂亮。","words":[[0,2,61.606,61.751,"da"],[3,9,61.826,62.151,"jobbet"],[10,14,62.166,62.428,"alle"],[15,24,62.428,63.011,"familiene"],[25,26,63.066,63.169,"i"],[27,33,63.169,63.511,"blokka"],[34,40,63.546,63.891,"sammen"],[41,44,64.126,64.288,"for"],[45,46,64.288,64.349,"å"],[47,52,64.349,64.508,"gjøre"],[53,56,64.508,64.629,"det"],[57,61,64.629,64.959,"pent"],[62,69,64.959,65.351,"utenfor"]],"speaker":"Paul"},{"id":17,"start":66.786,"end":72.431,"text":"Noen stelte plantene, noen malte – og noen kokte kaffe og stekte vafler.","zh":"有人照料花草，有人刷漆，还有人煮咖啡、做华夫饼。","words":[[0,4,66.786,67.089,"noen"],[5,11,67.089,67.529,"stelte"],[12,20,67.529,68.011,"plantene"],[22,26,68.806,69.089,"noen"],[27,32,69.089,69.531,"malte"],[35,37,70.506,70.629,"og"],[38,42,70.629,70.879,"noen"],[43,48,70.879,71.189,"kokte"],[49,54,71.189,71.571,"kaffe"],[55,57,71.586,71.709,"og"],[58,64,71.709,72.069,"stekte"],[65,71,72.069,72.431,"vafler"]],"speaker":"Paul"},{"id":18,"start":73.486,"end":76.671,"text":"Det var hyggelig, og nå kjenner vi noen av de andre familiene her.","zh":"大家相处得很愉快，现在我们认识这里的其他几户人家了。","words":[[0,3,73.486,73.629,"det"],[4,7,73.629,73.749,"var"],[8,16,73.749,74.151,"hyggelig"],[18,20,74.706,74.819,"og"],[21,23,74.819,74.931,"nå"],[24,31,75.026,75.329,"kjenner"],[32,34,75.329,75.428,"vi"],[35,39,75.428,75.629,"noen"],[40,42,75.629,75.728,"av"],[43,45,75.728,75.819,"de@pa-vei-de-definite"],[46,51,75.819,76.051,"andre"],[52,61,76.066,76.519,"familiene"],[62,65,76.519,76.671,"her"]],"speaker":"Paul"},{"id":19,"start":79.146,"end":80.911,"text":"Heldigvis liker barna våre seg her.","zh":"幸好，我们的孩子们喜欢这里。","words":[[0,9,79.146,79.671,"heldigvis"],[10,15,79.726,80.118,"liker"],[16,21,80.118,80.409,"barna"],[22,26,80.409,80.618,"våre"],[27,30,80.618,80.739,"seg"],[31,34,80.739,80.911,"her"]],"speaker":"Paul"},{"id":20,"start":81.746,"end":84.291,"text":"Sønnen vår, Ben, går i andre klasse.","zh":"我们的儿子本在上二年级。","words":[[0,6,81.746,82.088,"sønnen"],[7,10,82.088,82.311,"vår"],[12,15,82.506,82.731,"ben"],[17,20,83.366,83.559,"går"],[21,22,83.559,83.649,"i"],[23,28,83.649,83.939,"andre@pa-vei-andre-second"],[29,35,83.939,84.291,"klasse"]],"speaker":"Paul"},{"id":21,"start":85.146,"end":86.071,"text":"Han spiller fotball.","zh":"他踢足球。","words":[[0,3,85.146,85.311,"han"],[4,11,85.326,85.618,"spiller"],[12,19,85.618,86.071,"fotball"]],"speaker":"Paul"},{"id":22,"start":87.086,"end":91.851,"text":"Dattera vår, Jessica, går i barnehagen og skal begynne på skolen til høsten.","zh":"我们的女儿杰西卡在上幼儿园，今年秋天就要上学了。","words":[[0,7,87.086,87.469,"dattera"],[8,11,87.469,87.691,"vår"],[13,20,87.986,88.431,"jessica"],[22,25,89.066,89.258,"går"],[26,27,89.258,89.349,"i"],[28,38,89.349,89.971,"barnehagen"],[39,41,90.346,90.459,"og"],[42,46,90.459,90.618,"skal"],[47,54,90.618,90.888,"begynne"],[55,57,90.888,91.008,"på"],[58,64,91.008,91.398,"skolen"],[65,68,91.398,91.508,"til"],[69,75,91.508,91.851,"høsten"]],"speaker":"Paul"},{"id":23,"start":92.906,"end":93.711,"text":"Hun går på svømming.","zh":"她参加游泳课。","words":[[0,3,92.906,93.059,"hun"],[4,7,93.059,93.198,"går"],[8,10,93.198,93.309,"på"],[11,19,93.309,93.711,"svømming"]],"speaker":"Paul"},{"id":24,"start":94.786,"end":96.411,"text":"I morgen har Jessica fødselsdag.","zh":"明天是杰西卡的生日。","words":[[0,1,94.786,94.888,"i"],[2,8,94.888,95.191,"morgen"],[9,12,95.226,95.379,"har"],[13,20,95.379,95.771,"jessica"],[21,31,95.786,96.411,"fødselsdag"]],"speaker":"Paul"},{"id":25,"start":97.446,"end":98.971,"text":"Da skal vi ha et lite selskap.","zh":"我们要办一个小聚会。","words":[[0,2,97.446,97.589,"da"],[3,7,97.589,97.758,"skal"],[8,10,97.758,97.869,"vi"],[11,13,97.869,98.011,"ha"],[14,16,98.046,98.178,"et"],[17,21,98.178,98.451,"lite"],[22,29,98.466,98.971,"selskap"]],"speaker":"Paul"},{"id":26,"start":99.566,"end":106.371,"text":"Det kommer sju jenter fra barnehagen hjem til oss, og vi skal spise pølser og kake og drikke brus.","zh":"幼儿园的七个女孩会来我们家，我们要吃香肠和蛋糕，喝汽水。","words":[[0,3,99.566,99.728,"det"],[4,10,99.728,99.991,"kommer"],[11,14,100.046,100.251,"sju"],[15,21,100.386,100.831,"jenter"],[22,25,100.906,101.091,"fra"],[26,36,101.106,101.711,"barnehagen"],[37,41,101.826,102.051,"hjem"],[42,45,102.126,102.279,"til"],[46,49,102.279,102.531,"oss"],[51,53,103.066,103.189,"og"],[54,56,103.189,103.288,"vi"],[57,61,103.288,103.448,"skal"],[62,67,103.448,103.791,"spise"],[68,74,103.806,104.311,"pølser"],[75,77,104.566,104.711,"og"],[78,82,104.726,105.211,"kake"],[83,85,105.646,105.779,"og"],[86,92,105.779,106.038,"drikke"],[93,97,106.038,106.371,"brus"]],"speaker":"Paul"},{"id":27,"start":108.346,"end":110.071,"text":"Michelle og jeg går på norskkurs.","zh":"米歇尔和我在上挪威语课。","words":[[0,8,108.346,108.858,"michelle"],[9,11,108.858,108.928,"og"],[12,15,108.928,109.111,"jeg"],[16,19,109.126,109.309,"går"],[20,22,109.309,109.451,"på"],[23,32,109.466,110.071,"norskkurs"]],"speaker":"Paul"},{"id":28,"start":110.986,"end":113.951,"text":"Vi må lære mye norsk fordi vi vil jobbe her i landet.","zh":"我们得学很多挪威语，因为我们想在这个国家工作。","words":[[0,2,110.986,111.108,"vi"],[3,5,111.108,111.228,"må"],[6,10,111.228,111.448,"lære"],[11,14,111.448,111.689,"mye"],[15,20,111.689,112.031,"norsk"],[21,26,112.606,112.851,"fordi"],[27,29,112.866,112.988,"vi"],[30,33,112.988,113.151,"vil"],[34,39,113.166,113.439,"jobbe"],[40,43,113.439,113.588,"her"],[44,45,113.588,113.668,"i"],[46,52,113.668,113.951,"landet"]],"speaker":"Paul"},{"id":29,"start":115.006,"end":119.531,"text":"Michelle var sykepleier i Kongo, og hun vil gjerne jobbe som sykepleier her også.","zh":"米歇尔在刚果时是护士，她也很想在这里做护士。","words":[[0,8,115.006,115.458,"michelle"],[9,12,115.458,115.591,"var"],[13,23,115.606,116.279,"sykepleier"],[24,25,116.279,116.349,"i"],[26,31,116.349,116.631,"kongo"],[33,35,117.386,117.499,"og"],[36,39,117.499,117.631,"hun"],[40,43,117.646,117.831,"vil"],[44,50,117.846,118.149,"gjerne"],[51,56,118.149,118.439,"jobbe"],[57,60,118.439,118.589,"som@pa-vei-som-as"],[61,71,118.589,119.118,"sykepleier"],[72,75,119.118,119.298,"her"],[76,80,119.298,119.531,"også"]],"speaker":"Paul"},{"id":30,"start":120.966,"end":122.531,"text":"Hun jobber på et sykehjem i helgene.","zh":"她周末在一家养老院工作。","words":[[0,3,120.966,121.129,"hun"],[4,10,121.129,121.409,"jobber"],[11,13,121.409,121.519,"på"],[14,16,121.519,121.659,"et"],[17,25,121.659,122.089,"sykehjem"],[26,27,122.089,122.168,"i"],[28,35,122.168,122.531,"helgene"]],"speaker":"Paul"},{"id":31,"start":124.08,"end":127.925,"text":"Jeg er arkitekt, men jeg vet ikke om jeg kan bruke utdanningen min her.","zh":"我是建筑师，不过我不知道在这里能否用上自己所学的专业。","words":[[0,3,124.08,124.325,"jeg"],[4,6,124.36,124.502,"er"],[7,15,124.502,125.125,"arkitekt"],[17,20,125.86,126.013,"men"],[21,24,126.013,126.123,"jeg"],[25,28,126.123,126.302,"vet"],[29,33,126.302,126.442,"ikke"],[34,36,126.442,126.523,"om@pa-vei-om-whether"],[37,40,126.523,126.632,"jeg"],[41,44,126.632,126.762,"kan"],[45,50,126.762,127.123,"bruke"],[51,62,127.123,127.593,"utdanningen"],[63,66,127.593,127.752,"min"],[67,70,127.752,127.925,"her"]],"speaker":"Paul"},{"id":32,"start":128.88,"end":129.465,"text":"Jeg håper det.","zh":"我希望可以。","words":[[0,3,128.88,129.032,"jeg"],[4,9,129.032,129.322,"håper"],[10,13,129.322,129.465,"det"]],"speaker":"Paul"},{"id":33,"start":130.3,"end":131.505,"text":"Jeg prøver å være optimist.","zh":"我努力保持乐观。","words":[[0,3,130.3,130.442,"jeg"],[4,10,130.442,130.773,"prøver"],[11,12,130.773,130.852,"å"],[13,17,130.852,131.022,"være"],[18,26,131.022,131.505,"optimist"]],"speaker":"Paul"},{"id":34,"start":135.22,"end":135.945,"text":"17. mai","zh":"五月十七日","words":[[0,2,135.22,135.743,"17"],[4,7,135.743,135.945,"mai"]]},{"id":35,"start":138.06,"end":139.085,"text":"Hei alle sammen!","zh":"大家好！","words":[[0,3,138.06,138.285,"hei"],[4,8,138.44,138.725,"alle"],[9,15,138.74,139.085,"sammen"]]},{"id":36,"start":140.706,"end":143.091,"text":"Neste onsdag er det 17. mai.","zh":"下周三是五月十七日。","words":[[0,5,140.706,141.111,"neste"],[6,12,141.146,141.691,"onsdag"],[13,15,142.046,142.198,"er"],[16,19,142.198,142.351,"det"],[20,22,142.366,142.829,"17"],[24,27,142.829,143.091,"mai"]]},{"id":37,"start":144.346,"end":146.091,"text":"Da er det ikke norskkurs.","zh":"那天没有挪威语课。","words":[[0,2,144.346,144.491,"da"],[3,5,144.646,144.779,"er"],[6,9,144.779,144.931,"det"],[10,14,144.986,145.391,"ikke"],[15,24,145.426,146.091,"norskkurs"]]},{"id":38,"start":147.466,"end":149.811,"text":"Klokka 14.00 er det fest på skolen.","zh":"下午两点，学校将举行庆祝活动。","words":[[0,6,147.466,147.811,"klokka"],[7,12,147.846,148.371,"14.00"],[13,15,148.526,148.659,"er"],[16,19,148.659,148.811,"det"],[20,24,148.846,149.228,"fest"],[25,27,149.228,149.371,"på"],[28,34,149.386,149.811,"skolen"]]},{"id":39,"start":150.906,"end":152.751,"text":"Det blir leker og musikk.","zh":"会有游戏和音乐。","words":[[0,3,150.906,151.059,"det"],[4,8,151.059,151.311,"blir"],[9,14,151.386,151.891,"leker@pa-vei-extra-6"],[15,17,152.106,152.249,"og"],[18,24,152.249,152.751,"musikk"]]},{"id":40,"start":153.906,"end":157.211,"text":"Salg av pølser, is, boller og brus.","zh":"现场出售香肠、冰淇淋、甜