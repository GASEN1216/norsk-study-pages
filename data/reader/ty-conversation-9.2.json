{"id":"ty-conversation-9.2","bookId":"ty-conversation-guide","readingId":"9.2","title":"Booking a flight","audio":"audio/ty-conversation/9.2.mp3","duration":67.813878,"synthetic":false,"sentences":[{"id":0,"start":18.52,"end":20.0,"speaker":"Clerk","text":"Norsk Flyselskap, vær så god?","zh":"这里是挪威航空公司，请问有什么可以帮您的吗？","words":[[0,5,18.52,19.0,"norsk"],[6,16,19.0,19.48,"flyselskap"],[18,21,19.62,19.76,"vær@ty-vær-phone"],[22,24,19.76,19.86,"så@ty-så-phone"],[25,28,19.86,20.0,"god@ty-god-phone"]]},{"id":1,"start":21.04,"end":23.88,"speaker":"Olav","text":"Jeg vil gjerne bestille billett til Bodø i morgen.","zh":"我想订明天去博德的机票。","words":[[0,3,21.04,21.28,"jeg"],[4,7,21.28,21.38,"vil"],[8,14,21.38,21.72,"gjerne"],[15,23,21.72,22.32,"bestille@ty-book-ticket"],[24,31,22.32,22.82,"billett"],[32,35,22.82,23.08,"til"],[36,40,23.08,23.52,"bodø"],[41,42,23.52,23.7,"i@ty-time"],[43,49,23.7,23.88,"morgen"]]},{"id":2,"start":24.3,"end":28.14,"speaker":"Clerk","text":"Du kan få plass på flyet som går klokken sju tretti i morgen.","zh":"您可以订到明天七点半起飞的航班。","words":[[0,2,24.3,24.9,"du"],[3,6,24.9,25.08,"kan"],[7,9,25.08,25.32,"få"],[10,15,25.32,25.62,"plass"],[16,18,25.62,25.8,"på@ty-on-plane"],[19,24,25.8,26.18,"flyet"],[25,28,26.18,26.34,"som"],[29,32,26.34,26.58,"går@ty-flight-departure"],[33,40,26.58,26.96,"klokken"],[41,44,26.96,27.3,"sju"],[45,51,27.3,27.8,"tretti"],[52,53,27.8,27.96,"i@ty-time"],[54,60,27.96,28.14,"morgen"]]},{"id":3,"start":28.68,"end":32.0,"speaker":"Olav","text":"Det er veldig tidlig. Er det et senere fly?","zh":"太早了。有晚一点的航班吗？","words":[[0,3,28.68,28.92,"det@ty-det-time"],[4,6,28.92,29.08,"er@ty-be-description"],[7,13,29.08,29.62,"veldig"],[14,20,29.84,30.0,"tidlig"],[22,24,30.58,31.06,"er@ty-be-existential"],[25,28,31.06,31.16,"det@ty-det-existential"],[29,31,31.16,31.32,"et"],[32,38,31.32,31.76,"senere"],[39,42,31.76,32.0,"fly"]]},{"id":4,"start":32.58,"end":35.26,"speaker":"Clerk","text":"Det er et senere fly, men det er fullt.","zh":"有晚一点的航班，但已经满了。","words":[[0,3,32.58,32.82,"det@ty-det-existential"],[4,6,32.82,33.04,"er@ty-be-existential"],[7,9,33.04,33.26,"et"],[10,16,33.26,33.66,"senere"],[17,20,33.66,33.94,"fly"],[22,25,34.32,34.56,"men"],[26,29,34.56,34.74,"det@ty-det-later-flight"],[30,32,34.74,34.86,"er@ty-be-description"],[33,38,34.86,35.26,"fullt"]]},{"id":5,"start":35.4,"end":39.14,"speaker":"Olav","text":"Da bestiller jeg plass på flyet som går klokken sju tretti.","zh":"那我就订七点半起飞的航班。","words":[[0,2,35.4,35.94,"da"],[3,12,35.94,36.38,"bestiller@ty-book-ticket-present"],[13,16,36.38,36.56,"jeg"],[17,22,36.56,36.9,"plass"],[23,25,36.9,37.04,"på@ty-on-plane"],[26,31,37.04,37.46,"flyet"],[32,35,37.46,37.64,"som"],[36,39,37.64,37.88,"går@ty-flight-departure"],[40,47,37.88,38.46,"klokken"],[48,51,38.46,38.74,"sju"],[52,58,38.74,39.14,"tretti"]]},{"id":6,"start":39.5,"end":42.42,"speaker":"Olav","text":"Er det direkte fly fra Bodø til Bergen?","zh":"从博德到卑尔根有直飞航班吗？","words":[[0,2,39.5,40.4,"er@ty-be-existential"],[3,6,40.4,40.52,"det@ty-det-existential"],[7,14,40.52,40.98,"direkte"],[15,18,40.98,41.32,"fly"],[19,22,41.32,41.62,"fra"],[23,27,41.62,41.96,"bodø"],[28,31,41.96,42.1,"til"],[32,38,42.1,42.42,"bergen"]]},{"id":7,"start":42.98,"end":45.06,"speaker":"Clerk","text":"Nei, du må reise via Trondheim.","zh":"没有，您得经特隆赫姆转机。","words":[[0,3,42.98,43.46,"nei"],[5,7,43.66,43.8,"du"],[8,10,43.8,43.92,"må"],[11,16,43.92,44.32,"reise"],[17,20,44.32,44.58,"via"],[21,30,44.58,45.06,"trondheim"]]},{"id":8,"start":45.1,"end":50.26,"speaker":"Olav","text":"Jeg bestiller billett fra Bodø til Bergen via Trondheim tirsdag kveld.","zh":"我订星期二晚上从博德经特隆赫姆到卑尔根的机票。","words":[[0,3,45.1,45.72,"jeg"],[4,13,45.72,46.18,"bestiller@ty-book-ticket-present"],[14,21,46.18,46.66,"billett"],[22,25,46.66,46.9,"fra"],[26,30,46.9,47.3,"bodø"],[31,34,47.3,47.48,"til"],[35,41,47.48,48.2,"bergen"],[42,45,48.2,48.46,"via"],[46,55,48.46,49.38,"trondheim"],[56,63,49.38,49.94,"tirsdag"],[64,69,49.94,50.26,"kveld"]]},{"id":9,"start":50.62,"end":52.42,"speaker":"Clerk","text":"Flyet går klokken nitten tretti.","zh":"航班十九点三十分起飞。","words":[[0,5,50.62,51.02,"flyet"],[6,9,51.02,51.22,"går@ty-flight-departure"],[10,17,51.22,51.56,"klokken"],[18,24,51.56,51.94,"nitten"],[25,31,51.94,52.42,"tretti"]]},{"id":10,"start":53.08,"end":55.66,"speaker":"Olav","text":"Fint. Jeg betaler med kredittkort.","zh":"好的。我用信用卡付款。","words":[[0,4,53.08,53.46,"fint"],[6,9,54.06,54.34,"jeg"],[10,17,54.34,54.82,"betaler"],[18,21,54.82,55.06,"med@ty-with-card"],[22,33,55.06,55.66,"kredittkort"]]}],"lexicon":{"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-book-ticket":{"lemma":"bestille","zh":"预订（机票）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式","contextual":true,"baseKey":"bestille","surface":"bestille"},"bestiller":{"lemma":"bestille","zh":"预订","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"现在时"},"bestiller@ty-book-ticket-present":{"lemma":"bestille","zh":"预订（机票或座位）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"现在时","contextual":true,"baseKey":"bestiller","surface":"bestiller"},"betaler":{"lemma":"betale","zh":"付款","pos":"动词","ref":"ty-conversation-9-004","clip":null,"form":"现在时"},"billett":{"lemma":"billett","zh":"机票","pos":"名词","ref":"ty-conversation-9-005","clip":null},"bodø":{"lemma":"Bodø","zh":"博德（挪威城市）","pos":"专名","ref":null,"clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-existential":{"lemma":"det","zh":"形式主语（det er：有；本词不单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"det@ty-det-later-flight":{"lemma":"det","zh":"它（指晚一点的航班）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":tr