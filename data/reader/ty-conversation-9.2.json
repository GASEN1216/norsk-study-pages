{"id":"ty-conversation-9.2","bookId":"ty-conversation-guide","readingId":"9.2","title":"Booking a flight","audio":"audio/ty-conversation/9.2.mp3","duration":67.813878,"synthetic":false,"sentences":[{"id":0,"start":18.43,"end":20.015,"speaker":"Clerk","text":"Norsk Flyselskap, vær så god?","zh":"这里是挪威航空公司，请问有什么可以帮您的吗？","words":[[0,5,18.43,18.775,"norsk"],[6,16,18.79,19.535,"flyselskap"],[18,21,19.61,19.733,"vær@ty-vær-phone"],[22,24,19.733,19.843,"så@ty-så-phone"],[25,28,19.843,20.015,"god@ty-god-phone"]]},{"id":1,"start":21.15,"end":24.015,"speaker":"Olav","text":"Jeg vil gjerne bestille billett til Bodø i morgen.","zh":"我想订明天去博德的机票。","words":[[0,3,21.15,21.292,"jeg"],[4,7,21.292,21.402,"vil"],[8,14,21.402,21.715,"gjerne"],[15,23,21.89,22.373,"bestille@ty-book-ticket"],[24,31,22.373,22.835,"billett"],[32,35,22.91,23.095,"til"],[36,40,23.11,23.515,"bodø"],[41,42,23.59,23.703,"i@ty-time"],[43,49,23.703,24.015,"morgen"]]},{"id":2,"start":24.75,"end":28.255,"speaker":"Clerk","text":"Du kan få plass på flyet som går klokken sju tretti i morgen.","zh":"您可以订到明天七点半起飞的航班。","words":[[0,2,24.75,24.895,"du"],[3,6,24.93,25.115,"kan"],[7,9,25.15,25.295,"få"],[10,15,25.35,25.652,"plass"],[16,18,25.652,25.795,"på@ty-on-plane"],[19,24,25.83,26.175,"flyet"],[25,28,26.21,26.392,"som"],[29,32,26.392,26.575,"går@ty-flight-departure"],[33,40,26.59,26.955,"klokken"],[41,44,27.07,27.255,"sju"],[45,51,27.35,27.755,"tretti"],[52,53,27.89,27.983,"i@ty-time"],[54,60,27.983,28.255,"morgen"]]},{"id":3,"start":28.77,"end":31.975,"speaker":"Olav","text":"Det er veldig tidlig. Er det et senere fly?","zh":"太早了。有晚一点的航班吗？","words":[[0,3,28.77,28.953,"det@ty-det-time"],[4,6,28.953,29.095,"er@ty-be-description"],[7,13,29.15,29.633,"veldig"],[14,20,29.633,29.995,"tidlig"],[22,24,30.89,31.043,"er@ty-be-existential"],[25,28,31.043,31.172,"det@ty-det-existential"],[29,31,31.172,31.315,"et"],[32,38,31.35,31.795,"senere"],[39,42,31.81,31.975,"fly"]]},{"id":4,"start":32.67,"end":35.255,"speaker":"Clerk","text":"Det er et senere fly, men det er fullt.","zh":"有晚一点的航班，但已经满了。","words":[[0,3,32.67,32.815,"det@ty-det-existential"],[4,6,32.83,33.055,"er@ty-be-existential"],[7,9,33.09,33.263,"et"],[10,16,33.263,33.695,"senere"],[17,20,33.71,33.895,"fly"],[22,25,34.43,34.593,"men"],[26,29,34.593,34.752,"det@ty-det-later-flight"],[30,32,34.752,34.892,"er@ty-be-description"],[33,38,34.892,35.255,"fullt"]]},{"id":5,"start":35.77,"end":39.135,"speaker":"Olav","text":"Da bestiller jeg plass på flyet som går klokken sju tretti.","zh":"那我就订七点半起飞的航班。","words":[[0,2,35.77,35.915,"da"],[3,12,35.97,36.422,"bestiller@ty-book-ticket-present"],[13,16,36.422,36.595,"jeg"],[17,22,36.65,36.933,"plass"],[23,25,36.933,37.055,"på@ty-on-plane"],[26,31,37.07,37.453,"flyet"],[32,35,37.453,37.655,"som"],[36,39,37.69,37.955,"går@ty-flight-departure"],[40,47,38.11,38.455,"klokken"],[48,51,38.51,38.695,"sju"],[52,58,38.79,39.135,"tretti"]]},{"id":6,"start":40.29,"end":42.435,"speaker":"Olav","text":"Er det direkte fly fra Bodø til Bergen?","zh":"从博德到卑尔根有直飞航班吗？","words":[[0,2,40.29,40.413,"er@ty-be-existential"],[3,6,40.413,40.543,"det@ty-det-existential"],[7,14,40.543,41.055,"direkte"],[15,18,41.07,41.295,"fly"],[19,22,41.41,41.595,"fra"],[23,27,41.67,41.953,"bodø"],[28,31,41.953,42.112,"til"],[32,38,42.112,42.435,"bergen"]]},{"id":7,"start":43.15,"end":45.115,"speaker":"Clerk","text":"Nei, du må reise via Trondheim.","zh":"没有，您得经特隆赫姆转机。","words":[[0,3,43.15,43.395,"nei"],[5,7,43.67,43.812,"du"],[8,10,43.812,43.933,"må"],[11,16,43.933,44.335,"reise"],[17,20,44.37,44.633,"via"],[21,30,44.633,45.115,"trondheim"]]},{"id":8,"start":45.51,"end":50.135,"speaker":"Olav","text":"Jeg bestiller billett fra Bodø til Bergen via Trondheim tirsdag kveld.","zh":"我订星期二晚上从博德经特隆赫姆到卑尔根的机票。","words":[[0,3,45.51,45.692,"jeg"],[4,13,45.692,46.175,"bestiller@ty-book-ticket-present"],[14,21,46.21,46.635,"billett"],[22,25,46.65,46.832,"fra"],[26,30,46.832,47.235,"bodø"],[31,34,47.27,47.435,"til"],[35,41,47.45,47.835,"bergen"],[42,45,48.23,48.463,"via"],[46,55,48.463,48.935,"trondheim"],[56,63,49.49,49.873,"tirsdag"],[64,69,49.873,50.135,"kveld"]]},{"id":9,"start":50.69,"end":52.415,"speaker":"Clerk","text":"Flyet går klokken nitten tretti.","zh":"航班十九点三十分起飞。","words":[[0,5,50.69,51.002,"flyet"],[6,9,51.002,51.215,"går@ty-flight-departure"],[10,17,51.25,51.575,"klokken"],[18,24,51.59,51.955,"nitten"],[25,31,52.07,52.415,"tretti"]]},{"id":10,"start":53.21,"end":55.735,"speaker":"Olav","text":"Fint. Jeg betaler med kredittkort.","zh":"好的。我用信用卡付款。","words":[[0,4,53.21,53.535,"fint"],[6,9,54.23,54.382,"jeg"],[10,17,54.382,54.873,"betaler"],[18,21,54.873,55.075,"med@ty-with-card"],[22,33,55.11,55.735,"kredittkort"]]}],"lexicon":{"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-book-ticket":{"lemma":"bestille","zh":"预订（机票）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式","contextual":true,"baseKey":"bestille","surface":"bestille"},"bestiller":{"lemma":"bestille","zh":"预订","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"现在时"},"bestiller@ty-book-ticket-present":{"lemma":"bestille","zh":"预订（机票或座位）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"现在时","contextual":true,"baseKey":"bestiller","surface":"bestiller"},"betaler":{"lemma":"betale","zh":"付款","pos":"动词","ref":"ty-conversation-9-004","clip":null,"form":"现在时"},"billett":{"lemma":"billett","zh":"机票","pos":"名词","ref":"ty-conversation-9-005","clip":null},"bodø":{"lemma":"Bodø","zh":"博德（挪威城市）","pos":"专名","ref":null,"clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-existential":{"lemma":"det","zh":"形式主语（det er：有；本词不单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":tr