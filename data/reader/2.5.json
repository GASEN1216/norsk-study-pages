{"id":"2.5","title":"Yrkestekst: Jeg er lege","audio":"audio/2.5.mp3","duration":49.01,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.89,"text":"2.5 Yrke: Jeg er lege","heading":true,"zh":"2.5 职业：我是医生","words":[[0,3,0.15,1.18,"2.5"],[4,8,2.5,2.94,"yrke"],[10,13,4.18,4.7,"jeg"],[14,16,4.7,5.16,"er"],[17,21,5.16,5.81,"lege"]]},{"id":1,"start":7.82,"end":9.46,"text":"Jeg er lege.","zh":"我是医生。","words":[[0,3,7.9,8.28,"jeg"],[4,6,8.28,8.7,"er"],[7,11,8.7,9.38,"lege"]]},{"id":2,"start":10.39,"end":17.18,"text":"En lege hjelper syke mennesker og jobber på et sykehus eller et legekontor.","zh":"医生帮助生病的人，在医院或诊所工作。","words":[[0,2,10.47,10.72,"en~a939a9e56dc5"],[3,7,10.72,11.24,"lege"],[8,15,11.24,11.92,"hjelper"],[16,20,11.92,12.42,"syke~67051311b33f"],[21,30,12.42,12.9,"mennesker"],[31,33,12.9,13.64,"og"],[34,40,13.64,13.92,"jobber~003ddb6d77e6"],[41,43,13.92,14.18,"på"],[44,46,14.18,14.34,"et~054dde72f37b"],[47,54,14.34,15.08,"sykehus"],[55,60,15.08,15.66,"eller"],[61,63,15.66,16.18,"et~054dde72f37b"],[64,74,16.18,17.1,"legekontor"]]},{"id":3,"start":18.04,"end":22.07,"text":"Jeg jobber ikke nå, men jeg vil jobbe i Norge.","zh":"我现在没有工作，但我想在挪威工作。","words":[[0,3,18.12,18.41,"jeg"],[4,10,18.41,18.85,"jobber~003ddb6d77e6"],[11,15,18.85,19.07,"ikke"],[16,18,19.07,19.37,"nå~d531d47a7712"],[20,23,20.09,20.25,"men"],[24,27,20.25,20.43,"jeg"],[28,31,20.43,20.75,"vil"],[32,37,20.75,21.19,"jobbe"],[38,39,21.19,21.51,"i"],[40,45,21.51,21.99,"norge~546b56e35dd5"]]},{"id":4,"start":24.6,"end":26.14,"text":"På biblioteket","zh":"在图书馆","words":[[0,2,24.68,24.88,"på"],[3,14,24.88,26.06,"biblioteket"]]},{"id":5,"start":27.65,"end":29.2,"text":"Hva jobber du som?","zh":"你是做什么工作的？","words":[[0,3,27.73,28.12,"hva"],[4,10,28.12,28.58,"jobber~003ddb6d77e6"],[11,13,28.58,28.76,"du"],[14,17,28.76,29.12,"som~90f492b4f2ff"]]},{"id":6,"start":30.12,"end":39.05,"text":"Jeg er lege, men jeg jobber ikke nå. Jeg går på norskkurs. Hva gjør du nå?","speaker":"Yousef","zh":"我是医生，但我现在没有工作。我在上挪威语