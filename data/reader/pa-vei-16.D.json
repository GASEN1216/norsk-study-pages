{"id":"pa-vei-16.D","bookId":"pa-vei-textbook","readingId":"16.D","title":"Svein-Erik går i 10. klasse","audio":"audio/pa-vei/16.D.mp3","duration":148.704,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.2,"end":4.585,"text":"Svein-Erik er 15 år og går på ungdomsskolen.","zh":"斯韦恩·埃里克 15 岁，在上初中。","words":[[0,10,1.2,2.072,"svein-erik"],[11,13,2.072,2.205,"er"],[14,16,2.24,2.725,"15"],[17,19,2.8,3.045,"år"],[20,22,3.42,3.532,"og"],[23,26,3.532,3.703,"går"],[27,29,3.703,3.825,"på"],[30,43,3.86,4.585,"ungdomsskolen"]]},{"id":1,"start":6.08,"end":8.925,"text":"Neste år skal han begynne på videregående skole.","zh":"明年他将进入高中阶段学校。","words":[[0,5,6.08,6.565,"neste"],[6,8,6.6,6.865,"år"],[9,13,7.08,7.262,"skal"],[14,17,7.262,7.393,"han"],[18,25,7.393,7.692,"begynne"],[26,28,7.692,7.825,"på"],[29,41,7.86,8.562,"videregående"],[42,47,8.562,8.925,"skole"]]},{"id":2,"start":10.316,"end":17.821,"text":"Der må elevene velge mellom ulike studieretninger, noen teoretiske og noen mer praktiske.","zh":"在那里，学生必须选择不同的学习方向，有些偏理论，有些更注重实践。","words":[[0,3,10.316,10.579,"der"],[4,6,10.579,10.721,"må"],[7,14,10.756,11.301,"elevene"],[15,20,11.336,11.729,"velge"],[21,27,11.729,12.001,"mellom"],[28,33,12.076,12.501,"ulike"],[34,49,12.596,13.621,"studieretninger"],[51,55,14.516,14.901,"noen"],[56,66,14.956,15.741,"teoretiske"],[67,69,16.456,16.581,"og"],[70,74,16.596,16.919,"noen"],[75,78,16.919,17.121,"mer"],[79,88,17.216,17.821,"praktiske"]]},{"id":3,"start":19.136,"end":22.441,"text":"Han forteller mora, Bente, om planene sine.","zh":"他把自己的计划告诉了母亲本特。","words":[[0,3,19.136,19.301,"han"],[4,13,19.316,19.781,"forteller"],[14,18,19.796,20.161,"mora"],[20,25,20.576,21.121,"bente"],[27,29,21.516,21.661,"om"],[30,37,21.676,22.141,"planene"],[38,42,22.156,22.441,"sine"]]},{"id":4,"start":24.336,"end":27.261,"text":"Nå går snart fristen ut for å søke på plass på videregående.","zh":"申请高中学位的截止日期快到了。","words":[[0,2,24.336,24.461,"nå"],[3,6,24.536,24.689,"går"],[7,12,24.689,24.948,"snart"],[13,20,24.948,25.338,"fristen"],[21,23,25.338,25.488,"ut"],[24,27,25.488,25.618,"for"],[28,29,25.618,25.699,"å"],[30,34,25.699,26.061,"søke"],[35,37,26.076,26.201,"på"],[38,43,26.216,26.509,"plass"],[44,46,26.509,26.639,"på"],[47,59,26.639,27.261,"videregående"]],"speaker":"Svein-Erik"},{"id":5,"start":28.196,"end":29.941,"text":"Jeg har tenkt å søke på elektrofag.","zh":"我打算申请电气专业。","words":[[0,3,28.196,28.319,"jeg"],[4,7,28.319,28.461,"har"],[8,13,28.476,28.788,"tenkt"],[14,15,28.788,28.879,"å"],[16,20,28.879,29.169,"søke"],[21,23,29.169,29.298,"på"],[24,34,29.298,29.941,"elektrofag"]],"speaker":"Svein-Erik"},{"id":6,"start":31.02,"end":35.405,"text":"Elektrofag? Skal ikke du bli advokat, da?","zh":"电气专业？你不是要当律师吗？","words":[[0,10,31.02,32.265,"elektrofag"],[12,16,33.78,34.005,"skal"],[17,21,34.04,34.252,"ikke"],[22,24,34.252,34.365,"du"],[25,28,34.38,34.562,"bli"],[29,36,34.562,35.272,"advokat"],[38,40,35.272,35.405,"da"]],"speaker":"Bente"},{"id":7,"start":36.44,"end":40.365,"text":"Nei, det er bare pappa som sier det. Jeg har lyst til å bli elektriker.","zh":"不是，那只是爸爸说的。我想当电工。","words":[[0,3,36.44,36.725,"nei"],[5,8,36.88,37.013,"det"],[9,11,37.013,37.102,"er"],[12,16,37.102,37.305,"bare"],[17,22,37.32,37.725,"pappa"],[23,26,37.76,37.922,"som"],[27,31,37.922,38.222,"sier"],[32,35,38.222,38.365,"det"],[37,40,39.1,39.242,"jeg"],[41,44,39.242,39.362,"har"],[45,49,39.362,39.523,"lyst@pa-vei-lyst-desire"],[50,53,39.523,39.612,"til"],[54,55,39.612,39.663,"å"],[56,59,39.663,39.772,"bli"],[60,70,39.772,40.365,"elektriker"]],"speaker":"Svein-Erik"},{"id":8,"start":41.3,"end":42.825,"text":"Men vil du ikke studere, da?","zh":"可是你不想上大学吗？","words":[[0,3,41.3,41.465,"men"],[4,7,41.48,41.642,"vil"],[8,10,41.642,41.752,"du"],[11,15,41.752,41.962,"ikke"],[16,23,41.962,42.683,"studere"],[25,27,42.683,42.825,"da"]],"speaker":"Bente"},{"id":9,"start":44.136,"end":45.981,"text":"Nei, jeg er lei av teori!","zh":"不想，我已经厌烦理论了！","words":[[0,3,44.136,44.461,"nei"],[5,8,44.916,45.099,"jeg"],[9,11,45.099,45.218,"er"],[12,15,45.218,45.441,"lei"],[16,18,45.496,45.629,"av"],[19,24,45.629,45.981,"teori"]],"speaker":"Svein-Erik"},{"id":10,"start":46.656,"end":50.761,"text":"Det er så mange kjedelige fag på skolen, og jeg orker ikke mer av det.","zh":"学校有那么多无聊的科目，我实在受不了了。","words":[[0,3,46.656,46.821,"det"],[4,6,46.896,47.201,"er"],[7,9,47.256,47.401,"så"],[10,15,47.476,47.761,"mange"],[16,25,47.816,48.308,"kjedelige"],[26,29,48.308,48.528,"fag"],[30,32,48.528,48.639,"på"],[33,39,48.639,49.021,"skolen"],[41,43,49.436,49.558,"og"],[44,47,49.558,49.701,"jeg"],[48,53,49.776,50.178,"orker"],[54,58,50.178,50.379,"ikke"],[59,62,50.379,50.538,"mer"],[63,65,50.538,50.639,"av"],[66,69,50.639,50.761,"det"]],"speaker":"Svein-Erik"},{"id":11,"start":52.156,"end":56.381,"text":"Hvis du jobber litt mer med skolearbeidet, vil det gå mye bedre!","zh":"如果你在功课上再用功一点，情况就会好很多！","words":[[0,4,52.156,52.421,"hvis"],[5,7,52.436,52.561,"du"],[8,14,52.616,53.001,"jobber"],[15,19,53.116,53.461,"litt"],[20,23,53.516,53.761,"mer"],[24,27,53.776,53.928,"med"],[28,41,53.928,54.701,"skolearbeidet"],[43,46,55.016,55.201,"vil"],[47,50,55.216,55.358,"det"],[51,53,55.358,55.501,"gå"],[54,57,55.696,55.998,"mye"],[58,63,55.998,56.381,"bedre@pa-vei-extra-136"]],"speaker":"Bente"},{"id":12,"start":57.256,"end":63.441,"text":"Se på søstra di. Hun jobber ordentlig på skolen og får toppkarakter i alle fag.","zh":"看看你姐姐，她在学校认真学习，各科都拿最高分。","words":[[0,2,57.256,57.421,"se"],[3,5,57.456,57.569,"på"],[6,12,57.569,57.959,"søstra"],[13,15,57.959,58.101,"di"],[17,20,58.976,59.241,"hun"],[21,27,59.396,59.801,"jobber"],[28,37,59.956,60.439,"ordentlig@pa-vei-extra-139"],[38,40,60.439,60.558,"på"],[41,47,60.558,60.961,"skolen"],[48,50,61.056,61.201,"og"],[51,54,61.276,61.521,"får"],[55,67,61.656,62.621,"toppkarakter"],[68,69,62.656,62.761,"i"],[70,74,62.836,63.118,"alle"],[75,78,63.118,63.441,"fag"]],"speaker":"Bente"},{"id":13,"start":64.436,"end":67.661,"text":"Hun kan studere akkurat hva hun vil etter skolen.","zh":"中学毕业后，她想学什么专业都可以。","words":[[0,3,64.436,64.621,"hun"],[4,7,64.656,64.841,"kan"],[8,15,64.856,65.321,"studere"],[16,23,65.516,66.118,"akkurat"],[24,27,66.118,66.258,"hva"],[28,31,66.258,66.418,"hun"],[32,35,66.418,66.601,"vil"],[36,41,67.016,67.288,"etter"],[42,48,67.288,67.661,"skolen"]],"speaker":"Bente"},{"id":14,"start":68.816,"end":71.801,"text":"Ja, men Silje er et skolelys! Det vet du jo!","zh":"是啊，可西尔耶是个学霸！这你也知道！","words":[[0,2,68.816,68.981,"ja"],[4,7,69.196,69.361,"men"],[8,13,69.416,69.749,"silje"],[14,16,69.749,69.858,"er"],[17,19,69.858,70.018,"et"],[20,28,70.018,70.781,"skolelys"],[30,33,71.096,71.258,"det"],[34,37,71.258,71.558,"vet"],[38,40,71.558,71.659,"du"],[41,43,71.659,71.801,"jo"]],"speaker":"Svein-Erik"},{"id":15,"start":72.676,"end":75.621,"text":"Jeg liker ikke å lese, og jeg har ikke lyst til å studere.","zh":"我不喜欢读书，也不想上大学。","words":[[0,3,72.676,72.839,"jeg"],[4,9,72.839,73.159,"liker"],[10,14,73.159,73.338,"ikke"],[15,16,73.338,73.409,"å"],[17,21,73.409,73.781,"lese"],[23,25,74.276,74.388,"og"],[26,29,74.388,74.508,"jeg"],[30,33,74.508,74.668,"har"],[34,38,74.668,74.858,"ikke"],[39,43,74.858,74.988,"lyst@pa-vei-lyst-desire"],[44,47,74.988,75.099,"til"],[48,49,75.099,75.159,"å"],[50,57,75.159,75.621,"studere"]],"speaker":"Svein-Erik"},{"id":16,"start":76.216,"end":77.621,"text":"Jeg vil heller gjøre noe praktisk.","zh":"我更想做一些实际的事情。","words":[[0,3,76.216,76.358,"jeg"],[4,7,76.358,76.469,"vil"],[8,14,76.469,76.698,"heller"],[15,20,76.698,76.909,"gjøre"],[21,24,76.909,77.058,"noe"],[25,33,77.058,77.621,"praktisk@pa-vei-extra-137"]],"speaker":"Svein-Erik"},{"id":17,"start":78.876,"end":84.321,"text":"Men hva med framtida? Vil du ikke ha en god jobb med høy lønn?","zh":"可是将来怎么办？你不想找一份薪水高的好工作吗？","words":[[0,3,78.876,79.038,"men"],[4,7,79.038,79.221,"hva"],[8,11,79.236,79.421,"med"],[12,20,79.456,80.161,"framtida"],[22,25,81.636,81.821,"vil"],[26,28,81.876,81.999,"du"],[29,33,81.999,82.228,"ikke"],[34,36,82.228,82.361,"ha"],[37,39,82.436,82.581,"en"],[40,43,82.616,82.921,"god"],[44,48,83.016,83.361,"jobb"],[49,52,83.456,83.621,"med"],[53,56,83.676,83.901,"høy"],[57,61,84.016,84.321,"lønn"]],"speaker":"Bente"},{"id":18,"start":85.536,"end":89.101,"text":"Jo da. Men elektrikere kan jo tjene bra, de?","zh":"当然想。不过电工也可以挣得不错，不是吗？","words":[[0,2,85.536,85.721,"jo"],[3,5,85.836,85.981,"da"],[7,10,86.816,87.041,"men"],[11,22,87.416,88.081,"elektrikere"],[23,26,88.116,88.298,"kan"],[27,29,88.298,88.409,"jo"],[30,35,88.409,88.701,"tjene"],[36,39,88.716,88.901,"bra"],[41,43,88.956,89.101,"de"]],"speaker":"Svein-Erik"},{"id":19,"start":89.996,"end":94.841,"text":"Og jeg vil mye heller gjøre noe som jeg liker enn å sitte på et trangt kontor hele dagen!","zh":"而且我宁愿做自己喜欢的事，也不想整天坐在狭小的办公室里！","words":[[0,2,89.996,90.099,"og"],[3,6,90.099,90.219,"jeg"],[7,10,90.219,90.361,"vil"],[11,14,90.456,90.901,"mye"],[15,21,90.916,91.221,"heller"],[22,27,91.236,91.518,"gjøre"],[28,31,91.518,91.698,"noe"],[32,35,91.698,91.809,"som"],[36,39,91.809,91.961,"jeg"],[40,45,91.976,92.481,"liker"],[46,49,92.516,92.698,"enn"],[50,51,92.698,92.779,"å"],[52,57,92.779,93.089,"sitte"],[58,60,93.089,93.209,"på"],[61,63,93.209,93.309,"et"],[64,70,93.309,93.638,"trangt@pa-vei-extra-138"],[71,77,93.638,94.001,"kontor"],[78,82,94.036,94.421,"hele"],[83,88,94.436,94.841,"dagen"]],"speaker":"Svein-Erik"},{"id":20,"start":96.676,"end":100.461,"text":"Dette liker jeg ikke. Det er helt nytt for meg.","zh":"我不喜欢这个想法。我从来没听你提过。","words":[[0,5,96.676,97.061,"dette"],[6,11,97.096,97.439,"liker"],[12,15,97.439,97.538,"jeg"],[16,20,97.538,97.761,"ikke"],[22,25,99.316,99.448,"det"],[26,28,99.448,99.561,"er"],[29,33,99.596,99.959,"helt"],[34,38,99.959,100.168,"nytt"],[39,42,100.168,100.299,"for"],[43,46,100.299,100.461,"meg"]],"speaker":"Bente"},{"id":21,"start":102.876,"end":104.881,"text":"Vi må snakke med pappa om det når han kommer hjem.","zh":"等爸爸回家，我们得和他谈谈。","words":[[0,2,102.876,102.999,"vi"],[3,5,102.999,103.141,"må"],[6,12,103.176,103.489,"snakke"],[13,16,103.489,103.638,"med"],[17,22,103.638,103.928,"pappa"],[23,25,103.928,104.059,"om"],[26,29,104.059,104.209,"det"],[30,33,104.209,104.349,"når@pa-vei-når-when"],[34,37,104.349,104.469,"han"],[38,44,104.469,104.708,"kommer"],[45,49,104.708,104.881,"hjem"]],"speaker":"Bente"},{"id":22,"start":106.256,"end":111.341,"text":"Og i neste uke er det konferansetime. Da kan jeg snakke med læreren din.","zh":"下星期还有家校面谈，到时我可以和你老师谈谈。","words":[[0,2,106.256,106.388,"og"],[3,4,106.388,106.478,"i"],[5,10,106.478,106.821,"neste"],[11,14,106.836,107.141,"uke"],[15,17,107.536,107.649,"er"],[18,21,107.649,107.758,"det"],[22,36,107.758,108.601,"konferansetime"],[38,40,109.736,109.881,"da"],[41,44,109.916,110.089,"kan"],[45,48,110.089,110.228,"jeg"],[49,55,110.228,110.569,"snakke"],[56,59,110.569,110.719,"med"],[60,67,110.719,111.099,"læreren"],[68,71,111.099,111.341,"din"]],"speaker":"Bente"},{"id":23,"start":112.436,"end":113.941,"text":"Jeg lurer på hva han mener.","zh":"我想知道他怎么看。","words":[[0,3,112.436,112.621,"jeg"],[4,9,112.636,112.978,"lurer"],[10,12,112.978,113.101,"på"],[13,16,113.136,113.301,"hva"],[17,20,113.336,113.521,"han"],[21,26,113.556,113.941,"mener"]],"speaker":"Bente"},{"id":24,"start":116.736,"end":117.421,"text":"Sammendrag.","zh":"摘要","words":[[0,10,116.736,117.421,"sammendrag"]]},{"id":25,"start":118.886,"end":125.111,"text":"Svein-Erik har lyst til å bli elektriker, men foreldrene hans vil at han skal bli advokat.","zh":"斯韦恩·埃里克想当电工，但父母希望他当律师。","words":[[0,10,118.886,119.751,"svein-erik"],[11,14,119.886,120.038,"har"],[15,19,120.038,120.298,"lyst@pa-vei-lyst-desire"],[20,23,120.298,120.448,"til"],[24,25,120.448,120.538,"å"],[26,29,120.538,120.691,"bli"],[30,40,120.826,121.551,"elektriker"],[42,45,122.586,122.771,"men"],[46,56,122.826,123.451,"foreldrene"],[57,61,123.466,123.758,"hans"],[62,65,123.758,123.909,"vil"],[66,68,123.909,124.038,"at"],[69,72,124.038,124.159,"han"],[73,77,124.159,124.328,"skal"],[78,81,124.328,124.491,"bli"],[82,89,124.506,125.111,"advokat"]]},{"id":26,"start":126.746,"end":129.111,"text":"Svein-Erik sier at han ikke vil studere.","zh":"斯韦恩·埃里克说他不想上大学。","words":[[0,10,126.746,127.491,"svein-erik"],[11,15,127.506,127.819,"sier"],[16,18,127.819,127.928,"at"],[19,22,127.928,128.069,"han"],[23,27,128.069,128.329,"ikke"],[28,31,128.329,128.511,"vil"],[32,39,128.606,129.111,"studere"]]},{"id":27,"start":130.436,"end":133.241,"text":"Han synes at de teoretiske fagene er kjedelige.","zh":"他觉得理论科目很无聊。","words":[[0,3,130.436,130.641,"han"],[4,9,130.716,131.108,"synes"],[10,12,131.108,131.238,"at"],[13,15,131.238,131.341,"de@pa-vei-de-definite"],[16,26,131.376,132.138,"teoretiske"],[27,33,132.138,132.548,"fagene"],[34,36,132.548,132.681,"er"],[37,46,132.736,133.241,"kjedelige"]]},{"id":28,"start":135.116,"end":139.961,"text":"Mora hans tror at han kan bli flinkere på skolen hvis han jobber mer med leksene.","zh":"母亲认为，如果他在作业上多下功夫，学习成绩就能提高。","words":[[0,4,135.116,135.521,"mora"],[5,9,135.536,135.881,"hans"],[10,14,135.916,136.321,"tror"],[15,17,136.376,136.498,"at"],[18,21,136.498,136.629,"han"],[22,25,136.629,136.769,"kan"],[26,29,136.769,136.921,"bli"],[30,38,136.976,137.499,"flinkere"],[39,41,137.499,137.641,"på"],[42,48,137.656,138.141,"skolen"],[49,53,138.316,138.519,"hvis"],[54,57,138.519,138.661,"han"],[58,64,138.676,139.021,"jobber"],[65,68,139.076,139.379,"mer"],[69,72,139.379,139.519,"med"],[73,80,139.519,139.961,"leksene"]]},{"id":29,"start":141.496,"end":146.881,"text":"Hun vil diskutere Svein-Eriks utdanning med samboeren sin og med læreren til Svein-Erik.","zh":"她想和自己的伴侣以及斯韦恩·埃里克的老师讨论他的教育问题。","words":[[0,3,141.496,141.681,"hun"],[4,7,141.696,141.841,"vil"],[8,17,141.856,142.581,"diskutere"],[18,29,142.596,143.301,"svein-eriks"],[30,39,143.336,143.839,"utdanning"],[40,43,143.839,143.999,"med"],[44,53,143.999,144.558,"samboeren"],[54,57,144.558,144.781,"sin"],[58,60,145.356,145.478,"og"],[61,64,145.478,145.638,"med"],[65,72,145.638,146.108,"læreren"],[73,76,146.108,146.261,"til"],[77