{"id":"9.5","title":"Yrkestekst: Jeg er snekker","audio":"audio/9.5.mp3","duration":54.61,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.26,"text":"9.5 Yrke: Jeg er snekker","heading":true,"zh":"9.5 职业：我是木匠","words":[[0,3,0.15,1.14,"9.5"],[4,8,2.16,2.6,"yrke"],[10,13,3.65,4.13,"jeg"],[14,16,4.13,4.49,"er"],[17,24,4.49,5.18,"snekker"]]},{"id":1,"start":7.58,"end":10.23,"text":"Jeg heter Marek og er snekker.","zh":"我叫马雷克，是一名木匠。","words":[[0,3,7.64,8.08,"jeg"],[4,9,8.08,8.54,"heter"],[10,15,8.54,9.22,"marek"],[16,18,9.22,9.34,"og"],[19,21,9.34,9.56,"er"],[22,29,9.56,10.08,"snekker"]]},{"id":2,"start":11.36,"end":13.79,"text":"Jeg jobbet som snekker i Polen.","zh":"我在波兰当过木匠。","words":[[0,3,11.42,11.74,"jeg"],[4,10,11.74,12.1,"jobbet"],[11,14,12.1,12.34,"som~ac9866165f47"],[15,22,12.34,13.02,"snekker"],[23,24,13.12,13.24,"i"],[25,30,13.24,13.64,"polen~488e57c60a08"]]},{"id":3,"start":15.03,"end":18.84,"text":"Der laget jeg kjøkkeninnredninger og trapper.","zh":"在那里我做过整体橱柜和楼梯。","words":[[0,3,15.09,15.46,"der"],[4,9,15.46,15.88,"laget~f1b55d77a255"],[10,13,15.88,16.34,"jeg"],[14,33,16.34,17.83,"kjøkkeninnredninger"],[34,36,18.04,18.2,"og"],[37,44,18.2,18.7,"trapper"]]},{"id":4,"start":19.92,"end":24.85,"text":"Nå har jeg fått fast jobb som snekker i et byggefirma i Norge.","zh":"现在我在挪威一家建筑公司找到了一份木匠的固定工作。","words":[[0,2,19.98,20.33,"nå~d531d47a7712"],[3,6,20.46,20.6,"har~8b9792170cca"],[7,10,20.6,20.74,"jeg"],[11,15,20.74,21.04,"fått"],[16,20,21.04,21.46,"fast"],[21,25,21.46,21.96,"jobb"],[26,29,21.96,22.18,"som~ac9866165f47"],[30,37,22.18,22.83,"snekker"],[38,39,23.0,23.08,"i"],[40,42,23.08,23.28,"et~054dde72f37b"],[43,53,23.28,24.13,"byggefirma"],[54,55,24.24,24.34,"i"],[56,61,24.34,24.7,"norge~546b56e35dd5"]]},{"id":5,"start":25.98,"end":30.8,"text":"Der reparerer jeg gamle hus og monterer kjøkkeninnredninger.","zh":"在那里我修理老房子，安装整体橱柜。","words":[[0,3,26.04,26.6,"der"],[4,13,26.6,27.28,"reparerer"],[14,17,27.28,27.52,"jeg"],[18,23,27.52,27.92,"gamle"],[24,27,27.92,28.54,"hus"],[28,30,28.54,28.66,"og"],[31,39,28.66,29.34,"monterer"],[40,59,29.34,30.66,"kjøkkeninnredninger"]]},{"id":6,"start":33.97,"end":36.22,"text":"Ewa og Marek pusser opp.","zh":"埃娃和马雷克在装修。","words":[[0,3,34.03,34.56,"ewa"],[4,6,34.56,34.7,"og"],[7,12,34.7,35.26,"marek"],[13,19,35.26,35.66,"pusser"],[20,23,35.66,36.07,"opp~10d7fedbe51f"]]},{"id":7,"start":37.8,"end":39.48,"text":"Hvor er hammeren, Marek?","speaker":"Ewa","zh":"锤子在哪儿，马雷克？","words":[[0,4,37.86,38.1,"hvor"],[5,7,38.1,38.28,"er"],[8,16,38.28,38.74,"hammeren"],[18,23,38.74,39.33,"marek"]]},{"id":8,"start":40.7,"end":43.74,"text":"Den ligger der borte ved siden av esken med spikere.","speaker":"Marek","zh":"它在那边，在装钉子的盒子旁边。","words":[[0,3,40.76,40.94,"den"],[4,10,40.94,41.24,"ligger"],[11,14,41.24,41.44,"der"],[15,20,41.44,41.78,"borte~03e4cd568943"],[21,24,41.78,41.94,"ved"],[25,30,41.94,42.26,"siden~68789c658db2"],[31,33,42.26,42.4,"av~38cf00d29ad7"],[34,39,42.4,42.82,"esken"],[40,43,42.82,42.98,"med~1c1ccb1b4bb9"],[44,51,42.98,43.59,"spikere"]]},{"id":9,"start":44.75,"end":50.68,"text":"Å, ja. Kan du hjelpe meg med å slå sammen disse plankene? Jeg klarer det ikke alene.","speaker":"Ewa","zh":"哦，对。你能帮我把这些木板钉在一起吗？我一个人做不来。","words":[[0,1,44.81,44.96,"å~496a48c13525"],[3,5,44.96,45.3,"ja"],[7,10,45.8,46.04,"kan"],[11,13,46.04,46.32,"du"],[14,20,46.32,46.8,"hjelpe"],[21,24,46.8,47.06,"meg"],[25,28,47.06,47.2,"med~0cacd71903f3"],[29,30,47.2,47.3,"å~0583da7a620a"],[31,34,47.3,47.56,"slå~fcb9d7ee5671"],[35,41,47.56,47.86,"sammen"],[42,47,47.86,48.14,"disse"],[48,56,48.14,48.8,"plankene"],[58,61,49.24,49.4,"jeg"],[62,68,49.4,49.74,"klarer"],[69,72,49.74,49.82,"det"],[73,77,49.82,49.98,"ikke"],[78,83,49.98,50.53,"alene"]]},{"id":10,"start":51.52,"end":53.87,"text":"Selvfølgelig. Jeg kommer!","speaker":"Marek","zh":"当然。我来了！","words":[[0,12,51.58,52.59,"selvfølgelig"],[14,17,53.12,53.36,"jeg"],[18,24,53.36,53.72,"kommer"]]}],"lexicon":{"9.5":{"lemma":"9.5","zh":"第 9.5 节","pos":"编号","ref":null,"clip":nu