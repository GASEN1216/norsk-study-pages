{"id":"9.5","title":"Yrkestekst: Jeg er snekker","audio":"audio/9.5.mp3","duration":54.61,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.26,"text":"9.5 Yrke: Jeg er snekker","heading":true,"zh":"9.5 职业：我是木匠","words":[[0,3,0.15,1.14,"9.5"],[4,8,2.16,2.6,"yrke"],[10,13,3.65,4.13,"jeg"],[14,16,4.13,4.49,"er"],[17,24,4.49,5.18,"snekker"]]},{"id":1,"start":7.54,"end":10.17,"text":"Jeg heter Marek og er snekker.","zh":"我叫马雷克，是一名木匠。","words":[[0,3,7.62,8.02,"jeg"],[4,9,8.02,8.42,"heter"],[10,15,8.42,9.02,"marek"],[16,18,9.02,9.3,"og"],[19,21,9.3,9.44,"er"],[22,29,9.44,10.09,"snekker"]]},{"id":2,"start":11.34,"end":13.71,"text":"Jeg jobbet som snekker i Polen.","zh":"我在波兰当过木匠。","words":[[0,3,11.42,11.65,"jeg"],[4,10,11.65,12.01,"jobbet"],[11,14,12.01,12.23,"som~ac9866165f47"],[15,22,12.23,12.85,"snekker"],[23,24,12.85,13.17,"i"],[25,30,13.17,13.63,"polen~488e57c60a08"]]},{"id":3,"start":13.93,"end":18.48,"text":"Der laget jeg kjøkkeninnredninger og trapper.","zh":"在那里我做过整体橱柜和楼梯。","words":[[0,3,14.7,15.3,"der"],[4,9,15.3,15.8,"laget~f1b55d77a255"],[10,13,15.8,16.0,"jeg"],[14,33,16.0,17.72,"kjøkkeninnredninger"],[34,36,17.72,18.1,"og"],[37,44,18.1,18.4,"trapper"]]},{"id":4,"start":19.81,"end":24.79,"text":"Nå har jeg fått fast jobb som snekker i et byggefirma i Norge.","zh":"现在我在挪威一家建筑公司找到了一份木匠的固定工作。","words":[[0,2,19.89,20.22,"nå~d531d47a7712"],[3,6,20.22,20.56,"har~8b9792170cca"],[7,10,20.56,20.68,"jeg"],[11,15,20.68,20.86,"fått"],[16,20,20.86,21.26,"fast"],[21,25,21.26,21.7,"jobb"],[26,29,21.7,22.08,"som~ac9866165f47"],[30,37,22.08,22.66,"snekker"],[38,39,22.66,23.06,"i"],[40,42,23.06,23.18,"et~054dde72f37b"],[43,53,23.18,23.9,"byggefirma"],[54,55,23.9,24.3,"i"],[56,61,24.3,24.71,"norge~546b56e35dd5"]]},{"id":5,"start":25.95,"end":30.75,"text":"Der reparerer jeg gamle hus og monterer kjøkkeninnredninger.","zh":"在那里我修理老房子，安装整体橱柜。","words":[[0,3,26.03,26.34,"der"],[4,13,26.34,27.2,"reparerer"],[14,17,27.2,27.38,"jeg"],[18,23,27.38,27.86,"gamle"],[24,27,27.86,28.18,"hus"],[28,30,28.18,28.6,"og"],[31,39,28.6,29.24,"monterer"],[40,59,29.24,30.67,"kjøkkeninnredninger"]]},{"id":6,"start":33.93,"end":36.16,"text":"Ewa og Marek pusser opp.","zh":"埃娃和马雷克在装修。","words":[[0,3,34.01,34.37,"ewa"],[4,6,34.37,34.65,"og"],[7,12,34.65,35.17,"marek"],[13,19,35.17,35.59,"pusser"],[20,23,35.59,36.08,"opp~10d7fedbe51f"]]},{"id":7,"start":37.76,"end":39.42,"text":"Hvor er hammeren, Marek?","speaker":"Ewa","zh":"锤子在哪儿，马雷克？","words":[[0,4,37.84,38.0,"hvor"],[5,7,38.0,38.2,"er"],[8,16,38.2,38.68,"hammeren"],[18,23,38.7,39.34,"marek"]]},{"id":8,"start":40.65,"end":43.67,"text":"Den ligger der borte ved siden av esken med spikere.","speaker":"Marek","zh":"它在那边，在装钉子的盒子旁边。","words":[[0,3,40.73,40.86,"den"],[4,10,40.86,41.06,"ligger"],[11,14,41.06,41.36,"der"],[15,20,41.36,41.7,"borte~03e4cd568943"],[21,24,41.7,41.86,"ved"],[25,30,41.86,42.14,"siden~68789c658db2"],[31,33,42.14,42.34,"av~38cf00d29ad7"],[34,39,42.34,42.74,"esken"],[40,43,42.74,42.9,"med~1c1ccb1b4bb9"],[44,51,42.9,43.59,"spikere"]]},{"id":9,"start":44.72,"end":50.63,"text":"Å, ja. Kan du hjelpe meg med å slå sammen disse plankene? Jeg klarer det ikke alene.","speaker":"Ewa","zh":"哦，对。你能帮我把这些木板钉在一起吗？我一个人做不来。","words":[[0,1,44.8,44.94,"å~496a48c13525"],[3,5,44.94,45.12,"ja"],[7,10,45.7,45.96,"kan"],[11,13,45.96,46.22,"du"],[14,20,46.22,46.72,"hjelpe"],[21,24,46.72,46.96,"meg"],[25,28,46.96,47.12,"med~0cacd71903f3"],[29,30,47.12,47.26,"å~0583da7a620a"],[31,34,47.26,47.5,"slå~fcb9d7ee5671"],[35,41,47.5,47.82,"sammen"],[42,47,47.82,48.02,"disse"],[48,56,48.02,48.58,"plankene"],[58,61,49.1,49.34,"jeg"],[62,68,49.34,49.76,"klarer"],[69,72,49.76,49.84,"det"],[73,77,49.84,49.94,"ikke"],[78,83,49.94,50.55,"alene"]]},{"id":10,"start":51.47,"end":53.8,"text":"Selvfølgelig. Jeg kommer!","speaker":"Marek","zh":"当然。我来了！","words":[[0,12,51.55,52.4,"selvfølgelig"],[14,17,53.0,53.24,"jeg"],[18,24,53.24,53.72,"kommer"]]}],"lexicon":{"9.5":{"lemma":"9.5","zh":"第 9.5 节","pos":"编号","ref":null,"clip":null,"kind