{"id":"pa-vei-16.A","bookId":"pa-vei-textbook","readingId":"16.A","title":"Javed skal begynne i barnehagen","audio":"audio/pa-vei/16.A.mp3","duration":145.272,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.1,"end":5.525,"text":"Amira har en sønn som er litt over ett år gammel.","zh":"阿米拉有一个一岁多的儿子。","words":[[0,5,1.1,1.665,"amira"],[6,9,1.78,2.005,"har"],[10,12,2.02,2.165,"en"],[13,17,2.28,2.625,"sønn"],[18,21,3.36,3.542,"som"],[22,24,3.542,3.725,"er"],[25,29,3.8,4.105,"litt"],[30,34,4.16,4.465,"over"],[35,38,4.62,4.945,"ett"],[39,41,5.0,5.205,"år"],[42,48,5.22,5.525,"gammel"]]},{"id":1,"start":6.86,"end":8.265,"text":"Han heter Javed.","zh":"他叫贾韦德。","words":[[0,3,6.86,7.085,"han"],[4,9,7.18,7.605,"heter"],[10,15,7.68,8.265,"javed"]]},{"id":2,"start":10.0,"end":12.205,"text":"Nå er hun ute i parken med ham.","zh":"现在，她正和他在公园里。","words":[[0,2,10.0,10.145,"nå"],[3,5,10.38,10.582,"er"],[6,9,10.582,10.765,"hun"],[10,13,10.9,11.262,"ute"],[14,15,11.262,11.365,"i"],[16,22,11.4,11.893,"parken"],[23,26,11.893,12.033,"med"],[27,30,12.033,12.205,"ham"]]},{"id":3,"start":13.588,"end":15.213,"text":"Der leker han med Stina.","zh":"他在那里和斯蒂娜一起玩。","words":[[0,3,13.588,13.893,"der"],[4,9,13.948,14.361,"leker"],[10,13,14.361,14.53,"han"],[14,17,14.53,14.693,"med"],[18,23,14.708,15.213,"stina"]]},{"id":4,"start":16.888,"end":19.533,"text":"Stina er også omtrent ett år.","zh":"斯蒂娜也大约一岁。","words":[[0,5,16.888,17.333,"stina"],[6,8,17.408,17.593,"er"],[9,13,17.668,18.033,"også"],[14,21,18.188,18.793,"omtrent"],[22,25,18.888,19.173,"ett"],[26,28,19.268,19.533,"år"]]},{"id":5,"start":21.008,"end":24.573,"text":"Hun er dattera til Amiras nabo, Heidi.","zh":"她是阿米拉的邻居海蒂的女儿。","words":[[0,3,21.008,21.233,"hun"],[4,6,21.388,21.613,"er"],[7,14,21.648,22.133,"dattera"],[15,18,22.228,22.413,"til"],[19,25,22.488,23.17,"amiras"],[26,30,23.17,23.633,"nabo"],[32,37,24.128,24.573,"heidi"]]},{"id":6,"start":26.888,"end":32.053,"text":"Amira og Heidi sitter og prater mens de holder øye med barna sine.","zh":"阿米拉和海蒂一边坐着聊天，一边照看自己的孩子。","words":[[0,5,26.888,27.453,"amira"],[6,8,27.548,27.673,"og"],[9,14,27.708,28.173,"heidi"],[15,21,28.308,28.651,"sitter"],[22,24,28.651,28.773,"og"],[25,31,28.788,29.333,"prater"],[32,36,30.028,30.34,"mens"],[37,39,30.34,30.453,"de"],[40,46,30.468,30.773,"holder@pa-vei-extra-107"],[47,50,30.848,31.193,"øye"],[51,54,31.228,31.381,"med"],[55,60,31.381,31.713,"barna"],[61,65,31.748,32.053,"sine"]]},{"id":7,"start":34.208,"end":36.393,"text":"I morgen skal Javed begynne i barnehagen.","zh":"贾韦德明天要开始上幼儿园了。","words":[[0,1,34.208,34.313,"i"],[2,8,34.348,34.671,"morgen"],[9,13,34.671,34.891,"skal"],[14,19,34.891,35.361,"javed"],[20,27,35.361,35.651,"begynne"],[28,29,35.651,35.73,"i"],[30,40,35.73,36.393,"barnehagen"]],"speaker":"Amira"},{"id":8,"start":36.968,"end":39.753,"text":"Skal han? Det blir spennende.","zh":"是吗？这会是令人期待的新体验。","words":[[0,4,36.968,37.333,"skal"],[5,8,37.428,37.613,"han"],[10,13,38.868,39.053,"det"],[14,18,39.068,39.291,"blir"],[19,28,39.291,39.753,"spennende"]],"speaker":"Heidi"},{"id":9,"start":40.388,"end":43.413,"text":"Ja, det blir spennende for hele familien.","zh":"是的，对全家人来说都是这样。","words":[[0,2,40.388,40.573,"ja"],[4,7,41.288,41.473,"det"],[8,12,41.488,41.713,"blir"],[13,22,41.768,42.253,"spennende"],[23,26,42.268,42.453,"for"],[27,31,42.508,42.853,"hele"],[32,40,42.868,43.413,"familien"]],"speaker":"Amira"},{"id":10,"start":44.308,"end":46.893,"text":"Skal Stina også begynne i barnehagen snart?","zh":"斯蒂娜也快要上幼儿园了吗？","words":[[0,4,44.308,44.553,"skal"],[5,10,44.608,45.033,"stina"],[11,15,45.108,45.38,"også"],[16,23,45.38,45.713,"begynne"],[24,25,45.728,45.831,"i"],[26,36,45.831,46.453,"barnehagen"],[37,42,46.468,46.893,"snart"]],"speaker":"Amira"},{"id":11,"start":47.648,"end":49.853,"text":"Nei, jeg vil vente litt.","zh":"不，我想再等一等。","words":[[0,3,47.648,47.933,"nei"],[5,8,48.768,48.953,"jeg"],[9,12,48.968,49.13,"vil"],[13,18,49.13,49.57,"vente"],[19,23,49.57,49.853,"litt"]],"speaker":"Heidi"},{"id":12,"start":50.668,"end":51.213,"text":"Hvorfor det?","zh":"为什么？","words":[[0,7,50.668,51.061,"hvorfor"],[8,11,51.061,51.213,"det"]],"speaker":"Amira"},{"id":13,"start":52.488,"end":54.413,"text":"Jeg synes hun er litt for liten.","zh":"我觉得她还有点太小。","words":[[0,3,52.488,52.693,"jeg"],[4,9,52.808,53.27,"synes"],[10,13,53.27,53.433,"hun"],[14,16,53.468,53.633,"er"],[17,21,53.648,53.88,"litt"],[22,25,53.88,54.02,"for@pa-vei-for-excess"],[26,31,54.02,54.413,"liten"]],"speaker":"Heidi"},{"id":14,"start":56.088,"end":58.093,"text":"Derfor har vi søkt om kontantstøtte.","zh":"所以我们申请了育儿现金补助。","words":[[0,6,56.088,56.511,"derfor"],[7,10,56.511,56.68,"har"],[11,13,56.68,56.793,"vi"],[14,18,56.808,57.09,"søkt"],[19,21,57.09,57.193,"om"],[22,35,57.208,58.093,"kontantstøtte"]],"speaker":"Heidi"},{"id":15,"start":59.328,"end":62.373,"text":"Jeg tror det er bra for Javed å komme i barnehagen nå.","zh":"我觉得贾韦德现在去幼儿园是好事。","words":[[0,3,59.328,59.573,"jeg"],[4,8,59.628,59.87,"tror"],[9,12,59.87,59.971,"det"],[13,15,59.971,60.07,"er"],[16,19,60.07,60.253,"bra"],[20,23,60.328,60.481,"for"],[24,29,60.481,60.953,"javed"],[30,31,61.148,61.251,"å"],[32,37,61.251,61.481,"komme"],[38,39,61.481,61.57,"i"],[40,50,61.57,62.193,"barnehagen"],[51,53,62.248,62.373,"nå"]],"speaker":"Amira"},{"id":16,"start":63.468,"end":67.833,"text":"Alle barn med innvandrerforeldre bør gå i barnehagen, synes jeg.","zh":"我认为，父母是移民的孩子都应该上幼儿园。","words":[[0,4,63.468,63.733,"alle"],[5,9,63.748,64.073,"barn"],[10,13,64.108,64.293,"med"],[14,32,64.348,65.513,"innvandrerforeldre"],[33,36,65.828,66.053,"bør"],[37,39,66.088,66.233,"gå"],[40,41,66.368,66.471,"i"],[42,52,66.471,67.053,"barnehagen"],[54,59,67.268,67.62,"synes"],[60,63,67.62,67.833,"jeg"]],"speaker":"Amira"},{"id":17,"start":68.828,"end":70.053,"text":"Da lærer de norsk!","zh":"这样他们就能学挪威语！","words":[[0,2,68.828,68.973,"da"],[3,8,69.048,69.38,"lærer@pa-vei-lærer-learns"],[9,11,69.38,69.513,"de"],[12,17,69.588,70.053,"norsk"]],"speaker":"Amira"},{"id":18,"start":71.728,"end":74.333,"text":"Jeg synes det er best at alle kan bestemme selv.","zh":"我觉得最好还是让每个人自己决定。","words":[[0,3,71.728,71.973,"jeg"],[4,9,72.068,72.441,"synes"],[10,13,72.441,72.581,"det"],[14,16,72.581,72.701,"er"],[17,21,72.701,73.001,"best"],[22,24,73.001,73.153,"at"],[25,29,73.188,73.451,"alle"],[30,33,73.451,73.631,"kan"],[34,42,73.631,74.053,"bestemme"],[43,47,74.068,74.333,"selv"]],"speaker":"Heidi"},{"id":19,"start":75.208,"end":77.473,"text":"Har du ikke lyst til å komme tilbake i jobb?","zh":"你不想回去工作吗？","words":[[0,3,75.208,75.37,"har"],[4,6,75.37,75.481,"du"],[7,11,75.481,75.68,"ikke"],[12,16,75.68,75.921,"lyst@pa-vei-lyst-desire"],[17,20,75.921,76.053,"til"],[21,22,76.068,76.171,"å"],[23,28,76.171,76.43,"komme"],[29,36,76.43,76.973,"tilbake"],[37,38,77.008,77.113,"i"],[39,43,77.148,77.473,"jobb"]],"speaker":"Amira"},{"id":20,"start":78.208,"end":81.293,"text":"Ikke ennå. Det blir så mye stress.","zh":"现在还不想，那样压力太大。","words":[[0,4,78.208,78.533,"ikke"],[5,9,78.568,78.833,"ennå"],[11,14,79.548,79.733,"det"],[15,19,79.788,80.073,"blir"],[20,22,80.188,80.373,"så"],[23,26,80.588,80.873,"mye"],[27,33,80.908,81.293,"stress"]],"speaker":"Heidi"},{"id":21,"start":82.288,"end":87.333,"text":"Jeg koser meg hjemme, og jeg tror det er bra for Stina å være hjemme litt til.","zh":"我在家过得很开心，也觉得让斯蒂娜在家再待一阵子对她有好处。","words":[[0,3,82.288,82.453,"jeg"],[4,9,82.528,83.06,"koser@pa-vei-extra-108"],[10,13,83.06,83.221,"meg"],[14,20,83.221,83.493,"hjemme"],[22,24,84.048,84.171,"og"],[25,28,84.171,84.373,"jeg"],[29,33,84.408,84.65,"tror"],[34,37,84.65,84.781,"det"],[38,40,84.781,84.893,"er"],[41,44,84.908,85.193,"bra"],[45,48,85.528,85.693,"for"],[49,54,85.728,86.133,"stina"],[55,56,86.268,86.37,"å"],[57,61,86.37,86.62,"være"],[62,68,86.62,86.93,"hjemme"],[69,73,86.93,87.16,"litt"],[74,77,87.16,87.333,"til"]],"speaker":"Heidi"},{"id":22,"start":88.508,"end":90.713,"text":"Jeg gleder meg til å begynne å jobbe igjen.","zh":"我很期待重新开始工作。","words":[[0,3,88.508,88.713,"jeg"],[4,10,88.808,89.34,"gleder"],[11,14,89.34,89.533,"meg"],[15,18,89.568,89.733,"til"],[19,20,89.748,89.831,"å"],[21,28,89.831,90.12,"begynne"],[29,30,90.12,90.193,"å"],[31,36,90.208,90.481,"jobbe"],[37,42,90.481,90.713,"igjen"]],"speaker":"Amira"},{"id":23,"start":91.348,"end":93.633,"text":"Jeg savner jobben og kollegaene mine.","zh":"我很想念工作和同事。","words":[[0,3,91.348,91.513,"jeg"],[4,10,91.588,92.113,"savner"],[11,17,92.128,92.493,"jobben"],[18,20,92.688,92.833,"og"],[21,31,92.848,93.37,"kollegaene"],[32,36,93.37,93.633,"mine"]],"speaker":"Amira"},{"id":24,"start":94.908,"end":96.693,"text":"Tror du ikke det blir slitsomt, da?","zh":"你不觉得那样会很累吗？","words":[[0,4,94.908,95.13,"tror"],[5,7,95.13,95.24,"du"],[8,12,95.24,95.441,"ikke"],[13,16,95.441,95.581,"det"],[17,21,95.581,95.813,"blir"],[22,30,95.888,96.581,"slitsomt"],[32,34,96.581,96.693,"da"]],"speaker":"Heidi"},{"id":25,"start":97.808,"end":99.493,"text":"Hvilken klasse går Jasmin i nå?","zh":"亚斯明现在上几年级？","words":[[0,7,97.808,98.153,"hvilken"],[8,14,98.168,98.59,"klasse"],[15,18,98.59,98.77,"går"],[19,25,98.77,99.28,"jasmin"],[26,27,99.28,99.351,"i"],[28,30,99.351,99.493,"nå"]],"speaker":"Heidi"},{"id":26,"start":100.488,"end":104.333,"text":"Hun går i tredje. Og etter skolen er hun på SFO.","zh":"她上三年级，放学后去课后托管。","words":[[0,3,100.488,100.653,"hun"],[4,7,100.688,100.891,"går"],[8,9,100.891,100.99,"i"],[10,16,100.99,101.453,"tredje"],[18,20,102.268,102.413,"og"],[21,26,102.428,102.733,"etter"],[27,33,102.748,103.193,"skolen"],[34,36,103.368,103.511,"er"],[37,40,103.511,103.65,"hun"],[41,43,103.65,103.773,"på"],[44,47,103.948,104.333,"sfo"]],"speaker":"Amira"},{"id":27,"start":105.248,"end":107.013,"text":"Jeg tror det kommer til å gå bra, jeg.","zh":"我觉得会顺利的。","words":[[0,3,105.248,105.493,"jeg"],[4,8,105.568,105.791,"tror"],[9,12,105.791,105.91,"det"],[13,19,105.91,106.16,"kommer"],[20,23,106.16,106.31,"til"],[24,25,106.31,106.4,"å"],[26,28,106.4,106.513,"gå"],[29,32,106.528,106.713,"bra"],[34,37,106.808,107.013,"jeg"]],"speaker":"Amira"},{"id":28,"start":107.888,"end":111.333,"text":"Ja, lykke til! Og lykke til i barnehagen i morgen.","zh":"好，祝你顺利！也祝明天上幼儿园顺利。","words":[[0,2,107.888,108.033,"ja"],[4,9,108.328,108.671,"lykke"],[10,13,108.671,108.873,"til"],[15,17,109.408,109.553,"og"],[18,23,109.588,109.91,"lykke"],[24,27,109.91,110.073,"til"],[28,29,110.088,110.21,"i"],[30,40,110.21,110.913,"barnehagen"],[41,42,110.928,111.02,"i"],[43,49,111.02,111.333,"morgen"]],"speaker":"Heidi"},{"id":29,"start":112.128,"end":115.253,"text":"Takk skal du ha. Jeg håper at han vil trives.","zh":"谢谢你。希望他会喜欢那里。","words":[[0,4,112.128,112.413,"takk"],[5,9,112.428,112.631,"skal"],[10,12,112.631,112.75,"du"],[13,15,112.75,112.893,"ha"],[17,20,113.748,113.93,"jeg"],[21,26,113.93,114.24,"håper"],[27,29,114.24,114.37,"at"],[30,33,114.37,114.511,"han"],[34,37,114.511,114.673,"vil"],[38,44,114.728,115.253,"trives"]],"speaker":"Amira"},{"id":30,"start":117.308,"end":118.053,"text":"Sammendrag.","zh":"摘要","words":[[0,10,117.308,118.053,"sammendrag"]]},{"id":31,"start":119.728,"end":122.013,"text":"Amira og Heidi er naboer.","zh":"阿米拉和海蒂是邻居。","words":[[0,5,119.728,120.293,"amira"],[6,8,120.408,120.533,"og"],[9,14,120.568,121.013,"heidi"],[15,17,121.168,121.393,"er"],[18,24,121.468,122.013,"naboer"]]},{"id":32,"start":123.388,"end":126.533,"text":"Amira har en sønn som skal begynne i barnehagen.","zh":"阿米拉有个即将开始上幼儿园的儿子。","words":[[0,5,123.388,123.933,"amira"],[6,9,123.988,124.191,"har"],[10,12,124.191,124.333,"en"],[13,17,124.428,124.773,"sønn"],[18,21,124.828,124.993,"som"],[22,26,125.008,125.213,"skal"],[27,34,125.248,125.673,"begynne"],[35,36,125.728,125.833,"i"],[37,47,125.848,126.533,"barnehagen"]]},{"id":33,"start":128.068,"end":131.353,"text":"Heidi har ei datter som ikke skal begynne ennå.","zh":"海蒂有个女儿，暂时还不上幼儿园。","words":[[0,5,128.068,128.493,"heidi"],[6,9,128.548,128.78,"har"],[10,12,128.78,128.913,"ei"],[13,19,128.948,129.373,"datter"],[20,23,129.708,129.893,"som"],[24,28,130.008,130.393,"ikke"],[29,33,130.408,130.633,"skal"],[34,41,130.648,131.093,"begynne"],[42,46,131.108,131.353,"ennå"]]},{"id":34,"start":133.028,"end":137.293,"text":"Amira savner kollegaene og har lyst til å begynne å jobbe igjen.","zh":"阿米拉想念同事，想重新开始工作。","words":[[0,5,133.028,133.553,"amira"],[6,12,133.648,134.073,"savner"],[13,23,134.108,134.853,"kollegaene"],[24,26,135.448,135.581,"og"],[27,30,135.581,135.721,"har"],[31,35,135.721,135.971,"lyst@pa-vei-lyst-desire"],[36,39,135.971,136.09,"til"],[40,41,136.09,136.19,"å"],[42,49,136.19,136.611,"begynne"],[50,51,136.611,136.713,"å"],[52,57,136.728,137.041,"jobbe"],[58,63,137.041,137.293,"igjen"]]},{"id":35,"start":138.748,"end":141.133,"text":"Heidi sier at hun ikke savner jobben.","zh":"海蒂说她并不想念工作。","words":[[0,5,138.748,139.153,"heidi"],[6,10,139.228,139.55,"sier"],[11,13,139.55,139.69,"at"],[14,17,139.69,139.833,"hun"],[18,22,139.928,140.333,"ikke"],[23,29,140.368,140.8,"savner"],[30,36,140.8,141.133,"jobben"]]},{"id":36,"start":142.108,"end":143.513,"text":"Hun koser seg hjemme.","zh":"她在家过得很开心。","words":[[0,3,142.108,142.333,"hun"],[4,9,142.448,142.951,"koser@pa-vei-extra-109"],[10,13,142.951,143.133,"seg"],[14,20,143.148,143.513,"hjemme"]]}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"amira":{"lemma":"Amira","pos":"专名","zh":"阿米拉（人名）","ref":null,"clip":null},"amiras":{"lemma":"Amira","pos":"专名","zh":"阿米拉的","ref":null,"clip":null,"form":"所有格"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":null},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"begynne":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","clip":null},"best":{"lemma":"god","zh":"好的","pos":"形容词","ref":"8-009","form":"最高级","clip":null},"bestemme":{"lemma":