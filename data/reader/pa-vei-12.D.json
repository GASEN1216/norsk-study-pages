{"id":"pa-vei-12.D","bookId":"pa-vei-textbook","readingId":"12.D","title":"Et flerkulturelt samfunn","audio":"audio/pa-vei/12.D.mp3","duration":102.936,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.8,"end":4.745,"text":"Det kan være mange kulturelle forskjeller mellom ulike steder i Norge.","zh":"挪威不同地方之间可能有很多文化差异。","words":[[0,3,0.8,0.963,"det"],[4,7,0.963,1.143,"kan"],[8,12,1.143,1.365,"være"],[13,18,1.4,1.745,"mange"],[19,29,1.78,2.485,"kulturelle"],[30,41,2.5,3.065,"forskjeller"],[42,48,3.08,3.365,"mellom"],[49,54,3.44,3.942,"ulike"],[55,61,3.942,4.353,"steder"],[62,63,4.353,4.453,"i"],[64,69,4.453,4.745,"norge"]]},{"id":1,"start":6.0,"end":9.565,"text":"Det er derfor ikke lett å si hva som er «typisk norsk».","zh":"因此，很难说什么才是“典型的挪威特色”。","words":[[0,3,6.0,6.143,"det"],[4,6,6.143,6.252,"er"],[7,13,6.252,6.625,"derfor"],[14,18,6.64,6.902,"ikke"],[19,23,6.902,7.285,"lett"],[24,25,7.42,7.525,"å"],[26,28,7.58,7.745,"si"],[29,32,7.8,7.965,"hva"],[33,36,8.02,8.183,"som"],[37,39,8.183,8.385,"er"],[41,47,8.56,9.185,"typisk"],[48,53,9.2,9.565,"norsk@pa-vei-norsk-adjective"]]},{"id":2,"start":10.84,"end":15.265,"text":"I dag bor det dessuten mennesker fra over 200 forskjellige land i Norge.","zh":"如今，挪威还居住着来自 200 多个国家的人。","words":[[0,1,10.84,10.945,"i"],[2,5,10.98,11.285,"dag"],[6,9,11.32,11.502,"bor"],[10,13,11.502,11.623,"det"],[14,22,11.623,12.123,"dessuten"],[23,32,12.123,12.665,"mennesker"],[33,36,12.7,12.885,"fra"],[37,41,12.92,13.185,"over"],[42,45,13.26,13.945,"200"],[46,58,13.96,14.482,"forskjellige"],[59,63,14.482,14.745,"land"],[64,65,14.86,14.953,"i"],[66,71,14.953,15.265,"norge"]]},{"id":3,"start":16.34,"end":18.605,"text":"Landet er et flerkulturelt samfunn.","zh":"这个国家是一个多元文化社会。","words":[[0,6,16.34,16.725,"landet"],[7,9,16.74,16.902,"er"],[10,12,16.902,17.065,"et"],[13,26,17.08,18.123,"flerkulturelt"],[27,34,18.123,18.605,"samfunn"]]},{"id":4,"start":19.9,"end":24.185,"text":"Folk reiser også mer enn før eller går på skole i andre land.","zh":"人们也比以前旅行得更多，或者去其他国家上学。","words":[[0,4,19.9,20.245,"folk"],[5,11,20.3,20.793,"reiser"],[12,16,20.793,21.045,"også"],[17,20,21.08,21.332,"mer"],[21,24,21.332,21.532,"enn"],[25,28,21.532,21.805,"før"],[29,34,22.34,22.623,"eller"],[35,38,22.623,22.845,"går"],[39,41,22.86,22.985,"på"],[42,47,23.02,23.465,"skole"],[48,49,23.5,23.605,"i"],[50,55,23.64,23.933,"andre"],[56,60,23.933,24.185,"land"]]},{"id":5,"start":25.2,"end":29.605,"text":"Der møter de andre skikker, religioner og måter å tenke på.","zh":"在那里，他们会接触到不同的习俗、宗教和思维方式。","words":[[0,3,25.2,25.505,"der"],[4,9,25.52,25.862,"møter"],[10,12,25.862,25.965,"de"],[13,18,26.02,26.365,"andre"],[19,26,26.4,26.905,"skikker"],[28,38,27.34,28.065,"religioner"],[39,41,28.5,28.642,"og"],[42,47,28.642,29.052,"måter"],[48,49,29.052,29.142,"å"],[50,55,29.142,29.473,"tenke"],[56,58,29.473,29.605,"på"]]},{"id":6,"start":31.34,"end":34.025,"text":"Men hva betyr det å være «norsk» i dag?","zh":"可是，今天成为“挪威人”意味着什么？","words":[[0,3,31.34,31.505,"men"],[4,7,31.54,31.725,"hva"],[8,13,31.8,32.213,"betyr"],[14,17,32.213,32.365,"det"],[18,19,32.38,32.483,"å"],[20,24,32.483,32.765,"være"],[26,31,32.98,33.465,"norsk@pa-vei-norsk-adjective"],[33,34,33.6,33.703,"i"],[35,38,33.703,34.025,"dag"]]},{"id":7,"start":35.36,"end":39.805,"text":"Hvor lenge må en innvandrer bo i Norge før han eller hun blir norsk?","zh":"一个移民要在挪威住多久，才能成为挪威人？","words":[[0,4,35.36,35.605,"hvor"],[5,10,35.66,36.002,"lenge"],[11,13,36.002,36.145,"må"],[14,16,36.16,36.285,"en"],[17,27,36.32,36.985,"innvandrer"],[28,30,37.04,37.185,"bo"],[31,32,37.28,37.373,"i"],[33,38,37.373,37.705,"norge"],[39,42,38.02,38.265,"før"],[43,46,38.32,38.525,"han"],[47,52,38.62,38.865,"eller"],[53,56,38.88,39.065,"hun"],[57,61,39.14,39.422,"blir"],[62,67,39.422,39.805,"norsk@pa-vei-norsk-adjective"]]},{"id":8,"start":41.1,"end":44.825,"text":"Er det nok å være født i Norge eller å være norsk statsborger?","zh":"在挪威出生，或者拥有挪威国籍，就够了吗？","words":[[0,2,41.1,41.233,"er"],[3,6,41.233,41.373,"det"],[7,10,41.373,41.605,"nok"],[11,12,41.62,41.713,"å"],[13,17,41.713,41.945,"være"],[18,22,42.04,42.403,"født"],[23,24,42.403,42.493,"i"],[25,30,42.493,42.825,"norge"],[31,36,43.12,43.362,"eller"],[37,38,43.362,43.453,"å"],[39,43,43.453,43.725,"være"],[44,49,43.78,44.105,"norsk@pa-vei-norsk-adjective"],[50,61,44.12,44.825,"statsborger"]]},{"id":9,"start":46.2,"end":51.345,"text":"Mange, som Savtantar og Laleh, opplever at det ikke er nok.","zh":"很多人，例如 Savtantar 和 Laleh，都感到这些还不够。","words":[[0,5,46.2,46.565,"mange"],[7,10,46.92,47.145,"som"],[11,20,47.38,48.325,"savtantar"],[21,23,48.44,48.585,"og"],[24,29,48.76,49.205,"laleh"],[31,39,49.74,50.252,"opplever"],[40,42,50.252,50.405,"at"],[43,46,50.42,50.605,"det"],[47,51,50.68,50.962,"ikke"],[52,54,50.962,51.082,"er"],[55,58,51.082,51.345,"nok"]]},{"id":10,"start":57.0,"end":60.165,"text":"Jeg har søkt mange jobber, men uten resultat.","zh":"我申请过很多工作，却没有结果。","words":[[0,3,57.0,57.153,"jeg"],[4,7,57.153,57.303,"har"],[8,12,57.303,57.665,"søkt"],[13,18,57.74,58.052,"mange"],[19,25,58.052,58.365,"jobber"],[27,30,58.94,59.105,"men"],[31,35,59.3,59.642,"uten"],[36,44,59.642,60.165,"resultat"]],"speaker":"Savtantar"},{"id":11,"start":61.38,"end":64.285,"text":"En kamerat sier at jeg ikke må bruke navnet mitt.","zh":"一位朋友说，我不应该用自己的名字。","words":[[0,2,61.38,61.523,"en"],[3,10,61.523,62.163,"kamerat"],[11,15,62.163,62.403,"sier"],[16,18,62.403,62.523,"at"],[19,22,62.523,62.665,"jeg"],[23,27,62.78,63.112,"ikke"],[28,30,63.112,63.245,"må"],[31,36,63.26,63.685,"bruke"],[37,43,63.7,64.043,"navnet"],[44,48,64.043,64.285,"mitt"]],"speaker":"Savtantar"},{"id":12,"start":65.34,"end":66.285,"text":"Det er ikke norsk nok.","zh":"这个名字不够像挪威名字。","words":[[0,3,65.34,65.472,"det"],[4,6,65.472,65.562,"er"],[7,11,65.562,65.762,"ikke"],[12,17,65.762,66.053,"norsk@pa-vei-norsk-adjective"],[18,21,66.053,66.285,"nok"]],"speaker":"Savtantar"},{"id":13,"start":67.8,"end":69.885,"text":"Må jeg bytte navn for å få meg jobb?","zh":"难道我得改名才能找到工作吗？","words":[[0,2,67.8,67.933,"må"],[3,6,67.933,68.085,"jeg"],[7,12,68.18,68.625,"bytte"],[13,17,68.64,69.005,"navn"],[18,21,69.14,69.302,"for"],[22,23,69.302,69.392,"å"],[24,26,69.392,69.502,"få"],[27,30,69.502,69.653,"meg"],[31,35,69.653,69.885,"jobb"]],"speaker":"Savtantar"},{"id":14,"start":75.48,"end":79.705,"text":"Jeg er født i Norge, men foreldrene mine er fra Iran.","zh":"我出生在挪威，但我的父母来自伊朗。","words":[[0,3,75.48,75.685,"jeg"],[4,6,75.76,75.905,"er"],[7,11,75.94,76.245,"født"],[12,13,76.26,76.352,"i"],[14,19,76.352,76.705,"norge"],[21,24,77.58,77.805,"men"],[25,35,77.92,78.493,"foreldrene"],[36,40,78.493,78.765,"mine"],[41,43,78.84,79.025,"er"],[44,47,79.14,79.325,"fra"],[48,52,79.34,79.705,"iran"]],"speaker":"Laleh"},{"id":15,"start":80.82,"end":84.405,"text":"Jeg har bodd hele livet i Nord-Norge og snakker dialekt.","zh":"我一辈子都住在挪威北部，说的也是当地方言。","words":[[0,3,80.82,80.972,"jeg"],[4,7,80.972,81.125,"har"],[8,12,81.14,81.425,"bodd"],[13,17,81.66,82.005,"hele"],[18,23,82.02,82.365,"livet"],[24,25,82.42,82.532,"i"],[26,36,82.532,83.025,"nord-norge"],[37,39,83.3,83.433,"og"],[40,47,83.433,83.825,"snakker"],[48,55,83.86,84.405,"dialekt"]],"speaker":"Laleh"},{"id":16,"start":85.26,"end":86.865,"text":"Likevel spør folk meg:","zh":"可是人们还是会问我：","words":[[0,7,85.26,85.885,"likevel"],[8,12,86.0,86.345,"spør"],[13,17,86.4,86.703,"folk"],[18,21,86.703,86.865,"meg"]],"speaker":"Laleh"},{"id":17,"start":88.2,"end":89.205,"text":"Hvor kommer du fra?","zh":"你来自哪里？","words":[[0,4,88.2,88.425,"hvor"],[5,11,88.5,88.862,"kommer"],[12,14,88.862,88.985,"du"],[15,18,89.02,89.205,"fra"]],"speaker":"Laleh"},{"id":18,"start":90.62,"end":92.265,"text":"Fra Nord-Norge, sier jeg.","zh":"我说，我来自挪威北部。","words":[[0,3,90.62,90.825,"fra"],[4,14,90.92,91.485,"nord-norge"],[16,20,91.86,92.112,"sier"],[21,24,92.112,92.265,"jeg"]],"speaker":"Laleh"},{"id":19,"start":93.74,"end":95.645,"text":"Men hvor kommer du egentlig fra?","zh":"可是，你到底来自哪里？","words":[[0,3,93.74,93.922,"men"],[4,8,93.922,94.145,"hvor"],[9,15,94.2,94.562,"kommer"],[16,18,94.562,94.685,"du"],[19,27,94.86,95.405,"egentlig"],[28,31,95.44,95.645,"fra"]],"speaker":"Laleh"},{"id":20,"start":97.04,"end":99.785,"text":"Å, jeg blir så lei av spørsmålene deres!","zh":"唉，我真受够了他们这些问题！","words":[[0,1,97.04,97.62,"å"],[3,6,97.66,97.845,"jeg"],[7,11,97.88,98.125,"blir"],[12,14,98.16,98.305,"så"],[15,18,98.36,98.565,"lei"],[19,21,98.62,98.765,"av"],[22,33,98.78,99.403,"spørsmålene"],[34,39,99.403,99.785,"deres"]],"speaker":"Laleh"},{"id":21,"start":100.56,"end":102.065,"text":"Når blir jeg norsk nok?","zh":"我什么时候才能算足够像挪威人呢？","words":[[0,3,100.56,100.785,"når"],[4,8,100.9,101.203,"blir"],[9,12,101.203,101.345,"jeg"],[13,18,101.38,101.725,"norsk"],[19,22,101.74,102.065,"nok"]],"speaker":"Laleh"}],"lexicon":{"200":{"lemma":"200","pos":"数词","zh":"数字 200","ref":null,"clip":null},"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"betyr":{"lemma":"bety","pos":"动词","zh":"意思是；意味着","form":"现在时","ref":null,"clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"bo":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"不定式","clip":null},"bodd":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"过去分词","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"bruke":{"lemma":"bruke","zh":"使用；花（钱、时间）","pos":"动词","ref":"10-010","clip":null},"bytte":{"lemma":"bytte","zh":"更换；交换","pos":"动词","ref":"12-058","clip":null},"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"deres":{"lemma":"deres","zh":"你们的；他们/她们/它们的","pos":"物主限定词","