{"id":"pa-vei-1.B","bookId":"pa-vei-textbook","readingId":"1.B","title":"Hvor er du fra?","audio":"audio/pa-vei/1.B.mp3","duration":110.424,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.74,"end":4.505,"text":"B. Hvor er du fra?","zh":"B. 你来自哪里？","words":[[0,1,1.74,2.34,"b"],[3,7,3.38,3.685,"hvor"],[8,10,3.88,4.103,"er"],[11,13,4.103,4.245,"du"],[14,17,4.3,4.505,"fra"]]},{"id":1,"start":6.0,"end":9.605,"text":"Hei, jeg heter Anne og er lærer.","zh":"你好，我叫安妮，是一名老师。","words":[[0,3,6.0,6.285,"hei"],[5,8,7.16,7.425,"jeg"],[9,14,7.66,7.965,"heter"],[15,19,8.06,8.405,"anne"],[20,22,8.72,8.865,"og"],[23,25,8.88,9.025,"er"],[26,31,9.1,9.605,"lærer"]],"speaker":"Anne"},{"id":2,"start":10.66,"end":11.385,"text":"Hva heter du?","zh":"你叫什么名字？","words":[[0,3,10.66,10.845,"hva"],[4,9,10.96,11.252,"heter"],[10,12,11.252,11.385,"du"]],"speaker":"Anne"},{"id":3,"start":12.88,"end":14.605,"text":"Jeg heter Monica.","zh":"我叫莫妮卡。","words":[[0,3,12.88,13.145,"jeg"],[4,9,13.34,13.825,"heter"],[10,16,14.08,14.605,"monica"]],"speaker":"Monica"},{"id":4,"start":16.19,"end":17.095,"text":"Hvor er du fra?","zh":"你来自哪里？","words":[[0,4,16.19,16.435,"hvor"],[5,7,16.53,16.693,"er"],[8,10,16.693,16.835,"du"],[11,14,16.93,17.095,"fra"]],"speaker":"Anne"},{"id":5,"start":18.43,"end":20.195,"text":"Jeg er fra Polen.","zh":"我来自波兰。","words":[[0,3,18.43,18.675,"jeg"],[4,6,18.81,19.035,"er"],[7,10,19.13,19.355,"fra"],[11,16,19.71,20.195,"polen"]],"speaker":"Monica"},{"id":6,"start":22.17,"end":22.975,"text":"Hva heter du?","zh":"你叫什么名字？","words":[[0,3,22.17,22.355,"hva"],[4,9,22.49,22.815,"heter"],[10,12,22.85,22.975,"du"]],"speaker":"Anne"},{"id":7,"start":24.39,"end":25.335,"text":"Jeg heter Safer.","zh":"我叫萨费尔。","words":[[0,3,24.39,24.553,"jeg"],[4,9,24.553,24.835,"heter"],[10,15,24.87,25.335,"safer"]],"speaker":"Safer"},{"id":8,"start":26.67,"end":27.755,"text":"Hvor kommer du fra?","zh":"你来自哪里？","words":[[0,4,26.67,26.895,"hvor"],[5,11,26.95,27.255,"kommer"],[12,14,27.29,27.455,"du"],[15,18,27.57,27.755,"fra"]],"speaker":"Anne"},{"id":9,"start":29.55,"end":33.075,"text":"Jeg kommer fra Somalia, men nå bor jeg i Norge.","zh":"我来自索马里，但我现在住在挪威。","words":[[0,3,29.55,29.735,"jeg"],[4,10,29.75,30.093,"kommer"],[11,14,30.093,30.275,"fra"],[15,22,30.43,31.015,"somalia"],[24,27,31.85,32.015,"men"],[28,30,32.03,32.175,"nå"],[31,34,32.31,32.522,"bor"],[35,38,32.522,32.662,"jeg"],[39,40,32.662,32.743,"i"],[41,46,32.743,33.075,"norge"]],"speaker":"Safer"},{"id":10,"start":35.03,"end":35.255,"text":"Hei!","zh":"你好！","words":[[0,3,35.03,35.255,"hei"]],"speaker":"Pablo"},{"id":11,"start":36.09,"end":36.295,"text":"Hei!","zh":"你好！","words":[[0,3,36.09,36.295,"hei"]],"speaker":"Haifa"},{"id":12,"start":37.63,"end":38.635,"text":"Jeg heter Pablo.","zh":"我叫巴勃罗。","words":[[0,3,37.63,37.815,"jeg"],[4,9,37.85,38.175,"heter"],[10,15,38.19,38.635,"pablo"]],"speaker":"Pablo"},{"id":13,"start":39.63,"end":40.275,"text":"Hva heter du?","zh":"你叫什么名字？","words":[[0,3,39.63,39.795,"hva"],[4,9,39.85,40.153,"heter"],[10,12,40.153,40.275,"du"]],"speaker":"Pablo"},{"id":14,"start":41.49,"end":42.495,"text":"Jeg heter Haifa.","zh":"我叫海法。","words":[[0,3,41.49,41.672,"jeg"],[4,9,41.672,42.035,"heter"],[10,15,42.07,42.495,"haifa"]],"speaker":"Haifa"},{"id":15,"start":43.79,"end":44.895,"text":"Jeg kommer fra Irak.","zh":"我来自伊拉克。","words":[[0,3,43.79,43.975,"jeg"],[4,10,43.99,44.293,"kommer"],[11,14,44.293,44.455,"fra"],[15,19,44.51,44.895,"irak"]],"speaker":"Haifa"},{"id":16,"start":46.21,"end":47.335,"text":"Hvor er du fra, Pablo?","zh":"巴勃罗，你来自哪里？","words":[[0,4,46.21,46.382,"hvor"],[5,7,46.382,46.513,"er"],[8,10,46.513,46.655,"du"],[11,14,46.73,46.915,"fra"],[16,21,47.01,47.335,"pablo"]],"speaker":"Haifa"},{"id":17,"start":48.73,"end":50.075,"text":"Jeg er fra Argentina.","zh":"我来自阿根廷。","words":[[0,3,48.73,48.915,"jeg"],[4,6,48.95,49.135,"er"],[7,10,49.15,49.335,"fra"],[11,20,49.35,50.075,"argentina"]],"speaker":"Pablo"},{"id":18,"start":51.59,"end":52.635,"text":"Hvor bor du, Haifa?","zh":"海法，你住在哪里？","words":[[0,4,51.59,51.795,"hvor"],[5,8,51.83,52.043,"bor"],[9,11,52.043,52.175,"du"],[13,18,52.31,52.635,"haifa"]],"speaker":"Pablo"},{"id":19,"start":53.77,"end":54.995,"text":"Jeg bor i Fjordgata.","zh":"我住在峡湾街。","words":[[0,3,53.77,53.995,"jeg"],[4,7,54.01,54.212,"bor"],[8,9,54.212,54.315,"i"],[10,19,54.41,54.995,"fjordgata"]],"speaker":"Haifa"},{"id":20,"start":60.03,"end":60.915,"text":"Sammendrag.","zh":"内容概要。","words":[[0,10,60.03,60.915,"sammendrag"]]},{"id":21,"start":63.25,"end":64.995,"text":"Safer er fra Somalia.","zh":"萨费尔来自索马里。","words":[[0,5,63.25,63.835,"safer"],[6,8,63.97,64.175,"er"],[9,12,64.19,64.373,"fra"],[13,20,64.373,64.995,"somalia"]]},{"id":22,"start":67.23,"end":70.355,"text":"Han snakker somali og italiensk.","zh":"他会说索马里语和意大利语。","words":[[0,3,67.23,67.415,"han"],[4,11,67.45,67.895,"snakker"],[12,18,68.07,68.675,"somali"],[19,21,69.35,69.495,"og"],[22,31,69.53,70.355,"italiensk"]]},{"id":23,"start":72.91,"end":74.815,"text":"Monica er fra Polen.","zh":"莫妮卡来自波兰。","words":[[0,6,72.91,73.535,"monica"],[7,9,73.91,74.095,"er"],[10,13,74.13,74.315,"fra"],[14,19,74.35,74.815,"polen"]]},{"id":24,"start":77.13,"end":79.375,"text":"Hun snakker polsk og tysk.","zh":"她会说波兰语和德语。","words":[[0,3,77.13,77.315,"hun"],[4,11,77.37,77.735,"snakker"],[12,17,77.83,78.495,"polsk"],[18,20,78.81,78.935,"og"],[21,25,78.95,79.375,"tysk"]]},{"id":25,"start":82.49,"end":83.955,"text":"Anne er fra Norge.","zh":"安妮来自挪威。","words":[[0,4,82.49,82.855,"anne"],[5,7,83.13,83.315,"er"],[8,11,83.35,83.535,"fra"],[12,17,83.55,83.955,"norge"]]},{"id":26,"start":86.53,"end":88.855,"text":"Hun snakker norsk og engelsk.","zh":"她会说挪威语和英语。","words":[[0,3,86.53,86.715,"hun"],[4,11,86.81,87.195,"snakker"],[12,17,87.25,87.715,"norsk@pa-vei-norsk-adjective"],[18,20,88.13,88.255,"og"],[21,28,88.31,88.855,"engelsk"]]},{"id":27,"start":92.19,"end":96.175,"text":"Pablo er fra Argentina og snakker spansk.","zh":"巴勃罗来自阿根廷，会说西班牙语。","words":[[0,5,92.19,92.755,"pabl