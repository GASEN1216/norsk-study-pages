{"id":"pa-vei-6.A","bookId":"pa-vei-textbook","readingId":"6.A","title":"På jobb etter ferien","audio":"audio/pa-vei/6.A.mp3","duration":95.892,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.7,"end":3.405,"text":"A. På jobb etter ferien","zh":"A. 假期结束后回到工作岗位","words":[[0,1,0.7,1.08,"a"],[3,5,2.1,2.245,"på"],[6,10,2.32,2.605,"jobb"],[11,16,2.64,2.925,"etter"],[17,23,2.94,3.405,"ferien"]]},{"id":1,"start":5.4,"end":7.805,"text":"Å, jeg er så trøtt.","zh":"啊，我好困。","words":[[0,1,5.4,5.76,"å"],[3,6,5.78,5.945,"jeg"],[7,9,6.08,6.325,"er"],[10,12,6.64,6.825,"så"],[13,18,7.3,7.805,"trøtt"]],"speaker":"Berit"},{"id":2,"start":9.24,"end":11.685,"text":"Jeg liker ikke å stå opp så tidlig.","zh":"我不喜欢这么早起床。","words":[[0,3,9.24,9.405,"jeg"],[4,9,9.46,9.953,"liker"],[10,14,9.953,10.183,"ikke"],[15,16,10.183,10.285,"å"],[17,20,10.32,10.545,"stå"],[21,24,10.62,10.845,"opp"],[25,27,10.88,11.085,"så"],[28,34,11.28,11.685,"tidlig"]],"speaker":"Berit"},{"id":3,"start":13.26,"end":14.265,"text":"Ikke jeg heller.","zh":"我也不喜欢。","words":[[0,4,13.26,13.582,"ikke"],[5,8,13.582,13.825,"jeg"],[9,15,13.88,14.265,"heller"]],"speaker":"Kristian"},{"id":4,"start":15.42,"end":17.565,"text":"Det er synd at ferien er slutt.","zh":"真遗憾，假期结束了。","words":[[0,3,15.42,15.572,"det"],[4,6,15.572,15.685,"er"],[7,11,15.74,16.085,"synd"],[12,14,16.1,16.265,"at"],[15,21,16.34,16.885,"ferien"],[22,24,16.96,17.105,"er"],[25,30,17.12,17.565,"slutt"]],"speaker":"Kristian"},{"id":5,"start":18.92,"end":20.185,"text":"Ja, det er det.","zh":"是啊。","words":[[0,2,18.92,19.085,"ja"],[4,7,19.34,19.545,"det"],[8,10,19.76,20.002,"er"],[11,14,20.002,20.185,"det"]],"speaker":"Hilde"},{"id":6,"start":21.36,"end":22.705,"text":"Hvor var dere i ferien?","zh":"你们假期去哪里了？","words":[[0,4,21.36,21.562,"hvor"],[5,8,21.562,21.723,"var"],[9,13,21.723,22.083,"dere"],[14,15,22.083,22.172,"i"],[16,22,22.172,22.705,"ferien"]],"speaker":"Hilde"},{"id":7,"start":24.18,"end":26.845,"text":"Jeg dro til Trøndelag og fisket laks.","zh":"我去了特伦德拉格钓鲑鱼。","words":[[0,3,24.18,24.425,"jeg"],[4,7,24.54,24.725,"dro"],[8,11,24.76,24.903,"til"],[12,21,24.903,25.505,"trøndelag"],[22,24,25.72,25.865,"og"],[25,31,25.92,26.345,"fisket"],[32,36,26.36,26.845,"laks"]],"speaker":"Berit"},{"id":8,"start":28.16,"end":28.865,"text":"Fikk du noe?","zh":"你钓到鱼了吗？","words":[[0,4,28.16,28.425,"fikk"],[5,7,28.44,28.585,"du"],[8,11,28.6,28.865,"noe"]],"speaker":"Hilde"},{"id":9,"start":30.42,"end":33.965,"text":"Ja, det gjorde jeg, men jeg mistet én.","zh":"钓到了，不过有一条跑掉了。","words":[[0,2,30.42,30.585,"ja"],[4,7,31.14,31.345,"det"],[8,14,31.64,31.953,"gjorde"],[15,18,31.953,32.125,"jeg"],[20,23,32.78,32.953,"men"],[24,27,32.953,33.125,"jeg"],[28,34,33.14,33.625,"mistet"],[35,37,33.7,33.965,"én"]],"speaker":"Berit"},{"id":10,"start":35.02,"end":37.425,"text":"Den veide over ti kilo.","zh":"它有十多公斤重。","words":[[0,3,35.02,35.225,"den"],[4,9,35.38,35.785,"veide"],[10,14,35.92,36.225,"over"],[15,17,36.32,36.525,"ti"],[18,22,36.96,37.425,"kilo"]],"speaker":"Berit"},{"id":11,"start":38.68,"end":40.365,"text":"Over ti kilo?","zh":"十多公斤？","words":[[0,4,38.68,39.225,"over"],[5,7,39.36,39.645,"ti"],[8,12,39.9,40.365,"kilo"]],"speaker":"Hilde"},{"id":12,"start":41.52,"end":42.445,"text":"Er du sikker?","zh":"你确定吗？","words":[[0,2,41.52,41.683,"er"],[3,5,41.683,41.825,"du"],[6,12,41.9,42.445,"sikker"]],"speaker":"Hilde"},{"id":13,"start":43.66,"end":46.105,"text":"Ne-i-i, ikke helt sikker.","zh":"不——不太确定。","words":[[0,6,43.66,44.36,"ne-i-i"],[8,12,44.82,45.145,"ikke"],[13,17,45.24,45.685,"helt"],[18,24,45.74,46.105,"sikker"]],"speaker":"Berit"},{"id":14,"start":46.98,"end":48.885,"text":"Men den var veldig tung.","zh":"不过它非常重。","words":[[0,3,46.98,47.185,"men"],[4,7,47.44,47.625,"den"],[8,11,47.64,47.845,"var"],[12,18,47.98,48.525,"veldig"],[19,23,48.54,48.885,"tung"]],"speaker":"Berit"},{"id":15,"start":49.96,"end":50.965,"text":"Og du da, Kristian?","zh":"你呢，克里斯蒂安？","words":[[0,2,49.96,50.105,"og"],[3,5,50.12,50.265,"du"],[6,8,50.28,50.425,"da"],[10,18,50.44,50.965,"kristian"]],"speaker":"Hilde"},{"id":16,"start":51.54,"end":52.105,"text":"Hva gjorde du?","zh":"你做了些什么？","words":[[0,3,51.54,51.703,"hva"],[4,10,51.703,51.983,"gjorde"],[11,13,51.983,52.105,"du"]],"speaker":"Hilde"},{"id":17,"start":53.62,"end":60.185,"text":"Jeg reiste rundt i Telemark, og så var jeg på bluesfestival på Notodden.","zh":"我在泰勒马克四处旅行，然后去了诺托登的布鲁斯音乐节。","words":[[0,3,53.62,53.845,"jeg"],[4,10,54.1,54.543,"reiste"],[11,16,54.543,54.885,"rundt"],[17,18,54.94,55.065,"i"],[19,27,55.4,56.145,"telemark"],[29,31,57.06,57.183,"og"],[32,34,57.183,57.345,"så"],[35,38,57.4,57.562,"var"],[39,42,57.562,57.683,"jeg"],[43,45,57.683,57.805,"på"],[46,59,57.84,58.985,"bluesfestival"],[60,62,59.18,59.325,"på"],[63,71,59.38,60.185,"notodden"]],"speaker":"Kristian"},{"id":18,"start":61.52,"end":63.285,"text":"Hvor lenge var du på festivalen?","zh":"你在音乐节待了多久？","words":[[0,4,61.52,61.742,"hvor"],[5,10,61.742,62.045,"lenge"],[11,14,62.08,62.293,"var"],[15,17,62.293,62.425,"du"],[18,20,62.44,62.585,"på"],[21,31,62.6,63.285,"festivalen"]],"speaker":"Hilde"},{"id":19,"start":64.76,"end":65.685,"text":"I fire dager.","zh":"四天。","words":[[0,1,64.76,64.865,"i"],[2,6,64.9,65.262,"fire"],[7,12,65.262,65.685,"dager"]],"speaker":"Kristian"},{"id":20,"start":66.74,"end":67.225,"text":"Hva med deg?","zh":"你呢？","words":[[0,3,66.74,66.885,"hva"],[4,7,66.9,67.053,"med"],[8,11,67.053,67.225,"deg"]],"speaker":"Kristian"},{"id":21,"start":68.42,"end":69.145,"text":"Jeg var hjemme.","zh":"我待在家里。","words":[[0,3,68.42,68.623,"jeg"],[4,7,68.623,68.773,"var"],[8,14,68.773,69.145,"hjemme"]],"speaker":"Hilde"},{"id":22,"start":70.56,"end":71.045,"text":"Hjemme?","zh":"家里？","words":[[0,6,70.56,71.045,"hjemme"]],"speaker":"Kristian"},{"id":23,"start":72.22,"end":77.145,"text":"Ja, jeg hadde ikke råd til å reise bort, men jeg hadde en flott ferie.","zh":"对，我没钱出去旅行，不过假期过得很棒。","words":[[0,2,72.22,72.385,"ja"],[4,7,73.26,73.403,"jeg"],[8,13,73.403,73.612,"hadde"],[14,18,73.612,73.825,"ikke"],[19,22,73.88,74.165,"råd"],[23,26,74.18,74.363,"til"],[27,28,74.363,74.463,"å"],[29,34,74.463,74.812,"reise"],[35,39,74.812,75.145,"bort"],[41,44,75.78,75.933,"men"],[45,48,75.933,76.072,"jeg"],[49,54,76.072,76.333,"hadde"],[55,57,76.333,76.433,"en"],[58,63,76.433,76.703,"flott"],[64,69,76.703,77.145,"ferie"]],"speaker":"Hilde"},{"id":24,"start":78.06,"end":87.305,"text":"Om formiddagen jogget jeg eller dro på biblioteket, og om kvelden var jeg på konsert eller slappet av hjemme.","zh":"上午我慢跑或者去图书馆，晚上去听音乐会或者在家休息。","words":[[0,2,78.06,78.185,"om"],[3,14,78.26,79.005,"formiddagen"],[15,21,79.54,80.042,"jogget"],[22,25,80.042,80.245,"jeg"],[26,31,80.52,80.785,"eller"],[32,35,80.8,81.005,"dro"],[36,38,81.06,81.203,"på"],[39,50,81.203,81.985,"biblioteket"],[52,54,82.76,82.905,"og"],[55,57,82.92,83.045,"om"],[58,65,83.1,83.625,"kvelden"],[66,69,84.0,84.153,"var"],[70,73,84.153,84.282,"jeg"],[74,76,84.282,84.392,"på"],[77,84,84.392,85.005,"konsert"],[85,90,85.62,85.945,"eller"],[91,98,86.16,86.605,"slappet"],[99,101,86.64,86.905,"av"],[102,108,86.92,87.305,"hjemme"]],"speaker":"Hilde"},{"id":25,"start":88.36,"end":91.285,"text":"Ingen vekkerklokke, ingen planer.","zh":"没有闹钟，没有计划。","words":[[0,5,88.36,88.863,"ingen"],[6,18,88.863,89.585,"vekkerklokke"],[20,25,90.16,90.785,"ingen"],[26,32,90.82,91.285,"planer"]],"speaker":"Hilde"},{"id":26,"start":92.44,"end":94.465,"text":"Å, så deilig.","zh":"啊，真舒服。","words":[[0,1,92.44,93.1,"å"],[3,5,93.14,93.425,"så"],[6,12,93.84,94.465,"deilig"]],"speaker":"Berit"}],"lexicon":{"a":{"lemma":"A","pos":"字母","zh":"字母 A","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"biblioteket":{"lemma":"bibliotek","zh":"图书馆","pos":"名词","ref":"basics:city:bibliotek","form":"单数定指","clip":null},"bluesfestival":{"lemma":"bluesfestival","pos":"名词","zh":"布鲁斯音乐节","ref":null,"clip":null},"bort":{"lemma":