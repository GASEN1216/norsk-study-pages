{"id":"5.3","title":"Jeg savner sommeren","audio":"audio/5.3.mp3","duration":82.3,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.98,"text":"5.3 Jeg savner sommeren","heading":true,"zh":"5.3 我想念夏天","words":[[0,3,0.15,1.26,"5.3"],[4,7,1.97,2.67,"jeg"],[8,14,2.67,3.25,"savner"],[15,23,3.25,3.9,"sommeren"]]},{"id":1,"start":5.79,"end":8.93,"text":"Leyla er assistent i en barnehage.","zh":"莱拉是一家幼儿园的助理。","words":[[0,5,5.88,6.36,"leyla"],[6,8,6.36,6.86,"er"],[9,18,6.86,7.56,"assistent"],[19,20,7.56,7.92,"i"],[21,23,7.92,8.08,"en~a939a9e56dc5"],[24,33,8.08,8.85,"barnehage"]]},{"id":2,"start":10.13,"end":14.31,"text":"Det er høst, og barna er ute på tur i skogen.","zh":"现在是秋天，孩子们在外面的树林里远足。","words":[[0,3,10.21,10.36,"det"],[4,6,10.36,10.5,"er"],[7,11,10.5,10.98,"høst"],[13,15,11.56,11.64,"og"],[16,21,11.64,12.1,"barna"],[22,24,12.1,12.5,"er"],[25,28,12.5,12.88,"ute"],[29,31,12.88,13.08,"på"],[32,35,13.08,13.4,"tur"],[36,37,13.4,13.62,"i"],[38,44,13.62,14.23,"skogen"]]},{"id":3,"start":14.5,"end":17.95,"text":"Det er fine farger om høsten.","zh":"秋天的色彩很美。","words":[[0,3,15.14,15.7,"det"],[4,6,15.7,15.98,"er"],[7,11,15.98,16.44,"fine"],[12,18,16.44,17.04,"farger"],[19,21,17.04,17.38,"om~2fdd1539ca38"],[22,28,17.38,17.87,"høsten"]]},{"id":4,"start":19.08,"end":26.15,"text":"Det er rødt, gult og oransje, men i dag er det grått ute.","zh":"有红色、黄色和橙色，但今天外面灰蒙蒙的。","words":[[0,3,19.16,19.34,"det"],[4,6,19.34,19.48,"er"],[7,11,19.48,19.82,"rødt"],[13,17,20.56,20.92,"gult"],[18,20,20.92,21.66,"og"],[21,28,21.66,22.24,"oransje"],[30,33,23.54,23.78,"men"],[34,35,23.78,24.04,"i~de136e71704d"],[36,39,24.04,24.3,"dag"],[40,42,24.3,24.98,"er"],[43,46,24.98,25.1,"det"],[47,52,25.1,25.54,"grått~834a870d2b04"],[53,56,25.54,26.07,"ute"]]},{"id":5,"start":26.66,"end":29.86,"text":"Det blåser, og det regner litt.","zh":"刮着风，还下着小雨。","words":[[0,3,26.78,27.56,"det"],[4,10,27.56,28.16,"blåser"],[12,14,28.7,28.82,"og"],[15,18,28.82,28.94,"det"],[19,25,28.94,29.36,"regner"],[26,30,29.36,29.78,"litt~54360be2a478"]]},{"id":6,"start":31.05,"end":38.2,"text":"Det er kaldt, og Leyla fryser, men barna smiler og ler.","zh":"天很冷，莱拉觉得冷，但孩子们面带微笑，开怀大笑。","words":[[0,3,31.13,31.34,"det"],[4,6,31.34,31.56,"er"],[7,12,31.56,32.1,"kaldt"],[14,16,32.74,32.86,"og"],[17,22,32.86,33.3,"leyla"],[23,29,33.3,33.9,"fryser~f006ce08e11e"],[31,34,35.2,35.62,"men"],[35,40,35.62,36.34,"barna"],[41,47,36.34,37.4,"smiler"],[48,50,37.4,37.64,"og"],[51,54,37.64,38.12,"ler"]]},{"id":7,"start":39.39,"end":41.51,"text":"De liker å være ute.","zh":"他们喜欢待在户外。","words":[[0,2,39.47,39.81,"de"],[3,8,39.81,40.39,"liker"],[9,10,40.39,40.59,"å~0583da7a620a"],[11,15,40.59,40.83,"være"],[16,19,40.83,41.43,"ute"]]},{"id":8,"start":42.39,"end":47.86,"text":"De plukker blåbær, og de griller pølser og drikker kakao.","zh":"他们采蓝莓，烤香肠，喝可可。","words":[[0,2,42.47,42.98,"de"],[3,10,42.98,43.38,"plukker"],[11,17,43.38,43.98,"blåbær"],[19,21,44.72,44.84,"og"],[22,24,44.84,45.0,"de"],[25,32,45.0,45.38,"griller"],[33,39,45.38,46.14,"pølser"],[40,42,46.14,46.68,"og"],[43,50,46.68,47.1,"drikker~8bc6fe28e25c"],[51,56,47.1,47.78,"kakao"]]},{"id":9,"start":49.68,"end":52.84,"text":"Leyla elsker å jobbe i barnehagen.","zh":"莱拉很喜欢在幼儿园工作。","words":[[0,5,49.76,50.27,"leyla"],[6,12,50.27,51.17,"elsker"],[13,14,51.17,51.37,"å~0583da7a620a"],[15,20,51.37,51.69,"jobbe"],[21,22,51.69,51.85,"i"],[23,33,51.85,52.76,"barnehagen"]]},{"id":10,"start":53.92,"end":61.12,"text":"Hun er glad i å være ute, men hun liker ikke å gå ut i dårlig vær.","zh":"她喜欢待在户外，但不喜欢在坏天气里出门。","words":[[0,3,54.0,54.24,"hun"],[4,6,54.24,54.52,"er"],[7,11,54.52,54.92,"glad~b5ec8d5b115a"],[12,13,54.92,55.22,"i~61214259ab5f"],[14,15,55.22,55.34,"å~0583da7a620a"],[16,20,55.34,55.5,"være"],[21,24,55.5,55.94,"ute"],[26,29,57.17,57.83,"men"],[30,33,57.83,58.15,"hun"],[34,39,58.15,58.57,"liker"],[40,44,58.57,58.91,"ikke"],[45,46,58.91,59.47,"å~0583da7a620a"],[47,49,59.47,59.61,"gå"],[50,52,59.61,59.89,"ut"],[53,54,59.89,60.13,"i"],[55,61,60.13,60.59,"dårlig"],[62,65,60.59,61.04,"vær~c9ef13faaa9b"]]},{"id":11,"start":61.23,"end":67.41,"text":"Hun har lyst til å gå inn nå, for det er varmt inne.","zh":"她现在想进屋去，因为里面很暖和。","words":[[0,3,62.2,62.76,"hun"],[4,7,62.76,63.06,"har"],[8,12,63.06,63.48,"lyst~b499524f55a4"],[13,16,63.48,63.92,"til~99ccdd3453b0"],[17,18,63.92,64.04,"å~0583da7a620a"],[19,21,64.04,64.28,"gå"],[22,25,64.28,64.52,"inn"],[26,28,64.52,64.7,"nå~d531d47a7712"],[30,33,65.44,65.92,"for~a05c87659379"],[34,37,65.92,66.16,"det"],[38,40,66.16,66.28,"er"],[41,46,66.28,66.84,"varmt"],[47,51,66.84,67.33,"inne"]]},{"id":12,"start":68.52,"end":70.14,"text":"Hun savner sommeren.","zh":"她想念夏天。","words":[[0,3,68.6,68.8,"hun"],[4,10,68.8,69.42,"savner"],[11,19,69.42,70.06,"sommeren"]]},{"id":13,"start":71.91,"end":74.41,"text":"Har du mange bær i koppen, Markus?","speaker":"Leyla","zh":"马库斯，你杯子里有很多浆果吗？","words":[[0,3,71.99,72.18,"har"],[4,6,72.18,72.36,"du"],[7,12,72.36,72.7,"mange"],[13,16,72.7,73.06,"bær"],[17,18,73.06,73.22,"i"],[19,25,73.22,73.66,"koppen"],[27,33,73.72,74.33,"markus"]]},{"id":14,"start":75.18,"end":78.31,"text":"Nei, men jeg elsker å spise blåbær.","speaker":"Markus","zh":"没有，不过我最爱吃蓝莓了。","words":[[0,3,75.26,75.78,"nei"],[5,8,76.18,76.46,"men"],[9,12,76.46,76.62,"jeg"],[13,19,76.62,77.26,"elsker"],[20,21,77.26,77.36,"å~0583da7a620a"],[22,27,77.36,77.64,"spise"],[28,34,77.64,78.23,"blåbær"]]}],"lexicon":{"5.3":{"lemma":"5.3","zh":"第 5.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"assistent":{"lemma":"assistent","zh":"助理","pos":"名词","ref":"5-076","clip":"pronunciation/7dc58d6db0b56c5c11eb.mp3"},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"barnehage":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","clip":"pronunciation/6d6282dce74548f70784.mp3"},"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"blåbær":{"lemma":"blåbær","zh":"蓝莓","pos":"名词","ref":"5-086","clip":"pronunciation/6f1a4baa8