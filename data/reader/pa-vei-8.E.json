{"id":"pa-vei-8.E","bookId":"pa-vei-textbook","readingId":"8.E","title":"Hva slags klima ...?","audio":"audio/pa-vei/8.E.mp3","duration":89.136,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.12,"end":3.345,"text":"God morgen, alle sammen.","zh":"大家早上好。","words":[[0,3,2.12,2.305,"god"],[4,10,2.32,2.765,"morgen"],[12,16,2.8,3.022,"alle"],[17,23,3.022,3.345,"sammen"]],"speaker":"Anne"},{"id":1,"start":4.08,"end":7.285,"text":"I dag skal vi snakke mer om vær og om klima.","zh":"今天我们继续聊聊天气和气候。","words":[[0,1,4.08,4.185,"i"],[2,5,4.22,4.565,"dag"],[6,10,4.58,4.783,"skal"],[11,13,4.783,4.905,"vi"],[14,20,4.94,5.305,"snakke"],[21,24,5.4,5.705,"mer"],[25,27,5.76,5.905,"om"],[28,31,6.02,6.425,"vær"],[32,34,6.48,6.625,"og"],[35,37,6.64,6.785,"om"],[38,43,6.86,7.285,"klima"]],"speaker":"Anne"},{"id":2,"start":8.46,"end":10.045,"text":"Jeg kommer fra Ålesund.","zh":"我来自奥勒松。","words":[[0,3,8.46,8.685,"jeg"],[4,10,9.02,9.303,"kommer"],[11,14,9.303,9.465,"fra"],[15,22,9.56,10.045,"ålesund"]],"speaker":"Anne"},{"id":3,"start":10.92,"end":13.705,"text":"Hva slags klima tror dere at det er der?","zh":"你们觉得那里的气候怎么样？","words":[[0,3,10.92,11.105,"hva"],[4,9,11.2,11.505,"slags"],[10,15,11.52,12.125,"klima"],[16,20,12.3,12.672,"tror"],[21,25,12.672,12.925,"dere"],[26,28,12.96,13.113,"at"],[29,32,13.113,13.265,"det"],[33,35,13.28,13.482,"er"],[36,39,13.482,13.705,"der"]],"speaker":"Anne"},{"id":4,"start":15.05,"end":17.595,"text":"Ålesund er ganske langt nord.","zh":"奥勒松在挺北边的。","words":[[0,7,15.05,15.855,"ålesund"],[8,10,15.93,16.115,"er"],[11,17,16.21,16.795,"ganske"],[18,23,16.83,17.255,"langt"],[24,28,17.27,17.595,"nord"]],"speaker":"Pablo"},{"id":5,"start":18.37,"end":20.775,"text":"Det er sikkert veldig kaldt der om vinteren.","zh":"那里冬天一定很冷。","words":[[0,3,18.37,18.555,"det"],[4,6,18.57,18.755,"er"],[7,14,18.79,19.195,"sikkert"],[15,21,19.23,19.675,"veldig"],[22,27,19.69,20.013,"kaldt"],[28,31,20.013,20.195,"der"],[32,34,20.21,20.335,"om"],[35,43,20.35,20.775,"vinteren"]],"speaker":"Pablo"},{"id":6,"start":21.97,"end":24.635,"text":"Nei, det er faktisk ikke så kaldt.","zh":"不，其实没那么冷。","words":[[0,3,21.97,22.315,"nei"],[5,8,22.91,23.072,"det"],[9,11,23.072,23.255,"er"],[12,19,23.27,23.663,"faktisk"],[20,24,23.663,23.892,"ikke"],[25,27,23.892,24.035,"så"],[28,33,24.09,24.635,"kaldt"]],"speaker":"Anne"},{"id":7,"start":25.45,"end":28.815,"text":"Ålesund ligger ved kysten, og vi har ganske mye regn.","zh":"奥勒松位于海边，我们那里雨水很多。","words":[[0,7,25.45,25.935,"ålesund"],[8,14,26.09,26.373,"ligger"],[15,18,26.373,26.513,"ved"],[19,25,26.513,26.975,"kysten"],[27,29,27.29,27.402,"og"],[30,32,27.402,27.503,"vi"],[33,36,27.503,27.635,"har"],[37,43,27.67,28.175,"ganske"],[44,47,28.19,28.435,"mye"],[48,52,28.47,28.815,"regn"]],"speaker":"Anne"},{"id":8,"start":29.43,"end":31.255,"text":"Men noen ganger kommer det masse snø.","zh":"不过有时也会下很多雪。","words":[[0,3,29.43,29.595,"men"],[4,8,29.61,29.883,"noen"],[9,15,29.883,30.175,"ganger"],[16,22,30.27,30.513,"kommer"],[23,26,30.513,30.655,"det"],[27,32,30.67,30.995,"masse"],[33,36,31.03,31.255,"snø"]],"speaker":"Anne"},{"id":9,"start":32.31,"end":34.315,"text":"Er det mye snø i Polen, Monica?","zh":"莫妮卡，波兰的雪多吗？","words":[[0,2,32.31,32.433,"er"],[3,6,32.433,32.575,"det"],[7,10,32.59,32.855,"mye"],[11,14,32.87,33.115,"snø"],[15,16,33.17,33.275,"i"],[17,22,33.31,33.795,"polen"],[24,30,33.95,34.315,"monica"]],"speaker":"Anne"},{"id":10,"start":35.51,"end":40.835,"text":"Ja, noen steder er det en ganske lang vinter, og barna kan leke i snøen.","zh":"多，有些地方冬天相当长，孩子们可以在雪里玩。","words":[[0,2,35.51,35.655,"ja"],[4,8,36.21,36.515,"noen"],[9,15,36.55,36.935,"steder"],[16,18,37.01,37.133,"er"],[19,22,37.133,37.252,"det"],[23,25,37.252,37.375,"en"],[26,32,37.39,37.955,"ganske"],[33,37,37.97,38.195,"lang"],[38,44,38.21,38.615,"vinter"],[46,48,39.29,39.415,"og"],[49,54,39.43,39.752,"barna"],[55,58,39.752,39.933,"kan"],[59,63,39.933,40.295,"leke"],[64,65,40.33,40.435,"i"],[66,71,40.49,40.835,"snøen"]],"speaker":"Monica"},{"id":11,"start":41.73,"end":43.955,"text":"Men det er ofte regn og kald vind.","zh":"不过也经常下雨、刮冷风。","words":[[0,3,41.73,41.873,"men"],[4,7,41.873,41.972,"det"],[8,10,41.972,42.093,"er"],[11,15,42.093,42.395,"ofte"],[16,20,42.41,42.775,"regn"],[21,23,43.23,43.373,"og"],[24,28,43.373,43.692,"kald"],[29,33,43.692,43.955,"vind"]],"speaker":"Monica"},{"id":12,"start":44.93,"end":46.195,"text":"Jeg liker ikke vinteren!","zh":"我不喜欢冬天！","words":[[0,3,44.93,45.095,"jeg"],[4,9,45.13,45.543,"liker"],[10,14,45.543,45.763,"ikke"],[15,23,45.763,46.195,"vinteren"]],"speaker":"Monica"},{"id":13,"start":47.23,"end":48.155,"text":"Hva med sommeren?","zh":"夏天呢？","words":[[0,3,47.23,47.415,"hva"],[4,7,47.49,47.695,"med"],[8,16,47.73,48.155,"sommeren"]],"speaker":"Pablo"},{"id":14,"start":48.89,"end":49.515,"text":"Hvordan er den?","zh":"夏天怎么样？","words":[[0,7,48.89,49.243,"hvordan"],[8,10,49.243,49.362,"er"],[11,14,49.362,49.515,"den"]],"speaker":"Pablo"},{"id":15,"start":51.03,"end":55.555,"text":"Sommeren er ganske varm mange steder, og vi går på stranda og bader.","zh":"很多地方夏天挺暖和，我们去海滩游泳。","words":[[0,8,51.03,51.515,"sommeren"],[9,11,51.61,51.752,"er"],[12,18,51.752,52.135,"ganske"],[19,23,52.19,52.495,"varm"],[24,29,52.63,52.895,"mange"],[30,36,52.91,53.295,"steder"],[38,40,53.95,54.073,"og"],[41,43,54.073,54.183,"vi"],[44,47,54.183,54.392,"går"],[48,50,54.392,54.535,"på"],[51,58,54.57,54.975,"stranda"],[59,61,54.99,55.133,"og"],[62,67,55.133,55.555,"bader"]],"speaker":"Monica"},{"id":16,"start":57.61,"end":60.475,"text":"Hvordan er klimaet i Irak, Haifa?","zh":"海法，伊拉克的气候怎么样？","words":[[0,7,57.61,58.155,"hvordan"],[8,10,58.37,58.515,"er"],[11,18,58.55,59.155,"klimaet"],[19,20,59.31,59.415,"i"],[21,25,59.51,60.133,"irak"],[27,32,60.133,60.475,"haifa"]],"speaker":"Anne"},{"id":17,"start":61.49,"end":62.975,"text":"Er det ikke veldig varmt der?","zh":"那里不是很热吗？","words":[[0,2,61.49,61.633,"er"],[3,6,61.633,61.742,"det"],[7,11,61.742,61.933,"ikke"],[12,18,61.933,62.215,"veldig"],[19,24,62.23,62.655,"varmt"],[25,28,62.73,62.975,"der"]],"speaker":"Anne"},{"id":18,"start":64.13,"end":68.435,"text":"Jo, noen steder, særlig i Vest-Irak er det veldig varmt og tørt.","zh":"是的，有些地方，尤其是伊拉克西部，非常炎热干燥。","words":[[0,2,64.13,64.275,"jo"],[4,8,64.67,64.933,"noen"],[9,15,64.933,65.315,"steder"],[17,23,66.03,66.382,"særlig"],[24,25,66.382,66.453,"i"],[26,35,66.453,67.123,"vest-irak"],[36,38,67.123,67.213,"er"],[39,42,67.213,67.335,"det"],[43,49,67.35,67.752,"veldig"],[50,55,67.752,68.052,"varmt"],[56,58,68.052,68.142,"og"],[59,63,68.142,68.435,"tørt"]],"speaker":"Haifa"},{"id":19,"start":69.0,"end":70.325,"text":"Det er ørken mange steder.","zh":"很多地方都是沙漠。","words":[[0,3,69.0,69.153,"det"],[4,6,69.153,69.325,"er"],[7,12,69.4,69.782,"ørken"],[13,18,69.782,69.993,"mange"],[19,25,69.993,70.325,"steder"]],"speaker":"Haifa"},{"id":20,"start":71.26,"end":72.305,"text":"Har dere ikke regntid?","zh":"你们没有雨季吗？","words":[[0,3,71.26,71.453,"har"],[4,8,71.453,71.602,"dere"],[9,13,71.602,71.792,"ikke"],[14,21,71.792,72.305,"regntid"]],"speaker":"Safer"},{"id":21,"start":73.0,"end":76.545,"text":"Jo, vi får litt regn i perioden fra desember til mars.","zh":"有，从十二月到三月这段时间会下点雨。","words":[[0,2,73.0,73.165,"jo"],[4,6,73.56,73.685,"vi"],[7,10,73.86,74.032,"får"],[11,15,74.032,74.262,"litt"],[16,20,74.262,74.562,"regn"],[21,22,74.562,74.665,"i"],[23,31,74.72,75.225,"perioden"],[32,35,75.26,75.445,"fra"],[36,44,75.5,76.083,"desember"],[45,48,76.083,76.225,"til"],[49,53,76.26,76.545,"mars"]],"speaker":"Haifa"},{"id":22,"start":77.67,"end":82.575,"text":"I Somalia har vi regntid fra april til september, men det regner vanligvis ikke nok.","zh":"在索马里，我们的雨季从四月持续到九月，可通常雨水不够。","words":[[0,1,77.67,77.775,"i"],[2,9,77.79,78.333,"somalia"],[10,13,78.333,78.472,"har"],[14,16,78.472,78.572,"vi"],[17,24,78.572,79.155,"regntid"],[25,28,79.19,79.393,"fra"],[29,34,79.393,79.815,"april"],[35,38,79.93,80.095,"til"],[39,48,80.11,80.595,"september"],[50,53,81.25,81.392,"men"],[54,57,81.392,81.502,"det"],[58,64,81.502,81.803,"regner"],[65,74,81.803,82.172,"vanligvis"],[75,79,82.172,82.332,"ikke"],[80,83,82.332,82.575,"nok"]],"speaker":"Safer"},{"id":23,"start":83.47,"end":85.395,"text":"Jeg liker veldig godt regnet her i Norge.","zh":"我特别喜欢挪威这里的雨。","words":[[0,3,83.47,83.635,"jeg"],[4,9,83.65,83.955,"liker"],[10,16,83.97,84.352,"veldig"],[17,21,84.352,84.572,"godt"],[22,28,84.572,84.892,"regnet"],[29,32,84.892,85.042,"her"],[33,34,85.042,85.112,"i"],[35,40,85.112,85.395,"norge"]],"speaker":"Safer"},{"id":24,"start":86.27,"end":87.755,"text":"Kanskje jeg skal flytte til Ålesund!","zh":"也许我该搬去奥勒松！","words":[[0,7,86.27,86.583,"kanskje"],[8,11,86.583,86.672,"jeg"],[12,16,86.672,86.833,"skal"],[17,23,86.833,87.175,"flytte"],[24,27,87.19,87.352,"til"],[28,35,87.352,87.755,"ålesund"]],"speaker":"Safer"}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"april":{"lemma":"april","zh":"四月","pos":"名词","ref":"2-025","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"bader":{"lemma":"bade","zh":"游泳；在水中玩；洗澡（依语境）","pos":"动词","ref":"5-071","form":"现在时","clip":null},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"dere":{"lemma":"dere","zh":"你们","pos":"代词","ref":"ty-conversation-4-004","clip":null,"form":"主格"},"desember":{"lemma":"desember","zh":"十二月","pos":"名词","ref":"2-033","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":nul