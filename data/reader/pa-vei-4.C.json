{"id":"pa-vei-4.C","bookId":"pa-vei-textbook","readingId":"4.C","title":"Etter frokost","audio":"audio/pa-vei/4.C.mp3","duration":56.664,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.92,"end":4.225,"text":"C. Etter frokost","zh":"C. 早餐后","words":[[0,1,1.92,2.38,"c"],[3,8,3.26,3.585,"etter"],[9,16,3.64,4.225,"frokost"]]},{"id":1,"start":6.26,"end":9.465,"text":"Etter frokost har familien det travelt.","zh":"早餐之后，一家人都很忙。","words":[[0,5,6.26,6.665,"etter"],[6,13,6.76,7.585,"frokost"],[14,17,7.86,8.065,"har"],[18,26,8.08,8.683,"familien"],[27,30,8.683,8.852,"det"],[31,38,8.852,9.465,"travelt"]]},{"id":2,"start":11.02,"end":12.905,"text":"Marianne børster håret til Emma.","zh":"玛丽安娜给埃玛梳头。","words":[[0,8,11.02,11.585,"marianne"],[9,16,11.62,12.102,"børster"],[17,22,12.102,12.473,"håret"],[23,26,12.473,12.625,"til"],[27,31,12.64,12.905,"emma"]]},{"id":3,"start":15.128,"end":18.153,"text":"Så går Henrik og Emma sammen til bussen.","zh":"然后亨里克和埃玛一起去坐公交车。","words":[[0,2,15.128,15.293,"så"],[3,6,15.448,15.693,"går"],[7,13,15.748,16.333,"henrik"],[14,16,16.348,16.493,"og"],[17,21,16.528,16.813,"emma"],[22,28,17.248,17.611,"sammen"],[29,32,17.611,17.773,"til"],[33,39,17.788,18.153,"bussen"]]},{"id":4,"start":20.748,"end":25.333,"text":"Henrik skal på jobben. Emma skal på skolen.","zh":"亨里克要去上班，埃玛要去上学。","words":[[0,6,20.748,21.273,"henrik"],[7,11,21.308,21.533,"skal"],[12,14,21.588,21.733,"på"],[15,21,21.748,22.113,"jobben"],[23,27,24.088,24.433,"emma"],[28,32,24.528,24.733,"skal"],[33,35,24.768,24.891,"på"],[36,42,24.891,25.333,"skolen"]]},{"id":5,"start":27.608,"end":30.313,"text":"I sekken har hun bøker og matpakke.","zh":"她的书包里装着书和带去吃的午餐。","words":[[0,1,27.608,27.713,"i"],[2,8,27.788,28.293,"sekken"],[9,12,28.328,28.49,"har"],[13,16,28.49,28.653,"hun"],[17,22,28.688,29.253,"bøker"],[23,25,29.548,29.67,"og"],[26,34,29.67,30.313,"matpakke"]]},{"id":6,"start":33.428,"end":35.233,"text":"Marianne har det også travelt.","zh":"玛丽安娜也很忙。","words":[[0,8,33.428,34.07,"marianne"],[9,12,34.07,34.21,"har"],[13,16,34.21,34.353,"det"],[17,21,34.368,34.693,"også"],[22,29,34.708,35.233,"travelt"]]},{"id":7,"start":37.848,"end":39.313,"text":"Først rydder hun bordet.","zh":"她先收拾餐桌。","words":[[0,5,37.848,38.333,"først"],[6,12,38.468,38.751,"rydder"],[13,16,38.751,38.893,"hun"],[17,23,38.948,39.313,"bordet"]]},{"id":8,"start":41.928,"end":43.413,"text":"Etterpå pusser hun tennene.","zh":"然后刷牙。","words":[[0,7,41.928,42.493,"etterpå"],[8,14,42.548,42.85,"pusser"],[15,18,42.85,42.973,"hun"],[19,26,42.988,43.413,"tennene"]]},{"id":9,"start":45.648,"end":48.333,"text":"Så vasker hun Jonas og tar på ham klær.","zh":"接着她给约纳斯洗漱、穿衣服。","words":[[0,2,45.648,45.793,"så"],[3,9,45.848,46.26,"vasker"],[10,13,46.26,46.413,"hun"],[14,19,46.428,46.913,"jonas"],[20,22,47.268,47.41,"og"],[23,26,47.41,47.673,"tar"],[27,29,47.688,47.8,"på"],[30,33,47.8,47.973,"ham"],[34,38,48.008,48.333,"klær"]]},{"id":10,"start":50.268,"end":54.913,"text":"Marianne kjører Jonas til barnehagen, og så kjører hun til jobben.","zh":"玛丽安娜开车送约纳斯去幼儿园，然后开车去上班。","words":[[0,8,50.268,50.833,"marianne"],[9,15,50.868,51.27,"kjører"],[16,21,51.27,51.701,"jonas"],[22,25,51.701,51.853,"til"],[26,36,51.868,52.453,"barnehagen"],[38,40,53.468,53.613,"og"],[41,43,53.628,53.773,"så"],[44,50,53.908,54.26,"kjører"],[51,54,54.26,54.41,"hun"],[55,58,54.41,54.57,"til"],[59,65,54.57,54.913,"jobben"]]}],"lexicon":{"barnehagen":{"lemma":"barnehage","zh":"幼儿园","pos":"名词","ref":"2-044","form":"单数定指","clip":null},"bordet":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","form":"单数定指","clip":null},"bussen":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","form":"单数定指","clip":null},"bøker":{"lemma":"bok","zh":"书","pos":"名词","ref":"pa-vei-4-080","form":"复数","clip":null},"børster":{"lemma":"børste","pos":"动词","zh":"梳；刷","ref":null,"clip":null,"form":"现在时"},"c":{"lemma":"C","pos":"字母","zh":"字母 C","ref":null,"clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"emma":{"lemma":"Emma","pos":"专名","zh":"艾玛（人名）","ref":null,"clip":null},"etter":{"lemma":"etter","zh":"之后","pos":"介词","ref":"3-062","clip":null},"etterpå":{"lemma":"etterpå","zh":"之后","pos":"副词","ref":"4-030","clip":null},"familien":{"lemma":"familie","zh":"家庭","pos":"名词","ref":"2-056","form":"单数定指","clip":null},"frokost":{"lemma":"frokost","zh":"早餐","pos":"名词","ref":"ty-conversation-9-012","clip":null},"først":{"lemma":"først","zh":"首先；先；在最前面","pos":"副词","ref":"2-094","clip":null},"går":{"lemma":"gå","pos":"动词","zh":"走；去；（车）开行","ref":null,"clip":null,"form":"现在时"},"ham":{"lemma":"han","zh":"他","pos":"代词","ref":"ty-conversation-8-007","clip":null,"form":"宾格"},"har":{"lemma":"ha","zh":"有；拥有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时"},"henrik":{"lemma":"Henrik","pos":"专名","zh":"亨里克（人名）","ref":null,"clip":null},"hun":{"lemma":"hun","zh":"她","pos":"代词","ref":"ty-conversation-8-010","clip":null,"form":"主格"},"håret":{"lemma":"hår","zh":"头发","pos":"名词","ref":"8-050","form":"单数定指","clip":null},"i":{"lemma":"i","pos":"介词","zh":"在；于","ref":null,"clip":null},"jobben":{"lemma":"jobb","zh":"工作","pos":"名词","ref":"ty-conversation-7-010","clip":null,"form":"单数定指"},"jonas":{"lemma":"Jonas","pos":"专名","zh":"约纳斯（人名）","ref":null,"clip":null},"kjører":{"lemma":"kjøre","zh":"开车；驾驶（kjøre 的现在时）","pos":"动词","ref":"pa-vei-4-088","form":"现在时","clip":null},"klær":{"lemma":"klær","zh":"衣服","pos":"名词","ref":"8-059","clip":null},"marianne":{"lemma":"Marianne","pos":"专名","zh":"玛丽安娜（人名）","ref":null,"clip":null},"matpakke":{"lemma":"matpakke","zh":"自带便当；盒饭","pos":"名词","ref":"4-031","clip":null},"og":{"lemma":"og","zh":"和；（Og du?）那你呢","pos":"连词","ref":"ty-conversation-1-021","clip":null},"også":{"lemma":"også","zh":"也","pos":"副词","ref":"ty-conversation-3-010","clip":null},"pusser":{"lemma":"pusse","pos":"动词","form":"现在时","zh":"装修（pusse opp）；刷（pusse tennene：刷牙）","ref":null,"clip":null},"på":{"lemma":"på","zh":"在","pos":"介词","ref":"ty-conversation