{"id":"3.5","title":"Yrkestekst: Jeg er bilmekaniker","audio":"audio/3.5.mp3","duration":50.17,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.96,"text":"3.5 Yrke: Jeg er bilmekaniker","heading":true,"zh":"3.5 职业：我是汽车修理工","words":[[0,3,0.15,1.08,"3.5"],[4,8,1.83,2.59,"yrke"],[10,13,3.76,4.28,"jeg"],[14,16,4.28,4.66,"er"],[17,29,4.66,5.88,"bilmekaniker"]]},{"id":1,"start":7.68,"end":11.6,"text":"Jeg heter Bjørnar og er bilmekaniker.","zh":"我叫比约纳尔，是汽车修理工。","words":[[0,3,7.76,8.08,"jeg"],[4,9,8.08,8.42,"heter"],[10,17,8.42,9.16,"bjørnar"],[18,20,9.16,10.1,"og"],[21,23,10.1,10.34,"er"],[24,36,10.34,11.52,"bilmekaniker"]]},{"id":2,"start":12.65,"end":15.92,"text":"Jeg jobber på et verksted sammen med en kollega.","zh":"我和一个同事在一家修车厂工作。","words":[[0,3,12.73,13.02,"jeg"],[4,10,13.02,13.38,"jobber~003ddb6d77e6"],[11,13,13.38,13.66,"på"],[14,16,13.66,13.82,"et~054dde72f37b"],[17,25,13.82,14.44,"verksted"],[26,32,14.44,14.98,"sammen"],[33,36,14.98,15.08,"med"],[37,39,15.08,15.24,"en~a939a9e56dc5"],[40,47,15.24,15.84,"kollega"]]},{"id":3,"start":16.76,"end":18.39,"text":"Han heter Øystein.","zh":"他叫奥于斯坦。","words":[[0,3,16.84,17.1,"han"],[4,9,17.1,17.42,"heter"],[10,17,17.42,18.31,"øystein"]]},{"id":4,"start":19.14,"end":20.93,"text":"Vi reparerer biler.","zh":"我们修理汽车。","words":[[0,2,19.22,19.48,"vi"],[3,12,19.48,20.18,"reparerer"],[13,18,20.18,20.85,"biler"]]},{"id":5,"start":21.84,"end":23.19,"text":"Jeg liker jobben.","zh":"我喜欢这份工作。","words":[[0,3,21.92,22.14,"jeg"],[4,9,22.14,22.62,"liker"],[10,16,22.62,23.11,"jobben"]]},{"id":6,"start":25.04,"end":28.62,"text":"Skal vi ta pause nå? Jeg er sulten.","speaker":"Øystein","zh":"我们现在休息一下好吗？我饿了。","words":[[0,4,25.12,25.46,"skal~d1b9dc119407"],[5,7,25.46,25.68,"vi"],[8,10,25.68,25.92,"ta~7727c1b09766"],[11,16,25.92,26.26,"pause"],[17,19,26.26,26.58,"nå~d531d47a7712"],[21,24,27.44,27.82,"jeg"],[25,27,27.82,27.96,"er"],[28,34,27.96,28.54,"sulten"]]},{"id":7,"start":29.5,"end":32.73,"text":"Ja, nå må vi spise. Vil du ha kaffe?","speaker":"Bjørnar","zh":"好，现在我们得吃点东西了。你要咖啡吗？","words":[[0,2,29.58,29.79,"ja"],[4,6,29.89,30.09,"nå~d531d47a7712"],[7,9,30.09,30.27,"må"],[10,12,30.27,30.41,"vi"],[13,18,30.41,30.73,"spise"],[20,23,31.71,31.99,"vil"],[24,26,31.99,32.11,"du"],[27,29,32.11,32.21,"ha~7724ec04e04d"],[30,35,32.21,32.65,"kaffe"]]},{"id":8,"start":33.39,"end":34.19,"text":"Ja, takk.","speaker":"Øystein","zh":"好的，谢谢。","words":[[0,2,33.47,33.69,"ja"],[4,8,33.69,34.11,"takk"]]},{"id":9,"start":35.01,"end":35.87,"text":"Vær så god.","speaker":"Bjørnar","zh":"给你。","words":[[0,3,35.09,35.33,"vær~2378ba4e3ccb"],[4,6,35.33,35.47,"så~972c2610db62"],[7,10,35.47,35.79,"god~3b9f14bf3b28"]]},{"id":10,"start":35.88,"end":42.71,"text":"Klokka er halv fire. Nå må jeg dra hjem. Jeg må hente barna.","speaker":"Bjørnar","zh":"现在三点半了。我得回家了，我得去接孩子。","words":[[0,6,37.39,38.43,"klokka"],[7,9,38.43,38.53,"er"],[10,14,38.53,38.77,"halv~afaec9028f69"],[15,19,38.77,38.95,"fire~b55c2bdbcdef"],[21,23,39.67,40.11,"nå~d531d47a7712"],[24,26,40.11,40.23,"må"],[27,30,40.23,40.37,"jeg"],[31,34,40.37,40.65,"dra"],[35,39,40.65,40.93,"hjem~3f5fbf6a493e"],[41,44,41.47,41.65,"jeg"],[45,47,41.65,41.77,"må"],[48,53,41.77,42.07,"hente"],[54,59,42.07,42.63,"barna"]]},{"id":11,"start":43.49,"end":46.49,"text":"Jeg skal også dra. Takk for i dag!","speaker":"Øystein","zh":"我也要走了。今天谢谢了！","words":[[0,3,43.57,43.85,"jeg"],[4,8,43.85,44.17,"skal"],[9,13,44.17,44.49,"også"],[14,17,44.49,44.75,"dra"],[19,23,45.51,45.89,"takk"],[24,27,45.89,46.01,"for~e2266a025d60"],[28,29,46.01,46.09,"i~de136e71704d"],[30,33,46.09,46.41,"dag~83a758a6ca25"]]},{"id":12,"start":47.16,"end":49.5,"text":"Takk for i dag! Vi ses i morgen.","speaker":"Bjørnar","zh":"今天谢谢了！明天见。","words":[[0,4,47.24,47.43,"takk"],[5,8,47.43,47.49,"for~e2266a025d60"],[9,10,47.49,47.59,"i~de136e71704d"],[11,14,47.59,47.81,"dag~83a758a6ca25"],[16,18,48.27,48.53,"vi"],[19,22,48.53,48.83,"ses~50e7a837d7a3"],[23,24,48.83,49.07,"i~46dcc9198d6d"],[25,31,49.07,49.42,"morgen~a09fa253039f"