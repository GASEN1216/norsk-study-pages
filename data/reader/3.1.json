{"id":"3.1","title":"De forteller om familien","audio":"audio/3.1.mp3","duration":160.64,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.33,"text":"3.1 De forteller om familien","heading":true,"zh":"3.1 他们讲述自己的家庭","words":[[0,3,0.15,1.31,"3.1"],[4,6,2.93,3.31,"de"],[7,16,3.31,3.89,"forteller"],[17,19,3.89,4.35,"om~52c0bdc828db"],[20,28,4.35,5.25,"familien"]]},{"id":1,"start":7.16,"end":13.55,"text":"Yousef er fra Syria, men nå bor han i Norge.","zh":"优素福来自叙利亚，但他现在住在挪威。","words":[[0,6,7.24,8.01,"yousef"],[7,9,8.01,8.69,"er"],[10,13,8.69,9.05,"fra"],[14,19,9.05,9.47,"syria~2ae242f98808"],[21,24,10.67,11.01,"men"],[25,27,11.01,11.47,"nå~d531d47a7712"],[28,31,11.47,12.29,"bor"],[32,35,12.29,12.63,"han"],[36,37,12.63,12.95,"i"],[38,43,12.95,13.47,"norge~546b56e35dd5"]]},{"id":2,"start":14.64,"end":20.35,"text":"Han er gift, og kona til Yousef heter Leyla.","zh":"他已婚，优素福的妻子叫莱拉。","words":[[0,3,14.72,15.11,"han"],[4,6,15.11,15.29,"er"],[7,11,15.29,15.55,"gift"],[13,15,16.73,17.05,"og"],[16,20,17.05,17.61,"kona"],[21,24,17.61,17.86,"til~8de1a9181f86"],[25,31,17.86,18.66,"yousef"],[32,37,18.66,19.38,"heter"],[38,43,19.38,20.27,"leyla"]]},{"id":3,"start":21.31,"end":29.45,"text":"De har tre barn, ei datter på tolv og to sønner på ti og fire år.","zh":"他们有三个孩子：一个十二岁的女儿，还有两个儿子，分别是十岁和四岁。","words":[[0,2,21.39,21.96,"de"],[3,6,21.96,22.3,"har"],[7,10,22.3,22.75,"tre"],[11,15,22.75,23.14,"barn"],[17,19,24.34,24.54,"ei~47aa2d18e376"],[20,26,24.54,25.14,"datter"],[27,29,25.14,25.39,"på~f81b9c7a500b"],[30,34,25.39,25.95,"tolv"],[35,37,26.48,26.57,"og"],[38,40,26.57,26.91,"to"],[41,47,26.91,27.43,"sønner"],[48,50,27.43,27.71,"på~f81b9c7a500b"],[51,53,27.71,28.07,"ti"],[54,56,28.07,28.39,"og"],[57,61,28.39,28.77,"fire"],[62,64,28.77,29.37,"år"]]},{"id":4,"start":30.06,"end":38.94,"text":"Dattera og en sønn går på skolen, og en sønn går i barnehagen.","zh":"女儿和一个儿子在上学，另一个儿子在上幼儿园。","words":[[0,7,30.41,31.87,"dattera"],[8,10,31.87,32.19,"og"],[11,13,32.19,32.75,"en~a939a9e56dc5"],[14,18,32.75,33.27,"sønn"],[19,22,33.27,33.73,"går~076be03169c2"],[23,25,33.73,33.97,"på~27b87af3cc0f"],[26,32,33.97,34.51,"skolen"],[34,36,35.69,35.79,"og"],[37,39,35.79,36.29,"en~a939a9e56dc5"],[40,44,36.29,36.85,"sønn"],[45,48,36.85,37.61,"går~c6b32fb0bbf8"],[49,50,37.61,37.93,"i~d9f93ce9bf9a"],[51,61,37.93,38.86,"barnehagen"]]},{"id":5,"start":39.63,"end":47.59,"text":"Yousef har ei søster i Kristiansand og to brødre i Tyskland.","zh":"优素福有一个姐妹在克里斯蒂安桑，还有两个兄弟在德国。","words":[[0,6,40.3,41.4,"yousef"],[7,10,41.4,41.76,"har"],[11,13,41.76,42.2,"ei~47aa2d18e376"],[14,20,42.2,42.76,"søster"],[21,22,42.76,43.12,"i"],[23,35,43.12,43.94,"kristiansand"],[36,38,43.94,44.99,"og"],[39,41,45.2,45.58,"to"],[42,48,45.58,46.26,"brødre"],[49,50,46.26,46.81,"i"],[51,59,46.81,47.51,"tyskland~287b03959be2"]]},{"id":6,"start":49.19,"end":53.15,"text":"Foreldrene til Yousef bor i Libanon.","zh":"优素福的父母住在黎巴嫩。","words":[[0,10,49.27,49.99,"foreldrene"],[11,14,49.99,50.26,"til~8de1a9181f86"],[15,21,50.26,51.08,"yousef"],[22,25,51.08,51.9,"bor"],[26,27,51.9,52.26,"i"],[28,35,52.26,53.07,"libanon"]]},{"id":7,"start":55.84,"end":57.36,"text":"Håvard forteller:","zh":"霍瓦尔讲述：","words":[[0,6,55.92,56.5,"håvard"],[7,16,56.5,57.28,"forteller"]]},{"id":8,"start":58.64,"end":61.29,"text":"Jeg bor sammen med Marit.","zh":"我和玛丽特住在一起。","words":[[0,3,58.72,59.14,"jeg"],[4,7,59.14,59.56,"bor"],[8,14,59.56,60.28,"sammen"],[15,18,60.28,60.46,"med"],[19,24,60.46,61.21,"marit"]]},{"id":9,"start":62.58,"end":64.2,"text":"Vi har ikke barn.","zh":"我们没有孩子。","words":[[0,2,62.66,62.94,"vi"],[3,6,62.94,63.24,"har"],[7,11,63.24,63.64,"ikke"],[12,16,63.64,64.12,"barn"]]},{"id":10,"start":65.33,"end":68.02,"text":"Mamma og pappa bor i Bergen.","zh":"我妈妈和爸爸住在卑尔根。","words":[[0,5,65.41,65.94,"mamma"],[6,8,65.94,66.11,"og"],[9,14,66.11,66.5,"pappa"],[15,18,66.5,67.14,"bor"],[19,20,67.14,67.36,"i"],[21,27,67.36,67.94,"bergen"]]},{"id":11,"start":69.69,"end":73.44,"text":"Mora og faren til Marit bor i Trondheim.","zh":"玛丽特的妈妈和爸爸住在特隆赫姆。","words":[[0,4,69.77,70.23,"mora"],[5,7,70.23,70.64,"og"],[8,13,70.64,71.11,"faren"],[14,17,71.11,71.25,"til~8de1a9181f86"],[18,23,71.25,71.8,"marit"],[24,27,71.8,72.25,"bor"],[28,29,72.25,72.45,"i"],[30,39,72.45,73.36,"trondheim"]]},{"id":12,"start":73.99,"end":76.52,"text":"Jeg har ikke søsken.","zh":"我没有兄弟姐妹。","words":[[0,3,74.59,75.25,"jeg"],[4,7,75.25,75.49,"har"],[8,12,75.49,75.79,"ikke"],[13,19,75.79,76.44,"søsken"]]},{"id":13,"start":76.82,"end":82.11,"text":"Jeg er enebarn, men Marit har to søstre.","zh":"我是独生子，但玛丽特有两个姐妹。","words":[[0,3,77.39,77.97,"jeg"],[4,6,77.97,78.42,"er"],[7,14,78.42,79.25,"enebarn"],[16,19,79.83,80.17,"men"],[20,25,80.17,80.69,"marit"],[26,29,80.69,81.14,"har"],[30,32,81.14,81.41,"to"],[33,39,81.41,82.03,"søstre"]]},{"id":14,"start":84.36,"end":87.41,"text":"Søstrene til Marit studerer i Oslo.","zh":"玛丽特的姐妹们在奥斯陆上大学。","words":[[0,8,84.44,85.03,"søstrene"],[9,12,85.03,85.33,"til~8de1a9181f86"],[13,18,85.33,85.83,"marit"],[19,27,85.83,86.45,"studerer"],[28,29,86.45,86.78,"i"],[30,34,86.78,87.33,"oslo"]]},{"id":15,"start":89.02,"end":91.51,"text":"Jeg har ei bestemor i Bergen.","zh":"我在卑尔根有一位（外）祖母。","words":[[0,3,89.09,89.37,"jeg"],[4,7,89.37,89.73,"har"],[8,10,89.73,89.97,"ei~47aa2d18e376"],[11,19,89.97,90.57,"bestemor"],[20,21,90.57,90.83,"i"],[22,28,90.83,91.43,"bergen"]]},{"id":16,"start":92.58,"end":95.0,"text":"Hun er 79 år.","zh":"她 79 岁。","words":[[0,3,92.66,93.04,"hun"],[4,6,93.04,93.52,"er"],[7,9,93.52,94.34,"79"],[10,12,94.34,94.92,"år"]]},{"id":17,"start":96.43,"end":99.5,"text":"Besteforeldrene til Marit er døde.","zh":"玛丽特的（外）祖父母已经去世了。","words":[[0,15,96.51,97.42,"besteforeldrene"],[16,19,97.42,97.75,"til~8de1a9181f86"],[20,25,97.75,98.34,"marit"],[26,28,98.34,98.92,"er"],[29,33,98.92,99.42,"døde~5b4ff2ce979e"]]},{"id":18,"start":101.06,"end":106.62,"text":"Vi besøker familien i feriene, og de besøker oss noen ganger.","zh":"我们假期里去看望家人，他们有时也来看我们。","words":[[0,2,101.14,101.3,"vi"],[3,10,101.3,101.92,"besøker"],[11,19,101.92,102.56,"familien"],[20,21,102.56,102.84,"i~b41765e2dfcc"],[22,29,102.84,103.34,"feriene"],[31,33,104.16,104.4,"og"],[34,36,104.4,104.62,"de"],[37,44,104.62,105.18,"besøker"],[45,48,105.18,105.56,"oss"],[49,53,105.56,106.08,"noen~c766e2ef794d"],[54,60,106.08,106.55,"ganger~cc17bde91843"]]},{"id":19,"start":111.25,"end":112.91,"text":"Viola forteller:","zh":"维奥拉讲述：","words":[[0,5,111.33,111.92,"viola"],[6,15,111.92,112.83,"forteller"]]},{"id":20,"start":114.48,"end":116.87,"text":"Jeg har ikke familie i Norge.","zh":"我在挪威没有家人。","words":[[0,3,114.56,114.84,"jeg"],[4,7,114.84,115.14,"har"],[8,12,115.14,115.38,"ikke"],[13,20,115.38,116.1,"familie"],[21,22,116.1,116.28,"i"],[23,28,116.28,116.79,"norge~546b56e35dd5"]]},{"id":21,"start":117.78,"end":121.57,"text":"De bor i Italia, og jeg savner dem.","zh":"他们住在意大利，我很想念他们。","words":[[0,2,117.86,118.02,"de"],[3,6,118.02,118.3,"bor"],[7,8,118.3,118.64,"i"],[9,15,118.64,119.2,"italia"],[17,19,119.96,120.46,"og"],[20,23,120.46,120.64,"jeg"],[24,30,120.64,121.1,"savner"],[31,34,121.1,121.49,"dem"]]},{"id":22,"start":122.79,"end":127.35,"text":"Mamma heter Laura, og pappa heter Luca.","zh":"我妈妈叫劳拉，爸爸叫卢卡。","words":[[0,5,122.87,123.35,"mamma"],[6,11,123.35,123.87,"heter"],[12,17,123.87,124.33,"laura"],[19,21,125.52,125.58,"og"],[22,27,125.58,125.97,"pappa"],[28,33,125.97,126.45,"heter"],[34,38,126.45,127.27,"luca"]]},{"id":23,"start":128.63,"end":130.02,"text":"Jeg har ei søster.","zh":"我有一个姐妹。","words":[[0,3,128.71,128.94,"jeg"],[4,7,128.94,129.14,"har"],[8,10,129.14,129.34,"ei~47aa2d18e376"],[11,17,129.34,129.94,"søster"]]},{"id":24,"start":130.91,"end":132.67,"text":"Hun er sykepleier.","zh":"她是护士。","words":[[0,3,130.99,131.34,"hun"],[4,6,131.34,131.68,"er"],[7,17,131.68,132.59,"sykepleier"]]},{"id":25,"start":133.91,"end":137.9,"text":"Jeg har også en bror, og han jobber som politi.","zh":"我还有一个兄弟，他当警察。","words":[[0,3,133.99,134.17,"jeg"],[4,7,134.17,134.35,"har"],[8,12,134.35,134.69,"også"],[13,15,134.69,134.89,"en~a939a9e56dc5"],[16,20,134.89,135.25,"bror"],[22,24,136.07,136.19,"og"],[25,28,136.19,136.45,"han"],[29,35,136.45,136.77,"jobber~003ddb6d77e6"],[36,39,136.77,137.11,"som~1e3e2be1aae7"],[40,46,137.11,137.82,"politi"]]},{"id":26,"start":139.77,"end":143.71,"text":"Jeg er au pair og bor sammen med en norsk familie.","zh":"我是互惠生（住家保姆），和一个挪威家庭住在一起。","words":[[0,3,139.85,140.12,"jeg"],[4,6,140.12,140.36,"er"],[7,9,140.36,140.56,"au"],[10,14,140.56,140.84,"pair"],[15,17,140.84,141.54,"og"],[18,21,141.54,141.74,"bor"],[22,28,141.74,142.18,"sammen"],[29,32,142.18,142.46,"med"],[33,35,142.46,142.68,"en~a939a9e56dc5"],[36,41,142.68,143.02,"norsk~300c0d0c4f59"],[42,49,143.02,143.63,"familie"]]},{"id":27,"start":145.07,"end":150.06,"text":"Mora i familien er psykolog, og faren er pilot.","zh":"这家的妈妈是心理学家，爸爸是飞行员。","words":[[0,4,145.15,145.52,"mora"],[5,6,145.52,145.88,"i"],[7,15,145.88,146.44,"familien"],[16,18,146.44,146.9,"er"],[19,27,146.9,147.4,"psykolog"],[29,31,148.38,148.47,"og"],[32,37,148.47,148.94,"faren"],[38,40,148.94,149.38,"er"],[41,46,149.38,149.98,"pilot"]]},{"id":28,"start":150.82,"end":152.23,"text":"De jobber mye.","zh":"他们工作很忙。","words":[[0,2,150.9,151.16,"de"],[3,9,151.16,151.56,"jobber~003ddb6d77e6"],[10,13,151.56,152.15,"mye~933c5a923198"]]},{"id":29,"start":153.22,"end":156.78,"text":"De har to sønner på to og fire år.","zh":"他们有两个儿子，分别是两岁和四岁。","words":[[0,2,153.3,153.43,"de"],[3,6,153.43,153.69,"har"],[7,9,153.69,154.05,"to"],[10,16,154.05,154.59,"sønner"],[17,19,154.59,155.21,"på~f81b9c7a500b"],[20,22,155.21,155.5,"to"],[23,25,155.53,155.97,"og"],[26,30,155.97,156.25,"fire"],[31,33,156.25,156.71,"år"]]}],"lexicon":{"3.1":{"lemma":"3.1","zh":"第 3.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"79":{"lemma":"79","zh":"数字 79","pos":"数词","ref":"basics:numbers:syttini","clip":null,"kind":"number"},"au":{"lemma":"au pair","zh":"（au pair）互惠生","pos":"名词","ref":null,"clip":null},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":"pronunci