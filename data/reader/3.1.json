{"id":"3.1","title":"De forteller om familien","audio":"audio/3.1.mp3","duration":160.64,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.33,"text":"3.1 De forteller om familien","heading":true,"zh":"3.1 他们讲述自己的家庭","words":[[0,3,0.15,1.31,"3.1"],[4,6,2.93,3.31,"de"],[7,16,3.31,3.89,"forteller"],[17,19,3.89,4.35,"om~52c0bdc828db"],[20,28,4.35,5.25,"familien"]]},{"id":1,"start":7.2,"end":13.61,"text":"Yousef er fra Syria, men nå bor han i Norge.","zh":"优素福来自叙利亚，但他现在住在挪威。","words":[[0,6,7.26,8.12,"yousef"],[7,9,8.52,8.82,"er"],[10,13,8.82,9.2,"fra"],[14,19,9.2,9.86,"syria~2ae242f98808"],[21,24,10.78,11.22,"men"],[25,27,11.22,11.54,"nå~d531d47a7712"],[28,31,12.08,12.4,"bor"],[32,35,12.4,12.86,"han"],[36,37,12.86,12.98,"i"],[38,43,12.98,13.46,"norge~546b56e35dd5"]]},{"id":2,"start":14.82,"end":20.42,"text":"Han er gift, og kona til Yousef heter Leyla.","zh":"他已婚，优素福的妻子叫莱拉。","words":[[0,3,14.88,15.16,"han"],[4,6,15.16,15.36,"er"],[7,11,15.36,16.02,"gift"],[13,15,16.9,17.22,"og"],[16,20,17.22,17.78,"kona"],[21,24,17.78,17.98,"til~8de1a9181f86"],[25,31,17.98,18.71,"yousef"],[32,37,19.16,19.76,"heter"],[38,43,19.76,20.27,"leyla"]]},{"id":3,"start":21.73,"end":29.5,"text":"De har tre barn, ei datter på tolv og to sønner på ti og fire år.","zh":"他们有三个孩子：一个十二岁的女儿，还有两个儿子，分别是十岁和四岁。","words":[[0,2,21.79,22.1,"de"],[3,6,22.1,22.52,"har"],[7,10,22.52,22.88,"tre"],[11,15,22.88,23.39,"barn"],[17,19,24.42,24.72,"ei~47aa2d18e376"],[20,26,24.72,25.24,"datter"],[27,29,25.24,25.56,"på~f81b9c7a500b"],[30,34,25.56,26.11,"tolv"],[35,37,26.5,26.72,"og"],[38,40,26.72,27.12,"to"],[41,47,27.12,27.62,"sønner"],[48,50,27.62,27.84,"på~f81b9c7a500b"],[51,53,27.84,28.2,"ti"],[54,56,28.32,28.52,"og"],[57,61,28.52,29.06,"fire"],[62,64,29.06,29.35,"år"]]},{"id":4,"start":31.05,"end":39.0,"text":"Dattera og en sønn går på skolen, og en sønn går i barnehagen.","zh":"女儿和一个儿子在上学，另一个儿子在上幼儿园。","words":[[0,7,31.11,31.84,"dattera"],[8,10,31.96,32.26,"og"],[11,13,32.42,32.92,"en~a939a9e56dc5"],[14,18,32.92,33.44,"sønn"],[19,22,33.56,33.86,"går~076be03169c2"],[23,25,33.86,34.08,"på~27b87af3cc0f"],[26,32,34.08,34.76,"skolen"],[34,36,35.64,35.98,"og"],[37,39,35.98,36.5,"en~a939a9e56dc5"],[40,44,36.5,36.99,"sønn"],[45,48,37.44,37.84,"går~c6b32fb0bbf8"],[49,50,37.84,38.02,"i~d9f93ce9bf9a"],[51,61,38.02,38.85,"barnehagen"]]},{"id":5,"start":40.63,"end":47.66,"text":"Yousef har ei søster i Kristiansand og to brødre i Tyskland.","zh":"优素福有一个姐妹在克里斯蒂安桑，还有两个兄弟在德国。","words":[[0,6,40.7,41.56,"yousef"],[7,10,41.56,42.06,"har"],[11,13,42.06,42.32,"ei~47aa2d18e376"],[14,20,42.32,42.98,"søster"],[21,22,42.98,43.22,"i"],[23,35,43.22,44.23,"kristiansand"],[36,38,45.1,45.34,"og"],[39,41,45.34,45.74,"to"],[42,48,45.74,46.45,"brødre"],[49,50,46.76,46.9,"i"],[51,59,46.9,47.52,"tyskland~287b03959be2"]]},{"id":6,"start":49.23,"end":53.21,"text":"Foreldrene til Yousef bor i Libanon.","zh":"优素福的父母住在黎巴嫩。","words":[[0,10,49.29,50.16,"foreldrene"],[11,14,50.16,50.5,"til~8de1a9181f86"],[15,21,50.5,51.23,"yousef"],[22,25,51.74,52.14,"bor"],[26,27,52.14,52.36,"i"],[28,35,52.36,53.06,"libanon"]]},{"id":7,"start":55.88,"end":57.44,"text":"Håvard forteller:","zh":"霍瓦尔讲述：","words":[[0,6,55.94,56.66,"håvard"],[7,16,56.66,57.29,"forteller"]]},{"id":8,"start":58.69,"end":61.35,"text":"Jeg bor sammen med Marit.","zh":"我和玛丽特住在一起。","words":[[0,3,58.75,59.3,"jeg"],[4,7,59.3,59.92,"bor"],[8,14,59.92,60.34,"sammen"],[15,18,60.34,60.58,"med"],[19,24,60.58,61.2,"marit"]]},{"id":9,"start":62.61,"end":64.26,"text":"Vi har ikke barn.","zh":"我们没有孩子。","words":[[0,2,62.67,63.02,"vi"],[3,6,63.02,63.4,"har"],[7,11,63.4,63.74,"ikke"],[12,16,63.74,64.11,"barn"]]},{"id":10,"start":65.37,"end":68.09,"text":"Mamma og pappa bor i Bergen.","zh":"我妈妈和爸爸住在卑尔根。","words":[[0,5,65.43,66.04,"mamma"],[6,8,66.04,66.16,"og"],[9,14,66.16,66.72,"pappa"],[15,18,66.96,67.3,"bor"],[19,20,67.3,67.42,"i"],[21,27,67.42,67.94,"bergen"]]},{"id":11,"start":69.73,"end":73.5,"text":"Mora og faren til Marit bor i Trondheim.","zh":"玛丽特的妈妈和爸爸住在特隆赫姆。","words":[[0,4,69.79,70.52,"mora"],[5,7,70.52,70.76,"og"],[8,13,70.76,71.14,"faren"],[14,17,71.14,71.32,"til~8de1a9181f86"],[18,23,71.32,72.0,"marit"],[24,27,72.12,72.4,"bor"],[28,29,72.4,72.54,"i"],[30,39,72.54,73.35,"trondheim"]]},{"id":12,"start":74.99,"end":76.58,"text":"Jeg har ikke søsken.","zh":"我没有兄弟姐妹。","words":[[0,3,75.05,75.32,"jeg"],[4,7,75.32,75.6,"har"],[8,12,75.6,75.9,"ikke"],[13,19,75.9,76.43,"søsken"]]},{"id":13,"start":77.72,"end":82.18,"text":"Jeg er enebarn, men Marit har to søstre.","zh":"我是独生子，但玛丽特有两个姐妹。","words":[[0,3,77.78,78.24,"jeg"],[4,6,78.24,78.62,"er"],[7,14,78.62,79.54,"enebarn"],[16,19,80.06,80.26,"men"],[20,25,80.26,80.96,"marit"],[26,29,81.06,81.26,"har"],[30,32,81.26,81.54,"to"],[33,39,81.54,82.03,"søstre"]]},{"id":14,"start":84.41,"end":87.5,"text":"Søstrene til Marit studerer i Oslo.","zh":"玛丽特的姐妹们在奥斯陆上大学。","words":[[0,8,84.47,85.22,"søstrene"],[9,12,85.22,85.42,"til~8de1a9181f86"],[13,18,85.42,85.94,"marit"],[19,27,85.94,86.68,"studerer"],[28,29,86.68,86.86,"i"],[30,34,86.86,87.34,"oslo"]]},{"id":15,"start":89.06,"end":91.57,"text":"Jeg har ei bestemor i Bergen.","zh":"我在卑尔根有一位（外）祖母。","words":[[0,3,89.12,89.52,"jeg"],[4,7,89.52,89.86,"har"],[8,10,89.86,90.02,"ei~47aa2d18e376"],[11,19,90.02,90.74,"bestemor"],[20,21,90.74,90.88,"i"],[22,28,90.88,91.42,"bergen"]]},{"id":16,"start":92.73,"end":94.97,"text":"Hun er 79 år.","zh":"她 79 岁。","words":[[0,3,92.8,93.3,"hun"],[4,6,93.3,93.64,"er"],[7,9,93.64,94.52,"79"],[10,12,94.52,94.82,"år"]]},{"id":17,"start":96.47,"end":99.59,"text":"Besteforeldrene til Marit er døde.","zh":"玛丽特的（外）祖父母已经去世了。","words":[[0,15,96.53,97.64,"besteforeldrene"],[16,19,97.64,97.86,"til~8de1a9181f86"],[20,25,97.86,98.56,"marit"],[26,28,98.84,99.02,"er"],[29,33,99.02,99.44,"døde~5b4ff2ce979e"]]},{"id":18,"start":101.1,"end":106.7,"text":"Vi besøker familien i feriene, og de besøker oss noen ganger.","zh":"我们假期里去看望家人，他们有时也来看我们。","words":[[0,2,101.16,101.36,"vi"],[3,10,101.36,102.04,"besøker"],[11,19,102.04,102.76,"familien"],[20,21,102.76,102.92,"i~b41765e2dfcc"],[22,29,102.92,103.6,"feriene"],[31,33,104.28,104.44,"og"],[34,36,104.44,104.68,"de"],[37,44,104.68,105.32,"besøker"],[45,48,105.32,105.82,"oss"],[49,53,105.82,106.14,"noen~c766e2ef794d"],[54,60,106.14,106.55,"ganger~cc17bde91843"]]},{"id":19,"start":111.28,"end":112.97,"text":"Viola forteller:","zh":"维奥拉讲述：","words":[[0,5,111.34,112.24,"viola"],[6,15,112.24,112.82,"forteller"]]},{"id":20,"start":114.52,"end":116.93,"text":"Jeg har ikke familie i Norge.","zh":"我在挪威没有家人。","words":[[0,3,114.58,114.94,"jeg"],[4,7,114.94,115.2,"har"],[8,12,115.2,115.52,"ikke"],[13,20,115.52,116.2,"familie"],[21,22,116.2,116.32,"i"],[23,28,116.32,116.78,"norge~546b56e35dd5"]]},{"id":21,"start":117.82,"end":121.63,"text":"De bor i Italia, og jeg savner dem.","zh":"他们住在意大利，我很想念他们。","words":[[0,2,117.88,118.1,"de"],[3,6,118.1,118.48,"bor"],[7,8,118.48,118.82,"i"],[9,15,118.82,119.58,"italia"],[17,19,120.36,120.48,"og"],[20,23,120.48,120.74,"jeg"],[24,30,120.74,121.18,"savner"],[31,34,121.18,121.48,"dem"]]},{"id":22,"start":122.83,"end":127.41,"text":"Mamma heter Laura, og pappa heter Luca.","zh":"我妈妈叫劳拉，爸爸叫卢卡。","words":[[0,5,122.89,123.56,"mamma"],[6,11,123.56,124.12,"heter"],[12,17,124.12,124.72,"laura"],[19,21,125.5,125.66,"og"],[22,27,125.66,126.22,"pappa"],[28,33,126.22,126.78,"heter"],[34,38,126.78,127.26,"luca"]]},{"id":23,"start":128.66,"end":130.09,"text":"Jeg har ei søster.","zh":"我有一个姐妹。","words":[[0,3,128.72,129.02,"jeg"],[4,7,129.02,129.22,"har"],[8,10,129.22,129.4,"ei~47aa2d18e376"],[11,17,129.4,129.94,"søster"]]},{"id":24,"start":130.97,"end":132.77,"text":"Hun er sykepleier.","zh":"她是护士。","words":[[0,3,131.03,131.54,"hun"],[4,6,131.54,131.84,"er"],[7,17,131.84,132.62,"sykepleier"]]},{"id":25,"start":133.94,"end":137.97,"text":"Jeg har også en bror, og han jobber som politi.","zh":"我还有一个兄弟，他当警察。","words":[[0,3,134.0,134.22,"jeg"],[4,7,134.22,134.42,"har"],[8,12,134.42,134.78,"også"],[13,15,134.78,134.96,"en~a939a9e56dc5"],[16,20,134.96,135.5,"bror"],[22,24,136.1,136.24,"og"],[25,28,136.24,136.58,"han"],[29,35,136.58,136.92,"jobber~003ddb6d77e6"],[36,39,136.92,137.26,"som~1e3e2be1aae7"],[40,46,137.26,137.81,"politi"]]},{"id":26,"start":139.81,"end":143.77,"text":"Jeg er au pair og bor sammen med en norsk familie.","zh":"我是互惠生（住家保姆），和一个挪威家庭住在一起。","words":[[0,3,139.87,140.22,"jeg"],[4,6,140.22,140.46,"er"],[7,9,140.46,140.58,"au"],[10,14,140.58,141.18,"pair"],[15,17,141.46,141.58,"og"],[18,21,141.58,141.86,"bor"],[22,28,141.86,142.36,"sammen"],[29,32,142.36,142.56,"med"],[33,35,142.56,142.7,"en~a939a9e56dc5"],[36,41,142.7,143.08,"norsk~300c0d0c4f59"],[42,49,143.08,143.62,"familie"]]},{"id":27,"start":145.1,"end":150.12,"text":"Mora i familien er psykolog, og faren er pilot.","zh":"这家的妈妈是心理学家，爸爸是飞行员。","words":[[0,4,145.16,145.7,"mora"],[5,6,145.82,145.96,"i"],[7,15,145.96,146.66,"familien"],[16,18,146.82,146.94,"er"],[19,27,146.94,147.74,"psykolog"],[29,31,148.4,148.56,"og"],[32,37,148.56,149.18,"faren"],[38,40,149.3,149.44,"er"],[41,46,149.44,149.97,"pilot"]]},{"id":28,"start":150.93,"end":152.28,"text":"De jobber mye.","zh":"他们工作很忙。","words":[[0,2,150.99,151.24,"de"],[3,9,151.24,151.74,"jobber~003ddb6d77e6"],[10,13,151.74,152.13,"mye~933c5a923198"]]},{"id":29,"start":153.25,"end":156.85,"text":"De har to sønner på to og fire år.","zh":"他们有两个儿子，分别是两岁和四岁。","words":[[0,2,153.31,153.48,"de"],[3,6,153.48,153.88,"har"],[7,9,153.88,154.16,"to"],[10,16,154.16,154.74,"sønner"],[17,19,155.06,155.3,"på~f81b9c7a500b"],[20,22,155.3,155.64,"to"],[23,25,155.9,156.04,"og"],[26,30,156.04,156.46,"fire"],[31,33,156.46,156.7,"år"]]}],"lexicon":{"3.1":{"lemma":"3.1","zh":"第 3.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"79":{"lemma":"79","zh":"数字 79","pos":"数词","ref":"basics:numbers:syttini","clip":null,"kind":"number"},"au":{"lemma":"au pair","zh":"（au pair）互惠生","pos":"名词","ref":null,"clip":null},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":"pronunciation/e43a7ece3a362be44a9e.