{"id":"8.5","title":"Yrkestekst: Jeg er butikkmedarbeider","audio":"audio/8.5.mp3","duration":55.99,"synthetic":true,"sentences":[{"id":0,"start":0.22,"end":1.98,"text":"Jeg er butikkmedarbeider","heading":true,"zh":"我是店员","words":[[0,3,0.28,0.64,"jeg"],[4,6,0.64,0.8,"er"],[7,24,0.8,1.83,"butikkmedarbeider"]]},{"id":1,"start":2.9,"end":5.69,"text":"Jeg er butikkmedarbeider og jobber i en matbutikk.","zh":"我是店员，在一家食品店工作。","words":[[0,3,2.96,3.24,"jeg"],[4,6,3.24,3.38,"er"],[7,24,3.38,4.42,"butikkmedarbeider"],[25,27,4.42,4.54,"og"],[28,34,4.54,4.8,"jobber~003ddb6d77e6"],[35,36,4.8,4.86,"i"],[37,39,4.86,4.94,"en~a939a9e56dc5"],[40,49,4.94,5.54,"matbutikk"]]},{"id":2,"start":6.6,"end":8.93,"text":"Jeg har mange forskjellige oppgaver i butikken.","zh":"我在店里有很多不同的工作任务。","words":[[0,3,6.66,6.8,"jeg"],[4,7,6.8,6.94,"har"],[8,13,6.94,7.22,"mange"],[14,26,7.22,7.68,"forskjellige"],[27,35,7.68,8.18,"oppgaver"],[36,37,8.18,8.3,"i"],[38,46,8.3,8.78,"butikken"]]},{"id":3,"start":9.85,"end":13.94,"text":"Noen dager rydder jeg varer på plass i hyllene, og jeg må kaste gamle varer.","zh":"有些日子我把商品整理摆放到货架上，还得把旧的商品扔掉。","words":[[0,4,9.91,10.26,"noen~c766e2ef794d"],[5,10,10.26,10.62,"dager"],[11,17,10.62,10.84,"rydder"],[18,21,10.84,10.98,"jeg"],[22,27,10.98,11.22,"varer~1e807736579e"],[28,30,11.22,11.32,"på~59a174e0ba7b"],[31,36,11.32,11.56,"plass"],[37,38,11.56,11.64,"i"],[39,46,11.64,12.2,"hyllene"],[48,50,12.56,12.66,"og"],[51,54,12.66,12.78,"jeg"],[55,57,12.78,12.9,"må"],[58,63,12.9,13.2,"kaste"],[64,69,13.2,13.48,"gamle"],[70,75,13.48,13.79,"varer~1e807736579e"]]},{"id":4,"start":14.83,"end":16.04,"text":"Det liker jeg ikke.","zh":"我不喜欢这个。","words":[[0,3,14.89,15.12,"det"],[4,9,15.12,15.42,"liker"],[10,13,15.42,15.56,"jeg"],[14,18,15.56,15.88,"ikke"]]},{"id":5,"start":17.0,"end":18.84,"text":"Jeg må også bestille nye varer.","zh":"我还得订购新货。","words":[[0,3,17.05,17.26,"jeg"],[4,6,17.26,17.42,"må"],[7,11,17.42,17.68,"også"],[12,20,17.68,18.1,"bestille"],[21,24,18.1,18.36,"nye"],[25,30,18.36,18.69,"varer~1e807736579e"]]},{"id":6,"start":19.78,"end":22.71,"text":"Noen dager sitter jeg i kassa og tar betalt for varene.","zh":"有些日子我坐在收银台收款。","words":[[0,4,19.84,20.16,"noen~c766e2ef794d"],[5,10,20.16,20.54,"dager"],[11,17,20.54,20.8,"sitter"],[18,21,20.8,20.88,"jeg"],[22,23,20.88,20.94,"i"],[24,29,20.94,21.42,"kassa"],[30,32,21.42,21.52,"og"],[33,36,21.52,21.66,"tar~456004b27a9b"],[37,43,21.66,22.0,"betalt"],[44,47,22.0,22.14,"for~2b0474af71b1"],[48,54,22.14,22.56,"varene"]]},{"id":7,"start":23.59,"end":26.6,"text":"Jeg trives i jobben, for jeg møter mange mennesker hver dag.","zh":"我很喜欢这份工作，因为我每天能见到很多人。","words":[[0,3,23.64,23.86,"jeg"],[4,10,23.86,24.28,"trives"],[11,12,24.28,24.36,"i"],[13,19,24.36,24.88,"jobben"],[21,24,25.0,25.1,"for~1b22712a94b1"],[25,28,25.1,25.22,"jeg"],[29,34,25.22,25.48,"møter~8f944f539693"],[35,40,25.48,25.74,"mange"],[41,50,25.74,26.12,"mennesker"],[51,55,26.12,26.28,"hver"],[56,59,26.28,26.45,"dag"]]},{"id":8,"start":27.61,"end":33.62,"text":"Nesten alle kundene er hyggelige, men noen kunder hilser ikke på meg i kassa, og noen ganger snakker de i mobiltelefonen.","zh":"几乎所有顾客都很友好，但有些顾客在收银台不跟我打招呼，有时候他们还在打手机。","words":[[0,6,27.66,28.12,"nesten"],[7,11,28.12,28.36,"alle~6873d9584096"],[12,19,28.36,28.72,"kundene"],[20,22,28.72,28.84,"er"],[23,32,28.84,29.45,"hyggelige"],[34,37,29.62,29.76,"men"],[38,42,29.76,29.92,"noen~c766e2ef794d"],[43,49,29.92,30.18,"kunder"],[50,56,30.18,30.5,"hilser"],[57,61,30.5,30.66,"ikke"],[62,64,30.66,30.78,"på~588ffe6c89d8"],[65,68,30.78,30.9,"meg"],[69,70,30.9,30.96,"i"],[71,76,30.96,31.45,"kassa"],[78,80,31.66,31.76,"og"],[81,85,31.76,31.94,"noen~c766e2ef794d"],[86,92,31.94,32.24,"ganger"],[93,100,32.24,32.52,"snakker"],[101,103,32.52,32.6,"de"],[104,105,32.6,32.66,"i~bab7f108408a"],[106,120,32.66,33.47,"mobiltelefonen"]]},{"id":9,"start":34.51,"end":37.09,"text":"Da blir jeg litt irritert, for det er uhøflig.","zh":"这时我会有点恼火，因为这样很不礼貌。","words":[[0,2,34.57,34.78,"da~fba15067726f"],[3,7,34.78,34.94,"blir"],[8,11,34.94,35.08,"jeg"],[12,16,35.08,35.28,"litt~54360be2a478"],[17,25,35.28,36.1,"irritert"],[27,30,36.1,36.2,"for~1b22712a94b1"],[31,34,36.2,36.32,"det"],[35,37,36.32,36.44,"er"],[38,45,36.44,36.94,"uhøflig"]]},{"id":10,"start":37.98,"end":39.68,"text":"I kassa på matbutikken","subheading":true,"zh":"在食品店的收银台","words":[[0,1,38.05,38.22,"i"],[2,7,38.22,38.68,"kassa"],[8,10,38.68,38.82,"på"],[11,22,38.82,39.53,"matbutikken"]]},{"id":11,"start":40.58,"end":41.81,"text":"Trenger du pose?","speaker":"Butikkmedarbeider","zh":"你需要袋子吗？","words":[[0,7,40.64,41.04,"trenger"],[8,10,41.04,41.18,"du"],[11,15,41.18,41.66,"pose"]]},{"id":12,"start":42.7,"end":43.98,"text":"Nei, takk.","speaker":"Kunde","zh":"不用，谢谢。","words":[[0,3,42.77,43.26,"nei"],[5,9,43.44,43.84,"takk"]]},{"id":13,"start":44.9,"end":48.89,"text":"Da blir det 59 kroner. Vil du ha kvittering?","speaker":"Butikkmedarbeider","zh":"那一共是59克朗。要收据吗？","words":[[0,2,44.96,45.24,"da~407a644a9bc0"],[3,7,45.24,45.42,"blir~8e63c9b279ae"],[8,11,45.42,45.54,"det"],[12,14,45.54,46.1,"59"],[15,21,46.1,46.67,"kroner"],[23,26,47.68,47.86,"vil"],[27,29,47.86,47.98,"du"],[30,32,47.98,48.16,"ha~ca5edb8b1cdb"],[33,43,48.16,48.74,"kvittering"]]},{"id":14,"start":49.84,"end":51.1,"text":"Ja, takk.","speaker":"Kunde","zh":"要，谢谢。","words":[[0,2,49.91,50.31,"ja"],[4,8,50.56,50.95,"takk"]]},{"id":15,"start":52.05,"end":52.91,"text":"God helg!","speaker":"Butikkmedarbeider","zh":"周末愉快！","words":[[0,3,52.12,52.44,"god"],[4,8,52.44,52.77,"helg"]]},{"id":16,"start":53.8,"end":55.2,"text":"Takk i like måte!","speaker":"Kunde","zh":"谢谢，你也是！","words":[[0,4,53.87,54.2,"takk"],[5,6,54.2,54.3,"i~d931e4e5d506"],[7,11,54.3,54.62,"like~96c08a97a401"],[12,16,54.62,55.05,"måte~e6eb4b458deb"]]}],"lexicon":{"59":{"lemma":"59","zh":"数字 59","pos":"数词","ref":"basics:numbers:femtini","clip":null,"kind":"number"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"be