{"id":"8.5","title":"Yrkestekst: Jeg er butikkmedarbeider","audio":"audio/8.5.mp3","duration":55.99,"synthetic":true,"sentences":[{"id":0,"start":0.18,"end":1.9,"text":"Jeg er butikkmedarbeider","heading":true,"zh":"我是店员","words":[[0,3,0.26,0.48,"jeg"],[4,6,0.48,0.72,"er"],[7,24,0.72,1.82,"butikkmedarbeider"]]},{"id":1,"start":2.86,"end":5.62,"text":"Jeg er butikkmedarbeider og jobber i en matbutikk.","zh":"我是店员，在一家食品店工作。","words":[[0,3,2.94,3.13,"jeg"],[4,6,3.13,3.31,"er"],[7,24,3.31,4.29,"butikkmedarbeider"],[25,27,4.29,4.49,"og"],[28,34,4.49,4.73,"jobber~003ddb6d77e6"],[35,36,4.73,4.85,"i"],[37,39,4.85,4.95,"en~a939a9e56dc5"],[40,49,4.95,5.54,"matbutikk"]]},{"id":2,"start":6.56,"end":8.86,"text":"Jeg har mange forskjellige oppgaver i butikken.","zh":"我在店里有很多不同的工作任务。","words":[[0,3,6.64,6.78,"jeg"],[4,7,6.78,6.88,"har"],[8,13,6.88,7.08,"mange"],[14,26,7.08,7.62,"forskjellige"],[27,35,7.62,8.1,"oppgaver"],[36,37,8.1,8.24,"i"],[38,46,8.24,8.78,"butikken"]]},{"id":3,"start":9.81,"end":13.84,"text":"Noen dager rydder jeg varer på plass i hyllene, og jeg må kaste gamle varer.","zh":"有些日子我把商品整理摆放到货架上，还得把旧的商品扔掉。","words":[[0,4,9.89,10.21,"noen~c766e2ef794d"],[5,10,10.21,10.57,"dager"],[11,17,10.57,10.81,"rydder"],[18,21,10.81,10.89,"jeg"],[22,27,10.89,11.15,"varer~1e807736579e"],[28,30,11.15,11.29,"på~59a174e0ba7b"],[31,36,11.29,11.47,"plass"],[37,38,11.47,11.61,"i"],[39,46,11.61,12.01,"hyllene"],[48,50,12.01,12.28,"og"],[51,54,12.28,12.54,"jeg"],[55,57,12.54,12.8,"må"],[58,63,12.8,13.07,"kaste"],[64,69,13.07,13.43,"gamle"],[70,75,13.43,13.76,"varer~1e807736579e"]]},{"id":4,"start":14.81,"end":15.94,"text":"Det liker jeg ikke.","zh":"我不喜欢这个。","words":[[0,3,14.89,15.06,"det"],[4,9,15.06,15.4,"liker"],[10,13,15.4,15.52,"jeg"],[14,18,15.52,15.86,"ikke"]]},{"id":5,"start":16.96,"end":18.75,"text":"Jeg må også bestille nye varer.","zh":"我还得订购新货。","words":[[0,3,17.04,17.23,"jeg"],[4,6,17.23,17.33,"må"],[7,11,17.33,17.59,"også"],[12,20,17.59,17.99,"bestille"],[21,24,17.99,18.27,"nye"],[25,30,18.27,18.67,"varer~1e807736579e"]]},{"id":6,"start":19.74,"end":22.63,"text":"Noen dager sitter jeg i kassa og tar betalt for varene.","zh":"有些日子我坐在收银台收款。","words":[[0,4,19.82,20.12,"noen~c766e2ef794d"],[5,10,20.12,20.46,"dager"],[11,17,20.46,20.74,"sitter"],[18,21,20.74,20.86,"jeg"],[22,23,20.86,20.94,"i"],[24,29,20.94,21.18,"kassa"],[30,32,21.18,21.5,"og"],[33,36,21.5,21.5,"tar~456004b27a9b"],[37,43,21.5,21.96,"betalt"],[44,47,21.96,22.1,"for~2b0474af71b1"],[48,54,22.1,22.55,"varene"]]},{"id":7,"start":23.55,"end":26.55,"text":"Jeg trives i jobben, for jeg møter mange mennesker hver dag.","zh":"我很喜欢这份工作，因为我每天能见到很多人。","words":[[0,3,23.64,23.77,"jeg"],[4,10,23.77,24.15,"trives"],[11,12,24.15,24.33,"i"],[13,19,24.33,24.65,"jobben"],[21,24,25.01,25.11,"for~1b22712a94b1"],[25,28,25.11,25.17,"jeg"],[29,34,25.17,25.41,"møter~8f944f539693"],[35,40,25.41,25.59,"mange"],[41,50,25.59,26.09,"mennesker"],[51,55,26.09,26.25,"hver"],[56,59,26.25,26.47,"dag"]]},{"id":8,"start":27.57,"end":33.55,"text":"Nesten alle kundene er hyggelige, men noen kunder hilser ikke på meg i kassa, og noen ganger snakker de i mobiltelefonen.","zh":"几乎所有顾客都很友好，但有些顾客在收银台不跟我打招呼，有时候他们还在打手机。","words":[[0,6,27.65,28.02,"nesten"],[7,11,28.02,28.26,"alle~6873d9584096"],[12,19,28.26,28.62,"kundene"],[20,22,28.62,28.78,"er"],[23,32,28.78,29.24,"hyggelige"],[34,37,29.62,29.72,"men"],[38,42,29.72,29.88,"noen~c766e2ef794d"],[43,49,29.88,30.06,"kunder"],[50,56,30.06,30.48,"hilser"],[57,61,30.48,30.62,"ikke"],[62,64,30.62,30.72,"på~588ffe6c89d8"],[65,68,30.72,30.86,"meg"],[69,70,30.86,30.94,"i"],[71,76,30.94,31.26,"kassa"],[78,80,31.64,31.72,"og"],[81,85,31.72,31.88,"noen~c766e2ef794d"],[86,92,31.88,32.16,"ganger"],[93,100,32.16,32.48,"snakker"],[101,103,32.48,32.6,"de"],[104,105,32.6,32.6,"i~bab7f108408a"],[106,120,32.6,33.47,"mobiltelefonen"]]},{"id":9,"start":34.47,"end":37.02,"text":"Da blir jeg litt irritert, for det er uhøflig.","zh":"这时我会有点恼火，因为这样很不礼貌。","words":[[0,2,34.55,34.74,"da~fba15067726f"],[3,7,34.74,34.92,"blir"],[8,11,34.92,35.02,"jeg"],[12,16,35.02,35.2,"litt~54360be2a478"],[17,25,35.2,35.82,"irritert"],[27,30,36.08,36.2,"for~1b22712a94b1"],[31,34,36.2,36.32,"det"],[35,37,36.32,36.38,"er"],[38,45,36.38,36.94,"uhøflig"]]},{"id":10,"start":37.95,"end":39.61,"text":"I kassa på matbutikken","subheading":true,"zh":"在食品店的收银台","words":[[0,1,38.03,38.17,"i"],[2,7,38.17,38.59,"kassa"],[8,10,38.69,38.77,"på"],[11,22,38.77,39.53,"matbutikken"]]},{"id":11,"start":40.55,"end":41.74,"text":"Trenger du pose?","speaker":"Butikkmedarbeider","zh":"你需要袋子吗？","words":[[0,7,40.63,41.01,"trenger"],[8,10,41.01,41.11,"du"],[11,15,41.11,41.66,"pose"]]},{"id":12,"start":42.67,"end":43.69,"text":"Nei, takk.","speaker":"Kunde","zh":"不用，谢谢。","words":[[0,3,42.75,43.21,"nei"],[5,9,43.39,43.61,"takk"]]},{"id":13,"start":44.86,"end":48.71,"text":"Da blir det 59 kroner. Vil du ha kvittering?","speaker":"Butikkmedarbeider","zh":"那一共是59克朗。要收据吗？","words":[[0,2,44.94,45.18,"da~407a644a9bc0"],[3,7,45.18,45.38,"blir~8e63c9b279ae"],[8,11,45.38,45.5,"det"],[12,14,45.5,45.88,"59"],[15,21,45.88,46.48,"kroner"],[23,26,47.62,47.8,"vil"],[27,29,47.8,47.94,"du"],[30,32,47.94,48.1,"ha~ca5edb8b1cdb"],[33,43,48.1,48.71,"kvittering"]]},{"id":14,"start":48.83,"end":50.81,"text":"Ja, takk.","speaker":"Kunde","zh":"要，谢谢。","words":[[0,2,48.83,50.54,"ja"],[4,8,50.54,50.73,"takk"]]},{"id":15,"start":52.02,"end":52.85,"text":"God helg!","speaker":"Butikkmedarbeider","zh":"周末愉快！","words":[[0,3,52.1,52.34,"god"],[4,8,52.34,52.77,"helg"]]},{"id":16,"start":53.77,"end":55.11,"text":"Takk i like måte!","speaker":"Kunde","zh":"谢谢，你也是！","words":[[0,4,53.85,54.18,"takk"],[5,6,54.18,54.28,"i~d931e4e5d506"],[7,11,54.28,54.48,"like~96c08a97a401"],[12,16,54.48,55.03,"måte~e6eb4b458deb"]]}],"lexicon":{"59":{"lemma":"59","zh":"数字 59","pos":"数词","ref":"basics:numbers:femtini","clip":null,"kind":"number"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5