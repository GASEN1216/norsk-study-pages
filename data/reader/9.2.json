{"id":"9.2","title":"Marek har flyttet","audio":"audio/9.2.mp3","duration":170.21,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.84,"text":"9.2 Marek har flyttet","heading":true,"zh":"9.2 马雷克搬家了","words":[[0,3,0.15,1.09,"9.2"],[4,9,1.52,2.74,"marek"],[10,13,2.74,2.98,"har~8b9792170cca"],[14,21,2.98,3.76,"flyttet"]]},{"id":1,"start":6.45,"end":7.84,"text":"Telefonen ringer.","zh":"电话响了。","words":[[0,9,6.51,7.24,"telefonen"],[10,16,7.24,7.69,"ringer~04b7ec2e850d"]]},{"id":2,"start":11.46,"end":13.99,"text":"Hallo? Det er Håvard.","speaker":"Håvard","zh":"喂？我是霍瓦尔。","words":[[0,5,11.52,12.04,"hallo"],[7,10,12.84,13.12,"det"],[11,13,13.12,13.4,"er"],[14,20,13.4,13.84,"håvard"]]},{"id":3,"start":14.54,"end":16.93,"text":"Hei, lærer! Det er Marek.","speaker":"Marek","zh":"你好，老师！我是马雷克。","words":[[0,3,14.61,14.94,"hei"],[5,10,14.94,15.48,"lærer~5a8d077d35fc"],[12,15,16.0,16.14,"det"],[16,18,16.14,16.24,"er"],[19,24,16.24,16.79,"marek"]]},{"id":4,"start":17.73,"end":25.22,"text":"Å, hei! Hvordan har du det? Det er lenge siden jeg har sett deg. Har du sluttet i klassen?","speaker":"Håvard","zh":"哦，你好！你好吗？好久没见到你了。你退出这个班了吗？","words":[[0,1,17.79,18.09,"å~496a48c13525"],[3,6,18.32,18.73,"hei"],[8,15,19.54,20.08,"hvordan"],[16,19,20.08,20.3,"har"],[20,22,20.3,20.42,"du"],[23,26,20.42,20.75,"det~de516fb88048"],[28,31,21.46,21.6,"det"],[32,34,21.6,21.68,"er"],[35,40,21.68,21.96,"lenge"],[41,46,21.96,22.22,"siden~73a7d0c7dfb2"],[47,50,22.22,22.32,"jeg"],[51,54,22.32,22.44,"har~8b9792170cca"],[55,59,22.44,22.66,"sett"],[60,63,22.66,22.99,"deg"],[65,68,23.9,24.04,"har~8b9792170cca"],[69,71,24.04,24.26,"du"],[72,79,24.26,24.62,"sluttet"],[80,81,24.62,24.68,"i~e78c30a27293"],[82,89,24.68,25.07,"klassen"]]},{"id":5,"start":26.64,"end":31.83,"text":"Ja, jeg har begynt på norskkurs om kvelden, for jeg har fått fast jobb.","speaker":"Marek","zh":"是的，我开始上晚上的挪威语课了，因为我找到了固定工作。","words":[[0,2,26.7,27.07,"ja"],[4,7,27.62,27.82,"jeg"],[8,11,27.82,27.94,"har~8b9792170cca"],[12,18,27.94,28.32,"begynt"],[19,21,28.32,28.48,"på~0499e342b97f"],[22,31,28.48,29.16,"norskkurs"],[32,34,29.16,29.28,"om~c13075d78f52"],[35,42,29.28,29.86,"kvelden"],[44,47,30.22,30.36,"for~1b22712a94b1"],[48,51,30.36,30.52,"jeg"],[52,55,30.52,30.68,"har~8b9792170cca"],[56,60,30.68,30.98,"fått"],[61,65,30.98,31.4,"fast"],[66,70,31.4,31.68,"jobb"]]},{"id":6,"start":32.41,"end":35.45,"text":"Gratulerer! Nå ble jeg glad.","speaker":"Håvard","zh":"恭喜！听到这个我真高兴。","words":[[0,10,32.47,33.73,"gratulerer"],[12,14,34.56,34.74,"nå~d531d47a7712"],[15,18,34.74,34.86,"ble~7ae30f94c147"],[19,22,34.86,34.98,"jeg"],[23,27,34.98,35.3,"glad"]]},{"id":7,"start":36.05,"end":41.87,"text":"Takk, jeg er også glad for å ha fått jobb. Ewa har kommet til Norge.","speaker":"Marek","zh":"谢谢，我也很高兴找到了工作。埃娃已经来挪威了。","words":[[0,4,36.12,36.67,"takk"],[6,9,37.28,37.48,"jeg"],[10,12,37.48,37.62,"er"],[13,17,37.62,37.96,"også"],[18,22,37.96,38.26,"glad"],[23,26,38.26,38.4,"for~d06f5440f0d3"],[27,28,38.4,38.48,"å~0583da7a620a"],[29,31,38.48,38.6,"ha~32adc5dc2c40"],[32,36,38.6,38.84,"fått"],[37,41,38.84,39.27,"jobb"],[43,46,40.22,40.74,"ewa"],[47,50,40.74,40.9,"har~8b9792170cca"],[51,57,40.9,41.24,"kommet"],[58,61,41.24,41.38,"til"],[62,67,41.38,41.72,"norge~546b56e35dd5"]]},{"id":8,"start":42.94,"end":45.55,"text":"Så koselig! Når kom hun hit?","speaker":"Håvard","zh":"真好！她什么时候来的？","words":[[0,2,43.0,43.28,"så~1c5b6a43311c"],[3,10,43.28,43.98,"koselig"],[12,15,44.52,44.76,"når~a56a1c61425b"],[16,19,44.76,44.98,"kom~a03d8aa690db"],[20,23,44.98,45.12,"hun"],[24,27,45.12,45.41,"hit"]]},{"id":9,"start":46.45,"end":52.73,"text":"Hun kom hit for en måned siden. Vi har kjøpt en leilighet sammen i sentrum.","speaker":"Marek","zh":"她是一个月前来这里的。我们一起在市中心买了一套公寓。","words":[[0,3,46.51,46.78,"hun"],[4,7,46.78,47.06,"kom~a03d8aa690db"],[8,11,47.06,47.5,"hit"],[12,15,47.5,47.64,"for~e753a937d19e"],[16,18,47.64,47.76,"en~a939a9e56dc5"],[19,24,47.76,48.16,"måned"],[25,30,48.16,48.63,"siden~9a3d2d89a980"],[32,34,49.9,50.0,"vi"],[35,38,50.0,50.18,"har~8b9792170cca"],[39,44,50.18,50.5,"kjøpt"],[45,47,50.5,50.64,"en~a939a9e56dc5"],[48,57,50.64,51.2,"leilighet"],[58,64,51.2,51.71,"sammen"],[65,66,51.84,52.0,"i"],[67,74,52.0,52.59,"sentrum"]]},{"id":10,"start":53.68,"end":56.59,"text":"Så fint! Har dere flyttet inn?","speaker":"Håvard","zh":"太好了！你们已经搬进去了吗？","words":[[0,2,53.74,54.14,"så~1c5b6a43311c"],[3,7,54.14,54.8,"fint"],[9,12,55.42,55.62,"har~8b9792170cca"],[13,17,55.62,55.92,"dere"],[18,25,55.92,56.24,"flyttet"],[26,29,56.24,56.45,"inn~718ba71089b2"]]},{"id":11,"start":57.63,"end":65.73,"text":"Ja, vi flyttet inn for to uker siden, og vi har pusset opp stua, gangen og soverommene.","speaker":"Marek","zh":"是的，我们两周前搬进去的，已经翻新了客厅、门厅和卧室。","words":[[0,2,57.7,58.08,"ja"],[4,6,58.7,58.9,"vi"],[7,14,58.9,59.32,"flyttet"],[15,18,59.32,59.74,"inn~718ba71089b2"],[19,22,59.74,59.96,"for~e753a937d19e"],[23,25,59.96,60.3,"to"],[26,30,60.3,60.58,"uker"],[31,36,60.58,61.08,"siden~9a3d2d89a980"],[38,40,61.54,61.64,"og"],[41,43,61.64,61.74,"vi"],[44,47,61.74,61.88,"har~8b9792170cca"],[48,54,61.88,62.28,"pusset"],[55,58,62.28,62.52,"opp~10d7fedbe51f"],[59,63,62.52,63.16,"stua"],[65,71,63.62,64.22,"gangen~2331c2796989"],[72,74,64.66,64.9,"og"],[75,86,64.9,65.58,"soverommene"]]},{"id":12,"start":66.8,"end":70.74,"text":"Så flinke dere er! Har Ewa fått jobb her?","speaker":"Håvard","zh":"你们真能干！埃娃在这里找到工作了吗？","words":[[0,2,66.86,67.16,"så~1c5b6a43311c"],[3,9,67.16,67.64,"flinke"],[10,14,67.64,67.82,"dere"],[15,17,67.82,68.2,"er"],[19,22,69.1,69.58,"har~8b9792170cca"],[23,26,69.58,69.98,"ewa"],[27,31,69.98,70.18,"fått"],[32,36,70.18,70.36,"jobb"],[37,40,70.36,70.59,"her"]]},{"id":13,"start":71.43,"end":82.5,"text":"Nei, hun leter etter jobb nå. Hun har lært litt norsk, men hun er ikke så god i norsk ennå. Vi prøver å snakke litt norsk hjemme.","speaker":"Marek","zh":"没有，她现在正在找工作。她学了一点挪威语，但挪威语还不太好。我们在家尽量说一点挪威语。","words":[[0,3,71.49,71.96,"nei"],[5,8,72.66,72.9,"hun"],[9,14,72.9,73.32,"leter"],[15,20,73.32,73.56,"etter~47a4c65924c9"],[21,25,73.56,73.86,"jobb"],[26,28,73.86,74.18,"nå~d531d47a7712"],[30,33,75.26,75.4,"hun"],[34,37,75.4,75.56,"har~8b9792170cca"],[38,42,75.56,75.9,"lært"],[43,47,75.9,76.18,"litt~462e893626a5"],[48,53,76.18,76.74,"norsk~4de5d75feae1"],[55,58,77.1,77.24,"men"],[59,62,77.24,77.4,"hun"],[63,65,77.4,77.54,"er"],[66,70,77.54,77.8,"ikke"],[71,73,77.8,78.0,"så~5ea680aa9b78"],[74,77,78.0,78.28,"god"],[78,79,78.28,78.36,"i~2f0e448f7280"],[80,85,78.36,78.7,"norsk~4de5d75feae1"],[86,90,78.7,79.08,"ennå"],[92,94,80.18,80.36,"vi"],[95,101,80.36,80.86,"prøver~fc7bfa0f89a8"],[102,103,80.86,81.0,"å~0583da7a620a"],[104,110,81.0,81.34,"snakke"],[111,115,81.34,81.58,"litt~462e893626a5"],[116,121,81.58,82.02,"norsk~4de5d75feae1"],[122,128,82.02,82.35,"hjemme"]]},{"id":14,"start":83.59,"end":87.35,"text":"Det er bra. Har du snakket med noen i klassen i det siste?","speaker":"Håvard","zh":"那很好。你最近和班上的人聊过吗？","words":[[0,3,83.65,83.88,"det"],[4,6,83.88,83.98,"er"],[7,10,83.98,84.34,"bra~bbb83846e29f"],[12,15,85.2,85.34,"har~8b9792170cca"],[16,18,85.34,85.48,"du"],[19,26,85.48,85.84,"snakket"],[27,30,85.84,85.94,"med"],[31,35,85.94,86.16,"noen~8e23a4fd3f2f"],[36,37,86.16,86.24,"i"],[38,45,86.24,86.62,"klassen"],[46,47,86.62,86.7,"i~773e1f5ab22a"],[48,51,86.7,86.82,"det~0f267d37d43e"],[52,57,86.82,87.2,"siste"]]},{"id":15,"start":88.32,"end":105.45,"text":"Ja, jeg snakket med Sompit i går. Jeg har også snakket med Yousef mange ganger. Jeg savner den gamle klassen med alle de hyggelige menneskene, men det er spennende med en ny klasse og nye kollegaer på jobben.","speaker":"Marek","zh":"是的，我昨天和松皮特聊过。我也和优素福聊过很多次。我想念原来那个班和班上所有友善的人，不过有一个新班级和工作上的新同事也很让人兴奋。","words":[[0,2,88.38,88.8,"ja"],[4,7,89.54,89.78,"jeg"],[8,15,89.78,90.2,"snakket~853fba2e9223"],[16,19,90.2,90.38,"med"],[20,26,90.38,91.04,"sompit"],[27,28,91.04,91.12,"i~a60b3c4a2bee"],[29,32,91.12,91.58,"går~c22338876ea6"],[34,37,92.44,92.56,"jeg"],[38,41,92.56,92.74,"har~8b9792170cca"],[42,46,92.74,93.04,"også"],[47,54,93.04,93.48,"snakket"],[55,58,93.48,93.62,"med"],[59,65,93.62,94.38,"yousef"],[66,71,94.48,94.86,"mange"],[72,78,94.86,95.38,"ganger~3045db79f07e"],[80,83,96.38,96.62,"jeg"],[84,90,96.62,97.16,"savner"],[91,94,97.16,97.36,"den~5f413bef0ba1"],[95,100,97.36,97.76,"gamle"],[101,108,97.76,98.38,"klassen"],[109,112,98.48,98.66,"med~e54958f33c71"],[113,117,98.66,98.92,"alle~6873d9584096"],[118,120,98.92,99.08,"de~d251aa490218"],[121,130,99.08,99.6,"hyggelige"],[131,141,99.6,100.32,"menneskene"],[143,146,101.18,101.3,"men"],[147,150,101.3,101.42,"det"],[151,153,101.42,101.54,"er"],[154,163,101.54,102.3,"spennende"],[164,167,102.3,102.42,"med"],[168,170,102.42,102.54,"en~a939a9e56dc5"],[171,173,102.54,102.8,"ny"],[174,180,102.8,103.38,"klasse"],[181,183,103.58,103.74,"og"],[184,187,103.74,104.04,"nye"],[188,197,104.04,104.84,"kollegaer"],[198,200,104.84,104.96,"på"],[201,207,104.96,105.3,"jobben"]]},{"id":16,"start":106.82,"end":114.38,"text":"Ja, og du har hatt mye å gjøre i den nye leiligheten. Lykke til i den nye jobben, Marek!","speaker":"Håvard","zh":"是啊，你在新公寓里也有很多事要忙。祝你新工作顺利，马雷克！","words":[[0,2,106.88,107.32,"ja"],[4,6,108.06,108.22,"og"],[7,9,108.22,108.36,"du"],[10,13,108.36,108.5,"har~8b9792170cca"],[14,18,108.5,108.82,"hatt~b32342f11ef0"],[19,22,108.82,109.2,"mye~cc164d0dc3da"],[23,24,109.2,109.34,"å~0583da7a620a"],[25,30,109.34,109.94,"gjøre"],[31,32,110.06,110.16,"i"],[33,36,110.16,110.3,"den~5f413bef0ba1"],[37,40,110.3,110.52,"nye"],[41,52,110.52,111.28,"leiligheten"],[54,59,112.54,112.9,"lykke"],[60,63,112.9,113.08,"til~01d134aa0a9e"],[64,65,113.08,113.16,"i"],[66,69,113.16,113.3,"den~5f413bef0ba1"],[70,73,113.3,113.52,"nye"],[74,80,113.52,113.82,"jobben"],[82,87,113.82,114.23,"marek"]]},{"id":17,"start":115.42,"end":118.4,"text":"Takk for det. Hyggelig å snakke med deg!","speaker":"Marek","zh":"谢谢。和你聊天很愉快！","words":[[0,4,115.48,115.8,"takk"],[5,8,115.8,115.94,"for~dbf4329b7fe1"],[9,12,115.94,116.28,"det"],[14,22,117.04,117.46,"hyggelig"],[23,24,117.46,117.58,"å~0583da7a620a"],[25,31,117.58,117.92,"snakke"],[32,35,117.92,118.04,"med"],[36,39,118.04,118.25,"deg"]]},{"id":18,"start":120.82,"end":122.09,"text":"Ewa forteller:","zh":"埃娃讲述：","words":[[0,3,120.88,121.3,"ewa"],[4,13,121.3,121.94,"forteller"]]},{"id":19,"start":123.4,"end":126.24,"text":"Nå har jeg endelig kommet til Norge!","zh":"我终于来到挪威了！","words":[[0,2,123.46,123.84,"nå~d531d47a7712"],[3,6,123.84,124.02,"har~8b9792170cca"],[7,10,124.02,124.38,"jeg"],[11,18,124.38,125.12,"endelig"],[19,25,125.12,125.44,"kommet"],[26,29,125.44,125.6,"til"],[30,35,125.6,126.09,"norge~546b56e35dd5"]]},{"id":20,"start":127.54,"end":129.57,"text":"Jeg kom hit for en måned siden.","zh":"我是一个月前来这里的。","words":[[0,3,127.6,127.82,"jeg"],[4,7,127.82,128.04,"kom~a03d8aa690db"],[8,11,128.04,128.34,"hit"],[12,15,128.34,128.48,"for~e753a937d19e"],[16,18,128.48,128.6,"en~a939a9e56dc5"],[19,24,128.6,128.96,"måned"],[25,30,128.96,129.42,"siden~9a3d2d89a980"]]},{"id":21,"start":130.94,"end":136.02,"text":"Marek har fått fast jobb, og vi har kjøpt en fin leilighet sammen.","zh":"马雷克找到了固定工作，我们一起买了一套漂亮的公寓。","words":[[0,5,131.0,131.58,"marek"],[6,9,131.58,131.76,"har~8b9792170cca"],[10,14,131.76,131.98,"fått"],[15,19,131.98,132.32,"fast"],[20,24,132.32,132.75,"jobb"],[26,28,133.78,133.9,"og"],[29,31,133.9,134.0,"vi"],[32,35,134.0,134.14,"har~8b9792170cca"],[36,41,134.14,134.36,"kjøpt"],[42,44,134.36,134.58,"en~a939a9e56dc5"],[45,48,134.58,134.9,"fin"],[49,58,134.9,135.42,"leilighet"],[59,65,135.42,135.87,"sammen"]]},{"id":22,"start":137.41,"end":140.05,"text":"Den nye leiligheten ligger i sentrum.","zh":"新公寓位于市中心。","words":[[0,3,137.47,137.68,"den~5f413bef0ba1"],[4,7,137.68,138.0,"nye"],[8,19,138.0,138.86,"leiligheten"],[20,26,138.86,139.12,"ligger"],[27,28,139.12,139.26,"i"],[29,36,139.26,139.9,"sentrum"]]},{"id":23,"start":141.35,"end":144.81,"text":"Det er en treroms leilighet på 70 kvadratmeter.","zh":"这是一套70平方米、两室一厅的公寓。","words":[[0,3,141.41,141.54,"det"],[4,6,141.54,141.66,"er"],[7,9,141.66,141.82,"en~a939a9e56dc5"],[10,17,141.82,142.52,"treroms"],[18,27,142.52,143.2,"leilighet"],[28,30,143.2,143.38,"på~c7eea141d2f3"],[31,33,143.38,143.76,"70"],[34,46,143.76,144.66,"kvadratmeter"]]},{"id":24,"start":146.28,"end":151.42,"text":"Vi har malt de mørke veggene i stua, og Marek har lagt nytt gulv.","zh":"我们把客厅里深色的墙刷了漆，马雷克还铺了新地板。","words":[[0,2,146.34,146.48,"vi"],[3,6,146.48,146.66,"har~8b9792170cca"],[7,11,146.66,146.98,"malt"],[12,14,146.98,147.12,"de~d251aa490218"],[15,20,147.12,147.54,"mørke"],[21,28,147.54,147.88,"veggene"],[29,30,147.88,147.98,"i"],[31,35,147.98,148.5,"stua"],[37,39,149.5,149.66,"og"],[40,45,149.66,150.32,"marek"],[46,49,150.32,150.44,"har~8b9792170cca"],[50,54,150.44,150.68,"lagt"],[55,59,150.68,150.94,"nytt"],[60,64,150.94,151.27,"gulv"]]},{"id":25,"start":152.74,"end":154.59,"text":"Nå er stua lys og fin.","zh":"现在客厅明亮又漂亮。","words":[[0,2,152.8,153.04,"nå~d531d47a7712"],[3,5,153.04,153.16,"er"],[6,10,153.16,153.56,"stua"],[11,14,153.56,153.94,"lys~37231c69213d"],[15,17,153.94,154.06,"og"],[18,21,154.06,154.44,"fin"]]},{"id":26,"start":156.03,"end":159.69,"text":"Jeg har fått et lite skrivebord på det ene soverommet.","zh":"我在其中一间卧室里有了一张小书桌。","words":[[0,3,156.09,156.4,"jeg"],[4,7,156.4,156.58,"har~8b9792170cca"],[8,12,156.58,156.82,"fått"],[13,15,156.82,156.96,"et~054dde72f37b"],[16,20,156.96,157.36,"lite"],[21,31,157.36,158.28,"skrivebord"],[32,34,158.28,158.4,"på"],[35,38,158.4,158.58,"det~b62ffd829647"],[39,42,158.58,158.9,"ene"],[43,53,158.9,159.53,"soverommet"]]},{"id":27,"start":161.09,"end":163.79,"text":"Det lille skrivebordet har Marek laget selv.","zh":"那张小书桌是马雷克自己做的。","words":[[0,3,161.16,161.34,"det~b62ffd829647"],[4,9,161.34,161.66,"lille"],[10,22,161.66,162.4,"skrivebordet"],[23,26,162.4,162.6,"har~8b9792170cca"],[27,32,162.6,162.98,"marek"],[33,38,162.98,163.4,"laget~1d8b6670c2ea"],[39,43,163.4,163.64,"selv"]]},{"id":28,"start":165.1,"end":167.13,"text":"Han er en veldig flink snekker.","zh":"他是一个非常能干的木匠。","words":[[0,3,165.16,16