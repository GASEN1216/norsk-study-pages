{"id":"9.2","title":"Marek har flyttet","audio":"audio/9.2.mp3","duration":170.21,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.84,"text":"9.2 Marek har flyttet","heading":true,"zh":"9.2 马雷克搬家了","words":[[0,3,0.15,1.09,"9.2"],[4,9,1.52,2.74,"marek"],[10,13,2.74,2.98,"har~8b9792170cca"],[14,21,2.98,3.76,"flyttet"]]},{"id":1,"start":6.41,"end":7.78,"text":"Telefonen ringer.","zh":"电话响了。","words":[[0,9,6.49,7.18,"telefonen"],[10,16,7.18,7.7,"ringer~04b7ec2e850d"]]},{"id":2,"start":11.43,"end":13.94,"text":"Hallo? Det er Håvard.","speaker":"Håvard","zh":"喂？我是霍瓦尔。","words":[[0,5,11.51,11.87,"hallo"],[7,10,12.65,13.01,"det"],[11,13,13.01,13.29,"er"],[14,20,13.29,13.86,"håvard"]]},{"id":3,"start":14.51,"end":16.88,"text":"Hei, lærer! Det er Marek.","speaker":"Marek","zh":"你好，老师！我是马雷克。","words":[[0,3,14.59,14.89,"hei"],[5,10,14.95,15.23,"lærer~5a8d077d35fc"],[12,15,15.87,16.09,"det"],[16,18,16.09,16.21,"er"],[19,24,16.21,16.8,"marek"]]},{"id":4,"start":17.7,"end":25.17,"text":"Å, hei! Hvordan har du det? Det er lenge siden jeg har sett deg. Har du sluttet i klassen?","speaker":"Håvard","zh":"哦，你好！你好吗？好久没见到你了。你退出这个班了吗？","words":[[0,1,17.78,18.02,"å~496a48c13525"],[3,6,18.28,18.58,"hei"],[8,15,19.46,19.96,"hvordan"],[16,19,19.96,20.24,"har"],[20,22,20.24,20.38,"du"],[23,26,20.38,20.52,"det~de516fb88048"],[28,31,20.52,20.52,"det"],[32,34,21.6,21.7,"er"],[35,40,21.7,21.84,"lenge"],[41,46,21.84,22.14,"siden~73a7d0c7dfb2"],[47,50,22.14,22.28,"jeg"],[51,54,22.28,22.44,"har~8b9792170cca"],[55,59,22.44,22.54,"sett"],[60,63,22.54,22.76,"deg"],[65,68,23.72,24.02,"har~8b9792170cca"],[69,71,24.02,24.16,"du"],[72,79,24.16,24.56,"sluttet"],[80,81,24.56,24.66,"i~e78c30a27293"],[82,89,24.66,25.09,"klassen"]]},{"id":5,"start":26.6,"end":31.77,"text":"Ja, jeg har begynt på norskkurs om kvelden, for jeg har fått fast jobb.","speaker":"Marek","zh":"是的，我开始上晚上的挪威语课了，因为我找到了固定工作。","words":[[0,2,26.68,26.95,"ja"],[4,7,27.49,27.73,"jeg"],[8,11,27.73,27.89,"har~8b9792170cca"],[12,18,27.89,28.17,"begynt"],[19,21,28.17,28.39,"på~0499e342b97f"],[22,31,28.39,29.07,"norskkurs"],[32,34,29.07,29.21,"om~c13075d78f52"],[35,42,29.21,29.53,"kvelden"],[44,47,30.19,30.33,"for~1b22712a94b1"],[48,51,30.33,30.47,"jeg"],[52,55,30.47,30.61,"har~8b9792170cca"],[56,60,30.61,30.83,"fått"],[61,65,30.83,31.17,"fast"],[66,70,31.17,31.69,"jobb"]]},{"id":6,"start":32.37,"end":35.4,"text":"Gratulerer! Nå ble jeg glad.","speaker":"Håvard","zh":"恭喜！听到这个我真高兴。","words":[[0,10,32.45,33.49,"gratulerer"],[12,14,34.35,34.69,"nå~d531d47a7712"],[15,18,34.69,34.83,"ble~7ae30f94c147"],[19,22,34.83,34.91,"jeg"],[23,27,34.91,35.32,"glad"]]},{"id":7,"start":36.02,"end":41.81,"text":"Takk, jeg er også glad for å ha fått jobb. Ewa har kommet til Norge.","speaker":"Marek","zh":"谢谢，我也很高兴找到了工作。埃娃已经来挪威了。","words":[[0,4,36.09,36.52,"takk"],[6,9,36.7,36.82,"jeg"],[10,12,37.5,37.62,"er"],[13,17,37.62,37.82,"også"],[18,22,37.82,38.12,"glad"],[23,26,38.12,38.38,"for~d06f5440f0d3"],[27,28,38.38,38.44,"å~0583da7a620a"],[29,31,38.44,38.52,"ha~32adc5dc2c40"],[32,36,38.52,38.7,"fått"],[37,41,38.7,39.26,"jobb"],[43,46,39.26,39.89,"ewa"],[47,50,39.89,40.52,"har~8b9792170cca"],[51,57,40.52,41.14,"kommet"],[58,61,41.14,41.32,"til"],[62,67,41.32,41.73,"norge~546b56e35dd5"]]},{"id":8,"start":41.93,"end":45.61,"text":"Så koselig! Når kom hun hit?","speaker":"Håvard","zh":"真好！她什么时候来的？","words":[[0,2,42.59,43.21,"så~1c5b6a43311c"],[3,10,43.21,43.75,"koselig"],[12,15,44.09,44.67,"når~a56a1c61425b"],[16,19,44.67,44.91,"kom~a03d8aa690db"],[20,23,44.91,45.07,"hun"],[24,27,45.07,45.53,"hit"]]},{"id":9,"start":46.42,"end":52.68,"text":"Hun kom hit for en måned siden. Vi har kjøpt en leilighet sammen i sentrum.","speaker":"Marek","zh":"她是一个月前来这里的。我们一起在市中心买了一套公寓。","words":[[0,3,46.5,46.72,"hun"],[4,7,46.72,46.96,"kom~a03d8aa690db"],[8,11,46.96,47.26,"hit"],[12,15,47.26,47.6,"for~e753a937d19e"],[16,18,47.6,47.72,"en~a939a9e56dc5"],[19,24,47.72,48.02,"måned"],[25,30,48.02,48.38,"siden~9a3d2d89a980"],[32,34,48.38,48.92,"vi"],[35,38,48.92,49.46,"har~8b9792170cca"],[39,44,49.46,50.01,"kjøpt"],[45,47,50.01,50.55,"en~a939a9e56dc5"],[48,57,50.55,51.09,"leilighet"],[58,64,51.09,51.51,"sammen"],[65,66,51.51,51.93,"i"],[67,74,51.93,52.6,"sentrum"]]},{"id":10,"start":53.63,"end":56.53,"text":"Så fint! Har dere flyttet inn?","speaker":"Håvard","zh":"太好了！你们已经搬进去了吗？","words":[[0,2,53.71,54.02,"så~1c5b6a43311c"],[3,7,54.02,54.46,"fint"],[9,12,55.0,55.6,"har~8b9792170cca"],[13,17,55.6,55.82,"dere"],[18,25,55.82,56.2,"flyttet"],[26,29,56.2,56.45,"inn~718ba71089b2"]]},{"id":11,"start":57.6,"end":65.66,"text":"Ja, flyttet inn for to uker siden, og vi har pusset opp stua, gangen og soverommene.","speaker":"Marek","zh":"是的，两周前搬进去的，我们已经翻新了客厅、门厅和卧室。","words":[[0,2,57.68,57.95,"ja"],[4,11,58.98,59.22,"flyttet"],[12,15,59.22,59.42,"inn~718ba71089b2"],[16,19,59.42,59.86,"for~e753a937d19e"],[20,22,60.04,60.22,"to"],[23,27,60.22,60.5,"uker"],[28,33,60.5,60.74,"siden~9a3d2d89a980"],[35,37,61.5,61.62,"og"],[38,40,61.62,61.72,"vi"],[41,44,61.72,61.82,"har~8b9792170cca"],[45,51,61.82,62.22,"pusset"],[52,55,62.22,62.42,"opp~10d7fedbe51f"],[56,60,62.42,62.92,"stua"],[62,68,63.58,64.04,"gangen~2331c2796989"],[69,71,64.04,64.8,"og"],[72,83,64.8,65.58,"soverommene"]]},{"id":12,"start":66.76,"end":70.67,"text":"Så flinke dere er! Har Ewa fått jobb her?","speaker":"Håvard","zh":"你们真能干！埃娃在这里找到工作了吗？","words":[[0,2,66.84,67.04,"så~1c5b6a43311c"],[3,9,67.04,67.6,"flinke"],[10,14,67.6,67.72,"dere"],[15,17,67.72,67.94,"er"],[19,22,68.76,69.38,"har~8b9792170cca"],[23,26,69.38,69.84,"ewa"],[27,31,69.84,70.1,"fått"],[32,36,70.1,70.34,"jobb"],[37,40,70.34,70.59,"her"]]},{"id":13,"start":71.39,"end":82.44,"text":"Nei, hun leter etter jobb nå. Hun har lært litt norsk, men hun er ikke så god i norsk ennå. Vi prøver å snakke litt norsk hjemme.","speaker":"Marek","zh":"没有，她现在正在找工作。她学了一点挪威语，但挪威语还不太好。我们在家尽量说一点挪威语。","words":[[0,3,71.47,71.78,"nei"],[5,8,72.56,72.78,"hun"],[9,14,72.78,73.28,"leter"],[15,20,73.28,73.52,"etter~6d1db6ff2d59"],[21,25,73.52,73.8,"jobb"],[26,28,73.8,73.98,"nå~d531d47a7712"],[30,33,75.29,75.39,"hun"],[34,37,75.39,75.49,"har~8b9792170cca"],[38,42,75.49,75.81,"lært"],[43,47,75.81,76.09,"litt~462e893626a5"],[48,53,76.09,76.53,"norsk~4de5d75feae1"],[55,58,76.53,76.83,"men"],[59,62,76.83,77.12,"hun"],[63,65,77.12,77.42,"er"],[66,70,77.42,77.71,"ikke"],[71,73,77.71,78.01,"så~5ea680aa9b78"],[74,77,78.01,78.3,"god"],[78,79,78.3,78.32,"i~2f0e448f7280"],[80,85,78.32,78.66,"norsk~4de5d75feae1"],[86,90,78.8,78.88,"ennå"],[92,94,78.88,79.41,"vi"],[95,101,79.41,79.94,"prøver~fc7bfa0f89a8"],[102,103,79.94,80.47,"å~0583da7a620a"],[104,110,80.47,81.0,"snakke"],[111,115,81.0,81.53,"litt~462e893626a5"],[116,121,81.53,81.93,"norsk~4de5d75feae1"],[122,128,81.93,82.36,"hjemme"]]},{"id":14,"start":83.55,"end":87.29,"text":"Det er bra. Har du snakket med noen i klassen i det siste?","speaker":"Håvard","zh":"那很好。你最近和班上的人聊过吗？","words":[[0,3,83.63,83.83,"det"],[4,6,83.83,83.93,"er"],[7,10,83.93,84.13,"bra~bbb83846e29f"],[12,15,84.68,85.32,"har~8b9792170cca"],[16,18,85.32,85.42,"du"],[19,26,85.42,85.8,"snakket"],[27,30,85.8,85.9,"med"],[31,35,85.9,86.1,"noen~8e23a4fd3f2f"],[36,37,86.1,86.2,"i"],[38,45,86.2,86.52,"klassen"],[46,47,86.52,86.68,"i~773e1f5ab22a"],[48,51,86.68,86.76,"det~0f267d37d43e"],[52,57,86.76,87.21,"siste"]]},{"id":15,"start":88.28,"end":105.49,"text":"Ja, jeg snakket med Sompit i går. Jeg har også snakket med Yousef mange ganger. Jeg savner den gamle klassen med alle de hyggelige menneskene, men det er spennende med en ny klasse og nye kollegaer på jobben.","speaker":"Marek","zh":"是的，我昨天和松皮特聊过。我也和优素福聊过很多次。我想念原来那个班和班上所有友善的人，不过有一个新班级和工作上的新同事也很让人兴奋。","words":[[0,2,88.36,88.67,"ja"],[4,7,89.52,89.68,"jeg"],[8,15,89.68,90.12,"snakket~853fba2e9223"],[16,19,90.12,90.3,"med"],[20,26,90.3,90.9,"sompit"],[27,28,90.9,91.12,"i~a60b3c4a2bee"],[29,32,91.12,91.4,"går~c22338876ea6"],[34,37,91.94,92.58,"jeg"],[38,41,92.58,92.66,"har~8b9792170cca"],[42,46,92.66,92.94,"også"],[47,54,92.94,93.4,"snakket"],[55,58,93.4,93.56,"med"],[59,65,93.56,94.2,"yousef"],[66,71,94.2,94.68,"mange"],[72,78,94.68,95.1,"ganger~3045db79f07e"],[80,83,96.4,96.54,"jeg"],[84,90,96.54,97.02,"savner"],[91,94,97.02,97.26,"den~5f413bef0ba1"],[95,100,97.26,97.68,"gamle"],[101,108,97.68,98.1,"klassen"],[109,112,98.1,98.56,"med~e54958f33c71"],[113,117,98.56,98.84,"alle~6873d9584096"],[118,120,98.84,99.0,"de~d251aa490218"],[121,130,99.0,99.5,"hyggelige"],[131,141,99.5,100.06,"menneskene"],[143,146,101.12,101.28,"men"],[147,150,101.28,101.4,"det"],[151,153,101.4,101.44,"er"],[154,163,101.44,102.04,"spennende"],[164,167,102.04,102.4,"med"],[168,170,102.4,102.52,"en~a939a9e56dc5"],[171,173,102.52,102.7,"ny"],[174,180,102.7,103.02,"klasse"],[181,183,103.02,103.64,"og"],[184,187,103.64,103.94,"nye"],[188,197,103.94,104.6,"kollegaer"],[198,200,104.6,104.9,"på"],[201,207,104.9,105.41,"jobben"]]},{"id":16,"start":106.78,"end":114.32,"text":"Ja, og du har hatt mye å gjøre i den nye leiligheten. Lykke til i den nye jobben, Marek!","speaker":"Håvard","zh":"是啊，你在新公寓里也有很多事要忙。祝你新工作顺利，马雷克！","words":[[0,2,106.86,107.21,"ja"],[4,6,107.89,108.17,"og"],[7,9,108.17,108.33,"du"],[10,13,108.33,108.45,"har~8b9792170cca"],[14,18,108.45,108.69,"hatt~b32342f11ef0"],[19,22,108.69,109.09,"mye~cc164d0dc3da"],[23,24,109.09,109.27,"å~0583da7a620a"],[25,30,109.27,109.63,"gjøre"],[31,32,109.63,110.11,"i"],[33,36,110.11,110.25,"den~5f413bef0ba1"],[37,40,110.25,110.43,"nye"],[41,52,110.43,111.01,"leiligheten"],[54,59,112.25,112.77,"lykke"],[60,63,112.77,113.01,"til~01d134aa0a9e"],[64,65,113.01,113.13,"i"],[66,69,113.13,113.23,"den~5f413bef0ba1"],[70,73,113.23,113.43,"nye"],[74,80,113.43,113.77,"jobben"],[82,87,113.81,114.24,"marek"]]},{"id":17,"start":115.38,"end":118.32,"text":"Takk for det. Hyggelig å snakke med deg!","speaker":"Marek","zh":"谢谢。和你聊天很愉快！","words":[[0,4,115.46,115.75,"takk"],[5,8,115.75,115.91,"for~dbf4329b7fe1"],[9,12,115.91,116.09,"det"],[14,22,116.95,117.41,"hyggelig"],[23,24,117.41,117.53,"å~0583da7a620a"],[25,31,117.53,117.85,"snakke"],[32,35,117.85,117.99,"med"],[36,39,117.99,118.24,"deg"]]},{"id":18,"start":119.63,"end":122.03,"text":"Ewa forteller:","zh":"埃娃讲述：","words":[[0,3,120.26,121.16,"ewa"],[4,13,121.16,121.95,"forteller"]]},{"id":19,"start":123.36,"end":126.19,"text":"Nå har jeg endelig kommet til Norge!","zh":"我终于来到挪威了！","words":[[0,2,123.44,123.73,"nå~d531d47a7712"],[3,6,123.73,123.97,"har~8b9792170cca"],[7,10,123.97,124.13,"jeg"],[11,18,124.13,124.93,"endelig"],[19,25,124.93,125.41,"kommet"],[26,29,125.41,125.53,"til"],[30,35,125.53,126.11,"norge~546b56e35dd5"]]},{"id":20,"start":127.48,"end":129.48,"text":"Jeg kom hit for en måned siden.","zh":"我是一个月前来这里的。","words":[[0,3,127.56,127.69,"jeg"],[4,7,127.75,128.07,"kom~a03d8aa690db"],[8,11,128.07,128.25,"hit"],[12,15,128.25,128.43,"for~e753a937d19e"],[16,18,128.43,128.55,"en~a939a9e56dc5"],[19,24,128.55,128.85,"måned"],[25,30,128.85,129.4,"siden~9a3d2d89a980"]]},{"id":21,"start":130.91,"end":135.96,"text":"Marek har fått fast jobb, og vi har kjøpt en fin leilighet sammen.","zh":"马雷克找到了固定工作，我们一起买了一套漂亮的公寓。","words":[[0,5,130.98,131.51,"marek"],[6,9,131.51,131.67,"har~8b9792170cca"],[10,14,131.67,131.85,"fått"],[15,19,131.85,132.17,"fast"],[20,24,132.17,132.61,"jobb"],[26,28,133.75,133.87,"og"],[29,31,133.87,133.99,"vi"],[32,35,133.99,134.09,"har~8b9792170cca"],[36,41,134.09,134.27,"kjøpt"],[42,44,134.27,134.47,"en~a939a9e56dc5"],[45,48,134.47,134.79,"fin"],[49,58,134.79,135.35,"leilighet"],[59,65,135.35,135.88,"sammen"]]},{"id":22,"start":137.38,"end":139.96,"text":"Den nye leiligheten ligger i sentrum.","zh":"新公寓位于市中心。","words":[[0,3,137.46,137.64,"den~5f413bef0ba1"],[4,7,137.64,137.92,"nye"],[8,19,137.92,138.64,"leiligheten"],[20,26,138.64,138.98,"ligger"],[27,28,138.98,139.2,"i"],[29,36,139.2,139.88,"sentrum"]]},{"id":23,"start":140.36,"end":144.74,"text":"Det er en treroms leilighet på 70 kvadratmeter.","zh":"这是一套70平方米、两室一厅的公寓。","words":[[0,3,141.06,141.54,"det"],[4,6,141.54,141.62,"er"],[7,9,141.62,141.74,"en~a939a9e56dc5"],[10,17,141.74,142.46,"treroms"],[18,27,142.46,143.06,"leilighet"],[28,30,143.06,143.3,"på~c7eea141d2f3"],[31,33,143.3,143.6,"70"],[34,46,143.6,144.66,"kvadratmeter"]]},{"id":24,"start":146.24,"end":151.35,"text":"Vi har malt de mørke veggene i stua, og Marek har lagt nytt gulv.","zh":"我们把客厅里深色的墙刷了漆，马雷克还铺了新地板。","words":[[0,2,146.32,146.47,"vi"],[3,6,146.47,146.61,"har~8b9792170cca"],[7,11,146.61,146.81,"malt"],[12,14,146.81,147.07,"de~d251aa490218"],[15,20,147.07,147.45,"mørke"],[21,28,147.45,147.81,"veggene"],[29,30,147.81,147.95,"i"],[31,35,147.95,148.27,"stua"],[37,39,149.32,149.58,"og"],[40,45,149.58,150.16,"marek"],[46,49,150.16,150.38,"har~8b9792170cca"],[50,54,150.38,150.56,"lagt"],[55,59,150.56,150.86,"nytt"],[60,64,150.86,151.27,"gulv"]]},{"id":25,"start":152.71,"end":154.5,"text":"Nå er stua lys og fin.","zh":"现在客厅明亮又漂亮。","words":[[0,2,152.79,152.98,"nå~d531d47a7712"],[3,5,152.98,153.12,"er"],[6,10,153.12,153.4,"stua"],[11,14,153.4,153.76,"lys~37231c69213d"],[15,17,153.76,154.02,"og"],[18,21,154.02,154.42,"fin"]]},{"id":26,"start":154.92,"end":159.27,"text":"Jeg har fått et lite skrivebord på det ene soverommet.","zh":"我在其中一间卧室里有了一张小书桌。","words":[[0,3,155.75,156.35,"jeg"],[4,7,156.35,156.51,"har~8b9792170cca"],[8,12,156.51,156.71,"fått"],[13,15,156.71,156.91,"et~054dde72f37b"],[16,20,156.91,157.19,"lite"],[21,31,157.19,157.93,"skrivebord"],[32,34,157.93,158.37,"på"],[35,38,158.37,158.51,"det~b62ffd829647"],[39,42,158.51,158.85,"ene"],[43,53,158.85,159.27,"soverommet"]]},{"id":27,"start":159.44,"end":163.74,"text":"Det lille skrivebordet har Marek laget selv.","zh":"那张小书桌是马雷克自己做的。","words":[[0,3,159.44,160.21,"det~b62ffd829647"],[4,9,161.26,161.54,"lille"],[10,22,161.54,162.32,"skrivebordet"],[23,26,162.32,162.5,"har~8b9792170cca"],[27,32,162.5,162.94,"marek"],[33,38,162.94,163.32,"laget~1d8b6670c2ea"],[39,43,163.32,163.66,"selv"]]},{"id":28,"start":164.97,"end":167.06,"text":"Han er en veldig flink snekker.","zh":"他是一个非常能干的木匠。","words":[