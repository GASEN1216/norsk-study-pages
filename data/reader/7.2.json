{"id":"7.2","title":"Hva gjorde du i Bergen?","audio":"audio/7.2.mp3","duration":153.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.37,"text":"7.2 Hva gjorde du i Bergen?","heading":true,"zh":"7.2 你在卑尔根做了什么？","words":[[0,3,0.15,1.23,"7.2"],[4,7,2.44,2.78,"hva"],[8,14,2.78,3.26,"gjorde"],[15,17,3.26,3.48,"du"],[18,19,3.48,3.62,"i"],[20,26,3.62,4.29,"bergen"]]},{"id":1,"start":5.64,"end":9.79,"text":"Viola skriver en e-post til Synne.","zh":"维奥拉在给辛妮写电子邮件。","words":[[0,5,5.72,6.27,"viola"],[6,13,6.27,6.71,"skriver"],[14,16,6.71,7.03,"en~a939a9e56dc5"],[17,23,7.03,7.59,"e-post"],[24,27,7.59,7.77,"til"],[28,33,9.26,9.79,"synne"]]},{"id":2,"start":9.97,"end":14.49,"text":"Synne flyttet til Trondheim for to uker siden, for hun skal studere der.","zh":"辛妮两周前搬到了特隆赫姆，因为她要在那里上大学。","words":[[0,5,9.97,9.97,"synne"],[6,13,9.97,10.28,"flyttet"],[14,17,10.28,10.48,"til"],[18,27,10.48,11.1,"trondheim"],[28,31,11.1,11.48,"for~d0291af9704a"],[32,34,11.48,11.7,"to"],[35,39,11.7,11.93,"uker"],[40,45,11.93,12.22,"siden~9a3d2d89a980"],[47,50,12.56,12.84,"for~1b22712a94b1"],[51,54,12.84,13.1,"hun"],[55,59,13.1,13.42,"skal"],[60,67,13.42,14.02,"studere"],[68,71,14.02,14.41,"der"]]},{"id":3,"start":16.56,"end":17.69,"text":"Hei Synne!","zh":"嗨，辛妮！","words":[[0,3,16.64,17.04,"hei"],[4,9,17.16,17.61,"synne"]]},{"id":4,"start":18.81,"end":19.87,"text":"Hvordan går det?","zh":"你好吗？","words":[[0,7,18.89,19.22,"hvordan"],[8,11,19.22,19.46,"går~7b5cc0f64acd"],[12,15,19.46,19.79,"det"]]},{"id":5,"start":21.22,"end":23.52,"text":"Jeg håper du har det fint i Trondheim.","zh":"希望你在特隆赫姆一切都好。","words":[[0,3,21.22,21.66,"jeg"],[4,9,21.66,21.96,"håper"],[10,12,21.96,22.08,"du"],[13,16,22.08,22.22,"har~fa08241d63a7"],[17,20,22.22,22.38,"det"],[21,25,22.38,22.6,"fint"],[26,27,22.6,22.8,"i"],[28,37,22.8,23.44,"trondheim"]]},{"id":6,"start":24.52,"end":25.62,"text":"Jeg har det bra.","zh":"我很好。","words":[[0,3,24.6,24.89,"jeg"],[4,7,24.89,25.05,"har~fa08241d63a7"],[8,11,25.05,25.19,"det"],[12,15,25.19,25.54,"bra~9ed229260de6"]]},{"id":7,"start":27.11,"end":30.17,"text":"Nå er jeg hjemme etter en hyggelig tur til Bergen.","zh":"去卑尔根玩了一趟，很愉快，现在我回到家了。","words":[[0,2,27.19,27.47,"nå~d531d47a7712"],[3,5,27.47,27.65,"er"],[6,9,27.65,27.75,"jeg"],[10,16,27.75,28.11,"hjemme"],[17,22,28.11,28.37,"etter"],[23,25,28.37,28.49,"en~a939a9e56dc5"],[26,34,28.49,28.91,"hyggelig"],[35,38,28.91,29.15,"tur"],[39,42,29.15,29.51,"til"],[43,49,29.51,30.09,"bergen"]]},{"id":8,"start":31.74,"end":33.84,"text":"Jeg dro dit for fire dager siden.","zh":"我是四天前去那儿的。","words":[[0,3,31.82,31.98,"jeg"],[4,7,31.98,32.18,"dro"],[8,11,32.18,32.36,"dit"],[12,15,32.36,32.58,"for~d0291af9704a"],[16,20,32.58,32.96,"fire"],[21,26,32.96,33.24,"dager"],[27,32,33.24,33.76,"siden~9a3d2d89a980"]]},{"id":9,"start":34.45,"end":38.23,"text":"Jeg reiste med tog, og togturen var kjempefin!","zh":"我坐火车去的，火车旅行棒极了！","words":[[0,3,34.53,34.94,"jeg"],[4,10,34.94,35.24,"reiste"],[11,14,35.24,35.42,"med~a7d4af26146c"],[15,18,35.42,35.98,"tog"],[20,22,35.98,36.47,"og"],[23,31,36.47,36.96,"togturen"],[32,35,36.96,37.28,"var"],[36,45,37.28,38.15,"kjempefin"]]},{"id":10,"start":39.18,"end":42.89,"text":"Vi kjørte over fjellet, og jeg så mye vakker natur.","zh":"我们翻过了山，我看到了很多美丽的自然风光。","words":[[0,2,40.08,40.08,"vi"],[3,9,40.08,40.08,"kjørte~9fbde051c551"],[10,14,40.08,40.08,"over"],[15,22,40.08,40.66,"fjellet"],[24,26,40.66,41.2,"og"],[27,30,41.2,41.36,"jeg"],[31,33,41.36,41.54,"så~cf8ba6a9aa04"],[34,37,41.54,41.88,"mye~cc164d0dc3da"],[38,44,41.88,42.26,"vakker"],[45,50,42.26,42.81,"natur"]]},{"id":11,"start":44.1,"end":46.49,"text":"I Bergen traff jeg mamma og pappa.","zh":"在卑尔根我见到了爸爸妈妈。","words":[[0,1,44.18,44.33,"i"],[2,8,44.79,45.05,"bergen"],[9,14,45.05,45.29,"traff"],[15,18,45.29,45.45,"jeg"],[19,24,45.45,45.79,"mamma"],[25,27,45.79,45.97,"og"],[28,33,45.97,46.41,"pappa"]]},{"id":12,"start":47.41,"end":48.82,"text":"De fløy dit fra Roma.","zh":"他们从罗马飞到那儿。","words":[[0,2,47.49,47.64,"de"],[3,7,47.64,47.88,"fløy"],[8,11,47.88,48.06,"dit"],[12,15,48.06,48.28,"fra"],[16,20,48.28,48.74,"roma"]]},{"id":13,"start":50.11,"end":53.12,"text":"En dag tok vi Fløibanen opp til Fløyen.","zh":"有一天我们坐弗洛伊山缆车上了弗洛伊恩山。","words":[[0,2,50.19,50.4,"en~a939a9e56dc5"],[3,6,50.4,50.76,"dag"],[7,10,50.8,51.18,"tok"],[11,13,51.18,51.34,"vi"],[14,23,51.34,52.02,"fløibanen"],[24,27,52.08,52.32,"opp"],[28,31,52.32,52.48,"til"],[32,38,52.48,53.04,"fløyen"]]},{"id":14,"start":53.93,"end":58.8,"text":"Der var det fantastisk utsikt, og mamma og pappa spanderte middag på meg der.","zh":"那里的风景美极了，爸爸妈妈在那儿请我吃了晚饭。","words":[[0,3,54.01,54.3,"der"],[4,7,54.3,54.44,"var"],[8,11,54.44,54.56,"det"],[12,22,54.56,55.4,"fantastisk"],[23,29,55.4,55.88,"utsikt"],[31,33,56.18,56.56,"og"],[34,39,56.56,56.8,"mamma"],[40,42,56.8,56.9,"og"],[43,48,56.9,57.16,"pappa"],[49,58,57.16,57.7,"spanderte"],[59,65,57.7,58.04,"middag"],[66,68,58.04,58.2,"på~a5d81465c9b6"],[69,72,58.2,58.34,"meg"],[73,76,58.34,58.72,"der"]]},{"id":15,"start":60.54,"end":66.01,"text":"Neste dag så vi Bryggen og Fisketorget, og der tok vi mange bilder.","zh":"第二天我们去看了布吕根码头和鱼市，在那里拍了很多照片。","words":[[0,5,60.62,60.98,"neste~1a5863e01a71"],[6,9,60.98,61.24,"dag"],[10,12,61.24,61.84,"så~80eb3513036b"],[13,15,61.84,61.96,"vi"],[16,23,61.96,62.56,"bryggen~81ffe82455d1"],[24,26,62.56,62.98,"og"],[27,38,62.98,63.8,"fisketorget"],[40,42,64.34,64.52,"og"],[43,46,64.52,64.72,"der"],[47,50,64.9,64.92,"tok~30f391d9b8a8"],[51,53,64.92,65.1,"vi"],[54,59,65.1,65.36,"mange"],[60,66,65.36,65.93,"bilder"]]},{"id":16,"start":67.96,"end":73.74,"text":"Mamma og pappa gruet seg litt til å reise til Norge, for de snakker ikke norsk eller engelsk.","zh":"爸爸妈妈对来挪威有点发怵，因为他们既不会说挪威语也不会说英语。","words":[[0,5,68.04,68.41,"mamma"],[6,8,68.41,68.53,"og"],[9,14,68.53,68.79,"pappa"],[15,20,68.79,69.13,"gruet"],[21,24,69.13,69.37,"seg"],[25,29,69.37,69.63,"litt~54360be2a478"],[30,33,69.63,69.93,"til~0afb1198ec28"],[34,35,69.93,70.03,"å~0583da7a620a"],[36,41,70.03,70.39,"reise~b6b0d7d6c228"],[42,45,70.39,70.57,"til"],[46,51,70.57,70.97,"norge~546b56e35dd5"],[53,56,71.59,71.75,"for~1b22712a94b1"],[57,59,71.75,71.87,"de"],[60,67,71.87,72.19,"snakker"],[68,72,72.19,72.35,"ikke"],[73,78,72.35,72.79,"norsk~4de5d75feae1"],[79,84,72.79,72.97,"eller"],[85,92,72.97,73.66,"engelsk~220c678f9536"]]},{"id":17,"start":74.98,"end":81.33,"text":"Heldigvis reiste de hit likevel, og på Fisketorget skjedde det noe morsomt.","zh":"幸好他们还是来了，而且在鱼市发生了一件有趣的事。","words":[[0,9,75.06,75.81,"heldigvis"],[10,16,75.81,76.57,"reiste"],[17,19,76.57,76.77,"de"],[20,23,76.77,77.11,"hit"],[24,31,77.11,77.63,"likevel"],[33,35,78.46,78.64,"og"],[36,38,78.64,78.76,"på"],[39,50,78.76,79.56,"fisketorget"],[51,58,79.56,80.2,"skjedde"],[59,62,80.2,80.36,"det"],[63,66,80.36,80.58,"noe"],[67,74,80.58,81.25,"morsomt"]]},{"id":18,"start":82.09,"end":85.71,"text":"Der kjøpte vi laks av en gutt, og han var italiensk!","zh":"我们在那儿从一个小伙子手里买了三文鱼，他居然是意大利人！","words":[[0,3,82.17,82.42,"der"],[4,10,82.42,82.76,"kjøpte"],[11,13,82.76,82.88,"vi"],[14,18,82.88,83.12,"laks"],[19,21,83.12,83.3,"av~e99d12aa736a"],[22,24,83.3,83.42,"en~a939a9e56dc5"],[25,29,83.42,83.74,"gutt"],[31,33,84.14,84.26,"og"],[34,37,84.26,84.46,"han"],[38,41,84.46,84.62,"var"],[42,51,84.62,85.63,"italiensk~7c30b65a690f"]]},{"id":19,"start":86.44,"end":87.95,"text":"Vi snakket lenge med ham.","zh":"我们和他聊了很久。","words":[[0,2,86.52,86.64,"vi"],[3,10,86.64,87.0,"snakket"],[11,16,87.0,87.36,"lenge"],[17,20,87.36,87.58,"med"],[21,24,87.58,87.87,"ham"]]},{"id":20,"start":90.37,"end":95.63,"text":"Det regner ofte i Bergen, og det regnet hver dag, men det gjorde ingenting.","zh":"卑尔根经常下雨，那几天也天天下雨，不过没关系。","words":[[0,3,90.45,90.61,"det"],[4,10,90.61,90.93,"regner"],[11,15,90.93,91.35,"ofte"],[16,17,91.35,91.51,"i"],[18,24,91.51,91.89,"bergen"],[26,28,92.47,92.63,"og"],[29,32,92.63,92.77,"det"],[33,39,92.77,93.21,"regnet"],[40,44,93.21,93.71,"hver"],[45,48,93.71,93.95,"dag"],[50,53,94.45,94.59,"men"],[54,57,94.59,94.69,"det"],[58,64,94.69,94.93,"gjorde~9124086a6cfc"],[65,74,94.93,95.55,"ingenting~f5eb795e4308"]]},{"id":21,"start":96.67,"end":99.75,"text":"Det var veldig hyggelig å være sammen med mamma og pappa igjen.","zh":"能再次和爸爸妈妈在一起，真是太好了。","words":[[0,3,96.75,96.81,"det"],[4,7,96.81,96.95,"var"],[8,14,96.95,97.43,"veldig"],[15,23,97.43,97.71,"hyggelig"],[24,25,97.71,97.83,"å~0583da7a620a"],[26,30,97.83,97.95,"være"],[31,37,97.95,98.39,"sammen"],[38,41,98.39,98.53,"med"],[42,47,98.53,98.85,"mamma"],[48,50,98.85,98.97,"og"],[51,56,98.97,99.25,"pappa"],[57,62,99.25,99.67,"igjen"]]},{"id":22,"start":101.58,"end":107.86,"text":"Etter tre dager dro de hjem til Italia, men først fulgte de meg til jernbanestasjonen.","zh":"三天后他们回意大利了，不过他们先把我送到了火车站。","words":[[0,5,101.66,101.9,"etter"],[6,9,101.9,102.16,"tre"],[10,15,102.16,102.58,"dager"],[16,19,102.58,103.24,"dro"],[20,22,103.24,103.38,"de"],[23,27,103.38,103.58,"hjem~f44e82ff7f3a"],[28,31,103.58,103.78,"til"],[32,38,103.78,104.28,"italia"],[40,43,105.0,105.22,"men"],[44,49,105.22,105.66,"først"],[50,56,105.66,106.1,"fulgte"],[57,59,106.1,106.2,"de"],[60,63,106.2,106.38,"meg"],[64,67,106.38,106.62,"til"],[68,85,106.62,107.78,"jernbanestasjonen"]]},{"id":23,"start":108.86,"end":110.95,"text":"Det var litt trist å reise fra dem igjen.","zh":"又要和他们分开，我有点难过。","words":[[0,3,108.94,109.03,"det"],[4,7,109.03,109.17,"var"],[8,12,109.17,109.33,"litt~54360be2a478"],[13,18,109.33,109.65,"trist"],[19,20,109.65,109.77,"å~0583da7a620a"],[21,26,109.77,110.07,"reise~7137e366f1fa"],[27,30,110.07,110.27,"fra"],[31,34,110.27,110.45,"dem"],[35,40,110.45,110.87,"igjen"]]},{"id":24,"start":113.08,"end":118.63,"text":"På toget ble jeg kjent med ei hyggelig eldre dame, og jeg viste henne bildene fra Bergen.","zh":"在火车上我认识了一位和蔼的老太太，我给她看了在卑尔根拍的照片。","words":[[0,2,113.16,113.32,"på"],[3,8,113.32,113.84,"toget"],[9,12,113.84,114.14,"ble~e1623bc307fb"],[13,16,114.14,114.22,"jeg"],[17,22,114.22,114.46,"kjent~43c3ae802868"],[23,26,114.46,114.66,"med~52f62f4e6a50"],[27,29,114.66,114.78,"ei~47aa2d18e376"],[30,38,114.78,115.18,"hyggelig"],[39,44,115.18,115.64,"eldre"],[45,49,115.64,115.98,"dame"],[51,53,116.72,116.74,"og"],[54,57,116.74,116.86,"jeg"],[58,63,116.86,117.16,"viste"],[64,69,117.16,117.36,"henne"],[70,77,117.36,117.88,"bildene"],[78,81,117.88,118.08,"fra"],[82,88,118.08,118.55,"bergen"]]},{"id":25,"start":119.82,"end":126.73,"text":"Jeg tenkte på familien i Italia og på den familien jeg bor hos her i Norge, og jeg ble glad igjen.","zh":"我想起了在意大利的家人，也想起了我在挪威寄住的这家人，心情又好了起来。","words":[[0,3,119.9,120.09,"jeg"],[4,10,120.09,120.39,"tenkte"],[11,13,120.39,120.57,"på~2246356e1d74"],[14,22,120.57,121.13,"familien"],[23,24,121.13,121.13,"i"],[25,31,121.13,121.87,"italia"],[32,34,121.87,122.59,"og"],[35,37,122.59,122.71,"på~2246356e1d74"],[38,41,122.71,122.83,"den~103625117b77"],[42,50,122.83,123.47,"familien"],[51,54,123.47,123.59,"jeg"],[55,58,123.59,123.79,"bor"],[59,62,123.79,124.07,"hos"],[63,66,124.07,124.27,"her"],[67,68,124.27,124.39,"i"],[69,74,124.39,124.71,"norge~546b56e35dd5"],[76,78,125.57,125.81,"og"],[79,82,125.81,125.95,"jeg"],[83,86,125.95,126.07,"ble"],[87,91,126.07,126.33,"glad"],[92,97,126.33,126.66,"igjen"]]},{"id":26,"start":127.82,"end":132.7,"text":"Jeg har en familie her og en familie der, og det er veldig fint.","zh":"我在这里有一个家，在那里也有一个家，这真的很好。","words":[[0,3,127.9,128.01,"jeg"],[4,7,128.01,128.21,"har"],[8,10,128.21,128.53,"en~a939a9e56dc5"],[11,18,128.53,128.99,"familie"],[19,22,128.99,129.27,"her"],[23,25,129.27,129.89,"og"],[26,28,129.89,130.11,"en~a939a9e56dc5"],[29,36,130.11,130.53,"familie"],[37,40,130.53,130.79,"der"],[42,44,131.27,131.49,"og"],[45,48,131.49,131.63,"det"],[49,51,131.63,131.75,"er"],[52,58,131.75,132.17,"veldig"],[59,63,132.17,132.62,"fint"]]},{"id":27,"start":133.71,"end":141.77,"text":"Jeg legger ved to bilder her i mailen, og jeg gleder meg til å vise deg alle bildene, Synne. Vi snakkes snart igjen.","zh":"我在邮件里附上两张照片，辛妮，我很期待给你看所有的照片。我们很快再聊。","words":[[0,3,133.79,134.18,"jeg"],[4,10,134.18,134.44,"legger~74792109a55f"],[11,14,134.44,134.64,"ved~1ec794a4fd6b"],[15,17,134.64,134.96,"to"],[18,24,134.96,135.44,"bilder"],[25,28,135.44,135.66,"her"],[29,30,135.66,135.8,"i"],[31,37,135.8,136.12,"mailen"],[39,41,136.7,136.9,"og"],[42,45,136.9,137.02,"jeg"],[46,52,137.02,137.44,"gleder"],[53,56,137.44,137.62,"meg"],[57,60,137.62,137.78,"til~f6df3d4686b1"],[61,62,137.78,137.78,"å~0583da7a620a"],[63,67,137.78,138.12,"vise"],[68,71,138.12,138.24,"deg"],[72,76,138.24,138.46,"alle~6873d9584096"],[77,84,138.46,138.92,"bildene"],[86,91,138.92,139.0,"synne"],[93,95,139.0,140.06,"vi"],[96,103,140.65,141.03,"snakkes~0cbe05857e4a"],[104,109,141.03,141.29,"snart"],[110,115,141.29,141.69,"igjen"]]},{"id":28,"start":142.58,"end":143.79,"text":"Klem fra Viola.","zh":"来自维奥拉的拥抱。","words":[[0,4,142.66,142.94,"klem"],[5,8,142.94,143.24,"fra"],[9,14,143.24,143.71,"viola"]]},{"id":29,"start":147.73,"end":149.77,"text":"I Bergen traff jeg mamma og pappa.","zh":"在卑尔根我见到了爸爸妈妈。","words":[[0,1,147.81,147.93,"i"],[2,8,147.93,148.41,"bergen"],[9,14,148.41,148.61,"traff"],[15,18,148.61,148.77,"jeg"],[19,24,148.77,149.09,"mamma"],[25,27,149.09,149.21,"og"],[28,33,149.21,149.69,"pappa"]]}],"lexicon":{"7.2":{"lemma":"7.2","zh":"第 7.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":"pronunciation/30e3d1e2053d54e76c16.mp3"},"bildene":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","form":"复数定指","clip":null},"bilder":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","form":"复数不定","clip":null},"ble":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"过去时","clip":null},"bor":{"lemma":"bo","zh":"居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e375