{"id":"7.2","title":"Hva gjorde du i Bergen?","audio":"audio/7.2.mp3","duration":153.39,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.37,"text":"7.2 Hva gjorde du i Bergen?","heading":true,"zh":"7.2 你在卑尔根做了什么？","words":[[0,3,0.15,1.23,"7.2"],[4,7,2.44,2.78,"hva"],[8,14,2.78,3.26,"gjorde"],[15,17,3.26,3.48,"du"],[18,19,3.48,3.62,"i"],[20,26,3.62,4.29,"bergen"]]},{"id":1,"start":5.68,"end":8.42,"text":"Viola skriver en e-post til Synne.","zh":"维奥拉在给辛妮写电子邮件。","words":[[0,5,5.74,6.46,"viola"],[6,13,6.46,6.9,"skriver"],[14,16,6.9,7.12,"en~a939a9e56dc5"],[17,23,7.12,7.64,"e-post"],[24,27,7.64,7.84,"til"],[28,33,7.84,8.27,"synne"]]},{"id":2,"start":9.39,"end":14.54,"text":"Synne flyttet til Trondheim for to uker siden, for hun skal studere der.","zh":"辛妮两周前搬到了特隆赫姆，因为她要在那里上大学。","words":[[0,5,9.46,10.0,"synne"],[6,13,10.0,10.38,"flyttet"],[14,17,10.38,10.62,"til"],[18,27,10.62,11.38,"trondheim"],[28,31,11.38,11.54,"for~d0291af9704a"],[32,34,11.54,11.76,"to"],[35,39,11.76,12.0,"uker"],[40,45,12.0,12.5,"siden~9a3d2d89a980"],[47,50,12.7,12.98,"for~1b22712a94b1"],[51,54,12.98,13.24,"hun"],[55,59,13.24,13.6,"skal"],[60,67,13.6,14.12,"studere"],[68,71,14.12,14.39,"der"]]},{"id":3,"start":16.61,"end":17.75,"text":"Hei Synne!","zh":"嗨，辛妮！","words":[[0,3,16.66,17.14,"hei"],[4,9,17.14,17.61,"synne"]]},{"id":4,"start":18.84,"end":19.91,"text":"Hvordan går det?","zh":"你好吗？","words":[[0,7,18.9,19.32,"hvordan"],[8,11,19.32,19.52,"går~7b5cc0f64acd"],[12,15,19.52,19.76,"det"]]},{"id":5,"start":21.48,"end":23.53,"text":"Jeg håper du har det fint i Trondheim.","zh":"希望你在特隆赫姆一切都好。","words":[[0,3,21.54,21.7,"jeg"],[4,9,21.7,22.0,"håper"],[10,12,22.0,22.12,"du"],[13,16,22.12,22.24,"har~fa08241d63a7"],[17,20,22.24,22.42,"det"],[21,25,22.42,22.74,"fint"],[26,27,22.74,22.84,"i"],[28,37,22.84,23.38,"trondheim"]]},{"id":6,"start":24.55,"end":25.67,"text":"Jeg har det bra.","zh":"我很好。","words":[[0,3,24.61,24.94,"jeg"],[4,7,24.94,25.08,"har~fa08241d63a7"],[8,11,25.08,25.24,"det"],[12,15,25.24,25.52,"bra~9ed229260de6"]]},{"id":7,"start":27.14,"end":30.22,"text":"Nå er jeg hjemme etter en hyggelig tur til Bergen.","zh":"去卑尔根玩了一趟，很愉快，现在我回到家了。","words":[[0,2,27.2,27.54,"nå~d531d47a7712"],[3,5,27.54,27.68,"er"],[6,9,27.68,27.82,"jeg"],[10,16,27.82,28.16,"hjemme"],[17,22,28.16,28.4,"etter"],[23,25,28.4,28.56,"en~a939a9e56dc5"],[26,34,28.56,28.98,"hyggelig"],[35,38,28.98,29.42,"tur"],[39,42,29.42,29.58,"til"],[43,49,29.58,30.07,"bergen"]]},{"id":8,"start":31.78,"end":33.85,"text":"Jeg dro dit for fire dager siden.","zh":"我是四天前去那儿的。","words":[[0,3,31.84,32.02,"jeg"],[4,7,32.02,32.26,"dro"],[8,11,32.26,32.46,"dit"],[12,15,32.46,32.72,"for~d0291af9704a"],[16,20,32.72,33.04,"fire"],[21,26,33.04,33.34,"dager"],[27,32,33.34,33.7,"siden~9a3d2d89a980"]]},{"id":9,"start":34.77,"end":38.3,"text":"Jeg reiste med tog, og togturen var kjempefin!","zh":"我坐火车去的，火车旅行棒极了！","words":[[0,3,34.84,34.98,"jeg"],[4,10,34.98,35.32,"reiste"],[11,14,35.32,35.5,"med~a7d4af26146c"],[15,18,35.5,36.09,"tog"],[20,22,36.38,36.52,"og"],[23,31,36.52,37.2,"togturen"],[32,35,37.2,37.42,"var"],[36,45,37.42,38.15,"kjempefin"]]},{"id":10,"start":39.46,"end":42.95,"text":"Vi kjørte over fjellet, og jeg så mye vakker natur.","zh":"我们翻过了山，我看到了很多美丽的自然风光。","words":[[0,2,39.52,39.66,"vi"],[3,9,39.66,39.92,"kjørte~9fbde051c551"],[10,14,39.92,40.16,"over"],[15,22,40.16,40.76,"fjellet"],[24,26,41.14,41.22,"og"],[27,30,41.22,41.44,"jeg"],[31,33,41.44,41.68,"så~cf8ba6a9aa04"],[34,37,41.68,42.02,"mye~cc164d0dc3da"],[38,44,42.02,42.34,"vakker"],[45,50,42.34,42.8,"natur"]]},{"id":11,"start":44.17,"end":46.55,"text":"I Bergen traff jeg mamma og pappa.","zh":"在卑尔根我见到了爸爸妈妈。","words":[[0,1,44.23,44.38,"i"],[2,8,44.38,45.03,"bergen"],[9,14,45.18,45.4,"traff"],[15,18,45.4,45.52,"jeg"],[19,24,45.52,45.92,"mamma"],[25,27,45.92,46.02,"og"],[28,33,46.02,46.41,"pappa"]]},{"id":12,"start":47.44,"end":48.9,"text":"De fløy dit fra Roma.","zh":"他们从罗马飞到那儿。","words":[[0,2,47.5,47.7,"de"],[3,7,47.7,47.94,"fløy"],[8,11,47.94,48.16,"dit"],[12,15,48.16,48.34,"fra"],[16,20,48.34,48.75,"roma"]]},{"id":13,"start":50.14,"end":53.2,"text":"En dag tok vi Fløibanen opp til Fløyen.","zh":"有一天我们坐弗洛伊山缆车上了弗洛伊恩山。","words":[[0,2,50.2,50.44,"en~a939a9e56dc5"],[3,6,50.44,51.04,"dag"],[7,10,51.04,51.24,"tok"],[11,13,51.24,51.42,"vi"],[14,23,51.42,52.16,"fløibanen"],[24,27,52.16,52.38,"opp"],[28,31,52.38,52.6,"til"],[32,38,52.6,53.05,"fløyen"]]},{"id":14,"start":53.96,"end":58.85,"text":"Der var det fantastisk utsikt, og mamma og pappa spanderte middag på meg der.","zh":"那里的风景美极了，爸爸妈妈在那儿请我吃了晚饭。","words":[[0,3,54.02,54.34,"der"],[4,7,54.34,54.46,"var"],[8,11,54.46,54.62,"det"],[12,22,54.62,55.48,"fantastisk"],[23,29,55.48,56.2,"utsikt"],[31,33,56.46,56.6,"og"],[34,39,56.6,56.86,"mamma"],[40,42,56.86,56.94,"og"],[43,48,56.94,57.3,"pappa"],[49,58,57.3,57.8,"spanderte"],[59,65,57.8,58.1,"middag"],[66,68,58.1,58.24,"på~a5d81465c9b6"],[69,72,58.24,58.44,"meg"],[73,76,58.44,58.7,"der"]]},{"id":15,"start":60.57,"end":66.07,"text":"Neste dag så vi Bryggen og Fisketorget, og der tok vi mange bilder.","zh":"第二天我们去看了布吕根码头和鱼市，在那里拍了很多照片。","words":[[0,5,60.63,61.04,"neste~1a5863e01a71"],[6,9,61.04,61.52,"dag"],[10,12,61.7,61.88,"så~80eb3513036b"],[13,15,61.88,62.06,"vi"],[16,23,62.06,62.73,"bryggen~81ffe82455d1"],[24,26,62.92,63.06,"og"],[27,38,63.06,64.06,"fisketorget"],[40,42,64.46,64.58,"og"],[43,46,64.58,64.8,"der"],[47,50,64.8,65.0,"tok~30f391d9b8a8"],[51,53,65.0,65.2,"vi"],[54,59,65.2,65.5,"mange"],[60,66,65.5,65.92,"bilder"]]},{"id":16,"start":68.0,"end":73.8,"text":"Mamma og pappa gruet seg litt til å reise til Norge, for de snakker ikke norsk eller engelsk.","zh":"爸爸妈妈对来挪威有点发怵，因为他们既不会说挪威语也不会说英语。","words":[[0,5,68.06,68.46,"mamma"],[6,8,68.46,68.56,"og"],[9,14,68.56,68.94,"pappa"],[15,20,68.94,69.3,"gruet"],[21,24,69.3,69.48,"seg"],[25,29,69.48,69.82,"litt~54360be2a478"],[30,33,69.82,70.0,"til~0afb1198ec28"],[34,35,70.0,70.1,"å~0583da7a620a"],[36,41,70.1,70.48,"reise~b6b0d7d6c228"],[42,45,70.48,70.68,"til"],[46,51,70.68,71.22,"norge~546b56e35dd5"],[53,56,71.66,71.78,"for~1b22712a94b1"],[57,59,71.78,71.92,"de"],[60,67,71.92,72.26,"snakker"],[68,72,72.26,72.48,"ikke"],[73,78,72.48,72.86,"norsk~4de5d75feae1"],[79,84,72.86,73.12,"eller"],[85,92,73.12,73.65,"engelsk~220c678f9536"]]},{"id":17,"start":75.11,"end":81.39,"text":"Heldigvis reiste de hit likevel, og på Fisketorget skjedde det noe morsomt.","zh":"幸好他们还是来了，而且在鱼市发生了一件有趣的事。","words":[[0,9,75.17,76.06,"heldigvis"],[10,16,76.26,76.68,"reiste"],[17,19,76.68,76.88,"de"],[20,23,76.88,77.22,"hit"],[24,31,77.22,77.9,"likevel"],[33,35,78.58,78.7,"og"],[36,38,78.7,78.86,"på"],[39,50,78.86,79.78,"fisketorget"],[51,58,79.98,80.28,"skjedde"],[59,62,80.28,80.42,"det"],[63,66,80.42,80.66,"noe"],[67,74,80.66,81.24,"morsomt"]]},{"id":18,"start":82.12,"end":85.77,"text":"Der kjøpte vi laks av en gutt, og han var italiensk!","zh":"我们在那儿从一个小伙子手里买了三文鱼，他居然是意大利人！","words":[[0,3,82.18,82.5,"der"],[4,10,82.5,82.8,"kjøpte"],[11,13,82.8,82.94,"vi"],[14,18,82.94,83.24,"laks"],[19,21,83.24,83.34,"av~e99d12aa736a"],[22,24,83.34,83.46,"en~a939a9e56dc5"],[25,29,83.46,83.96,"gutt"],[31,33,84.2,84.32,"og"],[34,37,84.32,84.52,"han"],[38,41,84.52,84.74,"var"],[42,51,84.74,85.62,"italiensk~7c30b65a690f"]]},{"id":19,"start":86.49,"end":88.03,"text":"Vi snakket lenge med ham.","zh":"我们和他聊了很久。","words":[[0,2,86.55,86.7,"vi"],[3,10,86.7,87.14,"snakket"],[11,16,87.14,87.48,"lenge"],[17,20,87.48,87.62,"med"],[21,24,87.62,87.88,"ham"]]},{"id":20,"start":90.41,"end":95.73,"text":"Det regner ofte i Bergen, og det regnet hver dag, men det gjorde ingenting.","zh":"卑尔根经常下雨，那几天也天天下雨，不过没关系。","words":[[0,3,90.47,90.64,"det"],[4,10,90.64,91.06,"regner"],[11,15,91.06,91.46,"ofte"],[16,17,91.46,91.54,"i"],[18,24,91.54,92.16,"bergen"],[26,28,92.54,92.64,"og"],[29,32,92.64,92.82,"det"],[33,39,92.82,93.46,"regnet"],[40,44,93.46,93.78,"hver"],[45,48,93.78,94.24,"dag"],[50,53,94.46,94.6,"men"],[54,57,94.6,94.72,"det"],[58,64,94.72,94.98,"gjorde~9124086a6cfc"],[65,74,94.98,95.58,"ingenting~f5eb795e4308"]]},{"id":21,"start":96.68,"end":99.78,"text":"Det var veldig hyggelig å være sammen med mamma og pappa igjen.","zh":"能再次和爸爸妈妈在一起，真是太好了。","words":[[0,3,96.74,96.88,"det"],[4,7,96.88,97.06,"var"],[8,14,97.06,97.48,"veldig"],[15,23,97.48,97.78,"hyggelig"],[24,25,97.78,97.86,"å~0583da7a620a"],[26,30,97.86,98.14,"være"],[31,37,98.14,98.46,"sammen"],[38,41,98.46,98.62,"med"],[42,47,98.62,98.9,"mamma"],[48,50,98.9,99.0,"og"],[51,56,99.0,99.32,"pappa"],[57,62,99.32,99.63,"igjen"]]},{"id":22,"start":101.62,"end":107.9,"text":"Etter tre dager dro de hjem til Italia, men først fulgte de meg til jernbanestasjonen.","zh":"三天后他们回意大利了，不过他们先把我送到了火车站。","words":[[0,5,101.68,101.96,"etter"],[6,9,101.96,102.26,"tre"],[10,15,102.26,102.86,"dager"],[16,19,103.12,103.32,"dro"],[20,22,103.32,103.44,"de"],[23,27,103.44,103.7,"hjem~f44e82ff7f3a"],[28,31,103.7,103.88,"til"],[32,38,103.88,104.52,"italia"],[40,43,105.12,105.34,"men"],[44,49,105.34,105.8,"først"],[50,56,105.8,106.12,"fulgte"],[57,59,106.12,106.26,"de"],[60,63,106.26,106.52,"meg"],[64,67,106.52,106.68,"til"],[68,85,106.68,107.75,"jernbanestasjonen"]]},{"id":23,"start":108.88,"end":111.05,"text":"Det var litt trist å reise fra dem igjen.","zh":"又要和他们分开，我有点难过。","words":[[0,3,108.94,109.06,"det"],[4,7,109.06,109.22,"var"],[8,12,109.22,109.4,"litt~54360be2a478"],[13,18,109.4,109.72,"trist"],[19,20,109.72,109.8,"å~0583da7a620a"],[21,26,109.8,110.16,"reise~7137e366f1fa"],[27,30,110.16,110.32,"fra"],[31,34,110.32,110.5,"dem"],[35,40,110.5,110.9,"igjen"]]},{"id":24,"start":113.12,"end":118.73,"text":"På toget ble jeg kjent med ei hyggelig eldre dame, og jeg viste henne bildene fra Bergen.","zh":"在火车上我认识了一位和蔼的老太太，我给她看了在卑尔根拍的照片。","words":[[0,2,113.18,113.4,"på"],[3,8,113.4,114.0,"toget"],[9,12,114.0,114.14,"ble~e1623bc307fb"],[13,16,114.14,114.3,"jeg"],[17,22,114.3,114.58,"kjent~43c3ae802868"],[23,26,114.58,114.7,"med~52f62f4e6a50"],[27,29,114.7,114.84,"ei~47aa2d18e376"],[30,38,114.84,115.3,"hyggelig"],[39,44,115.3,115.7,"eldre"],[45,49,115.7,116.24,"dame"],[51,53,116.66,116.76,"og"],[54,57,116.76,116.92,"jeg"],[58,63,116.92,117.24,"viste"],[64,69,117.24,117.48,"henne"],[70,77,117.48,117.96,"bildene"],[78,81,117.96,118.14,"fra"],[82,88,118.14,118.58,"bergen"]]},{"id":25,"start":119.91,"end":126.8,"text":"Jeg tenkte på familien i Italia og på den familien jeg bor hos her i Norge, og jeg ble glad igjen.","zh":"我想起了在意大利的家人，也想起了我在挪威寄住的这家人，心情又好了起来。","words":[[0,3,119.97,120.18,"jeg"],[4,10,120.18,120.5,"tenkte"],[11,13,120.5,120.66,"på~2246356e1d74"],[14,22,120.66,121.28,"familien"],[23,24,121.28,121.34,"i"],[25,31,121.34,122.08,"italia"],[32,34,122.52,122.64,"og"],[35,37,122.64,122.74,"på~2246356e1d74"],[38,41,122.74,122.96,"den~103625117b77"],[42,50,122.96,123.52,"familien"],[51,54,123.52,123.68,"jeg"],[55,58,123.68,123.9,"bor"],[59,62,123.9,124.12,"hos"],[63,66,124.12,124.34,"her"],[67,68,124.34,124.44,"i"],[69,74,124.44,124.98,"norge~546b56e35dd5"],[76,78,125.72,125.82,"og"],[79,82,125.82,125.98,"jeg"],[83,86,125.98,126.14,"ble"],[87,91,126.14,126.38,"glad"],[92,97,126.38,126.65,"igjen"]]},{"id":26,"start":127.86,"end":132.76,"text":"Jeg har en familie her og en familie der, og det er veldig fint.","zh":"我在这里有一个家，在那里也有一个家，这真的很好。","words":[[0,3,127.92,128.06,"jeg"],[4,7,128.06,128.34,"har"],[8,10,128.34,128.6,"en~a939a9e56dc5"],[11,18,128.6,129.06,"familie"],[19,22,129.06,129.53,"her"],[23,25,129.82,129.96,"og"],[26,28,129.96,130.18,"en~a939a9e56dc5"],[29,36,130.18,130.62,"familie"],[37,40,130.62,131.08,"der"],[42,44,131.42,131.52,"og"],[45,48,131.52,131.7,"det"],[49,51,131.7,131.84,"er"],[52,58,131.84,132.24,"veldig"],[59,63,132.24,132.61,"fint"]]},{"id":27,"start":134.04,"end":141.82,"text":"Jeg legger ved to bilder her i mailen, og jeg gleder meg til å vise deg alle bildene, Synne. Vi snakkes snart igjen.","zh":"我在邮件里附上两张照片，辛妮，我很期待给你看所有的照片。我们很快再聊。","words":[[0,3,134.1,134.24,"jeg"],[4,10,134.24,134.52,"legger~74792109a55f"],[11,14,134.52,134.84,"ved~1ec794a4fd6b"],[15,17,134.84,135.08,"to"],[18,24,135.08,135.54,"bilder"],[25,28,135.54,135.74,"her"],[29,30,135.74,135.82,"i"],[31,37,135.82,136.4,"mailen"],[39,41,136.84,136.92,"og"],[42,45,136.92,137.08,"jeg"],[46,52,137.08,137.5,"gleder"],[53,56,137.5,137.7,"meg"],[57,60,137.7,137.84,"til~f6df3d4686b1"],[61,62,137.84,137.92,"å~0583da7a620a"],[63,67,137.92,138.2,"vise"],[68,71,138.2,138.32,"deg"],[72,76,138.32,138.56,"alle~6873d9584096"],[77,84,138.56,139.04,"bildene"],[86,91,139.04,139.5,"synne"],[93,95,140.58,140.72,"vi"],[96,103,140.72,141.06,"snakkes~0cbe05857e4a"],[104,109,141.06,141.34,"snart"],[110,115,141.34,141.67,"igjen"]]},{"id":28,"start":142.61,"end":143.84,"text":"Klem fra Viola.","zh":"来自维奥拉的拥抱。","words":[[0,4,142.67,143.08,"klem"],[5,8,143.08,143.28,"fra"],[9,14,143.28,143.69,"viola"]]},{"id":29,"start":147.76,"end":149.83,"text":"I Bergen traff jeg mamma og pappa.","zh":"在卑尔根我见到了爸爸妈妈。","words":[[0,1,147.82,147.98,"i"],[2,8,147.98,148.46,"bergen"],[9,14,148.46,148.72,"traff"],[15,18,148.72,148.84,"jeg"],[19,24,148.84,149.16,"mamma"],[25,27,149.16,149.28,"og"],[28,33,149.28,149.68,"pappa"]]}],"lexicon":{"7.2":{"lemma":"7.2","zh":"第 7.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":"pronunciation/30e3d1e2053d54e76c16.mp3"},"bildene":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","form":"复数定指","clip":null},"bilder":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","form":"复数不定","clip":null},"ble":{"lemma":"bli","zh":"变成；成为；留下（依语境）","pos":"动词","ref":"9-068","form":"过去时","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e3751847918c.mp3"},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词