{"id":"3.2","title":"Jeg kommer ikke på norskkurs i dag","audio":"audio/3.2.mp3","duration":105.89,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.93,"text":"3.2 Jeg kommer ikke på norskkurs i dag","heading":true,"zh":"3.2 我今天不来上挪威语课","words":[[0,3,0.15,1.08,"3.2"],[4,7,2.37,2.65,"jeg"],[8,14,2.65,3.09,"kommer"],[15,19,3.09,3.41,"ikke"],[20,22,3.41,3.67,"på~2f682701c302"],[23,32,3.67,4.27,"norskkurs"],[33,34,4.27,4.47,"i~de136e71704d"],[35,38,4.47,4.85,"dag~83a758a6ca25"]]},{"id":1,"start":7.17,"end":10.33,"text":"Ismail er sønnen til Yousef.","zh":"伊斯梅尔是优素福的儿子。","words":[[0,6,7.25,7.77,"ismail"],[7,9,7.77,8.45,"er"],[10,16,8.45,9.05,"sønnen"],[17,20,9.05,9.33,"til~8de1a9181f86"],[21,27,9.33,10.25,"yousef"]]},{"id":2,"start":11.69,"end":16.11,"text":"I dag er Yousef hjemme, for Ismail er syk.","zh":"今天优素福在家，因为伊斯梅尔病了。","words":[[0,1,11.77,11.96,"i~de136e71704d"],[2,5,11.96,12.26,"dag~83a758a6ca25"],[6,8,12.26,12.76,"er"],[9,15,12.76,13.32,"yousef"],[16,22,13.32,13.92,"hjemme"],[24,27,14.2,14.46,"for~a05c87659379"],[28,34,14.46,15.2,"ismail"],[35,37,15.2,15.44,"er"],[38,41,15.44,16.03,"syk"]]},{"id":3,"start":17.47,"end":20.36,"text":"Ismail ligger i senga og sover.","zh":"伊斯梅尔躺在床上睡觉。","words":[[0,6,17.55,18.06,"ismail"],[7,13,18.06,18.44,"ligger"],[14,15,18.44,18.7,"i"],[16,21,18.7,19.12,"senga"],[22,24,19.12,19.62,"og"],[25,30,19.62,20.28,"sover"]]},{"id":4,"start":21.76,"end":25.2,"text":"Yousef lager mat og gjør husarbeid.","zh":"优素福做饭、做家务。","words":[[0,6,21.84,22.46,"yousef"],[7,12,22.46,22.88,"lager~61c7d708dd47"],[13,16,22.88,23.36,"mat"],[17,19,23.36,23.76,"og"],[20,24,23.76,24.04,"gjør"],[25,34,24.04,25.12,"husarbeid"]]},{"id":5,"start":26.05,"end":29.46,"text":"Han rydder huset og støvsuger gulvet.","zh":"他收拾房子，用吸尘器吸地板。","words":[[0,3,26.13,26.32,"han"],[4,10,26.32,26.76,"rydder"],[11,16,26.76,27.28,"huset"],[17,19,27.28,28.12,"og"],[20,29,28.12,28.82,"støvsuger"],[30,36,28.82,29.38,"gulvet"]]},{"id":6,"start":30.75,"end":33.16,"text":"Kona til Yousef er på jobb.","zh":"优素福的妻子在上班。","words":[[0,4,30.83,31.23,"kona"],[5,8,31.23,31.47,"til~8de1a9181f86"],[9,15,31.47,32.11,"yousef"],[16,18,32.11,32.41,"er"],[19,21,32.41,32.61,"på"],[22,26,32.61,33.08,"jobb"]]},{"id":7,"start":34.02,"end":35.97,"text":"Hun kommer hjem klokka to.","zh":"她两点回家。","words":[[0,3,34.1,34.31,"hun"],[4,10,34.31,34.65,"kommer"],[11,15,34.65,35.03,"hjem~3f5fbf6a493e"],[16,22,35.03,35.19,"klokka"],[23,25,35.19,35.89,"to"]]},{"id":8,"start":37.51,"end":40.84,"text":"Telefonen ringer, og Yousef svarer.","zh":"电话响了，优素福接电话。","words":[[0,9,37.59,38.22,"telefonen"],[10,16,38.22,38.66,"ringer~be9be71a80b3"],[18,20,39.32,39.54,"og"],[21,27,39.54,40.1,"yousef"],[28,34,40.1,40.76,"svarer~279806dda3ec"]]},{"id":9,"start":45.04,"end":47.29,"text":"Hallo, det er Yousef.","speaker":"Yousef","zh":"喂，我是优素福。","words":[[0,5,45.12,45.45,"hallo"],[7,10,46.07,46.35,"det~b9f96941724d"],[11,13,46.35,46.49,"er"],[14,20,46.49,47.21,"yousef"]]},{"id":10,"start":48.32,"end":56.94,"text":"Hei, Yousef! Det er Håvard. Du er ikke på skolen i dag. Er du syk?","speaker":"Håvard","zh":"你好，优素福！我是霍瓦尔。你今天没来学校。你生病了吗？","words":[[0,3,48.4,48.72,"hei"],[5,11,48.74,49.28,"yousef"],[13,16,50.57,50.69,"det~b9f96941724d"],[17,19,50.69,50.83,"er"],[20,26,50.83,51.27,"håvard"],[28,30,53.16,53.36,"du"],[31,33,53.36,53.64,"er"],[34,38,53.64,53.84,"ikke"],[39,41,53.84,54.06,"på"],[42,48,54.06,54.48,"skolen"],[49,50,54.48,54.66,"i~de136e71704d"],[51,54,54.66,54.84,"dag~83a758a6ca25"],[56,58,55.76,56.1,"er"],[59,61,56.1,56.28,"du"],[62,65,56.28,56.86,"syk"]]},{"id":11,"start":58.05,"end":63.94,"text":"Nei. Jeg er hjemme, for Ismail er syk, og Leyla jobber.","speaker":"Yousef","zh":"没有。我在家，因为伊斯梅尔病了，莱拉在上班。","words":[[0,3,58.13,58.55,"nei"],[5,8,59.07,59.25,"jeg"],[9,11,59.25,59.45,"er"],[12,18,59.45,59.91,"hjemme"],[20,23,60.54,60.8,"for~a05c87659379"],[24,30,60.8,61.3,"ismail"],[31,33,61.3,61.78,"er"],[34,37,61.78,62.36,"syk"],[39,41,62.36,62.92,"og"],[42,47,62.92,63.24,"leyla"],[48,54,63.36,63.86,"jobber~003ddb6d77e6"]]},{"id":12,"start":64.98,"end":65.99,"text":"Jeg forstår.","speaker":"Håvard","zh":"我明白了。","words":[[0,3,65.06,65.2,"jeg"],[4,11,65.2,65.91,"forstår"]]},{"id":13,"start":66.11,"end":70.18,"text":"Jeg skal sende SMS til deg neste gang, Håvard.","speaker":"Yousef","zh":"霍瓦尔，下次我会给你发短信。","words":[[0,3,66.82,67.3,"jeg"],[4,8,67.3,67.52,"skal"],[9,14,67.52,68.0,"sende"],[15,18,68.0,68.36,"sms"],[19,22,68.36,68.76,"til"],[23,26,68.76,68.96,"deg"],[27,32,68.96,69.24,"neste~a4f76403b031"],[33,37,69.24,69.6,"gang~acdfed0361f2"],[39,45,69.72,70.1,"håvard"]]},{"id":14,"start":71.29,"end":75.91,"text":"Det er bra. Skal Leyla jobbe i morgen også?","speaker":"Håvard","zh":"好的。莱拉明天也要上班吗？","words":[[0,3,71.37,71.66,"det"],[4,6,71.66,71.78,"er"],[7,10,71.78,72.0,"bra~bbb83846e29f"],[12,16,73.46,73.96,"skal"],[17,22,73.96,74.5,"leyla"],[23,28,74.5,74.96,"jobbe"],[29,30,74.96,75.14,"i~46dcc9198d6d"],[31,37,75.14,75.24,"morgen~a09fa253039f"],[38,42,75.37,75.83,"også"]]},{"id":15,"start":75.96,"end":80.36,"text":"Ja, men Ismail er kanskje frisk i morgen.","speaker":"Yousef","zh":"是的，不过伊斯梅尔明天也许就好了。","words":[[0,2,76.29,77.37,"ja"],[4,7,77.79,77.97,"men"],[8,14,77.97,78.47,"ismail"],[15,17,78.47,78.79,"er"],[18,25,78.79,79.19,"kanskje"],[26,31,79.19,79.63,"frisk"],[32,33,79.63,79.77,"i~46dcc9198d6d"],[34,40,79.77,80.28,"morgen~a09fa253039f"]]},{"id":16,"start":81.5,"end":84.88,"text":"Håper jeg. God bedring til ham!","speaker":"Håvard","zh":"希望如此。祝他早日康复！","words":[[0,5,81.58,82.25,"håper"],[6,9,82.25,82.45,"jeg"],[11,14,83.6,83.9,"god~44e35664574a"],[15,22,83.9,84.32,"bedring"],[23,26,84.32,84.5,"til"],[27,30,84.5,84.8,"ham"]]},{"id":17,"start":84.97,"end":88.18,"text":"Tusen takk. Vi ses!","speaker":"Yousef","zh":"非常感谢。回头见！","words":[[0,5,85.76,86.42,"tusen"],[6,10,86.54,86.86,"takk"],[12,14,87.32,87.52,"vi"],[15,18,87.52,88.1,"ses~eec2d40d2d3f"]]},{"id":18,"start":89.25,"end":91.76,"text":"Vi ses! Ha det bra!","speaker":"Håvard","zh":"回头见！再见！","words":[[0,2,89.33,89.64,"vi"],[3,6,89.64,89.86,"ses~eec2d40d2d3f"],[8,10,91.02,91.24,"ha~f5b6194409e1"],[11,14,91.24,91.36,"det~58cfefde490a"],[15,18,91.36,91.68,"bra~9ed229260de6"]]},{"id":19,"start":93.75,"end":94.81,"text":"Hei Håvard.","zh":"你好，霍瓦尔。","words":[[0,3,93.83,94.19,"hei"],[4,10,94.23,94.73,"håvard"]]},{"id":20,"start":95.43,"end":99.66,"text":"Jeg kommer ikke på skolen i dag, for Ismail er syk.","zh":"我今天不来学校了，因为伊斯梅尔病了。","words":[[0,3,95.51,95.69,"jeg"],[4,10,95.69,96.01,"kommer"],[11,15,96.01,96.49,"ikke"],[16,18,96.49,96.67,"på~57bd83edfd51"],[19,25,96.67,97.05,"skolen"],[26,27,97.05,97.15,"i~de136e71704d"],[28,31,97.15,97.35,"dag~83a758a6ca25"],[33,36,97.95,98.15,"for~a05c87659379"],[37,43,98.15,98.75,"ismail"],[44,46,98.75,99.07,"er"],[47,50,99.07,99.58,"syk"]]},{"id":21,"start":100.17,"end":101.67,"text":"Hilsen Yousef","zh":"优素福 敬上","words":[[0,6,100.25,100.81,"hilsen"],[7,13,100.81,101.59,"yousef"]]}],"lexicon":{"3.2":{"lemma":"3.2","zh":"第 3.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"bedring":{"lemma":"bedring","zh":"好转；康复（God bedring!：祝早日康复！）","pos":"名词","ref":null,"clip":null},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"deg":{"lemma":"deg","zh":"你（单数宾格）","pos":"代词","ref":"basics:pronouns:deg","clip":"pronunciation/f8b61df211696e11c220.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"for":{"lemma":"for","zh":"因为（连词）；为了；对于；（takk for）为……；（for + 形容词）太","pos":"连词／介词","ref":"3-052","clip":"pronunciation/10c22bcf4c768b515be4.mp3"},"forstår":