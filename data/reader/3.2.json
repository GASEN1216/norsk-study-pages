{"id":"3.2","title":"Jeg kommer ikke på norskkurs i dag","audio":"audio/3.2.mp3","duration":105.89,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.93,"text":"3.2 Jeg kommer ikke på norskkurs i dag","heading":true,"zh":"3.2 我今天不来上挪威语课","words":[[0,3,0.15,1.08,"3.2"],[4,7,2.37,2.65,"jeg"],[8,14,2.65,3.09,"kommer"],[15,19,3.09,3.41,"ikke"],[20,22,3.41,3.67,"på~2f682701c302"],[23,32,3.67,4.27,"norskkurs"],[33,34,4.27,4.47,"i~de136e71704d"],[35,38,4.47,4.85,"dag~83a758a6ca25"]]},{"id":1,"start":7.21,"end":10.47,"text":"Ismail er sønnen til Yousef.","zh":"伊斯梅尔是优素福的儿子。","words":[[0,6,7.27,8.14,"ismail"],[7,9,8.26,8.64,"er"],[10,16,8.64,9.18,"sønnen"],[17,20,9.18,9.54,"til~8de1a9181f86"],[21,27,9.54,10.33,"yousef"]]},{"id":2,"start":11.72,"end":16.16,"text":"I dag er Yousef hjemme, for Ismail er syk.","zh":"今天优素福在家，因为伊斯梅尔病了。","words":[[0,1,11.79,11.96,"i~de136e71704d"],[2,5,11.96,12.52,"dag~83a758a6ca25"],[6,8,12.52,12.84,"er"],[9,15,12.84,13.42,"yousef"],[16,22,13.42,14.06,"hjemme"],[24,27,14.26,14.78,"for~a05c87659379"],[28,34,14.78,15.32,"ismail"],[35,37,15.32,15.5,"er"],[38,41,15.5,16.02,"syk"]]},{"id":3,"start":17.51,"end":20.42,"text":"Ismail ligger i senga og sover.","zh":"伊斯梅尔躺在床上睡觉。","words":[[0,6,17.57,18.24,"ismail"],[7,13,18.24,18.62,"ligger"],[14,15,18.62,18.76,"i"],[16,21,18.76,19.29,"senga"],[22,24,19.46,19.78,"og"],[25,30,19.78,20.27,"sover"]]},{"id":4,"start":21.8,"end":25.26,"text":"Yousef lager mat og gjør husarbeid.","zh":"优素福做饭、做家务。","words":[[0,6,21.86,22.62,"yousef"],[7,12,22.62,23.04,"lager~61c7d708dd47"],[13,16,23.04,23.58,"mat"],[17,19,23.58,23.84,"og"],[20,24,23.84,24.16,"gjør"],[25,34,24.16,25.11,"husarbeid"]]},{"id":5,"start":26.09,"end":29.52,"text":"Han rydder huset og støvsuger gulvet.","zh":"他收拾房子，用吸尘器吸地板。","words":[[0,3,26.14,26.44,"han"],[4,10,26.44,26.88,"rydder"],[11,16,26.88,27.47,"huset"],[17,19,28.02,28.2,"og"],[20,29,28.2,28.94,"støvsuger"],[30,36,28.94,29.38,"gulvet"]]},{"id":6,"start":30.79,"end":33.23,"text":"Kona til Yousef er på jobb.","zh":"优素福的妻子在上班。","words":[[0,4,30.84,31.36,"kona"],[5,8,31.36,31.58,"til~8de1a9181f86"],[9,15,31.58,32.34,"yousef"],[16,18,32.34,32.52,"er"],[19,21,32.52,32.7,"på"],[22,26,32.7,33.08,"jobb"]]},{"id":7,"start":34.05,"end":36.02,"text":"Hun kommer hjem klokka to.","zh":"她两点回家。","words":[[0,3,34.12,34.44,"hun"],[4,10,34.44,34.76,"kommer"],[11,15,34.76,35.2,"hjem~3f5fbf6a493e"],[16,22,35.2,35.54,"klokka"],[23,25,35.54,35.88,"to"]]},{"id":8,"start":37.55,"end":40.9,"text":"Telefonen ringer, og Yousef svarer.","zh":"电话响了，优素福接电话。","words":[[0,9,37.61,38.3,"telefonen"],[10,16,38.3,38.85,"ringer~be9be71a80b3"],[18,20,39.5,39.66,"og"],[21,27,39.66,40.18,"yousef"],[28,34,40.18,40.75,"svarer~279806dda3ec"]]},{"id":9,"start":45.08,"end":47.34,"text":"Hallo, det er Yousef.","speaker":"Yousef","zh":"喂，我是优素福。","words":[[0,5,45.14,45.63,"hallo"],[7,10,46.24,46.38,"det~b9f96941724d"],[11,13,46.38,46.56,"er"],[14,20,46.56,47.19,"yousef"]]},{"id":10,"start":48.37,"end":56.99,"text":"Hei, Yousef! Det er Håvard. Du er ikke på skolen i dag. Er du syk?","speaker":"Håvard","zh":"你好，优素福！我是霍瓦尔。你今天没来学校。你生病了吗？","words":[[0,3,48.43,48.78,"hei"],[5,11,48.78,49.48,"yousef"],[13,16,50.56,50.74,"det~b9f96941724d"],[17,19,50.74,50.9,"er"],[20,26,50.9,51.53,"håvard"],[28,30,53.22,53.46,"du"],[31,33,53.46,53.68,"er"],[34,38,53.68,53.92,"ikke"],[39,41,53.92,54.16,"på"],[42,48,54.16,54.6,"skolen"],[49,50,54.6,54.66,"i~de136e71704d"],[51,54,54.66,55.12,"dag~83a758a6ca25"],[56,58,55.94,56.14,"er"],[59,61,56.14,56.36,"du"],[62,65,56.36,56.84,"syk"]]},{"id":11,"start":58.09,"end":64.01,"text":"Nei. Jeg er hjemme, for Ismail er syk, og Leyla jobber.","speaker":"Yousef","zh":"没有。我在家，因为伊斯梅尔病了，莱拉在上班。","words":[[0,3,58.15,58.66,"nei"],[5,8,59.12,59.34,"jeg"],[9,11,59.34,59.5,"er"],[12,18,59.5,60.05,"hjemme"],[20,23,60.66,60.9,"for~a05c87659379"],[24,30,60.9,61.7,"ismail"],[31,33,61.7,61.92,"er"],[34,37,61.92,62.53,"syk"],[39,41,62.82,62.98,"og"],[42,47,62.98,63.42,"leyla"],[48,54,63.42,63.86,"jobber~003ddb6d77e6"]]},{"id":12,"start":65.03,"end":66.05,"text":"Jeg forstår.","speaker":"Håvard","zh":"我明白了。","words":[[0,3,65.09,65.36,"jeg"],[4,11,65.36,65.9,"forstår"]]},{"id":13,"start":67.15,"end":70.25,"text":"Jeg skal sende SMS til deg neste gang, Håvard.","speaker":"Yousef","zh":"霍瓦尔，下次我会给你发短信。","words":[[0,3,67.21,67.4,"jeg"],[4,8,67.4,67.66,"skal"],[9,14,67.66,68.1,"sende"],[15,18,68.1,68.64,"sms"],[19,22,68.64,68.82,"til"],[23,26,68.82,69.1,"deg"],[27,32,69.1,69.44,"neste~a4f76403b031"],[33,37,69.44,69.72,"gang~acdfed0361f2"],[39,45,69.72,70.1,"håvard"]]},{"id":14,"start":71.33,"end":75.97,"text":"Det er bra. Skal Leyla jobbe i morgen også?","speaker":"Håvard","zh":"好的。莱拉明天也要上班吗？","words":[[0,3,71.39,71.7,"det"],[4,6,71.7,71.82,"er"],[7,10,71.82,72.2,"bra~bbb83846e29f"],[12,16,73.58,74.16,"skal"],[17,22,74.16,74.66,"leyla"],[23,28,74.66,75.08,"jobbe"],[29,30,75.08,75.2,"i~46dcc9198d6d"],[31,37,75.2,75.48,"morgen~a09fa253039f"],[38,42,75.48,75.82,"også"]]},{"id":15,"start":77.02,"end":80.44,"text":"Ja, men Ismail er kanskje frisk i morgen.","speaker":"Yousef","zh":"是的，不过伊斯梅尔明天也许就好了。","words":[[0,2,77.08,77.46,"ja"],[4,7,77.84,78.04,"men"],[8,14,78.04,78.7,"ismail"],[15,17,78.7,78.86,"er"],[18,25,78.86,79.26,"kanskje"],[26,31,79.26,79.74,"frisk"],[32,33,79.74,79.84,"i~46dcc9198d6d"],[34,40,79.84,80.29,"morgen~a09fa253039f"]]},{"id":16,"start":81.54,"end":84.93,"text":"Det håper jeg. God bedring til ham!","speaker":"Håvard","zh":"希望如此。祝他早日康复！","words":[[0,3,81.6,81.98,"det"],[4,9,81.98,82.28,"håper"],[10,13,82.28,82.66,"jeg"],[15,18,83.76,83.98,"god~44e35664574a"],[19,26,83.98,84.4,"bedring"],[27,30,84.4,84.54,"til"],[31,34,84.54,84.78,"ham"]]},{"id":17,"start":86.01,"end":88.24,"text":"Tusen takk. Vi ses!","speaker":"Yousef","zh":"非常感谢。回头见！","words":[[0,5,86.07,86.46,"tusen"],[6,10,86.46,86.98,"takk"],[12,14,87.38,87.58,"vi"],[15,18,87.58,88.09,"ses~eec2d40d2d3f"]]},{"id":18,"start":89.28,"end":91.83,"text":"Vi ses! Ha det bra!","speaker":"Håvard","zh":"回头见！再见！","words":[[0,2,89.34,89.68,"vi"],[3,6,89.68,90.22,"ses~eec2d40d2d3f"],[8,10,91.1,91.28,"ha~f5b6194409e1"],[11,14,91.28,91.4,"det~58cfefde490a"],[15,18,91.4,91.68,"bra~9ed229260de6"]]},{"id":19,"start":93.79,"end":94.87,"text":"Hei Håvard.","zh":"你好，霍瓦尔。","words":[[0,3,93.85,94.26,"hei"],[4,10,94.26,94.72,"håvard"]]},{"id":20,"start":95.47,"end":99.72,"text":"Jeg kommer ikke på skolen i dag, for Ismail er syk.","zh":"我今天不来学校了，因为伊斯梅尔病了。","words":[[0,3,95.53,95.78,"jeg"],[4,10,95.78,96.3,"kommer"],[11,15,96.3,96.58,"ikke"],[16,18,96.58,96.74,"på~57bd83edfd51"],[19,25,96.74,97.12,"skolen"],[26,27,97.12,97.18,"i~de136e71704d"],[28,31,97.18,97.64,"dag~83a758a6ca25"],[33,36,98.0,98.3,"for~a05c87659379"],[37,43,98.3,98.98,"ismail"],[44,46,98.98,99.14,"er"],[47,50,99.14,99.57,"syk"]]},{"id":21,"start":100.2,"end":101.73,"text":"Hilsen Yousef","zh":"优素福 敬上","words":[[0,6,100.26,100.96,"hilsen"],[7,13,100.96,101.58,"yousef"]]}],"lexicon":{"3.2":{"lemma":"3.2","zh":"第 3.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"bedring":{"lemma":"bedring","zh":"好转；康复（God bedring!：祝早日康复！）","pos":"名词","ref":null,"clip":null},"bra":{"lemma":"bra","zh":"好的；很好","pos":"形容词／副词","ref":"pa-vei-2-018","clip":"pronunciation/8f684d401d2bd253c862.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"deg":{"lemma":"deg","zh":"你（单数宾格）","pos":"代词","ref":"basics:pronouns:deg","clip":"pronunciation/f8b61df211696e11c220.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"for":{"lemma":"for","zh":"因为（连词）；为了；对于；（takk for）为……；（for + 形容词）太","pos":"连词／介词","ref":"3-052","clip":"pronunciation/10c22bcf4c768b515be4.m