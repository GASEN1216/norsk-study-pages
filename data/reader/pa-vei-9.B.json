{"id":"pa-vei-9.B","bookId":"pa-vei-textbook","readingId":"9.B","title":"Velkommen til bords!","audio":"audio/pa-vei/9.B.mp3","duration":132.288,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.0,"end":5.785,"text":"Haifa er invitert til venninna si, Torunn, og mannen hennes, Per.","zh":"海法受邀到朋友托伦和她丈夫佩尔家做客。","words":[[0,5,1.0,1.525,"haifa"],[6,8,1.58,1.763,"er"],[9,17,1.763,2.412,"invitert"],[18,21,2.412,2.565,"til"],[22,30,2.58,3.125,"venninna"],[31,33,3.18,3.385,"si@pa-vei-si-possessive"],[35,41,3.44,3.925,"torunn"],[43,45,4.54,4.685,"og"],[46,52,4.7,5.043,"mannen"],[53,59,5.043,5.405,"hennes"],[61,64,5.46,5.785,"per@pa-vei-per-name"]]},{"id":1,"start":7.36,"end":8.585,"text":"Velkommen, Haifa.","zh":"欢迎你，海法。","words":[[0,9,7.36,8.145,"velkommen"],[11,16,8.18,8.585,"haifa"]],"speaker":"Per"},{"id":2,"start":9.3,"end":10.065,"text":"Og god jul!","zh":"圣诞快乐！","words":[[0,2,9.3,9.445,"og"],[3,6,9.46,9.725,"god"],[7,10,9.74,10.065,"jul"]],"speaker":"Per"},{"id":3,"start":10.88,"end":11.845,"text":"Hyggelig å se deg.","zh":"很高兴见到你。","words":[[0,8,10.88,11.303,"hyggelig"],[9,10,11.303,11.405,"å"],[11,13,11.42,11.585,"se"],[14,17,11.66,11.845,"deg"]],"speaker":"Per"},{"id":4,"start":13.078,"end":13.763,"text":"Takk skal du ha.","zh":"谢谢。","words":[[0,4,13.078,13.341,"takk"],[5,9,13.341,13.53,"skal"],[10,12,13.53,13.64,"du"],[13,15,13.64,13.763,"ha"]],"speaker":"Haifa"},{"id":5,"start":14.278,"end":15.503,"text":"Og takk for innbydelsen.","zh":"也谢谢你们的邀请。","words":[[0,2,14.278,14.423,"og"],[3,7,14.498,14.741,"takk"],[8,11,14.741,14.88,"for"],[12,23,14.88,15.503,"innbydelsen"]],"speaker":"Haifa"},{"id":6,"start":16.398,"end":16.863,"text":"Vær så god.","zh":"请收下。","words":[[0,3,16.398,16.55,"vær@pa-vei-vær-be"],[4,6,16.55,16.671,"så"],[7,10,16.671,16.863,"god"]],"speaker":"Haifa"},{"id":7,"start":17.338,"end":18.723,"text":"Jeg har med noen blomster til dere.","zh":"我给你们带了些花。","words":[[0,3,17.338,17.491,"jeg"],[4,7,17.491,17.651,"har"],[8,11,17.651,17.78,"med"],[12,16,17.78,17.98,"noen"],[17,25,17.98,18.38,"blomster"],[26,29,18.38,18.48,"til"],[30,34,18.48,18.723,"dere"]],"speaker":"Haifa"},{"id":8,"start":19.898,"end":20.823,"text":"Tusen takk.","zh":"非常感谢。","words":[[0,5,19.898,20.483,"tusen"],[6,10,20.498,20.823,"takk"]],"speaker":"Torunn"},{"id":9,"start":21.218,"end":22.363,"text":"De er nydelige.","zh":"花真漂亮。","words":[[0,2,21.218,21.363,"de"],[3,5,21.458,21.603,"er"],[6,14,21.738,22.363,"nydelige"]],"speaker":"Torunn"},{"id":10,"start":23.038,"end":23.843,"text":"Og takk for sist.","zh":"也谢谢上次的款待。","words":[[0,2,23.038,23.163,"og"],[3,7,23.178,23.443,"takk"],[8,11,23.458,23.603,"for"],[12,16,23.618,23.843,"sist"]],"speaker":"Torunn"},{"id":11,"start":24.798,"end":27.143,"text":"Det var så hyggelig å treffe familien din.","zh":"能见到你的家人真高兴。","words":[[0,3,24.798,24.941,"det"],[4,7,24.941,25.103,"var"],[8,10,25.198,25.383,"så"],[11,19,25.498,25.92,"hyggelig"],[20,21,25.92,26.023,"å"],[22,28,26.038,26.383,"treffe"],[29,37,26.398,26.941,"familien"],[38,41,26.941,27.143,"din"]],"speaker":"Torunn"},{"id":12,"start":28.198,"end":29.123,"text":"De likte deg også.","zh":"他们也很喜欢你。","words":[[0,2,28.198,28.321,"de"],[3,8,28.321,28.66,"likte"],[9,12,28.66,28.84,"deg"],[13,17,28.84,29.123,"også"]],"speaker":"Haifa"},{"id":13,"start":30.098,"end":31.323,"text":"Jeg henger kåpa di her.","zh":"我把你的大衣挂在这里。","words":[[0,3,30.098,30.24,"jeg"],[4,10,30.24,30.543,"henger"],[11,15,30.558,30.941,"kåpa"],[16,18,30.941,31.083,"di"],[19,22,31.098,31.323,"her"]],"speaker":"Torunn"},{"id":14,"start":32.118,"end":32.463,"text":"Takk.","zh":"谢谢。","words":[[0,4,32.118,32.463,"takk"]],"speaker":"Haifa"},{"id":15,"start":33.758,"end":34.623,"text":"Kom og sett dere.","zh":"过来坐吧。","words":[[0,3,33.758,33.963,"kom@pa-vei-kom-imperative"],[4,6,34.018,34.13,"og"],[7,11,34.13,34.391,"sett@pa-vei-sett-imperative"],[12,16,34.391,34.623,"dere"]],"speaker":"Per"},{"id":16,"start":34.978,"end":35.923,"text":"Maten er ferdig.","zh":"饭做好了。","words":[[0,5,34.978,35.401,"maten"],[6,8,35.401,35.52,"er"],[9,15,35.52,35.923,"ferdig"]],"speaker":"Per"},{"id":17,"start":37.478,"end":38.403,"text":"Det lukter godt.","zh":"闻起来真香。","words":[[0,3,37.478,37.643,"det"],[4,10,37.758,38.1,"lukter"],[11,15,38.1,38.403,"godt"]],"speaker":"Haifa"},{"id":18,"start":39.678,"end":40.763,"text":"Per lager maten.","zh":"饭是佩尔做的。","words":[[0,3,39.678,40.043,"per@pa-vei-per-name"],[4,9,40.078,40.403,"lager"],[10,15,40.418,40.763,"maten"]],"speaker":"Torunn"},{"id":19,"start":41.358,"end":42.863,"text":"Han er pinnekjøtteksperten.","zh":"他可是做风干盐渍羊排的专家。","words":[[0,3,41.358,41.543,"han"],[4,6,41.558,41.703,"er"],[7,26,41.718,42.863,"pinnekjøtteksperten"]],"speaker":"Torunn"},{"id":20,"start":43.658,"end":44.343,"text":"Pinnekjøtt?","zh":"风干盐渍羊排？","words":[[0,10,43.658,44.343,"pinnekjøtt"]],"speaker":"Haifa"},{"id":21,"start":44.978,"end":46.043,"text":"Det ser spennende ut.","zh":"看起来很特别。","words":[[0,3,44.978,45.141,"det"],[4,7,45.141,45.363,"ser"],[8,17,45.398,45.85,"spennende"],[18,20,45.85,46.043,"ut"]],"speaker":"Haifa"},{"id":22,"start":46.758,"end":47.323,"text":"Er det lam?","zh":"是羊肉吗？","words":[[0,2,46.758,46.891,"er"],[3,6,46.891,47.043,"det"],[7,10,47.118,47.323,"lam"]],"speaker":"Haifa"},{"id":23,"start":48.518,"end":52.723,"text":"Ja, det er tørket og saltet lammekjøtt.","zh":"是的，是风干后用盐腌制的羊肉。","words":[[0,2,48.518,48.683,"ja"],[4,7,49.678,49.863,"det"],[8,10,49.878,50.043,"er"],[11,17,50.258,51.003,"tørket"],[18,20,51.178,51.303,"og"],[21,27,51.338,51.943,"saltet"],[28,38,51.998,52.723,"lammekjøtt"]],"speaker":"Per"},{"id":24,"start":53.798,"end":55.183,"text":"Du kan sitte her, Haifa.","zh":"海法，你可以坐这里。","words":[[0,2,53.798,53.943,"du"],[3,6,53.958,54.141,"kan"],[7,12,54.141,54.443,"sitte"],[13,16,54.478,54.743,"her"],[18,23,54.778,55.183,"haifa"]],"speaker":"Per"},{"id":25,"start":56.298,"end":57.463,"text":"Nå må dere forsyne dere.","zh":"现在大家自己夹菜吧。","words":[[0,2,56.298,56.421,"nå"],[3,5,56.421,56.531,"må"],[6,10,56.531,56.751,"dere"],[11,18,56.751,57.191,"forsyne"],[19,23,57.191,57.463,"dere"]],"speaker":"Per"},{"id":26,"start":58.538,"end":58.883,"text":"Takk.","zh":"谢谢。","words":[[0,4,58.538,58.883,"takk"]],"speaker":"Haifa"},{"id":27,"start":60.358,"end":61.203,"text":"Kålrabistappe?","zh":"来点芜菁甘蓝泥吗？","words":[[0,13,60.358,61.203,"kålrabistappe"]],"speaker":"Per"},{"id":28,"start":62.518,"end":62.883,"text":"Gjerne.","zh":"好呀。","words":[[0,6,62.518,62.883,"gjerne"]],"speaker":"Haifa"},{"id":29,"start":63.278,"end":64.163,"text":"Det ser godt ut.","zh":"看起来很好吃。","words":[[0,3,63.278,63.443,"det"],[4,7,63.518,63.721,"ser"],[8,12,63.721,63.93,"godt"],[13,15,63.93,64.163,"ut"]],"speaker":"Haifa"},{"id":30,"start":65.498,"end":66.623,"text":"Det er godt med øl til.","zh":"配啤酒喝很不错。","words":[[0,3,65.498,65.641,"det"],[4,6,65.641,65.751,"er"],[7,11,65.751,65.96,"godt"],[12,15,65.96,66.103,"med"],[16,18,66.138,66.303,"øl"],[19,22,66.418,66.623,"til"]],"speaker":"Per"},{"id":31,"start":67.358,"end":68.203,"text":"Vil du ha et glass?","zh":"你要来一杯吗？","words":[[0,3,67.358,67.511,"vil"],[4,6,67.511,67.611,"du"],[7,9,67.611,67.743,"ha"],[10,12,67.758,67.9,"et"],[13,18,67.9,68.203,"glass"]],"speaker":"Per"},{"id":32,"start":69.398,"end":71.003,"text":"Nei takk, bare vann til meg.","zh":"不用了，谢谢，我喝水就好。","words":[[0,3,69.398,69.62,"nei"],[4,8,69.62,69.903,"takk"],[10,14,70.238,70.49,"bare"],[15,19,70.49,70.71,"vann"],[20,23,70.71,70.831,"til"],[24,27,70.831,71.003,"meg"]],"speaker":"Haifa"},{"id":33,"start":74.478,"end":74.663,"text":"Mmm.","zh":"嗯。","words":[[0,3,74.478,74.663,"mmm"]],"speaker":"Haifa"},{"id":34,"start":75.318,"end":76.623,"text":"Det smaker nydelig.","zh":"味道真好。","words":[[0,3,75.318,75.481,"det"],[4,10,75.481,75.943,"smaker"],[11,18,76.018,76.623,"nydelig"]],"speaker":"Haifa"},{"id":35,"start":77.738,"end":78.943,"text":"Vil du ha litt mer kjøtt?","zh":"还要来点肉吗？","words":[[0,3,77.738,77.891,"vil"],[4,6,77.891,78.0,"du"],[7,9,78.0,78.123,"ha"],[10,14,78.138,78.35,"litt"],[15,18,78.35,78.543,"mer"],[19,24,78.578,78.943,"kjøtt"]],"speaker":"Per"},{"id":36,"start":79.978,"end":80.523,"text":"Ja takk.","zh":"好的，谢谢。","words":[[0,2,79.978,80.143,"ja"],[3,7,80.218,80.523,"takk"]],"speaker":"Haifa"},{"id":37,"start":80.978,"end":82.323,"text":"Du er en flink kokk, Per.","zh":"佩尔，你的厨艺真棒。","words":[[0,2,80.978,81.111,"du"],[3,5,81.111,81.231,"er"],[6,8,81.231,81.343,"en"],[9,14,81.398,81.761,"flink"],[15,19,81.761,82.041,"kokk"],[21,24,82.041,82.323,"per@pa-vei-per-name"]],"speaker":"Haifa"},{"id":38,"start":83.378,"end":84.123,"text":"Synes du det?","zh":"你这么觉得？","words":[[0,5,83.378,83.85,"synes"],[6,8,83.85,83.96,"du"],[9,12,83.96,84.123,"det"]],"speaker":"Per (ler)"},{"id":39,"start":85.278,"end":86.343,"text":"Det synes jeg også!","zh":"我也这么觉得！","words":[[0,3,85.278,85.423,"det"],[4,9,85.438,85.803,"synes"],[10,13,85.818,86.003,"jeg"],[14,18,86.058,86.343,"også"]],"speaker":"Per (ler)"},{"id":40,"start":87.738,"end":89.043,"text":"Per er fra Vestlandet.","zh":"佩尔来自挪威西部。","words":[[0,3,87.738,88.043,"per@pa-vei-per-name"],[4,6,88.058,88.21,"er"],[7,10,88.21,88.363,"fra"],[11,21,88.378,89.043,"vestlandet"]],"speaker":"Torunn"},{"id":41,"start":89.838,"end":92.123,"text":"Der er pinnekjøtt vanlig julemat.","zh":"那里的圣诞节通常吃风干盐渍羊排。","words":[[0,3,89.838,90.123,"der"],[4,6,90.178,90.343,"er"],[7,17,90.378,91.043,"pinnekjøtt"],[18,24,91.058,91.503,"vanlig"],[25,32,91.518,92.123,"julemat"]],"speaker":"Torunn"},{"id":42,"start":93.218,"end":97.643,"text":"Jeg er fra Østlandet, og der pleier vi å spise ribbe på julaften.","zh":"我来自挪威东部，我们那里平安夜通常吃烤猪肋排。","words":[[0,3,93.218,93.443,"jeg"],[4,6,93.458,93.601,"er"],[7,10,93.601,93.783,"fra"],[11,20,93.858,94.483,"østlandet"],[22,24,95.118,95.243,"og"],[25,28,95.258,95.523,"der"],[29,35,95.538,95.861,"pleier"],[36,38,95.861,95.963,"vi"],[39,40,95.978,96.081,"å"],[41,46,96.081,96.483,"spise"],[47,52,96.498,96.903,"ribbe"],[53,55,96.938,97.063,"på"],[56,64,97.078,97.643,"julaften"]],"speaker":"Torunn"},{"id":43,"start":98.778,"end":102.183,"text":"Ribbe er svinekjøtt med masse fett på.","zh":"烤猪肋排就是带着很多脂肪的猪肉。","words":[[0,5,98.778,99.343,"ribbe"],[6,8,99.418,99.583,"er"],[9,19,99.938,100.923,"svinekjøtt"],[20,23,101.078,101.24,"med"],[24,29,101.24,101.583,"masse"],[30,34,101.638,101.983,"fett"],[35,37,102.038,102.183,"på"]],"speaker":"Per"},{"id":44,"start":103.418,"end":104.683,"text":"Men det smaker godt!","zh":"不过味道很好！","words":[[0,3,103.418,103.643,"men"],[4,7,103.678,103.84,"det"],[8,14,103.84,104.323,"smaker"],[15,19,104.338,104.683,"godt"]],"speaker":"Torunn"},{"id":45,"start":105.798,"end":106.983,"text":"Jeg støtter Vestlandet!","zh":"我支持挪威西部！","words":[[0,3,105.798,106.003,"jeg"],[4,11,106.058,106.451,"støtter@pa-vei-extra-5"],[12,22,106.451,106.983,"vestlandet"]],"speaker":"Haifa"},{"id":46,"start":107.798,"end":111.383,"text":"Jeg spiser ikke svinekjøtt, men dette er veldig godt.","zh":"我不吃猪肉，不过这个非常好吃。","words":[[0,3,107.798,107.963,"jeg"],[4,10,107.978,108.38,"spiser"],[11,15,108.38,108.571,"ikke"],[16,26,108.571,109.263,"svinekjøtt"],[28,31,109.798,109.983,"men"],[32,37,110.058,110.463,"dette"],[38,40,110.478,110.643,"er"],[41,47,110.678,111.09,"veldig"],[48,52,111.09,111.383,"godt"]],"speaker":"Haifa"},{"id":47,"start":112.838,"end":113.643,"text":"Hyggelig å høre.","zh":"听你这么说真高兴。","words":[[0,8,112.838,113.24,"hyggelig"],[9,10,113.24,113.34,"å"],[11,15,113.34,113.643,"høre"]],"speaker":"Per"},{"id":48,"start":114.458,"end":114.963,"text":"Vær så god.","zh":"别客气。","words":[[0,3,114.458,114.62,"vær@pa-vei-vær-be"],[4,6,114.62,114.751,"så"],[7,10,114.751,114.963,"god"]],"speaker":"Per"},{"id":49,"start":115.578,"end":116.163,"text":"Ta litt til!","zh":"再来一点吧！","words":[[0,2,115.578,115.723,"ta"],[3,7,115.758,115.99,"litt"],[8,11,115.99,116.163,"til"]],"speaker":"Per"},{"id":50,"start":117.098,"end":117.603,"text":"Nei takk.","zh":"不用了，谢谢。","words":[[0,3,117.098,117.323,"nei"],[4,8,117.338,117.603,"takk"]],"speaker":"Haifa"},{"id":51,"start":118.058,"end":120.443,"text":"Det smakte deilig, men nå er jeg mett.","zh":"味道非常好，不过我已经吃饱了。","words":[[0,3,118.058,118.221,"det"],[4,10,118.221,118.603,"smakte"],[11,17,118.638,119.103,"deilig"],[19,22,119.458,119.683,"men"],[23,25,119.758,119.891,"nå"],[26,28,119.891,119.981,"er"],[29,32,119.981,120.12,"jeg"],[33,37,120.12,120.443,"mett"]],"speaker":"Haifa"},{"id":52,"start":121.858,"end":122.903,"text":"Er alle forsynt?","zh":"大家都吃好了吗？","words":[[0,2,121.858,122.063,"er"],[3,7,122.078,122.321,"alle"],[8,15,122.321,122.903,"forsynt"]],"speaker":"Torunn"},{"id":53,"start":124.198,"end":125.463,"text":"Da henter jeg desserten.","zh":"那我去拿甜点。","words":[[0,2,124.198,124.343,"da"],[3,9,124.438,124.761,"henter"],[10,13,124.761,124.891,"jeg"],[14,23,124.891,125.463,"desserten"]],"speaker":"Torunn"},{"id":54,"start":126.198,"end":127.323,"text":"Det er multekrem.","zh":"是云莓奶油甜点。","words":[[0,3,126.198,126.363,"det"],[4,6,126.398,126.543,"er"],[7,16,126.558,127.323,"multekrem"]],"speaker":"Torunn"},{"id":55,"start":128.258,"end":130.943,"text":"Og etterpå er det kaffe og julekaker!","zh":"之后还有咖啡和圣诞饼干！","words":[[0,2,128.258,128.383,"og"],[3,10,128.438,128.883,"etterpå"],[11,13,129.278,129.38,"er"],[14,17,129.38,129.523,"det"],[18,23,129.538,129.943,"kaffe"],[24,26,130.118,130.261,"og"],[27,36,130.261,130.943,"julekaker"]],"speaker":"Torunn"}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"blomster":{"lemma":"blomst","zh":"花（复数）","pos":"名词","ref":"basics:seasons:blomster","form":"复数不定","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"deilig":{"lemma":"deilig","zh":"美味的；好吃的；令人愉快的","pos":"形容词","ref":"8-137","clip":null},"der"