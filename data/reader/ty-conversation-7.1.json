{"id":"ty-conversation-7.1","bookId":"ty-conversation-guide","readingId":"7.1","title":"Lunch at a restaurant","audio":"audio/ty-conversation/7.1.mp3","duration":59.768163,"synthetic":false,"sentences":[{"id":0,"start":22.27,"end":24.235,"speaker":"Olav","text":"Vi vil gjerne se menyen.","zh":"我们想看一下菜单。","words":[[0,2,22.27,22.395,"vi"],[3,6,22.47,22.655,"vil"],[7,13,22.75,23.175,"gjerne"],[14,16,23.39,23.555,"se@ty-see-menu"],[17,23,23.75,24.235,"menyen"]]},{"id":1,"start":24.69,"end":25.975,"speaker":"Waiter","text":"Jeg skal komme tilbake.","zh":"我一会儿再过来。","words":[[0,3,24.69,24.875,"jeg"],[4,8,24.89,25.115,"skal"],[9,14,25.19,25.453,"komme@ty-come-back"],[15,22,25.453,25.975,"tilbake"]]},{"id":2,"start":26.95,"end":27.735,"speaker":"Olav","text":"Hva vil du ha?","zh":"你想吃什么？","words":[[0,3,26.95,27.115,"hva"],[4,7,27.15,27.335,"vil"],[8,10,27.39,27.515,"du"],[11,13,27.59,27.735,"ha@ty-want-food"]]},{"id":3,"start":29.15,"end":31.335,"speaker":"Kari","text":"Jeg vil gjerne ha fisk.","zh":"我想吃鱼。","words":[[0,3,29.15,29.435,"jeg"],[4,7,29.57,29.775,"vil"],[8,14,30.01,30.435,"gjerne"],[15,17,30.55,30.695,"ha@ty-want-food"],[18,22,30.85,31.335,"fisk"]]},{"id":4,"start":31.95,"end":33.335,"speaker":"Olav","text":"Vil du ha en forrett?","zh":"你要来份前菜吗？","words":[[0,3,31.95,32.135,"vil"],[4,6,32.15,32.295,"du"],[7,9,32.33,32.475,"ha@ty-want-food"],[10,12,32.55,32.695,"en"],[13,20,32.87,33.335,"forrett"]]},{"id":5,"start":34.27,"end":37.135,"speaker":"Kari","text":"Nei, jeg vil heller ha dessert.","zh":"不要，我更想吃甜点。","words":[[0,3,34.27,34.615,"nei"],[5,8,35.27,35.555,"jeg"],[9,12,35.67,35.855,"vil"],[13,19,35.95,36.295,"heller"],[20,22,36.31,36.455,"ha@ty-want-food"],[23,30,36.53,37.135,"dessert"]]},{"id":6,"start":37.79,"end":39.615,"speaker":"Olav","text":"Jeg vil gjerne ha bacalao.","zh":"我想吃咸鳕鱼炖菜。","words":[[0,3,37.79,37.995,"jeg"],[4,7,38.01,38.175,"vil"],[8,14,38.23,38.655,"gjerne"],[15,17,38.71,38.855,"ha@ty-want-food"],[18,25,38.97,39.615,"bacalao"]]},{"id":7,"start":40.37,"end":41.835,"speaker":"Olav","text":"God norsk mat!","zh":"这可是美味的挪威菜！","words":[[0,3,40.37,40.695,"god@ty-good-food"],[4,9,40.93,41.355,"norsk"],[10,13,41.43,41.835,"mat"]]},{"id":8,"start":42.45,"end":44.555,"speaker":"Kari","text":"Jeg liker ikke klippfisk.","zh":"我不喜欢咸鳕鱼干。","words":[[0,3,42.45,42.715,"jeg"],[4,9,42.91,43.435,"liker"],[10,14,43.53,43.835,"ikke"],[15,24,43.85,44.555,"klippfisk"]]},{"id":9,"start":45.05,"end":48.695,"speaker":"Kari","text":"Jeg vil heller ha stekt torsk og salat.","zh":"我更想吃煎鳕鱼和沙拉。","words":[[0,3,45.05,45.315,"jeg"],[4,7,45.67,45.875,"vil"],[8,14,45.99,46.395,"heller"],[15,17,46.45,46.595,"ha@ty-want-food"],[18,23,46.77,47.175,"stekt"],[24,29,47.23,47.655,"torsk"],[30,32,47.85,47.995,"og"],[33,38,48.09,48.695,"salat"]]},{"id":10,"start":49.67,"end":51.115,"speaker":"Olav","text":"Vil du ha et glass vin?","zh":"你要来杯葡萄酒吗？","words":[[0,3,49.67,49.835,"vil"],[4,6,49.85,49.995,"du"],[7,9,50.03,50.175,"ha@ty-want-drink"],[10,12,50.33,50.492,"et"],[13,18,50.492,50.795,"glass"],[19,22,50.81,51.115,"vin"]]},{"id":11,"start":52.01,"end":54.135,"speaker":"Kari","text":"Ja, takk. Hvitvin.","zh":"好的，谢谢。白葡萄酒。","words":[[0,2,52.01,52.175,"ja"],[4,8,52.29,52.615,"takk"],[10,17,53.57,54.135,"hvitvin"]]},{"id":12,"start":54.73,"end":55.975,"speaker":"Olav","text":"Jeg vil ha et glass øl.","zh":"我要一杯啤酒。","words":[[0,3,54.73,54.935,"jeg"],[4,7,54.95,55.115,"vil"],[8,10,55.15,55.275,"ha@ty-want-drink"],[11,13,55.31,55.472,"et"],[14,19,55.472,55.755,"glass"],[20,22,55.81,55.975,"øl"]]},{"id":13,"start":56.77,"end":57.795,"speaker":"Olav","text":"Nå kan vi bestille.","zh":"我们现在可以点餐了。","words":[[0,2,56.77,56.915,"nå"],[3,6,56.97,57.155,"kan"],[7,9,57.17,57.295,"vi"],[10,18,57.33,57.795,"bestille@ty-order-food"]]}],"lexicon":{"bacalao":{"lemma":"bacalao","zh":"咸鳕鱼炖菜","pos":"名词","ref":"ty-conversation-7-003","clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-order-