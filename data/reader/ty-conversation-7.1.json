{"id":"ty-conversation-7.1","bookId":"ty-conversation-guide","readingId":"7.1","title":"Lunch at a restaurant","audio":"audio/ty-conversation/7.1.mp3","duration":59.768163,"synthetic":false,"sentences":[{"id":0,"start":21.64,"end":24.18,"speaker":"Olav","text":"Vi vil gjerne se menyen.","zh":"我们想看一下菜单。","words":[[0,2,21.64,22.44,"vi"],[3,6,22.44,22.66,"vil"],[7,13,22.66,23.16,"gjerne"],[14,16,23.16,23.62,"se@ty-see-menu"],[17,23,23.62,24.18,"menyen"]]},{"id":1,"start":24.64,"end":25.84,"speaker":"Waiter","text":"Jeg skal komme tilbake.","zh":"我一会儿再过来。","words":[[0,3,24.64,24.86,"jeg"],[4,8,24.86,25.12,"skal"],[9,14,25.12,25.44,"komme@ty-come-back"],[15,22,25.44,25.84,"tilbake"]]},{"id":2,"start":26.84,"end":27.8,"speaker":"Olav","text":"Hva vil du ha?","zh":"你想吃什么？","words":[[0,3,26.84,27.14,"hva"],[4,7,27.14,27.36,"vil"],[8,10,27.36,27.56,"du"],[11,13,27.56,27.8,"ha@ty-want-food"]]},{"id":3,"start":28.76,"end":31.2,"speaker":"Kari","text":"Jeg vil gjerne ha fisk.","zh":"我想吃鱼。","words":[[0,3,28.76,29.48,"jeg"],[4,7,29.48,29.82,"vil"],[8,14,29.82,30.42,"gjerne"],[15,17,30.42,30.76,"ha@ty-want-food"],[18,22,30.76,31.2,"fisk"]]},{"id":4,"start":31.8,"end":33.3,"speaker":"Olav","text":"Vil du ha en forrett?","zh":"你要来份前菜吗？","words":[[0,3,31.8,32.16,"vil"],[4,6,32.16,32.3,"du"],[7,9,32.3,32.54,"ha@ty-want-food"],[10,12,32.54,32.76,"en"],[13,20,32.76,33.3,"forrett"]]},{"id":5,"start":33.92,"end":37.08,"speaker":"Kari","text":"Nei, jeg vil heller ha dessert.","zh":"不要，我更想吃甜点。","words":[[0,3,33.92,34.72,"nei"],[5,8,35.18,35.6,"jeg"],[9,12,35.6,35.88,"vil"],[13,19,35.88,36.24,"heller"],[20,22,36.24,36.52,"ha@ty-want-food"],[23,30,36.52,37.08,"dessert"]]},{"id":6,"start":37.44,"end":39.66,"speaker":"Olav","text":"Jeg vil gjerne ha bacalao.","zh":"我想吃咸鳕鱼炖菜。","words":[[0,3,37.44,38.0,"jeg"],[4,7,38.0,38.18,"vil"],[8,14,38.18,38.64,"gjerne"],[15,17,38.64,38.92,"ha@ty-want-food"],[18,25,38.92,39.66,"bacalao"]]},{"id":7,"start":40.3,"end":41.72,"speaker":"Olav","text":"God norsk mat!","zh":"这可是美味的挪威菜！","words":[[0,3,40.3,40.68,"god@ty-good-food"],[4,9,40.96,41.36,"norsk"],[10,13,41.36,41.72,"mat"]]},{"id":8,"start":42.12,"end":44.44,"speaker":"Kari","text":"Jeg liker ikke klippfisk.","zh":"我不喜欢咸鳕鱼干。","words":[[0,3,42.12,42.74,"jeg"],[4,9,42.74,43.44,"liker"],[10,14,43.44,43.78,"ikke"],[15,24,43.78,44.44,"klippfisk"]]},{"id":9,"start":44.88,"end":48.66,"speaker":"Kari","text":"Jeg vil heller ha stekt torsk og salat.","zh":"我更想吃煎鳕鱼和沙拉。","words":[[0,3,44.88,45.36,"jeg"],[4,7,45.36,45.9,"vil"],[8,14,45.9,46.32,"heller"],[15,17,46.32,46.68,"ha@ty-want-food"],[18,23,46.68,47.08,"stekt"],[24,29,47.08,47.68,"torsk"],[30,32,47.68,47.98,"og"],[33,38,47.98,48.66,"salat"]]},{"id":10,"start":49.8,"end":51.04,"speaker":"Olav","text":"Vil du ha et glass vin?","zh":"你要来杯葡萄酒吗？","words":[[0,3,49.8,49.88,"vil"],[4,6,49.88,50.0,"du"],[7,9,50.0,50.26,"ha@ty-want-drink"],[10,12,50.26,50.48,"et"],[13,18,50.48,50.68,"glass"],[19,22,50.68,51.04,"vin"]]},{"id":11,"start":51.78,"end":54.06,"speaker":"Kari","text":"Ja, takk. Hvitvin.","zh":"好的，谢谢。白葡萄酒。","words":[[0,2,51.78,52.22,"ja"],[4,8,52.22,52.66,"takk"],[10,17,53.48,54.06,"hvitvin"]]},{"id":12,"start":54.38,"end":56.1,"speaker":"Olav","text":"Jeg vil ha et glass øl.","zh":"我要一杯啤酒。","words":[[0,3,54.38,54.94,"jeg"],[4,7,54.94,55.1,"vil"],[8,10,55.1,55.32,"ha@ty-want-drink"],[11,13,55.32,55.46,"et"],[14,19,55.46,55.66,"glass"],[20,22,55.66,56.1,"øl"]]},{"id":13,"start":56.76,"end":57.76,"speaker":"Olav","text":"Nå kan vi bestille.","zh":"我们现在可以点餐了。","words":[[0,2,56.76,56.96,"nå"],[3,6,56.96,57.14,"kan"],[7,9,57.14,57.3,"vi"],[10,18,57.3,57.76,"bestille@ty-order-food"]]}],"lexicon":{"bacalao":{"lemma":"bacalao","zh":"咸鳕鱼炖菜","pos":"名词","ref":"ty-conversation-7-003","clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-order-food":{"lemma":"bestille","zh":"点餐","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式","contextual