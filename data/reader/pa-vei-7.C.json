{"id":"pa-vei-7.C","bookId":"pa-vei-textbook","readingId":"7.C","title":"Et godt tilbud?","audio":"audio/pa-vei/7.C.mp3","duration":184.968,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.86,"end":4.645,"text":"C. Et godt tilbud?","zh":"C. 很划算吗？","words":[[0,1,1.86,2.38,"c"],[3,5,3.62,3.825,"et"],[6,10,3.84,4.125,"godt"],[11,17,4.14,4.645,"tilbud"]]},{"id":1,"start":6.82,"end":11.565,"text":"Emma og Henrik går ut av butikken med røde sko i en bærepose.","zh":"埃玛和亨里克走出商店，购物袋里装着红鞋。","words":[[0,4,6.82,7.205,"emma"],[5,7,7.26,7.402,"og"],[8,14,7.402,7.925,"henrik"],[15,18,8.12,8.425,"går"],[19,21,8.44,8.633,"ut"],[22,24,8.633,8.785,"av"],[25,33,8.8,9.385,"butikken"],[34,37,9.48,9.645,"med"],[38,42,9.68,10.105,"røde"],[43,46,10.16,10.385,"sko"],[47,48,10.58,10.685,"i"],[49,51,10.7,10.845,"en"],[52,60,10.86,11.565,"bærepose"]]},{"id":2,"start":12.8,"end":14.625,"text":"Emma er glad og fornøyd.","zh":"埃玛开心又满意。","words":[[0,4,12.8,13.125,"emma"],[5,7,13.36,13.545,"er"],[8,12,13.64,14.005,"glad"],[13,15,14.04,14.162,"og"],[16,23,14.162,14.625,"fornøyd"]]},{"id":3,"start":16.3,"end":21.405,"text":"De går forbi en butikk med herreklær, og Emma ser på klærne i vinduet.","zh":"他们经过一家男装店，埃玛看着橱窗里的衣服。","words":[[0,2,16.3,16.445,"de"],[3,6,16.5,16.745,"går"],[7,12,16.78,17.105,"forbi"],[13,15,17.26,17.402,"en"],[16,22,17.402,17.793,"butikk"],[23,26,17.793,17.933,"med"],[27,36,17.933,18.585,"herreklær"],[38,40,19.2,19.345,"og"],[41,45,19.42,19.725,"emma"],[46,49,19.98,20.225,"ser"],[50,52,20.26,20.405,"på"],[53,59,20.44,20.865,"klærne"],[60,61,20.9,20.992,"i"],[62,69,20.992,21.405,"vinduet"]]},{"id":4,"start":23.19,"end":25.855,"text":"Pappa, en rød genser.","zh":"爸爸，有一件红毛衣。","words":[[0,5,23.19,23.635,"pappa"],[7,9,24.53,24.715,"en"],[10,13,24.81,25.155,"rød"],[14,20,25.25,25.855,"genser"]],"speaker":"Emma"},{"id":5,"start":26.55,"end":27.435,"text":"Den er fin!","zh":"真好看！","words":[[0,3,26.55,26.775,"den"],[4,6,26.83,27.015,"er"],[7,10,27.05,27.435,"fin"]],"speaker":"Emma"},{"id":6,"start":28.13,"end":29.195,"text":"Den bør du kjøpe.","zh":"你应该把它买下来。","words":[[0,3,28.13,28.355,"den"],[4,7,28.43,28.602,"bør"],[8,10,28.602,28.715,"du"],[11,16,28.77,29.195,"kjøpe"]],"speaker":"Emma"},{"id":7,"start":30.45,"end":31.855,"text":"En rød genser til meg?","zh":"我穿红毛衣？","words":[[0,2,30.45,30.595,"en"],[3,6,30.67,30.973,"rød"],[7,13,30.973,31.462,"genser"],[14,17,31.462,31.615,"til"],[18,21,31.65,31.855,"meg"]],"speaker":"Henrik"},{"id":8,"start":32.87,"end":33.115,"text":"Nei.","zh":"不。","words":[[0,3,32.87,33.115,"nei"]],"speaker":"Henrik"},{"id":9,"start":34.37,"end":35.995,"text":"Kan du ikke prøve den?","zh":"你不试一下吗？","words":[[0,3,34.37,34.635,"kan"],[4,6,34.71,34.832,"du"],[7,11,34.832,35.093,"ikke"],[12,17,35.093,35.572,"prøve"],[18,21,35.572,35.995,"den"]],"speaker":"Emma"},{"id":10,"start":37.55,"end":40.115,"text":"Nei, jeg har ikke lyst til å prøve klær.","zh":"不，我不想试衣服。","words":[[0,3,37.55,37.895,"nei"],[5,8,38.45,38.603,"jeg"],[9,12,38.603,38.763,"har"],[13,17,38.763,38.992,"ikke"],[18,22,38.992,39.243,"lyst@pa-vei-lyst-desire"],[23,26,39.243,39.373,"til"],[27,28,39.373,39.463,"å"],[29,34,39.463,39.793,"prøve"],[35,39,39.793,40.115,"klær"]],"speaker":"Henrik"},{"id":11,"start":41.25,"end":42.255,"text":"Hvorfor ikke?","zh":"为什么不呢？","words":[[0,7,41.25,41.755,"hvorfor"],[8,12,41.85,42.255,"ikke"]],"speaker":"Emma"},{"id":12,"start":43.03,"end":45.055,"text":"Du må også kjøpe klær noen ganger.","zh":"你有时候也得买衣服呀。","words":[[0,2,43.03,43.172,"du"],[3,5,43.172,43.315,"må"],[6,10,43.49,43.835,"også"],[11,16,43.85,44.162,"kjøpe"],[17,21,44.162,44.403,"klær"],[22,26,44.403,44.623,"noen"],[27,33,44.623,45.055,"ganger"]],"speaker":"Emma"},{"id":13,"start":46.27,"end":46.615,"text":"Ok.","zh":"好吧。","words":[[0,2,46.27,46.615,"ok"]],"speaker":"Henrik"},{"id":14,"start":47.35,"end":47.955,"text":"Vi går inn.","zh":"我们进去。","words":[[0,2,47.35,47.495,"vi"],[3,6,47.53,47.773,"går"],[7,10,47.773,47.955,"inn"]],"speaker":"Henrik"},{"id":15,"start":50.31,"end":50.715,"text":"Hei, hei.","zh":"你们好。","words":[[0,3,50.31,50.513,"hei"],[5,8,50.513,50.715,"hei"]],"speaker":"Selger"},{"id":16,"start":51.87,"end":54.435,"text":"Trenger dere hjelp, eller vil dere kikke litt?","zh":"需要帮忙，还是想先看看？","words":[[0,7,51.87,52.153,"trenger"],[8,12,52.153,52.373,"dere"],[13,18,52.373,52.775,"hjelp"],[20,25,53.29,53.502,"eller"],[26,29,53.502,53.612,"vil"],[30,34,53.612,53.852,"dere"],[35,40,53.852,54.142,"kikke"],[41,45,54.142,54.435,"litt"]],"speaker":"Selger"},{"id":17,"start":55.63,"end":57.435,"text":"Jeg så en rød genser i vinduet.","zh":"我在橱窗里看到一件红毛衣。","words":[[0,3,55.63,55.855,"jeg"],[4,6,55.99,56.135,"så@pa-vei-så-saw"],[7,9,56.17,56.312,"en"],[10,13,56.312,56.553,"rød"],[14,20,56.553,56.933,"genser"],[21,22,56.933,57.013,"i"],[23,30,57.013,57.435,"vinduet"]],"speaker":"Henrik"},{"id":18,"start":58.47,"end":59.155,"text":"Hva koster den?","zh":"多少钱？","words":[[0,3,58.47,58.633,"hva"],[4,10,58.633,59.002,"koster"],[11,14,59.002,59.155,"den"]],"speaker":"Henrik"},{"id":19,"start":60.33,"end":61.715,"text":"270 kroner.","zh":"二百七十克朗。","words":[[0,3,60.33,61.332,"270"],[4,10,61.332,61.715,"kroner"]],"speaker":"Selger"},{"id":20,"start":62.65,"end":63.635,"text":"Den er på salg.","zh":"正在打折。","words":[[0,3,62.65,62.835,"den"],[4,6,62.85,62.983,"er"],[7,9,62.983,63.095,"på"],[10,14,63.17,63.635,"salg"]],"speaker":"Selger"},{"id":21,"start":64.71,"end":65.555,"text":"Kan jeg prøve den?","zh":"我能试一下吗？","words":[[0,3,64.71,64.875,"kan"],[4,7,64.89,65.042,"jeg"],[8,13,65.042,65.382,"prøve"],[14,17,65.382,65.555,"den"]],"speaker":"Henrik"},{"id":22,"start":66.51,"end":67.275,"text":"Selvfølgelig.","zh":"当然。","words":[[0,12,66.51,67.275,"selvfølgelig"]],"speaker":"Selger"},{"id":23,"start":67.91,"end":69.275,"text":"Hvilken størrelse bruker du?","zh":"您穿多大码的？","words":[[0,7,67.91,68.295,"hvilken"],[8,17,68.31,68.833,"størrelse"],[18,24,68.833,69.153,"bruker"],[25,27,69.153,69.275,"du"]],"speaker":"Selger"},{"id":24,"start":70.61,"end":73.615,"text":"Størrelse 52 eller 54.","zh":"五十二或五十四码。","words":[[0,9,70.61,71.155,"størrelse"],[10,12,71.25,71.835,"52"],[13,18,72.53,72.895,"eller"],[19,21,73.05,73.615,"54"]],"speaker":"Henrik"},{"id":25,"start":74.73,"end":76.455,"text":"Her er en genser i large.","zh":"这里有一件大码毛衣。","words":[[0,3,74.73,74.942,"her"],[4,6,74.942,75.062,"er"],[7,9,75.062,75.183,"en"],[10,16,75.183,75.635,"genser"],[17,18,75.67,75.775,"i"],[19,24,75.87,76.455,"large"]],"speaker":"Selger"},{"id":26,"start":77.57,"end":78.515,"text":"Den passer, tror jeg.","zh":"我想应该合适。","words":[[0,3,77.57,77.775,"den"],[4,10,77.81,78.192,"passer"],[12,16,78.192,78.373,"tror"],[17,20,78.373,78.515,"jeg"]],"speaker":"Selger"},{"id":27,"start":79.57,"end":80.755,"text":"Prøverommet er der borte.","zh":"试衣间在那边。","words":[[0,11,79.57,80.192,"prøverommet"],[12,14,80.192,80.282,"er"],[15,18,80.282,80.463,"der"],[19,24,80.463,80.755,"borte"]],"speaker":"Selger"},{"id":28,"start":83.11,"end":84.715,"text":"Henrik prøver genseren.","zh":"亨里克试穿毛衣。","words":[[0,6,83.11,83.635,"henrik"],[7,13,83.69,84.175,"prøver"],[14,22,84.19,84.715,"genseren"]]},{"id":29,"start":85.92,"end":88.565,"text":"Han kommer ut fra prøverommet og smiler.","zh":"他从试衣间里走出来，面带笑容。","words":[[0,3,85.92,86.105,"han"],[4,10,86.18,86.482,"kommer"],[11,13,86.482,86.692,"ut"],[14,17,86.692,86.865,"fra"],[18,29,86.88,87.585,"prøverommet"],[30,32,87.82,87.965,"og"],[33,39,88.0,88.565,"smiler"]]},{"id":30,"start":90.22,"end":91.785,"text":"Du er kjempefin, pappa.","zh":"爸爸，你穿着特别好看。","words":[[0,2,90.22,90.312,"du"],[3,5,90.312,90.445,"er"],[6,15,90.64,91.425,"kjempefin"],[17,22,91.46,91.785,"pappa"]],"speaker":"Emma"},{"id":31,"start":93.3,"end":94.005,"text":"Synes du det?","zh":"你这么觉得吗？","words":[[0,5,93.3,93.692,"synes"],[6,8,93.692,93.805,"du"],[9,12,93.82,94.005,"det"]],"speaker":"Henrik"},{"id":32,"start":94.8,"end":95.765,"text":"Er den ikke for liten?","zh":"不会太小吗？","words":[[0,2,94.8,94.912,"er"],[3,6,94.912,95.072,"den"],[7,11,95.072,95.263,"ikke"],[12,15,95.263,95.382,"for@pa-vei-for-excess"],[16,21,95.382,95.765,"liten"]],"speaker":"Henrik"},{"id":33,"start":97.06,"end":99.545,"text":"Nei, den er akkurat passe.","zh":"不会，正合适。","words":[[0,3,97.06,97.405,"nei"],[5,8,97.8,97.982,"den"],[9,11,97.982,98.105,"er"],[12,19,98.28,99.112,"akkurat"],[20,25,99.112,99.545,"passe"]],"speaker":"Emma"},{"id":34,"start":100.84,"end":101.345,"text":"Jeg tar den.","zh":"我买这件。","words":[[0,3,100.84,101.002,"jeg"],[4,7,101.002,101.183,"tar"],[8,11,101.183,101.345,"den"]],"speaker":"Henrik"},{"id":35,"start":102.22,"end":102.825,"text":"Den er billig.","zh":"很便宜。","words":[[0,3,102.22,102.382,"den"],[4,6,102.382,102.502,"er"],[7,13,102.502,102.825,"billig"]],"speaker":"Henrik"},{"id":36,"start":103.98,"end":105.045,"text":"Skal det være noe mer?","zh":"还需要别的吗？","words":[[0,4,103.98,104.172,"skal"],[5,8,104.172,104.312,"det"],[9,13,104.312,104.583,"være"],[14,17,104.583,104.782,"noe"],[18,21,104.782,105.045,"mer"]],"speaker":"Selger"},{"id":37,"start":106.5,"end":107.745,"text":"Skal jeg ha noe mer, Emma?","zh":"埃玛，我还需要买什么吗？","words":[[0,4,106.5,106.692,"skal"],[5,8,106.692,106.863,"jeg"],[9,11,106.863,107.002,"ha"],[12,15,107.002,107.222,"noe"],[16,19,107.222,107.465,"mer"],[21,25,107.5,107.745,"emma"]],"speaker":"Henrik"},{"id":38,"start":109.1,"end":111.285,"text":"Ja, du trenger et skjerf.","zh":"需要，你还缺一条围巾。","words":[[0,2,109.1,109.265,"ja"],[4,6,109.94,110.085,"du"],[7,14,110.16,110.562,"trenger"],[15,17,110.562,110.745,"et"],[18,24,110.76,111.285,"skjerf"]],"speaker":"Emma"},{"id":39,"start":111.78,"end":114.345,"text":"Et blått, nei, et grått skjerf.","zh":"蓝色的，不，灰色的围巾。","words":[[0,2,111.78,111.942,"et"],[3,8,111.942,112.325,"blått"],[10,13,112.6,112.865,"nei"],[15,17,113.2,113.385,"et"],[18,23,113.44,113.825,"grått"],[24,30,113.84,114.345,"skjerf"]],"speaker":"Emma"},{"id":40,"start":115.32,"end":117.125,"text":"Her er et grått ullskjerf.","zh":"这里有一条灰色羊毛围巾。","words":[[0,3,115.32,115.623,"her"],[4,6,115.623,115.765,"er"],[7,9,115.78,115.945,"et"],[10,15,115.96,116.345,"grått"],[16,25,116.44,117.125,"ullskjerf"]],"speaker":"Selger"},{"id":41,"start":117.92,"end":118.705,"text":"Det er lekkert.","zh":"很漂亮。","words":[[0,3,117.92,118.083,"det"],[4,6,118.083,118.213,"er"],[7,14,118.213,118.705,"lekkert"]],"speaker":"Selger"},{"id":42,"start":120.0,"end":120.185,"text":"Bra.","zh":"好。","words":[[0,3,120.0,120.185,"bra"]],"speaker":"Henrik"},{"id":43,"start":120.92,"end":121.405,"text":"Jeg tar det.","zh":"我买这条。","words":[[0,3,120.92,121.072,"jeg"],[4,7,121.072,121.263,"tar"],[8,11,121.263,121.405,"det"]],"speaker":"Henrik"},{"id":44,"start":122.5,"end":123.245,"text":"Hvor mye blir det?","zh":"一共多少钱？","words":[[0,4,122.5,122.692,"hvor"],[5,8,122.692,122.912,"mye"],[9,13,122.912,123.102,"blir"],[14,17,123.102,123.245,"det"]],"speaker":"Henrik"},{"id":45,"start":124.46,"end":127.645,"text":"Det blir 770 kroner til sammen.","zh":"一共七百七十克朗。","words":[[0,3,124.46,124.665,"det"],[4,8,124.82,125.385,"blir"],[9,12,125.78,126.843,"770"],[13,19,126.843,127.153,"kroner"],[20,23,127.153,127.292,"til"],[24,30,127.292,127.645,"sammen"]],"speaker":"Selger"},{"id":46,"start":129.0,"end":129.285,"text":"Hva?","zh":"什么？","words":[[0,3,129.0,129.285,"hva"]],"speaker":"Henrik"},{"id":47,"start":130.24,"end":132.085,"text":"Koster skjerfet 500 kroner?","zh":"围巾要五百克朗？","words":[[0,6,130.24,130.585,"koster"],[7,15,130.6,131.025,"skjerfet"],[16,19,131.08,131.683,"500"],[20,26,131.683,132.085,"kroner"]],"speaker":"Henrik"},{"id":48,"start":132.86,"end":136.225,"text":"Ja, men vanlig pris er 800 kroner.","zh":"是的，不过原价是八百克朗。","words":[[0,2,132.86,133.025,"ja"],[4,7,133.8,133.985,"men"],[8,14,134.04,134.502,"vanlig"],[15,19,134.502,134.865,"pris"],[20,22,134.98,135.145,"er"],[23,26,135.26,135.882,"800"],[27,33,135.882,136.225,"kroner"]],"speaker":"Selger"},{"id":49,"start":136.94,"end":138.685,"text":"Det er et veldig godt tilbud.","zh":"这个优惠很好。","words":[[0,3,136.94,137.093,"det"],[4,6,137.093,137.222,"er"],[7,9,137.222,137.385,"et"],[10,16,137.44,137.923,"veldig"],[17,21,137.923,138.202,"godt"],[22,28,138.202,138.685,"tilbud"]],"speaker":"Selger"},{"id":50,"start":139.46,"end":141.385,"text":"Og fargen er veldig fin til deg.","zh":"而且这个颜色非常适合您。","words":[[0,2,139.46,139.605,"og"],[3,9,139.66,140.085,"fargen"],[10,12,140.1,140.225,"er"],[13,19,140.28,140.745,"veldig"],[20,23,140.78,141.065,"fin"],[24,27,141.08,141.213,"til"],[28,31,141.213,141.385,"deg"]],"speaker":"Selger"},{"id":51,"start":145.22,"end":145.945,"text":"Sammendrag.","zh":"摘要","words":[[0,10,145.22,145.945,"sammendrag"]]},{"id":52,"start":148.0,"end":151.425,"text":"Emma og Henrik går forbi en butikk med herreklær.","zh":"埃玛和亨里克经过一家男装店。","words":[[0,4,148.0,148.365,"emma"],[5,7,148.42,148.545,"og"],[8,14,148.6,149.205,"henrik"],[15,18,149.34,149.565,"går"],[19,24,149.6,149.925,"forbi"],[25,27,150.04,150.183,"en"],[28,34,150.183,150.665,"butikk"],[35,38,150.68,150.833,"med"],[39,48,150.833,151.425,"herreklær"]]},{"id":53,"start":153.08,"end":155.245,"text":"Emma ser en rød genser i vinduet.","zh":"埃玛在橱窗里看到一件红毛衣。","words":[[0,4,153.08,153.385,"emma"],[5,8,153.44,153.662,"ser"],[9,11,153.662,153.805,"en"],[12,15,153.88,154.225,"rød"],[16,22,154.24,154.725,"genser"],[23,24,154.74,154.833,"i"],[25,32,154.833,155.245,"vinduet"]]},{"id":54,"start":156.71,"end":159.555,"text":"De går inn, og Henrik prøver genseren.","zh":"他们走进去，亨里克试穿了毛衣。","words":[[0,2,156.71,156.835,"de"],[3,6,156.85,157.035,"går"],[7,10,157.05,157.275,"inn"],[12,14,157.95,158.075,"og"],[15,21,158.13,158.575,"henrik"],[22,28,158.61,159.093,"prøver"],[29,37,159.093,159.555,"genseren"]]},{"id":55,"start":160.81,"end":164.875,"text":"Den er fin, og den koster bare 270 kroner.","zh":"毛衣很好看，而且只要二百七十克朗。","words":[[0,3,160.81,160.975,"den"],[4,6,160.99,161.115,"er"],[7,10,161.15,161.455,"fin"],[12,14,162.41,162.542,"og"],[15,18,162.542,162.692,"den"],[19,25,162.692,163.075,"koster"],[26,30,163.09,163.335,"bare"],[31,34,1