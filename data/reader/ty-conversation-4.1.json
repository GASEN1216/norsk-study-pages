{"id":"ty-conversation-4.1","bookId":"ty-conversation-guide","readingId":"4.1","title":"Talking about what you do","audio":"audio/ty-conversation/4.1.mp3","duration":50.390208,"synthetic":false,"sentences":[{"id":0,"start":0.78,"end":2.445,"speaker":"Olav","text":"Hva studerer du?","zh":"你学什么专业？","words":[[0,3,0.78,0.965,"hva"],[4,12,1.44,2.165,"studerer"],[13,15,2.3,2.445,"du"]]},{"id":1,"start":3.9,"end":5.985,"speaker":"Eva","text":"Jeg studerer farmasi.","zh":"我学药学。","words":[[0,3,3.9,4.145,"jeg"],[4,12,4.38,5.025,"studerer"],[13,20,5.38,5.985,"farmasi"]]},{"id":2,"start":8.08,"end":11.065,"speaker":"Eva","text":"Jeg vil gjerne bli farmasøyt.","zh":"我想成为药剂师。","words":[[0,3,8.08,8.325,"jeg"],[4,7,8.58,8.765,"vil"],[8,14,8.96,9.365,"gjerne"],[15,18,9.58,9.785,"bli"],[19,28,10.14,11.065,"farmasøyt"]]},{"id":3,"start":13.11,"end":15.115,"speaker":"Olav","text":"Hvor studerer du?","zh":"你在哪里读书？","words":[[0,4,13.11,13.415,"hvor"],[5,13,14.21,14.895,"studerer"],[14,16,14.97,15.115,"du"]]},{"id":4,"start":16.61,"end":18.775,"speaker":"Eva","text":"Jeg studerer i Tromsø.","zh":"我在特罗姆瑟读书。","words":[[0,3,16.61,16.835,"jeg"],[4,12,17.09,17.735,"studerer"],[13,14,17.97,18.075,"i@ty-place"],[15,21,18.19,18.775,"tromsø"]]},{"id":5,"start":20.11,"end":20.915,"speaker":"Eva","text":"Hva gjør du?","zh":"你做什么工作？","words":[[0,3,20.11,20.315,"hva"],[4,8,20.55,20.755,"gjør"],[9,11,20.77,20.915,"du"]]},{"id":6,"start":22.51,"end":23.935,"speaker":"Olav","text":"Jeg er journalist.","zh":"我是记者。","words":[[0,3,22.51,22.735,"jeg"],[4,6,22.81,23.055,"er@ty-be-identity"],[7,17,23.27,23.935,"journalist"]]},{"id":7,"start":25.39,"end":27.875,"speaker":"Olav","text":"Jeg jobber i en stor avis.","zh":"我在一家大报社工作。","words":[[0,3,25.39,25.635,"jeg"],[4,10,25.87,26.335,"jobber@ty-work"],[11,12,26.47,26.575,"i@ty-place"],[13,15,26.59,26.715,"en"],[16,20,26.83,27.235,"stor"],[21,25,27.39,27.875,"avis@ty-newsroom"]]},{"id":8,"start":29.19,"end":30.015,"speaker":"Eva","text":"Hvor bor du?","zh":"你住在哪里？","words":[[0,4,29.19,29.455,"hvor"],[5,8,29.63,29.873,"bor"],[9,11,29.873,30.015,"du"]]},{"id":9,"start":31.63,"end":33.155,"speaker":"Olav","text":"Jeg bor i Bergen.","zh":"我住在卑尔根。","words":[[0,3,31.63,31.895,"jeg"],[4,7,31.97,32.295,"bor"],[8,9,32.61,32.712,"i@ty-place"],[10,16,32.712,33.155,"bergen"]]},{"id":10,"start":34.55,"end":36.515,"speaker":"Olav","text":"Jeg er på ferie i Oslo.","zh":"我在奥斯陆度假。","words":[[0,3,34.55,34.735,"jeg"],[4,6,34.81,35.035,"er@ty-be-state"],[7,9,35.07,35.215,"på@ty-holiday"],[10,15,35.31,35.775,"ferie"],[16,17,36.09,36.192,"i@ty-place"],[18,22,36.192,36.515,"oslo"]]},{"id":11,"start":37.89,"end":39.775,"speaker":"Eva","text":"Jeg er også på ferie.","zh":"我也在度假。","words":[[0,3,37.89,38.095,"jeg"],[4,6,38.27,38.435,"er@ty-be-state"],[7,11,38.51,38.855,"også"],[12,14,39.15,39.295,"på@ty-holiday"],[15,20,39.35,39.775,"ferie"]]},{"id":12,"start":40.83,"end":43.895,"speaker":"Eva","text":"Jeg reiser til Tromsø på tirsdag.","zh":"我星期二去特罗姆瑟。","words":[[0,3,40.83,41.055,"jeg"],[4,10,41.29,41.795,"reiser"],[11,14,41.93,42.115,"til"],[15,21,42.19,42.695,"tromsø"],[22,24,43.07,43.215,"på@ty-weekday"],[25,32,43.31,43.895,"tirsdag"]]},{"id":13,"start":45.57,"end":48.215,"speaker":"Olav","text":"Jeg reiser til Bergen på onsdag.","zh":"我星期三去卑尔根。","words":[[0,3,45.57,45.835,"jeg"],[4,10,46.03,46.492,"reiser"],[11,14,46.492,46.655,"til"],[15,21,46.69,47.155,"bergen"],[22,24,47.45,47.595,"på@ty-weekday"],[25,31,47.65,48.215,"onsdag"]]}],"lexicon":{"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"avis@ty-newsroom":{"lemma":"avis","zh":"报社","pos":"名词","ref":"ty-conversation-4-001","clip":null,"contextual":true,"baseKey":"avis","surface":"avis"},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bli":{"lemma":"bli","zh":"成为","pos":"动词","ref":"ty-conversation-4-002","clip":null,"form":"不定式"},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form