{"id":"ty-conversation-4.1","bookId":"ty-conversation-guide","readingId":"4.1","title":"Talking about what you do","audio":"audio/ty-conversation/4.1.mp3","duration":50.390208,"synthetic":false,"sentences":[{"id":0,"start":0.0,"end":2.98,"speaker":"Olav","text":"Hva studerer du?","zh":"你学什么专业？","words":[[0,3,0.0,1.24,"hva"],[4,12,1.24,2.28,"studerer"],[13,15,2.28,2.98,"du"]]},{"id":1,"start":3.7,"end":6.4,"speaker":"Eva","text":"Jeg studerer farmasi.","zh":"我学药学。","words":[[0,3,3.7,4.26,"jeg"],[4,12,4.26,5.34,"studerer"],[13,20,5.34,6.4,"farmasi"]]},{"id":2,"start":8.22,"end":11.42,"speaker":"Eva","text":"Jeg vil gjerne bli farmasøyt.","zh":"我想成为药剂师。","words":[[0,3,8.22,8.5,"jeg"],[4,7,8.5,8.98,"vil"],[8,14,8.98,9.62,"gjerne"],[15,18,9.62,10.14,"bli"],[19,28,10.14,11.42,"farmasøyt"]]},{"id":3,"start":13.12,"end":15.3,"speaker":"Olav","text":"Hvor studerer du?","zh":"你在哪里读书？","words":[[0,4,13.12,13.96,"hvor"],[5,13,13.96,14.98,"studerer"],[14,16,14.98,15.3,"du"]]},{"id":4,"start":16.4,"end":19.2,"speaker":"Eva","text":"Jeg studerer i Tromsø.","zh":"我在特罗姆瑟读书。","words":[[0,3,16.4,17.16,"jeg"],[4,12,17.16,17.86,"studerer"],[13,14,17.86,18.34,"i@ty-place"],[15,21,18.34,19.2,"tromsø"]]},{"id":5,"start":20.02,"end":21.18,"speaker":"Eva","text":"Hva gjør du?","zh":"你做什么工作？","words":[[0,3,20.02,20.58,"hva"],[4,8,20.58,20.82,"gjør"],[9,11,20.82,21.18,"du"]]},{"id":6,"start":22.38,"end":23.98,"speaker":"Olav","text":"Jeg er journalist.","zh":"我是记者。","words":[[0,3,22.38,22.8,"jeg"],[4,6,22.8,23.26,"er@ty-be-identity"],[7,17,23.26,23.98,"journalist"]]},{"id":7,"start":25.38,"end":28.06,"speaker":"Olav","text":"Jeg jobber i en stor avis.","zh":"我在一家大报社工作。","words":[[0,3,25.38,25.86,"jeg"],[4,10,25.86,26.42,"jobber@ty-work"],[11,12,26.42,26.68,"i@ty-place"],[13,15,26.68,27.02,"en"],[16,20,27.02,27.44,"stor"],[21,25,27.44,28.06,"avis@ty-newsroom"]]},{"id":8,"start":28.06,"end":30.18,"speaker":"Eva","text":"Hvor bor du?","zh":"你住在哪里？","words":[[0,4,28.06,29.58,"hvor"],[5,8,29.58,29.88,"bor"],[9,11,29.88,30.18,"du"]]},{"id":9,"start":31.56,"end":33.37,"speaker":"Olav","text":"Jeg bor i Bergen.","zh":"我住在卑尔根。","words":[[0,3,31.56,31.96,"jeg"],[4,7,31.96,32.36,"bor"],[8,9,32.36,32.86,"i@ty-place"],[10,16,32.86,33.37,"bergen"]]},{"id":10,"start":34.44,"end":36.94,"speaker":"Olav","text":"Jeg er på ferie i Oslo.","zh":"我在奥斯陆度假。","words":[[0,3,34.44,34.8,"jeg"],[4,6,34.8,35.14,"er@ty-be-state"],[7,9,35.14,35.42,"på@ty-holiday"],[10,15,35.42,36.04,"ferie"],[16,17,36.04,36.28,"i@ty-place"],[18,22,36.28,36.94,"oslo"]]},{"id":11,"start":37.98,"end":40.04,"speaker":"Eva","text":"Jeg er også på ferie.","zh":"我也在度假。","words":[[0,3,37.98,38.24,"jeg"],[4,6,38.24,38.56,"er@ty-be-state"],[7,11,38.56,39.02,"også"],[12,14,39.02,39.48,"på@ty-holiday"],[15,20,39.48,40.04,"ferie"]]},{"id":12,"start":40.74,"end":44.06,"speaker":"Eva","text":"Jeg reiser til Tromsø på tirsdag.","zh":"我星期二去特罗姆瑟。","words":[[0,3,40.74,41.32,"jeg"],[4,10,41.32,41.88,"reiser"],[11,14,41.88,42.26,"til"],[15,21,42.26,42.96,"tromsø"],[22,24,42.96,43.38,"på@ty-weekday"],[25,32,43.38,44.06,"tirsdag"]]},{"id":13,"start":45.6,"end":48.32,"speaker":"Olav","text":"Jeg reiser til Bergen på onsdag.","zh":"我星期三去卑尔根。","words":[[0,3,45.6,46.0,"jeg"],[4,10,46.0,46.52,"reiser"],[11,14,46.52,46.76,"til"],[15,21,46.76,47.44,"bergen"],[22,24,47.44,47.7,"på@ty-weekday"],[25,31,47.7,48.32,"onsdag"]]}],"lexicon":{"avis":{"lemma":"avis","zh":"报纸；报社","pos":"名词","ref":"ty-conversation-4-001","clip":null},"avis@ty-newsroom":{"lemma":"avis","zh":"报社","pos":"名词","ref":"ty-conversation-4-001","clip":null,"contextual":true,"baseKey":"avis","surface":"avis"},"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bli":{"lemma":"bli","zh":"成为","pos":"动词","ref":"ty-conversation-4-002","clip":null,"form":"不定式"},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"