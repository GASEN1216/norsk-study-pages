{"id":"pa-vei-9.A","bookId":"pa-vei-textbook","readingId":"9.A","title":"Hva betyr jula for dere?","audio":"audio/pa-vei/9.A.mp3","duration":108.0,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.8,"end":5.125,"text":"Jeg og familien reiser alltid til foreldrene mine på Sørlandet i jula.","zh":"圣诞节时，我和家人总去南部地区看我的父母。","words":[[0,3,0.8,1.025,"jeg"],[4,6,1.1,1.225,"og"],[7,15,1.24,1.785,"familien"],[16,22,2.18,2.585,"reiser"],[23,29,2.64,3.062,"alltid"],[30,33,3.062,3.205,"til"],[34,44,3.24,3.803,"foreldrene"],[45,49,3.803,4.062,"mine"],[50,52,4.062,4.185,"på"],[53,62,4.22,4.772,"sørlandet"],[63,64,4.772,4.853,"i"],[65,69,4.853,5.125,"jula"]],"speaker":"Henrik"},{"id":1,"start":6.6,"end":9.365,"text":"Der har de stort juletre med masse pakker under.","zh":"他们那里有一棵大圣诞树，树下放着很多礼物包。","words":[[0,3,6.6,6.865,"der"],[4,7,6.88,7.022,"har"],[8,10,7.022,7.145,"de"],[11,16,7.22,7.625,"stort"],[17,24,7.64,8.105,"juletre"],[25,28,8.22,8.383,"med"],[29,34,8.383,8.705,"masse"],[35,41,8.72,9.102,"pakker@pa-vei-pakker-packages"],[42,47,9.102,9.365,"under"]],"speaker":"Henrik"},{"id":2,"start":10.602,"end":14.687,"text":"Om kvelden går alle sammen rundt juletreet og synger julesanger.","zh":"晚上，大家一起围着圣诞树走，唱圣诞歌曲。","words":[[0,2,10.602,10.727,"om"],[3,10,10.742,11.187,"kvelden"],[11,14,11.742,11.947,"går"],[15,19,11.982,12.247,"alle"],[20,26,12.262,12.607,"sammen"],[27,32,12.622,12.884,"rundt"],[33,42,12.884,13.514,"juletreet"],[43,45,13.514,13.627,"og"],[46,52,13.642,13.967,"synger"],[53,63,14.002,14.687,"julesanger"]],"speaker":"Henrik"},{"id":3,"start":16.262,"end":18.227,"text":"Etterpå kommer nissen med flere gaver.","zh":"之后圣诞老人还会带来更多礼物。","words":[[0,7,16.262,16.687,"etterpå"],[8,14,16.742,17.014,"kommer"],[15,21,17.014,17.425,"nissen"],[22,25,17.425,17.584,"med"],[26,31,17.584,17.867,"flere"],[32,37,17.882,18.227,"gaver"]],"speaker":"Henrik"},{"id":4,"start":19.862,"end":25.767,"text":"Barna i familien gleder seg alltid til jul, og de synes det er fint å være sammen med besteforeldrene sine.","zh":"家里的孩子们总是盼着过圣诞节，他们觉得能和祖父母在一起很开心。","words":[[0,5,19.862,20.187,"barna"],[6,7,20.202,20.294,"i"],[8,16,20.294,20.847,"familien"],[17,23,20.902,21.274,"gleder"],[24,27,21.274,21.447,"seg"],[28,34,21.482,21.864,"alltid"],[35,38,21.864,22.007,"til"],[39,42,22.042,22.287,"jul"],[44,46,22.802,22.904,"og"],[47,49,22.904,23.027,"de"],[50,55,23.042,23.345,"synes"],[56,59,23.345,23.444,"det"],[60,62,23.444,23.565,"er"],[63,67,23.565,23.934,"fint"],[68,69,23.934,24.014,"å"],[70,74,24.014,24.247,"være"],[75,81,24.262,24.544,"sammen"],[82,85,24.544,24.675,"med"],[86,101,24.675,25.484,"besteforeldrene"],[102,106,25.484,25.767,"sine"]],"speaker":"Henrik"},{"id":5,"start":30.582,"end":31.847,"text":"Jula er koselig.","zh":"圣诞节很温馨。","words":[[0,4,30.582,30.987,"jula"],[5,7,31.142,31.287,"er"],[8,15,31.322,31.847,"koselig"]],"speaker":"Monica"},{"id":6,"start":32.822,"end":36.087,"text":"Det er bra med mye lys og god mat midt på vinteren.","zh":"寒冬时节有这么多灯光和美食，真好。","words":[[0,3,32.822,32.954,"det"],[4,6,32.954,33.064,"er"],[7,10,33.064,33.267,"bra"],[11,14,33.362,33.527,"med"],[15,18,33.542,33.825,"mye"],[19,22,33.825,34.227,"lys"],[23,25,34.462,34.587,"og"],[26,29,34.602,34.847,"god"],[30,33,34.862,35.247,"mat"],[34,38,35.282,35.527,"midt"],[39,41,35.542,35.654,"på"],[42,50,35.654,36.087,"vinteren"]],"speaker":"Monica"},{"id":7,"start":37.34,"end":40.025,"text":"I jula har familien tid til å være sammen.","zh":"圣诞节时，家人有时间相聚。","words":[[0,1,37.34,37.445,"i"],[2,6,37.48,37.845,"jula"],[7,10,37.9,38.085,"har"],[11,19,38.12,38.585,"familien"],[20,23,38.62,39.005,"tid"],[24,27,39.18,39.332,"til"],[28,29,39.332,39.412,"å"],[30,34,39.412,39.645,"være"],[35,41,39.66,40.025,"sammen"]],"speaker":"Monica"},{"id":8,"start":41.2,"end":44.245,"text":"Vi går i kirken og gjør mange hyggelige ting.","zh":"我们去教堂，也做很多愉快的事。","words":[[0,2,41.2,41.343,"vi"],[3,6,41.343,41.552,"går"],[7,8,41.552,41.645,"i"],[9,15,41.68,42.205,"kirken"],[16,18,42.84,42.962,"og"],[19,23,42.962,43.145,"gjør"],[24,29,43.16,43.485,"mange"],[30,39,43.52,44.002,"hyggelige"],[40,44,44.002,44.245,"ting"]],"speaker":"Monica"},{"id":9,"start":45.4,"end":49.405,"text":"Jeg liker godt å bake og pynte huset med julepynt.","zh":"我很喜欢烘焙，喜欢用圣诞装饰品布置家里。","words":[[0,3,45.4,45.585,"jeg"],[4,9,45.6,46.025,"liker"],[10,14,46.06,46.312,"godt"],[15,16,46.312,46.412,"å"],[17,21,46.412,46.825,"bake"],[22,24,47.6,47.722,"og"],[25,30,47.722,48.105,"pynte"],[31,36,48.14,48.573,"huset"],[37,40,48.573,48.722,"med"],[41,49,48.722,49.405,"julepynt"]],"speaker":"Monica"},{"id":10,"start":51.02,"end":56.545,"text":"Alle snakker om hvor mye man må gjøre før jul, men jeg prøver å ikke stresse for mye.","zh":"大家都在说圣诞节前有多少事情要做，不过我尽量不让自己太紧张。","words":[[0,4,51.02,51.285,"alle"],[5,12,51.32,51.725,"snakker"],[13,15,51.74,51.883,"om"],[16,20,51.883,52.085,"hvor"],[21,24,52.1,52.383,"mye"],[25,28,52.383,52.532,"man"],[29,31,52.532,52.645,"må"],[32,37,52.68,53.045,"gjøre"],[38,41,53.14,53.425,"før"],[42,45,53.44,53.705,"jul"],[47,50,54.6,54.752,"men"],[51,54,54.752,54.905,"jeg"],[55,61,54.92,55.242,"prøver"],[62,63,55.242,55.325,"å"],[64,68,55.34,55.625,"ikke"],[69,76,55.66,56.105,"stresse"],[77,80,56.14,56.293,"for@pa-vei-for-excess"],[81,84,56.293,56.545,"mye"]],"speaker":"Monica"},{"id":11,"start":61.672,"end":63.437,"text":"Jeg synes jula er litt trist.","zh":"我觉得圣诞节有点伤感。","words":[[0,3,61.672,61.837,"jeg"],[4,9,61.872,62.277,"synes"],[10,14,62.312,62.637,"jula"],[15,17,62.732,62.865,"er"],[18,22,62.865,63.044,"litt"],[23,28,63.044,63.437,"trist"]],"speaker":"Safer"},{"id":12,"start":64.432,"end":68.017,"text":"Det er veldig mørkt ute, og alle er sammen med familiene sine.","zh":"外面很黑，大家都和自己的家人在一起。","words":[[0,3,64.432,64.584,"det"],[4,6,64.584,64.684,"er"],[7,13,64.684,64.977,"veldig"],[14,19,65.012,65.385,"mørkt"],[20,23,65.385,65.617,"ute"],[25,27,66.332,66.457,"og"],[28,32,66.472,66.695,"alle"],[33,35,66.695,66.804,"er"],[36,42,66.804,67.135,"sammen"],[43,46,67.135,67.285,"med"],[47,56,67.285,67.755,"familiene"],[57,61,67.755,68.017,"sine"]],"speaker":"Safer"},{"id":13,"start":69.232,"end":72.457,"text":"Da savner jeg familien min og hjemlandet mitt ekstra mye.","zh":"那时，我就格外想念家人和祖国。","words":[[0,2,69.232,69.377,"da"],[3,9,69.452,69.794,"savner"],[10,13,69.794,69.957,"jeg"],[14,22,69.972,70.484,"familien"],[23,26,70.484,70.657,"min"],[27,29,70.752,70.864,"og"],[30,40,70.864,71.355,"hjemlandet"],[41,45,71.355,71.597,"mitt"],[46,52,71.852,72.225,"ekstra"],[53,56,72.225,72.457,"mye"]],"speaker":"Safer"},{"id":14,"start":73.472,"end":74.417,"text":"Jeg er sammen med venner.","zh":"我和朋友们一起过。","words":[[0,3,73.472,73.594,"jeg"],[4,6,73.594,73.684,"er"],[7,13,73.684,73.984,"sammen"],[14,17,73.984,74.114,"med"],[18,24,74.114,74.417,"venner"]],"speaker":"Safer"},{"id":15,"start":75.192,"end":78.077,"text":"Det er hyggelig, men det er ikke som hjemme.","zh":"这样也很愉快，不过和在家时不一样。","words":[[0,3,75.192,75.355,"det"],[4,6,75.355,75.465,"er"],[7,15,75.465,75.837,"hyggelig"],[17,20,76.632,76.837,"men"],[21,24,77.212,77.355,"det"],[25,27,77.355,77.484,"er"],[28,32,77.484,77.674,"ikke"],[33,36,77.674,77.804,"som@pa-vei-som-like"],[37,43,77.804,78.077,"hjemme"]],"speaker":"Safer"},{"id":16,"start":82.832,"end":87.257,"text":"Gatene ser veldig fine ut før jul med alle lysene og julepynten.","zh":"圣诞节前，街道上布满灯光和圣诞装饰，看起来非常漂亮。","words":[[0,6,82.832,83.397,"gatene"],[7,10,83.452,83.637,"ser"],[11,17,83.672,84.057,"veldig"],[18,22,84.072,84.394,"fine"],[23,25,84.394,84.554,"ut"],[26,29,84.554,84.757,"før"],[30,33,84.772,85.057,"jul"],[34,37,85.292,85.445,"med"],[38,42,85.445,85.677,"alle"],[43,49,85.692,86.297,"lysene"],[50,52,86.352,86.497,"og"],[53,63,86.532,87.257,"julepynten"]],"speaker":"Haifa"},{"id":17,"start":88.132,"end":92.217,"text":"Nordmenn er veldig opptatt av jula, og jeg tror den er viktig for mange.","zh":"挪威人很重视圣诞节，我想这对很多人来说都很重要。","words":[[0,8,88.132,88.544,"nordmenn"],[9,11,88.544,88.677,"er"],[12,18,88.732,89.165,"veldig"],[19,26,89.165,89.495,"opptatt"],[27,29,89.495,89.605,"av"],[30,34,89.605,89.877,"jula"],[36,38,90.552,90.674,"og"],[39,42,90.674,90.817,"jeg"],[43,47,90.832,91.055,"tror"],[48,51,91.055,91.174,"den"],[52,54,91.174,91.317,"er"],[55,61,91.332,91.777,"viktig"],[62,65,91.832,91.965,"for"],[66,71,91.965,92.217,"mange"]],"speaker":"Haifa"},{"id":18,"start":93.512,"end":97.177,"text":"Jeg er muslim, og for meg betyr jula mange stille dager.","zh":"我是穆斯林，对我来说，圣诞节意味着许多个安静的日子。","words":[[0,3,93.512,93.717,"jeg"],[4,6,93.732,93.897,"er"],[7,13,93.912,94.437,"muslim"],[15,17,94.752,94.875,"og"],[18,21,94.875,95.037,"for"],[22,25,95.052,95.277,"meg"],[26,31,95.312,95.695,"betyr"],[32,36,95.695,95.997,"jula"],[37,42,96.032,96.317,"mange"],[43,49,96.372,96.794,"stille"],[50,55,96.794,97.177,"dager"]],"speaker":"Haifa"},{"id":19,"start":98.132,"end":102.717,"text":"Men i år er jeg invitert til noen norske venner, og det gleder jeg meg til.","zh":"不过今年有几位挪威朋友邀请了我，我很期待。","words":[[0,3,98.132,98.315,"men"],[4,5,98.315,98.417,"i"],[6,8,98.472,98.757,"år"],[9,11,98.872,99.005,"er"],[12,15,99.005,99.124,"jeg"],[16,24,99.124,99.725,"invitert"],[25,28,99.725,99.875,"til"],[29,33,99.875,100.075,"noen"],[34,40,100.075,100.484,"norske"],[41,47,100.484,100.817,"venner"],[49,51,101.412,101.537,"og"],[52,55,101.652,101.837,"det"],[56,62,102.012,102.334,"gleder"],[63,66,102.334,102.434,"jeg"],[67,70,102.434,102.544,"meg"],[71,74,102.544,102.717,"til"]],"speaker":"Haifa"},{"id":20,"start":103.692,"end":106.517,"text":"Jeg skal spise tradisjonell norsk julemat.","zh":"我要吃挪威传统的圣诞食物。","words":[[0,3,103.692,103.897,"jeg"],[4,8,103.912,104.114,"skal"],[9,14,104.114,104.537,"spise"],[15,27,104.612,105.357,"tradisjonell"],[28,33,105.472,105.817,"norsk@pa-vei-norsk-adjective"],[34,41,105.872,106.517,"julemat"]],"speaker":"Haifa"}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"alltid":{"lemma":"alltid","pos":"副词","zh":"总是；一直","ref":null,"clip":null},"av":{"lemm