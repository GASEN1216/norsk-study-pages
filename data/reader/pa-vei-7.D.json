{"id":"pa-vei-7.D","bookId":"pa-vei-textbook","readingId":"7.D","title":"Tomater eller agurk?","audio":"audio/pa-vei/7.D.mp3","duration":63.897563,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.92,"end":4.345,"text":"D. Tomater eller agurk?","zh":"D. 番茄还是黄瓜？","words":[[0,1,0.92,1.4,"d"],[3,10,2.6,3.305,"tomater"],[11,16,3.4,3.705,"eller"],[17,22,3.84,4.345,"agurk"]]},{"id":1,"start":6.04,"end":13.305,"text":"Emma og Henrik går hjemover med røde sko, en rød genser og et grått skjerf i bæreposene.","zh":"埃玛和亨里克往家走，购物袋里装着红鞋、红毛衣和灰围巾。","words":[[0,4,6.04,6.385,"emma"],[5,7,6.42,6.562,"og"],[8,14,6.562,7.105,"henrik"],[15,18,7.3,7.623,"går"],[19,27,7.623,8.125,"hjemover"],[28,31,8.2,8.405,"med"],[32,36,8.5,8.885,"røde"],[37,40,8.92,9.125,"sko"],[42,44,9.66,9.845,"en"],[45,48,9.9,10.183,"rød"],[49,55,10.183,10.665,"genser"],[56,58,11.14,11.285,"og"],[59,61,11.32,11.525,"et"],[62,67,11.56,11.905,"grått"],[68,74,11.92,12.385,"skjerf"],[75,76,12.46,12.585,"i"],[77,87,12.6,13.305,"bæreposene"]]},{"id":2,"start":14.202,"end":15.847,"text":"De er glade og fornøyde.","zh":"他们开心又满意。","words":[[0,2,14.202,14.347,"de"],[3,5,14.442,14.627,"er"],[6,11,14.702,15.207,"glade"],[12,14,15.222,15.354,"og"],[15,23,15.354,15.847,"fornøyde"]]},{"id":3,"start":17.342,"end":18.687,"text":"Takk skal du ha, pappa.","zh":"谢谢你，爸爸。","words":[[0,4,17.342,17.667,"takk"],[5,9,17.682,17.895,"skal"],[10,12,17.895,18.027,"du"],[13,15,18.082,18.247,"ha"],[17,22,18.362,18.687,"pappa"]],"speaker":"Emma"},{"id":4,"start":19.522,"end":22.467,"text":"I morgen skal jeg gå med røde sko i bursdagen.","zh":"明天我要穿红鞋去参加生日聚会。","words":[[0,1,19.522,19.647,"i"],[2,8,19.662,20.087,"morgen"],[9,13,20.182,20.404,"skal"],[14,17,20.404,20.624,"jeg"],[18,20,20.624,20.767,"gå"],[21,24,20.802,20.987,"med"],[25,29,21.002,21.327,"røde"],[30,33,21.382,21.627,"sko"],[34,35,21.722,21.827,"i"],[36,45,21.842,22.467,"bursdagen"]],"speaker":"Emma"},{"id":5,"start":23.362,"end":24.547,"text":"Takk skal du ha, Emma.","zh":"谢谢你，埃玛。","words":[[0,4,23.362,23.645,"takk"],[5,9,23.645,23.827,"skal"],[10,12,23.842,23.987,"du"],[13,15,24.102,24.247,"ha"],[17,21,24.302,24.547,"emma"]],"speaker":"Henrik"},{"id":6,"start":25.802,"end":27.787,"text":"Det er hyggelig å gå i butikker sammen med deg.","zh":"和你一起逛商店很开心。","words":[[0,3,25.802,25.954,"det"],[4,6,25.954,26.065,"er"],[7,15,26.065,26.454,"hyggelig"],[16,17,26.454,26.535,"å"],[18,20,26.535,26.645,"gå"],[21,22,26.645,26.735,"i"],[23,31,26.735,27.224,"butikker"],[32,38,27.224,27.514,"sammen"],[39,42,27.514,27.634,"med"],[43,46,27.634,27.787,"deg"]],"speaker":"Henrik"},{"id":7,"start":29.402,"end":31.187,"text":"Nå går vi hjem og spiser middag.","zh":"现在我们回家吃晚饭。","words":[[0,2,29.402,29.547,"nå"],[3,6,29.722,29.934,"går"],[7,9,29.934,30.055,"vi"],[10,14,30.055,30.267,"hjem"],[15,17,30.422,30.535,"og"],[18,24,30.535,30.875,"spiser"],[25,31,30.875,31.187,"middag"]],"speaker":"Henrik"},{"id":8,"start":32.32,"end":32.76,"text":"Oj.","zh":"哎呀。","words":[[0,2,32.32,32.76,"oj"]],"speaker":"Emma"},{"id":9,"start":33.342,"end":34.547,"text":"Hva med grønnsakene?","zh":"蔬菜怎么办？","words":[[0,3,33.342,33.527,"hva"],[4,7,33.542,33.724,"med"],[8,19,33.724,34.547,"grønnsakene"]],"speaker":"Emma"},{"id":10,"start":35.242,"end":36.407,"text":"Det må vi ikke glemme.","zh":"我们可不能忘了。","words":[[0,3,35.242,35.447,"det"],[4,6,35.562,35.687,"må"],[7,9,35.702,35.825,"vi"],[10,14,35.825,36.014,"ikke"],[15,21,36.014,36.407,"glemme"]],"speaker":"Emma"},{"id":11,"start":37.782,"end":38.547,"text":"Det er sant.","zh":"说得对。","words":[[0,3,37.782,37.967,"det"],[4,6,38.022,38.167,"er"],[7,11,38.182,38.547,"sant"]],"speaker":"Henrik"},{"id":12,"start":39.522,"end":41.167,"text":"Det ligger en matbutikk der borte.","zh":"那边有一家食品店。","words":[[0,3,39.522,39.674,"det"],[4,10,39.674,39.927,"ligger"],[11,13,39.942,40.075,"en"],[14,23,40.075,40.684,"matbutikk"],[24,27,40.684,40.874,"der"],[28,33,40.874,41.167,"borte"]],"speaker":"Henrik"},{"id":13,"start":42.582,"end":44.007,"text":"Men hva sa mamma?","zh":"不过妈妈说了什么来着？","words":[[0,3,42.582,42.787,"men"],[4,7,43.102,43.267,"hva"],[8,10,43.382,43.567,"sa"],[11,16,43.682,44.007,"mamma"]],"speaker":"Henrik"},{"id":14,"start":45.402,"end":46.807,"text":"Hun trengte brokkoli.","zh":"她需要西兰花。","words":[[0,3,45.402,45.567,"hun"],[4,11,45.602,46.047,"trengte"],[12,20,46.142,46.807,"brokkoli"]],"speaker":"Emma"},{"id":15,"start":48.122,"end":48.527,"text":"Riktig.","zh":"对。","words":[[0,6,48.122,48.527,"riktig"]],"speaker":"Henrik"},{"id":16,"start":49.402,"end":52.067,"text":"Og så trengte hun tomater, gjorde hun ikke?","zh":"她还需要番茄，是不是？","words":[[0,2,49.402,49.527,"og"],[3,5,49.542,49.687,"så"],[6,13,49.762,50.165,"trengte"],[14,17,50.165,50.367,"hun"],[18,25,50.502,51.367,"tomater"],[27,33,51.422,51.684,"gjorde"],[34,37,51.684,51.825,"hun"],[38,42,51.825,52.067,"ikke"]],"speaker":"Henrik"},{"id":17,"start":53.422,"end":56.267,"text":"Tomater eller agurk?","zh":"是番茄还是黄瓜？","words":[[0,7,53.422,54.267,"tomater"],[8,13,55.082,55.427,"eller"],[14,19,55.602,56.267,"agurk"]],"speaker":"Emma"},{"id":18,"start":57.242,"end":58.047,"text":"Jeg husker ikke.","zh":"我记不清了。","words":[[0,3,57.242,57.407,"jeg"],[4,10,57.422,57.805,"husker"],[11,15,57.805,58.047,"ikke"]],"speaker":"Henrik"},{"id":19,"start":58.762,"end":60.627,"text":"Vi kjøper både tomater og agurk.","zh":"番茄和黄瓜我们都买。","words":[[0,2,58.762,58.904,"vi"],[3,9,58.904,59.247,"kjøper"],[10,14,59.282,59.584,"både"],[15,22,59.584,60.094,"tomater"],[23,25,60.094,60.184,"og"],[26,31,60.184,60.627,"agurk"]],"speaker":"Henrik"}],"lexicon":{"agurk":{"lemma":"agurk","zh":"黄瓜","pos":"名词","ref":"basics:groceries:agurk","clip":null},"borte":{"lemma":"borte","zh":"那边（der borte：在那边）","pos":"副词","ref":null,"clip":null},"brokkoli":{"lemma":"brokkoli","zh":"西兰花","pos":"名词","ref":"basics:groceries:brokkoli","clip":null},"bursdagen":{"lemma":"bursdag","zh":"生日","pos":"名词","ref":"5-099","form":"单数定指","clip":null},"butikker":{"lemma":"butikk","zh":"商店","pos":"名词","r