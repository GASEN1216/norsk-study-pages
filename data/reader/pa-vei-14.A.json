{"id":"pa-vei-14.A","bookId":"pa-vei-textbook","readingId":"14.A","title":"Familiebilder","audio":"audio/pa-vei/14.A.mp3","duration":133.176,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.86,"end":2.405,"text":"Du har mange bilder på veggen.","zh":"你墙上挂着很多照片。","words":[[0,2,0.86,1.002,"du"],[3,6,1.002,1.185,"har"],[7,12,1.22,1.585,"mange"],[13,19,1.6,1.933,"bilder"],[20,22,1.933,2.045,"på"],[23,29,2.06,2.405,"veggen"]],"speaker":"Fru Berg"},{"id":1,"start":3.52,"end":5.245,"text":"Er det besteforeldrene dine?","zh":"那是你的祖父母吗？","words":[[0,2,3.52,3.683,"er"],[3,6,3.683,3.865,"det"],[7,22,4.0,4.925,"besteforeldrene"],[23,27,4.94,5.245,"dine"]],"speaker":"Fru Berg"},{"id":2,"start":6.78,"end":8.665,"text":"Ja, det er farmor og farfar.","zh":"是的，那是我的奶奶和爷爷。","words":[[0,2,6.78,6.965,"ja"],[4,7,7.46,7.593,"det"],[8,10,7.593,7.703,"er"],[11,17,7.703,8.092,"farmor"],[18,20,8.092,8.192,"og"],[21,27,8.192,8.665,"farfar"]],"speaker":"Johanna"},{"id":3,"start":9.56,"end":12.905,"text":"Farfar døde for ti år siden, men farmor lever.","zh":"爷爷十年前去世了，不过奶奶还健在。","words":[[0,6,9.56,9.982,"farfar"],[7,11,9.982,10.312,"døde@pa-vei-extra-14"],[12,15,10.312,10.465,"for"],[16,18,10.5,10.685,"ti"],[19,21,10.84,11.045,"år"],[22,27,11.06,11.385,"siden"],[29,32,11.86,12.045,"men"],[33,39,12.08,12.505,"farmor"],[40,45,12.54,12.905,"lever"]],"speaker":"Johanna"},{"id":4,"start":14.092,"end":17.157,"text":"Hun heter Marie og blir 90 år snart.","zh":"她叫玛丽，很快就要满 90 岁了。","words":[[0,3,14.092,14.277,"hun"],[4,9,14.332,14.677,"heter"],[10,15,14.692,15.137,"marie"],[16,18,15.632,15.764,"og"],[19,23,15.764,16.017,"blir"],[24,26,16.192,16.577,"90"],[27,29,16.592,16.777,"år"],[30,35,16.792,17.157,"snart"]],"speaker":"Johanna"},{"id":5,"start":18.272,"end":21.717,"text":"90 år? Skal dere feire dagen?","zh":"90 岁？你们要庆祝生日吗？","words":[[0,2,18.272,18.777,"90"],[3,5,18.792,19.017,"år"],[7,11,20.272,20.497,"skal"],[12,16,20.512,20.797,"dere"],[17,22,20.812,21.277,"feire"],[23,28,21.292,21.717,"dagen"]],"speaker":"Fru Berg"},{"id":6,"start":23.192,"end":26.977,"text":"Ja, det er klart. Vi skal ha en stor fest på lørdag.","zh":"当然了。我们星期六要办一个盛大的聚会。","words":[[0,2,23.192,23.357,"ja"],[4,7,23.532,23.694,"det"],[8,10,23.694,23.855,"er"],[11,16,23.855,24.237,"klart"],[18,20,24.892,25.017,"vi"],[21,25,25.052,25.255,"skal"],[26,28,25.255,25.374,"ha"],[29,31,25.374,25.517,"en"],[32,36,25.572,25.917,"stor"],[37,41,25.932,26.337,"fest"],[42,44,26.372,26.497,"på"],[45,51,26.512,26.977,"lørdag"]],"speaker":"Johanna"},{"id":7,"start":27.732,"end":29.977,"text":"Hun har mange barnebarn og oldebarn.","zh":"她有很多孙辈和曾孙辈。","words":[[0,3,27.732,27.915,"hun"],[4,7,27.915,28.075,"har"],[8,13,28.075,28.417,"mange"],[14,23,28.432,28.977,"barnebarn"],[24,26,29.272,29.397,"og"],[27,35,29.452,29.977,"oldebarn"]],"speaker":"Johanna"},{"id":8,"start":31.572,"end":32.697,"text":"Er det mannen din?","zh":"那是你丈夫吗？","words":[[0,2,31.572,31.737,"er"],[3,6,31.772,31.957,"det"],[7,13,32.072,32.297,"mannen"],[14,17,32.432,32.697,"din"]],"speaker":"Fru Berg"},{"id":9,"start":34.052,"end":37.277,"text":"Nei, det er broren min Oscar og kona hans.","zh":"不是，那是我的兄弟奥斯卡和他的妻子。","words":[[0,3,34.052,34.357,"nei"],[5,8,34.872,35.025,"det"],[9,11,35.025,35.144,"er"],[12,18,35.144,35.474,"broren"],[19,22,35.474,35.657,"min"],[23,28,35.732,36.257,"oscar"],[29,31,36.452,36.575,"og"],[32,36,36.575,36.915,"kona"],[37,41,36.915,37.277,"hans"]],"speaker":"Johanna"},{"id":10,"start":38.052,"end":42.737,"text":"Nå er de skilt, men broren min har en ny kjæreste. De bor sammen.","zh":"他们现在离婚了，不过我的兄弟有了新女友，他们住在一起。","words":[[0,2,38.052,38.184,"nå"],[3,5,38.184,38.294,"er"],[6,8,38.294,38.397,"de"],[9,14,38.412,38.877,"skilt"],[16,19,39.392,39.557,"men"],[20,26,39.592,39.885,"broren"],[27,30,39.885,40.037,"min"],[31,34,40.052,40.234,"har"],[35,37,40.234,40.355,"en"],[38,40,40.355,40.477,"ny"],[41,49,40.572,41.077,"kjæreste"],[51,53,41.952,42.077,"de"],[54,57,42.112,42.337,"bor"],[58,64,42.392,42.737,"sammen"]],"speaker":"Johanna"},{"id":11,"start":43.772,"end":44.717,"text":"Er de ikke gift?","zh":"他们没有结婚吗？","words":[[0,2,43.772,43.954,"er"],[3,5,43.954,44.075,"de"],[6,10,44.075,44.314,"ikke"],[11,15,44.314,44.717,"gift"]],"speaker":"Fru Berg"},{"id":12,"start":45.472,"end":49.857,"text":"Nei, de er samboere, men de skal kanskje gifte seg til sommeren.","zh":"没有，他们在同居，不过也许今年夏天会结婚。","words":[[0,3,45.472,45.757,"nei"],[5,7,46.272,46.415,"de"],[8,10,46.415,46.557,"er"],[11,19,46.592,47.177,"samboere"],[21,24,47.792,47.954,"men"],[25,27,47.954,48.077,"de"],[28,32,48.092,48.297,"skal"],[33,40,48.312,48.675,"kanskje"],[41,46,48.675,49.014,"gifte"],[47,50,49.014,49.194,"seg"],[51,54,49.194,49.357,"til"],[55,63,49.412,49.857,"sommeren"]],"speaker":"Johanna"},{"id":13,"start":51.432,"end":55.577,"text":"Og her er to pene jenter. Er det dine barn?","zh":"这里有两个漂亮的女孩。是你的孩子吗？","words":[[0,2,51.432,51.577,"og"],[3,6,51.732,52.097,"her"],[7,9,52.192,52.337,"er"],[10,12,52.392,52.577,"to"],[13,17,52.732,53.154,"pene"],[18,24,53.154,53.617,"jenter"],[26,28,54.712,54.844,"er"],[29,32,54.844,54.995,"det"],[33,37,54.995,55.314,"dine"],[38,42,55.314,55.577,"barn"]],"speaker":"Fru Berg"},{"id":14,"start":56.532,"end":59.977,"text":"Ja, det er Liv og Synne. De er tvillinger.","zh":"是的，她们是莉芙和叙内，是双胞胎。","words":[[0,2,56.532,56.697,"ja"],[4,7,57.412,57.575,"det"],[8,10,57.575,57.715,"er"],[11,14,57.715,58.017,"liv@pa-vei-liv-name"],[15,17,58.112,58.234,"og"],[18,23,58.234,58.577,"synne"],[25,27,59.232,59.355,"de"],[28,30,59.355,59.465,"er"],[31,41,59.465,59.977,"tvillinger@pa-vei-extra-15"]],"speaker":"Johanna"},{"id":15,"start":61.212,"end":64.457,"text":"Det kan jeg se. De er veldig like.","zh":"看得出来，她们长得很像。","words":[[0,3,61.212,61.374,"det"],[4,7,61.374,61.535,"kan"],[8,11,61.535,61.697,"jeg"],[12,14,61.712,61.877,"se"],[16,18,63.112,63.257,"de"],[19,21,63.292,63.437,"er"],[22,28,63.512,64.017,"veldig"],[29,33,64.032,64.457,"like@pa-vei-like-similar"]],"speaker":"Fru Berg"},{"id":16,"start":66.072,"end":68.06,"text":"Og hvem er det? Er det deg?","zh":"那这是谁？是你吗？","words":[[0,2,66.072,66.195,"og"],[3,7,66.195,66.397,"hvem"],[8,10,66.412,66.544,"er"],[11,14,66.544,66.717,"det"],[16,18,67.512,67.635,"er"],[19,22,67.635,67.764,"det"],[23,26,67.78,68.06,"deg"]],"speaker":"Fru Berg"},{"id":17,"start":68.962,"end":71.167,"text":"Meg? Nei, det er min mor.","zh":"我？不是，那是我妈妈。","words":[[0,3,68.962,69.227,"meg"],[5,8,69.782,70.067,"nei"],[10,13,70.422,70.554,"det"],[14,16,70.554,70.674,"er"],[17,20,70.674,70.867,"min"],[21,24,70.882,71.167,"mor"]],"speaker":"Johanna"},{"id":18,"start":72.16,"end":74.167,"text":"Åh. Unnskyld meg!","zh":"啊，不好意思！","words":[[0,2,72.16,72.58,"åh"],[4,12,73.302,73.945,"unnskyld"],[13,16,73.945,74.167,"meg"]],"speaker":"Fru Berg"},{"id":19,"start":75.382,"end":80.747,"text":"Det er i orden. Vi er veldig like. Og forresten er det et gammelt bilde.","zh":"没关系。我们长得很像，而且那也是张老照片。","words":[[0,3,75.382,75.567,"det"],[4,6,75.582,75.725,"er"],[7,8,75.725,75.825,"i"],[9,14,75.825,76.207,"orden"],[16,18,76.842,76.987,"vi"],[19,21,77.002,77.144,"er"],[22,28,77.144,77.584,"veldig"],[29,33,77.584,77.947,"like@pa-vei-like-similar"],[35,37,78.662,78.794,"og"],[38,47,78.794,79.307,"forresten"],[48,50,79.642,79.764,"er"],[51,54,79.764,79.864,"det"],[55,57,79.864,79.975,"et"],[58,65,79.975,80.387,"gammelt"],[66,71,80.402,80.747,"bilde"]],"speaker":"Johanna"},{"id":20,"start":83.932,"end":84.617,"text":"Sammendrag.","zh":"摘要","words":[[0,10,83.932,84.617,"sammendrag"]]},{"id":21,"start":86.872,"end":90.577,"text":"Johanna har fått en ny nabo som heter Sonja Berg.","zh":"约翰娜有了一位叫索尼娅·贝格的新邻居。","words":[[0,7,86.872,87.537,"johanna"],[8,11,87.572,87.757,"har"],[12,16,87.792,88.035,"fått@pa-vei-extra-18"],[17,19,88.035,88.174,"en"],[20,22,88.174,88.317,"ny"],[23,27,88.472,88.937,"nabo"],[28,31,89.012,89.165,"som"],[32,37,89.165,89.457,"heter"],[38,43,89.592,90.137,"sonja"],[44,48,90.192,90.577,"berg"]]},{"id":22,"start":92.672,"end":97.457,"text":"Hun besøker Johanna og ser på familiebildene som henger på veggen.","zh":"她来约翰娜家做客，看墙上挂着的家庭照片。","words":[[0,3,92.672,92.857,"hun"],[4,11,92.892,93.525,"besøker"],[12,19,93.525,93.977,"johanna"],[20,22,94.632,94.757,"og"],[23,26,94.812,95.077,"ser"],[27,29,95.112,95.255,"på"],[30,44,95.255,96.397,"familiebildene"],[45,48,96.452,96.614,"som"],[49,55,96.614,96.904,"henger"],[56,58,96.904,97.037,"på"],[59,65,97.072,97.457,"veggen"]]},{"id":23,"start":99.412,"end":102.797,"text":"Johanna forteller om farmora si som blir 90 år.","zh":"约翰娜讲起即将满 90 岁的奶奶。","words":[[0,7,99.412,99.957,"johanna"],[8,17,99.992,100.577,"forteller"],[18,20,100.632,100.777,"om"],[21,28,100.852,101.397,"farmora"],[29,31,101.412,101.557,"si@pa-vei-si-possessive"],[32,35,101.592,101.745,"som"],[36,40,101.745,101.957,"blir"],[41,43,102.052,102.517,"90"],[44,46,102.572,102.797,"år"]]},{"id":24,"start":104.272,"end":107.277,"text":"Hun snakker om fødselsdagen de skal feire til helga.","zh":"她说起他们这个周末要庆祝的生日。","words":[[0,3,104.272,104.437,"hun"],[4,11,104.492,104.875,"snakker"],[12,14,104.875,104.997,"om"],[15,27,105.072,105.954,"fødselsdagen"],[28,30,105.954,106.075,"de"],[31,35,106.075,106.257,"skal"],[36,41,106.312,106.717,"feire"],[42,45,106.732,106.897,"til"],[46,51,106.912,107.277,"helga@pa-vei-extra-17"]]},{"id":25,"start":109.372,"end":113.337,"text":"Johanna forteller også om broren sin som er skilt.","zh":"约翰娜还讲起她已经离婚的兄弟。","words":[[0,7,109.372,109.897,"johanna"],[8,17,109.932,110.417,"forteller"],[18,22,110.492,110.857,"også"],[23,25,111.252,111.397,"om"],[26,32,111.472,111.957,"broren"],[33,36,111.972,112.177,"sin"],[37,40,112.552,112.715,"som"],[41,43,112.715,112.837,"er"],[44,49,112.852,113.337,"skilt"]]},{"id":26,"start":114.672,"end":115.617,"text":"Han heter Oscar.","zh":"他叫奥斯卡。","words":[[0,3,114.672,114.834,"han"],[4,9,114.834,115.117,"heter"],[10,15,115.152,115.617,"oscar"]]},{"id":27,"start":117.132,"end":122.697,"text":"Nå bor han sammen med en ny kjæreste, og de skal kanskje gifte seg til sommeren.","zh":"现在他和新女友住在一起，也许今年夏天会结婚。","words":[[0,2,117.132,117.277,"nå"],[3,6,117.352,117.575,"bor"],[7,10,117.575,117.717,"han"],[11,17,117.772,118.135,"sammen"],[18,21,118.135,118.294,"med"],[22,24,118.294,118.437,"en"],[25,27,118.452,118.617,"ny"],[28,36,118.772,119.297,"kjæreste"],[38,40,120.432,120.565,"og"],[41,43,120.565,120.677,"de"],[44,48,120.692,120.897,"skal"],[49,56,120.932,121.337,"kanskje"],[57,62,121.352,121.817,"gifte"],[63,66,121.832,122.037,"seg"],[67,70,122.072,122.257,"til"],[71,79,122.292,122.697,"sommeren"]]},{"id":28,"start":124.852,"end":128.417,"text":"Johanna har to døtre som heter Synne og Liv.","zh":"约翰娜有两个女儿，叫叙内和莉芙。","words":[[0,7,124.852,125.355,"johanna"],[8,11,125.355,125.537,"har"],[12,14,125.612,125.777,"to"],[15,20,125.912,126.357,"døtre"],[21,24,126.912,127.055,"som"],[25,30,127.055,127.317,"heter"],[31,36,127.392,127.857,"synne"],[37,39,127.952,128.075,"og"],[40,43,128.075,128.417,"liv@pa-vei-liv-name"]]},{"id":29,"start":129.572,"end":130.517,"text":"De er tvillinger.","zh":"她们是双胞胎。","words":[[0,2,129.572,129.717,"de"],[3,5,129.772,129.915,"er"],[6,16,129.915,130.517,"tvillinger@pa-vei-extra-16"]]}],"lexicon":{"90":{"lemma":"90","pos":"数词","zh":"数字 90","ref":null,"clip":null},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":null},"barnebarn":{"lemma":"barnebarn","zh":"孙辈；孙子、孙女、外孙或外孙女","pos":"名词","ref":"5-036","clip":null},"berg":{"lemma":"Berg","zh":"贝格（姓氏）","pos":"专名","ref":null,"clip":null},"besteforeldrene":{"lemma":"besteforeldre","zh":"祖父母；外祖父母","pos":"名词","ref":"3-021","form":"复数定指","clip":null},"besøker":{"lemma":"besøke","zh":"拜访；看望（besøke 的现在时）","pos":"动词","ref":"3-023","form":"现在时","clip":null},"bilde":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","clip":null},"bilder":{"lemma":"bilde","zh":"图片；照片","pos":"名词","ref":"7-065","form":"复数不定","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-convers