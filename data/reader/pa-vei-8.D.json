{"id":"pa-vei-8.D","bookId":"pa-vei-textbook","readingId":"8.D","title":"En frisk høstdag","audio":"audio/pa-vei/8.D.mp3","duration":39.744,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.0,"end":5.665,"text":"Samboeren til Nils heter Bente, og hun er glad i å gå på tur.","zh":"尼尔斯的同居伴侣叫本特，她喜欢外出散步。","words":[[0,9,1.0,1.683,"samboeren"],[10,13,1.683,1.865,"til"],[14,18,1.94,2.405,"nils"],[19,24,2.5,2.945,"heter"],[25,30,3.02,3.545,"bente"],[32,34,4.02,4.165,"og"],[35,38,4.18,4.365,"hun"],[39,41,4.42,4.565,"er"],[42,46,4.58,4.863,"glad"],[47,48,4.863,4.963,"i"],[49,50,4.963,5.062,"å"],[51,53,5.062,5.185,"gå"],[54,56,5.2,5.342,"på"],[57,60,5.342,5.665,"tur"]]},{"id":1,"start":7.44,"end":8.845,"text":"Er det ikke en flott dag!","zh":"多好的天气呀！","words":[[0,2,7.44,7.582,"er"],[3,6,7.582,7.702,"det"],[7,11,7.702,7.862,"ikke"],[12,14,7.862,7.985,"en"],[15,20,8.12,8.543,"flott"],[21,24,8.543,8.845,"dag"]],"speaker":"Bente"},{"id":2,"start":10.14,"end":10.765,"text":"Flott?","zh":"好？","words":[[0,5,10.14,10.765,"flott"]],"speaker":"Nils"},{"id":3,"start":11.428,"end":13.173,"text":"Det blåser og er kaldt.","zh":"外面又刮风又冷。","words":[[0,3,11.428,11.593,"det"],[4,10,11.648,12.271,"blåser"],[11,13,12.271,12.37,"og"],[14,16,12.37,12.493,"er"],[17,22,12.528,13.173,"kaldt"]],"speaker":"Nils"},{"id":4,"start":14.088,"end":15.193,"text":"Blir du med ut en tur?","zh":"你一起出去走走吗？","words":[[0,4,14.088,14.341,"blir"],[5,7,14.341,14.45,"du"],[8,11,14.45,14.611,"med"],[12,14,14.611,14.831,"ut"],[15,17,14.831,14.95,"en"],[18,21,14.95,15.193,"tur"]],"speaker":"Bente"},{"id":5,"start":16.228,"end":16.993,"text":"Nei takk.","zh":"不了，谢谢。","words":[[0,3,16.228,16.513,"nei"],[4,8,16.608,16.993,"takk"]],"speaker":"Nils"},{"id":6,"start":18.328,"end":19.253,"text":"Hvorfor ikke?","zh":"为什么不呢？","words":[[0,7,18.328,18.853,"hvorfor"],[8,12,18.868,19.253,"ikke"]],"speaker":"Bente"},{"id":7,"start":20.048,"end":21.613,"text":"Det er så fint vær.","zh":"天气这么好。","words":[[0,3,20.048,20.213,"det"],[4,6,20.248,20.453,"er"],[7,9,20.488,20.653,"så"],[10,14,20.828,21.293,"fint"],[15,18,21.308,21.613,"vær"]],"speaker":"Bente"},{"id":8,"start":22.868,"end":24.033,"text":"Jeg vil heller være hjemme.","zh":"我宁愿待在家里。","words":[[0,3,22.868,23.011,"jeg"],[4,7,23.011,23.14,"vil"],[8,14,23.14,23.41,"heller"],[15,19,23.41,23.611,"være"],[20,26,23.611,24.033,"hjemme"]],"speaker":"Nils"},{"id":9,"start":25.188,"end":25.993,"text":"Hvorfor det?","zh":"为什么？","words":[[0,7,25.188,25.693,"hvorfor"],[8,11,25.768,25.993,"det"]],"speaker":"Bente"},{"id":10,"start":27.108,"end":30.373,"text":"Fordi det er kaldt ute og varmt og godt inne.","zh":"因为外面冷，屋里暖和又舒服。","words":[[0,5,27.108,27.351,"fordi"],[6,9,27.351,27.471,"det"],[10,12,27.471,27.573,"er"],[13,18,27.608,28.133,"kaldt"],[19,22,28.168,28.553,"ute"],[23,25,29.168,29.313,"og"],[26,31,29.328,29.711,"varmt"],[32,34,29.711,29.82,"og"],[35,39,29.82,30.09,"godt"],[40,44,30.09,30.373,"inne"]],"speaker":"Nils"},{"id":11,"start":31.668,"end":33.533,"text":"Dessuten må jeg skifte dekk på bilen.","zh":"而且我得给汽车换轮胎。","words":[[0,8,31.668,32.07,"dessuten"],[9,11,32.07,32.18,"må"],[12,15,32.18,32.32,"jeg"],[16,22,32.32,32.653,"skifte"],[23,27,32.688,32.993,"dekk"],[28,30,33.008,33.153,"på"],[31,36,33.168,33.533,"bilen"]],"speaker":"Nils"},{"id":12,"start":34.66,"end":35.34,"text":"Å?","zh":"哦？","words":[[0,1,34.66,35.34,"å"]],"speaker":"Bente"},{"id":13,"start":35.948,"end":36.713,"text":"Er du sikker?","zh":"你确定？","words":[[0,2,35.948,36.081,"er"],[3,5,36.081,36.213,"du"],[6,12,36.248,36.713,"sikker"]],"speaker":"Bente"},{"id":14,"start":37.688,"end":39.373,"text":"Bare en liten tur?","zh":"就走一小会儿？","words":[[0,4,37.688,37.993,"bare"],[5,7,38.008,38.153,"en"],[8,13,38.248,38.913,"liten"],[14,17,38.988,39.373,"tur"]],"speaker":"Bente"}],"lexicon":{"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bente":{"lemma":"Bente","pos":"专名","zh":"本特（人名）","ref":null,"clip":null},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"blåser":{"lemma":"blåse","zh":"吹；刮风","pos":"动词","ref":"5-006","form":"现在时","clip":null},"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"dekk":{"lemma":"dekk","pos":"名词","zh":"轮胎","ref":null,"clip":null},"dessuten":{"lemma":"dessuten","zh":"而且","pos":"副词","ref":"14-092","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"fint":{"lemma":"fin","zh":"好；太好了（表示赞同）","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"中性"},"flott":{"lemma":"flott","zh":"很棒的；出色的；漂亮的","pos":"形容词","ref":"10-114","clip":null},"fordi":{"lemma":"fordi","zh":"因为","pos":"从属连词","ref":"13-010","clip":null},"glad":{"lemma":"glad","zh":"高兴的；快乐的","pos":"形容词","ref":"9-065","clip":null},"godt":{"lemma":"god","pos":"形容词","zh":"好的；美味的","ref":null,"clip":null,"form":"中性形式"},"gå":{"lemma":"gå","zh":"走；去","pos":"动词","ref":"ty-conversation-3-002","clip":null,"form":"不定式"},"heller":{"lemma":"heller","pos":"副词","zh":"也不（否定句）；宁愿","ref":null,"clip":null},"heter":{"lemma":"hete","zh":"名叫；叫做","pos":"动词","ref":"ty-conversation-1-011","clip":null,"form":"现在时"},"hjemme":{"lemma":"hjemme","zh":"在家（位置）","pos":"副词","ref":"3-039","clip":null},"hun":{"lemma":"hun","zh":"她","pos":"代词","ref":"ty-conversation-8-010","clip":null,"form":"主格"},"hvorfor":{"lemma":"hvorfor","zh":"为什么","pos":"疑问副词","ref":"ty-conversation-1-014","clip":null},"i":{"lemma":"i","pos":"介词","zh":"在；于","ref":null,"clip":null},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-016","clip":null}