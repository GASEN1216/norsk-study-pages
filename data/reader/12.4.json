{"id":"12.4","title":"Vi må prøve å spise sunt","audio":"audio/12.4.mp3","duration":168.58,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.6,"text":"12.4 Vi må prøve å spise sunt","heading":true,"zh":"12.4 我们得尽量吃得健康","words":[[0,4,0.15,1.08,"12.4"],[5,7,1.9,2.4,"vi"],[8,10,2.4,2.6,"må"],[11,16,2.6,3.12,"prøve~c94a9af46ffc"],[17,18,3.12,3.34,"å~0583da7a620a"],[19,24,3.34,3.86,"spise"],[25,29,3.86,4.52,"sunt"]]},{"id":1,"start":6.48,"end":10.1,"text":"Marit og Håvard har vært på joggetur sammen.","zh":"玛丽特和霍瓦尔一起去慢跑了。","words":[[0,5,6.54,7.18,"marit"],[6,8,7.18,7.3,"og"],[9,15,7.3,7.98,"håvard"],[16,19,8.22,8.46,"har~8b9792170cca"],[20,24,8.46,8.68,"vært"],[25,27,8.68,8.84,"på~f36e9b6d216b"],[28,36,8.84,9.54,"joggetur"],[37,43,9.54,9.95,"sammen"]]},{"id":2,"start":11.23,"end":15.04,"text":"Nå har de dusjet, og Håvard er kjempesulten.","zh":"现在他们洗完了澡，霍瓦尔饿极了。","words":[[0,2,11.29,11.66,"nå~d531d47a7712"],[3,6,11.66,11.8,"har~8b9792170cca"],[7,9,11.8,11.94,"de"],[10,16,11.94,12.6,"dusjet"],[18,20,13.0,13.14,"og"],[21,27,13.14,13.68,"håvard"],[28,30,13.68,13.94,"er"],[31,43,13.94,14.89,"kjempesulten"]]},{"id":3,"start":16.74,"end":25.24,"text":"Skal vi bestille en pizza? Jeg er både sliten og sulten. Jeg orker ikke å lage middag nå.","speaker":"Håvard","zh":"我们点个披萨吧？我又累又饿。我现在没力气做晚饭。","words":[[0,4,16.8,17.32,"skal"],[5,7,17.32,17.5,"vi"],[8,16,17.5,18.0,"bestille"],[17,19,18.0,18.12,"en~a939a9e56dc5"],[20,25,18.12,18.68,"pizza"],[27,30,19.86,20.12,"jeg"],[31,33,20.12,20.26,"er"],[34,38,20.26,20.62,"både"],[39,45,20.62,21.42,"sliten"],[46,48,21.42,21.6,"og"],[49,55,21.6,22.25,"sulten"],[57,60,23.1,23.42,"jeg"],[61,66,23.42,23.78,"orker"],[67,71,23.78,23.94,"ikke"],[72,73,23.94,24.0,"å~0583da7a620a"],[74,78,24.0,24.34,"lage"],[79,85,24.34,24.8,"middag"],[86,88,24.8,25.09,"nå~d531d47a7712"]]},{"id":4,"start":26.43,"end":35.25,"text":"Jeg synes at vi skal prøve å spise sunnere. Det er usunt med pizza. Jeg kan lage gulrotsuppe med hjemmelagde grove rundstykker.","speaker":"Marit","zh":"我觉得我们应该尽量吃得健康一点。吃披萨不健康。我可以做胡萝卜汤，配自制的粗粮小面包。","words":[[0,3,26.48,26.76,"jeg"],[4,9,26.76,27.02,"synes"],[10,12,27.02,27.14,"at"],[13,15,27.14,27.26,"vi"],[16,20,27.26,27.46,"skal"],[21,26,27.46,27.74,"prøve~c94a9af46ffc"],[27,28,27.74,27.84,"å~0583da7a620a"],[29,34,27.84,28.3,"spise"],[35,42,28.3,28.89,"sunnere~6142cf103dc8"],[44,47,29.44,29.56,"det"],[48,50,29.56,29.68,"er"],[51,56,29.68,30.2,"usunt"],[57,60,30.2,30.34,"med~af5b33d8592a"],[61,66,30.34,30.88,"pizza"],[68,71,31.54,31.7,"jeg"],[72,75,31.7,31.86,"kan"],[76,80,31.86,32.18,"lage"],[81,92,32.18,33.16,"gulrotsuppe"],[93,96,33.16,33.3,"med~9c3bed5a2e37"],[97,108,33.3,34.06,"hjemmelagde"],[109,114,34.06,34.46,"grove"],[115,126,34.46,35.1,"rundstykker"]]},{"id":5,"start":36.33,"end":38.66,"text":"Jeg blir aldri mett av suppe.","speaker":"Håvard","zh":"我喝汤从来喝不饱。","words":[[0,3,36.39,36.7,"jeg"],[4,8,36.7,37.12,"blir"],[9,14,37.12,37.52,"aldri"],[15,19,37.52,37.84,"mett"],[20,22,37.84,37.98,"av~74a5dcf34271"],[23,28,37.98,38.51,"suppe"]]},{"id":6,"start":39.48,"end":41.73,"text":"Jeg tror at du blir mett av denne suppa.","speaker":"Marit","zh":"我相信这汤能让你吃饱。","words":[[0,3,39.55,39.74,"jeg"],[4,8,39.74,40.04,"tror"],[9,11,40.04,40.16,"at"],[12,14,40.16,40.28,"du"],[15,19,40.28,40.48,"blir"],[20,24,40.48,40.8,"mett"],[25,27,40.8,40.9,"av~74a5dcf34271"],[28,33,40.9,41.18,"denne"],[34,39,41.18,41.58,"suppa"]]},{"id":7,"start":43.62,"end":47.34,"text":"Marit og Håvard sitter ved bordet og spiser.","zh":"玛丽特和霍瓦尔坐在桌旁吃饭。","words":[[0,5,43.69,44.44,"marit"],[6,8,44.44,44.6,"og"],[9,15,44.6,45.31,"håvard"],[16,22,45.46,45.86,"sitter"],[23,26,45.86,46.02,"ved"],[27,33,46.02,46.52,"bordet"],[34,36,46.52,46.66,"og"],[37,43,46.66,47.2,"spiser"]]},{"id":8,"start":48.77,"end":51.16,"text":"Hva synes du? Er suppa god?","speaker":"Marit","zh":"你觉得怎么样？汤好喝吗？","words":[[0,3,48.84,49.02,"hva"],[4,9,49.02,49.3,"synes"],[10,12,49.3,49.59,"du"],[14,16,50.26,50.38,"er"],[17,22,50.38,50.74,"suppa"],[23,26,50.74,51.01,"god~661d53956419"]]},{"id":9,"start":51.89,"end":59.55,"text":"Mm, og disse rundstykkene er også veldig gode. Jeg tar ett til. Au!","speaker":"Håvard","zh":"嗯，这些小面包也非常好吃。我再拿一个。哎哟！","words":[[0,2,51.95,52.48,"mm"],[4,6,53.52,53.64,"og"],[7,12,53.64,53.9,"disse"],[13,25,53.9,54.48,"rundstykkene"],[26,28,54.48,54.56,"er"],[29,33,54.56,54.82,"også"],[34,40,54.82,55.16,"veldig"],[41,45,55.16,55.58,"gode~8f382b67505d"],[47,50,56.8,56.98,"jeg"],[51,54,56.98,57.2,"tar"],[55,58,57.2,57.34,"ett"],[59,62,57.34,57.67,"til~0abfbafc9c23"],[64,66,58.9,59.4,"au"]]},{"id":10,"start":60.27,"end":61.13,"text":"Hva skjedde?","speaker":"Marit","zh":"怎么了？","words":[[0,3,60.34,60.5,"hva"],[4,11,60.5,60.98,"skjedde"]]},{"id":11,"start":62.02,"end":74.95,"text":"Jeg fikk så vondt i ei tann. Jeg må ringe tannlegen, for jeg tror at tanna er ødelagt. Det gjør så vondt. Jeg håper at jeg får time i morgen.","speaker":"Håvard","zh":"我一颗牙疼得厉害。我得给牙医打电话，因为我觉得那颗牙坏了。太疼了。希望明天能约上时间。","words":[[0,3,62.09,62.38,"jeg"],[4,8,62.38,62.68,"fikk~c6d22aeb7bd1"],[9,11,62.68,62.88,"så~f85fae793184"],[12,17,62.88,63.2,"vondt"],[18,19,63.2,63.24,"i"],[20,22,63.24,63.46,"ei~47aa2d18e376"],[23,27,63.46,64.02,"tann"],[29,32,65.34,65.5,"jeg"],[33,35,65.5,65.64,"må"],[36,41,65.64,65.94,"ringe"],[42,51,65.94,66.76,"tannlegen"],[53,56,67.38,67.5,"for~1b22712a94b1"],[57,60,67.5,67.62,"jeg"],[61,65,67.62,67.86,"tror"],[66,68,67.86,68.0,"at"],[69,74,68.0,68.4,"tanna"],[75,77,68.4,68.62,"er"],[78,85,68.62,69.48,"ødelagt"],[87,90,70.38,70.54,"det"],[91,95,70.54,70.88,"gjør~1b092add2921"],[96,98,70.88,71.22,"så~25c4a3a832be"],[99,104,71.22,71.9,"vondt"],[106,109,72.76,72.94,"jeg"],[110,115,72.94,73.28,"håper"],[116,118,73.28,73.38,"at"],[119,122,73.38,73.52,"jeg"],[123,126,73.52,73.68,"får~939872ac59d0"],[127,131,73.68,74.14,"time~5959e4e2d751"],[132,133,74.14,74.22,"i~4f108c27c9d2"],[134,140,74.22,74.8,"morgen~709e4ceb9c48"]]},{"id":12,"start":78.59,"end":79.64,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,78.65,79.49,"sammendrag"]]},{"id":13,"start":80.84,"end":86.7,"text":"Marit og Håvard har vært på den første joggeturen sammen, og nå skal de spise middag.","zh":"玛丽特和霍瓦尔一起进行了第一次慢跑，现在他们要吃晚饭了。","words":[[0,5,80.9,81.46,"marit"],[6,8,81.46,81.58,"og"],[9,15,81.58,82.08,"håvard"],[16,19,82.08,82.28,"har~8b9792170cca"],[20,24,82.28,82.58,"vært"],[25,27,82.58,82.72,"på~f36e9b6d216b"],[28,31,82.72,82.9,"den~5f413bef0ba1"],[32,38,82.9,83.28,"første"],[39,49,83.28,83.92,"joggeturen"],[50,56,83.92,84.46,"sammen"],[58,60,84.9,85.06,"og"],[61,63,85.06,85.44,"nå~d531d47a7712"],[64,68,85.44,85.68,"skal"],[69,71,85.68,85.8,"de"],[72,77,85.8,86.16,"spise"],[78,84,86.16,86.55,"middag"]]},{"id":14,"start":87.58,"end":93.21,"text":"Håvard spør om de skal bestille en pizza, men Marit vil lage sunn mat.","zh":"霍瓦尔问要不要点披萨，但玛丽特想做健康的饭菜。","words":[[0,6,87.64,88.24,"håvard"],[7,11,88.24,88.76,"spør"],[12,14,88.76,88.9,"om~744a29d3d900"],[15,17,88.9,89.08,"de"],[18,22,89.08,89.36,"skal"],[23,31,89.36,89.78,"bestille"],[32,34,89.78,89.9,"en~a939a9e56dc5"],[35,40,89.9,90.46,"pizza"],[42,45,90.92,91.14,"men"],[46,51,91.14,91.78,"marit"],[52,55,91.78,91.96,"vil"],[56,60,91.96,92.3,"lage"],[61,65,92.3,92.6,"sunn"],[66,69,92.6,93.06,"mat"]]},{"id":15,"start":93.98,"end":97.75,"text":"De spiser gulrotsuppe med hjemmelagde rundstykker.","zh":"他们吃胡萝卜汤配自制小面包。","words":[[0,2,94.04,94.34,"de"],[3,9,94.34,94.9,"spiser"],[10,21,94.9,95.88,"gulrotsuppe"],[22,25,95.88,96.16,"med"],[26,37,96.16,96.9,"hjemmelagde"],[38,49,96.9,97.6,"rundstykker"]]},{"id":16,"start":98.78,"end":103.35,"text":"Håvard synes at suppa er god, og han spiser mange rundstykker.","zh":"霍瓦尔觉得汤很好喝，他吃了很多小面包。","words":[[0,6,98.84,99.56,"håvard"],[7,12,99.72,99.98,"synes"],[13,15,99.98,100.14,"at"],[16,21,100.14,100.46,"suppa"],[22,24,100.46,100.64,"er"],[25,28,100.64,101.06,"god~661d53956419"],[30,32,101.38,101.48,"og"],[33,36,101.48,101.68,"han"],[37,43,101.68,102.2,"spiser"],[44,49,102.2,102.56,"mange"],[50,61,102.56,103.2,"rundstykker"]]},{"id":17,"start":104.38,"end":107.07,"text":"Plutselig får Håvard vondt i ei tann.","zh":"突然霍瓦尔有一颗牙疼了起来。","words":[[0,9,104.44,105.02,"plutselig"],[10,13,105.02,105.3,"får~5af6e866825f"],[14,20,105.3,105.84,"håvard"],[21,26,105.84,106.22,"vondt"],[27,28,106.22,106.36,"i"],[29,31,106.36,106.52,"ei~47aa2d18e376"],[32,36,106.52,106.92,"tann"]]},{"id":18,"start":107.76,"end":112.93,"text":"Han tror at tanna er ødelagt, og sier at han må ringe tannlegen.","zh":"他觉得牙坏了，说他得给牙医打电话。","words":[[0,3,107.82,108.16,"han"],[4,8,108.16,108.58,"tror"],[9,11,108.58,108.9,"at"],[12,17,108.9,109.32,"tanna"],[18,20,109.32,109.58,"er"],[21,28,109.58,110.36,"ødelagt"],[30,32,110.7,110.84,"og"],[33,37,110.84,111.2,"sier"],[38,40,111.2,111.36,"at"],[41,44,111.36,111.56,"han"],[45,47,111.56,111.7,"må"],[48,53,111.7,112.02,"ringe"],[54,63,112.02,112.78,"tannlegen"]]},{"id":19,"start":116.1,"end":117.03,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,116.16,116.88,"fakta"]]},{"id":20,"start":118.05,"end":119.53,"text":"Spiser du sunt?","subheading":true,"zh":"你吃得健康吗？","words":[[0,6,118.11,118.68,"spiser"],[7,9,118.68,118.88,"du"],[10,14,118.88,119.38,"sunt"]]},{"id":21,"start":121.06,"end":127.04,"text":"Det er viktig å spise sunn mat og unngå å spise for mye usunn mat.","zh":"吃健康的食物、避免吃太多不健康的食物很重要。","words":[[0,3,121.12,121.4,"det"],[4,6,121.4,121.68,"er"],[7,13,121.68,122.16,"viktig"],[14,15,122.16,122.28,"å~0583da7a620a"],[16,21,122.28,122.72,"spise"],[22,26,122.72,123.02,"sunn"],[27,30,123.02,123.56,"mat"],[31,33,123.92,124.24,"og"],[34,39,124.24,124.78,"unngå"],[40,41,124.78,124.9,"å~0583da7a620a"],[42,47,124.9,125.36,"spise"],[48,51,125.36,125.6,"for~79c080957b12"],[52,55,125.6,125.98,"mye~cc164d0dc3da"],[56,61,125.98,126.46,"usunn"],[62,65,126.46,126.89,"mat"]]},{"id":22,"start":127.65,"end":132.14,"text":"Vi kan legge på oss av å spise mat som inneholder mye sukker.","zh":"吃含糖多的食物会让我们长胖。","words":[[0,2,127.71,127.94,"vi"],[3,6,127.94,128.16,"kan"],[7,12,128.16,128.46,"legge~381bdd6d35ac"],[13,15,128.46,128.64,"på~9284de4ec9e2"],[16,19,128.64,129.14,"oss"],[20,22,129.14,129.3,"av~594cf435dcae"],[23,24,129.3,129.42,"å~0583da7a620a"],[25,30,129.42,129.9,"spise"],[31,34,129.9,130.3,"mat"],[35,38,130.3,130.66,"som~b7970b8f941e"],[39,49,130.66,131.24,"inneholder"],[50,53,131.24,131.56,"mye~cc164d0dc3da"],[54,60,131.56,131.99,"sukker"]]},{"id":23,"start":133.3,"end":136.12,"text":"Overvekt kan gi diabetes type 2.","zh":"超重可能导致2型糖尿病。","words":[[0,8,133.38,134.11,"overvekt"],[9,12,134.11,134.43,"kan"],[13,15,134.43,134.59,"gi~3f1ede00e5f2"],[16,24,134.59,134.93,"diabetes"],[25,29,134.93,135.51,"type"],[30,31,135.51,136.04,"2"]]},{"id":24,"start":136.71,"end":139.53,"text":"Det er sunt å spise grønnsaker og frukt.","zh":"吃蔬菜和水果有益健康。","words":[[0,3,136.77,136.92,"det"],[4,6,136.92,137.12,"er"],[7,11,137.12,137.7,"sunt"],[12,13,137.7,137.82,"å~0583da7a620a"],[14,19,137.82,138.24,"spise"],[20,30,138.24,138.82,"grønnsaker"],[31,33,138.82,138.92,"og"],[34,39,138.92,139.38,"frukt"]]},{"id":25,"start":140.02,"end":142.72,"text":"Vi bør spise grønnsaker og frukt hver dag.","zh":"我们应该每天吃蔬菜和水果。","words":[[0,2,140.08,140.3,"vi"],[3,6,140.3,140.58,"bør"],[7,12,140.58,140.92,"spise"],[13,23,140.92,141.46,"grønnsaker"],[24,26,141.46,141.56,"og"],[27,32,141.56,141.94,"frukt"],[33,37,141.94,142.2,"hver"],[38,41,142.2,142.56,"dag"]]},{"id":26,"start":144.31,"end":146.99,"text":"Vitamin D er viktig for kroppen.","zh":"维生素D对身体很重要。","words":[[0,7,144.38,144.96,"vitamin"],[8,9,144.96,145.24,"d"],[10,12,145.58,145.76,"er"],[13,19,145.76,146.1,"viktig"],[20,23,146.1,146.32,"for~da1a474a7e8c"],[24,31,146.32,146.84,"kroppen"]]},{"id":27,"start":147.62,"end":153.88,"text":"Vi får vitamin D fra sola, men fra oktober til april er ikke dette nok.","zh":"我们从阳光中获得维生素D，但从十月到四月，这样是不够的。","words":[[0,2,147.68,148.02,"vi"],[3,6,148.02,148.34,"får"],[7,14,148.34,148.88,"vitamin"],[15,16,148.88,149.12,"d"],[17,20,149.12,149.36,"fra"],[21,25,149.36,149.9,"sola"],[27,30,150.38,150.82,"men"],[31,34,150.82,151.12,"fra"],[35,42,151.12,151.82,"oktober"],[43,46,151.82,152.02,"til"],[47,52,152.02,152.58,"april"],[53,55,152.58,152.78,"er"],[56,60,152.78,152.98,"ikke"],[61,66,152.98,153.32,"dette"],[67,70,153.32,153.72,"nok~55c4175c2203"]]},{"id":28,"start":154.31,"end":157.78,"text":"Da er det mindre sol i Norge enn i sydligere land.","zh":"那时挪威的阳光比更南边的国家少。","words":[[0,2,154.38,154.56,"da~c65388b29f33"],[3,5,154.56,154.66,"er"],[6,9,154.66,154.84,"det"],[10,16,154.84,155.3,"mindre~99178d8f8bd2"],[17,20,155.3,155.7,"sol"],[21,22,155.7,155.8,"i"],[23,28,155.8,156.38,"norge~546b56e35dd5"],[29,32,156.38,156.62,"enn"],[33,34,156.62,156.74,"i"],[35,44,156.74,157.34,"sydligere"],[45,49,157.34,157.63,"land"]]},{"id":29,"start":158.57,"end":165.4,"text":"Om vinteren bør vi ta tran og spise fet fisk, for det er ikke vitamin D i frukt og grønnsaker.","zh":"冬天我们应该吃鱼肝油和多脂鱼，因为水果和蔬菜里没有维生素D。","words":[[0,2,158.63,158.84,"om~1e753acc270b"],[3,11,158.84,159.48,"vinteren"],[12,15,159.48,159.66,"bør"],[16,18,159.66,159.78,"vi"],[19,21,159.78,159.98,"ta~abc243e161c2"],[22,26,159.98,160.56,"tran"],[27,29,160.7,160.82,"og"],[30,35,160.82,161.2,"spise"],[36,39,161.2,161.56,"fet"],[40,44,161.56,162.16,"fisk"],[46,49,162.42,162.52,"for~1b22712a94b1"],[50,53,162.52,162.64,"det"],[54,56,162.64,162.8,"er"],[57,61,162.8,163.1,"ikke"],[62,69,163.1,163.62,"vitamin"],[70,71,163.62,163.96,"d"],[72,73,163.96,164.08,"i"],[74,79,164.08,164.44,"frukt"],[80,82,164.44,164.54,"og"],[83,93,164.54,165.25,"grønnsaker"]]}],"lexicon":{"12.4":{"lemma":"12.4","zh":"第 12.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"2":{"lemma":"2","zh":"数字 2","pos":"数词","ref":"basics:numbers:to","clip":null,"kind":"number"},"aldri":{"lemma":"aldri","zh":"从不；从来没有","pos":"副词","ref":"basics:grammar:aldri","clip":"pronunciation/d1f5a7278af42576f5dd.mp3"},"april":{"lemma":"april","zh":"四月","pos":"名词","ref":"2-025","clip":"pronunciation/aa6890829510931f9593.mp3"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos"