{"id":"12.4","title":"Vi må prøve å spise sunt","audio":"audio/12.4.mp3","duration":168.58,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.6,"text":"12.4 Vi må prøve å spise sunt","heading":true,"zh":"12.4 我们得尽量吃得健康","words":[[0,4,0.15,1.08,"12.4"],[5,7,1.9,2.4,"vi"],[8,10,2.4,2.6,"må"],[11,16,2.6,3.12,"prøve~c94a9af46ffc"],[17,18,3.12,3.34,"å~0583da7a620a"],[19,24,3.34,3.86,"spise"],[25,29,3.86,4.52,"sunt"]]},{"id":1,"start":6.44,"end":10.04,"text":"Marit og Håvard har vært på joggetur sammen.","zh":"玛丽特和霍瓦尔一起去慢跑了。","words":[[0,5,6.52,7.13,"marit"],[6,8,7.13,7.23,"og"],[9,15,7.23,7.73,"håvard"],[16,19,7.73,8.37,"har~8b9792170cca"],[20,24,8.37,8.57,"vært"],[25,27,8.57,8.77,"på~f36e9b6d216b"],[28,36,8.77,9.39,"joggetur"],[37,43,9.39,9.96,"sammen"]]},{"id":2,"start":11.2,"end":14.98,"text":"Nå har de dusjet, og Håvard er kjempesulten.","zh":"现在他们洗完了澡，霍瓦尔饿极了。","words":[[0,2,11.28,11.55,"nå~d531d47a7712"],[3,6,11.55,11.77,"har~8b9792170cca"],[7,9,11.77,11.89,"de"],[10,16,11.89,12.27,"dusjet"],[18,20,12.95,13.09,"og"],[21,27,13.09,13.55,"håvard"],[28,30,13.55,13.83,"er"],[31,43,13.83,14.9,"kjempesulten"]]},{"id":3,"start":16.7,"end":25.17,"text":"Skal vi bestille en pizza? Jeg er både sliten og sulten. Jeg orker ikke å lage middag nå.","speaker":"Håvard","zh":"我们点个披萨吧？我又累又饿。我现在没力气做晚饭。","words":[[0,4,16.78,17.24,"skal"],[5,7,17.24,17.44,"vi"],[8,16,17.44,17.9,"bestille"],[17,19,17.9,18.08,"en~a939a9e56dc5"],[20,25,18.08,18.3,"pizza"],[27,30,19.63,20.01,"jeg"],[31,33,20.01,20.19,"er"],[34,38,20.19,20.39,"både"],[39,45,20.39,21.13,"sliten"],[46,48,21.13,21.53,"og"],[49,55,21.53,22.01,"sulten"],[57,60,22.87,23.27,"jeg"],[61,66,23.27,23.73,"orker"],[67,71,23.73,23.89,"ikke"],[72,73,23.89,23.99,"å~0583da7a620a"],[74,78,23.99,24.21,"lage"],[79,85,24.21,24.67,"middag"],[86,88,24.67,25.09,"nå~d531d47a7712"]]},{"id":4,"start":26.34,"end":35.2,"text":"Jeg synes at vi skal prøve å spise sunnere. Det er usunt med pizza. Jeg kan lage gulrotsuppe med hjemmelagde grove rundstykker.","speaker":"Marit","zh":"我觉得我们应该尽量吃得健康一点。吃披萨不健康。我可以做胡萝卜汤，配自制的粗粮小面包。","words":[[0,3,26.42,26.69,"jeg"],[4,9,26.69,26.97,"synes"],[10,12,26.97,27.11,"at"],[13,15,27.11,27.23,"vi"],[16,20,27.23,27.39,"skal"],[21,26,27.39,27.67,"prøve~c94a9af46ffc"],[27,28,27.67,27.81,"å~0583da7a620a"],[29,34,27.81,28.15,"spise"],[35,42,28.15,28.67,"sunnere~6142cf103dc8"],[44,47,29.35,29.55,"det"],[48,50,29.55,29.61,"er"],[51,56,29.61,30.11,"usunt"],[57,60,30.11,30.29,"med~af5b33d8592a"],[61,66,30.29,30.53,"pizza"],[68,71,31.27,31.65,"jeg"],[72,75,31.65,31.81,"kan"],[76,80,31.81,32.05,"lage"],[81,92,32.05,33.07,"gulrotsuppe"],[93,96,33.07,33.25,"med~9c3bed5a2e37"],[97,108,33.25,33.97,"hjemmelagde"],[109,114,34.09,34.41,"grove"],[115,126,34.41,35.12,"rundstykker"]]},{"id":5,"start":35.27,"end":38.23,"text":"Jeg blir aldri mett av suppe.","speaker":"Håvard","zh":"我喝汤从来喝不饱。","words":[[0,3,35.66,36.6,"jeg"],[4,8,36.6,36.92,"blir"],[9,14,36.92,37.46,"aldri"],[15,19,37.46,37.7,"mett"],[20,22,37.7,37.94,"av~74a5dcf34271"],[23,28,37.94,38.15,"suppe"]]},{"id":6,"start":39.45,"end":41.67,"text":"Jeg tror at du blir mett av denne suppa.","speaker":"Marit","zh":"我相信这汤能让你吃饱。","words":[[0,3,39.53,39.64,"jeg"],[4,8,39.64,39.92,"tror"],[9,11,39.92,40.14,"at"],[12,14,40.14,40.24,"du"],[15,19,40.24,40.36,"blir"],[20,24,40.36,40.7,"mett"],[25,27,40.7,40.86,"av~74a5dcf34271"],[28,33,40.86,41.16,"denne"],[34,39,41.16,41.59,"suppa"]]},{"id":7,"start":43.59,"end":47.29,"text":"Marit og Håvard sitter ved bordet og spiser.","zh":"玛丽特和霍瓦尔坐在桌旁吃饭。","words":[[0,5,43.67,44.28,"marit"],[6,8,44.28,44.52,"og"],[9,15,44.52,45.02,"håvard"],[16,22,45.02,45.62,"sitter"],[23,26,45.62,45.94,"ved"],[27,33,45.94,46.38,"bordet"],[34,36,46.38,46.6,"og"],[37,43,46.6,47.21,"spiser"]]},{"id":8,"start":48.75,"end":51.1,"text":"Hva synes du? Er suppa god?","speaker":"Marit","zh":"你觉得怎么样？汤好喝吗？","words":[[0,3,48.83,48.97,"hva"],[4,9,48.97,49.21,"synes"],[10,12,49.21,49.43,"du"],[14,16,50.09,50.33,"er"],[17,22,50.33,50.61,"suppa"],[23,26,50.61,51.02,"god~661d53956419"]]},{"id":9,"start":51.25,"end":59.49,"text":"Mm, og disse rundstykkene er også veldig gode. Jeg tar ett til. Au!","speaker":"Håvard","zh":"嗯，这些小面包也非常好吃。我再拿一个。哎哟！","words":[[0,2,51.61,52.27,"mm"],[4,6,53.2,53.6,"og"],[7,12,53.6,53.84,"disse"],[13,25,53.84,54.42,"rundstykkene"],[26,28,54.42,54.54,"er"],[29,33,54.54,54.72,"også"],[34,40,54.72,55.06,"veldig"],[41,45,55.06,55.3,"gode~8f382b67505d"],[47,50,56.52,56.9,"jeg"],[51,54,57.08,57.16,"tar"],[55,58,57.16,57.32,"ett"],[59,62,57.32,57.47,"til~0abfbafc9c23"],[64,66,58.46,59.41,"au"]]},{"id":10,"start":59.59,"end":61.08,"text":"Hva skjedde?","speaker":"Marit","zh":"怎么了？","words":[[0,3,59.86,60.48,"hva"],[4,11,60.48,61.0,"skjedde"]]},{"id":11,"start":61.99,"end":74.88,"text":"Jeg fikk så vondt i ei tann. Jeg må ringe tannlegen, for jeg tror at tanna er ødelagt. Det gjør så vondt. Jeg håper at jeg får time i morgen.","speaker":"Håvard","zh":"我一颗牙疼得厉害。我得给牙医打电话，因为我觉得那颗牙坏了。太疼了。希望明天能约上时间。","words":[[0,3,62.07,62.22,"jeg"],[4,8,62.22,62.52,"fikk~c6d22aeb7bd1"],[9,11,62.52,62.8,"så~f85fae793184"],[12,17,62.8,63.18,"vondt"],[18,19,63.18,63.28,"i"],[20,22,63.28,63.48,"ei~47aa2d18e376"],[23,27,63.48,63.68,"tann"],[29,32,65.09,65.45,"jeg"],[33,35,65.45,65.59,"må"],[36,41,65.59,65.87,"ringe"],[42,51,66.11,66.47,"tannlegen"],[53,56,67.27,67.47,"for~1b22712a94b1"],[57,60,67.47,67.57,"jeg"],[61,65,67.57,67.75,"tror"],[66,68,67.75,67.95,"at"],[69,74,67.95,68.19,"tanna"],[75,77,68.19,68.43,"er"],[78,85,68.43,69.15,"ødelagt"],[87,90,70.29,70.47,"det"],[91,95,70.47,70.73,"gjør~1b092add2921"],[96,98,70.73,71.03,"så~25c4a3a832be"],[99,104,71.03,71.85,"vondt"],[106,109,72.67,72.87,"jeg"],[110,115,72.87,73.19,"håper"],[116,118,73.19,73.37,"at"],[119,122,73.37,73.47,"jeg"],[123,126,73.47,73.61,"får~939872ac59d0"],[127,131,73.61,73.95,"time~5959e4e2d751"],[132,133,73.95,74.17,"i~4f108c27c9d2"],[134,140,74.17,74.8,"morgen~709e4ceb9c48"]]},{"id":12,"start":78.55,"end":79.58,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,78.63,79.5,"sammendrag"]]},{"id":13,"start":80.81,"end":86.63,"text":"Marit og Håvard har vært på den første joggeturen sammen, og nå skal de spise middag.","zh":"玛丽特和霍瓦尔一起进行了第一次慢跑，现在他们要吃晚饭了。","words":[[0,5,80.89,81.36,"marit"],[6,8,81.36,81.54,"og"],[9,15,81.54,81.98,"håvard"],[16,19,81.98,82.2,"har~8b9792170cca"],[20,24,82.2,82.42,"vært"],[25,27,82.42,82.68,"på~f36e9b6d216b"],[28,31,82.68,82.84,"den~5f413bef0ba1"],[32,38,82.84,83.22,"første"],[39,49,83.22,83.76,"joggeturen"],[50,56,83.76,84.26,"sammen"],[58,60,84.88,85.0,"og"],[61,63,85.0,85.28,"nå~d531d47a7712"],[64,68,85.28,85.6,"skal"],[69,71,85.6,85.78,"de"],[72,77,85.78,86.08,"spise"],[78,84,86.08,86.55,"middag"]]},{"id":14,"start":87.53,"end":93.17,"text":"Håvard spør om de skal bestille en pizza, men Marit vil lage sunn mat.","zh":"霍瓦尔问要不要点披萨，但玛丽特想做健康的饭菜。","words":[[0,6,87.61,88.1,"håvard"],[7,11,88.1,88.48,"spør"],[12,14,88.48,88.86,"om~744a29d3d900"],[15,17,88.86,89.02,"de"],[18,22,89.02,89.24,"skal"],[23,31,89.24,89.68,"bestille"],[32,34,89.68,89.86,"en~a939a9e56dc5"],[35,40,89.86,90.12,"pizza"],[42,45,90.84,91.04,"men"],[46,51,91.04,91.62,"marit"],[52,55,91.62,91.92,"vil"],[56,60,91.92,92.16,"lage"],[61,65,92.16,92.56,"sunn"],[66,69,92.56,93.09,"mat"]]},{"id":15,"start":93.17,"end":97.69,"text":"De spiser gulrotsuppe med hjemmelagde rundstykker.","zh":"他们吃胡萝卜汤配自制小面包。","words":[[0,2,93.58,94.26,"de"],[3,9,94.26,94.74,"spiser"],[10,21,94.74,95.8,"gulrotsuppe"],[22,25,95.8,96.04,"med"],[26,37,96.04,96.84,"hjemmelagde"],[38,49,96.84,97.61,"rundstykker"]]},{"id":16,"start":98.74,"end":103.29,"text":"Håvard synes at suppa er god, og han spiser mange rundstykker.","zh":"霍瓦尔觉得汤很好喝，他吃了很多小面包。","words":[[0,6,98.82,99.31,"håvard"],[7,12,99.31,99.87,"synes"],[13,15,99.87,100.11,"at"],[16,21,100.11,100.41,"suppa"],[22,24,100.41,100.57,"er"],[25,28,100.57,100.81,"god~661d53956419"],[30,32,101.05,101.45,"og"],[33,36,101.45,101.61,"han"],[37,43,101.61,102.05,"spiser"],[44,49,102.05,102.43,"mange"],[50,61,102.43,103.21,"rundstykker"]]},{"id":17,"start":104.34,"end":107.01,"text":"Plutselig får Håvard vondt i ei tann.","zh":"突然霍瓦尔有一颗牙疼了起来。","words":[[0,9,104.42,104.94,"plutselig"],[10,13,104.94,105.18,"får~5af6e866825f"],[14,20,105.18,105.74,"håvard"],[21,26,105.74,106.18,"vondt"],[27,28,106.18,106.3,"i"],[29,31,106.3,106.48,"ei~47aa2d18e376"],[32,36,106.51,106.93,"tann"]]},{"id":18,"start":107.62,"end":112.87,"text":"Han tror at tanna er ødelagt, og sier at han må ringe tannlegen.","zh":"他觉得牙坏了，说他得给牙医打电话。","words":[[0,3,107.7,108.03,"han"],[4,8,108.03,108.44,"tror"],[9,11,108.44,108.78,"at"],[12,17,108.78,109.2,"tanna"],[18,20,109.2,109.48,"er"],[21,28,109.48,110.08,"ødelagt"],[30,32,110.32,110.78,"og"],[33,37,110.78,111.08,"sier"],[38,40,111.08,111.28,"at"],[41,44,111.28,111.5,"han"],[45,47,111.5,111.66,"må"],[48,53,111.66,111.96,"ringe"],[54,63,111.96,112.79,"tannlegen"]]},{"id":19,"start":116.11,"end":116.86,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,116.19,116.78,"fakta"]]},{"id":20,"start":118.01,"end":119.22,"text":"Spiser du sunt?","subheading":true,"zh":"你吃得健康吗？","words":[[0,6,118.09,118.61,"spiser"],[7,9,118.61,118.79,"du"],[10,14,118.79,119.14,"sunt"]]},{"id":21,"start":120.81,"end":126.98,"text":"Det er viktig å spise sunn mat og unngå å spise for mye usunn mat.","zh":"吃健康的食物、避免吃太多不健康的食物很重要。","words":[[0,3,120.89,121.29,"det"],[4,6,121.29,121.57,"er"],[7,13,121.57,121.95,"viktig"],[14,15,121.95,122.23,"å~0583da7a620a"],[16,21,122.23,122.63,"spise"],[22,26,122.63,122.97,"sunn"],[27,30,122.97,123.23,"mat"],[31,33,123.69,124.13,"og"],[34,39,124.13,124.65,"unngå"],[40,41,124.65,124.87,"å~0583da7a620a"],[42,47,124.87,125.29,"spise"],[48,51,125.29,125.53,"for~79c080957b12"],[52,55,125.53,125.85,"mye~cc164d0dc3da"],[56,61,125.85,126.35,"usunn"],[62,65,126.35,126.9,"mat"]]},{"id":22,"start":127.61,"end":132.09,"text":"Vi kan legge på oss av å spise mat som inneholder mye sukker.","zh":"吃含糖多的食物会让我们长胖。","words":[[0,2,127.69,127.87,"vi"],[3,6,127.87,128.05,"kan"],[7,12,128.05,128.37,"legge~381bdd6d35ac"],[13,15,128.37,128.59,"på~9284de4ec9e2"],[16,19,128.59,128.87,"oss"],[20,22,128.87,129.25,"av~594cf435dcae"],[23,24,129.25,129.39,"å~0583da7a620a"],[25,30,129.39,129.77,"spise"],[31,34,129.77,130.13,"mat"],[35,38,130.13,130.51,"som~b7970b8f941e"],[39,49,130.51,131.01,"inneholder"],[50,53,131.01,131.47,"mye~cc164d0dc3da"],[54,60,131.47,132.01,"sukker"]]},{"id":23,"start":133.3,"end":136.12,"text":"Overvekt kan gi diabetes type 2.","zh":"超重可能导致2型糖尿病。","words":[[0,8,133.38,134.11,"overvekt"],[9,12,134.11,134.43,"kan"],[13,15,134.43,134.59,"gi~3f1ede00e5f2"],[16,24,134.59,134.93,"diabetes"],[25,29,134.93,135.51,"type"],[30,31,135.51,136.04,"2"]]},{"id":24,"start":136.71,"end":139.48,"text":"Det er sunt å spise grønnsaker og frukt.","zh":"吃蔬菜和水果有益健康。","words":[[0,3,136.79,136.91,"det"],[4,6,136.91,137.03,"er"],[7,11,137.03,137.43,"sunt"],[12,13,137.43,137.77,"å~0583da7a620a"],[14,19,137.77,138.15,"spise"],[20,30,138.15,138.69,"grønnsaker"],[31,33,138.69,138.87,"og"],[34,39,138.87,139.41,"frukt"]]},{"id":25,"start":139.99,"end":142.75,"text":"Vi bør spise grønnsaker og frukt hver dag.","zh":"我们应该每天吃蔬菜和水果。","words":[[0,2,140.07,140.23,"vi"],[3,6,140.23,140.49,"bør"],[7,12,140.49,140.87,"spise"],[13,23,140.87,141.29,"grønnsaker"],[24,26,141.29,141.51,"og"],[27,32,141.51,141.79,"frukt"],[33,37,141.79,142.15,"hver"],[38,41,142.15,142.67,"dag"]]},{"id":26,"start":144.28,"end":146.93,"text":"Vitamin D er viktig for kroppen.","zh":"维生素D对身体很重要。","words":[[0,7,144.36,144.76,"vitamin"],[8,9,144.76,145.16,"d"],[10,12,145.16,145.68,"er"],[13,19,145.68,146.02,"viktig"],[20,23,146.02,146.24,"for~da1a474a7e8c"],[24,31,146.24,146.85,"kroppen"]]},{"id":27,"start":147.59,"end":153.56,"text":"Vi får vitamin D fra sola, men fra oktober til april er ikke dette nok.","zh":"我们从阳光中获得维生素D，但从十月到四月，这样是不够的。","words":[[0,2,147.67,147.92,"vi"],[3,6,147.92,148.2,"får"],[7,14,148.2,148.6,"vitamin"],[15,16,148.6,149.0,"d"],[17,20,149.0,149.26,"fra"],[21,25,149.26,149.7,"sola"],[27,30,150.09,150.59,"men"],[31,34,150.59,150.95,"fra"],[35,42,150.95,151.63,"oktober"],[43,46,151.63,151.95,"til"],[47,52,151.95,152.47,"april"],[53,55,152.47,152.73,"er"],[56,60,152.73,152.91,"ikke"],[61,66,152.91,153.13,"dette"],[67,70,153.13,153.48,"nok~55c4175c2203"]]},{"id":28,"start":154.3,"end":157.78,"text":"Da er det mindre sol i Norge enn i sydligere land.","zh":"那时挪威的阳光比更南边的国家少。","words":[[0,2,154.38,154.5,"da~c65388b29f33"],[3,5,154.5,154.64,"er"],[6,9,154.64,154.76,"det"],[10,16,154.76,155.22,"mindre~99178d8f8bd2"],[17,20,155.22,155.54,"sol"],[21,22,155.54,155.76,"i"],[23,28,155.76,156.22,"norge~546b56e35dd5"],[29,32,156.22,156.56,"enn"],[33,34,156.56,156.7,"i"],[35,44,156.7,157.28,"sydligere"],[45,49,157.28,157.7,"land"]]},{"id":29,"start":158.54,"end":165.34,"text":"Om vinteren bør vi ta tran og spise fet fisk, for det er ikke vitamin D i frukt og grønnsaker.","zh":"冬天我们应该吃鱼肝油和多脂鱼，因为水果和蔬菜里没有维生素D。","words":[[0,2,158.62,158.77,"om~1e753acc270b"],[3,11,158.77,159.41,"vinteren"],[12,15,159.41,159.59,"bør"],[16,18,159.59,159.73,"vi"],[19,21,159.73,159.87,"ta~abc243e161c2"],[22,26,159.87,160.25,"tran"],[27,29,160.25,160.75,"og"],[30,35,160.75,161.09,"spise"],[36,39,161.09,161.37,"fet"],[40,44,161.37,161.95,"fisk"],[46,49,162.41,162.51,"for~1b22712a94b1"],[50,53,162.51,162.63,"det"],[54,56,162.63,162.73,"er"],[57,61,162.73,162.99,"ikke"],[62,69,162.99,163.39,"vitamin"],[70,71,163.39,163.75,"d"],[72,73,163.75,164.03,"i"],[74,79,164.03,164.33,"frukt"],[80,82,164.33,164.51,"og"],[83,93,164.51,165.26,"grønnsaker"]]}],"lexicon":{"12.4":{"lemma":"12.4","zh":"第 12.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"2":{"lemma":"2","zh":"数字 2","pos":"数词","ref":"basics:numbers:to","clip":null,"kind":"number"},"aldri":{"lemma":"aldri","zh":"从不；从来没有","pos":"副词","ref":"basics:grammar:aldri","clip":"pronunciation/d1f5a7278af42576f5dd.mp3"},"april":{"lemma":"april","zh":"四月","pos":"名词","ref":"2-025","clip":"pronunciation/a