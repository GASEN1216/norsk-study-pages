{"id":"pa-vei-7.B","bookId":"pa-vei-textbook","readingId":"7.B","title":"I skobutikken","audio":"audio/pa-vei/7.B.mp3","duration":100.68,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.1,"end":4.545,"text":"B. I skobutikken","zh":"B. 在鞋店","words":[[0,1,2.1,2.66,"b"],[3,4,3.56,3.665,"i"],[5,16,3.76,4.545,"skobutikken"]]},{"id":1,"start":6.36,"end":7.385,"text":"Kan jeg hjelpe dere?","zh":"需要帮忙吗？","words":[[0,3,6.36,6.565,"kan"],[4,7,6.58,6.745,"jeg"],[8,14,6.76,7.112,"hjelpe"],[15,19,7.112,7.385,"dere"]],"speaker":"Selger"},{"id":2,"start":8.38,"end":9.625,"text":"Jeg skal ha nye sko.","zh":"我要买新鞋。","words":[[0,3,8.38,8.582,"jeg"],[4,8,8.582,8.845,"skal"],[9,11,8.86,9.005,"ha"],[12,15,9.06,9.385,"nye"],[16,19,9.4,9.625,"sko"]],"speaker":"Emma"},{"id":3,"start":10.8,"end":12.265,"text":"Hva slags sko vil du ha?","zh":"你想要什么样的鞋？","words":[[0,3,10.8,10.985,"hva"],[4,9,11.04,11.405,"slags"],[10,13,11.52,11.745,"sko"],[14,17,11.82,11.982,"vil"],[18,20,11.982,12.123,"du"],[21,23,12.123,12.265,"ha"]],"speaker":"Selger"},{"id":4,"start":13.42,"end":14.545,"text":"Jeg vil ha fine sko.","zh":"我想要漂亮的鞋。","words":[[0,3,13.42,13.562,"jeg"],[4,7,13.562,13.703,"vil"],[8,10,13.703,13.845,"ha"],[11,15,13.9,14.285,"fine"],[16,19,14.32,14.545,"sko"]],"speaker":"Emma"},{"id":5,"start":15.22,"end":17.445,"text":"Jeg skal i bursdagsselskap i morgen.","zh":"我明天要参加生日聚会。","words":[[0,3,15.22,15.373,"jeg"],[4,8,15.373,15.585,"skal"],[9,10,15.66,15.765,"i"],[11,26,15.78,16.845,"bursdagsselskap"],[27,28,16.9,17.002,"i"],[29,35,17.002,17.445,"morgen"]],"speaker":"Emma"},{"id":6,"start":18.566,"end":19.931,"text":"Hvilken størrelse bruker du?","zh":"你穿多大码的？","words":[[0,7,18.566,18.951,"hvilken"],[8,17,18.966,19.498,"størrelse"],[18,24,19.498,19.809,"bruker"],[25,27,19.809,19.931,"du"]],"speaker":"Selger"},{"id":7,"start":21.166,"end":24.211,"text":"Pappa, hvilken størrelse bruker jeg?","zh":"爸爸，我穿多大码的？","words":[[0,5,21.166,21.591,"pappa"],[7,14,22.326,22.771,"hvilken"],[15,24,22.866,23.511,"størrelse"],[25,31,23.526,23.951,"bruker"],[32,35,23.966,24.211,"jeg"]],"speaker":"Emma"},{"id":8,"start":25.566,"end":26.551,"text":"Jeg er ikke sikker.","zh":"我不太确定。","words":[[0,3,25.566,25.728,"jeg"],[4,6,25.728,25.871,"er"],[7,11,25.906,26.129,"ikke"],[12,18,26.129,26.551,"sikker"]],"speaker":"Henrik"},{"id":9,"start":27.906,"end":28.911,"text":"Du kan prøve disse.","zh":"你可以试试这双。","words":[[0,2,27.906,28.048,"du"],[3,6,28.048,28.228,"kan"],[7,12,28.228,28.569,"prøve"],[13,18,28.569,28.911,"disse"]],"speaker":"Selger"},{"id":10,"start":29.786,"end":31.591,"text":"Jeg tror det er riktig størrelse.","zh":"我想这个尺码合适。","words":[[0,3,29.786,29.991,"jeg"],[4,8,30.106,30.538,"tror"],[9,12,30.538,30.669,"det"],[13,15,30.669,30.779,"er"],[16,22,30.779,31.089,"riktig"],[23,32,31.089,31.591,"størrelse"]],"speaker":"Selger"},{"id":11,"start":32.706,"end":34.231,"text":"Men de er hvite.","zh":"可是它们是白色的。","words":[[0,3,32.706,32.891,"men"],[4,6,32.966,33.111,"de"],[7,9,33.246,33.391,"er"],[10,15,33.526,34.231,"hvite"]],"speaker":"Emma"},{"id":12,"start":35.606,"end":36.771,"text":"Hvilken farge liker du?","zh":"你喜欢什么颜色？","words":[[0,7,35.606,35.951,"hvilken"],[8,13,35.966,36.359,"farge"],[14,19,36.359,36.648,"liker"],[20,22,36.648,36.771,"du"]],"speaker":"Selger"},{"id":13,"start":37.906,"end":41.351,"text":"Vil du ha svarte sko eller brune sko?","zh":"你想要黑鞋还是棕色的鞋？","words":[[0,3,37.906,38.049,"vil"],[4,6,38.049,38.159,"du"],[7,9,38.159,38.271,"ha"],[10,16,38.286,38.659,"svarte"],[17,20,38.659,38.851,"sko"],[21,26,39.986,40.291,"eller"],[27,32,40.746,41.169,"brune"],[33,36,41.169,41.351,"sko"]],"speaker":"Selger"},{"id":14,"start":43.146,"end":44.931,"text":"Nei, jeg vet ikke, jeg ...","zh":"不，我不知道，我……","words":[[0,3,43.146,43.491,"nei"],[5,8,43.886,44.071,"jeg"],[9,12,44.086,44.439,"vet"],[13,17,44.439,44.659,"ikke"],[19,22,44.659,44.931,"jeg"]],"speaker":"Emma"},{"id":15,"start":47.406,"end":49.691,"text":"Emma, nå må du bestemme deg.","zh":"埃玛，你现在得拿定主意了。","words":[[0,4,47.406,47.691,"emma"],[6,8,48.586,48.711,"nå"],[9,11,48.726,48.849,"må"],[12,14,48.849,48.991,"du"],[15,23,49.006,49.519,"bestemme"],[24,27,49.519,49.691,"deg"]],"speaker":"Henrik"},{"id":16,"start":50.466,"end":51.011,"text":"Jeg vil hjem.","zh":"我想回家。","words":[[0,3,50.466,50.618,"jeg"],[4,7,50.618,50.771,"vil"],[8,12,50.786,51.011,"hjem"]],"speaker":"Henrik"},{"id":17,"start":52.866,"end":54.351,"text":"Jeg har lyst på røde sko.","zh":"我想要红鞋。","words":[[0,3,52.866,53.049,"jeg"],[4,7,53.049,53.211,"har"],[8,12,53.226,53.498,"lyst@pa-vei-lyst-desire"],[13,15,53.498,53.631,"på"],[16,20,53.646,54.051,"røde"],[21,24,54.066,54.351,"sko"]],"speaker":"Emma"},{"id":18,"start":55.286,"end":56.551,"text":"Julie har røde sko.","zh":"尤莉有红鞋。","words":[[0,5,55.286,55.791,"julie"],[6,9,55.826,55.978,"har"],[10,14,55.978,56.271,"røde"],[15,18,56.306,56.551,"sko"]],"speaker":"Emma"},{"id":19,"start":57.826,"end":58.411,"text":"Hvem er det?","zh":"她是谁？","words":[[0,4,57.826,58.051,"hvem"],[5,7,58.066,58.209,"er"],[8,11,58.209,58.411,"det"]],"speaker":"Henrik"},{"id":20,"start":59.626,"end":60.671,"text":"Ei jente i klassen.","zh":"班里的一个女孩。","words":[[0,2,59.626,59.771,"ei"],[3,8,59.806,60.178,"jente"],[9,10,60.178,60.258,"i"],[11,18,60.258,60.671,"klassen"]],"speaker":"Emma"},{"id":21,"start":62.086,"end":63.211,"text":"Har dere røde sko?","zh":"你们有红鞋吗？","words":[[0,3,62.086,62.258,"har"],[4,8,62.258,62.511,"dere"],[9,13,62.566,62.931,"røde"],[14,17,63.006,63.211,"sko"]],"speaker":"Henrik"},{"id":22,"start":64.926,"end":67.311,"text":"Ja, vi har et par der borte.","zh":"有，我们那边有一双。","words":[[0,2,64.926,65.091,"ja"],[4,6,66.106,66.228,"vi"],[7,10,66.228,66.428,"har"],[11,13,66.428,66.578,"et"],[14,17,66.578,66.811,"par"],[18,21,66.846,67.019,"der"],[22,27,67.019,67.311,"borte"]],"speaker":"Selger"},{"id":23,"start":68.726,"end":69.291,"text":"Vi tar dem.","zh":"我们买这双。","words":[[0,2,68.726,68.851,"vi"],[3,6,68.866,69.108,"tar"],[7,10,69.108,69.291,"dem"]],"speaker":"Henrik"},{"id":24,"start":70.746,"end":74.011,"text":"Men pappa, skal jeg ikke prøve dem først?","zh":"可是爸爸，我不先试一下吗？","words":[[0,3,70.746,70.951,"men"],[4,9,71.026,71.491,"pappa"],[11,15,72.206,72.451,"skal"],[16,19,72.486,72.648,"jeg"],[20,24,72.648,72.851,"ikke"],[25,30,72.866,73.258,"prøve"],[31,34,73.258,73.431,"dem"],[35,40,73.466,74.011,"først"]],"speaker":"Emma"},{"id":25,"start":75.106,"end":76.331,"text":"Jo, selvfølgelig.","zh":"对，当然要。","words":[[0,2,75.106,75.271,"jo"],[4,16,75.426,76.331,"selvfølgelig"]],"speaker":"Henrik"},{"id":26,"start":76.846,"end":77.491,"text":"Unnskyld!","zh":"不好意思！","words":[[0,8,76.846,77.491,"unnskyld"]],"speaker":"Henrik"},{"id":27,"start":79.976,"end":80.741,"text":"Sammendrag.","zh":"摘要","words":[[0,10,79.976,80.741,"sammendrag"]]},{"id":28,"start":82.196,"end":84.381,"text":"Emma og Henrik er i butikken.","zh":"埃玛和亨里克在商店里。","words":[[0,4,82.196,82.541,"emma"],[5,7,82.596,82.741,"og"],[8,14,82.756,83.381,"henrik"],[15,17,83.616,83.788,"er"],[18,19,83.788,83.888,"i"],[20,28,83.888,84.381,"butikken"]]},{"id":29,"start":85.796,"end":92.041,"text":"Der har de hvite, svarte og brune sko, men Emma har lyst på røde sko.","zh":"店里有白色、黑色和棕色的鞋，可埃玛想要红鞋。","words":[[0,3,85.796,85.999,"der"],[4,7,85.999,86.099,"har"],[8,10,86.099,86.221,"de"],[11,16,86.236,86.781,"hvite"],[18,24,87.256,87.801,"svarte"],[25,27,88.136,88.281,"og"],[28,33,88.336,88.801,"brune"],[34,37,88.816,89.021,"sko"],[39,42,90.036,90.221,"men"],[43,47,90.336,90.661,"emma"],[48,51,90.676,90.861,"har"],[52,56,90.876,91.201,"lyst@pa-vei-lyst-desire"],[57,59,91.216,91.361,"på"],[60,64,91.456,91.821,"røde"],[65,68,91.856,92.041,"sko"]]},{"id":30,"start":93.356,"end":95.301,"text":"Ei jente i klassen har røde sko.","zh":"班里的一个女孩有红鞋。","words":[[0,2,93.356,93.501,"ei"],[3,8,93.516,93.909,"jente"],[9,10,93.909,93.989,"i"],[11,18,93.989,94.461,"klassen"],[19,22,94.536,94.721,"har"],[23,27,94.736,95.061,"røde"],[28,31,95.096,95.301,"sko"]]},{"id":31,"start":96.976,"end":98.881,"