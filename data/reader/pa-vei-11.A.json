{"id":"pa-vei-11.A","bookId":"pa-vei-textbook","readingId":"11.A","title":"Hvordan går det?","audio":"audio/pa-vei/11.A.mp3","duration":97.872,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.0,"end":3.085,"text":"Hei, Terje! Hvordan går det?","zh":"嗨，泰耶！你最近怎么样？","words":[[0,3,1.0,1.225,"hei"],[5,10,1.34,1.705,"terje"],[12,19,2.32,2.645,"hvordan"],[20,23,2.66,2.922,"går"],[24,27,2.922,3.085,"det"]],"speaker":"Michelle"},{"id":1,"start":4.0,"end":7.045,"text":"Elendig! Jeg føler meg ikke frisk.","zh":"糟透了！我觉得身体不舒服。","words":[[0,7,4.0,4.725,"elendig"],[9,12,5.54,5.725,"jeg"],[13,18,5.76,6.093,"føler"],[19,22,6.093,6.265,"meg"],[23,27,6.28,6.525,"ikke"],[28,33,6.54,7.045,"frisk"]],"speaker":"Terje"},{"id":2,"start":8.0,"end":10.3,"text":"Huff da, hva er i veien med deg?","zh":"哎呀，你怎么了？","words":[[0,4,8.0,8.345,"huff"],[5,7,8.38,8.505,"da"],[9,12,9.2,9.365,"hva"],[13,15,9.44,9.553,"er"],[16,17,9.553,9.602,"i"],[18,23,9.602,9.902,"veien"],[24,27,9.902,10.053,"med"],[28,31,10.08,10.3,"deg"]],"speaker":"Michelle"},{"id":3,"start":11.252,"end":13.437,"text":"Jeg er kvalm og har vondt i magen.","zh":"我恶心，肚子疼。","words":[[0,3,11.252,11.434,"jeg"],[4,6,11.434,11.577,"er"],[7,12,11.612,12.097,"kvalm"],[13,15,12.372,12.505,"og"],[16,19,12.505,12.655,"har"],[20,25,12.655,12.934,"vondt"],[26,27,12.934,13.034,"i"],[28,33,13.034,13.437,"magen"]],"speaker":"Terje"},{"id":4,"start":14.592,"end":17.297,"text":"Og så har jeg vondt i hodet og i halsen.","zh":"而且我头疼、嗓子疼。","words":[[0,2,14.592,14.694,"og"],[3,5,14.694,14.794,"så"],[6,9,14.794,14.915,"har"],[10,13,14.915,15.024,"jeg"],[14,19,15.024,15.274,"vondt"],[20,21,15.274,15.375,"i"],[22,27,15.375,15.837,"hodet"],[28,30,16.572,16.694,"og"],[31,32,16.694,16.797,"i"],[33,39,16.812,17.297,"halsen"]],"speaker":"Terje"},{"id":5,"start":18.312,"end":19.077,"text":"Har du feber?","zh":"你发烧了吗？","words":[[0,3,18.312,18.455,"har"],[4,6,18.455,18.557,"du"],[7,12,18.632,19.077,"feber"]],"speaker":"Michelle"},{"id":6,"start":20.092,"end":24.957,"text":"Det tror jeg. Minst 40. Og det verker i hele kroppen.","zh":"我想是的，至少 40 度。而且我浑身都疼。","words":[[0,3,20.092,20.277,"det"],[4,8,20.292,20.554,"tror"],[9,12,20.554,20.697,"jeg"],[14,19,21.432,21.797,"minst"],[20,22,21.852,22.297,"40"],[24,26,23.232,23.364,"og"],[27,30,23.364,23.497,"det"],[31,37,23.532,24.017,"verker"],[38,39,24.032,24.137,"i"],[40,44,24.152,24.537,"hele"],[45,52,24.552,24.957,"kroppen"]],"speaker":"Terje"},{"id":7,"start":25.892,"end":27.417,"text":"Da må du gå til legen.","zh":"那你得去看医生。","words":[[0,2,25.892,26.017,"da"],[3,5,26.112,26.257,"må"],[6,8,26.412,26.557,"du"],[9,11,26.572,26.717,"gå"],[12,15,26.792,26.965,"til"],[16,21,26.965,27.417,"legen"]],"speaker":"Michelle"},{"id":8,"start":28.492,"end":31.837,"text":"Vel ... Jeg var hos legen for to dager siden.","zh":"这个嘛……我两天前去看过医生。","words":[[0,3,28.492,28.737,"vel"],[8,11,29.772,29.934,"jeg"],[12,15,29.934,30.135,"var"],[16,19,30.135,30.334,"hos"],[20,25,30.334,30.777,"legen"],[26,29,30.812,30.974,"for"],[30,32,30.974,31.117,"to"],[33,38,31.152,31.505,"dager"],[39,44,31.505,31.837,"siden"]],"speaker":"Terje"},{"id":9,"start":32.892,"end":33.477,"text":"Hva sa han?","zh":"他说了什么？","words":[[0,3,32.892,33.057,"hva"],[4,6,33.092,33.257,"sa"],[7,10,33.292,33.477,"han"]],"speaker":"Michelle"},{"id":10,"start":34.792,"end":39.137,"text":"Jeg fikk ikke noe medisin. Hun sa at jeg var litt forkjølet.","zh":"我什么药也没拿到。她说我有点感冒。","words":[[0,3,34.792,34.957,"jeg"],[4,8,34.972,35.245,"fikk"],[9,13,35.245,35.497,"ikke"],[14,17,35.532,35.757,"noe"],[18,25,35.772,36.377,"medisin"],[27,30,37.392,37.577,"hun"],[31,33,37.652,37.817,"sa"],[34,36,37.892,38.025,"at"],[37,40,38.025,38.165,"jeg"],[41,44,38.165,38.284,"var"],[45,49,38.284,38.504,"litt"],[50,59,38.504,39.137,"forkjølet"]],"speaker":"Terje"},{"id":11,"start":40.112,"end":41.857,"text":"Men nå skal jeg bestille ny time.","zh":"不过现在我要重新预约。","words":[[0,3,40.112,40.277,"men"],[4,6,40.292,40.417,"nå"],[7,11,40.492,40.665,"skal"],[12,15,40.665,40.794,"jeg"],[16,24,40.794,41.217,"bestille"],[25,27,41.252,41.397,"ny"],[28,32,41.472,41.857,"time"]],"speaker":"Terje"},{"id":12,"start":42.952,"end":47.277,"text":"Jeg får ikke sove om natta. Kanskje jeg bør dra til legevakta.","zh":"我晚上睡不着。也许我应该去急诊诊所。","words":[[0,3,42.952,43.117,"jeg"],[4,7,43.152,43.385,"får"],[8,12,43.385,43.617,"ikke"],[13,17,43.652,44.055,"sove"],[18,20,44.055,44.175,"om"],[21,26,44.175,44.497,"natta"],[28,35,45.672,46.035,"kanskje"],[36,39,46.035,46.154,"jeg"],[40,43,46.154,46.264,"bør"],[44,47,46.264,46.417,"dra"],[48,51,46.452,46.614,"til"],[52,61,46.614,47.277,"legevakta"]],"speaker":"Terje"},{"id":13,"start":48.352,"end":50.197,"text":"Ja, ja. God bedring!","zh":"好吧，好吧。祝你早日康复！","words":[[0,2,48.352,48.517,"ja"],[4,6,48.612,48.777,"ja"],[8,11,49.452,49.675,"god"],[12,19,49.675,50.197,"bedring"]],"speaker":"Michelle"},{"id":14,"start":51.092,"end":52.557,"text":"Takk. Ha det!","zh":"谢谢。再见！","words":[[0,4,51.092,51.397,"takk"],[6,8,52.192,52.337,"ha"],[9,12,52.372,52.557,"det"]],"speaker":"Terje"},{"id":15,"start":53.192,"end":53.577,"text":"Ha det!","zh":"再见！","words":[[0,2,53.192,53.337,"ha"],[3,6,53.392,53.577,"det"]],"speaker":"Michelle"},{"id":16,"start":55.172,"end":58.017,"text":"Puh! Neste gang sier jeg bare hei!","zh":"呼！下次我只说声你好就算了！","words":[[0,3,55.172,55.377,"puh"],[5,10,56.272,56.635,"neste"],[11,15,56.635,56.877,"gang"],[16,20,56.912,57.174,"sier"],[21,24,57.174,57.297,"jeg"],[25,29,57.332,57.697,"bare"],[30,33,57.792,58.017,"hei"]],"speaker":"Michelle"},{"id":17,"start":61.312,"end":62.037,"text":"Sammendrag.","zh":"摘要","words":[[0,10,61.312,62.037,"sammendrag"]]},{"id":18,"start":63.872,"end":68.177,"text":"Michelle møter Terje, en ung mann i nabolaget.","zh":"米歇尔遇见了住在附近的年轻人泰耶。","words":[[0,8,63.872,64.457,"michelle"],[9,14,64.652,65.217,"møter"],[15,20,65.352,65.797,"terje"],[22,24,66.552,66.697,"en"],[25,28,66.832,67.097,"ung"],[29,33,67.132,67.417,"mann"],[34,35,67.472,67.575,"i"],[36,45,67.575,68.177,"nabolaget"]]},{"id":19,"start":69.852,"end":75.617,"text":"Han forteller at han føler seg syk, og at han er kvalm og har vondt i hele kroppen.","zh":"他说自己觉得不舒服，恶心，而且浑身疼。","words":[[0,3,69.852,70.037,"han"],[4,13,70.092,70.537,"forteller"],[14,16,70.572,70.695,"at"],[17,20,70.695,70.837,"han"],[21,26,70.852,71.165,"føler"],[27,30,71.165,71.337,"seg"],[31,34,71.512,71.997,"syk"],[36,38,72.532,72.674,"og"],[39,41,72.674,72.794,"at"],[42,45,72.794,72.934,"han"],[46,48,72.934,73.097,"er"],[49,54,73.152,73.657,"kvalm"],[55,57,73.932,74.054,"og"],[58,61,74.054,74.237,"har"],[62,67,74.292,74.717,"vondt"],[68,69,74.732,74.837,"i"],[70,74,74.852,75.215,"hele"],[75,82,75.215,75.617,"kroppen"]]},{"id":20,"start":77.052,"end":79.317,"text":"Han tror at han har 40 i feber.","zh":"他觉得自己发烧到 40 度了。","words":[[0,3,77.052,77.237,"han"],[4,8,77.272,77.635,"tror"],[9,11,77.635,77.755,"at"],[12,15,77.755,77.897,"han"],[16,19,77.912,78.157,"har"],[20,22,78.292,78.757,"40"],[23,24,78.832,78.937,"i"],[25,30,78.952,79.317,"feber"]]},{"id":21,"start":81.112,"end":83.337,"text":"Han var hos legen for noen dager siden.","zh":"他几天前去看过医生。","words":[[0,3,81.112,81.277,"han"],[4,7,81.292,81.517,"var"],[8,11,81.532,81.757,"hos"],[12,17,81.772,82.237,"legen"],[18,21,82.292,82.445,"for"],[22,26,82.445,82.674,"noen"],[27,32,82.674,83.005,"dager"],[33,38,83.005,83.337,"siden"]]},{"id":22,"start":84.472,"end":87.317,"text":"Men legen hans ga ham ikke noe medisin.","zh":"可是他的医生什么药也没给他。","words":[[0,3,84.472,84.637,"men"],[4,9,84.692,85.075,"legen"],[10,14,85.075,85.457,"hans"],[15,17,85.852,85.997,"ga"],[18,21,86.092,86.257,"ham"],[22,26,86.272,86.484,"ikke"],[27,30,86.484,86.697,"noe"],[31,38,86.712,87.317,"medisin"]]},{"id":23,"start":88.652,"end":90.817,"text":"Hun sa at han var litt forkjølet.","zh":"她说他有点感冒。","words":[[0,3,88.652,88.857,"hun"],[4,6,88.992,89.177,"sa"],[7,9,89.332,89.475,"at"],[10,13,89.475,89.617,"han"],[14,17,89.632,89.877,"var"],[18,22,89.892,90.124,"litt"],[23,32,90.124,90.817,"forkjølet"]]},{"id":24,"start":92.502,"end":95.107,"text":"Michelle synes at han klager for mye.","zh":"米歇尔觉得他抱怨得太多了。","words":[[0,8,92.502,93.124,"michelle"],[9,14,93.124,93.524,"synes"],[15,17,93.524,93.665,"at"],[18,21,93.665,93.807,"han"],[22,28,93.902,94.527,"klager"],[29,32,94.582,94.747,"for@pa-vei-for-excess"],[33,36,94.782,95.107,"mye"]]}],"lexicon":{"40":{"lemma":"40","pos":"数词","zh":"数字 40","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bedring":{"lemma":"bedring","zh":"康复（god bedring：祝早日康复）","pos":"名词","ref":null,"clip":null},"bestille":{"lemma":"bestille","pos":"动词","zh":"预订；订购","ref":null,"clip":null,"form":"不定式"},"bør":{"lemma":"burde","zh":"应该（burde 的现在时）","pos":"情态动词","ref":"pa-vei-7-088","form":"现在时","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"dager":{"lemma":"dag","pos":"名词","zh":"天；日子","form":"复数不定","ref":null,"clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dra":{"lemma":"dra","zh":"去；离开；拉","pos":"动词","ref":"6-023","form":"不定式","clip":null},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"elendig":{"lemma":"elendig","zh":"糟糕的；很差的","pos":"形容词","ref":"pa-vei-6-060","clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"feber":{"lemma":"feber","zh":"发烧","pos":"名词","ref":"ty-conversation-5-008","clip":null},"fikk":{"lemma":"få","zh":"得到；获得；可以（被允许）","pos":"动词","ref":"6-055","form":"过去时","clip":null},"for":{"lemma":"for","pos":"介词","zh":"为；对于；因为（依结构而定）","ref":null,"clip":null},"for@pa-vei-for-excess":{"lemma"