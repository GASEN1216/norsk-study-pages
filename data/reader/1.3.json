{"id":"1.3","title":"Nå bor jeg i Norge","audio":"audio/1.3.mp3","duration":213.47,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.97,"text":"1.3 Nå bor jeg i Norge","heading":true,"zh":"1.3 现在我住在挪威","words":[[0,3,0.15,1.17,"1.3"],[4,6,2.19,3.11,"nå~d531d47a7712"],[7,10,3.11,3.61,"bor"],[11,14,3.61,3.93,"jeg"],[15,16,3.93,4.29,"i"],[17,22,4.29,4.89,"norge~546b56e35dd5"]]},{"id":1,"start":10.04,"end":18.92,"text":"Jeg kommer fra Eritrea. Nå bor jeg i Norge. Og du, Sompit?","speaker":"Biniam","zh":"我来自厄立特里亚。现在我住在挪威。你呢，松皮特？","words":[[0,3,10.1,10.7,"jeg"],[4,10,10.86,11.5,"kommer"],[11,14,11.64,12.1,"fra"],[15,22,12.1,12.96,"eritrea"],[24,26,14.02,14.38,"nå~d531d47a7712"],[27,30,14.38,14.68,"bor"],[31,34,14.68,14.98,"jeg"],[35,36,14.98,15.2,"i"],[37,42,15.2,15.78,"norge~546b56e35dd5"],[44,46,17.1,17.34,"og"],[47,49,17.34,17.68,"du"],[51,57,18.16,18.77,"sompit"]]},{"id":2,"start":23.37,"end":32.51,"text":"Jeg kommer fra Thailand. Nå bor jeg i Norge. Hvor kommer du fra, Viola?","speaker":"Sompit","zh":"我来自泰国。现在我住在挪威。维奥拉，你从哪里来？","words":[[0,3,23.43,23.88,"jeg"],[4,10,23.88,24.38,"kommer"],[11,14,24.38,24.74,"fra"],[15,23,24.74,25.49,"thailand"],[25,27,26.58,26.89,"nå~d531d47a7712"],[28,31,27.34,27.68,"bor"],[32,35,27.68,28.14,"jeg"],[36,37,28.14,28.32,"i"],[38,43,28.32,28.88,"norge~546b56e35dd5"],[45,49,30.42,30.72,"hvor"],[50,56,30.72,31.08,"kommer"],[57,59,31.08,31.42,"du"],[60,63,31.42,31.79,"fra"],[65,70,31.92,32.36,"viola"]]},{"id":3,"start":36.61,"end":45.68,"text":"Jeg kommer fra Italia. Jeg bor også i Norge nå. Hvor kommer du fra, Yousef?","speaker":"Viola","zh":"我来自意大利。我现在也住在挪威。优素福，你从哪里来？","words":[[0,3,36.67,37.12,"jeg"],[4,10,37.12,37.52,"kommer"],[11,14,37.52,37.8,"fra"],[15,21,37.8,38.73,"italia"],[23,26,40.36,40.64,"jeg"],[27,30,40.64,40.98,"bor"],[31,35,40.98,41.4,"også"],[36,37,41.4,41.52,"i"],[38,43,41.52,41.96,"norge~546b56e35dd5"],[44,46,41.96,42.27,"nå~d531d47a7712"],[48,52,43.66,44.08,"hvor"],[53,59,44.08,44.4,"kommer"],[60,62,44.4,44.68,"du"],[63,66,44.68,45.08,"fra"],[68,74,45.08,45.53,"yousef"]]},{"id":4,"start":49.71,"end":55.45,"text":"Jeg kommer fra Syria. Hvor kommer du fra, Håvard?","speaker":"Yousef","zh":"我来自叙利亚。霍瓦尔，你从哪里来？","words":[[0,3,49.77,50.3,"jeg"],[4,10,50.48,51.12,"kommer"],[11,14,51.12,51.4,"fra"],[15,20,51.4,52.05,"syria~2ae242f98808"],[22,26,53.26,53.7,"hvor"],[27,33,53.7,54.14,"kommer"],[34,36,54.14,54.44,"du"],[37,40,54.44,54.88,"fra"],[42,48,54.88,55.3,"håvard"]]},{"id":5,"start":59.43,"end":68.76,"text":"Jeg kommer fra Bergen, men jeg bor ikke i Bergen nå. Hvor kommer dere fra, Hawa og Marek?","speaker":"Håvard","zh":"我来自卑尔根，但我现在不住在卑尔根。哈娃和马雷克，你们从哪里来？","words":[[0,3,59.49,60.08,"jeg"],[4,10,60.08,60.5,"kommer"],[11,14,60.5,60.74,"fra"],[15,21,60.74,61.45,"bergen"],[23,26,62.26,62.46,"men"],[27,30,62.46,62.68,"jeg"],[31,34,62.68,63.0,"bor"],[35,39,63.0,63.3,"ikke"],[40,41,63.3,63.44,"i"],[42,48,63.44,63.98,"bergen"],[49,51,63.98,64.3,"nå~d531d47a7712"],[53,57,65.54,65.86,"hvor"],[58,64,65.86,66.22,"kommer"],[65,69,66.22,66.68,"dere"],[70,73,66.68,67.08,"fra"],[75,79,67.26,67.84,"hawa"],[80,82,67.84,67.96,"og"],[83,88,67.96,68.61,"marek"]]},{"id":6,"start":72.84,"end":79.78,"text":"Jeg kommer fra Somalia, og han kommer fra Polen. Vi bor i Norge nå.","speaker":"Hawa","zh":"我来自索马里，他来自波兰。我们现在住在挪威。","words":[[0,3,72.9,73.54,"jeg"],[4,10,73.54,73.88,"kommer"],[11,14,73.88,74.12,"fra"],[15,22,74.12,75.0,"somalia"],[24,26,75.48,75.68,"og"],[27,30,75.68,76.12,"han"],[31,37,76.12,76.44,"kommer"],[38,41,76.44,76.68,"fra"],[42,47,76.68,77.28,"polen~488e57c60a08"],[49,51,78.28,78.44,"vi"],[52,55,78.44,78.7,"bor"],[56,57,78.7,78.86,"i"],[58,63,78.86,79.4,"norge~546b56e35dd5"],[64,66,79.4,79.63,"nå~d531d47a7712"]]},{"id":7,"start":83.88,"end":85.3,"text":"Veldig bra!","speaker":"Håvard","zh":"非常好！","words":[[0,6,83.94,84.72,"veldig"],[7,10,84.72,85.3,"bra~bbb83846e29f"]]},{"id":8,"start":85.99,"end":88.06,"text":"Vi spør og svarer.","zh":"我们来提问和回答。","words":[[0,2,86.05,86.36,"vi"],[3,7,86.36,86.88,"spør"],[8,10,87.1,87.3,"og"],[11,17,87.3,87.91,"svarer"]]},{"id":9,"start":88.92,"end":91.95,"text":"Hvor kommer Biniam og Sompit fra?","zh":"比尼亚姆和松皮特来自哪里？","words":[[0,4,88.98,89.52,"hvor"],[5,11,89.52,90.0,"kommer"],[12,18,90.0,90.66,"biniam"],[19,21,90.66,90.84,"og"],[22,28,90.84,91.48,"sompit"],[29,32,91.48,91.8,"fra"]]},{"id":10,"start":96.15,"end":103.66,"text":"Han kommer fra Eritrea, og hun kommer fra Thailand. Nå bor de i Norge.","speaker":"Marek","zh":"他来自厄立特里亚，她来自泰国。现在他们住在挪威。","words":[[0,3,96.21,96.7,"han"],[4,10,96.8,97.18,"kommer"],[11,14,97.18,97.56,"fra"],[15,22,97.72,98.52,"eritrea"],[24,26,99.1,99.32,"og"],[27,30,99.32,99.7,"hun"],[31,37,99.84,100.2,"kommer"],[38,41,100.2,100.44,"fra"],[42,50,100.44,101.12,"thailand"],[52,54,101.94,102.26,"nå~d531d47a7712"],[55,58,102.26,102.48,"bor"],[59,61,102.48,102.8,"de"],[62,63,102.94,103.06,"i"],[64,69,103.06,103.51,"norge~546b56e35dd5"]]},{"id":11,"start":108.9,"end":110.24,"text":"Hva gjør de?","zh":"他们在做什么？","words":[[0,3,108.96,109.46,"hva"],[4,8,109.46,109.8,"gjør"],[9,11,109.8,110.09,"de"]]},{"id":12,"start":113.75,"end":116.21,"text":"Marek snakker på Skype.","zh":"马雷克在用 Skype 通话。","words":[[0,5,113.81,114.46,"marek"],[6,13,114.46,115.14,"snakker"],[14,16,115.14,115.38,"på~acc985c9313f"],[17,22,115.38,116.06,"skype"]]},{"id":13,"start":118.25,"end":118.86,"text":"To.","zh":"二、","words":[[0,2,118.31,118.74,"to"]]},{"id":14,"start":120.25,"end":123.52,"text":"Viola skriver en SMS.","zh":"维奥拉在写一条短信。","words":[[0,5,120.31,121.1,"viola"],[6,13,121.1,122.04,"skriver"],[14,16,122.04,122.42,"en~a939a9e56dc5"],[17,20,122.42,123.38,"sms"]]},{"id":15,"start":125.74,"end":126.46,"text":"Tre.","zh":"三、","words":[[0,3,125.8,126.38,"tre"]]},{"id":16,"start":128.0,"end":130.51,"text":"Biniam drikker vann.","zh":"比尼亚姆在喝水。","words":[[0,6,128.06,128.88,"biniam"],[7,14,129.1,129.84,"drikker~8bc6fe28e25c"],[15,19,129.84,130.36,"vann"]]},{"id":17,"start":132.19,"end":133.12,"text":"Fire.","zh":"四、","words":[[0,4,132.25,132.97,"fire"]]},{"id":18,"start":134.7,"end":138.34,"text":"Sompit leser God i norsk.","zh":"松皮特在读《God i norsk》（挪威语教材）。","words":[[0,6,134.76,135.82,"sompit"],[7,12,135.82,136.58,"leser"],[13,16,137.0,137.44,"god~6da943f79ce0"],[17,18,137.44,137.6,"i~2f0e448f7280"],[19,24,137.6,138.19,"norsk~4de5d75feae1"]]},{"id":19,"start":140.16,"end":140.97,"text":"Fem.","zh":"五、","words":[[0,3,140.22,140.86,"fem"]]},{"id":20,"start":142.0,"end":144.63,"text":"Hawa hører på musikk.","zh":"哈娃在听音乐。","words":[[0,4,142.06,142.75,"hawa"],[5,10,142.92,143.52,"hører"],[11,13,143.52,143.78,"på~c90eef4e5e73"],[14,20,143.78,144.48,"musikk"]]},{"id":21,"start":146.52,"end":147.53,"text":"Seks.","zh":"六、","words":[[0,4,146.58,147.5,"seks"]]},{"id":22,"start":148.69,"end":151.68,"text":"Yousef surfer på internett.","zh":"优素福在上网。","words":[[0,6,148.75,149.7,"yousef"],[7,13,149.7,150.38,"surfer"],[14,16,150.38,150.7,"på~48fbb875a822"],[17,26,150.7,151.53,"internett"]]},{"id":23,"start":154.06,"end":154.77,"text":"Sju.","zh":"七、","words":[[0,3,154.12,154.62,"sju"]]},{"id":24,"start":156.2,"end":158.37,"text":"Eivind spiller fotball.","zh":"埃温德在踢足球。","words":[[0,6,156.26,156.98,"eivind"],[7,14,157.2,157.58,"spiller"],[15,22,157.58,158.22,"fotball"]]},{"id":25,"start":160.34,"end":161.16,"text":"Åtte.","zh":"八、","words":[[0,4,160.4,161.0,"åtte"]]},{"id":26,"start":162.5,"end":164.76,"text":"Håvard ser på tv.","zh":"霍瓦尔在看电视。","words":[[0,6,162.56,163.31,"håvard"],[7,10,163.42,163.82,"ser"],[11,13,163.82,164.06,"på~598828787ba5"],[14,16,164.06,164.61,"tv"]]},{"id":27,"start":166.81,"end":167.51,"text":"Ni.","zh":"九、","words":[[0,2,166.88,167.38,"ni"]]},{"id":28,"start":168.91,"end":171.31,"text":"Sofie spiser is.","zh":"苏菲在吃冰淇淋。","words":[[0,5,168.97,169.92,"sofie"],[6,12,169.92,170.56,"spiser"],[13,15,170.56,171.16,"is"]]},{"id":29,"start":173.12,"end":173.78,"text":"Ti.","zh":"十、","words":[[0,2,173.19,173.63,"ti"]]},{"id":30,"start":175.02,"end":177.28,"text":"Bjørnar går på tur.","zh":"比约纳