{"id":"1.3","title":"Nå bor jeg i Norge","audio":"audio/1.3.mp3","duration":213.47,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.97,"text":"1.3 Nå bor jeg i Norge","heading":true,"zh":"1.3 现在我住在挪威","words":[[0,3,0.15,1.17,"1.3"],[4,6,2.19,3.11,"nå~d531d47a7712"],[7,10,3.11,3.61,"bor"],[11,14,3.61,3.93,"jeg"],[15,16,3.93,4.29,"i"],[17,22,4.29,4.89,"norge~546b56e35dd5"]]},{"id":1,"start":10.01,"end":18.84,"text":"Jeg kommer fra Eritrea. Nå bor jeg i Norge. Og du, Sompit?","speaker":"Biniam","zh":"我来自厄立特里亚。现在我住在挪威。你呢，松皮特？","words":[[0,3,10.09,10.55,"jeg"],[4,10,10.55,11.19,"kommer"],[11,14,11.19,11.95,"fra"],[15,22,11.95,12.67,"eritrea"],[24,26,13.75,14.27,"nå~d531d47a7712"],[27,30,14.27,14.59,"bor"],[31,34,14.59,14.81,"jeg"],[35,36,14.81,15.11,"i"],[37,42,15.11,15.43,"norge~546b56e35dd5"],[44,46,17.08,17.2,"og"],[47,49,17.2,17.54,"du"],[51,57,17.54,18.76,"sompit"]]},{"id":2,"start":23.34,"end":32.45,"text":"Jeg kommer fra Thailand. Nå bor jeg i Norge. Hvor kommer du fra, Viola?","speaker":"Sompit","zh":"我来自泰国。现在我住在挪威。维奥拉，你从哪里来？","words":[[0,3,23.42,23.79,"jeg"],[4,10,23.79,24.15,"kommer"],[11,14,24.15,24.59,"fra"],[15,23,24.59,25.01,"thailand"],[25,27,26.38,26.86,"nå~d531d47a7712"],[28,31,26.86,27.6,"bor"],[32,35,27.6,27.84,"jeg"],[36,37,27.84,28.26,"i"],[38,43,28.26,28.52,"norge~546b56e35dd5"],[45,49,30.26,30.64,"hvor"],[50,56,30.64,30.92,"kommer"],[57,59,30.92,31.28,"du"],[60,63,31.28,31.62,"fra"],[65,70,31.88,32.37,"viola"]]},{"id":3,"start":36.58,"end":45.62,"text":"Jeg kommer fra Italia. Jeg bor også i Norge nå. Hvor kommer du fra, Yousef?","speaker":"Viola","zh":"我来自意大利。我现在也住在挪威。优素福，你从哪里来？","words":[[0,3,36.66,37.03,"jeg"],[4,10,37.03,37.33,"kommer"],[11,14,37.33,37.69,"fra"],[15,21,37.69,38.29,"italia"],[23,26,40.22,40.54,"jeg"],[27,30,40.54,40.74,"bor"],[31,35,40.74,41.2,"også"],[36,37,41.2,41.48,"i"],[38,43,41.48,41.84,"norge~546b56e35dd5"],[44,46,41.84,42.1,"nå~d531d47a7712"],[48,52,43.54,43.9,"hvor"],[53,59,43.9,44.28,"kommer"],[60,62,44.28,44.58,"du"],[63,66,44.58,44.88,"fra"],[68,74,45.06,45.54,"yousef"]]},{"id":4,"start":49.67,"end":55.39,"text":"Jeg kommer fra Syria. Hvor kommer du fra, Håvard?","speaker":"Yousef","zh":"我来自叙利亚。霍瓦尔，你从哪里来？","words":[[0,3,49.75,50.14,"jeg"],[4,10,50.14,50.76,"kommer"],[11,14,50.76,51.28,"fra"],[15,20,51.28,51.62,"syria~2ae242f98808"],[22,26,52.93,53.51,"hvor"],[27,33,53.51,53.89,"kommer"],[34,36,53.89,54.29,"du"],[37,40,54.29,54.65,"fra"],[42,48,54.81,55.31,"håvard"]]},{"id":5,"start":59.39,"end":68.71,"text":"Jeg kommer fra Bergen, men jeg bor ikke i Bergen nå. Hvor kommer dere fra, Hawa og Marek?","speaker":"Håvard","zh":"我来自卑尔根，但我现在不住在卑尔根。哈娃和马雷克，你们从哪里来？","words":[[0,3,59.47,59.91,"jeg"],[4,10,59.91,60.31,"kommer"],[11,14,60.31,60.67,"fra"],[15,21,60.67,61.17,"bergen"],[23,26,62.21,62.37,"men"],[27,30,62.37,62.59,"jeg"],[31,34,62.59,62.89,"bor"],[35,39,62.89,63.19,"ikke"],[40,41,63.19,63.39,"i"],[42,48,63.39,63.83,"bergen"],[49,51,63.83,64.19,"nå~d531d47a7712"],[53,57,65.45,65.75,"hvor"],[58,64,65.75,66.13,"kommer"],[65,69,66.13,66.45,"dere"],[70,73,66.45,66.95,"fra"],[75,79,66.95,67.55,"hawa"],[80,82,67.55,67.91,"og"],[83,88,67.91,68.63,"marek"]]},{"id":6,"start":72.81,"end":79.78,"text":"Jeg kommer fra Somalia, og han kommer fra Polen. Vi bor i Norge nå.","speaker":"Hawa","zh":"我来自索马里，他来自波兰。我们现在住在挪威。","words":[[0,3,72.89,73.38,"jeg"],[4,10,73.38,73.72,"kommer"],[11,14,73.72,74.04,"fra"],[15,22,74.04,74.72,"somalia"],[24,26,75.34,75.6,"og"],[27,30,75.6,75.9,"han"],[31,37,75.9,76.3,"kommer"],[38,41,76.3,76.58,"fra"],[42,47,76.58,77.06,"polen~488e57c60a08"],[49,51,77.86,78.38,"vi"],[52,55,78.38,78.58,"bor"],[56,57,78.58,78.78,"i"],[58,63,78.78,79.2,"norge~546b56e35dd5"],[64,66,79.2,79.7,"nå~d531d47a7712"]]},{"id":7,"start":83.84,"end":85.27,"text":"Veldig bra!","speaker":"Håvard","zh":"非常好！","words":[[0,6,83.92,84.7,"veldig"],[7,10,84.7,84.94,"bra~bbb83846e29f"]]},{"id":8,"start":85.38,"end":88.0,"text":"Vi spør og svarer.","zh":"我们来提问和回答。","words":[[0,2,85.38,86.28,"vi"],[3,7,86.28,86.62,"spør"],[8,10,86.62,87.2,"og"],[11,17,87.2,87.92,"svarer"]]},{"id":9,"start":88.89,"end":91.89,"text":"Hvor kommer Biniam og Sompit fra?","zh":"比尼亚姆和松皮特来自哪里？","words":[[0,4,88.97,89.36,"hvor"],[5,11,89.36,89.82,"kommer"],[12,18,89.82,90.52,"biniam"],[19,21,90.52,90.76,"og"],[22,28,90.76,91.36,"sompit"],[29,32,91.36,91.81,"fra"]]},{"id":10,"start":96.11,"end":103.6,"text":"Han kommer fra Eritrea, og hun kommer fra Thailand. Nå bor de i Norge.","speaker":"Marek","zh":"他来自厄立特里亚，她来自泰国。现在他们住在挪威。","words":[[0,3,96.19,96.6,"han"],[4,10,96.6,97.06,"kommer"],[11,14,97.06,97.38,"fra"],[15,22,97.38,98.26,"eritrea"],[24,26,98.26,99.22,"og"],[27,30,99.22,99.54,"hun"],[31,37,99.54,100.12,"kommer"],[38,41,100.12,100.34,"fra"],[42,50,100.34,100.84,"thailand"],[52,54,101.7,102.14,"nå~d531d47a7712"],[55,58,102.14,102.42,"bor"],[59,61,102.42,102.64,"de"],[62,63,102.64,103.02,"i"],[64,69,103.02,103.52,"norge~546b56e35dd5"]]},{"id":11,"start":108.87,"end":110.28,"text":"Hva gjør de?","zh":"他们在做什么？","words":[[0,3,108.95,109.31,"hva"],[4,8,109.31,109.75,"gjør"],[9,11,109.75,110.2,"de"]]},{"id":12,"start":113.25,"end":116.16,"text":"Marek snakker på Skype.","zh":"马雷克在用 Skype 通话。","words":[[0,5,113.33,114.36,"marek"],[6,13,114.36,114.96,"snakker"],[14,16,114.96,115.28,"på~acc985c9313f"],[17,22,115.28,116.08,"skype"]]},{"id":13,"start":118.21,"end":118.81,"text":"To.","zh":"二、","words":[[0,2,118.29,118.73,"to"]]},{"id":14,"start":119.96,"end":123.47,"text":"Viola skriver en SMS.","zh":"维奥拉在写一条短信。","words":[[0,5,120.04,120.95,"viola"],[6,13,120.95,121.49,"skriver"],[14,16,121.49,122.31,"en~a939a9e56dc5"],[17,20,122.31,122.69,"sms"]]},{"id":15,"start":125.7,"end":126.41,"text":"Tre.","zh":"三、","words":[[0,3,125.78,126.33,"tre"]]},{"id":16,"start":127.97,"end":130.44,"text":"Biniam drikker vann.","zh":"比尼亚姆在喝水。","words":[[0,6,128.05,128.76,"biniam"],[7,14,128.76,129.54,"drikker~8bc6fe28e25c"],[15,19,129.54,130.36,"vann"]]},{"id":17,"start":131.91,"end":133.03,"text":"Fire.","zh":"四、","words":[[0,4,131.99,132.95,"fire"]]},{"id":18,"start":134.67,"end":138.28,"text":"Sompit leser God i norsk.","zh":"松皮特在读《God i norsk》（挪威语教材）。","words":[[0,6,134.75,135.49,"sompit"],[7,12,135.49,136.47,"leser"],[13,16,136.47,137.23,"god~6da943f79ce0"],[17,18,137.23,137.55,"i~2f0e448f7280"],[19,24,137.55,138.21,"norsk~4de5d75feae1"]]},{"id":19,"start":140.15,"end":140.88,"text":"Fem.","zh":"五、","words":[[0,3,140.23,140.8,"fem"]]},{"id":20,"start":141.65,"end":144.22,"text":"Hawa hører på musikk.","zh":"哈娃在听音乐。","words":[[0,4,141.73,142.58,"hawa"],[5,10,142.58,143.32,"hører"],[11,13,143.32,143.68,"på~c90eef4e5e73"],[14,20,143.68,144.14,"musikk"]]},{"id":21,"start":146.55,"end":147.38,"text":"Seks.","zh":"六、","words":[[0,4,146.63,147.3,"seks"]]},{"id":22,"start":148.66,"end":151.3,"text":"Yousef surfer på internett.","zh":"优素福在上网。","words":[[0,6,148.74,149.44,"yousef"],[7,13,149.44,150.18,"surfer"],[14,16,150.18,150.56,"på~48fbb875a822"],[17,26,150.56,151.22,"internett"]]},{"id":23,"start":154.03,"end":154.68,"text":"Sju.","zh":"七、","words":[[0,3,154.11,154.6,"sju"]]},{"id":24,"start":156.17,"end":158.32,"text":"Eivind spiller fotball.","zh":"埃温德在踢足球。","words":[[0,6,156.25,156.74,"eivind"],[7,14,156.74,157.5,"spiller"],[15,22,157.5,158.24,"fotball"]]},{"id":25,"start":160.31,"end":160.63,"text":"Åtte.","zh":"八、","words":[[0,4,160.39,160.55,"åtte"]]},{"id":26,"start":162.46,"end":164.71,"text":"Håvard ser på tv.","zh":"霍瓦尔在看电视。","words":[[0,6,162.54,163.08,"håvard"],[7,10,163.08,163.62,"ser"],[11,13,163.62,163.96,"på~598828787ba5"],[14,16,163.96,164.63,"tv"]]},{"id":27,"start":166.78,"end":167.45,"text":"Ni.","zh":"九、","words":[[0,2,166.86,167.37,"ni"]]},{"id":28,"start":168.88,"end":171.26,"text":"Sofie spiser is.","zh":"苏菲在吃冰淇淋。","words":[[0,5,168.96,169.65,"sofie"],[6,12,169.65,170.39,"spiser"],[13,15,170.39,171.18,"is"]]},{"id":29,"start":173.09,"end":173.72,"text":"Ti.","zh":"十、","words":[[0,2,173.17,173.64,"ti"]]},{"id":30,"start":174.98,"end":177.22,"t