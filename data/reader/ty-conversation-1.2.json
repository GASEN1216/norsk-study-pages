{"id":"ty-conversation-1.2","bookId":"ty-conversation-guide","readingId":"1.2","title":"Responding to more questions about yourself","audio":"audio/ty-conversation/1.2.mp3","duration":38.4,"synthetic":false,"sentences":[{"id":0,"start":0.72,"end":3.12,"speaker":"Kari","text":"Kommer du fra Bergen, Olav?","zh":"奥拉夫，你来自卑尔根吗？","words":[[0,6,0.72,1.54,"kommer"],[7,9,1.54,1.72,"du"],[10,13,1.72,1.96,"fra"],[14,20,1.96,2.52,"bergen"],[22,26,2.68,3.12,"olav"]]},{"id":1,"start":4.08,"end":6.94,"speaker":"Olav","text":"Ja, jeg kommer fra Bergen.","zh":"是的，我来自卑尔根。","words":[[0,2,4.08,4.92,"ja"],[4,7,5.62,5.86,"jeg"],[8,14,5.86,6.18,"kommer"],[15,18,6.18,6.54,"fra"],[19,25,6.54,6.94,"bergen"]]},{"id":2,"start":7.92,"end":9.62,"speaker":"Kari","text":"Jeg kommer fra Oslo.","zh":"我来自奥斯陆。","words":[[0,3,7.92,8.44,"jeg"],[4,10,8.44,8.84,"kommer"],[11,14,8.84,9.14,"fra"],[15,19,9.14,9.62,"oslo"]]},{"id":3,"start":10.28,"end":12.28,"speaker":"Kari","text":"Jeg bor i Oslo.","zh":"我住在奥斯陆。","words":[[0,3,10.28,11.02,"jeg"],[4,7,11.02,11.38,"bor"],[8,9,11.38,11.82,"i@ty-place"],[10,14,11.82,12.28,"oslo"]]},{"id":4,"start":13.14,"end":14.98,"speaker":"Kari","text":"Bor du på hotell?","zh":"你住酒店吗？","words":[[0,3,13.14,13.98,"bor"],[4,6,13.98,14.22,"du"],[7,9,14.22,14.5,"på@ty-hotel"],[10,16,14.5,14.98,"hotell"]]},{"id":5,"start":15.82,"end":18.72,"speaker":"Olav","text":"Ja, jeg bor på hotell.","zh":"是的，我住酒店。","words":[[0,2,15.82,16.66,"ja"],[4,7,17.44,17.74,"jeg"],[8,11,17.74,18.02,"bor"],[12,14,18.02,18.3,"på@ty-hotel"],[15,21,18.3,18.72,"hotell"]]},{"id":6,"start":19.48,"end":20.62,"speaker":"Olav","text":"Og du?","zh":"你呢？","words":[[0,2,19.48,20.32,"og"],[3,5,20.32,20.62,"du"]]},{"id":7,"start":21.4,"end":23.42,"speaker":"Kari","text":"Jeg bor ikke på hotell!","zh":"我可不住酒店！","words":[[0,3,21.4,21.98,"jeg"],[4,7,21.98,22.28,"bor"],[8,12,22.28,22.74,"ikke"],[13,15,22.74,22.96,"på@ty-hotel"],[16,22,22.96,23.42,"hotell"]]},{"id":8,"start":24.32,"end":25.68,"speaker":"Olav","text":"Har du bil?","zh":"你有车吗？","words":[[0,3,24.32,25.16,"har"],[4,6,25.16,25.38,"du"],[7,10,25.38,25.68,"bil"]]},{"id":9,"start":26.18,"end":28.5,"speaker":"Kari","text":"Nei, jeg har ikke bil.","zh":"没有，我没有车。","words":[[0,3,26.18,27.02,"nei"],[5,8,27.42,27.62,"jeg"],[9,12,27.62,27.86,"har"],[13,17,27.86,28.18,"ikke"],[18,21,28.18,28.5,"bil"]]},{"id":10,"start":29.46,"end":30.38,"speaker":"Kari","text":"Har du bil?","zh":"你有车吗？","words":[[0,3,29.46,29.84,"har"],[4,6,29.84,30.08,"du"],[7,10,30.08,30.38,"bil"]]},{"id":11,"start":31.52,"end":34.08,"speaker":"Olav","text":"Ja, jeg har bil i Bergen.","zh":"有，我在卑尔根有车。","words":[[0,2,31.52,32.2,"ja"],[4,7,32.72,32.88,"jeg"],[8,11,32.88,33.12,"har"],[12,15,33.12,33.46,"bil"],[16,17,33.46,33.68,"i@ty-place"],[18,24,33.68,34.08,"bergen"]]},{"id":12,"start":35.06,"end":36.64,"speaker":"Olav","text":"Jeg har ikke bil i Oslo.","zh":"我在奥斯陆没有车。","words":[[0,3,35.06,35.26,"jeg"],[4,7,35.26,35.42,"har"],[8,12,35.42,35.84,"ikke"],[13,16,35.84,36.12,"bil"],[17,18,36.12,36.24,"i@ty-place"],[19,23,36.24,36.64,"oslo"]]}],"lexicon":{"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"ty-conversation-1-001","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"fra":{"lemma":"fra","zh":"从；来自","pos":"介词","ref":"ty-conversation-1-007","clip":null},"har":{"lemma":"ha","zh":"有；拥有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时"},"hotell":{"lemma":"hotell","zh":"酒店；旅馆","pos":"名词","ref":"ty-conversation-1-012","clip":null},"i":{"lemma":"i","zh":"在","pos":"介词","ref":"ty-conversation-1-015","clip":null},"i@ty-place":{"lemma":"i","zh":"在（某个地方）","pos":"介词","ref":"ty-conversation-1-015","clip":null,"contextual":true,"baseKey":"i","surface":"i"},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-0