{"id":"ty-conversation-1.2","bookId":"ty-conversation-guide","readingId":"1.2","title":"Responding to more questions about yourself","audio":"audio/ty-conversation/1.2.mp3","duration":38.4,"synthetic":false,"sentences":[{"id":0,"start":1.09,"end":3.175,"speaker":"Kari","text":"Kommer du fra Bergen, Olav?","zh":"奥拉夫，你来自卑尔根吗？","words":[[0,6,1.09,1.555,"kommer"],[7,9,1.59,1.735,"du"],[10,13,1.79,1.975,"fra"],[14,20,2.01,2.515,"bergen"],[22,26,2.71,3.175,"olav"]]},{"id":1,"start":4.69,"end":6.975,"speaker":"Olav","text":"Ja, jeg kommer fra Bergen.","zh":"是的，我来自卑尔根。","words":[[0,2,4.69,4.835,"ja"],[4,7,5.63,5.855,"jeg"],[8,14,5.91,6.295,"kommer"],[15,18,6.35,6.535,"fra"],[19,25,6.55,6.975,"bergen"]]},{"id":2,"start":8.15,"end":9.595,"speaker":"Kari","text":"Jeg kommer fra Oslo.","zh":"我来自奥斯陆。","words":[[0,3,8.15,8.435,"jeg"],[4,10,8.59,8.955,"kommer"],[11,14,8.97,9.155,"fra"],[15,19,9.21,9.595,"oslo"]]},{"id":3,"start":10.81,"end":12.255,"speaker":"Kari","text":"Jeg bor i Oslo.","zh":"我住在奥斯陆。","words":[[0,3,10.81,11.035,"jeg"],[4,7,11.13,11.435,"bor"],[8,9,11.69,11.795,"i@ty-place"],[10,14,11.87,12.255,"oslo"]]},{"id":4,"start":13.69,"end":15.095,"speaker":"Kari","text":"Bor du på hotell?","zh":"你住酒店吗？","words":[[0,3,13.69,13.995,"bor"],[4,6,14.03,14.175,"du"],[7,9,14.29,14.455,"på@ty-hotel"],[10,16,14.55,15.095,"hotell"]]},{"id":5,"start":16.39,"end":18.775,"speaker":"Olav","text":"Ja, jeg bor på hotell.","zh":"是的，我住酒店。","words":[[0,2,16.39,16.535,"ja"],[4,7,17.51,17.735,"jeg"],[8,11,17.79,18.055,"bor"],[12,14,18.13,18.275,"på@ty-hotel"],[15,21,18.31,18.775,"hotell"]]},{"id":6,"start":20.13,"end":20.535,"speaker":"Olav","text":"Og du?","zh":"你呢？","words":[[0,2,20.13,20.355,"og"],[3,5,20.39,20.535,"du"]]},{"id":7,"start":21.71,"end":23.495,"speaker":"Kari","text":"Jeg bor ikke på hotell!","zh":"我可不住酒店！","words":[[0,3,21.71,21.995,"jeg"],[4,7,22.07,22.335,"bor"],[8,12,22.43,22.775,"ikke"],[13,15,22.79,22.915,"på@ty-hotel"],[16,22,22.97,23.495,"hotell"]]},{"id":8,"start":24.89,"end":25.735,"speaker":"Olav","text":"Har du bil?","zh":"你有车吗？","words":[[0,3,24.89,25.175,"har"],[4,6,25.23,25.355,"du"],[7,10,25.41,25.735,"bil"]]},{"id":9,"start":26.61,"end":28.555,"speaker":"Kari","text":"Nei, jeg har ikke bil.","zh":"没有，我没有车。","words":[[0,3,26.61,26.915,"nei"],[5,8,27.43,27.635,"jeg"],[9,12,27.67,27.855,"har"],[13,17,27.91,28.235,"ikke"],[18,21,28.25,28.555,"bil"]]},{"id":10,"start":29.61,"end":30.435,"speaker":"Kari","text":"Har du bil?","zh":"你有车吗？","words":[[0,3,29.61,29.855,"har"],[4,6,29.89,30.035,"du"],[7,10,30.15,30.435,"bil"]]},{"id":11,"start":31.95,"end":34.115,"speaker":"Olav","text":"Ja, jeg har bil i Bergen.","zh":"有，我在卑尔根有车。","words":[[0,2,31.95,32.095,"ja"],[4,7,32.71,32.915,"jeg"],[8,11,32.95,33.155,"har"],[12,15,33.21,33.535,"bil"],[16,17,33.59,33.692,"i@ty-place"],[18,24,33.692,34.115,"bergen"]]},{"id":12,"start":35.11,"end":36.595,"speaker":"Olav","text":"Jeg har ikke bil i Oslo.","zh":"我在奥斯陆没有车。","words":[[0,3,35.11,35.263,"jeg"],[4,7,35.263,35.435,"har"],[8,12,35.51,35.875,"ikke"],[13,16,35.93,36.183,"bil"],[17,18,36.183,36.273,"i@ty-place"],[19,23,36.273,36.595,"oslo"]]}],"lexicon":{"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"ty-conversation-1-001","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"fra":{"lemma":"fra","zh":"从；来自","pos":"介词","ref":"ty-conversation-1-007","clip":null},"har":{"lemma":"ha","zh":"有；拥有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时"},"hotell":{"lemma":"hotell","zh":"酒店；旅馆","pos":"名词","ref":"ty-conversation-1-012","clip":null},"i":{"lemma":"i","zh":"在","pos":"介词","ref":"ty-conversation-1-015","clip":null},"i@ty-place":{"lemma":"i","zh":"在（某个地方）","pos":"介词","ref":"ty-conversation-1-015","clip":null,"contextual":true,"baseKey":"i","sur