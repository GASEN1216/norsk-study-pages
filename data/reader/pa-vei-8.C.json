{"id":"pa-vei-8.C","bookId":"pa-vei-textbook","readingId":"8.C","title":"En kald morgen","audio":"audio/pa-vei/8.C.mp3","duration":122.904,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.06,"end":2.705,"text":"Nils ser ut av vinduet.","zh":"尼尔斯往窗外看。","words":[[0,4,1.06,1.525,"nils"],[5,8,1.58,1.933,"ser"],[9,11,1.933,2.123,"ut"],[12,14,2.123,2.232,"av"],[15,22,2.232,2.705,"vinduet"]]},{"id":1,"start":4.74,"end":9.665,"text":"Ute er det snø, og termometeret viser minus ti grader.","zh":"外面有雪，温度计显示零下十度。","words":[[0,3,4.74,5.093,"ute"],[4,6,5.093,5.202,"er"],[7,10,5.202,5.325,"det"],[11,14,5.36,5.605,"snø"],[16,18,6.84,6.982,"og"],[19,31,6.982,7.885,"termometeret"],[32,37,7.9,8.345,"viser"],[38,43,8.48,8.865,"minus"],[44,46,8.98,9.145,"ti"],[47,53,9.28,9.665,"grader"]]},{"id":2,"start":11.96,"end":17.165,"text":"Sønnen til Nils, Svein-Erik, er 15 år og går på skolen.","zh":"尼尔斯的儿子斯韦恩－埃里克十五岁，正在上学。","words":[[0,6,11.96,12.405,"sønnen"],[7,10,12.44,12.605,"til"],[11,15,12.64,13.005,"nils"],[17,27,13.64,14.385,"svein-erik"],[29,31,15.28,15.425,"er"],[32,34,15.48,15.965,"15"],[35,37,16.04,16.285,"år"],[38,40,16.34,16.462,"og"],[41,44,16.462,16.623,"går"],[45,47,16.623,16.763,"på"],[48,54,16.763,17.165,"skolen"]]},{"id":3,"start":19.44,"end":19.965,"text":"Ha det, pappa!","zh":"再见，爸爸！","words":[[0,2,19.44,19.583,"ha"],[3,6,19.583,19.722,"det"],[8,13,19.722,19.965,"pappa"]],"speaker":"Svein-Erik"},{"id":4,"start":20.8,"end":21.285,"text":"Vent!","zh":"等等！","words":[[0,4,20.8,21.285,"vent"]],"speaker":"Nils"},{"id":5,"start":22.33,"end":24.495,"text":"Det er ti kuldegrader ute.","zh":"外面零下十度。","words":[[0,3,22.33,22.513,"det"],[4,6,22.513,22.635,"er"],[7,9,22.77,23.015,"ti"],[10,21,23.33,24.163,"kuldegrader"],[22,25,24.163,24.495,"ute"]],"speaker":"Nils"},{"id":6,"start":25.49,"end":27.095,"text":"Du trenger varme klær.","zh":"你得穿暖和的衣服。","words":[[0,2,25.49,25.635,"du"],[3,10,25.69,26.075,"trenger"],[11,16,26.13,26.575,"varme"],[17,21,26.61,27.095,"klær"]],"speaker":"Nils"},{"id":7,"start":27.89,"end":28.655,"text":"Har du skjerf?","zh":"你有围巾吗？","words":[[0,3,27.89,28.043,"har"],[4,6,28.043,28.155,"du"],[7,13,28.17,28.655,"skjerf"]],"speaker":"Nils"},{"id":8,"start":29.53,"end":29.975,"text":"Ja da.","zh":"有啦。","words":[[0,2,29.53,29.695,"ja"],[3,5,29.83,29.975,"da"]],"speaker":"Svein-Erik"},{"id":9,"start":32.27,"end":33.055,"text":"Hva med longs?","zh":"秋裤呢？","words":[[0,3,32.27,32.433,"hva"],[4,7,32.433,32.572,"med"],[8,13,32.572,33.055,"longs"]],"speaker":"Nils"},{"id":10,"start":33.99,"end":34.855,"text":"Jeg fryser ikke.","zh":"我不冷。","words":[[0,3,33.99,34.135,"jeg"],[4,10,34.17,34.612,"fryser"],[11,15,34.612,34.855,"ikke"]],"speaker":"Svein-Erik"},{"id":11,"start":36.21,"end":37.475,"text":"Det er snø ute!","zh":"外面有雪！","words":[[0,3,36.21,36.362,"det"],[4,6,36.362,36.495,"er"],[7,10,36.55,36.835,"snø"],[11,14,37.07,37.475,"ute"]],"speaker":"Nils"},{"id":12,"start":38.05,"end":39.115,"text":"Du kan bli syk.","zh":"你会生病的。","words":[[0,2,38.05,38.175,"du"],[3,6,38.19,38.392,"kan"],[7,10,38.392,38.555,"bli"],[11,14,38.63,39.115,"syk"]],"speaker":"Nils"},{"id":13,"start":40.19,"end":41.735,"text":"Du må ta på deg vintersko.","zh":"你得穿上冬鞋。","words":[[0,2,40.19,40.332,"du"],[3,5,40.332,40.472,"må"],[6,8,40.472,40.635,"ta"],[9,11,40.69,40.802,"på"],[12,15,40.802,40.955,"deg"],[16,25,40.99,41.735,"vintersko"]],"speaker":"Nils"},{"id":14,"start":43.07,"end":44.875,"text":"Alle på skolen går med joggesko.","zh":"学校里大家都穿运动鞋。","words":[[0,4,43.07,43.475,"alle"],[5,7,43.49,43.615,"på"],[8,14,43.63,44.043,"skolen"],[15,18,44.043,44.192,"går"],[19,22,44.192,44.332,"med"],[23,31,44.332,44.875,"joggesko"]],"speaker":"Svein-Erik"},{"id":15,"start":46.01,"end":46.775,"text":"Nå går jeg, pappa.","zh":"爸爸，我走了。","words":[[0,2,46.01,46.155,"nå"],[3,6,46.17,46.373,"går"],[7,10,46.373,46.502,"jeg"],[12,17,46.502,46.775,"pappa"]],"speaker":"Svein-Erik"},{"id":16,"start":47.33,"end":47.675,"text":"Ha det!","zh":"再见！","words":[[0,2,47.33,47.475,"ha"],[3,6,47.51,47.675,"det"]],"speaker":"Svein-Erik"},{"id":17,"start":48.87,"end":49.575,"text":"Husk lue!","zh":"别忘了帽子！","words":[[0,4,48.87,49.263,"husk"],[5,8,49.263,49.575,"lue"]],"speaker":"Nils"},{"id":18,"start":52.91,"end":53.655,"text":"Sammendrag.","zh":"摘要","words":[[0,10,52.91,53.655,"sammendrag"]]},{"id":19,"start":55.57,"end":56.715,"text":"Det er en kald dag.","zh":"这是寒冷的一天。","words":[[0,3,55.57,55.733,"det"],[4,6,55.733,55.873,"er"],[7,9,55.873,55.995,"en"],[10,14,56.03,56.375,"kald"],[15,18,56.39,56.715,"dag"]]},{"id":20,"start":58.65,"end":60.995,"text":"Ute er det snø og kuldegrader.","zh":"外面有雪，气温在零度以下。","words":[[0,3,58.65,59.032,"ute"],[4,6,59.032,59.153,"er"],[7,10,59.153,59.295,"det"],[11,14,59.33,59.595,"snø"],[15,17,60.19,60.312,"og"],[18,29,60.312,60.995,"kuldegrader"]]},{"id":21,"start":63.03,"end":66.315,"text":"Nils sier at Svein-Erik må ta på seg varme klær.","zh":"尼尔斯说斯韦恩－埃里克必须穿暖和的衣服。","words":[[0,4,63.03,63.455,"nils"],[5,9,63.57,63.933,"sier"],[10,12,63.933,64.093,"at"],[13,23,64.093,64.815,"svein-erik"],[24,26,64.83,64.955,"må"],[27,29,64.99,65.135,"ta"],[30,32,65.19,65.312,"på"],[33,36,65.312,65.495,"seg"],[37,42,65.51,65.955,"varme"],[43,47,65.97,66.315,"klær"]]},{"id":22,"start":68.71,"end":72.275,"text":"Svein-Erik har ikke lyst til å ta på seg longs eller varme klær.","zh":"斯韦恩－埃里克不想穿秋裤或暖和的衣服。","words":[[0,10,68.71,69.273,"svein-erik"],[11,14,69.273,69.403,"har"],[15,19,69.403,69.615,"ikke"],[20,24,69.65,69.993,"lyst@pa-vei-lyst-desire"],[25,28,69.993,70.153,"til"],[29,30,70.153,70.243,"å"],[31,33,70.243,70.375,"ta"],[34,36,70.45,70.583,"på"],[37,40,70.583,70.755,"seg"],[41,46,70.81,71.273,"longs"],[47,52,71.273,71.535,"eller"],[53,58,71.55,71.935,"varme"],[59,63,71.95,72.275,"klær"]]},{"id":23,"start":73.85,"end":75.735,"text":"Han fryser ikke, sier han.","zh":"他说自己不冷。","words":[[0,3,73.85,74.035,"han"],[4,10,74.13,74.703,"fryser"],[11,15,74.703,74.975,"ikke"],[17,21,75.33,75.583,"sier"],[22,25,75.583,75.735,"han"]]},{"id":24,"start":77.18,"end":78.945,"text":"Han vil ikke ta på seg varme sko.","zh":"他不想穿暖和的鞋。","words":[[0,3,77.18,77.345,"han"],[4,7,77.36,77.525,"vil"],[8,12,77.54,77.773,"ikke"],[13,15,77.773,77.945,"ta"],[16,18,78.08,78.192,"på"],[19,22,78.192,78.365,"seg"],[23,28,78.38,78.725,"varme"],[29,32,78.74,78.945,"sko"]]},{"id":25,"start":80.68,"end":83.165,"text":"Han sier at alle på skolen går med joggesko.","zh":"他说学校里大家都穿运动鞋。","words":[[0,3,80.68,80.845,"han"],[4,8,80.88,81.172,"sier"],[9,11,81.172,81.305,"at"],[12,16,81.34,81.643,"alle"],[17,19,81.643,81.785,"på"],[20,26,81.82,82.245,"skolen"],[27,30,82.28,82.482,"går"],[31,34,82.482,82.643,"med"],[35,43,82.643,83.165,"joggesko"]]},{"id":26,"start":87.96,"end":89.165,"text":"Hva slags vær er det?","zh":"是什么天气？","words":[[0,3,87.96,88.145,"hva"],[4,9,88.22,88.545,"slags"],[10,13,88.58,88.903,"vær"],[14,16,88.903,89.023,"er"],[17,20,89.023,89.165,"det"]]},{"id":27,"start":90.92,"end":91.885,"text":"Sola skinner.","zh":"阳光照耀着。","words":[[0,4,90.92,91.385,"sola"],[5,12,91.46,91.885,"skinner"]]},{"id":28,"start":93.0,"end":93.765,"text":"Det er sol.","zh":"天是晴的。","words":[[0,3,93.0,93.183,"det"],[4,6,93.183,93.325,"er"],[7,10,93.42,93.765,"sol"]]},{"id":29,"start":94.9,"end":95.765,"text":"Det er varmt.","zh":"天气暖和。","words":[[0,3,94.9,95.083,"det"],[4,6,95.083,95.225,"er"],[7,12,95.26,95.765,"varmt"]]},{"id":30,"start":97.96,"end":99.265,"text":"Det er overskyet.","zh":"天阴着。","words":[[0,3,97.96,98.143,"det"],[4,6,98.143,98.285,"er"],[7,16,98.38,99.265,"overskyet"]]},{"id":31,"start":101.5,"end":102.145,"text":"Det regner.","zh":"下雨了。","words":[[0,3,101.5,101.665,"det"],[4,10,101.68,102.145,"regner@pa-vei-extra-4"]]},{"id":32,"start":103.38,"end":104.105,"text":"Det er regn.","zh":"有雨。","words":[[0,3,103.38,103.542,"det"],[4,6,103.542,103.703,"er"],[7,11,103.703,104.105,"regn"]]},{"id":33,"start":106.62,"end":107.425,"text":"Det blåser.","zh":"刮风了。","words":[[0,3,106.62,106.785,"det"],[4,10,106.82,107.425,"blåser"]]},{"id":34,"start":108.56,"end":109.285,"text":"Det er vind.","zh":"有风。","words":[[0,3,108.56,108.745,"det"],[4,6,108.76,108.905,"er"],[7,11,108.98,109.285,"vind"]]},{"id":35,"start":111.7,"end":112.485,"text":"Det snør.","zh":"下雪了。","words":[[0,3,111.7,111.885,"det"],[4,8,112.0,112.485,"snør"]]},{"id":36,"start":113.76,"end":114.465,"text":"Det er snø.","zh":"有雪。","words":[[0,3,113.76,113.945,"det"],[4,6,113.96,114.105,"er"],[7,10,114.22,114.465,"snø"]]},{"id":37,"start":116.0,"end":116.885,"text":"Det er kaldt.","zh":"天气寒冷。","words":[[0,3,116.0,116.185,"det"],[4,6,116.2,116.345,"er"],[7,12,116.4,116.885,"kaldt"]]},{"id":38,"start":118.78,"end":119.585,"text":"Det lyner.","zh":"打闪了。","words":[[0,3,118.78,118.965,"det"],[4,9,119.04,119.585,"lyner"]]},{"id":39,"start":120.62,"end":121.445,"text":"Det tordner.","zh":"打雷了。","words":[[0,3,120.62,120.785,"det"],[4,11,120.82,121.445,"tordner"]]}],"lexicon":{"15":{"lemma":"15","pos":"数词","zh":"数字 15","ref":null,"clip":null},"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"bli":{"lemma":"bli","pos":"动词","zh":"变成；成为；留下","ref":null,"clip":null,"form":"不定式"},"blåser":{"lemma":"blåse","zh":"吹；刮风","pos":"动词","ref":"5-006","form":"现在时","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"eller":{"lemma":"eller","pos":"连词","zh":"或者；还是","ref":null,"clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","