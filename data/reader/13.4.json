{"id":"13.4","title":"Å studere i Norge","audio":"audio/13.4.mp3","duration":122.05,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.13,"text":"13.4 Å studere i Norge","heading":true,"zh":"13.4 在挪威上大学","words":[[0,4,0.15,1.58,"13.4"],[5,6,2.76,2.86,"å~0583da7a620a"],[7,14,2.86,3.38,"studere"],[15,16,3.38,3.6,"i"],[17,22,3.6,4.05,"norge~546b56e35dd5"]]},{"id":1,"start":5.79,"end":10.22,"text":"Synne tar sykepleierutdanning på universitetet i Trondheim.","zh":"辛妮在特隆赫姆的大学读护理专业。","words":[[0,5,5.85,6.4,"synne"],[6,9,6.4,6.74,"tar~d70448b06558"],[10,29,6.74,8.12,"sykepleierutdanning"],[30,32,8.12,8.34,"på"],[33,46,8.34,9.34,"universitetet"],[47,48,9.34,9.42,"i"],[49,58,9.42,10.07,"trondheim"]]},{"id":2,"start":11.01,"end":19.7,"text":"Hun går på forelesninger, og hun sitter på universitetet og leser, men hun sitter også ofte på rommet sitt og arbeider.","zh":"她去听课，也坐在大学里看书学习，但她也常常坐在自己的房间里用功。","words":[[0,3,11.07,11.32,"hun"],[4,7,11.32,11.66,"går~f167a1defd28"],[8,10,11.66,11.96,"på~5cdff0766088"],[11,24,11.96,13.06,"forelesninger"],[26,28,13.48,13.68,"og"],[29,32,13.68,13.88,"hun"],[33,39,13.88,14.3,"sitter"],[40,42,14.3,14.5,"på"],[43,56,14.5,15.38,"universitetet"],[57,59,15.38,15.5,"og"],[60,65,15.5,16.16,"leser"],[67,70,16.54,16.9,"men"],[71,74,16.9,17.06,"hun"],[75,81,17.06,17.38,"sitter"],[82,86,17.38,17.72,"også"],[87,91,17.72,18.0,"ofte"],[92,94,18.0,18.12,"på"],[95,101,18.12,18.48,"rommet"],[102,106,18.48,18.8,"sitt~9563d0679965"],[107,109,18.8,18.94,"og"],[110,118,18.94,19.55,"arbeider~bb25b9573ee7"]]},{"id":3,"start":20.83,"end":25.99,"text":"I løpet av studiet skal hun levere mange oppgaver om ulike temaer.","zh":"在学习期间，她要交很多关于不同主题的作业。","words":[[0,1,20.89,21.08,"i~10efb4834efd"],[2,7,21.08,21.42,"løpet"],[8,10,21.42,21.56,"av~e5733f90a2a5"],[11,18,21.56,22.2,"studiet"],[19,23,22.54,22.8,"skal"],[24,27,22.8,22.98,"hun"],[28,34,22.98,23.42,"levere"],[35,40,23.42,23.78,"mange"],[41,49,23.78,24.48,"oppgaver~68b42ea0b737"],[50,52,24.48,24.74,"om~52c0bdc828db"],[53,58,24.74,25.24,"ulike"],[59,65,25.24,25.84,"temaer"]]},{"id":4,"start":27.04,"end":32.34,"text":"Oppgavene er obligatoriske, og hun jobber mye med oppgavene sine.","zh":"这些作业必须完成，她花很多精力做这些作业。","words":[[0,9,27.09,27.88,"oppgavene~bd8d758ac233"],[10,12,27.88,28.26,"er"],[13,26,28.26,29.45,"obligatoriske"],[28,30,29.84,29.96,"og"],[31,34,29.96,30.14,"hun"],[35,41,30.14,30.56,"jobber~0d5a0ada1330"],[42,45,30.56,31.14,"mye~933c5a923198"],[46,49,31.14,31.26,"med~21c674a34b32"],[50,59,31.26,31.82,"oppgavene~bd8d758ac233"],[60,64,31.82,32.2,"sine"]]},{"id":5,"start":33.97,"end":36.85,"text":"Annenhver helg jobber hun på et sykehjem.","zh":"她每隔一个周末在养老院工作。","words":[[0,9,34.03,34.62,"annenhver"],[10,14,34.62,35.24,"helg"],[15,21,35.24,35.54,"jobber~15f358646921"],[22,25,35.54,35.74,"hun"],[26,28,35.74,35.84,"på"],[29,31,35.84,36.02,"et~054dde72f37b"],[32,40,36.02,36.7,"sykehjem"]]},{"id":6,"start":37.78,"end":48.72,"text":"I disse helgene er hun ikke så mye sammen med venninnene sine, men det er viktig for henne å tjene noen ekstra penger i tillegg til studielånet.","zh":"这些周末她和女性朋友们在一起的时间不多，但对她来说，除了学生贷款之外再多挣点钱很重要。","words":[[0,1,37.84,38.18,"i~0bdedb551af0"],[2,7,38.18,38.56,"disse"],[8,15,38.56,39.2,"helgene"],[16,18,39.62,39.86,"er"],[19,22,39.86,40.06,"hun"],[23,27,40.06,40.38,"ikke"],[28,30,40.38,40.64,"så~02fe378ac702"],[31,34,40.64,41.0,"mye~933c5a923198"],[35,41,41.0,41.34,"sammen"],[42,45,41.34,41.48,"med"],[46,56,41.48,42.08,"venninnene"],[57,61,42.08,42.58,"sine"],[63,66,43.38,43.68,"men"],[67,70,43.68,43.84,"det~5e977a82af29"],[71,73,43.84,44.04,"er"],[74,80,44.04,44.44,"viktig"],[81,84,44.44,44.6,"for~da1a474a7e8c"],[85,90,44.6,44.98,"henne"],[91,92,44.98,45.12,"å~0583da7a620a"],[93,98,45.12,45.58,"tjene"],[99,103,45.58,45.9,"noen~c766e2ef794d"],[104,110,45.9,46.36,"ekstra"],[111,117,46.36,46.94,"penger"],[118,119,46.94,47.08,"i~7e9724ca6f08"],[120,127,47.08,47.56,"tillegg"],[128,131,47.56,47.76,"til~442b7ec806e8"],[132,143,47.76,48.57,"studielånet"]]},{"id":7,"start":49.27,"end":51.2,"text":"Hun trives i jobben sin.","zh":"她在工作中过得很愉快。","words":[[0,3,49.34,49.64,"hun"],[4,10,49.64,50.36,"trives"],[11,12,50.36,50.48,"i"],[13,19,50.48,50.8,"jobben"],[20,23,50.8,51.05,"sin"]]},{"id":8,"start":53.11,"end":56.79,"text":"Synne bor i kollektiv sammen med tre andre jenter.","zh":"辛妮和另外三个女孩合租。","words":[[0,5,53.17,53.7,"synne"],[6,9,53.7,54.04,"bor"],[10,11,54.04,54.18,"i"],[12,21,54.18,55.08,"kollektiv"],[22,28,55.08,55.4,"sammen"],[29,32,55.4,55.56,"med"],[33,36,55.56,55.86,"tre"],[37,42,55.86,56.16,"andre~0c69ef1e750c"],[43,49,56.16,56.64,"jenter"]]},{"id":9,"start":57.58,"end":60.86,"text":"De har felles stue, kjøkken og bad.","zh":"她们共用客厅、厨房和浴室。","words":[[0,2,57.64,57.94,"de"],[3,6,57.94,58.26,"har"],[7,13,58.26,58.82,"felles"],[14,18,58.82,59.41,"stue"],[20,27,59.6,60.16,"kjøkken"],[28,30,60.16,60.28,"og"],[31,34,60.28,60.71,"bad~7f12b44fb659"]]},{"id":10,"start":61.54,"end":65.19,"text":"Det er litt trangt, men de bor ganske billig.","zh":"房子有点挤，但她们住得挺便宜。","words":[[0,3,61.6,61.78,"det"],[4,6,61.78,62.04,"er"],[7,11,62.04,62.38,"litt~54360be2a478"],[12,18,62.38,63.05,"trangt"],[20,23,63.38,63.7,"men"],[24,26,63.7,63.86,"de"],[27,30,63.86,64.18,"bor"],[31,37,64.18,64.66,"ganske"],[38,44,64.66,65.04,"billig~ce46d827c8bd"]]},{"id":11,"start":66.03,"end":71.97,"text":"Noen ganger blir det veldig rotete i leiligheten, og de bytter på å rydde og vaske.","zh":"有时候公寓里会变得很乱，她们就轮流整理和打扫。","words":[[0,4,66.09,66.46,"noen~c766e2ef794d"],[5,11,66.46,67.08,"ganger~16c4f7d3feb9"],[12,16,67.08,67.26,"blir"],[17,20,67.26,67.44,"det"],[21,27,67.44,67.78,"veldig"],[28,34,67.78,68.36,"rotete"],[35,36,68.36,68.44,"i"],[37,48,68.44,69.24,"leiligheten"],[50,52,69.58,69.7,"og"],[53,55,69.7,69.88,"de"],[56,62,69.88,70.4,"bytter~2583a4dca541"],[63,65,70.4,70.72,"på~7015667c5161"],[66,67,70.82,70.94,"å~0583da7a620a"],[68,73,70.94,71.26,"rydde"],[74,76,71.26,71.34,"og"],[77,82,71.34,71.81,"vaske"]]},{"id":12,"start":73.48,"end":82.13,"text":"Av og til ringer Synne til Viola. Hun savner den nye venninna si som hun ble kjent med da hun bodde hjemme.","zh":"辛妮有时给维奥拉打电话。她很想念她住在家里时认识的这位新朋友。","words":[[0,2,73.54,73.74,"av~26a687fec87a"],[3,5,73.74,73.86,"og~a1e5742503b8"],[6,9,73.86,74.24,"til~69fe6862a430"],[10,16,74.4,74.88,"ringer~2a328146b7c5"],[17,22,74.88,75.28,"synne"],[23,26,75.28,75.5,"til~e7e10aca9191"],[27,32,75.5,76.12,"viola"],[34,37,77.22,77.56,"hun"],[38,44,77.56,78.18,"savner"],[45,48,78.18,78.4,"den~c9bab093e223"],[49,52,78.4,78.68,"nye"],[53,61,78.68,79.14,"venninna"],[62,64,79.14,79.46,"si~71b7a59b5fad"],[65,68,79.76,79.94,"som~b7970b8f941e"],[69,72,79.94,80.14,"hun"],[73,76,80.14,80.36,"ble"],[77,82,80.36,80.72,"kjent~43c3ae802868"],[83,86,80.72,80.96,"med~55c996fa7248"],[87,89,80.96,81.12,"da~3ded9627966c"],[90,93,81.12,81.3,"hun"],[94,99,81.3,81.6,"bodde"],[100,106,81.6,81.98,"hjemme"]]},{"id":13,"start":83.09,"end":89.99,"text":"Hun håper at Viola fortsatt trives som au pair, og at hun kan komme og besøke henne i Trondheim snart.","zh":"她希望维奥拉做互惠生仍然过得开心，也希望她很快能来特隆赫姆看她。","words":[[0,3,83.16,83.4,"hun"],[4,9,83.4,83.88,"håper"],[10,12,83.88,84.02,"at"],[13,18,84.02,84.48,"viola"],[19,27,84.48,84.88,"fortsatt"],[28,34,84.88,85.44,"trives"],[35,38,85.44,85.74,"som~ac9866165f47"],[39,41,85.74,85.88,"au"],[42,46,85.88,86.36,"pair"],[48,50,86.72,86.88,"og"],[51,53,86.88,87.02,"at"],[54,57,87.02,87.2,"hun"],[58,61,87.2,87.4,"kan"],[62,67,87.4,87.68,"komme"],[68,70,87.68,87.78,"og"],[71,77,87.78,88.32,"besøke"],[78,83,88.32,88.72,"henne"],[84,85,88.72,88.8,"i"],[86,95,88.8,89.36,"trondheim"],[96,101,89.36,89.84,"snart"]]},{"id":14,"start":93.2,"end":93.95,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,93.26,93.8,"fakta"]]},{"id":15,"start":94.8,"end":95.94,"text":"Lånekassen","subheading":true,"zh":"国家助学贷款局（Lånekassen）","words":[[0,10,94.86,95.79,"lånekassen"]]},{"id":16,"start":96.71,"end":101.52,"text":"Statens lånekasse for utdanning gir økonomisk støtte til utdanning.","zh":"挪威国家教育贷款基金为教育提供经济资助。","words":[[0,7,96.77,97.42,"statens"],[8,17,97.42,98.04,"lånekasse"],[18,21,98.04,98.24,"for~9df345e142f0"],[22,31,98.24,99.06,"utdanning"],[32,35,99.06,99.32,"gir"],[36,45,99.32,100.14,"økonomisk"],[46,52,100.14,100.56,"støtte~5abfdb2ff3ea"],[53,56,100.56,100.78,"til~cb0b728ccd2a"],[57,66,100.78,101.37,"utdanning"]]},{"id":17,"start":102.4,"end":105.13,"text":"Du kan søke om både stipend og lån.","zh":"你可以同时申请助学金和贷款。","words":[[0,2,102.46,102.62,"du"],[3,6,102.62,102.84,"kan"],[7,11,102.84,103.3,"søke"],[12,14,103.3,103.46,"om~e442de0b3aae"],[15,19,103.46,103.78,"både"],[20,27,103.78,104.48,"stipend"],[28,30,104.48,104.6,"og"],[31,34,104.6,104.98,"lån"]]},{"id":18,"start":105.97,"end":111.85,"text":"Stipendet er penger som du får, men studielånet må du betale tilbake.","zh":"助学金是直接给你的钱，但学生贷款你必须偿还。","words":[[0,9,106.03,106.82,"stipendet"],[10,12,106.82,107.04,"er"],[13,19,107.04,107.42,"penger"],[20,23,107.42,107.62,"som~b7970b8f941e"],[24,26,107.62,107.8,"du"],[27,30,107.8,108.26,"får"],[32,35,108.78,109.14,"men"],[36,47,109.14,110.38,"studielånet"],[48,50,110.38,110.52,"må"],[51,53,110.52,110.66,"du"],[54,60,110.66,111.14,"betale"],[61,68,111.14,111.7,"tilbake~300904b5c5d2"]]},{"id":19,"start":112.68,"end":118.97,"text":"De som ikke fullfører studiet, må også betale tilbake deler av stipendet sitt.","zh":"没有完成学业的人，还必须退还部分助学金。","words":[[0,2,112.74,112.96,"de~14b75bcb9523"],[3,6,112.96,113.34,"som~b7970b8f941e"],[7,11,113.34,113.8,"ikke"],[12,21,113.8,114.56,"fullfører"],[22,29,114.56,115.22,"studiet"],[31,33,115.52,115.72,"må"],[34,38,115.72,116.14,"også"],[39,45,116.14,116.62,"betale"],[46,53,116.62,117.36,"tilbake~d635d03351ce"],[54,59,117.36,117.76,"deler~83839213c743"],[60,62,117.76,117.92,"av"],[63,72,117.92,118.44,"stipendet"],[73,77,118.44,118.82,"sitt~9563d0679965"]]}],"lexicon":{"13.4":{"lemma":"13.4","zh":"第 13.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词",