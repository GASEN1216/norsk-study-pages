{"id":"13.4","title":"Å studere i Norge","audio":"audio/13.4.mp3","duration":122.05,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.13,"text":"13.4 Å studere i Norge","heading":true,"zh":"13.4 在挪威上大学","words":[[0,4,0.15,1.58,"13.4"],[5,6,2.76,2.86,"å~0583da7a620a"],[7,14,2.86,3.38,"studere"],[15,16,3.38,3.6,"i"],[17,22,3.6,4.05,"norge~546b56e35dd5"]]},{"id":1,"start":4.24,"end":10.17,"text":"Synne tar sykepleierutdanning på universitetet i Trondheim.","zh":"辛妮在特隆赫姆的大学读护理专业。","words":[[0,5,5.18,6.32,"synne"],[6,9,6.32,6.66,"tar~d70448b06558"],[10,29,6.66,7.92,"sykepleierutdanning"],[30,32,7.92,8.24,"på"],[33,46,8.24,9.26,"universitetet"],[47,48,9.26,9.4,"i"],[49,58,9.4,10.09,"trondheim"]]},{"id":2,"start":10.28,"end":19.65,"text":"Hun går på forelesninger, og hun sitter på universitetet og leser, men hun sitter også ofte på rommet sitt og arbeider.","zh":"她去听课，也坐在大学里看书学习，但她也常常坐在自己的房间里用功。","words":[[0,3,10.6,11.26,"hun"],[4,7,11.26,11.5,"går~f167a1defd28"],[8,10,11.5,11.8,"på~5cdff0766088"],[11,24,11.8,12.9,"forelesninger"],[26,28,13.58,13.6,"og"],[29,32,13.6,13.82,"hun"],[33,39,13.82,14.04,"sitter"],[40,42,14.04,14.4,"på"],[43,56,14.4,15.34,"universitetet"],[57,59,15.34,15.46,"og"],[60,65,15.46,15.98,"leser"],[67,70,16.5,16.74,"men"],[71,74,16.74,17.02,"hun"],[75,81,17.02,17.24,"sitter"],[82,86,17.24,17.6,"også"],[87,91,17.6,17.94,"ofte"],[92,94,17.94,18.08,"på"],[95,101,18.08,18.44,"rommet"],[102,106,18.44,18.62,"sitt~9563d0679965"],[107,109,18.62,18.88,"og"],[110,118,18.88,19.57,"arbeider~bb25b9573ee7"]]},{"id":3,"start":20.36,"end":25.94,"text":"I løpet av studiet skal hun levere mange oppgaver om ulike temaer.","zh":"在学习期间，她要交很多关于不同主题的作业。","words":[[0,1,20.5,21.0,"i~10efb4834efd"],[2,7,21.0,21.34,"løpet"],[8,10,21.34,21.48,"av~e5733f90a2a5"],[11,18,21.48,22.02,"studiet"],[19,23,22.02,22.66,"skal"],[24,27,22.66,22.9,"hun"],[28,34,22.9,23.28,"levere"],[35,40,23.28,23.6,"mange"],[41,49,23.6,24.28,"oppgaver~68b42ea0b737"],[50,52,24.28,24.6,"om~52c0bdc828db"],[53,58,24.6,25.1,"ulike"],[59,65,25.1,25.86,"temaer"]]},{"id":4,"start":27.0,"end":32.28,"text":"Oppgavene er obligatoriske, og hun jobber mye med oppgavene sine.","zh":"这些作业必须完成，她花很多精力做这些作业。","words":[[0,9,27.08,27.77,"oppgavene~bd8d758ac233"],[10,12,27.77,28.09,"er"],[13,26,28.09,29.23,"obligatoriske"],[28,30,29.83,29.93,"og"],[31,34,29.93,30.07,"hun"],[35,41,30.07,30.41,"jobber~0d5a0ada1330"],[42,45,30.41,30.93,"mye~933c5a923198"],[46,49,30.93,31.21,"med~21c674a34b32"],[50,59,31.21,31.77,"oppgavene~bd8d758ac233"],[60,64,31.77,32.2,"sine"]]},{"id":5,"start":33.94,"end":36.8,"text":"Annenhver helg jobber hun på et sykehjem.","zh":"她每隔一个周末在养老院工作。","words":[[0,9,34.64,34.64,"annenhver"],[10,14,34.64,35.28,"helg"],[15,21,35.28,35.5,"jobber~15f358646921"],[22,25,35.5,35.66,"hun"],[26,28,35.66,35.82,"på"],[29,31,35.82,35.98,"et~054dde72f37b"],[32,40,35.98,36.72,"sykehjem"]]},{"id":6,"start":37.74,"end":48.65,"text":"I disse helgene er hun ikke så mye sammen med venninnene sine, men det er viktig for henne å tjene noen ekstra penger i tillegg til studielånet.","zh":"这些周末她和女性朋友们在一起的时间不多，但对她来说，除了学生贷款之外再多挣点钱很重要。","words":[[0,1,37.82,38.1,"i~0bdedb551af0"],[2,7,38.1,38.44,"disse"],[8,15,38.44,39.0,"helgene"],[16,18,39.0,39.8,"er"],[19,22,39.8,39.98,"hun"],[23,27,39.98,40.26,"ikke"],[28,30,40.26,40.54,"så~02fe378ac702"],[31,34,40.54,40.9,"mye~933c5a923198"],[35,41,40.9,41.28,"sammen"],[42,45,41.28,41.42,"med"],[46,56,41.42,42.02,"venninnene"],[57,61,42.02,42.24,"sine"],[63,66,42.88,43.54,"men"],[67,70,43.54,43.76,"det~5e977a82af29"],[71,73,43.76,43.92,"er"],[74,80,43.92,44.28,"viktig"],[81,84,44.28,44.56,"for~da1a474a7e8c"],[85,90,44.56,44.82,"henne"],[91,92,44.82,45.06,"å~0583da7a620a"],[93,98,45.06,45.44,"tjene"],[99,103,45.44,45.86,"noen~c766e2ef794d"],[104,110,45.86,46.24,"ekstra"],[111,117,46.24,46.76,"penger"],[118,119,46.76,47.0,"i~7e9724ca6f08"],[120,127,47.0,47.56,"tillegg"],[128,131,47.56,47.66,"til~442b7ec806e8"],[132,143,47.66,48.57,"studielånet"]]},{"id":7,"start":49.24,"end":51.15,"text":"Hun trives i jobben sin.","zh":"她在工作中过得很愉快。","words":[[0,3,49.32,49.56,"hun"],[4,10,49.56,50.1,"trives"],[11,12,50.1,50.44,"i"],[13,19,50.44,50.74,"jobben"],[20,23,50.74,51.07,"sin"]]},{"id":8,"start":52.14,"end":56.73,"text":"Synne bor i kollektiv sammen med tre andre jenter.","zh":"辛妮和另外三个女孩合租。","words":[[0,5,52.84,53.62,"synne"],[6,9,53.62,53.84,"bor"],[10,11,53.84,54.1,"i"],[12,21,54.1,54.82,"kollektiv"],[22,28,55.02,55.34,"sammen"],[29,32,55.34,55.48,"med"],[33,36,55.48,55.72,"tre"],[37,42,55.72,56.12,"andre~0c69ef1e750c"],[43,49,56.12,56.65,"jenter"]]},{"id":9,"start":56.76,"end":60.8,"text":"De har felles stue, kjøkken og bad.","zh":"她们共用客厅、厨房和浴室。","words":[[0,2,57.13,57.83,"de"],[3,6,57.83,58.17,"har"],[7,13,58.17,58.69,"felles"],[14,18,58.69,59.17,"stue"],[20,27,59.51,59.99,"kjøkken"],[28,30,59.99,60.23,"og"],[31,34,60.23,60.72,"bad~7f12b44fb659"]]},{"id":10,"start":61.52,"end":65.14,"text":"Det er litt trangt, men de bor ganske billig.","zh":"房子有点挤，但她们住得挺便宜。","words":[[0,3,61.6,61.71,"det"],[4,6,61.71,61.93,"er"],[7,11,61.93,62.25,"litt~54360be2a478"],[12,18,62.27,62.89,"trangt"],[20,23,63.33,63.59,"men"],[24,26,63.59,63.81,"de"],[27,30,63.81,64.05,"bor"],[31,37,64.05,64.57,"ganske"],[38,44,64.57,65.06,"billig~ce46d827c8bd"]]},{"id":11,"start":65.99,"end":71.9,"text":"Noen ganger blir det veldig rotete i leiligheten, og de bytter på å rydde og vaske.","zh":"有时候公寓里会变得很乱，她们就轮流整理和打扫。","words":[[0,4,66.07,66.4,"noen~c766e2ef794d"],[5,11,66.4,66.74,"ganger~16c4f7d3feb9"],[12,16,66.74,67.2,"blir"],[17,20,67.2,67.32,"det"],[21,27,67.32,67.74,"veldig"],[28,34,67.74,68.24,"rotete"],[35,36,68.24,68.4,"i"],[37,48,68.4,68.92,"leiligheten"],[50,52,69.46,69.66,"og"],[53,55,69.66,69.8,"de"],[56,62,69.8,70.28,"bytter~2583a4dca541"],[63,65,70.28,70.52,"på~7015667c5161"],[66,67,70.52,70.88,"å~0583da7a620a"],[68,73,70.88,71.2,"rydde"],[74,76,71.2,71.3,"og"],[77,82,71.3,71.82,"vaske"]]},{"id":12,"start":73.43,"end":82.07,"text":"Av og til ringer Synne til Viola. Hun savner den nye venninna si som hun ble kjent med da hun bodde hjemme.","zh":"辛妮有时给维奥拉打电话。她很想念她住在家里时认识的这位新朋友。","words":[[0,2,73.51,73.72,"av~26a687fec87a"],[3,5,73.72,73.8,"og~a1e5742503b8"],[6,9,73.8,74.06,"til~69fe6862a430"],[10,16,74.06,74.76,"ringer~2a328146b7c5"],[17,22,74.76,75.22,"synne"],[23,26,75.22,75.42,"til~e7e10aca9191"],[27,32,75.42,75.86,"viola"],[34,37,75.86,76.08,"hun"],[38,44,76.08,78.0,"savner"],[45,48,78.0,78.34,"den~c9bab093e223"],[49,52,78.34,78.62,"nye"],[53,61,78.62,79.04,"venninna"],[62,64,79.04,79.26,"si~71b7a59b5fad"],[65,68,79.72,79.9,"som~b7970b8f941e"],[69,72,79.9,80.08,"hun"],[73,76,80.08,80.28,"ble"],[77,82,80.28,80.58,"kjent~43c3ae802868"],[83,86,80.58,80.86,"med~55c996fa7248"],[87,89,80.86,81.06,"da~3ded9627966c"],[90,93,81.06,81.24,"hun"],[94,99,81.24,81.54,"bodde"],[100,106,81.54,81.99,"hjemme"]]},{"id":13,"start":82.55,"end":89.93,"text":"Hun håper at Viola fortsatt trives som au pair, og at hun kan komme og besøke henne i Trondheim snart.","zh":"她希望维奥拉做互惠生仍然过得开心，也希望她很快能来特隆赫姆看她。","words":[[0,3,82.76,83.28,"hun"],[4,9,83.28,83.76,"håper"],[10,12,83.76,83.96,"at"],[13,18,83.96,84.32,"viola"],[19,27,84.32,84.76,"fortsatt"],[28,34,84.76,85.28,"trives"],[35,38,85.28,85.56,"som~ac9866165f47"],[39,41,85.56,86.11,"au"],[42,46,86.11,86.66,"pair"],[48,50,86.66,86.82,"og"],[51,53,86.82,86.98,"at"],[54,57,86.98,87.1,"hun"],[58,61,87.1,87.3,"kan"],[62,67,87.3,87.52,"komme"],[68,70,87.52,87.72,"og"],[71,77,87.72,88.24,"besøke"],[78,83,88.24,88.54,"henne"],[84,85,88.54,88.76,"i"],[86,95,88.76,89.18,"trondheim"],[96,101,89.18,89.85,"snart"]]},{"id":14,"start":93.16,"end":93.84,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,93.24,93.76,"fakta"]]},{"id":15,"start":94.76,"end":95.86,"text":"Lånekassen","subheading":true,"zh":"国家助学贷款局（Lånekassen）","words":[[0,10,94.84,95.78,"lånekassen"]]},{"id":16,"start":96.67,"end":101.45,"text":"Statens lånekasse for utdanning gir økonomisk støtte til utdanning.","zh":"挪威国家教育贷款基金为教育提供经济资助。","words":[[0,7,96.75,97.27,"statens"],[8,17,97.27,97.95,"lånekasse"],[18,21,97.95,98.13,"for~9df345e142f0"],[22,31,98.13,98.79,"utdanning"],[32,35,98.79,99.19,"gir"],[36,45,99.19,100.01,"økonomisk"],[46,52,100.01,100.45,"støtte~5abfdb2ff3ea"],[53,56,100.45,100.65,"til~cb0b728ccd2a"],[57,66,100.65,101.38,"utdanning"]]},{"id":17,"start":102.37,"end":105.07,"text":"Du kan søke om både stipend og lån.","zh":"你可以同时申请助学金和贷款。","words":[[0,2,102.45,102.54,"du"],[3,6,102.54,102.72,"kan"],[7,11,102.72,103.16,"søke"],[12,14,103.16,103.36,"om~e442de0b3aae"],[15,19,103.36,103.68,"både"],[20,27,103.68,104.22,"stipend"],[28,30,104.22,104.54,"og"],[31,34,104.54,104.99,"lån"]]},{"id":18,"start":105.54,"end":111.81,"text":"Stipendet er penger som du får, men studielånet må du betale tilbake.","zh":"助学金是直接给你的钱，但学生贷款你必须偿还。","words":[[0,9,105.62,106.73,"stipendet"],[10,12,106.73,106.95,"er"],[13,19,106.95,107.35,"penger"],[20,23,107.35,107.53,"som~b7970b8f941e"],[24,26,107.53,107.71,"du"],[27,30,107.71,108.11,"får"],[32,35,108.59,108.97,"men"],[36,47,108.97,110.11,"studielånet"],[48,50,110.11,110.47,"må"],[51,53,110.47,110.59,"du"],[54,60,110.59,111.05,"betale"],[61,68,111.05,111.73,"tilbake~300904b5c5d2"]]},{"id":19,"start":112.64,"end":118.91,"text":"De som ikke fullfører studiet, må også betale tilbake deler av stipendet sitt.","zh":"没有完成学业的人，还必须退还部分助学金。","words":[[0,2,112.72,112.89,"de~14b75bcb9523"],[3,6,112.89,113.15,"som~b7970b8f941e"],[7,11,113.15,113.63,"ikke"],[12,21,113.63,114.47,"fullfører"],[22,29,114.47,115.03,"studiet"],[31,33,115.49,115.63,"må"],[34,38,115.63,116.01,"også"],[39,45,116.01,116.55,"betale"],[46,53,116.59,117.11,"tilbake~d635d03351ce"],[54,59,117.11,117.69,"deler~83839213c743"],[60,62,117.69,117.85,"av"],[63,72,117.85,118.41,"stipendet"],[73,77,118.41,118.83,"sitt~9563d0679965"]]}],"lexicon":{"13.4":{"lemma":"13.4","zh":"第 13.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词