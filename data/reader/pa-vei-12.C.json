{"id":"pa-vei-12.C","bookId":"pa-vei-textbook","readingId":"12.C","title":"Typisk norsk?","audio":"audio/pa-vei/12.C.mp3","duration":106.176,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.14,"end":6.245,"text":"Det er typisk norsk å spise hvalkjøtt, sier Pablo til Haifa.","zh":"巴勃罗对海法说，吃鲸肉是很典型的挪威习惯。","words":[[0,3,1.14,1.302,"det"],[4,6,1.302,1.445,"er"],[7,13,1.52,2.285,"typisk"],[14,19,2.32,2.725,"norsk@pa-vei-norsk-adjective"],[20,21,2.9,3.002,"å"],[22,27,3.002,3.345,"spise"],[28,37,3.4,4.225,"hvalkjøtt"],[39,43,4.8,5.085,"sier"],[44,49,5.14,5.625,"pablo"],[50,53,5.64,5.825,"til"],[54,59,5.84,6.245,"haifa"]]},{"id":1,"start":8.208,"end":16.433,"text":"Andre vil si at det er typisk norsk å spise vafler, drikke mye melk eller gå på tur i allslags vær.","zh":"也有人会说，吃华夫饼、喝很多牛奶，或者无论什么天气都去徒步，才是典型的挪威习惯。","words":[[0,5,8.208,8.613,"andre"],[6,9,8.628,8.793,"vil"],[10,12,8.888,9.053,"si"],[13,15,9.128,9.251,"at"],[16,19,9.251,9.361,"det"],[20,22,9.361,9.473,"er"],[23,29,9.548,10.233,"typisk"],[30,35,10.268,10.693,"norsk@pa-vei-norsk-adjective"],[36,37,10.948,11.04,"å"],[38,43,11.04,11.373,"spise"],[44,50,11.408,11.933,"vafler"],[52,58,12.568,12.96,"drikke"],[59,62,12.96,13.191,"mye"],[63,67,13.191,13.673,"melk"],[68,73,14.508,14.79,"eller"],[74,76,14.79,14.933,"gå"],[77,79,14.988,15.133,"på"],[80,83,15.168,15.48,"tur"],[84,85,15.48,15.573,"i"],[86,94,15.628,16.133,"allslags"],[95,98,16.148,16.433,"vær"]]},{"id":2,"start":18.328,"end":24.533,"text":"Her forteller Ebow Annan fra Ghana hva han mener er typisk norsk:","zh":"下面，来自加纳的埃博·安南讲述他眼中典型的挪威习惯：","words":[[0,3,18.328,18.593,"her"],[4,13,18.628,19.133,"forteller"],[14,18,19.308,19.793,"ebow"],[19,24,19.928,20.353,"annan"],[25,28,20.668,20.833,"fra"],[29,34,20.928,21.373,"ghana"],[35,38,22.028,22.213,"hva"],[39,42,22.368,22.593,"han"],[43,48,22.928,23.333,"mener"],[49,51,23.488,23.63,"er"],[52,58,23.63,24.151,"typisk"],[59,64,24.151,24.533,"norsk@pa-vei-norsk-adjective"]]},{"id":3,"start":26.748,"end":31.693,"text":"Jeg heter Ebow Annan, er 24 år gammel og kommer fra Ghana.","zh":"我叫埃博·安南，24 岁，来自加纳。","words":[[0,3,26.748,26.973,"jeg"],[4,9,27.088,27.473,"heter"],[10,14,27.528,27.87,"ebow"],[15,20,27.87,28.233,"annan"],[22,24,29.208,29.34,"er"],[25,27,29.34,29.793,"24"],[28,30,29.808,29.99,"år"],[31,37,29.99,30.333,"gammel"],[38,40,30.788,30.901,"og"],[41,47,30.901,31.18,"kommer"],[48,51,31.18,31.333,"fra"],[52,57,31.348,31.693,"ghana"]],"speaker":"Ebow Annan"},{"id":4,"start":33.408,"end":35.133,"text":"Jeg har bodd i Norge i fire år.","zh":"我在挪威住了四年。","words":[[0,3,33.408,33.593,"jeg"],[4,7,33.608,33.77,"har"],[8,12,33.77,34.011,"bodd"],[13,14,34.011,34.121,"i"],[15,20,34.121,34.473,"norge"],[21,22,34.508,34.613,"i"],[23,27,34.668,34.96,"fire"],[28,30,34.96,35.133,"år"]],"speaker":"Ebow Annan"},{"id":5,"start":36.548,"end":42.553,"text":"For tre år siden møtte jeg en hyggelig, norsk familie, og de inviterte meg på hyttetur på fjellet.","zh":"三年前，我认识了一个友善的挪威家庭，他们邀请我到山里的度假屋去玩。","words":[[0,3,36.548,36.691,"for"],[4,7,36.691,36.893,"tre"],[8,10,36.988,37.171,"år"],[11,16,37.171,37.513,"siden"],[17,22,37.668,37.96,"møtte"],[23,26,37.96,38.121,"jeg"],[27,29,38.121,38.251,"en"],[30,38,38.251,38.733,"hyggelig"],[40,45,38.788,39.133,"norsk@pa-vei-norsk-adjective"],[46,53,39.168,39.653,"familie"],[55,57,40.288,40.41,"og"],[58,60,40.41,40.553,"de"],[61,70,40.668,41.27,"inviterte"],[71,74,41.27,41.45,"meg"],[75,77,41.45,41.59,"på"],[78,86,41.59,42.07,"hyttetur"],[87,89,42.07,42.191,"på"],[90,97,42.191,42.553,"fjellet"]],"speaker":"Ebow Annan"},{"id":6,"start":43.948,"end":46.913,"text":"Jeg ble veldig glad og tok på meg pene klær og sko.","zh":"我很高兴，穿上了漂亮的衣服和鞋。","words":[[0,3,43.948,44.151,"jeg"],[4,7,44.151,44.313,"ble"],[8,14,44.328,44.651,"veldig"],[15,19,44.651,44.893,"glad"],[20,22,45.248,45.37,"og"],[23,26,45.37,45.59,"tok"],[27,29,45.59,45.701,"på"],[30,33,45.701,45.853,"meg"],[34,38,45.868,46.251,"pene"],[39,43,46.251,46.6,"klær"],[44,46,46.6,46.721,"og"],[47,50,46.721,46.913,"sko"]],"speaker":"Ebow Annan"},{"id":7,"start":48.408,"end":49.953,"text":"Det var helt feil!","zh":"这完全弄错了！","words":[[0,3,48.408,48.593,"det"],[4,7,49.068,49.253,"var"],[8,12,49.348,49.673,"helt"],[13,17,49.688,49.953,"feil"]],"speaker":"Ebow Annan"},{"id":8,"start":50.988,"end":54.253,"text":"Vi gikk i en halv time fra parkeringsplassen og til hytta.","zh":"我们从停车场走了半个小时才到度假屋。","words":[[0,2,50.988,51.113,"vi"],[3,7,51.128,51.4,"gikk"],[8,9,51.4,51.501,"i"],[10,12,51.501,51.613,"en"],[13,17,51.648,51.933,"halv"],[18,22,51.968,52.333,"time"],[23,26,52.428,52.611,"fra"],[27,44,52.611,53.513,"parkeringsplassen"],[45,47,53.708,53.82,"og"],[48,51,53.82,53.96,"til"],[52,57,53.96,54.253,"hytta"]],"speaker":"Ebow Annan"},{"id":9,"start":55.368,"end":59.293,"text":"Det var ikke vei til hytta, og skoene mine ble våte og skitne.","zh":"没有通往度假屋的路，我的鞋又湿又脏。","words":[[0,3,55.368,55.511,"det"],[4,7,55.511,55.641,"var"],[8,12,55.641,55.873,"ikke"],[13,16,55.888,56.093,"vei"],[17,20,56.188,56.35,"til"],[21,26,56.35,56.693,"hytta"],[28,30,57.228,57.37,"og"],[31,37,57.37,57.77,"skoene"],[38,42,57.77,58.073,"mine"],[43,46,58.088,58.253,"ble"],[47,51,58.308,58.751,"våte"],[52,54,58.751,58.861,"og"],[55,61,58.861,59.293,"skitne"]],"speaker":"Ebow Annan"},{"id":10,"start":60.628,"end":61.093,"text":"Og hytta?","zh":"那间度假屋呢？","words":[[0,2,60.628,60.76,"og"],[3,8,60.76,61.093,"hytta"]],"speaker":"Ebow Annan"},{"id":11,"start":62.208,"end":64.653,"text":"Den var lita og hadde ikke strøm eller vann.","zh":"它很小，既没电也没有自来水。","words":[[0,3,62.208,62.433,"den"],[4,7,62.508,62.673,"var"],[8,12,62.688,63.073,"lita"],[13,15,63.348,63.481,"og"],[16,21,63.481,63.691,"hadde"],[22,26,63.691,63.891,"ikke"],[27,32,63.891,64.153,"strøm"],[33,38,64.208,64.41,"eller"],[39,43,64.41,64.653,"vann"]],"speaker":"Ebow Annan"},{"id":12,"start":66.008,"end":68.533,"text":"Familien hentet vann fra ei elv i nærheten.","zh":"这家人到附近的小河取水。","words":[[0,8,66.008,66.541,"familien"],[9,15,66.541,66.933,"hentet"],[16,20,66.948,67.233,"vann"],[21,24,67.248,67.433,"fra"],[25,27,67.448,67.593,"ei"],[28,31,67.648,67.951,"elv"],[32,33,67.951,68.041,"i"],[34,42,68.041,68.533,"nærheten"]],"speaker":"Ebow Annan"},{"id":13,"start":69.988,"end":71.293,"text":"Men det var ikke det verste.","zh":"不过这还不是最糟的。","words":[[0,3,69.988,70.153,"men"],[4,7,70.188,70.373,"det"],[8,11,70.448,70.62,"var"],[12,16,70.62,70.831,"ikke"],[17,20,70.831,70.941,"det@pa-vei-det-definite"],[21,27,70.941,71.293,"verste"]],"speaker":"Ebow Annan"},{"id":14,"start":72.718,"end":78.883,"text":"Hytta hadde ikke WC, men et lite hus, en «utedo» ti meter fra hytta.","zh":"屋里没有厕所，只有离屋十米远的一间小房子，叫作“户外厕所”。","words":[[0,5,72.718,73.081,"hytta"],[6,11,73.081,73.32,"hadde"],[12,16,73.32,73.511,"ikke"],[17,19,73.511,73.863,"wc"],[21,24,74.838,75.0,"men"],[25,27,75.0,75.141,"et"],[28,32,75.141,75.421,"lite"],[33,36,75.421,75.783,"hus"],[38,40,76.378,76.543,"en"],[42,47,76.818,77.383,"utedo"],[49,51,77.818,77.983,"ti"],[52,57,78.098,78.43,"meter"],[58,61,78.43,78.59,"fra"],[62,67,78.59,78.883,"hytta"]],"speaker":"Ebow Annan"},{"id":15,"start":80.158,"end":81.583,"text":"Det luktet ikke godt der!","zh":"那里可不好闻！","words":[[0,3,80.158,80.31,"det"],[4,10,80.31,80.703,"luktet"],[11,15,80.798,81.16,"ikke"],[16,20,81.16,81.41,"godt"],[21,24,81.41,81.583,"der"]],"speaker":"Ebow Annan"},{"id":16,"start":82.908,"end":87.373,"text":"Familien var ganske rik, men de elsket hytta si og reiste ofte dit.","zh":"这家人相当有钱，但他们很爱自己的度假屋，经常去那里。","words":[[0,8,82.908,83.433,"familien"],[9,12,83.448,83.65,"var"],[13,19,83.65,83.981,"ganske"],[20,23,83.981,84.293,"rik"],[25,28,84.628,84.77,"men"],[29,31,84.77,84.893,"de"],[32,38,84.928,85.361,"elsket"],[39,44,85.361,85.673,"hytta"],[45,47,85.688,85.833,"si@pa-vei-si-possessive"],[48,50,86.348,86.481,"og"],[51,57,86.481,86.833,"reiste"],[58,62,86.848,87.111,"ofte"],[63,66,87.111,87.373,"dit"]],"speaker":"Ebow Annan"},{"id":17,"start":89.368,"end":96.413,"text":"I dag vet jeg at mange norske hytter har strøm og vann, men jeg tror likevel at «min» familie er typisk norsk.","zh":"现在我知道，很多挪威度假屋都有电和自来水，但我仍然觉得“我的”这个家庭很典型。","words":[[0,1,89.368,89.473,"i"],[2,5,89.488,89.813,"dag"],[6,9,89.848,90.12,"vet"],[10,13,90.12,90.27,"jeg"],[14,16,90.27,90.41,"at"],[17,22,90.41,90.693,"mange"],[23,29,90.708,91.06,"norske"],[30,36,91.06,91.473,"hytter"],[37,40,91.488,91.631,"har"],[41,46,91.631,91.933,"strøm"],[47,49,92.048,92.16,"og"],[50,54,92.16,92.433,"vann"],[56,59,93.008,93.15,"men"],[60,63,93.15,93.281,"jeg"],[64,68,93.281,93.513,"tror"],[69,76,93.528,94.02,"likevel"],[77,79,94.02,94.173,"at"],[81,84,94.248,94.473,"min"],[86,93,94.548,95.053,"familie"],[94,96,95.488,95.631,"er"],[97,103,95.631,96.071,"typisk"],[104,109,96.071,96.413,"norsk@pa-vei-norsk-adjective"]],"speaker":"Ebow Annan"},{"id":18,"start":97.688,"end":101.913,"text":"De liker at hytta er lita og primitiv og ligger langt fra andre folk.","zh":"他们喜欢小巧、简陋而又远离人群的度假屋。","words":[[0,2,97.688,97.833,"de"],[3,8,97.868,98.27,"liker"],[9,11,98.27,98.391,"at"],[12,17,98.391,98.731,"hytta"],[18,20,98.731,98.87,"er"],[21,25,98.87,99.293,"lita"],[26,28,99.348,99.473,"og"],[29,37,99.508,100.073,"primitiv"],[38,40,100.508,100.62,"og"],[41,47,100.62,100.87,"ligger"],[48,53,100.87,101.201,"langt"],[54,57,101.201,101.351,"fra"],[58,63,101.351,101.611,"andre"],[64,68,101.611,101.913,"folk"]],"speaker":"Ebow Annan"},{"id":19,"start":103.508,"end":104.793,"text":"Det synes jeg er litt rart.","zh":"我觉得这有点奇怪。","words":[[0,3,103.508,103.653,"det"],[4,9,103.668,104.001,"synes"],[10,13,104.001,104.16,"jeg"],[14,16,104.16,104.261,"er"],[17,21,104.261,104.43,"litt"],[22,26,104.43,104.793,"rart"]],"speaker":"Ebow Annan"}],"lexicon":{"24":{"lemma":"24","pos":"数词","zh":"数字 24","ref":null,"clip":null},"allslags":{"lemma":"allslags","zh":"各种各样的","pos":"形容词","ref":"pa-vei-12-047","clip":null},"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"annan":{"lemma":"Annan","pos":"专名","zh":"安南（姓氏）","ref":nu