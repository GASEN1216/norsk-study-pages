{"id":"4.5","title":"Yrkestekst: Jeg er servitør","audio":"audio/4.5.mp3","duration":82.79,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.5,"text":"4.5 Yrke: Jeg er servitør","heading":true,"zh":"4.5 职业：我是服务员","words":[[0,3,0.15,1.3,"4.5"],[4,8,2.32,2.7,"yrke"],[10,13,3.95,4.25,"jeg"],[14,16,4.25,4.59,"er"],[17,25,4.59,5.42,"servitør"]]},{"id":1,"start":8.01,"end":11.65,"text":"Jeg er servitør og jobber på en restaurant.","zh":"我是服务员，在一家餐厅工作。","words":[[0,3,8.07,8.48,"jeg"],[4,6,8.48,8.72,"er"],[7,15,8.72,9.6,"servitør"],[16,18,10.0,10.18,"og"],[19,25,10.18,10.62,"jobber~003ddb6d77e6"],[26,28,10.62,10.78,"på"],[29,31,10.78,10.9,"en~a939a9e56dc5"],[32,42,10.9,11.5,"restaurant"]]},{"id":2,"start":12.53,"end":13.96,"text":"Vi har mange gjester.","zh":"我们有很多客人。","words":[[0,2,12.59,12.72,"vi"],[3,6,12.72,12.96,"har"],[7,12,12.96,13.36,"mange"],[13,20,13.36,13.81,"gjester"]]},{"id":3,"start":15.03,"end":18.62,"text":"Gjestene får menyen og bestiller mat og drikke.","zh":"客人拿到菜单，点菜和饮料。","words":[[0,8,15.09,15.64,"gjestene"],[9,12,15.64,15.88,"får"],[13,19,15.88,16.47,"menyen"],[20,22,16.78,16.9,"og"],[23,32,16.9,17.42,"bestiller"],[33,36,17.42,17.96,"mat"],[37,39,17.96,18.06,"og"],[40,46,18.06,18.48,"drikke~304881dd2961"]]},{"id":4,"start":19.75,"end":24.16,"text":"Jeg leverer bestillingen til kjøkkenet, og en kokk lager maten.","zh":"我把订单交给厨房，由厨师做菜。","words":[[0,3,19.81,20.1,"jeg"],[4,11,20.1,20.64,"leverer~5df63c914d59"],[12,24,20.64,21.26,"bestillingen"],[25,28,21.26,21.52,"til"],[29,38,21.52,22.13,"kjøkkenet"],[40,42,22.48,22.6,"og"],[43,45,22.6,22.76,"en~a939a9e56dc5"],[46,50,22.76,23.26,"kokk"],[51,56,23.26,23.62,"lager~02acfedd4ab0"],[57,62,23.62,24.01,"maten"]]},{"id":5,"start":25.24,"end":28.52,"text":"Jeg henter maten på kjøkkenet og serverer den.","zh":"我去厨房取菜，然后端上桌。","words":[[0,3,25.3,25.64,"jeg"],[4,10,25.64,26.1,"henter"],[11,16,26.1,26.52,"maten"],[17,19,26.52,26.74,"på"],[20,29,26.74,27.34,"kjøkkenet"],[30,32,27.64,27.76,"og"],[33,41,27.76,28.16,"serverer"],[42,45,28.16,28.37,"den"]]},{"id":6,"start":29.74,"end":32.66,"text":"Jeg liker å servere god mat til gjestene.","zh":"我喜欢给客人端上美味的饭菜。","words":[[0,3,29.8,30.02,"jeg"],[4,9,30.02,30.56,"liker"],[10,11,30.56,30.68,"å~0583da7a620a"],[12,19,30.68,31.2,"servere"],[20,23,31.2,31.46,"god"],[24,27,31.46,31.86,"mat"],[28,31,31.86,32.04,"til"],[32,40,32.04,32.52,"gjestene"]]},{"id":7,"start":33.55,"end":35.64,"text":"De spiser og koser seg.","zh":"他们吃得很开心。","words":[[0,2,33.61,33.8,"de"],[3,9,33.8,34.67,"spiser"],[10,12,34.78,34.9,"og"],[13,18,34.9,35.26,"koser"],[19,22,35.26,35.49,"seg"]]},{"id":8,"start":36.73,"end":38.63,"text":"Til slutt rydder jeg bordet.","zh":"最后我收拾桌子。","words":[[0,3,36.79,37.02,"til~670533c5eb47"],[4,9,37.02,37.53,"slutt~8b571dca0f08"],[10,16,37.72,38.02,"rydder"],[17,20,38.02,38.18,"jeg"],[21,27,38.18,38.48,"bordet"]]},{"id":9,"start":41.18,"end":42.12,"text":"På kafé","zh":"在咖啡馆","words":[[0,2,41.24,41.54,"på"],[3,7,41.54,41.98,"kafé"]]},{"id":10,"start":43.68,"end":45.98,"text":"Jeg vil ha en kopp kaffe.","zh":"我要一杯咖啡。","words":[[0,3,43.74,44.18,"jeg"],[4,7,44.18,44.4,"vil"],[8,10,44.4,44.66,"ha~7724ec04e04d"],[11,13,44.66,44.88,"en~a939a9e56dc5"],[14,18,44.88,45.3,"kopp"],[19,24,45.3,45.83,"kaffe"]]},{"id":11,"start":46.92,"end":48.17,"text":"Hva vil du ha?","zh":"你要什么？","words":[[0,3,46.98,47.24,"hva"],[4,7,47.24,47.5,"vil"],[8,10,47.5,47.78,"du"],[11,13,47.78,48.02,"ha~7724ec04e04d"]]},{"id":12,"start":49.27,"end":50.7,"text":"Jeg tar en kopp te.","zh":"我要一杯茶。","words":[[0,3,49.33,49.7,"jeg"],[4,7,49.7,49.9,"tar~b60eb818ae9a"],[8,10,49.9,50.02,"en~a939a9e56dc5"],[11,15,50.02,50.24,"kopp"],[16,18,50.24,50.55,"te"]]},{"id":13,"start":51.4,"end":52.96,"text":"Jeg liker ikke kaffe.","zh":"我不喜欢咖啡。","words":[[0,3,51.46,51.74,"jeg"],[4,9,51.74,52.1,"liker"],[10,14,52.1,52.42,"ikke"],[15,20,52.42,52.81,"kaffe"]]},{"id":14,"start":55.72,"end":57.06,"text":"Hva har du lyst på?","zh":"你想要点什么？","words":[[0,3,55.78,56.08,"hva"],[4,7,56.08,56.22,"har~2fe5eb128613"],[8,10,56.22,56.4,"du"],[11,15,56.4,56.7,"lyst~0eef5d2ccab2"],[16,18,56.7,56.91,"på~40ad664c0969"]]},{"id":15,"start":58.08,"end":59.66,"text":"Jeg har lyst på sushi.","zh":"我想吃寿司。","words":[[0,3,58.14,58.38,"jeg"],[4,7,58.38,58.5,"har~2fe5eb128613"],[8,12,58.5,58.78,"lyst~0eef5d2ccab2"],[13,15,58.78,59.12,"på~40ad664c0969"],[16,21,59.12,59.52,"sushi"]]},{"id":16,"start":60.69,"end":62.41,"text":"Jeg liker ikke sushi.","zh":"我不喜欢寿司。","words":[[0,3,60.75,61.1,"jeg"],[4,9,61.1,61.54,"liker"],[10,14,61.54,61.8,"ikke"],[15,20,61.8,62.27,"sushi"]]},{"id":17,"start":63.06,"end":65.07,"text":"Jeg tar en hamburger.","zh":"我要一个汉堡。","words":[[0,3,63.12,63.63,"jeg"],[4,7,63.74,63.98,"tar~b60eb818ae9a"],[8,10,63.98,64.12,"en~a939a9e56dc5"],[11,20,64.12,64.92,"hamburger"]]},{"id":18,"start":67.68,"end":69.33,"text":"Hva vil dere bestille?","speaker":"Servitør","zh":"你们想点什么？","words":[[0,3,67.74,68.14,"hva"],[4,7,68.14,68.34,"vil"],[8,12,68.34,68.64,"dere"],[13,21,68.64,69.18,"bestille"]]},{"id":19,"start":70.53,"end":75.09,"text":"Jeg vil gjerne ha en vaffel og et glass cola.","zh":"我想要一份华夫饼和一杯可乐。","words":[[0,3,70.59,71.04,"jeg"],[4,7,71.04,71.24,"vil"],[8,14,71.24,71.74,"gjerne"],[15,17,71.74,72.06,"ha~7724ec04e04d"],[18,20,72.06,72.56,"en~a939a9e56dc5"],[21,27,72.76,73.44,"vaffel"],[28,30,73.58,73.72,"og"],[31,33,73.72,73.94,"et~054dde72f37b"],[34,39,73.94,74.42,"glass"],[40,44,74.42,74.94,"cola"]]},{"id":20,"start":76.52,"end":81.51,"text":"Jeg har lyst på sjokoladekake og en kopp kaffe uten melk.","zh":"我想要巧克力蛋糕和一杯不加牛奶的咖啡。","words":[[0,3,76.58,76.92,"jeg"],[4,7,76.92,77.08,"har~2fe5eb128613"],[8,12,77.08,77.42,"lyst~0eef5d2ccab2"],[13,15,77.42,77.68,"på~40ad664c0969"],[16,29,77.68,78.76,"sjokoladekake"],[30,32,78.9,79.18,"og"],[33,35,79.38,79.58,"en~a939a9e56dc5"],[36,40,79.58,79.86,"kopp"],[41,46,79.86,80.5,"kaffe"],[47,51,80.5,80.9,"uten"],[52,56,80.9,81.36,"melk"]]}],"lexicon":{"4.5":{"lemma":"4.5","zh":"第 4.5 节","pos":"编号","ref":null,"clip":null,"k