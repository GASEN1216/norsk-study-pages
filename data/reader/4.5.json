{"id":"4.5","title":"Yrkestekst: Jeg er servitør","audio":"audio/4.5.mp3","duration":82.79,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.5,"text":"4.5 Yrke: Jeg er servitør","heading":true,"zh":"4.5 职业：我是服务员","words":[[0,3,0.15,1.3,"4.5"],[4,8,2.32,2.7,"yrke"],[10,13,3.95,4.25,"jeg"],[14,16,4.25,4.59,"er"],[17,25,4.59,5.42,"servitør"]]},{"id":1,"start":7.97,"end":11.59,"text":"Jeg er servitør og jobber på en restaurant.","zh":"我是服务员，在一家餐厅工作。","words":[[0,3,8.05,8.36,"jeg"],[4,6,8.36,8.62,"er"],[7,15,8.62,9.32,"servitør"],[16,18,9.32,10.08,"og"],[19,25,10.08,10.5,"jobber~003ddb6d77e6"],[26,28,10.5,10.74,"på"],[29,31,10.74,10.88,"en~a939a9e56dc5"],[32,42,10.88,11.51,"restaurant"]]},{"id":2,"start":12.5,"end":13.91,"text":"Vi har mange gjester.","zh":"我们有很多客人。","words":[[0,2,12.58,12.7,"vi"],[3,6,12.7,12.84,"har"],[7,12,12.84,13.22,"mange"],[13,20,13.22,13.83,"gjester"]]},{"id":3,"start":14.98,"end":18.69,"text":"Gjestene får menyen og bestiller mat og drikke.","zh":"客人拿到菜单，点菜和饮料。","words":[[0,8,15.06,15.55,"gjestene"],[9,12,15.55,15.77,"får"],[13,19,15.77,16.21,"menyen"],[20,22,16.21,16.85,"og"],[23,32,16.85,17.29,"bestiller"],[33,36,17.29,17.63,"mat"],[37,39,17.63,18.03,"og"],[40,46,18.03,18.61,"drikke~304881dd2961"]]},{"id":4,"start":19.71,"end":24.11,"text":"Jeg leverer bestillingen til kjøkkenet, og en kokk lager maten.","zh":"我把订单交给厨房，由厨师做菜。","words":[[0,3,19.79,20.04,"jeg"],[4,11,20.04,20.58,"leverer~5df63c914d59"],[12,24,20.58,21.2,"bestillingen"],[25,28,21.2,21.34,"til"],[29,38,21.34,21.94,"kjøkkenet"],[40,42,22.28,22.56,"og"],[43,45,22.56,22.72,"en~a939a9e56dc5"],[46,50,22.72,23.14,"kokk"],[51,56,23.14,23.52,"lager~02acfedd4ab0"],[57,62,23.52,24.03,"maten"]]},{"id":5,"start":25.2,"end":28.44,"text":"Jeg henter maten på kjøkkenet og serverer den.","zh":"我去厨房取菜，然后端上桌。","words":[[0,3,25.28,25.56,"jeg"],[4,10,25.56,25.98,"henter"],[11,16,25.98,26.44,"maten"],[17,19,26.44,26.66,"på"],[20,29,26.66,27.16,"kjøkkenet"],[30,32,27.16,27.7,"og"],[33,41,27.7,28.14,"serverer"],[42,45,28.14,28.36,"den"]]},{"id":6,"start":29.64,"end":32.61,"text":"Jeg liker å servere god mat til gjestene.","zh":"我喜欢给客人端上美味的饭菜。","words":[[0,3,29.72,29.94,"jeg"],[4,9,29.94,30.48,"liker"],[10,11,30.48,30.64,"å~0583da7a620a"],[12,19,30.64,31.08,"servere"],[20,23,31.08,31.38,"god"],[24,27,31.38,31.68,"mat"],[28,31,31.68,31.96,"til"],[32,40,31.96,32.53,"gjestene"]]},{"id":7,"start":33.52,"end":35.57,"text":"De spiser og koser seg.","zh":"他们吃得很开心。","words":[[0,2,33.6,33.75,"de"],[3,9,33.75,34.45,"spiser"],[10,12,34.45,34.85,"og"],[13,18,34.85,35.21,"koser"],[19,22,35.21,35.49,"seg"]]},{"id":8,"start":36.69,"end":38.57,"text":"Til slutt rydder jeg bordet.","zh":"最后我收拾桌子。","words":[[0,3,36.77,36.91,"til~670533c5eb47"],[4,9,36.91,37.31,"slutt~8b571dca0f08"],[10,16,37.31,37.99,"rydder"],[17,20,37.99,38.09,"jeg"],[21,27,38.09,38.49,"bordet"]]},{"id":9,"start":41.15,"end":42.07,"text":"På kafé","zh":"在咖啡馆","words":[[0,2,41.23,41.44,"på"],[3,7,41.44,41.99,"kafé"]]},{"id":10,"start":43.64,"end":45.92,"text":"Jeg vil ha en kopp kaffe.","zh":"我要一杯咖啡。","words":[[0,3,43.72,44.08,"jeg"],[4,7,44.08,44.3,"vil"],[8,10,44.3,44.56,"ha~7724ec04e04d"],[11,13,44.56,44.8,"en~a939a9e56dc5"],[14,18,44.8,45.08,"kopp"],[19,24,45.08,45.84,"kaffe"]]},{"id":11,"start":46.88,"end":48.07,"text":"Hva vil du ha?","zh":"你要什么？","words":[[0,3,46.96,47.16,"hva"],[4,7,47.16,47.4,"vil"],[8,10,47.4,47.7,"du"],[11,13,47.7,47.99,"ha~7724ec04e04d"]]},{"id":12,"start":49.23,"end":50.65,"text":"Jeg tar en kopp te.","zh":"我要一杯茶。","words":[[0,3,49.31,49.59,"jeg"],[4,7,49.59,49.83,"tar~b60eb818ae9a"],[8,10,49.83,49.99,"en~a939a9e56dc5"],[11,15,49.99,50.19,"kopp"],[16,18,50.19,50.57,"te"]]},{"id":13,"start":51.35,"end":52.89,"text":"Jeg liker ikke kaffe.","zh":"我不喜欢咖啡。","words":[[0,3,51.43,51.65,"jeg"],[4,9,51.65,52.07,"liker"],[10,14,52.07,52.27,"ikke"],[15,20,52.27,52.81,"kaffe"]]},{"id":14,"start":55.68,"end":56.95,"text":"Hva har du lyst på?","zh":"你想要点什么？","words":[[0,3,55.76,56.02,"hva"],[4,7,56.02,56.18,"har~2fe5eb128613"],[8,10,56.18,56.3,"du"],[11,15,56.3,56.6,"lyst~0eef5d2ccab2"],[16,18,56.6,56.87,"på~40ad664c0969"]]},{"id":15,"start":58.04,"end":59.6,"text":"Jeg har lyst på sushi.","zh":"我想吃寿司。","words":[[0,3,58.12,58.31,"jeg"],[4,7,58.31,58.47,"har~2fe5eb128613"],[8,12,58.47,58.69,"lyst~0eef5d2ccab2"],[13,15,58.69,58.97,"på~40ad664c0969"],[16,21,58.97,59.52,"sushi"]]},{"id":16,"start":60.65,"end":62.35,"text":"Jeg liker ikke sushi.","zh":"我不喜欢寿司。","words":[[0,3,60.73,61.0,"jeg"],[4,9,61.0,61.48,"liker"],[10,14,61.48,61.68,"ikke"],[15,20,61.68,62.27,"sushi"]]},{"id":17,"start":63.02,"end":64.99,"text":"Jeg tar en hamburger.","zh":"我要一个汉堡。","words":[[0,3,63.1,63.38,"jeg"],[4,7,63.38,63.96,"tar~b60eb818ae9a"],[8,10,63.96,64.06,"en~a939a9e56dc5"],[11,20,64.06,64.91,"hamburger"]]},{"id":18,"start":67.25,"end":69.29,"text":"Hva vil dere bestille?","speaker":"Servitør","zh":"你们想点什么？","words":[[0,3,67.33,68.06,"hva"],[4,7,68.06,68.3,"vil"],[8,12,68.3,68.52,"dere"],[13,21,68.52,69.21,"bestille"]]},{"id":19,"start":70.49,"end":75.03,"text":"Jeg vil gjerne ha en vaffel og et glass cola.","zh":"我想要一份华夫饼和一杯可乐。","words":[[0,3,70.57,70.97,"jeg"],[4,7,70.97,71.19,"vil"],[8,14,71.19,71.65,"gjerne"],[15,17,71.65,71.91,"ha~7724ec04e04d"],[18,20,71.91,72.43,"en~a939a9e56dc5"],[21,27,72.43,73.27,"vaffel"],[28,30,73.27,73.67,"og"],[31,33,73.67,73.87,"et~054dde72f37b"],[34,39,73.87,74.15,"glass"],[40,44,74.15,74.95,"cola"]]},{"id":20,"start":76.48,"end":81.47,"text":"Jeg har lyst på sjokoladekake og en kopp kaffe uten melk.","zh":"我想要巧克力蛋糕和一杯不加牛奶的咖啡。","words":[[0,3,76.56,76.77,"jeg"],[4,7,76.77,76.99,"har~2fe5eb128613"],[8,12,76.99,77.33,"lyst~0eef5d2ccab2"],[13,15,77.33,77.57,"på~40ad664c0969"],[16,29,77.57,78.53,"sjokoladekake"],[30,32,78.53,79.15,"og"],[33,35,79.15,79.47,"en~a939a9e56dc5"],[36,40,79.47,79.77,"kopp"],[41,46,79.77,80.19,"kaffe"],[47,51,80.19,80.85,"uten"],[52,56,80.85,81.39,"melk"]]}],"lexicon":{"4.5":{"lemma":"4.5","zh":"第 4.5 节","pos":"编号","ref"