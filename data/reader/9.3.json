{"id":"9.3","title":"Hvor lenge har du bodd her?","audio":"audio/9.3.mp3","duration":187.63,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.36,"text":"9.3 Hvor lenge har du bodd her?","heading":true,"zh":"9.3 你在这里住了多久？","words":[[0,3,0.15,1.09,"9.3"],[4,8,2.47,2.91,"hvor~89609d84930b"],[9,14,2.91,3.23,"lenge"],[15,18,3.23,3.51,"har~8b9792170cca"],[19,21,3.51,3.63,"du"],[22,26,3.63,3.91,"bodd"],[27,30,3.91,4.28,"her"]]},{"id":1,"start":5.8,"end":9.27,"text":"Marek har flyttet inn i ny leilighet i ei blokk.","zh":"马雷克搬进了一栋公寓楼里的新公寓。","words":[[0,5,5.88,6.45,"marek"],[6,9,6.45,6.69,"har~8b9792170cca"],[10,17,6.69,7.13,"flyttet"],[18,21,7.13,7.33,"inn~74cd3f854d45"],[22,23,7.33,7.57,"i"],[24,26,7.57,7.79,"ny"],[27,36,7.79,8.37,"leilighet"],[37,38,8.45,8.63,"i"],[39,41,8.63,8.71,"ei~47aa2d18e376"],[42,47,8.71,9.19,"blokk"]]},{"id":2,"start":9.86,"end":16.51,"text":"I dag treffer han en gammel mann i oppgangen, og den gamle mannen begynner å snakke med Marek.","zh":"今天他在楼道里遇到一位老人，那位老人开始和马雷克聊天。","words":[[0,1,9.94,10.31,"i"],[2,5,10.31,10.57,"dag"],[6,13,10.57,11.09,"treffer"],[14,17,11.09,11.31,"han"],[18,20,11.31,11.55,"en~a939a9e56dc5"],[21,27,11.55,11.87,"gammel"],[28,32,11.87,12.17,"mann"],[33,34,12.17,12.39,"i"],[35,44,12.39,12.79,"oppgangen"],[46,48,13.59,13.71,"og"],[49,52,13.71,13.89,"den~5f413bef0ba1"],[53,58,13.89,14.25,"gamle"],[59,65,14.25,14.65,"mannen"],[66,74,14.65,15.11,"begynner"],[75,76,15.11,15.33,"å~0583da7a620a"],[77,83,15.33,15.71,"snakke"],[84,87,15.71,15.87,"med"],[88,93,15.87,16.43,"marek"]]},{"id":3,"start":17.91,"end":23.57,"text":"God dag! Har du nettopp flyttet inn? Jeg har ikke sett deg før.","speaker":"Gustav","zh":"你好！你是刚搬进来的吗？我以前没见过你。","words":[[0,3,17.99,18.15,"god"],[4,7,18.15,18.41,"dag"],[9,12,19.35,19.71,"har~8b9792170cca"],[13,15,19.71,19.91,"du"],[16,23,19.91,20.39,"nettopp"],[24,31,20.39,20.73,"flyttet"],[32,35,20.73,20.89,"inn~0af50cd9ebe5"],[37,40,21.59,22.09,"jeg"],[41,44,22.09,22.31,"har~8b9792170cca"],[45,49,22.31,22.51,"ikke"],[50,54,22.51,22.81,"sett"],[55,58,22.81,23.11,"deg"],[59,62,23.11,23.49,"før~f9c047e06941"]]},{"id":4,"start":24.6,"end":37.15,"text":"Jeg har bodd her i to uker. Kona og jeg flyttet inn for to uker siden. Marek heter jeg. Vi bor i femte etasje.","speaker":"Marek","zh":"我在这里住了两个星期了。我和妻子两周前搬进来的。我叫马雷克。我们住在五楼。","words":[[0,3,24.68,24.9,"jeg"],[4,7,24.9,25.06,"har~8b9792170cca"],[8,12,25.06,25.36,"bodd"],[13,16,25.36,25.58,"her"],[17,18,25.58,25.92,"i~7176d3d97355"],[19,21,25.92,26.32,"to"],[22,26,26.32,26.74,"uker"],[28,32,27.94,28.46,"kona"],[33,35,28.46,28.86,"og"],[36,39,28.86,29.12,"jeg"],[40,47,29.12,29.86,"flyttet"],[48,51,29.86,30.04,"inn~0af50cd9ebe5"],[52,55,30.04,30.42,"for~e753a937d19e"],[56,58,30.42,30.76,"to"],[59,63,30.76,31.16,"uker"],[64,69,31.16,31.4,"siden~9a3d2d89a980"],[71,76,32.62,33.16,"marek"],[77,82,33.34,33.56,"heter"],[83,86,33.56,33.78,"jeg"],[88,90,34.42,35.06,"vi"],[91,94,35.06,35.34,"bor"],[95,96,35.34,35.76,"i"],[97,102,35.76,36.34,"femte"],[103,109,36.34,37.07,"etasje"]]},{"id":5,"start":38.29,"end":47.69,"text":"Velkommen hit! Jeg heter Gustav og bor i leiligheten under dere. Jeg og kona har bodd her i 30 år.","speaker":"Gustav","zh":"欢迎！我叫古斯塔夫，住在你们楼下的公寓。我和妻子在这里住了30年了。","words":[[0,9,38.37,38.92,"velkommen"],[10,13,38.92,39.2,"hit"],[15,18,40.12,40.52,"jeg"],[19,24,40.52,40.86,"heter"],[25,31,40.86,41.42,"gustav"],[32,34,41.86,42.16,"og"],[35,38,42.16,42.38,"bor"],[39,40,42.38,42.56,"i"],[41,52,42.56,43.18,"leiligheten"],[53,58,43.18,43.52,"under"],[59,63,43.52,43.74,"dere"],[65,68,44.6,45.08,"jeg"],[69,71,45.08,45.24,"og"],[72,76,45.24,45.64,"kona"],[77,80,45.64,46.18,"har~8b9792170cca"],[81,85,46.18,46.46,"bodd"],[86,89,46.46,46.68,"her"],[90,91,46.68,46.82,"i~320a5eb18595"],[92,94,46.82,47.2,"30"],[95,97,47.2,47.61,"år"]]},{"id":6,"start":49.11,"end":50.59,"text":"Liker dere å bo her?","speaker":"Marek","zh":"你们喜欢住在这里吗？","words":[[0,5,49.19,49.63,"liker"],[6,10,49.63,49.85,"dere"],[11,12,49.85,50.03,"å~0583da7a620a"],[13,15,50.03,50.21,"bo"],[16,19,50.21,50.51,"her"]]},{"id":7,"start":51.74,"end":59.31,"text":"Ja, vi trives så godt her. Vi har mange gode naboer. Hva driver dere med?","speaker":"Gustav","zh":"是的，我们在这里过得很舒心。我们有很多好邻居。你们是做什么的？","words":[[0,2,51.82,52.06,"ja"],[4,6,52.28,52.44,"vi"],[7,13,52.44,53.1,"trives"],[14,16,53.1,53.44,"så~f0deef830e78"],[17,21,53.44,53.66,"godt~28a24c509f3c"],[22,25,53.66,53.94,"her"],[27,29,54.61,55.31,"vi"],[30,33,55.31,55.55,"har"],[34,39,55.55,55.93,"mange"],[40,44,55.93,56.37,"gode"],[45,51,56.37,56.87,"naboer"],[53,56,57.75,58.23,"hva"],[57,63,58.23,58.63,"driver"],[64,68,58.63,58.87,"dere"],[69,72,58.87,59.23,"med~68248755c10e"]]},{"id":8,"start":60.58,"end":72.29,"text":"Jeg er snekker, og kona mi leter etter jobb nå. Hun har lært litt norsk i Polen, men hun må lære mer norsk først. Hva gjør du?","speaker":"Marek","zh":"我是木匠，我妻子现在在找工作。她在波兰学了一点挪威语，但她得先多学些挪威语。你是做什么的？","words":[[0,3,60.66,61.02,"jeg"],[4,6,61.02,61.32,"er"],[7,14,61.32,61.86,"snekker"],[16,18,62.42,62.6,"og"],[19,23,62.6,63.02,"kona"],[24,26,63.02,63.28,"mi"],[27,32,63.28,63.92,"leter"],[33,38,63.92,64.16,"etter~6d1db6ff2d59"],[39,43,64.16,64.46,"jobb"],[44,46,64.46,64.68,"nå~d531d47a7712"],[48,51,65.86,66.12,"hun"],[52,55,66.12,66.24,"har~8b9792170cca"],[56,60,66.24,66.56,"lært"],[61,65,66.56,66.76,"litt~462e893626a5"],[66,71,66.76,67.24,"norsk~4de5d75feae1"],[72,73,67.24,67.44,"i"],[74,79,67.44,67.82,"polen~488e57c60a08"],[81,84,68.46,68.6,"men"],[85,88,68.6,68.72,"hun"],[89,91,68.72,68.86,"må"],[92,96,68.86,69.18,"lære"],[97,100,69.18,69.48,"mer~564a1acc2512"],[101,106,69.48,69.86,"norsk~4de5d75feae1"],[107,112,69.86,70.26,"først"],[114,117,71.28,71.66,"hva"],[118,122,71.66,71.82,"gjør"],[123,125,71.82,72.21,"du"]]},{"id":9,"start":73.77,"end":88.75,"text":"Jeg arbeidet som lege i 40 år, og kona mi var advokat, men nå har vi blitt pensjonister. Barna flyttet ut for mange år siden, men vi snakker ofte med de hyggelige naboene.","speaker":"Gustav","zh":"我当了40年医生，我妻子以前是律师，不过现在我们都退休了。孩子们很多年前就搬出去了，但我们经常和友善的邻居们聊天。","words":[[0,3,73.85,74.04,"jeg"],[4,12,74.04,74.7,"arbeidet~62f2bad7bb5d"],[13,16,74.7,74.98,"som~8fdc0b351bdd"],[17,21,74.98,75.5,"lege"],[22,23,75.5,75.72,"i~5021eee3f417"],[24,26,75.72,76.04,"40"],[27,29,76.04,76.36,"år"],[31,33,76.92,77.18,"og"],[34,38,77.18,77.52,"kona"],[39,41,77.52,77.78,"mi"],[42,45,77.78,78.04,"var"],[46,53,78.04,78.72,"advokat"],[55,58,79.56,79.92,"men"],[59,61,79.92,80.14,"nå~d531d47a7712"],[62,65,80.14,80.42,"har~8b9792170cca"],[66,68,80.42,80.56,"vi"],[69,74,80.56,80.82,"blitt"],[75,87,80.82,81.58,"pensjonister"],[89,94,82.78,83.3,"barna"],[95,102,83.3,83.64,"flyttet"],[103,105,83.64,83.86,"ut~109beb99f3d1"],[106,109,83.86,84.12,"for~e753a937d19e"],[110,115,84.12,84.42,"mange"],[116,118,84.42,84.7,"år"],[119,124,84.7,84.94,"siden~9a3d2d89a980"],[126,129,85.68,86.1,"men"],[130,132,86.1,86.4,"vi"],[133,140,86.4,86.76,"snakker"],[141,145,86.76,87.14,"ofte"],[146,149,87.14,87.3,"med"],[150,152,87.3,87.48,"de~d251aa490218"],[153,162,87.48,87.92,"hyggelige"],[163,170,87.92,88.67,"naboene"]]},{"id":10,"start":90.04,"end":98.26,"text":"Jeg har ikke truffet mange naboer. Jeg har bare hilst på de unge naboene ved siden av oss. De er hyggelige.","speaker":"Marek","zh":"我还没见过多少邻居。我只跟我们隔壁的年轻邻居打过招呼。他们人很好。","words":[[0,3,90.12,90.29,"jeg"],[4,7,90.29,90.49,"har~8b9792170cca"],[8,12,90.49,90.67,"ikke"],[13,20,90.67,91.17,"truffet"],[21,26,91.17,91.45,"mange"],[27,33,91.45,91.87,"naboer"],[35,38,92.5,93.14,"jeg"],[39,42,93.14,93.28,"har~8b9792170cca"],[43,47,93.28,93.52,"bare"],[48,53,93.52,93.88,"hilst"],[54,56,93.88,94.12,"på~e141e46fe0f2"],[57,59,94.12,94.26,"de~d251aa490218"],[60,64,94.26,94.62,"unge"],[65,72,94.62,95.1,"naboene"],[73,76,95.1,95.26,"ved"],[77,82,95.26,95.56,"siden~68789c658db2"],[83,85,95.56,95.72,"av~38cf00d29ad7"],[86,89,95.72,95.94,"oss"],[91,93,96.7,97.14,"de"],[94,96,97.14,97.5,"er"],[97,106,97.5,98.18,"hyggelige"]]},{"id":11,"start":99.87,"end":121.5,"text":"Jeg håper dere vil trives her. Dere må huske dugnaden på lørdag. Jeg har vært med på alle dugnadene her. Etter dugnaden drikker vi kaffe og spiser vafler, og det er pølser og is til barna. Dere kan bli kjent med naboene på dugnaden.","speaker":"Gustav","zh":"希望你们在这里住得舒心。你们要记得星期六的集体义务劳动。这里所有的义务劳动我都参加过。劳动结束后我们喝咖啡、吃华夫饼，还有给孩子们的香肠和冰淇淋。你们可以在义务劳动时认识邻居们。","words":[[0,3,99.95,100.15,"jeg"],[4,9,100.15,100.77,"håper"],[10,14,100.77,101.09,"dere"],[15,18,101.09,101.37,"vil"],[19,25,101.37,101.89,"trives"],[26,29,101.89,102.07,"her"],[31,35,103.28,103.64,"dere"],[36,38,103.64,103.78,"må"],[39,44,103.78,104.24,"huske"],[45,53,104.24,104.86,"dugnaden"],[54,56,104.86,105.12,"på~61b87cb0af5e"],[57,63,105.12,105.54,"lørdag"],[65,68,106.06,106.74,"jeg"],[69,72,106.74,106.94,"har~8b9792170cca"],[73,77,106.94,107.18,"vært"],[78,81,107.18,107.38,"med~9a3087923a19"],[82,84,107.38,107.58,"på~4ead103caef4"],[85,89,107.58,108.0,"alle~6873d9584096"],[90,99,108.0,108.76,"dugnadene"],[100,103,108.76,108.96,"her"],[105,110,110.13,110.65,"etter"],[111,119,110.65,111.11,"dugnaden"],[120,127,111.11,112.15,"drikker~b5c7b7b8fee2"],[128,130,112.15,112.29,"vi"],[131,136,112.29,112.69,"kaffe"],[137,139,112.69,113.21,"og"],[140,146,113.21,113.65,"spiser"],[147,153,113.65,114.11,"vafler"],[155,157,114.98,115.26,"og"],[158,161,115.26,115.46,"det"],[162,164,115.46,115.6,"er"],[165,171,115.6,116.28,"pølser"],[172,174,116.28,116.44,"og"],[175,177,116.44,116.78,"is"],[178,181,116.78,117.06,"til"],[182,187,117.06,117.46,"barna"],[189,193,118.61,119.03,"dere"],[194,197,119.03,119.27,"kan"],[198,201,119.27,119.43,"bli"],[202,207,119.43,119.75,"kjent~43c3ae802868"],[208,211,119.75,119.99,"med~c94aad168705"],[212,219,119.99,120.47,"naboene"],[220,222,120.47,120.73,"på"],[223,231,120.73,121.42,"dugnaden"]]},{"id":12,"start":122.8,"end":129.81,"text":"Tusen takk, det skal jeg huske. Hyggelig å hilse på deg. Vi ses på lørdag.","speaker":"Marek","zh":"非常感谢，我会记住的。很高兴认识你。星期六见。","words":[[0,5,122.88,123.38,"tusen"],[6,10,123.56,123.74,"takk"],[12,15,124.38,124.62,"det"],[16,20,124.62,124.96,"skal~5ee0369b5859"],[21,24,124.96,125.08,"jeg"],[25,30,125.08,125.46,"huske"],[32,40,126.18,126.86,"hyggelig"],[41,42,126.86,126.96,"å~0583da7a620a"],[43,48,126.96,127.3,"hilse~26e8efe82cd6"],[49,51,127.3,127.44,"på~be6244dce817"],[52,55,127.44,127.64,"deg"],[57,59,128.48,128.9,"vi"],[60,63,128.9,129.12,"ses~67c1c837603a"],[64,66,129.12,129.36,"på~61b87cb0af5e"],[67,73,129.36,129.73,"lørdag"]]},{"id":13,"start":130.16,"end":133.16,"text":"Det gjør vi. Ha en fin dag!","speaker":"Gustav","zh":"好的，到时见。祝你过得愉快！","words":[[0,3,130.3,130.98,"det"],[4,8,130.98,131.16,"gjør"],[9,11,131.16,131.3,"vi"],[13,15,131.96,132.22,"ha~5f1a57c3795d"],[16,18,132.22,132.4,"en~a939a9e56dc5"],[19,22,132.4,132.66,"fin"],[23,26,132.66,133.08,"dag"]]},{"id":14,"start":134.45,"end":138.05,"text":"Jeg har blitt kjent med en norsk nabo.","zh":"我认识了一位挪威邻居。","words":[[0,3,135.0,135.62,"jeg"],[4,7,135.62,135.86,"har~8b9792170cca"],[8,13,135.86,136.1,"blitt"],[14,19,136.1,136.56,"kjent~43c3ae802868"],[20,23,136.56,136.94,"med~c94aad168705"],[24,26,136.94,136.94,"en~a939a9e56dc5"],[27,32,136.94,137.5,"norsk~300c0d0c4f59"],[33,37,137.5,137.97,"nabo"]]},{"id":15,"start":141.86,"end":142.96,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,141.94,142.88,"sammendrag"]]},{"id":16,"start":144.05,"end":148.4,"text":"For to uker siden flyttet Marek inn i den nye leiligheten.","zh":"两周前，马雷克搬进了新公寓。","words":[[0,3,144.13,144.51,"for~e753a937d19e"],[4,6,144.51,144.81,"to"],[7,11,144.81,145.31,"uker"],[12,17,145.31,145.73,"siden~9a3d2d89a980"],[18,25,145.73,146.21,"flyttet"],[26,31,146.21,146.69,"marek"],[32,35,146.69,146.93,"inn~74cd3f854d45"],[36,37,146.93,147.13,"i"],[38,41,147.13,147.27,"den~5f413bef0ba1"],[42,45,147.27,147.51,"nye"],[46,57,147.51,148.32,"leiligheten"]]},{"id":17,"start":149.48,"end":152.54,"text":"I dag treffer han en norsk nabo i oppgangen.","zh":"今天他在楼道里遇到了一位挪威邻居。","words":[[0,1,149.56,149.69,"i"],[2,5,149.69,149.89,"dag"],[6,13,149.89,150.41,"treffer"],[14,17,150.41,150.65,"han"],[18,20,150.65,150.77,"en~a939a9e56dc5"],[21,26,150.77,151.13,"norsk~300c0d0c4f59"],[27,31,151.13,151.55,"nabo"],[32,33,151.55,151.79,"i"],[34,43,151.79,152.46,"oppgangen"]]},{"id":18,"start":153.36,"end":158.45,"text":"Naboen heter Gustav, og han og kona har bodd der i 30 år.","zh":"邻居叫古斯塔夫，他和妻子在那里住了30年。","words":[[0,6,153.44,154.23,"naboen"],[7,12,154.23,154.65,"heter"],[13,19,154.65,155.29,"gustav"],[21,23,155.69,155.81,"og"],[24,27,155.81,156.05,"han"],[28,30,156.05,156.25,"og"],[31,35,156.25,156.59,"kona"],[36,39,156.59,156.93,"har~8b9792170cca"],[40,44,156.93,157.15,"bodd"],[45,48,157.15,157.41,"der"],[49,50,157.41,157.59,"i~320a5eb18595"],[51,53,157.59,157.89,"30"],[54,56,157.89,158.37,"år"]]},{"id":19,"start":159.67,"end":162.38,"text":"Marek og Ewa bor over Gustav.","zh":"马雷克和埃娃住在古斯塔夫楼上。","words":[[0,5,159.75,160.34,"marek"],[6,8,160.34,160.5,"og"],[9,12,160.5,160.88,"ewa"],[13,16,160.88,161.3,"bor"],[17,21,161.3,161.74,"over"],[22,28,161.74,162.3,"gustav"]]},{"id":20,"start":163.6,"end":168.72,"text":"Gustav og kona har barn, men barna flyttet ut for mange år siden.","zh":"古斯塔夫和妻子有孩子，但孩子们很多年前就搬出去了。","words":[[0,6,163.68,164.18,"gustav"],[7,9,164.18,164.32,"og"],[10,14,164.32,164.68,"kona"],[15,18,164.68,164.92,"har"],[19,23,164.92,165.18,"barn"],[25,28,165.76,165.98,"men"],[29,34,165.98,166.5,"barna"],[35,42,166.5,166.96,"flyttet"],[43,45,166.96,167.2,"ut~109beb99f3d1"],[46,49,167.2,167.48,"for~e753a937d19e"],[50,55,167.48,167.8,"mange"],[56,58,167.8,168.06,"år"],[59,64,168.06,168.65,"siden~9a3d2d89a980"]]},{"id":21,"start":169.92,"end":172.39,"text":"Gustav har vært lege i mange år.","zh":"古斯塔夫做了很多年医生。","words":[[0,6,170.0,170.54,"gustav"],[7,10,170.54,170.72,"har~8b9792170cca"],[11,15,170.72,170.94,"vært"],[16,20,170.94,171.44,"lege"],[21,22,171.44,171.74,"i~c0bbfa552007"],[23,28,171.74,171.92,"mange"],[29,31,171.92,172.31,"år"]]},{"id":22,"start":173.02,"end":175.17,"text":"Nå er han pensjonist.","zh":"现在他退休了。","words":[[0,2,173.1,173.38,"nå~d531d47a7712"],[3,5,173.38,173.88,"er"],[6,9,173.88,174.08,"han"],[10,20,174.08,175.09,"pensjonist"]]},{"id":23,"start":175.85,"end":179.49,"text":"Gustav forteller om dugnaden på lørdag.","zh":"古斯塔夫讲了星期六集体义务劳动的事。","words":[[0,6,175.93,177.15,"gustav"],[7,16,177.15,177.71,"forteller"],[17,19,177.71,177.97,"om~52c0bdc828db"],[20,28,177.97,178.67,"dugnaden"],[29,31,178.67,178.93,"på~61b87cb0af5e"],[32,38,178.93,179.41,"lørdag"]]},{"id":24,"start":180.49,"end":183.7,"text":"Marek blir glad for å møte en hyggelig nabo.","zh":"马雷克很高兴遇到一位友善的邻居。","words":[[0,5,180.57,181.09,"marek"],[6,10,181.09,181.31,"blir"],[11,15,181.31,181.67,"glad"],[16,19,181.67,181.93,"for~d06f5440f0d3"],[20,21,181.93,182.07,"å~0583da7a620a"],[22,26,182.07,182.49,"møte~2b04e8ffdc70"],[27,29,182.49,182.67,"en~a939a9e56dc5"],[30,38,182.67,183.15,"hyggelig"],[39,43,183.15,183.62,"nabo"]]}],"lexicon":{"30":{"lemma":"30","zh":"数字 30","pos":"数词","ref":"basics:numbers:tretti","clip":null,"kind":"number"},"40":{"lemma":"40","zh":"数字 40","pos":"数词","ref":"basics:numbers:førti","clip":null,"kind":"number"},"9.3":{"lemma":"9.3","zh":"第 9.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"advokat":{"lemma":"advokat","zh":"律师","pos":"名词","ref":"9-061","clip":"pronunciation/1b2de252d8a897c26d8a.mp3"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"arbeidet":{"lemma":"arbeide","zh":"工作","pos":"动词","ref":"pa-vei-14-057","form":"过去时","clip":null,"ambiguous":true,"candidates":[{"lemma":"arbeide","zh":"工作","pos":"动词","ref":"pa-vei-14-057","form":"过去时"},{"lemma":"arbeid","zh":"工作；劳动","pos":"名词","ref":"basics:work:arbeid","form":"单数定指"}]},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barn":{"lemma":"b