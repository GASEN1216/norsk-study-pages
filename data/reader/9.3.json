{"id":"9.3","title":"Hvor lenge har du bodd her?","audio":"audio/9.3.mp3","duration":187.63,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.36,"text":"9.3 Hvor lenge har du bodd her?","heading":true,"zh":"9.3 你在这里住了多久？","words":[[0,3,0.15,1.09,"9.3"],[4,8,2.47,2.91,"hvor~89609d84930b"],[9,14,2.91,3.23,"lenge"],[15,18,3.23,3.51,"har~8b9792170cca"],[19,21,3.51,3.63,"du"],[22,26,3.63,3.91,"bodd"],[27,30,3.91,4.28,"her"]]},{"id":1,"start":5.84,"end":9.33,"text":"Marek har flyttet inn i ny leilighet i ei blokk.","zh":"马雷克搬进了一栋公寓楼里的新公寓。","words":[[0,5,5.9,6.52,"marek"],[6,9,6.52,6.78,"har~8b9792170cca"],[10,17,6.78,7.2,"flyttet"],[18,21,7.2,7.5,"inn~74cd3f854d45"],[22,23,7.5,7.64,"i"],[24,26,7.64,7.9,"ny"],[27,36,7.9,8.5,"leilighet"],[37,38,8.5,8.62,"i"],[39,41,8.62,8.76,"ei~47aa2d18e376"],[42,47,8.76,9.18,"blokk"]]},{"id":2,"start":10.06,"end":16.55,"text":"I dag treffer han en gammel mann i oppgangen, og den gamle mannen begynner å snakke med Marek.","zh":"今天他在楼道里遇到一位老人，那位老人开始和马雷克聊天。","words":[[0,1,10.12,10.3,"i"],[2,5,10.3,10.8,"dag"],[6,13,10.8,11.16,"treffer"],[14,17,11.16,11.44,"han"],[18,20,11.44,11.58,"en~a939a9e56dc5"],[21,27,11.58,11.94,"gammel"],[28,32,11.94,12.34,"mann"],[33,34,12.34,12.46,"i"],[35,44,12.46,13.13,"oppgangen"],[46,48,13.64,13.76,"og"],[49,52,13.76,13.96,"den~5f413bef0ba1"],[53,58,13.96,14.34,"gamle"],[59,65,14.34,14.76,"mannen"],[66,74,14.76,15.22,"begynner"],[75,76,15.22,15.38,"å~0583da7a620a"],[77,83,15.38,15.78,"snakke"],[84,87,15.78,15.92,"med"],[88,93,15.92,16.41,"marek"]]},{"id":3,"start":17.95,"end":23.63,"text":"God dag! Har du nettopp flyttet inn? Jeg har ikke sett deg før.","speaker":"Gustav","zh":"你好！你是刚搬进来的吗？我以前没见过你。","words":[[0,3,18.0,18.18,"god"],[4,7,18.18,18.68,"dag"],[9,12,19.5,19.74,"har~8b9792170cca"],[13,15,19.74,20.04,"du"],[16,23,20.04,20.46,"nettopp"],[24,31,20.46,20.8,"flyttet"],[32,35,20.8,21.18,"inn~0af50cd9ebe5"],[37,40,21.96,22.16,"jeg"],[41,44,22.16,22.36,"har~8b9792170cca"],[45,49,22.36,22.64,"ikke"],[50,54,22.64,22.98,"sett"],[55,58,22.98,23.2,"deg"],[59,62,23.2,23.48,"før~f9c047e06941"]]},{"id":4,"start":24.64,"end":37.2,"text":"Jeg har bodd her i to uker. Kona og jeg flyttet inn for to uker siden. Marek heter jeg. Vi bor i femte etasje.","speaker":"Marek","zh":"我在这里住了两个星期了。我和妻子两周前搬进来的。我叫马雷克。我们住在五楼。","words":[[0,3,24.7,24.98,"jeg"],[4,7,24.98,25.14,"har~8b9792170cca"],[8,12,25.14,25.42,"bodd"],[13,16,25.42,25.84,"her"],[17,18,25.84,26.02,"i~7176d3d97355"],[19,21,26.02,26.42,"to"],[22,26,26.42,26.95,"uker"],[28,32,28.1,28.8,"kona"],[33,35,28.8,28.92,"og"],[36,39,28.92,29.31,"jeg"],[40,47,29.5,29.94,"flyttet"],[48,51,29.94,30.3,"inn~0af50cd9ebe5"],[52,55,30.3,30.48,"for~e753a937d19e"],[56,58,30.48,30.9,"to"],[59,63,30.9,31.24,"uker"],[64,69,31.24,31.73,"siden~9a3d2d89a980"],[71,76,32.68,33.36,"marek"],[77,82,33.36,33.64,"heter"],[83,86,33.64,34.02,"jeg"],[88,90,34.92,35.14,"vi"],[91,94,35.14,35.58,"bor"],[95,96,35.68,35.86,"i"],[97,102,35.86,36.58,"femte"],[103,109,36.58,37.05,"etasje"]]},{"id":5,"start":38.33,"end":47.74,"text":"Velkommen hit! Jeg heter Gustav og bor i leiligheten under dere. Jeg og kona har bodd her i 30 år.","speaker":"Gustav","zh":"欢迎！我叫古斯塔夫，住在你们楼下的公寓。我和妻子在这里住了30年了。","words":[[0,9,38.39,39.02,"velkommen"],[10,13,39.02,39.49,"hit"],[15,18,40.28,40.6,"jeg"],[19,24,40.6,40.98,"heter"],[25,31,40.98,41.67,"gustav"],[32,34,42.06,42.24,"og"],[35,38,42.24,42.5,"bor"],[39,40,42.5,42.62,"i"],[41,52,42.62,43.34,"leiligheten"],[53,58,43.34,43.58,"under"],[59,63,43.58,44.02,"dere"],[65,68,44.9,45.18,"jeg"],[69,71,45.18,45.3,"og"],[72,76,45.3,45.85,"kona"],[77,80,46.04,46.26,"har~8b9792170cca"],[81,85,46.26,46.54,"bodd"],[86,89,46.54,46.76,"her"],[90,91,46.76,46.9,"i~320a5eb18595"],[92,94,46.9,47.32,"30"],[95,97,47.32,47.59,"år"]]},{"id":6,"start":49.16,"end":50.63,"text":"Liker dere å bo her?","speaker":"Marek","zh":"你们喜欢住在这里吗？","words":[[0,5,49.22,49.7,"liker"],[6,10,49.7,49.96,"dere"],[11,12,49.96,50.08,"å~0583da7a620a"],[13,15,50.08,50.26,"bo"],[16,19,50.26,50.48,"her"]]},{"id":7,"start":51.77,"end":59.38,"text":"Ja, vi trives så godt her. Vi har mange gode naboer. Hva driver dere med?","speaker":"Gustav","zh":"是的，我们在这里过得很舒心。我们有很多好邻居。你们是做什么的？","words":[[0,2,51.84,52.21,"ja"],[4,6,52.32,52.6,"vi"],[7,13,52.6,53.26,"trives"],[14,16,53.26,53.56,"så~f0deef830e78"],[17,21,53.56,53.82,"godt~28a24c509f3c"],[22,25,53.82,54.2,"her"],[27,29,55.12,55.38,"vi"],[30,33,55.38,55.68,"har"],[34,39,55.68,56.16,"mange"],[40,44,56.16,56.46,"gode"],[45,51,56.46,57.08,"naboer"],[53,56,58.0,58.36,"hva"],[57,63,58.36,58.72,"driver"],[64,68,58.72,58.96,"dere"],[69,72,58.96,59.23,"med~68248755c10e"]]},{"id":8,"start":60.61,"end":72.34,"text":"Jeg er snekker, og kona mi leter etter jobb nå. Hun har lært litt norsk i Polen, men hun må lære mer norsk først. Hva gjør du?","speaker":"Marek","zh":"我是木匠，我妻子现在在找工作。她在波兰学了一点挪威语，但她得先多学些挪威语。你是做什么的？","words":[[0,3,60.67,61.2,"jeg"],[4,6,61.2,61.42,"er"],[7,14,61.42,62.05,"snekker"],[16,18,62.5,62.68,"og"],[19,23,62.68,63.12,"kona"],[24,26,63.12,63.44,"mi"],[27,32,63.58,64.0,"leter"],[33,38,64.0,64.24,"etter~47a4c65924c9"],[39,43,64.24,64.52,"jobb"],[44,46,64.52,64.82,"nå~d531d47a7712"],[48,51,66.0,66.16,"hun"],[52,55,66.16,66.3,"har~8b9792170cca"],[56,60,66.3,66.62,"lært"],[61,65,66.62,66.92,"litt~462e893626a5"],[66,71,66.92,67.38,"norsk~4de5d75feae1"],[72,73,67.38,67.48,"i"],[74,79,67.48,68.0,"polen~488e57c60a08"],[81,84,68.48,68.62,"men"],[85,88,68.62,68.78,"hun"],[89,91,68.78,68.94,"må"],[92,96,68.94,69.3,"lære"],[97,100,69.3,69.6,"mer~564a1acc2512"],[101,106,69.6,69.94,"norsk~4de5d75feae1"],[107,112,69.94,70.48,"først"],[114,117,71.48,71.7,"hva"],[118,122,71.7,71.9,"gjør"],[123,125,71.9,72.19,"du"]]},{"id":9,"start":73.81,"end":88.81,"text":"Jeg arbeidet som lege i 40 år, og kona mi var advokat, men nå har vi blitt pensjonister. Barna flyttet ut for mange år siden, men vi snakker ofte med de hyggelige naboene.","speaker":"Gustav","zh":"我当了40年医生，我妻子以前是律师，不过现在我们都退休了。孩子们很多年前就搬出去了，但我们经常和友善的邻居们聊天。","words":[[0,3,73.87,74.24,"jeg"],[4,12,74.24,74.88,"arbeidet~62f2bad7bb5d"],[13,16,74.88,75.14,"som~8fdc0b351bdd"],[17,21,75.14,75.68,"lege"],[22,23,75.68,75.84,"i~5021eee3f417"],[24,26,75.84,76.2,"40"],[27,29,76.2,76.6,"år"],[31,33,77.08,77.24,"og"],[34,38,77.24,77.62,"kona"],[39,41,77.62,77.88,"mi"],[42,45,77.88,78.16,"var"],[46,53,78.16,79.0,"advokat"],[55,58,79.76,79.96,"men"],[59,61,79.96,80.28,"nå~d531d47a7712"],[62,65,80.28,80.46,"har~8b9792170cca"],[66,68,80.46,80.62,"vi"],[69,74,80.62,80.92,"blitt"],[75,87,80.92,81.84,"pensjonister"],[89,94,82.92,83.38,"barna"],[95,102,83.38,83.74,"flyttet"],[103,105,83.74,83.98,"ut~109beb99f3d1"],[106,109,83.98,84.24,"for~e753a937d19e"],[110,115,84.24,84.6,"mange"],[116,118,84.6,84.76,"år"],[119,124,84.76,85.22,"siden~9a3d2d89a980"],[126,129,85.92,86.28,"men"],[130,132,86.28,86.46,"vi"],[133,140,86.46,86.84,"snakker"],[141,145,86.84,87.22,"ofte"],[146,149,87.22,87.34,"med"],[150,152,87.34,87.54,"de~d251aa490218"],[153,162,87.54,88.04,"hyggelige"],[163,170,88.04,88.66,"naboene"]]},{"id":10,"start":90.08,"end":98.32,"text":"Jeg har ikke truffet mange naboer. Jeg har bare hilst på de unge naboene ved siden av oss. De er hyggelige.","speaker":"Marek","zh":"我还没见过多少邻居。我只跟我们隔壁的年轻邻居打过招呼。他们人很好。","words":[[0,3,90.14,90.38,"jeg"],[4,7,90.38,90.56,"har~8b9792170cca"],[8,12,90.56,90.82,"ikke"],[13,20,90.82,91.32,"truffet"],[21,26,91.32,91.62,"mange"],[27,33,91.62,92.18,"naboer"],[35,38,92.98,93.2,"jeg"],[39,42,93.2,93.34,"har~8b9792170cca"],[43,47,93.34,93.64,"bare"],[48,53,93.64,94.04,"hilst"],[54,56,94.04,94.16,"på~e141e46fe0f2"],[57,59,94.16,94.36,"de~d251aa490218"],[60,64,94.36,94.7,"unge"],[65,72,94.7,95.16,"naboene"],[73,76,95.16,95.34,"ved"],[77,82,95.34,95.66,"siden~68789c658db2"],[83,85,95.66,95.76,"av~38cf00d29ad7"],[86,89,95.76,96.18,"oss"],[91,93,96.92,97.24,"de"],[94,96,97.4,97.58,"er"],[97,106,97.58,98.17,"hyggelige"]]},{"id":11,"start":99.91,"end":121.56,"text":"Jeg håper dere vil trives her. Dere må huske dugnaden på lørdag. Jeg har vært med på alle dugnadene her. Etter dugnaden drikker vi kaffe og spiser vafler, og det er pølser og is til barna. Dere kan bli kjent med naboene på dugnaden.","speaker":"Gustav","zh":"希望你们在这里住得舒心。你们要记得星期六的集体义务劳动。这里所有的义务劳动我都参加过。劳动结束后我们喝咖啡、吃华夫饼，还有给孩子们的香肠和冰淇淋。你们可以在义务劳动时认识邻居们。","words":[[0,3,99.97,100.3,"jeg"],[4,9,100.3,100.96,"håper"],[10,14,100.96,101.3,"dere"],[15,18,101.3,101.48,"vil"],[19,25,101.48,101.96,"trives"],[26,29,101.96,102.34,"her"],[31,35,103.46,103.7,"dere"],[36,38,103.7,103.86,"må"],[39,44,103.86,104.34,"huske"],[45,53,104.34,105.04,"dugnaden"],[54,56,105.04,105.16,"på~61b87cb0af5e"],[57,63,105.16,105.7,"lørdag"],[65,68,106.58,106.82,"jeg"],[69,72,106.82,107.04,"har~8b9792170cca"],[73,77,107.04,107.28,"vært"],[78,81,107.28,107.48,"med~9a3087923a19"],[82,84,107.48,107.74,"på~4ead103caef4"],[85,89,107.74,108.16,"alle~6873d9584096"],[90,99,108.16,108.84,"dugnadene"],[100,103,108.84,109.22,"her"],[105,110,110.4,110.7,"etter"],[111,119,110.7,111.42,"dugnaden"],[120,127,111.86,112.2,"drikker~b5c7b7b8fee2"],[128,130,112.2,112.38,"vi"],[131,136,112.38,112.92,"kaffe"],[137,139,113.12,113.28,"og"],[140,146,113.28,113.74,"spiser"],[147,153,113.74,114.34,"vafler"],[155,157,115.1,115.38,"og"],[158,161,115.38,115.54,"det"],[162,164,115.54,115.74,"er"],[165,171,115.74,116.36,"pølser"],[172,174,116.36,116.6,"og"],[175,177,116.6,116.96,"is"],[178,181,116.96,117.18,"til"],[182,187,117.18,117.68,"barna"],[189,193,118.78,119.12,"dere"],[194,197,119.12,119.32,"kan"],[198,201,119.32,119.52,"bli"],[202,207,119.52,119.9,"kjent~43c3ae802868"],[208,211,119.9,120.04,"med~c94aad168705"],[212,219,120.04,120.6,"naboene"],[220,222,120.6,120.8,"på"],[223,231,120.8,121.41,"dugnaden"]]},{"id":12,"start":122.84,"end":129.87,"text":"Tusen takk, det skal jeg huske. Hyggelig å hilse på deg. Vi ses på lørdag.","speaker":"Marek","zh":"非常感谢，我会记住的。很高兴认识你。星期六见。","words":[[0,5,122.9,123.42,"tusen"],[6,10,123.42,123.9,"takk"],[12,15,124.4,124.82,"det"],[16,20,124.82,124.98,"skal~5ee0369b5859"],[21,24,124.98,125.12,"jeg"],[25,30,125.12,125.68,"huske"],[32,40,126.54,126.92,"hyggelig"],[41,42,126.92,127.0,"å~0583da7a620a"],[43,48,127.0,127.36,"hilse~26e8efe82cd6"],[49,51,127.36,127.48,"på~be6244dce817"],[52,55,127.48,127.84,"deg"],[57,59,128.76,128.94,"vi"],[60,63,128.94,129.26,"ses~67c1c837603a"],[64,66,129.26,129.4,"på~61b87cb0af5e"],[67,73,129.4,129.72,"lørdag"]]},{"id":13,"start":130.68,"end":133.22,"text":"Det gjør vi. Ha en fin dag!","speaker":"Gustav","zh":"好的，到时见。祝你过得愉快！","words":[[0,3,130.74,131.02,"det"],[4,8,131.02,131.22,"gjør"],[9,11,131.22,131.52,"vi"],[13,15,132.1,132.3,"ha~5f1a57c3795d"],[16,18,132.3,132.5,"en~a939a9e56dc5"],[19,22,132.5,132.74,"fin"],[23,26,132.74,133.06,"dag"]]},{"id":14,"start":135.35,"end":138.11,"text":"Jeg har blitt kjent med en norsk nabo.","zh":"我认识了一位挪威邻居。","words":[[0,3,135.41,135.78,"jeg"],[4,7,135.78,135.92,"har~8b9792170cca"],[8,13,135.92,136.24,"blitt"],[14,19,136.24,136.86,"kjent~43c3ae802868"],[20,23,136.86,136.98,"med~c94aad168705"],[24,26,136.98,137.12,"en~a939a9e56dc5"],[27,32,137.12,137.56,"norsk~300c0d0c4f59"],[33,37,137.56,137.96,"nabo"]]},{"id":15,"start":141.89,"end":143.02,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,141.95,142.87,"sammendrag"]]},{"id":16,"start":144.19,"end":148.46,"text":"For to uker siden flyttet Marek inn i den nye leiligheten.","zh":"两周前，马雷克搬进了新公寓。","words":[[0,3,144.25,144.66,"for~e753a937d19e"],[4,6,144.66,145.04,"to"],[7,11,145.04,145.42,"uker"],[12,17,145.42,145.9,"siden~9a3d2d89a980"],[18,25,145.9,146.3,"flyttet"],[26,31,146.3,146.78,"marek"],[32,35,146.78,147.08,"inn~74cd3f854d45"],[36,37,147.08,147.18,"i"],[38,41,147.18,147.34,"den~5f413bef0ba1"],[42,45,147.34,147.6,"nye"],[46,57,147.6,148.31,"leiligheten"]]},{"id":17,"start":149.52,"end":152.6,"text":"I dag treffer han en norsk nabo i oppgangen.","zh":"今天他在楼道里遇到了一位挪威邻居。","words":[[0,1,149.58,149.74,"i"],[2,5,149.74,150.16,"dag"],[6,13,150.16,150.52,"treffer"],[14,17,150.52,150.72,"han"],[18,20,150.72,150.86,"en~a939a9e56dc5"],[21,26,150.86,151.22,"norsk~300c0d0c4f59"],[27,31,151.22,151.74,"nabo"],[32,33,151.74,151.86,"i"],[34,43,151.86,152.45,"oppgangen"]]},{"id":18,"start":153.39,"end":158.5,"text":"Naboen heter Gustav, og han og kona har bodd der i 30 år.","zh":"邻居叫古斯塔夫，他和妻子在那里住了30年。","words":[[0,6,153.45,154.34,"naboen"],[7,12,154.34,154.78,"heter"],[13,19,154.78,155.52,"gustav"],[21,23,155.72,155.86,"og"],[24,27,155.86,156.16,"han"],[28,30,156.16,156.28,"og"],[31,35,156.28,156.8,"kona"],[36,39,156.8,157.0,"har~8b9792170cca"],[40,44,157.0,157.24,"bodd"],[45,48,157.24,157.52,"der"],[49,50,157.52,157.64,"i~320a5eb18595"],[51,53,157.64,158.08,"30"],[54,56,158.08,158.35,"år"]]},{"id":19,"start":159.71,"end":162.44,"text":"Marek og Ewa bor over Gustav.","zh":"马雷克和埃娃住在古斯塔夫楼上。","words":[[0,5,159.77,160.4,"marek"],[6,8,160.4,160.58,"og"],[9,12,160.58,161.12,"ewa"],[13,16,161.12,161.44,"bor"],[17,21,161.44,161.78,"over"],[22,28,161.78,162.29,"gustav"]]},{"id":20,"start":163.64,"end":168.72,"text":"Gustav og kona har barn, men barna flyttet ut for mange år siden.","zh":"古斯塔夫和妻子有孩子，但孩子们很多年前就搬出去了。","words":[[0,6,163.7,164.26,"gustav"],[7,9,164.26,164.38,"og"],[10,14,164.38,164.78,"kona"],[15,18,164.78,164.98,"har"],[19,23,164.98,165.5,"barn"],[25,28,165.82,166.16,"men"],[29,34,166.16,166.6,"barna"],[35,42,166.6,167.06,"flyttet"],[43,45,167.06,167.36,"ut~109beb99f3d1"],[46,49,167.36,167.58,"for~e753a937d19e"],[50,55,167.58,167.94,"mange"],[56,58,167.94,168.14,"år"],[59,64,168.14,168.56,"siden~9a3d2d89a980"]]},{"id":21,"start":169.96,"end":172.45,"text":"Gustav har vært lege i mange år.","zh":"古斯塔夫做了很多年医生。","words":[[0,6,170.02,170.62,"gustav"],[7,10,170.62,170.8,"har~8b9792170cca"],[11,15,170.8,171.04,"vært"],[16,20,171.04,171.66,"lege"],[21,22,171.66,171.78,"i~c0bbfa552007"],[23,28,171.78,172.06,"mange"],[29,31,172.06,172.3,"år"]]},{"id":22,"start":173.05,"end":175.22,"text":"Nå er han pensjonist.","zh":"现在他退休了。","words":[[0,2,173.11,173.5,"nå~d531d47a7712"],[3,5,173.74,173.92,"er"],[6,9,173.92,174.24,"han"],[10,20,174.24,175.07,"pensjonist"]]},{"id":23,"start":176.5,"end":179.54,"text":"Gustav forteller om dugnaden på lørdag.","zh":"古斯塔夫讲了星期六集体义务劳动的事。","words":[[0,6,176.56,177.3,"gustav"],[7,16,177.3,177.84,"forteller"],[17,19,177.84,178.08,"om~52c0bdc828db"],[20,28,178.08,178.84,"dugnaden"],[29,31,178.84,178.98,"på~61b87cb0af5e"],[32,38,178.98,179.39,"lørdag"]]},{"id":24,"start":180.52,"end":183.75,"text":"Marek blir glad for å møte en hyggelig nabo.","zh":"马雷克很高兴遇到一位友善的邻居。","words":[[0,5,180.58,181.16,"marek"],[6,10,181.16,181.46,"blir"],[11,15,181.46,181.84,"glad"],[16,19,181.84,182.0,"for~d06f5440f0d3"],[20,21,182.0,182.12,"å~0583da7a620a"],[22,26,182.12,182.58,"møte~2b04e8ffdc70"],[27,29,182.58,182.72,"en~a939a9e56dc5"],[30,38,182.72,183.18,"hyggelig"],[39,43,183.18,183.6,"nabo"]]}],"lexicon":{"30":{"lemma":"30","zh":"数字 30","pos":"数词","ref":"basics:numbers:tretti","clip":null,"kind":"number"},"40":{"lemma":"40","zh":"数字 40","pos":"数词","ref":"basics:numbers:førti","clip":null,"kind":"number"},"9.3":{"lemma":"9.3","zh":"第 9.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"advokat":{"lemma":"advokat","zh":"律师","pos":"名词","ref":"9-061","clip":"pronunciation/1b2de252d8a897c26d8a.mp3"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"arbeidet":{"lemma":"arbeide","zh":"工作","pos":"动词","ref":"pa-vei-14-057","form":"过去时","clip":null,"ambiguous":true,"candidates":[{"lemma":"arbeide","zh":"工作","pos":"动词","ref":"pa-vei-14-057","form":"过去时"},{"lemma":"arbeid","zh":"工作；劳动","pos":"名词","ref":"basics:work:arbeid","form":"单数定指"}]},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barn":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"2-051","clip":"pronunciation