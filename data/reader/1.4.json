{"id":"1.4","title":"Jeg snakker litt norsk","audio":"audio/1.4.mp3","duration":194.22,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.54,"text":"1.4 Jeg snakker litt norsk","heading":true,"zh":"1.4 我会说一点挪威语","words":[[0,3,0.15,2.77,"1.4"],[4,7,3.39,3.68,"jeg"],[8,15,3.68,4.34,"snakker"],[16,20,4.34,4.7,"litt~462e893626a5"],[21,26,4.7,5.46,"norsk~4de5d75feae1"]]},{"id":1,"start":8.35,"end":11.02,"text":"Håvard kommer fra Norge.","zh":"霍瓦尔来自挪威。","words":[[0,6,8.43,9.04,"håvard"],[7,13,9.04,9.86,"kommer"],[14,17,9.86,10.3,"fra"],[18,23,10.3,10.94,"norge~546b56e35dd5"]]},{"id":2,"start":12.57,"end":17.46,"text":"Han snakker norsk og er lærer på norskkurs.","zh":"他说挪威语，是挪威语课的老师。","words":[[0,3,12.65,13.06,"han"],[4,11,13.06,13.6,"snakker"],[12,17,13.6,14.16,"norsk~4de5d75feae1"],[18,20,14.16,15.14,"og"],[21,23,15.14,15.52,"er"],[24,29,15.52,16.12,"lærer~37398342c31f"],[30,32,16.12,16.38,"på"],[33,42,16.38,17.38,"norskkurs"]]},{"id":3,"start":19.08,"end":22.08,"text":"I klassen snakker de mange språk.","zh":"班上的人说很多种语言。","words":[[0,1,19.16,19.39,"i"],[2,9,19.39,19.89,"klassen"],[10,17,19.89,20.61,"snakker"],[18,20,20.61,20.73,"de"],[21,26,20.73,21.17,"mange"],[27,32,21.17,22.0,"språk"]]},{"id":4,"start":24.5,"end":30.92,"text":"Marek kommer fra Polen og snakker polsk og litt norsk.","zh":"马雷克来自波兰，会说波兰语和一点挪威语。","words":[[0,5,24.59,25.52,"marek"],[6,12,25.52,26.12,"kommer"],[13,16,26.12,26.48,"fra"],[17,22,26.48,27.04,"polen~488e57c60a08"],[23,25,27.04,28.12,"og"],[26,33,28.12,28.76,"snakker"],[34,39,28.76,29.36,"polsk~ad74d5e52fad"],[40,42,29.36,29.86,"og"],[43,47,29.86,30.16,"litt~462e893626a5"],[48,53,30.16,30.84,"norsk~4de5d75feae1"]]},{"id":5,"start":32.18,"end":34.87,"text":"Han snakker ikke engelsk.","zh":"他不会说英语。","words":[[0,3,32.26,32.63,"han"],[4,11,32.63,33.21,"snakker"],[12,16,33.21,33.77,"ikke"],[17,24,33.77,34.79,"engelsk~220c678f9536"]]},{"id":6,"start":37.12,"end":44.02,"text":"Sompit kommer fra Thailand og snakker thai og engelsk.","zh":"松皮特来自泰国，会说泰语和英语。","words":[[0,6,37.2,38.08,"sompit"],[7,13,38.08,38.58,"kommer"],[14,17,38.58,39.02,"fra"],[18,26,39.02,39.44,"thailand"],[27,29,39.44,40.92,"og"],[30,37,40.92,41.54,"snakker"],[38,42,41.54,41.98,"thai~6bdff336db65"],[43,45,42.22,43.04,"og"],[46,53,43.04,43.94,"engelsk~220c678f9536"]]},{"id":7,"start":45.04,"end":47.77,"text":"Hun snakker ikke polsk.","zh":"她不会说波兰语。","words":[[0,3,45.12,45.48,"hun"],[4,11,45.48,46.22,"snakker"],[12,16,46.22,46.72,"ikke"],[17,22,46.72,47.69,"polsk~ad74d5e52fad"]]},{"id":8,"start":49.85,"end":52.86,"text":"Yousef kommer fra Syria.","zh":"优素福来自叙利亚。","words":[[0,6,49.93,50.72,"yousef"],[7,13,50.72,51.36,"kommer"],[14,17,51.36,51.94,"fra"],[18,23,51.94,52.78,"syria~2ae242f98808"]]},{"id":9,"start":54.43,"end":61.54,"text":"Han snakker arabisk og engelsk, og nå forstår han litt norsk.","zh":"他会说阿拉伯语和英语，现在他能听懂一点挪威语。","words":[[0,3,54.51,54.91,"han"],[4,11,54.91,55.51,"snakker"],[12,19,55.51,56.53,"arabisk~3bb978ca6cd0"],[20,22,56.53,57.07,"og"],[23,30,57.07,57.93,"engelsk~220c678f9536"],[32,34,58.61,58.93,"og"],[35,37,58.93,59.25,"nå~d531d47a7712"],[38,45,59.25,59.89,"forstår"],[46,49,59.89,60.17,"han"],[50,54,60.17,60.61,"litt~462e893626a5"],[55,60,60.61,61.46,"norsk~4de5d75feae1"]]},{"id":10,"start":63.44,"end":66.23,"text":"Viola kommer fra Italia.","zh":"维奥拉来自意大利。","words":[[0,5,63.52,64.03,"viola"],[6,12,64.03,64.85,"kommer"],[13,16,64.85,65.31,"fra"],[17,23,65.31,66.15,"italia"]]},{"id":11,"start":67.65,"end":71.25,"text":"Hun snakker italiensk og engelsk.","zh":"她会说意大利语和英语。","words":[[0,3,67.73,68.06,"hun"],[4,11,68.06,68.62,"snakker"],[12,21,68.62,69.72,"italiensk~7d9db500feea"],[22,24,69.72,70.34,"og"],[25,32,70.34,71.17,"engelsk~220c678f9536"]]},{"id":12,"start":72.7,"end":79.15,"text":"Viola forstår mye norsk, men hun forstår ikke arabisk.","zh":"维奥拉能听懂很多挪威语，但她听不懂阿拉伯语。","words":[[0,5,72.78,73.26,"viola"],[6,13,73.26,73.92,"forstår"],[14,17,73.92,74.48,"mye~cc164d0dc3da"],[18,23,74.48,74.98,"norsk~4de5d75feae1"],[25,28,75.76,76.28,"men"],[29,32,76.28,76.7,"hun"],[33,40,76.7,77.3,"forstår"],[41,45,77.3,77.88,"ikke"],[46,53,77.88,79.07,"arabisk~3bb978ca6cd0"]]},{"id":13,"start":80.84,"end":83.86,"text":"Biniam kommer fra Eritrea.","zh":"比尼亚姆来自厄立特里亚。","words":[[0,6,80.92,81.52,"biniam"],[7,13,81.52,82.32,"kommer"],[14,17,82.32,82.82,"fra"],[18,25,82.82,83.78,"eritrea"]]},{"id":14,"start":84.98,"end":91.52,"text":"Han snakker tigrinja, og han forstår litt italiensk og norsk.","zh":"他说提格利尼亚语，他能听懂一点意大利语和挪威语。","words":[[0,3,85.06,85.33,"han"],[4,11,85.33,86.07,"snakker"],[12,20,86.07,87.07,"tigrinja"],[22,24,87.87,88.07,"og"],[25,28,88.07,88.35,"han"],[29,36,88.35,88.97,"forstår"],[37,41,88.97,89.39,"litt~462e893626a5"],[42,51,89.39,90.65,"italiensk~7d9db500feea"],[52,54,90.65,90.83,"og"],[55,60,90.83,91.44,"norsk~4de5d75feae1"]]},{"id":15,"start":93.43,"end":102.7,"text":"Hawa kommer fra Somalia og snakker somali, engelsk og litt italiensk.","zh":"哈娃来自索马里，会说索马里语、英语和一点意大利语。","words":[[0,4,93.51,94.08,"hawa"],[5,11,94.08,94.68,"kommer"],[12,15,94.68,95.08,"fra"],[16,23,95.08,95.7,"somalia"],[24,26,95.7,96.92,"og"],[27,34,96.92,97.52,"snakker"],[35,41,97.52,98.48,"somali~fb1d8fa9fdb8"],[43,50,99.32,100.34,"engelsk~220c678f9536"],[51,53,100.34,101.04,"og"],[54,58,101.04,101.38,"litt~462e893626a5"],[59,68,101.38,102.62,"italiensk~7d9db500feea"]]},{"id":16,"start":104.79,"end":110.62,"text":"Biniam, Viola og Hawa snakker litt italiensk sammen.","zh":"比尼亚姆、维奥拉和哈娃在一起说一点意大利语。","words":[[0,6,104.87,105.69,"biniam"],[8,13,105.87,106.35,"viola"],[14,16,106.35,106.85,"og"],[17,21,106.85,107.43,"hawa"],[22,29,107.43,108.45,"snakker"],[30,34,108.45,108.85,"litt~462e893626a5"],[35,44,108.85,109.89,"italiensk~7d9db500feea"],[45,51,109.89,110.54,"sammen"]]},{"id":17,"start":112.24,"end":116.45,"text":"«På skolen snakker vi norsk», sier Håvard.","zh":"“在学校我们说挪威语。”霍瓦尔说。","words":[[1,3,112.32,112.54,"på"],[4,10,112.54,113.16,"skolen"],[11,18,113.16,113.76,"snakker"],[19,21,113.76,113.94,"vi"],[22,27,113.94,114.66,"norsk~4de5d75feae1"],[30,34,115.56,115.86,"sier"],[35,41,115.86,116.37,"håvard"]]},{"id":18,"start":116.57,"end":119.96,"text":"Han forstår ikke italiensk.","zh":"他听不懂意大利语。","words":[[0,3,116.87,117.81,"han"],[4,11,117.81,118.35,"forstår"],[12,16,118.35,118.75,"ikke"],[17,26,118.75,119.88,"italiensk~7d9db500feea"]]},{"id":19,"start":123.98,"end":129.54,"text":"godinorsk.blogg.no","zh":"godinorsk.blogg.no（博客网址）","words":[[0,18,124.06,129.46,"godinorsk.blogg.no"]]},{"id":20,"start":132.27,"end":132.91,"text":"Hei!","zh":"你好！","words":[[0,3,132.35,132.83,"hei"]]},{"id":21,"start":133.78,"end":136.99,"text":"Jeg heter Hawa og kommer fra Somalia.","zh":"我叫哈娃，来自索马里。","words":[[0,3,133.86,134.24,"jeg"],[4,9,134.24,134.62,"heter"],[10,14,134.62,135.14,"hawa"],[15,17,135.14,135.6,"og"],[18,24,135.6,135.92,"kommer"],[25,28,135.92,136.16,"fra"],[29,36,136.16,136.91,"somalia"]]},{"id":22,"start":137.83,"end":139.72,"text":"Jeg går på norskkurs.","zh":"我在上挪威语课。","words":[[0,3,137.91,138.27,"jeg"],[4,7,138.27,138.53,"går~b93725e46d7b"],[8,10,138.53,138.77,"på~35ec86f98ed0"],[11,20,138.77,139.65,"norskkurs"]]},{"id":23,"start":140.53,"end":141.95,"text":"Vi er mange i klassen.","zh":"我们班上有很多人。","words":[[0,2,140.61,140.73,"vi"],[3,5,140.73,140.89,"er"],[6,11,140.89,141.21,"mange"],[12,13,141.21,141.37,"i"],[14,21,141.37,141.87,"klassen"]]},{"id":24,"start":143.48,"end":144.91,"text":"Vi lærer norsk.","zh":"我们学习挪威语。","words":[[0,2,143.56,143.84,"vi"],[3,8,143.84,144.24,"lærer~0769c7af9c2d"],[9,14,144.24,144.84,"norsk~4de5d75feae1"]]},{"id":25,"start":145.44,"end":149.58,"text":"Jeg forstår ikke mye, men jeg snakker og skriver litt.","zh":"我懂得不多，但我会说一点、写一点。","words":[[0,3,145.52,145.66,"jeg"],[4,11,145.66,146.08,"forstår"],[12,16,146.08,146.32,"ikke"],[17,20,146.32,146.62,"mye~cc164d0dc3da"],[22,25,147.3,147.52,"men"],[26,29,147.52,147.7,"jeg"],[30,37,147.7,148.26,"snakker"],[38,40,148.26,148.62,"og"],[41,48,148.62,149.02,"skriver"],[49,53,149.02,149.5,"litt~54360be2a478"]]},{"id":26,"start":150.29,"end":152.08,"text":"I bloggen skriver jeg norsk.","zh":"在博客里我用挪威语写。","words":[[0,1,150.37,150.48,"i"],[2,9,150.48,150.98,"bloggen"],[10,17,150.98,151.3,"skriver"],[18,21,151.3,151.48,"jeg"],[22,27,151.48,152.0,"norsk~4de5d75feae1"]]},{"id":27,"start":152.72,"end":156.17,"text":"«På skolen snakker vi norsk», sier Håvard.","zh":"“在学校我们说挪威语。”霍瓦尔说。","words":[[1,3,152.8,152.93,"på"],[4,10,152.93,153.49,"skolen"],[11,18,153.49,154.45,"snakker"],[19,21,154.45,154.55,"vi"],[22,27,154.55,155.13,"norsk~4de5d75feae1"],[30,34,155.41,155.59,"sier"],[35,41,155.59,156.09,"håvard"]]},{"id":28,"start":157.15,"end":158.38,"text":"Lærer du norsk?","zh":"你在学挪威语吗？","words":[[0,5,157.23,157.61,"lærer~0769c7af9c2d"],[6,8,157.61,157.79,"du"],[9,14,157.79,158.3,"norsk~4de5d75feae1"]]},{"id":29,"start":161.21,"end":162.35,"text":"Kommentarer","subheading":true,"zh":"评论","words":[[0,11,161.29,162.27,"kommentarer"]]},{"id":30,"start":164.09,"end":165.82,"text":"Fint bilde av klassen.","zh":"这张班级照片真不错。","words":[[0,4,164.17,164.62,"fint"],[5,10,164.62,164.9,"bilde"],[11,13,164.9,165.08,"av"],[14,21,165.08,165.74,"klassen"]]},{"id":31,"start":166.56,"end":167.67,"text":"Smilefjes.","zh":"（笑脸表情）","words":[[0,9,166.64,167.59,"smilefjes"]]},{"id":32,"start":168.07,"end":170.99,"text":"Jeg går på norskkurs.","zh":"我在上挪威语课。","words":[[0,3,168.15,169.1,"jeg"],[4,7,169.1,169.46,"går~b93725e46d7b"],[8,10,169.46,169.96,"på~35ec86f98ed0"],[11,20,169.96,170.91,"norskkurs"]]},{"id":33,"start":172.08,"end":174.09,"text":"Jeg forstår litt norsk.","zh":"我懂一点挪威语。","words":[[0,3,172.16,172.38,"jeg"],[4,11,172.38,173.04,"forstår"],[12,16,173.04,173.3,"litt~462e893626a5"],[17,22,173.3,174.01,"norsk~4de5d75feae1"]]},{"id":34,"start":174.5,"end":176.27,"text":"Jeg leser mye.","zh":"我读得很多。","words":[[0,3,174.5,175.12,"jeg"],[4,9,175.12,175.7,"leser"],[10,13,175.7,176.19,"mye~933c5a923198"]]},{"id":35,"start":177.21,"end":178.72,"text":"Hilsen Yousef","zh":"祝好！优素福","words":[[0,6,177.29,177.