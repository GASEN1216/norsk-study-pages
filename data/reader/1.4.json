{"id":"1.4","title":"Jeg snakker litt norsk","audio":"audio/1.4.mp3","duration":194.22,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.54,"text":"1.4 Jeg snakker litt norsk","heading":true,"zh":"1.4 我会说一点挪威语","words":[[0,3,0.15,2.77,"1.4"],[4,7,3.39,3.68,"jeg"],[8,15,3.68,4.34,"snakker"],[16,20,4.34,4.7,"litt~462e893626a5"],[21,26,4.7,5.46,"norsk~4de5d75feae1"]]},{"id":1,"start":8.38,"end":11.06,"text":"Håvard kommer fra Norge.","zh":"霍瓦尔来自挪威。","words":[[0,6,8.45,9.26,"håvard"],[7,13,9.62,10.08,"kommer"],[14,17,10.08,10.42,"fra"],[18,23,10.42,10.91,"norge~546b56e35dd5"]]},{"id":2,"start":12.61,"end":17.49,"text":"Han snakker norsk og er lærer på norskkurs.","zh":"他说挪威语，是挪威语课的老师。","words":[[0,3,12.67,13.2,"han"],[4,11,13.2,13.7,"snakker"],[12,17,13.7,14.34,"norsk~4de5d75feae1"],[18,20,14.96,15.24,"og"],[21,23,15.34,15.62,"er"],[24,29,15.62,16.26,"lærer~37398342c31f"],[30,32,16.26,16.46,"på"],[33,42,16.46,17.34,"norskkurs"]]},{"id":3,"start":19.14,"end":22.13,"text":"I klassen snakker de mange språk.","zh":"班上的人说很多种语言。","words":[[0,1,19.2,19.48,"i"],[2,9,19.48,20.13,"klassen"],[10,17,20.32,20.64,"snakker"],[18,20,20.64,20.88,"de"],[21,26,20.88,21.4,"mange"],[27,32,21.4,21.98,"språk"]]},{"id":4,"start":24.75,"end":30.97,"text":"Marek kommer fra Polen og snakker polsk og litt norsk.","zh":"马雷克来自波兰，会说波兰语和一点挪威语。","words":[[0,5,24.8,25.68,"marek"],[6,12,25.9,26.32,"kommer"],[13,16,26.32,26.56,"fra"],[17,22,26.56,27.2,"polen~488e57c60a08"],[23,25,27.9,28.24,"og"],[26,33,28.24,28.86,"snakker"],[34,39,28.86,29.63,"polsk~ad74d5e52fad"],[40,42,29.76,29.92,"og"],[43,47,29.92,30.32,"litt~462e893626a5"],[48,53,30.32,30.82,"norsk~4de5d75feae1"]]},{"id":5,"start":32.21,"end":34.91,"text":"Han snakker ikke engelsk.","zh":"他不会说英语。","words":[[0,3,32.27,32.78,"han"],[4,11,32.78,33.34,"snakker"],[12,16,33.34,34.04,"ikke"],[17,24,34.04,34.77,"engelsk~220c678f9536"]]},{"id":6,"start":37.16,"end":44.06,"text":"Sompit kommer fra Thailand og snakker thai og engelsk.","zh":"松皮特来自泰国，会说泰语和英语。","words":[[0,6,37.22,38.3,"sompit"],[7,13,38.3,38.78,"kommer"],[14,17,38.78,39.14,"fra"],[18,26,39.14,39.88,"thailand"],[27,29,40.72,41.04,"og"],[30,37,41.04,41.72,"snakker"],[38,42,41.72,42.2,"thai~6bdff336db65"],[43,45,42.82,43.09,"og"],[46,53,43.24,43.91,"engelsk~220c678f9536"]]},{"id":7,"start":45.07,"end":47.89,"text":"Hun snakker ikke polsk.","zh":"她不会说波兰语。","words":[[0,3,45.13,45.58,"hun"],[4,11,45.8,46.38,"snakker"],[12,16,46.38,46.94,"ikke"],[17,22,46.94,47.74,"polsk~ad74d5e52fad"]]},{"id":8,"start":49.88,"end":52.91,"text":"Yousef kommer fra Syria.","zh":"优素福来自叙利亚。","words":[[0,6,49.95,50.84,"yousef"],[7,13,51.12,51.66,"kommer"],[14,17,51.66,52.14,"fra"],[18,23,52.14,52.77,"syria~2ae242f98808"]]},{"id":9,"start":54.47,"end":61.53,"text":"Han snakker arabisk og engelsk, og nå forstår han litt norsk.","zh":"他会说阿拉伯语和英语，现在他能听懂一点挪威语。","words":[[0,3,54.53,55.04,"han"],[4,11,55.04,55.72,"snakker"],[12,19,55.72,56.84,"arabisk~3bb978ca6cd0"],[20,22,56.84,57.22,"og"],[23,30,57.22,58.12,"engelsk~220c678f9536"],[32,34,58.76,59.04,"og"],[35,37,59.04,59.35,"nå~d531d47a7712"],[38,45,59.48,60.0,"forstår"],[46,49,60.0,60.42,"han"],[50,54,60.42,60.82,"litt~462e893626a5"],[55,60,60.82,61.38,"norsk~4de5d75feae1"]]},{"id":10,"start":63.47,"end":66.29,"text":"Viola kommer fra Italia.","zh":"维奥拉来自意大利。","words":[[0,5,63.53,64.3,"viola"],[6,12,64.68,65.04,"kommer"],[13,16,65.04,65.46,"fra"],[17,23,65.46,66.14,"italia"]]},{"id":11,"start":67.69,"end":71.29,"text":"Hun snakker italiensk og engelsk.","zh":"她会说意大利语和英语。","words":[[0,3,67.75,68.18,"hun"],[4,11,68.18,68.8,"snakker"],[12,21,68.8,69.92,"italiensk~7d9db500feea"],[22,24,70.22,70.46,"og"],[25,32,70.46,71.14,"engelsk~220c678f9536"]]},{"id":12,"start":72.74,"end":79.2,"text":"Viola forstår mye norsk, men hun forstår ikke arabisk.","zh":"维奥拉能听懂很多挪威语，但她听不懂阿拉伯语。","words":[[0,5,72.8,73.48,"viola"],[6,13,73.48,74.16,"forstår"],[14,17,74.16,74.54,"mye~cc164d0dc3da"],[18,23,74.54,75.24,"norsk~4de5d75feae1"],[25,28,76.04,76.54,"men"],[29,32,76.54,76.78,"hun"],[33,40,76.78,77.52,"forstår"],[41,45,77.52,78.2,"ikke"],[46,53,78.2,79.05,"arabisk~3bb978ca6cd0"]]},{"id":13,"start":80.89,"end":83.91,"text":"Biniam kommer fra Eritrea.","zh":"比尼亚姆来自厄立特里亚。","words":[[0,6,80.95,81.82,"biniam"],[7,13,82.08,82.58,"kommer"],[14,17,82.58,83.04,"fra"],[18,25,83.04,83.76,"eritrea"]]},{"id":14,"start":85.02,"end":91.56,"text":"Han snakker tigrinja, og han forstår litt italiensk og norsk.","zh":"他说提格利尼亚语，他能听懂一点意大利语和挪威语。","words":[[0,3,85.08,85.52,"han"],[4,11,85.52,86.22,"snakker"],[12,20,86.34,87.22,"tigrinja"],[22,24,87.86,88.18,"og"],[25,28,88.18,88.46,"han"],[29,36,88.46,89.2,"forstår"],[37,41,89.2,89.74,"litt~462e893626a5"],[42,51,89.74,90.76,"italiensk~7d9db500feea"],[52,54,90.76,90.88,"og"],[55,60,90.88,91.41,"norsk~4de5d75feae1"]]},{"id":15,"start":93.48,"end":102.76,"text":"Hawa kommer fra Somalia og snakker somali, engelsk og litt italiensk.","zh":"哈娃来自索马里，会说索马里语、英语和一点意大利语。","words":[[0,4,93.54,94.22,"hawa"],[5,11,94.4,94.82,"kommer"],[12,15,94.82,95.22,"fra"],[16,23,95.22,96.0,"somalia"],[24,26,96.8,97.0,"og"],[27,34,97.0,97.68,"snakker"],[35,41,97.82,98.72,"somali~fb1d8fa9fdb8"],[43,50,99.48,100.5,"engelsk~220c678f9536"],[51,53,100.96,101.14,"og"],[54,58,101.14,101.6,"litt~462e893626a5"],[59,68,101.6,102.61,"italiensk~7d9db500feea"]]},{"id":16,"start":104.83,"end":110.66,"text":"Biniam, Viola og Hawa snakker litt italiensk sammen.","zh":"比尼亚姆、维奥拉和哈娃在一起说一点意大利语。","words":[[0,6,104.89,105.8,"biniam"],[8,13,105.9,106.62,"viola"],[14,16,106.76,106.92,"og"],[17,21,106.92,107.56,"hawa"],[22,29,107.96,108.62,"snakker"],[30,34,108.62,109.06,"litt~462e893626a5"],[35,44,109.06,109.96,"italiensk~7d9db500feea"],[45,51,109.96,110.51,"sammen"]]},{"id":17,"start":112.28,"end":116.5,"text":"«På skolen snakker vi norsk», sier Håvard.","zh":"“在学校我们说挪威语。”霍瓦尔说。","words":[[1,3,112.34,112.72,"på"],[4,10,112.72,113.32,"skolen"],[11,18,113.32,113.84,"snakker"],[19,21,113.84,114.04,"vi"],[22,27,114.04,114.74,"norsk~4de5d75feae1"],[30,34,115.6,115.92,"sier"],[35,41,115.92,116.35,"håvard"]]},{"id":18,"start":117.48,"end":120.01,"text":"Han forstår ikke italiensk.","zh":"他听不懂意大利语。","words":[[0,3,117.54,117.92,"han"],[4,11,117.92,118.52,"forstår"],[12,16,118.52,118.96,"ikke"],[17,26,118.96,119.86,"italiensk~7d9db500feea"]]},{"id":19,"start":124.02,"end":128.15,"text":"godinorsk.blogg.no","zh":"godinorsk.blogg.no（博客网址）","words":[[0,18,124.08,128.0,"godinorsk.blogg.no"]]},{"id":20,"start":132.3,"end":132.97,"text":"Hei!","zh":"你好！","words":[[0,3,132.36,132.82,"hei"]]},{"id":21,"start":133.88,"end":137.04,"text":"Jeg heter Hawa og kommer fra Somalia.","zh":"我叫哈娃，来自索马里。","words":[[0,3,133.94,134.32,"jeg"],[4,9,134.32,134.72,"heter"],[10,14,134.72,135.34,"hawa"],[15,17,135.52,135.64,"og"],[18,24,135.64,136.02,"kommer"],[25,28,136.02,136.24,"fra"],[29,36,136.24,136.89,"somalia"]]},{"id":22,"start":137.87,"end":139.78,"text":"Jeg går på norskkurs.","zh":"我在上挪威语课。","words":[[0,3,137.93,138.38,"jeg"],[4,7,138.38,138.66,"går~b93725e46d7b"],[8,10,138.66,138.86,"på~35ec86f98ed0"],[11,20,138.86,139.62,"norskkurs"]]},{"id":23,"start":140.56,"end":142.0,"text":"Vi er mange i klassen.","zh":"我们班上有很多人。","words":[[0,2,140.62,140.8,"vi"],[3,5,140.8,140.96,"er"],[6,11,140.96,141.32,"mange"],[12,13,141.32,141.4,"i"],[14,21,141.4,141.85,"klassen"]]},{"id":24,"start":143.51,"end":144.97,"text":"Vi lærer norsk.","zh":"我们学习挪威语。","words":[[0,2,143.57,143.92,"vi"],[3,8,143.92,144.36,"lærer~0769c7af9c2d"],[9,14,144.36,144.81,"norsk~4de5d75feae1"]]},{"id":25,"start":145.48,"end":149.64,"text":"Jeg forstår ikke mye, men jeg snakker og skriver litt.","zh":"我懂得不多，但我会说一点、写一点。","words":[[0,3,145.54,145.74,"jeg"],[4,11,145.74,146.16,"forstår"],[12,16,146.16,146.42,"ikke"],[17,20,146.42,146.86,"mye~cc164d0dc3da"],[22,25,147.42,147.58,"men"],[26,29,147.58,147.76,"jeg"],[30,37,147.76,148.5,"snakker"],[38,40,148.5,148.7,"og"],[41,48,148.7,149.16,"skriver"],[49,53,149.16,149.49,"litt~54360be2a478"]]},{"id":26,"start":150.32,"end":152.12,"text":"I bloggen skriver jeg norsk.","zh":"在博客里我用挪威语写。","words":[[0,1,150.38,150.56,"i"],[2,9,150.56,151.06,"bloggen"],[10,17,151.06,151.4,"skriver"],[18,21,151.4,151.58,"jeg"],[22,27,151.58,151.97,"norsk~4de5d75feae1"]]},{"id":27,"start":152.75,"end":156.2,"text":"«På skolen snakker vi norsk», sier Håvard.","zh":"“在学校我们说挪威语。”霍瓦尔说。","words":[[1,3,152.81,153.04,"på"],[4,10,153.04,153.72,"skolen"],[11,18,154.18,154.5,"snakker"],[19,21,154.5,154.66,"vi"],[22,27,154.66,155.25,"norsk~4de5d75feae1"],[30,34,155.42,155.66,"sier"],[35,41,155.66,156.05,"håvard"]]},{"id":28,"start":157.19,"end":158.44,"text":"Lærer du norsk?","zh":"你在学挪威语吗？","words":[[0,5,157.25,157.66,"lærer~0769c7af9c2d"],[6,8,157.66,157.88,"du"],[9,14,157.88,158.28,"norsk~4de5d75feae1"]]},{"id":29,"start":161.24,"end":162.4,"text":"Kommentarer","subheading":true,"zh":"评论","words":[[0,11,161.3,162.25,"kommentarer"]]},{"id":30,"start":164.12,"end":165.88,"text":"Fint bilde av klassen.","zh":"这张班级照片真不错。","words":[[0,4,164.18,164.72,"fint"],[5,10,164.72,165.02,"bilde"],[11,13,165.02,165.16,"av"],[14,21,165.16,165.73,"klassen"]]},{"id":31,"start":166.6,"end":167.73,"text":"Smilefjes.","zh":"（笑脸表情）","words":[[0,9,166.66,167.58,"smilefjes"]]},{"id":32,"start":168.69,"end":171.04,"text":"Jeg går på norskkurs.","zh":"我在上挪威语课。","words":[[0,3,168.75,169.24,"jeg"],[4,7,169.24,169.74,"går~b93725e46d7b"],[8,10,169.74,170.1,"på~35ec86f98ed0"],[11,20,170.1,170.89,"norskkurs"]]},{"id":33,"start":172.12,"end":174.15,"text":"Jeg forstår litt norsk.","zh":"我懂一点挪威语。","words":[[0,3,172.18,172.48,"jeg"],[4,11,172.48,173.14,"forstår"],[12,16,173.14,173.42,"litt~462e893626a5"],[17,22,173.42,174.0,"norsk~4de5d75feae1"]]},{"id":34,"start":174.9,"end":176.31,"text":"Jeg leser mye.","zh":"我读得很多。","words":[[0,3,174.96,175.2,"jeg"],[4,9,175.2,175.76,"leser"],[10,13,175.76,176.16,"mye~933c5a923198"]]},{"id":35,"start":177.25,"end":178.78,"text":"Hilsen Yousef","zh":"祝好！优素福","words":[[0,6,177.31,178.06,"hilsen"],[7,13,178.06