{"id":"10.3","title":"Vennene våre giftet seg i helga","audio":"audio/10.3.mp3","duration":193.95,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.04,"text":"10.3 Vennene våre giftet seg i helga","heading":true,"zh":"10.3 我们的朋友周末结婚了","words":[[0,4,0.15,1.09,"10.3"],[5,12,1.98,2.7,"vennene"],[13,17,2.7,3.08,"våre"],[18,24,3.08,4.06,"giftet~64012bebd01f"],[25,28,4.06,4.24,"seg~d074eab8ff8e"],[29,30,4.24,4.5,"i"],[31,36,4.5,4.96,"helga"]]},{"id":1,"start":7.53,"end":12.15,"text":"Sompit er hos svigerforeldrene for å hente Bella.","zh":"松皮特在公婆家，她是来接贝拉的。","words":[[0,6,7.59,8.55,"sompit"],[7,9,8.88,9.1,"er"],[10,13,9.1,9.38,"hos"],[14,30,9.38,10.62,"svigerforeldrene"],[31,34,10.9,11.06,"for~eb8cd4a9a3ad"],[35,36,11.06,11.16,"å~0583da7a620a"],[37,42,11.16,11.62,"hente"],[43,48,11.62,12.0,"bella"]]},{"id":2,"start":13.81,"end":17.2,"text":"Hvordan var det å være i et norsk bryllup?","speaker":"Svigermor","zh":"参加挪威的婚礼感觉怎么样？","words":[[0,7,13.88,14.48,"hvordan"],[8,11,14.48,14.74,"var"],[12,15,14.74,15.1,"det"],[16,17,15.1,15.24,"å~0583da7a620a"],[18,22,15.24,15.68,"være"],[23,24,15.68,15.82,"i~74358c3ac557"],[25,27,15.82,16.1,"et~054dde72f37b"],[28,33,16.1,16.52,"norsk~300c0d0c4f59"],[34,41,16.52,17.05,"bryllup"]]},{"id":3,"start":18.05,"end":22.97,"text":"Det var så spennende og helt forskjellig fra bryllup i hjemlandet mitt.","speaker":"Sompit","zh":"非常有意思，和我祖国的婚礼完全不一样。","words":[[0,3,18.11,18.34,"det"],[4,7,18.34,18.68,"var"],[8,10,18.68,19.1,"så~89d85de5e862"],[11,20,19.1,19.83,"spennende"],[21,23,20.16,20.4,"og"],[24,28,20.4,20.88,"helt~028cf283635e"],[29,40,20.88,21.38,"forskjellig"],[41,44,21.38,21.58,"fra"],[45,52,21.58,22.06,"bryllup"],[53,54,22.06,22.14,"i"],[55,65,22.14,22.6,"hjemlandet"],[66,70,22.6,22.82,"mitt"]]},{"id":4,"start":23.96,"end":28.77,"text":"I Thailand er det vanlig å ha 300 gjester, ikke bare 50.","zh":"在泰国，婚礼通常有300位客人，而不只是50位。","words":[[0,1,24.04,24.16,"i"],[2,10,24.16,24.48,"thailand"],[11,13,24.48,24.82,"er"],[14,17,24.82,24.92,"det"],[18,24,24.92,25.28,"vanlig"],[25,26,25.28,25.42,"å~0583da7a620a"],[27,29,25.42,25.62,"ha~ca5edb8b1cdb"],[30,33,25.62,26.5,"300"],[34,41,26.5,26.94,"gjester"],[43,47,27.66,27.86,"ikke"],[48,52,27.86,28.06,"bare"],[53,55,28.06,28.69,"50"]]},{"id":5,"start":29.4,"end":30.87,"text":"Hadde dere fint vær?","speaker":"Svigermor","zh":"那几天天气好吗？","words":[[0,5,29.46,29.78,"hadde"],[6,10,29.78,30.06,"dere"],[11,15,30.06,30.4,"fint"],[16,19,30.4,30.72,"vær~c9ef13faaa9b"]]},{"id":6,"start":31.64,"end":44.09,"text":"Ja, vi var veldig heldige med været. Det var nydelig vær både fredag og lørdag. På fredag var vi ute til sola gikk ned, og det var ikke kaldt.","speaker":"Sompit","zh":"是的，我们运气很好，碰上了好天气。星期五和星期六天气都特别好。星期五我们一直在外面待到太阳落山，而且一点也不冷。","words":[[0,2,31.7,32.11,"ja"],[4,6,32.56,32.68,"vi"],[7,10,32.68,32.98,"var"],[11,17,32.98,33.54,"veldig"],[18,25,33.54,33.96,"heldige"],[26,29,33.96,34.1,"med~f39daeee34ae"],[30,35,34.1,34.58,"været"],[37,40,35.34,35.44,"det"],[41,44,35.44,35.62,"var"],[45,52,35.62,36.16,"nydelig"],[53,56,36.16,36.62,"vær~c9ef13faaa9b"],[57,61,36.72,37.2,"både"],[62,68,37.2,37.72,"fredag"],[69,71,37.72,37.96,"og"],[72,78,37.96,38.53,"lørdag"],[80,82,39.66,39.84,"på~f9da194097d2"],[83,89,39.84,40.36,"fredag"],[90,93,40.36,40.52,"var"],[94,96,40.52,40.72,"vi"],[97,100,40.72,41.06,"ute"],[101,104,41.06,41.3,"til~55047c20df14"],[105,109,41.3,41.66,"sola"],[110,114,41.66,41.84,"gikk~6ee146950e41"],[115,118,41.84,42.3,"ned~15a2cb939f12"],[120,122,42.68,42.8,"og"],[123,126,42.8,42.92,"det"],[127,130,42.92,43.16,"var"],[131,135,43.16,43.5,"ikke"],[136,141,43.5,43.95,"kaldt"]]},{"id":7,"start":44.85,"end":46.66,"text":"Hvordan var det i kirken, da?","speaker":"Svigermor","zh":"那教堂里怎么样？","words":[[0,7,44.91,45.28,"hvordan"],[8,11,45.28,45.44,"var"],[12,15,45.44,45.64,"det"],[16,17,45.64,45.8,"i"],[18,24,45.8,46.26,"kirken"],[26,28,46.26,46.51,"da~38911ce223ea"]]},{"id":8,"start":47.32,"end":51.02,"text":"Det var fint, men jeg forsto ikke dialekten til presten.","speaker":"Sompit","zh":"很好，但我听不懂牧师的方言。","words":[[0,3,47.38,47.54,"det"],[4,7,47.54,47.72,"var"],[8,12,47.72,48.31,"fint"],[14,17,48.94,49.08,"men"],[18,21,49.08,49.22,"jeg"],[22,28,49.22,49.6,"forsto~165a56d4aafa"],[29,33,49.6,49.78,"ikke"],[34,43,49.78,50.3,"dialekten"],[44,47,50.3,50.42,"til~8de1a9181f86"],[48,55,50.42,50.87,"presten"]]},{"id":9,"start":51.93,"end":56.71,"text":"Bruden var vakker, og kjolen hennes var helt fantastisk.","zh":"新娘很美，她的婚纱简直太棒了。","words":[[0,6,51.99,52.52,"bruden"],[7,10,52.52,52.78,"var"],[11,17,52.78,53.44,"vakker"],[19,21,53.86,54.04,"og"],[22,28,54.04,54.46,"kjolen"],[29,35,54.46,54.82,"hennes"],[36,39,54.82,55.12,"var"],[40,44,55.12,55.58,"helt~09b00b4a2abd"],[45,55,55.58,56.56,"fantastisk"]]},{"id":10,"start":57.7,"end":60.8,"text":"Jeg gråt litt, for det var så romantisk.","zh":"我哭了一会儿，因为太浪漫了。","words":[[0,3,57.76,57.96,"jeg"],[4,8,57.96,58.34,"gråt"],[9,13,58.34,58.81,"litt~54360be2a478"],[15,18,59.18,59.28,"for~1b22712a94b1"],[19,22,59.28,59.4,"det"],[23,26,59.4,59.66,"var"],[27,29,59.66,59.9,"så~b10903249852"],[30,39,59.9,60.66,"romantisk"]]},{"id":11,"start":61.82,"end":66.59,"text":"Det høres fint ut. Hvor spiste dere bryllupsmiddag?","speaker":"Svigermor","zh":"听起来很不错。你们在哪儿吃的婚宴？","words":[[0,3,61.88,62.24,"det"],[4,9,62.24,62.84,"høres~8bd429d18814"],[10,14,62.84,63.18,"fint"],[15,17,63.18,63.59,"ut~e714e39fa98b"],[19,23,64.42,64.66,"hvor"],[24,30,64.66,65.16,"spiste"],[31,35,65.16,65.5,"dere"],[36,50,65.5,66.44,"bryllupsmiddag"]]},{"id":12,"start":67.35,"end":76.91,"text":"Vi spiste på restauranten på Fjellstua. Den ligger høyt over byen og har fantastisk utsikt over Ålesund og øyene rundt.","speaker":"Sompit","zh":"我们在Fjellstua的餐厅吃的。它位于城市上方的高处，可以俯瞰奥勒松和周围岛屿的绝佳景色。","words":[[0,2,67.41,67.76,"vi"],[3,9,67.76,68.44,"spiste"],[10,12,68.44,68.62,"på"],[13,25,68.62,69.32,"restauranten"],[26,28,69.32,69.5,"på"],[29,38,69.5,70.3,"fjellstua"],[40,43,70.92,71.12,"den"],[44,50,71.12,71.48,"ligger"],[51,55,71.48,71.96,"høyt"],[56,60,71.96,72.18,"over"],[61,65,72.18,72.68,"byen"],[66,68,72.96,73.06,"og"],[69,72,73.06,73.28,"har"],[73,83,73.28,74.22,"fantastisk"],[84,90,74.22,74.76,"utsikt"],[91,95,74.76,75.02,"over"],[96,103,75.02,75.76,"ålesund"],[104,106,75.9,76.08,"og"],[107,112,76.08,76.42,"øyene"],[113,118,76.42,76.76,"rundt~08788d8498e1"]]},{"id":13,"start":77.97,"end":84.96,"text":"Ja, der har jeg vært, men det er mange år siden nå. Var det mange taler under middagen?","speaker":"Svigermor","zh":"是的，我去过那里，不过那已经是很多年前的事了。晚宴上有很多人致辞吗？","words":[[0,2,78.03,78.44,"ja"],[4,7,78.68,78.94,"der"],[8,11,78.94,79.1,"har~8b9792170cca"],[12,15,79.1,79.28,"jeg"],[16,20,79.28,79.76,"vært"],[22,25,80.32,80.46,"men"],[26,29,80.46,80.6,"det"],[30,32,80.6,80.78,"er"],[33,38,80.78,81.14,"mange"],[39,41,81.14,81.3,"år"],[42,47,81.3,81.58,"siden~9a3d2d89a980"],[48,50,81.58,81.88,"nå~d531d47a7712"],[52,55,82.84,82.98,"var"],[56,59,82.98,83.12,"det"],[60,65,83.12,83.44,"mange"],[66,71,83.44,84.06,"taler"],[72,77,84.06,84.28,"under~6ac1c1e92611"],[78,86,84.28,84.81,"middagen"]]},{"id":14,"start":85.89,"end":95.77,"text":"Ja, det var over ti taler. Onkelen til brudgommen snakket kjempelenge, og ei eldre dame sovnet faktisk.","speaker":"Sompit","zh":"是的，有十多次致辞。新郎的叔叔讲了特别久，有一位上了年纪的女士居然睡着了。","words":[[0,2,85.95,86.44,"ja"],[4,7,86.94,87.06,"det"],[8,11,87.06,87.24,"var"],[12,16,87.24,87.76,"over~25ba017bad18"],[17,19,87.76,88.26,"ti"],[20,25,88.26,88.92,"taler"],[27,34,89.74,90.24,"onkelen"],[35,38,90.24,90.38,"til~8de1a9181f86"],[39,49,90.38,91.1,"brudgommen"],[50,57,91.1,91.74,"snakket~b025dd4aaf04"],[58,69,91.74,92.92,"kjempelenge"],[71,73,93.3,93.44,"og"],[74,76,93.44,93.64,"ei~47aa2d18e376"],[77,82,93.64,94.02,"eldre"],[83,87,94.02,94.48,"dame"],[88,94,94.48,95.06,"sovnet"],[95,102,95.06,95.62,"faktisk"]]},{"id":15,"start":96.74,"end":100.43,"text":"Er det sant? Holdt Kjetil også tale?","speaker":"Svigermor","zh":"真的吗？谢蒂尔也致辞了吗？","words":[[0,2,96.8,96.94,"er"],[3,6,96.94,97.26,"det"],[7,11,97.26,97.98,"sant"],[13,18,98.84,99.12,"holdt~7227e8f8f171"],[19,25,99.12,99.6,"kjetil"],[26,30,99.6,99.86,"også"],[31,35,99.86,100.28,"tale"]]},{"id":16,"start":101.12,"end":105.4,"text":"Ja, talen hans var veldig morsom, og mange lo.","speaker":"Sompit","zh":"是的，他的讲话非常有趣，很多人都笑了。","words":[[0,2,101.18,101.58,"ja"],[4,9,102.1,102.54,"talen"],[10,14,102.54,102.84,"hans"],[15,18,102.84,103.12,"var"],[19,25,103.12,103.56,"veldig"],[26,32,103.56,104.16,"morsom"],[34,36,104.28,104.48,"og"],[37,42,104.48,104.96,"mange"],[43,45,104.96,105.25,"lo"]]},{"id":17,"start":106.39,"end":116.48,"text":"Ja, det kan jeg tenke meg. Morten er jo barndomsvennen hans, og de har gjort mye rart sammen. Fikk brudeparet mange fine gaver?","speaker":"Svigermor","zh":"是啊，我能想象。莫滕毕竟是他儿时的朋友，他们一起干过很多怪事。新婚夫妇收到了很多好礼物吗？","words":[[0,2,106.45,106.86,"ja"],[4,7,106.86,107.14,"det"],[8,11,107.14,107.3,"kan"],[12,15,107.3,107.54,"jeg"],[16,21,107.54,108.1,"tenke~ebc2e3b4692d"],[22,25,108.1,108.46,"meg"],[27,33,108.92,109.4,"morten"],[34,36,109.4,109.64,"er"],[37,39,109.64,109.88,"jo~098a15bbbc37"],[40,54,109.88,110.78,"barndomsvennen"],[55,59,110.78,111.32,"hans"],[61,63,111.54,111.64,"og"],[64,66,111.64,111.78,"de"],[67,70,111.78,111.9,"har~8b9792170cca"],[71,76,111.9,112.24,"gjort"],[77,80,112.24,112.6,"mye~cc164d0dc3da"],[81,85,112.6,112.86,"rart~43b4cd592dd9"],[86,92,112.86,113.36,"sammen"],[94,98,114.32,114.56,"fikk~e94d2a93d84d"],[99,109,114.56,115.18,"brudeparet"],[110,115,115.18,115.5,"mange"],[116,120,115.5,115.82,"fine"],[121,126,115.82,116.33,"gaver"]]},{"id":18,"start":117.33,"end":125.24,"text":"Ja, de fikk mye fint. Alle gjestene fikk se gavene deres, for gavene sto på et stort gavebord.","speaker":"Sompit","zh":"是的，他们收到了很多好东西。所有客人都能看到他们的礼物，因为礼物都摆在一张大礼品桌上。","words":[[0,2,117.39,117.86,"ja"],[4,6,118.16,118.32,"de"],[7,11,118.32,118.6,"fikk~e94d2a93d84d"],[12,15,118.6,119.04,"mye~cc164d0dc3da"],[16,20,119.04,119.6,"fint"],[22,26,120.2,120.64,"alle~6873d9584096"],[27,35,120.64,121.22,"gjestene"],[36,40,121.22,121.4,"fikk~f2a4ebd4cfb3"],[41,43,121.4,121.64,"se"],[44,50,121.64,122.06,"gavene"],[51,56,122.06,122.62,"deres"],[58,61,122.78,122.94,"for~1b22712a94b1"],[62,68,122.94,123.38,"gavene"],[69,72,123.38,123.62,"sto~85d02948d0e3"],[73,75,123.62,123.74,"på"],[76,78,123.74,123.96,"et~054dde72f37b"],[79,84,123.96,124.54,"stort"],[85,93,124.54,125.09,"gavebord"]]},{"id":19,"start":126.08,"end":128.67,"text":"De fikk fire like blomstervaser.","zh":"他们收到了四个一模一样的花瓶。","words":[[0,2,126.14,126.3,"de"],[3,7,126.3,126.62,"fikk~e94d2a93d84d"],[8,12,126.62,127.2,"fire"],[13,17,127.2,127.72,"like~20e4ad624b8e"],[18,31,127.72,128.52,"blomstervaser"]]},{"id":20,"start":129.44,"end":134.94,"text":"Fikk de fire like vaser? Hva kjøpte dere i gave?","speaker":"Svigermor","zh":"他们收到了四个一样的花瓶？你们买了什么作礼物？","words":[[0,4,129.5,129.92,"fikk~e94d2a93d84d"],[5,7,129.92,130.22,"de"],[8,12,130.32,130.98,"fire"],[13,17,130.98,131.52,"like~20e4ad624b8e"],[18,23,131.52,132.18,"vaser"],[25,28,133.42,133.62,"hva"],[29,35,133.62,133.96,"kjøpte"],[36,40,133.96,134.3,"dere"],[41,42,134.3,134.4,"i~0283fbeb81b2"],[43,47,134.4,134.78,"gave"]]},{"id":21,"start":135.66,"end":136.97,"text":"En blomstervase.","speaker":"Sompit","zh":"一个花瓶。","words":[[0,2,135.72,135.94,"en~a939a9e56dc5"],[3,15,135.94,136.82,"blomstervase"]]},{"id":22,"start":142.46,"end":143.58,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,142.52,143.43,"sammendrag"]]},{"id":23,"start":144.84,"end":148.65,"text":"Sompit og svigermor snakker sammen om bryllupet i Ålesund.","zh":"松皮特和婆婆在聊奥勒松的婚礼。","words":[[0,6,144.9,145.58,"sompit"],[7,9,145.58,145.72,"og"],[10,19,145.72,146.34,"svigermor"],[20,27,146.34,146.74,"snakker"],[28,34,146.74,147.16,"sammen"],[35,37,147.16,147.28,"om~52c0bdc828db"],[38,47,147.28,147.8,"bryllupet"],[48,49,147.8,147.92,"i"],[50,57,147.92,148.5,"ålesund"]]},{"id":24,"start":149.57,"end":155.12,"text":"Brudeparet var heldige med været hele helga, og de hadde en fin seremoni i kirken.","zh":"整个周末新婚夫妇都赶上了好天气，他们在教堂里举行了一场美好的仪式。","words":[[0,10,149.63,150.32,"brudeparet"],[11,14,150.32,150.52,"var"],[15,22,150.52,150.98,"heldige"],[23,26,150.98,151.14,"med~f39daeee34ae"],[27,32,151.14,151.54,"været"],[33,37,151.54,151.9,"hele"],[38,43,151.9,152.44,"helga"],[45,47,152.68,152.78,"og"],[48,50,152.78,152.92,"de"],[51,56,152.92,153.14,"hadde"],[57,59,153.14,153.34,"en~a939a9e56dc5"],[60,63,153.34,153.72,"fin"],[64,72,153.72,154.38,"seremoni"],[73,74,154.38,154.48,"i"],[75,81,154.48,154.97,"kirken"]]},{"id":25,"start":156.18,"end":163.47,"text":"Bryllupsmiddagen var på Fjellstua med fin utsikt over Ålesund, og det var mange taler under middagen.","zh":"婚宴在Fjellstua举行，可以看到奥勒松的美景，晚宴上有很多人致辞。","words":[[0,16,156.24,157.28,"bryllupsmiddagen"],[17,20,157.28,157.5,"var"],[21,23,157.5,157.66,"på"],[24,33,157.66,158.46,"fjellstua"],[34,37,158.7,158.88,"med"],[38,41,158.88,159.28,"fin"],[42,48,159.28,159.84,"utsikt"],[49,53,159.84,160.1,"over"],[54,61,160.1,160.81,"ålesund"],[63,65,161.28,161.38,"og"],[66,69,161.38,161.5,"det"],[70,73,161.5,161.68,"var"],[74,79,161.68,162.0,"mange"],[80,85,162.0,162.52,"taler"],[86,91,162.52,162.78,"under~6ac1c1e92611"],[92,100,162.78,163.31,"middagen"]]},{"id":26,"start":164.8,"end":168.79,"text":"Kjetil holdt en morsom tale til barndomsvennen Morten.","zh":"谢蒂尔为儿时的朋友莫滕做了一番有趣的致辞。","words":[[0,6,164.86,165.58,"kjetil"],[7,12,165.58,165.96,"holdt~7227e8f8f171"],[13,15,165.96,166.12,"en~a939a9e56dc5"],[16,22,166.12,166.56,"morsom"],[23,27,166.56,167.08,"tale"],[28,31,167.08,167.32,"til~90405c67e65b"],[32,46,167.32,168.22,"barndomsvennen"],[47,53,168.22,168.64,"morten"]]},{"id":27,"start":169.86,"end":175.7,"text":"Brudeparet fikk mange fine gaver, men de fikk fire like blomstervaser.","zh":"新婚夫妇收到了很多好礼物，但他们收到了四个一模一样的花瓶。","words":[[0,10,169.92,170.76,"brudeparet"],[11,15,170.76,171.04,"fikk"],[16,21,171.04,171.46,"mange"],[22,26,171.46,171.8,"fine"],[27,32,171.8,172.38,"gaver"],[34,37,173.02,173.2,"men"],[38,40,173.2,173.36,"de"],[41,45,173.36,173.64,"fikk"],[46,50,173.64,174.16,"fire"],[51,55,174.16,174.58,"like~20e4ad624b8e"],[56,69,174.58,175.55,"blomstervaser"]]},{"id":28,"start":179.46,"end":181.82,"text":"Vi skal ha innflyttingsfest i helga.","zh":"我们周末要办乔迁派对。","words":[[0,2,179.52,179.82,"vi"],[3,7,179.82,180.04,"skal"],[8,10,180.04,180.26,"ha~a9a57b92ad7b"],[11,27,180.26,181.26,"innflyttingsfest"],[28,29,181.26,181.34,"i"],[30,35,181.34,181.67,"helga"]]},{"id":29,"start":182.46,"end":184.87,"text":"Kom og se den nye leiligheten vår!","zh":"来看看我们的新公寓吧！","words":[[0,3,182.52,182.9,"kom~5c2eea2b1229"],[4,6,182.9,183.04,"og"],[7,9,183.04,183.4,"se~26e2daf31e48"],[10,13,183.4,183.58,"den~5f413bef0ba1"],[14,17,183.58,183.88,"nye"],[18,29,183.88,184.5,"leiligheten"],[30,33,184.5,184.72,"vår~51869e30bae0"]]},{"id":30,"start":185.58,"end":187.6,"text":"Dere er velkommen klokka 18.","zh":"欢迎你们18点光临。","words":[[0,4,185.66,185.9,"dere"],[5,7,185.9,186.0,"er"],[8,17,186.0,186.44,"velkommen"],[18,24,186.44,187.04,"klokka"],[25,27,187.04,187.52,"18"]]},{"id":31,"start":188.44,"end":190.48,"text":"Hilsen Marek og Ewa.","zh":"马雷克和埃娃敬上。","words":[[0,6,188.5,189.18,"hilsen"],[7,12,189.18,189.86,"marek"],[13,15,189.86,190.0,"og"],[16,19,190.0,190.33,"ewa"]]}],"lexicon":{"10.3":{"lemma":"10.3","zh":"第 10.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"18":{"lemma":"18","zh":"数字 18","pos":"数词","ref":"basics:numbers:atten","clip":null,"kind":"number"},"300":{"lemma":"300","zh":"数字 300","pos":"数词","ref":null,"clip":null,"kind":"number"},"50":{"lemma":"50","zh":"数字 50","pos":"数词","ref":"basics:numbers:femti","clip":null,"kind":"number"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"barndomsvennen":{"lemma":"barndomsvenn","zh":"儿时的朋友","pos":"名词","ref":"10-056","form":"单数定指","clip":null},"bella":{"lemma":"Bella","zh":"贝拉（狗名）","pos":