{"id":"10.3","title":"Vennene våre giftet seg i helga","audio":"audio/10.3.mp3","duration":193.95,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.04,"text":"10.3 Vennene våre giftet seg i helga","heading":true,"zh":"10.3 我们的朋友周末结婚了","words":[[0,4,0.15,1.09,"10.3"],[5,12,1.98,2.7,"vennene"],[13,17,2.7,3.08,"våre"],[18,24,3.08,4.06,"giftet~64012bebd01f"],[25,28,4.06,4.24,"seg~d074eab8ff8e"],[29,30,4.24,4.5,"i"],[31,36,4.5,4.96,"helga"]]},{"id":1,"start":7.5,"end":12.08,"text":"Sompit er hos svigerforeldrene for å hente Bella.","zh":"松皮特在公婆家，她是来接贝拉的。","words":[[0,6,7.58,8.31,"sompit"],[7,9,8.31,9.01,"er"],[10,13,9.01,9.25,"hos"],[14,30,9.25,10.39,"svigerforeldrene"],[31,34,10.39,10.99,"for~eb8cd4a9a3ad"],[35,36,10.99,11.09,"å~0583da7a620a"],[37,42,11.09,11.39,"hente"],[43,48,11.39,12.0,"bella"]]},{"id":2,"start":13.78,"end":17.15,"text":"Hvordan var det å være i et norsk bryllup?","speaker":"Svigermor","zh":"参加挪威的婚礼感觉怎么样？","words":[[0,7,13.86,14.35,"hvordan"],[8,11,14.35,14.67,"var"],[12,15,14.67,14.89,"det"],[16,17,14.89,15.17,"å~0583da7a620a"],[18,22,15.17,15.47,"være"],[23,24,15.47,15.79,"i~74358c3ac557"],[25,27,15.79,15.95,"et~054dde72f37b"],[28,33,15.95,16.45,"norsk~300c0d0c4f59"],[34,41,16.45,17.07,"bryllup"]]},{"id":3,"start":18.03,"end":22.93,"text":"Det var så spennende og helt forskjellig fra bryllup i hjemlandet mitt.","speaker":"Sompit","zh":"非常有意思，和我祖国的婚礼完全不一样。","words":[[0,3,18.11,18.26,"det"],[4,7,18.26,18.48,"var"],[8,10,18.48,18.94,"så~89d85de5e862"],[11,20,18.94,19.6,"spennende"],[21,23,19.6,20.24,"og"],[24,28,20.24,20.74,"helt~028cf283635e"],[29,40,20.74,21.32,"forskjellig"],[41,44,21.32,21.5,"fra"],[45,52,21.5,21.96,"bryllup"],[53,54,21.96,22.14,"i"],[55,65,22.14,22.56,"hjemlandet"],[66,70,22.56,22.85,"mitt"]]},{"id":4,"start":23.96,"end":28.77,"text":"I Thailand er det vanlig å ha 300 gjester, ikke bare 50.","zh":"在泰国，婚礼通常有300位客人，而不只是50位。","words":[[0,1,24.04,24.16,"i"],[2,10,24.16,24.48,"thailand"],[11,13,24.48,24.82,"er"],[14,17,24.82,24.92,"det"],[18,24,24.92,25.28,"vanlig"],[25,26,25.28,25.42,"å~0583da7a620a"],[27,29,25.42,25.62,"ha~ca5edb8b1cdb"],[30,33,25.62,26.5,"300"],[34,41,26.5,26.94,"gjester"],[43,47,27.66,27.86,"ikke"],[48,52,27.86,28.06,"bare"],[53,55,28.06,28.69,"50"]]},{"id":5,"start":29.37,"end":30.82,"text":"Hadde dere fint vær?","speaker":"Svigermor","zh":"那几天天气好吗？","words":[[0,5,29.45,29.7,"hadde"],[6,10,29.7,29.94,"dere"],[11,15,29.94,30.28,"fint"],[16,19,30.28,30.74,"vær~c9ef13faaa9b"]]},{"id":6,"start":31.6,"end":44.04,"text":"Ja, vi var veldig heldige med været. Det var nydelig vær både fredag og lørdag. På fredag var vi ute til sola gikk ned, og det var ikke kaldt.","speaker":"Sompit","zh":"是的，我们运气很好，碰上了好天气。星期五和星期六天气都特别好。星期五我们一直在外面待到太阳落山，而且一点也不冷。","words":[[0,2,31.68,31.98,"ja"],[4,6,32.46,32.64,"vi"],[7,10,32.64,32.78,"var"],[11,17,32.78,33.48,"veldig"],[18,25,33.48,33.88,"heldige"],[26,29,33.88,34.04,"med~f39daeee34ae"],[30,35,34.04,34.36,"været"],[37,40,34.5,35.4,"det"],[41,44,35.4,35.52,"var"],[45,52,35.52,36.12,"nydelig"],[53,56,36.12,36.42,"vær~c9ef13faaa9b"],[57,61,36.42,37.02,"både"],[62,68,37.02,37.6,"fredag"],[69,71,37.6,37.88,"og"],[72,78,37.88,38.34,"lørdag"],[80,82,39.57,39.77,"på~f9da194097d2"],[83,89,39.77,40.23,"fredag"],[90,93,40.23,40.47,"var"],[94,96,40.47,40.61,"vi"],[97,100,40.61,41.01,"ute"],[101,104,41.01,41.15,"til~55047c20df14"],[105,109,41.15,41.49,"sola"],[110,114,41.49,41.77,"gikk~6ee146950e41"],[115,118,41.77,42.01,"ned~15a2cb939f12"],[120,122,42.47,42.77,"og"],[123,126,42.77,42.89,"det"],[127,130,42.89,43.03,"var"],[131,135,43.03,43.39,"ikke"],[136,141,43.39,43.96,"kaldt"]]},{"id":7,"start":44.82,"end":46.61,"text":"Hvordan var det i kirken, da?","speaker":"Svigermor","zh":"那教堂里怎么样？","words":[[0,7,44.9,45.17,"hvordan"],[8,11,45.17,45.41,"var"],[12,15,45.41,45.55,"det"],[16,17,45.55,45.81,"i"],[18,24,45.81,46.21,"kirken"],[26,28,46.21,46.53,"da~38911ce223ea"]]},{"id":8,"start":47.31,"end":50.96,"text":"Det var fint, men jeg forsto ikke dialekten til presten.","speaker":"Sompit","zh":"很好，但我听不懂牧师的方言。","words":[[0,3,47.39,47.49,"det"],[4,7,47.49,47.63,"var"],[8,12,47.63,48.03,"fint"],[14,17,48.79,49.03,"men"],[18,21,49.03,49.17,"jeg"],[22,28,49.17,49.53,"forsto~165a56d4aafa"],[29,33,49.53,49.71,"ikke"],[34,43,49.71,50.23,"dialekten"],[44,47,50.23,50.39,"til~8de1a9181f86"],[48,55,50.39,50.88,"presten"]]},{"id":9,"start":51.68,"end":56.66,"text":"Bruden var vakker, og kjolen hennes var helt fantastisk.","zh":"新娘很美，她的婚纱简直太棒了。","words":[[0,6,51.68,52.38,"bruden"],[7,10,52.38,52.66,"var"],[11,17,52.66,53.24,"vakker"],[19,21,53.6,53.96,"og"],[22,28,53.96,54.36,"kjolen"],[29,35,54.36,54.72,"hennes"],[36,39,54.72,54.92,"var"],[40,44,54.92,55.46,"helt~09b00b4a2abd"],[45,55,55.46,56.58,"fantastisk"]]},{"id":10,"start":57.66,"end":60.75,"text":"Jeg gråt litt, for det var så romantisk.","zh":"我哭了一会儿，因为太浪漫了。","words":[[0,3,57.73,57.9,"jeg"],[4,8,57.9,58.26,"gråt"],[9,13,58.26,58.58,"litt~54360be2a478"],[15,18,59.16,59.28,"for~1b22712a94b1"],[19,22,59.28,59.36,"det"],[23,26,59.36,59.52,"var"],[27,29,59.52,59.82,"så~b10903249852"],[30,39,59.82,60.67,"romantisk"]]},{"id":11,"start":61.71,"end":66.53,"text":"Det høres fint ut. Hvor spiste dere bryllupsmiddag?","speaker":"Svigermor","zh":"听起来很不错。你们在哪儿吃的婚宴？","words":[[0,3,61.79,62.12,"det"],[4,9,62.12,62.72,"høres~8bd429d18814"],[10,14,62.72,63.02,"fint"],[15,17,63.02,63.28,"ut~e714e39fa98b"],[19,23,64.22,64.58,"hvor"],[24,30,64.58,65.08,"spiste"],[31,35,65.08,65.34,"dere"],[36,50,65.34,66.45,"bryllupsmiddag"]]},{"id":12,"start":67.31,"end":76.87,"text":"Vi spiste på restauranten på Fjellstua. Den ligger høyt over byen og har fantastisk utsikt over Ålesund og øyene rundt.","speaker":"Sompit","zh":"我们在Fjellstua的餐厅吃的。它位于城市上方的高处，可以俯瞰奥勒松和周围岛屿的绝佳景色。","words":[[0,2,67.39,67.66,"vi"],[3,9,67.66,68.3,"spiste"],[10,12,68.3,68.56,"på"],[13,25,68.56,69.24,"restauranten"],[26,28,69.24,69.42,"på"],[29,38,69.42,70.06,"fjellstua"],[40,43,70.76,71.08,"den"],[44,50,71.08,71.3,"ligger"],[51,55,71.3,71.84,"høyt"],[56,60,71.84,72.12,"over"],[61,65,72.12,72.48,"byen"],[66,68,72.48,73.02,"og"],[69,72,73.02,73.18,"har"],[73,83,73.18,74.14,"fantastisk"],[84,90,74.14,74.6,"utsikt"],[91,95,74.6,74.92,"over"],[96,103,74.92,75.48,"ålesund"],[104,106,75.48,75.98,"og"],[107,112,75.98,76.38,"øyene"],[113,118,76.38,76.79,"rundt~08788d8498e1"]]},{"id":13,"start":77.93,"end":84.9,"text":"Ja, der har jeg vært, men det er mange år siden nå. Var det mange taler under middagen?","speaker":"Svigermor","zh":"是的，我去过那里，不过那已经是很多年前的事了。晚宴上有很多人致辞吗？","words":[[0,2,78.01,78.33,"ja"],[4,7,78.65,78.89,"der"],[8,11,78.89,79.05,"har~8b9792170cca"],[12,15,79.05,79.19,"jeg"],[16,20,79.19,79.45,"vært"],[22,25,80.27,80.41,"men"],[26,29,80.41,80.55,"det"],[30,32,80.55,80.67,"er"],[33,38,80.67,80.97,"mange"],[39,41,80.97,81.25,"år"],[42,47,81.25,81.49,"siden~9a3d2d89a980"],[48,50,81.49,81.73,"nå~d531d47a7712"],[52,55,82.69,82.93,"var"],[56,59,82.93,83.03,"det"],[60,65,83.03,83.27,"mange"],[66,71,83.27,83.97,"taler"],[72,77,83.97,84.19,"under~6ac1c1e92611"],[78,86,84.19,84.82,"middagen"]]},{"id":14,"start":85.84,"end":95.71,"text":"Ja, det var over ti taler. Onkelen til brudgommen snakket kjempelenge, og ei eldre dame sovnet faktisk.","speaker":"Sompit","zh":"是的，有十多次致辞。新郎的叔叔讲了特别久，有一位上了年纪的女士居然睡着了。","words":[[0,2,85.92,86.34,"ja"],[4,7,86.8,87.02,"det"],[8,11,87.02,87.14,"var"],[12,16,87.14,87.52,"over~25ba017bad18"],[17,19,87.76,88.16,"ti"],[20,25,88.16,88.48,"taler"],[27,34,89.4,90.18,"onkelen"],[35,38,90.18,90.3,"til~8de1a9181f86"],[39,49,90.3,90.8,"brudgommen"],[50,57,90.8,91.54,"snakket~b025dd4aaf04"],[58,69,91.54,92.58,"kjempelenge"],[71,73,93.16,93.4,"og"],[74,76,93.4,93.54,"ei~47aa2d18e376"],[77,82,93.54,93.98,"eldre"],[83,87,93.98,94.28,"dame"],[88,94,94.28,94.98,"sovnet"],[95,102,94.98,95.63,"faktisk"]]},{"id":15,"start":96.7,"end":100.36,"text":"Er det sant? Holdt Kjetil også tale?","speaker":"Svigermor","zh":"真的吗？谢蒂尔也致辞了吗？","words":[[0,2,96.78,96.92,"er"],[3,6,96.92,97.04,"det"],[7,11,97.04,97.56,"sant"],[13,18,98.77,99.07,"holdt~7227e8f8f171"],[19,25,99.07,99.55,"kjetil"],[26,30,99.55,99.75,"også"],[31,35,99.75,100.28,"tale"]]},{"id":16,"start":101.08,"end":105.34,"text":"Ja, talen hans var veldig morsom, og mange lo.","speaker":"Sompit","zh":"是的，他的讲话非常有趣，很多人都笑了。","words":[[0,2,101.16,101.4,"ja"],[4,9,102.08,102.52,"talen"],[10,14,102.52,102.72,"hans"],[15,18,102.72,102.94,"var"],[19,25,102.94,103.52,"veldig"],[26,32,103.52,103.9,"morsom"],[34,36,103.9,104.34,"og"],[37,42,104.34,104.82,"mange"],[43,45,104.82,105.27,"lo"]]},{"id":17,"start":106.36,"end":116.41,"text":"Ja, det kan jeg tenke meg. Morten er jo barndomsvennen hans, og de har gjort mye rart sammen. Fikk brudeparet mange fine gaver?","speaker":"Svigermor","zh":"是啊，我能想象。莫滕毕竟是他儿时的朋友，他们一起干过很多怪事。新婚夫妇收到了很多好礼物吗？","words":[[0,2,106.44,106.68,"ja"],[4,7,106.82,107.08,"det"],[8,11,107.08,107.24,"kan"],[12,15,107.24,107.42,"jeg"],[16,21,107.8,108.04,"tenke~ebc2e3b4692d"],[22,25,108.04,108.24,"meg"],[27,33,108.8,109.3,"morten"],[34,36,109.3,109.54,"er"],[37,39,109.54,109.76,"jo~098a15bbbc37"],[40,54,109.76,110.72,"barndomsvennen"],[55,59,110.72,111.06,"hans"],[61,63,111.44,111.62,"og"],[64,66,111.62,111.76,"de"],[67,70,111.76,111.86,"har~8b9792170cca"],[71,76,111.86,112.08,"gjort"],[77,80,112.08,112.56,"mye~cc164d0dc3da"],[81,85,112.56,112.74,"rart~43b4cd592dd9"],[86,92,112.74,113.12,"sammen"],[94,98,114.2,114.48,"fikk~e94d2a93d84d"],[99,109,114.48,115.0,"brudeparet"],[110,115,115.0,115.32,"mange"],[116,120,115.32,115.66,"fine"],[121,126,115.66,116.33,"gaver"]]},{"id":18,"start":117.28,"end":125.03,"text":"Ja, de fikk mye fint. Alle gjestene fikk se gavene deres, for gavene sto på et stort gavebord.","speaker":"Sompit","zh":"是的，他们收到了很多好东西。所有客人都能看到他们的礼物，因为礼物都摆在一张大礼品桌上。","words":[[0,2,117.36,117.74,"ja"],[4,6,118.12,118.28,"de"],[7,11,118.28,118.46,"fikk~e94d2a93d84d"],[12,15,118.46,118.96,"mye~cc164d0dc3da"],[16,20,118.96,119.28,"fint"],[22,26,119.94,120.56,"alle~6873d9584096"],[27,35,120.56,121.14,"gjestene"],[36,40,121.14,121.32,"fikk~f2a4ebd4cfb3"],[41,43,121.32,121.54,"se"],[44,50,121.54,122.02,"gavene"],[51,56,122.02,122.4,"deres"],[58,61,122.76,122.9,"for~1b22712a94b1"],[62,68,122.9,123.34,"gavene"],[69,72,123.34,123.54,"sto~85d02948d0e3"],[73,75,123.54,123.7,"på"],[76,78,123.7,123.86,"et~054dde72f37b"],[79,84,123.86,124.4,"stort"],[85,93,124.4,125.03,"gavebord"]]},{"id":19,"start":125.15,"end":128.61,"text":"De fikk fire like blomstervaser.","zh":"他们收到了四个一模一样的花瓶。","words":[[0,2,125.15,126.26,"de"],[3,7,126.26,126.46,"fikk~e94d2a93d84d"],[8,12,126.46,126.96,"fire"],[13,17,126.96,127.62,"like~20e4ad624b8e"],[18,31,127.62,128.53,"blomstervaser"]]},{"id":20,"start":129.4,"end":134.88,"text":"Fikk de fire like vaser? Hva kjøpte dere i gave?","speaker":"Svigermor","zh":"他们收到了四个一样的花瓶？你们买了什么作礼物？","words":[[0,4,129.47,129.84,"fikk~e94d2a93d84d"],[5,7,129.84,130.06,"de"],[8,12,130.06,130.68,"fire"],[13,17,130.68,131.42,"like~20e4ad624b8e"],[18,23,131.42,131.98,"vaser"],[25,28,132.94,133.56,"hva"],[29,35,133.56,133.9,"kjøpte"],[36,40,133.9,134.22,"dere"],[41,42,134.22,134.36,"i~0283fbeb81b2"],[43,47,134.36,134.8,"gave"]]},{"id":21,"start":135.62,"end":137.06,"text":"En blomstervase.","speaker":"Sompit","zh":"一个花瓶。","words":[[0,2,135.7,135.9,"en~a939a9e56dc5"],[3,15,135.9,136.98,"blomstervase"]]},{"id":22,"start":142.42,"end":143.53,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,142.5,143.45,"sammendrag"]]},{"id":23,"start":144.46,"end":148.59,"text":"Sompit og svigermor snakker sammen om bryllupet i Ålesund.","zh":"松皮特和婆婆在聊奥勒松的婚礼。","words":[[0,6,144.54,145.49,"sompit"],[7,9,145.49,145.65,"og"],[10,19,145.65,146.23,"svigermor"],[20,27,146.23,146.65,"snakker"],[28,34,146.65,147.03,"sammen"],[35,37,147.03,147.23,"om~52c0bdc828db"],[38,47,147.23,147.75,"bryllupet"],[48,49,147.75,147.85,"i"],[50,57,147.85,148.51,"ålesund"]]},{"id":24,"start":149.55,"end":155.07,"text":"Brudeparet var heldige med været hele helga, og de hadde en fin seremoni i kirken.","zh":"整个周末新婚夫妇都赶上了好天气，他们在教堂里举行了一场美好的仪式。","words":[[0,10,149.62,150.16,"brudeparet"],[11,14,150.16,150.42,"var"],[15,22,150.42,150.92,"heldige"],[23,26,150.92,151.04,"med~f39daeee34ae"],[27,32,151.04,151.46,"været"],[33,37,151.46,151.84,"hele"],[38,43,151.84,152.24,"helga"],[45,47,152.72,152.76,"og"],[48,50,152.76,152.88,"de"],[51,56,152.88,153.04,"hadde"],[57,59,153.04,153.28,"en~a939a9e56dc5"],[60,63,153.28,153.54,"fin"],[64,72,153.54,154.3,"seremoni"],[73,74,154.3,154.44,"i"],[75,81,154.44,154.99,"kirken"]]},{"id":25,"start":156.15,"end":163.4,"text":"Bryllupsmiddagen var på Fjellstua med fin utsikt over Ålesund, og det var mange taler under middagen.","zh":"婚宴在Fjellstua举行，可以看到奥勒松的美景，晚宴上有很多人致辞。","words":[[0,16,156.23,157.18,"bryllupsmiddagen"],[17,20,157.18,157.38,"var"],[21,23,157.38,157.58,"på"],[24,33,157.58,158.24,"fjellstua"],[34,37,158.24,158.8,"med"],[38,41,158.8,159.14,"fin"],[42,48,159.14,159.7,"utsikt"],[49,53,159.7,160.0,"over"],[54,61,160.0,160.56,"ålesund"],[63,65,161.1,161.36,"og"],[66,69,161.36,161.46,"det"],[70,73,161.46,161.58,"var"],[74,79,161.58,161.88,"mange"],[80,85,161.88,162.42,"taler"],[86,91,162.42,162.66,"under~6ac1c1e92611"],[92,100,162.66,163.32,"middagen"]]},{"id":26,"start":164.75,"end":168.81,"text":"Kjetil holdt en morsom tale til barndomsvennen Morten.","zh":"谢蒂尔为儿时的朋友莫滕做了一番有趣的致辞。","words":[[0,6,164.83,165.45,"kjetil"],[7,12,165.45,165.91,"holdt~7227e8f8f171"],[13,15,165.91,166.05,"en~a939a9e56dc5"],[16,22,166.05,166.47,"morsom"],[23,27,166.47,166.85,"tale"],[28,31,166.85,167.23,"til~90405c67e65b"],[32,46,167.23,168.17,"barndomsvennen"],[47,53,168.17,168.73,"morten"]]},{"id":27,"start":169.83,"end":175.65,"text":"Brudeparet fikk mange fine gaver, men de fikk fire like blomstervaser.","zh":"新婚夫妇收到了很多好礼物，但他们收到了四个一模一样的花瓶。","words":[[0,10,169.91,170.63,"brudeparet"],[11,15,170.63,170.87,"fikk"],[16,21,170.87,171.31,"mange"],[22,26,171.31,171.63,"fine"],[27,32,171.63,172.15,"gaver"],[34,37,172.97,173.15,"men"],[38,40,173.15,173.29,"de"]