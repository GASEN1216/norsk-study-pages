{"id":"4.1","title":"Hva er klokka?","audio":"audio/4.1.mp3","duration":56.33,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.33,"text":"4.1 Hva er klokka?","heading":true,"zh":"4.1 现在几点了？","words":[[0,3,0.15,1.14,"4.1"],[4,7,1.97,2.47,"hva"],[8,10,2.47,2.71,"er"],[11,17,2.71,3.25,"klokka"]]},{"id":1,"start":5.15,"end":9.22,"text":"Bjørnar står opp klokka kvart over seks.","zh":"比约纳尔六点一刻起床。","words":[[0,7,5.23,5.89,"bjørnar"],[8,12,5.89,6.29,"står~13cfed49d0de"],[13,16,6.29,6.61,"opp~4bb5dba4f351"],[17,23,6.61,7.41,"klokka"],[24,29,7.41,7.79,"kvart"],[30,34,7.79,8.57,"over~fc4babce59ce"],[35,39,8.57,9.14,"seks"]]},{"id":2,"start":9.69,"end":14.3,"text":"Han kler på seg klokka halv sju.","zh":"他六点半穿衣服。","words":[[0,3,10.67,11.25,"han"],[4,8,11.25,11.57,"kler"],[9,11,11.57,11.83,"på~21aaa4d0f582"],[12,15,11.83,12.09,"seg"],[16,22,12.87,13.23,"klokka"],[23,27,13.23,13.77,"halv~642706f0805b"],[28,31,13.77,14.22,"sju"]]},{"id":3,"start":16.32,"end":19.32,"text":"Klokka sju spiser han frokost.","zh":"七点他吃早餐。","words":[[0,6,16.4,16.79,"klokka"],[7,10,16.79,17.13,"sju"],[11,17,17.73,18.31,"spiser"],[18,21,18.31,18.51,"han"],[22,29,18.51,19.24,"frokost"]]},{"id":4,"start":19.4,"end":23.99,"text":"Han begynner på jobb klokka åtte.","zh":"他八点开始上班。","words":[[0,3,20.98,21.56,"han"],[4,12,21.56,22.06,"begynner"],[13,15,22.06,22.28,"på~362b62e4a2d8"],[16,20,22.28,22.64,"jobb"],[21,27,23.12,23.66,"klokka"],[28,32,23.66,23.91,"åtte"]]},{"id":5,"start":26.37,"end":29.11,"text":"Klokka tolv spiser han lunsj.","zh":"十二点他吃午饭。","words":[[0,6,26.45,26.83,"klokka"],[7,11,26.83,27.29,"tolv"],[12,18,27.29,28.31,"spiser"],[19,22,28.31,28.49,"han"],[23,28,28.49,29.03,"lunsj"]]},{"id":6,"start":31.47,"end":35.46,"text":"Bjørnar lager middag klokka halv fem.","zh":"比约纳尔四点半做晚饭。","words":[[0,7,31.55,32.17,"bjørnar"],[8,13,32.17,32.73,"lager~61c7d708dd47"],[14,20,32.73,33.19,"middag"],[21,27,33.79,34.37,"klokka"],[28,32,34.37,34.93,"halv~45167b7430b1"],[33,36,34.93,35.38,"fem"]]},{"id":7,"start":37.36,"end":42.4,"text":"Han ser på nyheter fra kvart på sju til halv åtte.","zh":"他从六点四十五分到七点半看新闻。","words":[[0,3,37.44,37.72,"han"],[4,7,37.72,38.1,"ser"],[8,10,38.1,38.34,"på~fab38a6838d6"],[11,18,38.34,38.84,"nyheter"],[19,22,39.32,39.84,"fra"],[23,28,39.84,40.16,"kvart"],[29,31,40.16,40.42,"på~8b9c9515a9ac"],[32,35,40.42,40.74,"sju"],[36,39,40.75,41.45,"til"],[40,44,41.45,41.91,"halv~e5cf85157fed"],[45,49,41.91,42.32,"åtte"]]},{"id":8,"start":44.39,"end":47.65,"text":"Klokka ni spiser han kveldsmat.","zh":"九点他吃夜宵。","words":[[0,6,44.47,44.84,"klokka"],[7,9,44.84,45.12,"ni"],[10,16,45.74,46.42,"spiser"],[17,20,46.42,46.6,"han"],[21,30,46.6,47.57,"kveldsmat"]]},{"id":9,"start":49.38,"end":52.31,"text":"Han legger seg klokka halv elleve.","zh":"他十点半上床睡觉。","words":[[0,3,49.46,49.64,"han"],[4,10,49.64,49.96,"legger~621543baabad"],[11,14,49.96,50.24,"seg"],[15,21,50.24,51.24,"klokka"],[22,26,51.24,51.72,"halv~c32acaf180bc"],[27,33,51.72,52.23,"elleve"]]}],"lexicon":{"4.1":{"lemma":"4.1","zh":"第 4.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"begynner":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"4-008","form":"现在时","clip":null},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"elleve":{"lemma":"elleve","zh":"数字 11","pos":"数词","ref":"basics:numbers:elleve","clip":"pronunciation/827005e1432c8163b1dc.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"fem":{"lemma":"fem","zh":"数字 5","pos":"数词","ref":"1-110","clip":"pronunciation/99abaadbd7e96105da30.mp3"},"fra":{"lemma":"fra","zh":"从；来自","pos":"介词","ref":"1-009","clip":"pronunciation/aca621d2b04049cd12f2.mp3"},"frokost":{"lemma":"frokost","zh":"早餐","pos":"名词","ref":"4-007","clip":"pronunciation/41f15362b6f992598e22.mp3"},"halv":{"lemma":"halv","zh":"一半；半（报时：halv åtte = 七点半）","pos":"形容词","ref":"4-006","clip":"pronunciation/f544d39eee61831623db.mp3","ambiguous":true,"candidates":[{"