{"id":"4.1","title":"Hva er klokka?","audio":"audio/4.1.mp3","duration":56.33,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.33,"text":"4.1 Hva er klokka?","heading":true,"zh":"4.1 现在几点了？","words":[[0,3,0.15,1.14,"4.1"],[4,7,1.97,2.47,"hva"],[8,10,2.47,2.71,"er"],[11,17,2.71,3.25,"klokka"]]},{"id":1,"start":5.18,"end":9.28,"text":"Bjørnar står opp klokka kvart over seks.","zh":"比约纳尔六点一刻起床。","words":[[0,7,5.24,6.08,"bjørnar"],[8,12,6.08,6.44,"står~13cfed49d0de"],[13,16,6.44,6.88,"opp~4bb5dba4f351"],[17,23,7.12,7.48,"klokka"],[24,29,7.48,8.07,"kvart"],[30,34,8.26,8.7,"over~fc4babce59ce"],[35,39,8.7,9.12,"seks"]]},{"id":2,"start":10.94,"end":14.4,"text":"Han kler på seg klokka halv sju.","zh":"他六点半穿衣服。","words":[[0,3,11.0,11.36,"han"],[4,8,11.36,11.7,"kler"],[9,11,11.7,11.92,"på~21aaa4d0f582"],[12,15,11.92,12.32,"seg"],[16,22,12.86,13.38,"klokka"],[23,27,13.38,13.94,"halv~642706f0805b"],[28,31,13.94,14.25,"sju"]]},{"id":3,"start":16.36,"end":19.39,"text":"Klokka sju spiser han frokost.","zh":"七点他吃早餐。","words":[[0,6,16.41,16.88,"klokka"],[7,10,16.88,17.23,"sju"],[11,17,17.9,18.38,"spiser"],[18,21,18.38,18.6,"han"],[22,29,18.6,19.24,"frokost"]]},{"id":4,"start":21.27,"end":24.38,"text":"Han begynner på jobb klokka åtte.","zh":"他八点开始上班。","words":[[0,3,21.32,21.68,"han"],[4,12,21.68,22.2,"begynner"],[13,15,22.2,22.36,"på~362b62e4a2d8"],[16,20,22.36,22.81,"jobb"],[21,27,23.24,23.8,"klokka"],[28,32,23.8,24.23,"åtte"]]},{"id":5,"start":26.41,"end":29.18,"text":"Klokka tolv spiser han lunsj.","zh":"十二点他吃午饭。","words":[[0,6,26.46,26.92,"klokka"],[7,11,26.92,27.43,"tolv"],[12,18,27.88,28.36,"spiser"],[19,22,28.36,28.58,"han"],[23,28,28.58,29.04,"lunsj"]]},{"id":6,"start":31.49,"end":35.54,"text":"Bjørnar lager middag klokka halv fem.","zh":"比约纳尔四点半做晚饭。","words":[[0,7,31.55,32.4,"bjørnar"],[8,13,32.4,32.84,"lager~61c7d708dd47"],[14,20,32.84,33.48,"middag"],[21,27,33.96,34.56,"klokka"],[28,32,34.56,35.04,"halv~45167b7430b1"],[33,36,35.04,35.39,"fem"]]},{"id":7,"start":37.39,"end":42.48,"text":"Han ser på nyheter fra kvart på sju til halv åtte.","zh":"他从六点四十五分到七点半看新闻。","words":[[0,3,37.45,37.9,"han"],[4,7,37.9,38.22,"ser"],[8,10,38.22,38.42,"på~fab38a6838d6"],[11,18,38.42,39.12,"nyheter"],[19,22,39.68,39.94,"fra"],[23,28,39.94,40.3,"kvart"],[29,31,40.3,40.48,"på~8b9c9515a9ac"],[32,35,40.48,40.84,"sju"],[36,39,41.32,41.62,"til"],[40,44,41.62,41.94,"halv~e5cf85157fed"],[45,49,41.94,42.33,"åtte"]]},{"id":8,"start":44.43,"end":47.72,"text":"Klokka ni spiser han kveldsmat.","zh":"九点他吃夜宵。","words":[[0,6,44.49,44.9,"klokka"],[7,9,44.9,45.21,"ni"],[10,16,45.94,46.46,"spiser"],[17,20,46.46,46.76,"han"],[21,30,46.76,47.57,"kveldsmat"]]},{"id":9,"start":49.41,"end":52.38,"text":"Han legger seg klokka halv elleve.","zh":"他十点半上床睡觉。","words":[[0,3,49.47,49.7,"han"],[4,10,49.7,50.02,"legger~621543baabad"],[11,14,50.02,50.44,"seg"],[15,21,50.92,51.34,"klokka"],[22,26,51.34,51.82,"halv~c32acaf180bc"],[27,33,51.82,52.23,"elleve"]]}],"lexicon":{"4.1":{"lemma":"4.1","zh":"第 4.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"begynner":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"4-008","form":"现在时","clip":null},"bjørnar":{"lemma":"Bjørnar","zh":"比约纳尔（人名）","pos":"专名","ref":null,"clip":null},"elleve":{"lemma":"elleve","zh":"数字 11","pos":"数词","ref":"basics:numbers:elleve","clip":"pronunciation/827005e1432c8163b1dc.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"fem":{"lemma":"fem","zh":"数字 5","pos":"数词","ref":"1-110","clip":"pronunciation/99abaadbd7e96105da30.mp3"},"fra":{"lemma":"fra","zh":"从；来自","pos":"介词","ref":"1-009","clip":"pronunciation/aca621d2b04049cd12f2.mp3"},"frokost":{"lemma":"frokost","zh":"早餐","pos":"名词","ref":"4-007","clip":"pronunciation/41f15362b6f992598e22.mp3"},"halv":{"lemma":"halv","zh":"一半；半（报时：halv åtte = 七点半）","pos":"形容词","ref":"4-006","clip":"pronunciation/f544d39eee61831623db.mp3","ambiguous":true,"candidates":[{"lemma":"halv",