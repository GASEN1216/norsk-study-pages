{"id":"12.5","title":"Yrkestekst: Jeg er pleieassistent","audio":"audio/12.5.mp3","duration":134.94,"synthetic":false,"sentences":[{"id":0,"start":0.44,"end":6.01,"text":"12.5 Yrke: Jeg er pleieassistent","heading":true,"zh":"12.5 职业：我是护理助理","words":[[0,4,0.44,1.48,"12.5"],[5,9,1.48,4.0,"yrke"],[11,14,4.0,4.2,"jeg"],[15,17,4.2,4.6,"er"],[18,32,4.6,5.93,"pleieassistent"]]},{"id":1,"start":7.8,"end":11.45,"text":"Jeg er pleieassistent og jobber på et sykehjem.","zh":"我是护理助理，在一家养老护理院工作。","words":[[0,3,7.88,8.11,"jeg"],[4,6,8.11,8.29,"er"],[7,21,8.29,9.35,"pleieassistent"],[22,24,9.35,9.89,"og"],[25,31,9.89,10.21,"jobber~ab83dbee3ee4"],[32,34,10.21,10.39,"på"],[35,37,10.39,10.59,"et~054dde72f37b"],[38,46,10.59,11.37,"sykehjem"]]},{"id":2,"start":11.92,"end":19.76,"text":"Jeg hjelper eldre mennesker med vask, stell og toalettbesøk, og jeg kler på dem og serverer mat til dem.","zh":"我帮助老人洗漱、护理和上厕所，还帮他们穿衣服、给他们送饭。","words":[[0,3,12.0,12.25,"jeg"],[4,11,12.25,12.71,"hjelper"],[12,17,12.71,13.11,"eldre"],[18,27,13.11,13.67,"mennesker"],[28,31,13.67,13.97,"med~8a758c8b8228"],[32,36,13.97,14.39,"vask~8a6853379b72"],[38,43,14.79,15.29,"stell"],[44,46,15.29,15.57,"og"],[47,59,15.71,16.51,"toalettbesøk"],[61,63,16.83,17.07,"og"],[64,67,17.07,17.19,"jeg"],[68,72,17.19,17.37,"kler~c2cd4943ac9b"],[73,75,17.37,17.63,"på~1acf41695d3e"],[76,79,17.63,17.93,"dem"],[80,82,17.93,18.45,"og"],[83,91,18.45,18.93,"serverer"],[92,95,18.93,19.19,"mat"],[96,99,19.26,19.48,"til"],[100,103,19.48,19.68,"dem"]]},{"id":3,"start":21.19,"end":26.69,"text":"Noen ganger går vi ut på tur, for beboerne trenger også frisk luft og mosjon.","zh":"有时我们会出去散步，因为住户们也需要新鲜空气和运动。","words":[[0,4,21.27,21.6,"noen~c766e2ef794d"],[5,11,21.6,21.98,"ganger~eebcae87faa3"],[12,15,21.98,22.32,"går"],[16,18,22.32,22.46,"vi"],[19,21,22.46,22.68,"ut"],[22,24,22.68,22.84,"på~0addaaf68589"],[25,28,22.84,23.14,"tur"],[30,33,23.84,24.0,"for~1b22712a94b1"],[34,42,24.0,24.56,"beboerne"],[43,50,24.56,25.16,"trenger"],[51,55,25.16,25.46,"også"],[56,61,25.46,25.88,"frisk"],[62,66,25.88,26.2,"luft"],[67,69,26.2,26.46,"og"],[70,76,26.46,26.69,"mosjon"]]},{"id":4,"start":26.98,"end":31.48,"text":"Jeg snakker mye med beboerne på sykehjemmet.","zh":"我经常和护理院的住户们聊天。","words":[[0,3,26.98,27.67,"jeg"],[4,11,28.93,29.47,"snakker"],[12,15,29.47,29.79,"mye~933c5a923198"],[16,19,29.79,29.95,"med"],[20,28,29.95,30.49,"beboerne"],[29,31,30.49,30.69,"på"],[32,43,30.69,31.4,"sykehjemmet"]]},{"id":5,"start":32.04,"end":37.68,"text":"Det er viktig å være god i muntlig norsk, for beboerne trenger noen å snakke med.","zh":"挪威语口语好很重要，因为住户们需要有人陪他们说话。","words":[[0,3,32.12,32.22,"det"],[4,6,32.22,32.3,"er"],[7,13,32.3,32.68,"viktig"],[14,15,32.68,33.1,"å~0583da7a620a"],[16,20,33.1,33.24,"være"],[21,24,33.24,33.6,"god~5df19a95aa60"],[25,26,33.6,33.96,"i~700bb620285c"],[27,34,33.96,34.36,"muntlig"],[35,40,34.36,34.84,"norsk~4de5d75feae1"],[42,45,35.18,35.38,"for~1b22712a94b1"],[46,54,35.38,36.02,"beboerne"],[55,62,36.02,36.5,"trenger"],[63,67,36.5,36.84,"noen~8e23a4fd3f2f"],[68,69,36.84,37.02,"å~0583da7a620a"],[70,76,37.02,37.34,"snakke"],[77,80,37.34,37.6,"med"]]},{"id":6,"start":38.48,"end":44.51,"text":"Det er også viktig å kunne ta imot beskjeder og samarbeide med kollegaene mine på sykehjemmet.","zh":"能接收口信、和护理院的同事们合作也很重要。","words":[[0,3,38.56,38.66,"det"],[4,6,38.66,38.72,"er"],[7,11,38.72,39.02,"også"],[12,18,39.02,39.44,"viktig"],[19,20,39.44,39.82,"å~0583da7a620a"],[21,26,39.82,40.0,"kunne"],[27,29,40.0,40.24,"ta~ac9cd4b7e7af"],[30,34,40.24,40.5,"imot"],[35,44,40.5,41.02,"beskjeder"],[45,47,41.02,41.78,"og"],[48,58,41.78,42.48,"samarbeide"],[59,62,42.48,42.68,"med"],[63,73,42.68,43.16,"kollegaene"],[74,78,43.16,43.46,"mine"],[79,81,43.46,43.66,"på"],[82,93,43.66,44.43,"sykehjemmet"]]},{"id":7,"start":48.07,"end":49.4,"text":"På sykehjemmet","zh":"在养老护理院","words":[[0,2,48.15,48.32,"på"],[3,14,48.32,49.32,"sykehjemmet"]]},{"id":8,"start":49.82,"end":53.94,"text":"God morgen, fru Olsen! Skal vi ta morgenstellet?","speaker":"Pleieassistent","zh":"早上好，奥尔森太太！我们开始早间护理吧？","words":[[0,3,49.92,50.6,"god"],[4,10,50.6,50.92,"morgen"],[12,15,51.1,51.22,"fru"],[16,21,51.22,51.6,"olsen"],[23,27,52.35,52.55,"skal"],[28,30,52.55,52.67,"vi"],[31,33,52.67,52.87,"ta~cd50c8c57e7d"],[34,47,52.87,53.86,"morgenstellet"]]},{"id":9,"start":54.68,"end":60.61,"text":"God morgen! Jeg vil gjerne ha på meg denne kjolen i dag.","speaker":"Fru Olsen","zh":"早上好！我今天想穿这条连衣裙。","words":[[0,3,54.76,54.98,"god"],[4,10,54.98,55.34,"morgen"],[12,15,56.26,56.72,"jeg"],[16,19,56.72,57.0,"vil"],[20,26,57.0,57.42,"gjerne"],[27,29,57.42,57.68,"ha~c8c0687d8865"],[30,32,57.68,57.92,"på~c626281c000c"],[33,36,57.92,58.22,"meg"],[37,42,58.22,59.0,"denne"],[43,49,59.0,59.52,"kjolen"],[50,51,59.52,60.08,"i"],[52,55,60.08,60.53,"dag"]]},{"id":10,"start":61.34,"end":67.6,"text":"Jeg tror ikke det. Det er kaldt i dag, og vi skal gå ut på tur. Du må ha på deg bukser.","speaker":"Pleieassistent","zh":"我觉得不太合适。今天很冷，我们还要出去散步。你得穿裤子。","words":[[0,3,61.42,61.55,"jeg"],[4,8,61.55,61.89,"tror"],[9,13,61.89,62.13,"ikke"],[14,17,62.13,62.29,"det"],[19,22,62.68,63.02,"det"],[23,25,63.02,63.14,"er"],[26,31,63.14,63.54,"kaldt"],[32,33,63.54,63.66,"i"],[34,37,63.66,63.82,"dag"],[39,41,64.2,64.38,"og"],[42,44,64.38,64.52,"vi"],[45,49,64.52,64.7,"skal"],[50,52,64.7,64.86,"gå"],[53,55,64.86,65.02,"ut"],[56,58,65.02,65.18,"på~0addaaf68589"],[59,62,65.18,65.56,"tur"],[64,66,65.94,66.3,"du"],[67,69,66.3,66.4,"må"],[70,72,66.4,66.54,"ha~c8c0687d8865"],[73,75,66.54,66.74,"på~c626281c000c"],[76,79,66.74,66.86,"deg"],[80,86,66.86,67.52,"bukser"]]},{"id":11,"start":68.17,"end":72.43,"text":"Ja vel. Hva er det til frokost i dag?","speaker":"Fru Olsen","zh":"好吧。今天早餐吃什么？","words":[[0,2,68.25,68.68,"ja"],[3,6,68.68,68.98,"vel~918a702b87c1"],[8,11,69.98,70.3,"hva"],[12,14,70.3,70.56,"er"],[15,18,70.56,70.66,"det"],[19,22,70.66,70.88,"til~ede609ee4130"],[23,30,70.88,71.6,"frokost"],[31,32,71.6,71.94,"i"],[33,36,71.94,72.35,"dag"]]},{"id":12,"start":72.49,"end":80.64,"text":"Du skal få en deilig havregrøt med frukt og bær. Senere i dag kommer dattera di og barnebarnet ditt på besøk.","speaker":"Pleieassistent","zh":"你会吃到美味的燕麦粥，配水果和浆果。今天晚些时候你女儿和外孙（女）会来看你。","words":[[0,2,72.88,73.32,"du"],[3,7,73.32,73.48,"skal"],[8,10,73.48,73.62,"få~65b84e08cd43"],[11,13,73.62,73.78,"en~a939a9e56dc5"],[14,20,73.78,74.34,"deilig"],[21,30,74.34,75.04,"havregrøt"],[31,34,75.04,75.22,"med"],[35,40,75.22,75.62,"frukt"],[41,43,75.62,75.82,"og"],[44,47,75.82,76.1,"bær"],[49,55,76.8,77.46,"senere"],[56,57,77.46,77.58,"i"],[58,61,77.58,77.82,"dag"],[62,68,77.82,78.08,"kommer"],[69,76,78.08,78.62,"dattera"],[77,79,78.62,78.8,"di"],[80,82,78.8,79.04,"og"],[83,94,79.04,79.68,"barnebarnet"],[95,99,79.68,79.82,"ditt"],[100,102,79.82,79.96,"på~e0ff03b4cdf8"],[103,108,79.96,80.56,"besøk"]]},{"id":13,"start":81.32,"end":90.32,"text":"Å, så hyggelig! Da vil jeg pynte meg. Kan du hjelpe meg med å sminke meg litt?","speaker":"Fru Olsen","zh":"哦，太好了！那我要打扮一下。你能帮我化点妆吗？","words":[[0,1,81.4,81.76,"å~496a48c13525"],[3,5,82.7,82.94,"så~1c5b6a43311c"],[6,14,82.94,83.6,"hyggelig"],[16,18,84.18,84.8,"da~4f486b190f4c"],[19,22,84.8,85.08,"vil"],[23,26,85.08,85.26,"jeg"],[27,32,85.26,86.02,"pynte~c335e45ad449"],[33,36,86.02,86.26,"meg"],[38,41,87.14,87.48,"kan"],[42,44,87.48,87.62,"du"],[45,51,87.62,88.04,"hjelpe"],[52,55,88.04,88.24,"meg"],[56,59,88.24,88.44,"med~8a758c8b8228"],[60,61,88.44,88.94,"å~0583da7a620a"],[62,68,88.94,89.62,"sminke~74270a8dfc2d"],[69,72,89.62,89.8,"meg"],[73,77,89.8,90.24,"litt~54360be2a478"]]},{"id":14,"start":93.69,"end":95.01,"text":"Helseyrker","zh":"医疗卫生职业","words":[[0,10,93.77,94.93,"helseyrker"]]},{"id":15,"start":96.33,"end":101.2,"text":"En fastlege jobber på et legekontor og hjelper syke mennesker.","zh":"家庭医生在诊所工作，帮助生病的人。","words":[[0,2,96.41,96.65,"en~a939a9e56dc5"],[3,11,96.65,97.33,"fastlege"],[12,18,97.33,97.73,"jobber~ab83dbee3ee4"],[19,21,97.73,97.99,"på"],[22,24,97.99,98.15,"et~054dde72f37b"],[25,35,98.15,98.95,"legekontor"],[36,38,98.95,99.53,"og"],[39,46,99.53,99.93,"hjelper"],[47,51,99.93,100.47,"syke~a3277fd424bc"],[52,61,100.47,101.12,"mennesker"]]},{"id":16,"start":102.79,"end":108.13,"text":"En ambulansearbeider kjører pasienter til sykehus i en ambulanse.","zh":"救护人员用救护车把病人送到医院。","words":[[0,2,102.87,103.13,"en~a939a9e56dc5"],[3,20,103.13,104.43,"ambulansearbeider"],[21,27,104.43,105.31,"kjører"],[28,37,105.31,106.03,"pasienter"],[38,41,106.03,106.19,"til"],[42,49,106.19,106.87,"sykehus"],[50,51,106.87,107.15,"i"],[52,54,107.15,107.27,"en~a939a9e56dc5"],[55,64,107.27,108.05,"ambulanse"]]},{"id":17,"start":109.81,"end":115.02,"text":"En sykepleier gir medisiner og passer på helsa til syke mennesker.","zh":"护士给病人发药，并照看病人的健康。","words":[[0,2,109.89,110.04,"en~a939a9e56dc5"],[3,13,110.04,110.8,"sykepleier"],[14,17,111.24,111.6,"gir"],[18,27,111.6,112.36,"medisiner"],[28,30,112.36,112.7,"og"],[31,37,112.7,113.02,"passer~443c855b0389"],[38,40,113.02,113.24,"på~2d0a57ce4630"],[41,46,113.24,113.66,"helsa"],[47,50,113.66,113.88,"til~8de1a9181f86"],[51,55,113.88,114.34,"syke~a3277fd424bc"],[56,65,114.34,114.94,"mennesker"]]},{"id":18,"start":116.86,"end":122.31,"text":"Ei helsesøster passer på barn og unges helse og gir vaksiner.","zh":"公共卫生护士负责儿童和青少年的健康，并给他们接种疫苗。","words":[[0,2,116.94,117.22,"ei~47aa2d18e376"],[3,14,117.22,118.16,"helsesøster"],[15,21,118.16,118.86,"passer~a0af3495c769"],[22,24,118.86,119.16,"på~2d0a57ce4630"],[25,29,119.16,119.44,"barn"],[30,32,119.44,119.64,"og"],[33,38,119.64,120.04,"unges"],[39,44,120.04,120.56,"helse"],[45,47,121.14,121.18,"og"],[48,51,121.18,121.38,"gir"],[52,60,121.38,122.23,"vaksiner"]]},{"id":19,"start":124.08,"end":129.29,"text":"En fysioterapeut hjelper pasienter med stive og vonde muskler.","zh":"物理治疗师帮助肌肉僵硬疼痛的病人。","words":[[0,2,124.16,124.41,"en~a939a9e56dc5"],[3,16,124.41,125.25,"fysioterapeut"],[17,24,125.25,126.49,"hjelper"],[25,34,126.49,127.21,"pasienter"],[35,38,127.21,127.37,"med~2ca3e92f17fb"],[39,44,127.37,127.89,"stive"],[45,47,127.89,128