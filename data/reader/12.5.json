{"id":"12.5","title":"Yrkestekst: Jeg er pleieassistent","audio":"audio/12.5.mp3","duration":134.94,"synthetic":false,"sentences":[{"id":0,"start":0.44,"end":6.01,"text":"12.5 Yrke: Jeg er pleieassistent","heading":true,"zh":"12.5 职业：我是护理助理","words":[[0,4,0.44,1.48,"12.5"],[5,9,1.48,4.0,"yrke"],[11,14,4.0,4.2,"jeg"],[15,17,4.2,4.6,"er"],[18,32,4.6,5.93,"pleieassistent"]]},{"id":1,"start":7.85,"end":11.5,"text":"Jeg er pleieassistent og jobber på et sykehjem.","zh":"我是护理助理，在一家养老护理院工作。","words":[[0,3,7.91,8.24,"jeg"],[4,6,8.24,8.44,"er"],[7,21,8.44,9.84,"pleieassistent"],[22,24,9.84,9.98,"og"],[25,31,9.98,10.32,"jobber~ab83dbee3ee4"],[32,34,10.32,10.5,"på"],[35,37,10.5,10.66,"et~054dde72f37b"],[38,46,10.66,11.35,"sykehjem"]]},{"id":2,"start":12.03,"end":19.81,"text":"Jeg hjelper eldre mennesker med vask, stell og toalettbesøk, og jeg kler på dem og serverer mat til dem.","zh":"我帮助老人洗漱、护理和上厕所，还帮他们穿衣服、给他们送饭。","words":[[0,3,12.09,12.32,"jeg"],[4,11,12.32,12.86,"hjelper"],[12,17,12.86,13.16,"eldre"],[18,27,13.16,13.88,"mennesker"],[28,31,13.88,14.04,"med~8a758c8b8228"],[32,36,14.04,14.7,"vask~8a6853379b72"],[38,43,14.86,15.5,"stell"],[44,46,15.5,15.6,"og"],[47,59,15.6,16.7,"toalettbesøk"],[61,63,17.0,17.06,"og"],[64,67,17.06,17.26,"jeg"],[68,72,17.26,17.48,"kler~c2cd4943ac9b"],[73,75,17.48,17.74,"på~1acf41695d3e"],[76,79,17.74,18.11,"dem"],[80,82,18.4,18.52,"og"],[83,91,18.52,19.0,"serverer"],[92,95,19.0,19.34,"mat"],[96,99,19.34,19.5,"til"],[100,103,19.5,19.66,"dem"]]},{"id":3,"start":21.22,"end":27.09,"text":"Noen ganger går vi ut på tur, for beboerne trenger også frisk luft og mosjon.","zh":"有时我们会出去散步，因为住户们也需要新鲜空气和运动。","words":[[0,4,21.28,21.66,"noen~c766e2ef794d"],[5,11,21.66,22.22,"ganger~eebcae87faa3"],[12,15,22.22,22.38,"går"],[16,18,22.38,22.56,"vi"],[19,21,22.56,22.76,"ut"],[22,24,22.76,22.92,"på~0addaaf68589"],[25,28,22.92,23.41,"tur"],[30,33,23.86,24.04,"for~1b22712a94b1"],[34,42,24.04,24.92,"beboerne"],[43,50,24.92,25.26,"trenger"],[51,55,25.26,25.62,"også"],[56,61,25.62,25.98,"frisk"],[62,66,25.98,26.38,"luft"],[67,69,26.38,26.48,"og"],[70,76,26.48,26.94,"mosjon"]]},{"id":4,"start":28.77,"end":31.53,"text":"Jeg snakker mye med beboerne på sykehjemmet.","zh":"我经常和护理院的住户们聊天。","words":[[0,3,28.82,29.04,"jeg"],[4,11,29.04,29.6,"snakker"],[12,15,29.6,29.88,"mye~933c5a923198"],[16,19,29.88,30.04,"med"],[20,28,30.04,30.6,"beboerne"],[29,31,30.6,30.74,"på"],[32,43,30.74,31.38,"sykehjemmet"]]},{"id":5,"start":32.05,"end":37.73,"text":"Det er viktig å være god i muntlig norsk, for beboerne trenger noen å snakke med.","zh":"挪威语口语好很重要，因为住户们需要有人陪他们说话。","words":[[0,3,32.12,32.26,"det"],[4,6,32.26,32.4,"er"],[7,13,32.4,33.02,"viktig"],[14,15,33.02,33.12,"å~0583da7a620a"],[16,20,33.12,33.4,"være"],[21,24,33.4,33.88,"god~5df19a95aa60"],[25,26,33.88,34.02,"i~700bb620285c"],[27,34,34.02,34.44,"muntlig"],[35,40,34.44,35.03,"norsk~4de5d75feae1"],[42,45,35.3,35.46,"for~1b22712a94b1"],[46,54,35.46,36.2,"beboerne"],[55,62,36.2,36.56,"trenger"],[63,67,36.56,36.96,"noen~8e23a4fd3f2f"],[68,69,36.96,37.06,"å~0583da7a620a"],[70,76,37.06,37.42,"snakke"],[77,80,37.42,37.59,"med"]]},{"id":6,"start":38.49,"end":44.55,"text":"Det er også viktig å kunne ta imot beskjeder og samarbeide med kollegaene mine på sykehjemmet.","zh":"能接收口信、和护理院的同事们合作也很重要。","words":[[0,3,38.55,38.66,"det"],[4,6,38.66,38.82,"er"],[7,11,38.82,39.16,"også"],[12,18,39.16,39.76,"viktig"],[19,20,39.76,39.86,"å~0583da7a620a"],[21,26,39.86,40.14,"kunne"],[27,29,40.14,40.3,"ta~ac9cd4b7e7af"],[30,34,40.3,40.62,"imot"],[35,44,40.62,41.35,"beskjeder"],[45,47,41.74,41.9,"og"],[48,58,41.9,42.6,"samarbeide"],[59,62,42.6,42.74,"med"],[63,73,42.74,43.34,"kollegaene"],[74,78,43.34,43.6,"mine"],[79,81,43.6,43.74,"på"],[82,93,43.74,44.41,"sykehjemmet"]]},{"id":7,"start":48.11,"end":49.45,"text":"På sykehjemmet","zh":"在养老护理院","words":[[0,2,48.17,48.56,"på"],[3,14,48.56,49.3,"sykehjemmet"]]},{"id":8,"start":50.4,"end":54.0,"text":"God morgen, fru Olsen! Skal vi ta morgenstellet?","speaker":"Pleieassistent","zh":"早上好，奥尔森太太！我们开始早间护理吧？","words":[[0,3,50.46,50.64,"god"],[4,10,50.64,51.08,"morgen"],[12,15,51.08,51.26,"fru"],[16,21,51.26,51.85,"olsen"],[23,27,52.38,52.6,"skal"],[28,30,52.6,52.74,"vi"],[31,33,52.74,52.98,"ta~cd50c8c57e7d"],[34,47,52.98,53.85,"morgenstellet"]]},{"id":9,"start":54.73,"end":60.66,"text":"God morgen! Jeg vil gjerne ha på meg denne kjolen i dag.","speaker":"Fru Olsen","zh":"早上好！我今天想穿这条连衣裙。","words":[[0,3,54.8,55.02,"god"],[4,10,55.02,55.71,"morgen"],[12,15,56.5,56.82,"jeg"],[16,19,56.82,57.08,"vil"],[20,26,57.08,57.5,"gjerne"],[27,29,57.5,57.82,"ha~c8c0687d8865"],[30,32,57.82,58.0,"på~c626281c000c"],[33,36,58.0,58.4,"meg"],[37,42,58.58,59.08,"denne"],[43,49,59.08,59.73,"kjolen"],[50,51,59.98,60.1,"i"],[52,55,60.1,60.52,"dag"]]},{"id":10,"start":61.39,"end":67.66,"text":"Jeg tror ikke det. Det er kaldt i dag, og vi skal gå ut på tur. Du må ha på deg bukser.","speaker":"Pleieassistent","zh":"我觉得不太合适。今天很冷，我们还要出去散步。你得穿裤子。","words":[[0,3,61.45,61.66,"jeg"],[4,8,61.66,62.02,"tror"],[9,13,62.02,62.22,"ikke"],[14,17,62.22,62.55,"det"],[19,22,62.92,63.06,"det"],[23,25,63.06,63.22,"er"],[26,31,63.22,63.6,"kaldt"],[32,33,63.6,63.66,"i"],[34,37,63.66,64.08,"dag"],[39,41,64.3,64.4,"og"],[42,44,64.4,64.56,"vi"],[45,49,64.56,64.74,"skal"],[50,52,64.74,64.92,"gå"],[53,55,64.92,65.1,"ut"],[56,58,65.1,65.24,"på~0addaaf68589"],[59,62,65.24,65.7,"tur"],[64,66,66.16,66.32,"du"],[67,69,66.32,66.46,"må"],[70,72,66.46,66.6,"ha~c8c0687d8865"],[73,75,66.6,66.76,"på~c626281c000c"],[76,79,66.76,66.94,"deg"],[80,86,66.94,67.51,"bukser"]]},{"id":11,"start":68.21,"end":72.49,"text":"Ja vel. Hva er det til frokost i dag?","speaker":"Fru Olsen","zh":"好吧。今天早餐吃什么？","words":[[0,2,68.27,68.8,"ja"],[3,6,68.8,69.18,"vel~918a702b87c1"],[8,11,70.12,70.42,"hva"],[12,14,70.42,70.58,"er"],[15,18,70.58,70.74,"det"],[19,22,70.74,71.02,"til~ede609ee4130"],[23,30,71.02,71.86,"frokost"],[31,32,71.86,71.96,"i"],[33,36,71.96,72.34,"dag"]]},{"id":12,"start":73.16,"end":80.7,"text":"Du skal få en deilig havregrøt med frukt og bær. Senere i dag kommer dattera di og barnebarnet ditt på besøk.","speaker":"Pleieassistent","zh":"你会吃到美味的燕麦粥，配水果和浆果。今天晚些时候你女儿和外孙（女）会来看你。","words":[[0,2,73.22,73.34,"du"],[3,7,73.34,73.54,"skal"],[8,10,73.54,73.7,"få~65b84e08cd43"],[11,13,73.7,73.92,"en~a939a9e56dc5"],[14,20,73.92,74.4,"deilig"],[21,30,74.4,75.14,"havregrøt"],[31,34,75.14,75.32,"med"],[35,40,75.32,75.74,"frukt"],[41,43,75.74,75.86,"og"],[44,47,75.86,76.36,"bær"],[49,55,77.08,77.54,"senere"],[56,57,77.54,77.62,"i"],[58,61,77.62,77.92,"dag"],[62,68,77.92,78.18,"kommer"],[69,76,78.18,78.64,"dattera"],[77,79,78.64,78.96,"di"],[80,82,78.96,79.1,"og"],[83,94,79.1,79.72,"barnebarnet"],[95,99,79.72,79.9,"ditt"],[100,102,79.9,80.0,"på~e0ff03b4cdf8"],[103,108,80.0,80.55,"besøk"]]},{"id":13,"start":81.36,"end":90.38,"text":"Å, så hyggelig! Da vil jeg pynte meg. Kan du hjelpe meg med å sminke meg litt?","speaker":"Fru Olsen","zh":"哦，太好了！那我要打扮一下。你能帮我化点妆吗？","words":[[0,1,81.42,81.76,"å~496a48c13525"],[3,5,82.78,83.02,"så~1c5b6a43311c"],[6,14,83.02,83.78,"hyggelig"],[16,18,84.5,84.9,"da~4f486b190f4c"],[19,22,84.9,85.12,"vil"],[23,26,85.12,85.5,"jeg"],[27,32,85.5,86.1,"pynte~c335e45ad449"],[33,36,86.1,86.48,"meg"],[38,41,87.34,87.54,"kan"],[42,44,87.54,87.7,"du"],[45,51,87.7,88.1,"hjelpe"],[52,55,88.1,88.34,"meg"],[56,59,88.34,88.52,"med~8a758c8b8228"],[60,61,88.52,88.8,"å~0583da7a620a"],[62,68,89.08,89.68,"sminke~74270a8dfc2d"],[69,72,89.68,89.84,"meg"],[73,77,89.84,90.23,"litt~54360be2a478"]]},{"id":14,"start":93.73,"end":95.08,"text":"Helseyrker","zh":"医疗卫生职业","words":[[0,10,93.79,94.93,"helseyrker"]]},{"id":15,"start":96.37,"end":101.26,"text":"En fastlege jobber på et legekontor og hjelper syke mennesker.","zh":"家庭医生在诊所工作，帮助生病的人。","words":[[0,2,96.43,96.76,"en~a939a9e56dc5"],[3,11,96.76,97.5,"fastlege"],[12,18,97.5,97.88,"jobber~ab83dbee3ee4"],[19,21,97.88,98.04,"på"],[22,24,98.04,98.2,"et~054dde72f37b"],[25,35,98.2,99.14,"legekontor"],[36,38,99.44,99.58,"og"],[39,46,99.58,100.12,"hjelper"],[47,51,100.12,100.52,"syke~a3277fd424bc"],[52,61,100.52,101.11,"mennesker"]]},{"id":16,"start":102.83,"end":108.19,"text":"En ambulansearbeider kjører pasienter til sykehus i en ambulanse.","zh":"救护人员用救护车把病人送到医院。","words":[[0,2,102.89,103.26,"en~a939a9e56dc5"],[3,20,103.26,104.7,"ambulansearbeider"],[21,27,104.96,105.48,"kjører"],[28,37,105.48,106.08,"pasienter"],[38,41,106.08,106.32,"til"],[42,49,106.32,107.06,"sykehus"],[50,51,107.06,107.2,"i"],[52,54,107.2,107.38,"en~a939a9e56dc5"],[55,64,107.38,108.04,"ambulanse"]]},{"id":17,"start":109.84,"end":115.09,"text":"En sykepleier gir medisiner og passer på helsa til syke mennesker.","zh":"护士给病人发药，并照看病人的健康。","words":[[0,2,109.91,110.18,"en~a939a9e56dc5"],[3,13,110.18,111.06,"sykepleier"],[14,17,111.4,111.7,"gir"],[18,27,111.7,112.62,"medisiner"],[28,30,112.62,112.8,"og"],[31,37,112.8,113.16,"passer~443c855b0389"],[38,40,113.16,113.32,"på~2d0a57ce4630"],[41,46,113.32,113.78,"helsa"],[47,50,113.78,114.06,"til~8de1a9181f86"],[51,55,114.06,114.42,"syke~a3277fd424bc"],[56,65,114.42,114.94,"mennesker"]]},{"id":18,"start":116.9,"end":122.36,"text":"Ei helsesøster passer på barn og unges helse og gir vaksiner.","zh":"公共卫生护士负责儿童和青少年的健康，并给他们接种疫苗。","words":[[0,2,116.96,117.34,"ei~47aa2d18e376"],[3,14,117.34,118.36,"helsesøster"],[15,21,118.6,119.06,"passer~a0af3495c769"],[22,24,119.06,119.22,"på~2d0a57ce4630"],[25,29,119.22,119.58,"barn"],[30,32,119.58,119.72,"og"],[33,38,119.72,120.1,"unges"],[39,44,120.1,120.74,"helse"],[45,47,121.1,121.22,"og"],[48,51,121.22,121.48,"gir"],[52,60,121.48,122.21,"vaksiner"]]},{"id":19,"start":124.11,"end":129.34,"text":"En fysioterapeut hjelper pasienter med stive og vonde muskler.","zh":"物理治疗师帮助肌肉僵硬疼痛的病人。","words":[[0,2,124.17,124.52,"en~a939a9e56dc5"],[3,16,124.52,125.84,"fysioterapeut"],[17,24,126.08,126.58,"hjelper"],[25,34,126.58,127.26,"pasienter"],[35,38,127.26,127.46,"med~2ca3e92f17fb"],[39,44,127.46,128.08,"stive"],[45,47,128.08,128.22,"og"],[48,53,128.22,128.6,"vonde~1