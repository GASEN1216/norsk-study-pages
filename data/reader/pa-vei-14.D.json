{"id":"pa-vei-14.D","bookId":"pa-vei-textbook","readingId":"14.D","title":"Et langt liv","audio":"audio/pa-vei/14.D.mp3","duration":260.496,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.84,"end":1.865,"text":"Marie forteller:","zh":"玛丽讲述：","words":[[0,5,0.84,1.345,"marie"],[6,15,1.36,1.865,"forteller"]]},{"id":1,"start":4.34,"end":11.925,"text":"I går ble jeg 90 år. 90 år! Jeg kan nesten ikke tro det.","zh":"昨天我满 90 岁了。90 岁！我几乎不敢相信。","words":[[0,1,4.34,4.445,"i"],[2,5,4.52,4.885,"går"],[6,9,5.02,5.225,"ble"],[10,13,5.34,5.585,"jeg"],[14,16,5.78,6.345,"90"],[17,19,6.44,6.685,"år"],[21,23,8.04,8.565,"90"],[24,26,8.66,9.025,"år"],[28,31,10.18,10.352,"jeg"],[32,35,10.352,10.525,"kan"],[36,42,10.56,11.143,"nesten"],[43,47,11.143,11.385,"ikke"],[48,51,11.4,11.645,"tro@pa-vei-tro-believe"],[52,55,11.74,11.925,"det"]],"speaker":"Marie"},{"id":2,"start":13.18,"end":14.845,"text":"Tida har gått så fort.","zh":"时间过得真快。","words":[[0,4,13.18,13.505,"tida"],[5,8,13.52,13.672,"har"],[9,13,13.672,13.942,"gått@pa-vei-extra-35"],[14,16,13.942,14.105,"så"],[17,21,14.32,14.845,"fort"]],"speaker":"Marie"},{"id":3,"start":16.44,"end":20.365,"text":"Jeg giftet meg ung, bare 19 år gammel.","zh":"我结婚很早，那时才 19 岁。","words":[[0,3,16.44,16.625,"jeg"],[4,10,16.68,17.223,"giftet"],[11,14,17.223,17.425,"meg"],[15,18,17.58,17.865,"ung"],[20,24,18.76,19.145,"bare"],[25,27,19.24,19.705,"19"],[28,30,19.78,19.985,"år"],[31,37,20.0,20.365,"gammel"]],"speaker":"Marie"},{"id":4,"start":21.97,"end":28.395,"text":"Mannen min, Peder, arbeidet på fabrikk. Han laget møbler.","zh":"我丈夫佩德尔在工厂工作，制作家具。","words":[[0,6,21.97,22.355,"mannen"],[7,10,22.41,22.615,"min"],[12,17,22.85,23.315,"peder"],[19,27,24.17,24.792,"arbeidet"],[28,30,24.792,24.915,"på"],[31,38,24.97,25.455,"fabrikk"],[40,43,27.09,27.295,"han"],[44,49,27.37,27.795,"laget"],[50,56,27.85,28.395,"møbler"]],"speaker":"Marie"},{"id":5,"start":30.28,"end":36.745,"text":"Det var vanskelig å finne et sted å bo, men vi fant et lite hus til slutt.","zh":"当时很难找到住处，不过我们最后找到了一间小房子。","words":[[0,3,30.28,30.443,"det"],[4,7,30.443,30.705,"var"],[8,17,30.98,31.742,"vanskelig"],[18,19,31.742,31.845,"å"],[20,25,31.88,32.203,"finne"],[26,28,32.203,32.383,"et"],[29,33,32.383,32.713,"sted"],[34,35,32.713,32.803,"å"],[36,38,32.803,32.945,"bo"],[40,43,34.56,34.805,"men"],[44,46,34.86,34.985,"vi"],[47,51,35.04,35.403,"fant"],[52,54,35.403,35.562,"et"],[55,59,35.562,35.865,"lite"],[60,63,35.9,36.205,"hus"],[64,67,36.24,36.403,"til"],[68,73,36.403,36.745,"slutt"]],"speaker":"Marie"},{"id":6,"start":39.44,"end":40.945,"text":"Jeg var så glad i Peder.","zh":"我很爱佩德尔。","words":[[0,3,39.44,39.602,"jeg"],[4,7,39.602,39.763,"var"],[8,10,39.763,39.905,"så"],[11,15,39.96,40.373,"glad"],[16,17,40.373,40.483,"i"],[18,23,40.483,40.945,"peder"]],"speaker":"Marie"},{"id":7,"start":42.02,"end":46.165,"text":"Han var alltid positiv og i godt humør.","zh":"他总是很乐观，心情很好。","words":[[0,3,42.02,42.203,"han"],[4,7,42.203,42.385,"var"],[8,14,42.48,43.305,"alltid"],[15,22,43.36,44.532,"positiv"],[23,25,44.532,44.665,"og"],[26,27,45.04,45.145,"i"],[28,32,45.2,45.665,"godt"],[33,38,45.7,46.165,"humør"]],"speaker":"Marie"},{"id":8,"start":47.62,"end":53.185,"text":"«Ta det med ro. Det ordner seg», sa han bestandig.","zh":"他总说：“别着急，一切都会解决的。”","words":[[1,3,47.62,47.825,"ta"],[4,7,48.16,48.302,"det"],[8,11,48.302,48.442,"med"],[12,14,48.442,48.605,"ro"],[16,19,49.5,49.665,"det"],[20,26,49.76,50.332,"ordner"],[27,30,50.332,50.605,"seg"],[33,35,51.72,51.885,"sa"],[36,39,51.94,52.145,"han"],[40,49,52.22,53.185,"bestandig"]],"speaker":"Marie"},{"id":9,"start":54.8,"end":58.485,"text":"Han hadde rett. Alt ordnet seg.","zh":"他说得对，一切都解决了。","words":[[0,3,54.8,54.985,"han"],[4,9,55.0,55.305,"hadde"],[10,14,55.34,55.685,"rett"],[16,19,57.02,57.545,"alt"],[20,26,57.66,58.245,"ordnet@pa-vei-extra-28"],[27,30,58.26,58.485,"seg"]],"speaker":"Marie"},{"id":10,"start":59.92,"end":64.305,"text":"Vi fikk fem barn, tre gutter og to jenter.","zh":"我们有了五个孩子，三个男孩、两个女孩。","words":[[0,2,59.92,60.045,"vi"],[3,7,60.12,60.405,"fikk"],[8,11,60.5,60.765,"fem"],[12,16,60.94,61.305,"barn"],[18,21,62.06,62.345,"tre"],[22,28,62.5,62.965,"gutter"],[29,31,63.38,63.525,"og"],[32,34,63.56,63.725,"to"],[35,41,63.82,64.305,"jenter"]],"speaker":"Marie"},{"id":11,"start":66.16,"end":72.645,"text":"Det var mye å gjøre, men jeg var ung, sterk og forelsket.","zh":"虽然有很多事要做，但那时我年轻、健壮，又沉浸在爱情里。","words":[[0,3,66.16,66.322,"det"],[4,7,66.322,66.605,"var"],[8,11,66.76,67.042,"mye"],[12,13,67.042,67.143,"å"],[14,19,67.143,67.505,"gjøre"],[21,24,68.42,68.625,"men"],[25,28,68.66,68.905,"jeg"],[29,32,68.92,69.125,"var"],[33,36,69.24,69.585,"ung"],[38,43,70.36,71.065,"sterk"],[44,46,71.7,71.845,"og"],[47,56,71.88,72.645,"forelsket"]],"speaker":"Marie"},{"id":12,"start":74.8,"end":77.945,"text":"Nå er jeg gammel og ikke så sterk lenger.","zh":"现在我老了，不再那么健壮。","words":[[0,2,74.8,74.925,"nå"],[3,5,75.0,75.132,"er"],[6,9,75.132,75.303,"jeg"],[10,16,75.303,75.745,"gammel"],[17,19,76.56,76.685,"og"],[20,24,76.74,77.023,"ikke"],[25,27,77.023,77.165,"så"],[28,33,77.2,77.585,"sterk"],[34,40,77.6,77.945,"lenger@pa-vei-extra-33"]],"speaker":"Marie"},{"id":13,"start":79.96,"end":84.185,"text":"Jeg savner Peder. Han døde for ti år siden.","zh":"我很想念佩德尔，他十年前去世了。","words":[[0,3,79.96,80.145,"jeg"],[4,10,80.18,80.745,"savner"],[11,16,80.78,81.265,"peder"],[18,21,82.56,82.785,"han"],[22,26,82.86,83.205,"døde@pa-vei-extra-31"],[27,30,83.22,83.382,"for"],[31,33,83.382,83.545,"ti"],[34,36,83.66,83.843,"år"],[37,42,83.843,84.185,"siden"]],"speaker":"Marie"},{"id":14,"start":85.94,"end":88.205,"text":"Jeg tenker på ham hver dag.","zh":"我每天都会想他。","words":[[0,3,85.94,86.125,"jeg"],[4,10,86.14,86.645,"tenker@pa-vei-extra-32"],[11,13,86.66,86.785,"på"],[14,17,86.82,87.005,"ham"],[18,22,87.26,87.745,"hver"],[23,26,87.8,88.205,"dag"]],"speaker":"Marie"},{"id":15,"start":90.0,"end":97.385,"text":"I går var jeg sammen med familien min, både barn, barnebarn og oldebarn.","zh":"昨天我和家人在一起，有孩子们、孙辈和曾孙辈。","words":[[0,1,90.0,90.125,"i"],[2,5,90.18,90.545,"går"],[6,9,90.88,91.023,"var"],[10,13,91.023,91.185,"jeg"],[14,20,91.22,91.585,"sammen"],[21,24,91.6,91.765,"med"],[25,33,91.78,92.325,"familien"],[34,37,92.34,92.525,"min"],[39,43,93.66,93.965,"både"],[44,48,94.02,94.505,"barn"],[50,59,95.0,95.825,"barnebarn"],[60,62,96.32,96.485,"og"],[63,71,96.58,97.385,"oldebarn"]],"speaker":"Marie"},{"id":16,"start":98.82,"end":105.145,"text":"De laget en stor bursdagsfest med deilig mat og mange taler.","zh":"他们办了一场盛大的生日聚会，有美味的食物，还有很多祝寿发言。","words":[[0,2,98.82,98.985,"de"],[3,8,99.08,99.585,"laget"],[9,11,99.6,99.745,"en"],[12,16,99.86,100.545,"stor"],[17,29,100.66,102.025,"bursdagsfest"],[30,33,102.1,102.285,"med"],[34,40,102.4,103.045,"deilig"],[41,44,103.06,103.565,"mat"],[45,47,103.78,103.925,"og"],[48,53,104.0,104.585,"mange"],[54,59,104.66,105.145,"taler"]],"speaker":"Marie"},{"id":17,"start":106.62,"end":111.245,"text":"Synne, et av oldebarna mine, holdt en fin tale.","zh":"我的一个曾孙女叙内作了很好的发言。","words":[[0,5,106.62,107.065,"synne"],[7,9,107.86,108.082,"et@pa-vei-et-one"],[10,12,108.082,108.222,"av"],[13,22,108.222,108.882,"oldebarna"],[23,27,108.882,109.185,"mine"],[29,34,109.68,110.085,"holdt@pa-vei-extra-34"],[35,37,110.14,110.285,"en"],[38,41,110.42,110.765,"fin"],[42,46,110.82,111.245,"tale"]],"speaker":"Marie"},{"id":18,"start":113.84,"end":116.805,"text":"«Du har alltid tid, oldemor», sa hun.","zh":"她说：“曾祖母，你总是有时间。”","words":[[1,3,113.84,113.985,"du"],[4,7,114.06,114.245,"har"],[8,14,114.3,114.685,"alltid"],[15,18,114.76,115.345,"tid"],[20,27,115.38,115.885,"oldemor"],[30,32,116.4,116.565,"sa"],[33,36,116.62,116.805,"hun"]],"speaker":"Marie"},{"id":19,"start":117.94,"end":126.945,"text":"«Du har tid til å prate med oss og høre på oss. Vi er glad i deg. Gratulerer med dagen.»","zh":"“你有时间和我们聊天，听我们说话。我们爱你。生日快乐！”","words":[[1,3,117.94,118.085,"du"],[4,7,118.24,118.425,"har"],[8,11,118.54,118.905,"tid"],[12,15,118.94,119.102,"til"],[16,17,119.102,119.225,"å"],[18,23,119.28,119.925,"prate"],[24,27,119.94,120.125,"med"],[28,31,120.14,120.362,"oss"],[32,34,120.362,120.485,"og"],[35,39,120.78,121.203,"høre"],[40,42,121.203,121.345,"på"],[43,46,121.36,121.625,"oss"],[48,50,123.18,123.305,"vi"],[51,53,123.32,123.485,"er"],[54,58,123.5,123.773,"glad"],[59,60,123.773,123.852,"i"],[61,64,123.852,124.045,"deg"],[66,76,125.46,126.245,"gratulerer"],[77,80,126.4,126.553,"med"],[81,86,126.553,126.945,"dagen"]],"speaker":"Marie"},{"id":20,"start":129.3,"end":136.245,"text":"Hun sa også noe annet: «Jeg tror du har levd et rikt liv, oldemor.»","zh":"她还说：“曾祖母，我觉得你过了充实的一生。”","words":[[0,3,129.3,129.505,"hun"],[4,6,129.62,129.785,"sa"],[7,11,129.98,130.285,"også"],[12,15,130.32,130.545,"noe"],[16,21,130.72,131.245,"annet"],[24,27,132.84,133.065,"jeg"],[28,32,133.14,133.502,"tror"],[33,35,133.502,133.645,"du"],[36,39,133.68,133.845,"har"],[40,44,133.86,134.265,"levd"],[45,47,134.36,134.565,"et"],[48,52,134.66,135.185,"rikt@pa-vei-extra-29"],[53,56,135.3,135.665,"liv@pa-vei-liv-life"],[58,65,135.7,136.245,"oldemor"]],"speaker":"Marie"},{"id":21,"start":138.56,"end":143.105,"text":"Hun har rett. Jeg føler meg rik.","zh":"她说得对，我觉得自己很富足。","words":[[0,3,138.56,138.765,"hun"],[4,7,138.86,139.125,"har"],[8,12,139.14,139.505,"rett"],[14,17,141.62,141.825,"jeg"],[18,23,141.94,142.403,"føler"],[24,27,142.403,142.585,"meg"],[28,31,142.64,143.105,"rik"]],"speaker":"Marie"},{"id":22,"start":145.12,"end":152.625,"text":"Jeg har hatt et langt og godt liv, og jeg har mange fine minner.","zh":"我过了漫长而美好的一生，有很多美好的回忆。","words":[[0,3,145.12,145.305,"jeg"],[4,7,145.34,145.525,"har"],[8,12,145.54,145.845,"hatt@pa-vei-extra-30"],[13,15,145.86,146.065,"et"],[16,21,146.28,146.905,"langt"],[22,24,147.28,147.425,"og"],[25,29,147.44,147.845,"godt"],[30,33,147.96,148.245,"liv@pa-vei-liv-life"],[35,37,149.44,149.572,"og"],[38,41,149.572,149.743,"jeg"],[42,45,149.743,149.945,"har"],[46,51,150.2,150.865,"mange"],[52,56,151.22,151.965,"fine"],[57,63,152.22,152.625,"minner"]],"speaker":"Marie"},{"id":23,"start":155.52,"end":159.465,"text":"Når jeg blir voksen, vil jeg gifte meg med morfar. Han er så snill.","zh":"等我长大了，我要嫁给外公。他那么好。","words":[[0,3,155.52,155.692,"når@pa-vei-når-when"],[4,7,155.692,155.863,"jeg"],[8,12,155.863,156.053,"blir"],[13,19,156.053,156.505,"voksen"],[21,24,156.78,156.933,"vil"],[25,28,156.933,157.062,"jeg"],[29,34,157.062,157.402,"gifte"],[35,38,157.402,157.543,"meg"],[39,42,157.543,157.692,"med"],[43,49,157.692,158.165,"morfar"],[51,54,158.6,158.762,"han"],[55,57,158.762,158.903,"er"],[58,60,158.903,159.045,"så"],[61,66,159.08,159.465,"snill"]],"speaker":"Siri"},{"id":24,"start":160.74,"end":165.125,"text":"Nei, lille venn. Du kan ikke gifte deg med faren min.","zh":"不行，小宝贝。你不能嫁给我爸爸。","words":[[0,3,160.74,161.005,"nei"],[5,10,161.1,161.385,"lille@pa-vei-extra-36"],[11,15,161.4,161.725,"venn"],[17,19,163.08,163.225,"du"],[20,23,163.34,163.525,"kan"],[24,28,163.54,163.785,"ikke"],[29,34,163.8,164.183,"gifte"],[35,38,164.183,164.343,"deg"],[39,42,164.343,164.485,"med"],[43,48,164.52,164.933,"faren"],[49,52,164.933,165.125,"min"]],"speaker":"Mamma"},{"id":25,"start":166.48,"end":169.625,"text":"Hvorfor ikke? Du giftet deg med faren min.","zh":"为什么不行？你就嫁给了我爸爸。","words":[[0,7,166.48,166.882,"hvorfor"],[8,12,166.882,167.245,"ikke"],[14,16,168.0,168.145,"du"],[17,23,168.26,168.623,"giftet"],[24,27,168.623,168.762,"deg"],[28,31,168.762,168.923,"med"],[32,37,168.923,169.325,"faren"],[38,41,169.34,169.625,"min"]],"speaker":"Siri"},{"id":26,"start":172.76,"end":173.605,"text":"Innbydelse","zh":"邀请函","words":[[0,10,172.76,173.605,"innbydelse"]]},{"id":27,"start":175.52,"end":179.345,"text":"Til Kyoko Hatsuo med ledsager","zh":"敬邀 Kyoko Hatsuo 及同伴","words":[[0,3,175.52,175.745,"til"],[4,9,176.1,176.825,"kyoko"],[10,16,177.16,177.805,"hatsuo"],[17,20,178.34,178.605,"med"],[21,29,178.64,179.345,"ledsager@pa-vei-extra-48"]]},{"id":28,"start":181.99,"end":192.395,"text":"Annabelle Rosa & Øyvind har den glede å innby til bryllup lørdag 14.9. kl. 19.00.","zh":"Annabelle Rosa 和 Øyvind 欣喜地邀请您参加婚礼，时间为 9 月 14 日星期六 19:00。","words":[[0,9,181.99,182.595,"annabelle"],[10,14,182.71,183.175,"rosa@pa-vei-extra-41"],[17,23,183.95,184.435,"øyvind"],[24,27,185.23,185.472,"har"],[28,31,185.472,185.655,"den@pa-vei-den-definite"],[32,37,185.69,186.155,"glede@pa-vei-extra-42"],[38,39,186.25,186.355,"å"],[40,45,186.45,186.815,"innby"],[46,49,186.87,187.055,"til"],[50,57,187.11,187.695,"bryllup"],[58,64,188.51,189.155,"lørdag"],[65,69,189.61,190.895,"14.9"],[71,73,191.67,191.995,"kl"],[75,80,192.03,192.395,"19.00"]]},{"id":29,"start":193.92,"end":198.605,"text":"Adresse: Bryggerhuset Restaurant, Havnegata 8","zh":"地址：Bryggerhuset 餐厅，Havnegata 街 8 号。","words":[[0,7,193.92,194.425,"adresse"],[9,21,195.28,196.162,"bryggerhuset"],[22,32,196.162,196.745,"restaurant"],[34,43,197.3,198.165,"havnegata"],[44,45,198.26,198.605,"8"]]},{"id":30,"start":200.3,"end":204.145,"text":"Vielsen foregår i Havstein kirke, kl. 12.00.","zh":"结婚仪式将于 12:00 在 Havstein 教堂举行。","words":[[0,7,200.3,200.945,"vielsen"],[8,15,201.02,201.605,"foregår"],[16,17,201.66,201.765,"i"],[18,26,201.86,202.585,"havstein"],[27,32,202.6,203.045,"kirke"],[34,36,203.44,203.745,"kl"],[38,43,203.8,204.145,"12.00"]]},{"id":31,"start":205.35,"end":208.695,"text":"S.U. innen 15.8.","zh":"请于 8 月 15 日前回复是否出席。","words":[[0,4,205.35,206.535,"s.u."],[5,10,206.71,207.115,"innen"],[11,15,207.57,208.695,"15.8"]]},{"id":32,"start":209.99,"end":213.355,"text":"Hei! Er du og Ove ledige neste lørdag?","zh":"嗨！你和奥韦下星期六有空吗？","words":[[0,3,209.99,210.195,"hei"],[5,7,211.31,211.475,"er"],[8,10,211.49,211.635,"du"],[11,13,211.71,211.835,"og"],[14,17,211.89,212.235,"ove"],[18,24,212.27,212.713,"ledige"],[25,30,212.713,213.072,"neste"],[31,37,213.072,213.355,"lørdag"]]},{"id":33,"start":214.16,"end":221.265,"text":"Vi lager vårfest, etter en laaang vinter. Eva (og Jan)","zh":"漫长的冬天终于过去了，我们要办春日聚会。埃娃（和扬）","words":[[0,2,214.16,214.282,"vi"],[3,8,214.282,214.605,"lager"],[9,16,214.64,215.385,"vårfest"],[18,23,216.2,216.463,"etter"],[24,26,216.463,216.605,"en"],[27,33,216.68,217.465,"laaang"],[34,40,217.52,217.965,"vinter"],[42,45,219.6,219.945,"eva"],[47,49,220.82,220.945,"og"],[50,53,220.96,221.265,"jan"]]},{"id":34,"start":223.46,"end":224.405,"text":"Kjære Ingrid","zh":"亲爱的英格丽：","words":[[0,5,223.46,223.945,"kjære"],[6,12,223.98,224.405,"ingrid"]]},{"id":35,"start":225.68,"end":230.385,"text":"Tusen takk for den vakre brosjen som jeg fikk til min 60-årsdag.","zh":"非常感谢你在我六十岁生日时送给我的漂亮胸针。","words":[[0,5,225.68,226.162,"tusen"],[6,10,226.162,226.423,"takk"],[11,14,226.423,226.562,"for"],[15,18,226.562,226.705,"den@pa-vei-den-definite"],[19,24,226.74,227.205,"vakre@pa-vei-extra-49"],[25,32,227.24,227.705,"brosjen"],[33,36,228.3,228.483,"som"],[37,40,228.483,228.665,"jeg"],[41,45,228.72,228.963,"fikk"],[46,49,228.963,229.125,"til"],[50,53,229.14,229.325,"min"],[54,63,229.46,230.385,"60-årsdag"]]},{"id":36,"start":231.68,"end":233.405,"text":"Jeg pynter meg med den ofte.","zh":"我经常戴着它。","words":[[0,3,231.68,231.845,"jeg"],[4,10,231.88,232.382,"pynter@pa-vei-extra-47"],[11,14,232.382,232.565,"meg"],[15,18,232.58,232.765,"med"],[19,22,232.78,232.945,"den"],[23,27,233.02,233.405,"ofte"]]},{"id":37,"start":235.04,"end":236.845,"text":"Hjertelig hilsen tante Helga","zh":"亲切问候，赫尔加阿姨","words":[[0,9,235.04,235.543,"hjertelig"],[10,16,235.543,236.065,"hilsen"],[17,22,236.08,236.465,"tante"],[23,28,236.48,236.845,"helga@pa-vei-extra-44"]]},{"id":38,"start":239.12,"end":240.325,"text":"Kjære alle sammen","zh":"亲爱的各位：","words":[[0,5,239.12,239.605,"kjære"],[6,10,239.66,239.945,"alle"],[11,17,239.96,240.325,"sammen"]]},{"id":39,"start":241.44,"end":244.325,"text":"Tusen, tusen takk for flotte blomster!","zh":"非常非常感谢你们送的美丽鲜花！","words":[[0,5,241.44,242.085,"tusen"],[7,12,242.14,242.645,"tusen"],[13,17,242.66,242.965,"takk"],[18,21,243.0,243.185,"for"],[22,28,243.28,243.822,"flotte"],[29,37,243.822,244.325,"blomster"]]},{"id":40,"start":245.52,"end":250.805,"text"