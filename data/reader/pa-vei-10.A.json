{"id":"pa-vei-10.A","bookId":"pa-vei-textbook","readingId":"10.A","title":"Kjærlighet og savn","audio":"audio/pa-vei/10.A.mp3","duration":111.048,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.84,"end":2.685,"text":"Når kom du hit, Paul?","zh":"保罗，你什么时候来这里的？","words":[[0,3,0.84,1.085,"når"],[4,7,1.2,1.445,"kom"],[8,10,1.54,1.685,"du"],[11,14,1.84,2.245,"hit"],[16,20,2.38,2.685,"paul"]],"speaker":"Monica"},{"id":1,"start":3.46,"end":6.385,"text":"Jeg kom hit for tre år og fire måneder siden.","zh":"我三年零四个月前来到这里。","words":[[0,3,3.46,3.645,"jeg"],[4,7,3.68,3.885,"kom"],[8,11,3.94,4.192,"hit"],[12,15,4.192,4.345,"for"],[16,19,4.36,4.605,"tre"],[20,22,4.76,5.005,"år"],[23,25,5.18,5.325,"og"],[26,30,5.4,5.742,"fire"],[31,38,5.742,6.103,"måneder"],[39,44,6.103,6.385,"siden"]],"speaker":"Paul"},{"id":2,"start":8.18,"end":9.825,"text":"Hvordan var det å komme hit?","zh":"刚来这里时怎么样？","words":[[0,7,8.18,8.605,"hvordan"],[8,11,8.64,8.822,"var"],[12,15,8.822,8.943,"det"],[16,17,8.943,9.043,"å"],[18,23,9.043,9.445,"komme"],[24,27,9.48,9.825,"hit"]],"speaker":"Monica"},{"id":3,"start":11.556,"end":13.201,"text":"Det var litt vanskelig i begynnelsen.","zh":"一开始有点困难。","words":[[0,3,11.556,11.718,"det"],[4,7,11.718,11.941,"var"],[8,12,11.956,12.168,"litt"],[13,22,12.168,12.639,"vanskelig"],[23,24,12.639,12.709,"i"],[25,36,12.709,13.201,"begynnelsen"]],"speaker":"Paul"},{"id":4,"start":13.996,"end":14.821,"text":"Jeg var flyktning.","zh":"我当时是难民。","words":[[0,3,13.996,14.149,"jeg"],[4,7,14.149,14.301,"var"],[8,17,14.316,14.821,"flyktning"]],"speaker":"Paul"},{"id":5,"start":15.536,"end":17.321,"text":"Jeg var alene og kjente ingen.","zh":"我独自一人，谁也不认识。","words":[[0,3,15.536,15.668,"jeg"],[4,7,15.668,15.838,"var"],[8,13,15.838,16.301,"alene"],[14,16,16.536,16.681,"og"],[17,23,16.696,17.038,"kjente"],[24,29,17.038,17.321,"ingen"]],"speaker":"Paul"},{"id":6,"start":18.116,"end":21.261,"text":"Jeg savnet familien min, og det var mørkt og kaldt.","zh":"我想念家人，这里又黑又冷。","words":[[0,3,18.116,18.281,"jeg"],[4,10,18.296,18.739,"savnet"],[11,19,18.739,19.218,"familien"],[20,23,19.218,19.381,"min"],[25,27,19.736,19.849,"og"],[28,31,19.849,19.959,"det"],[32,35,19.959,20.101,"var"],[36,41,20.116,20.541,"mørkt"],[42,44,20.716,20.858,"og"],[45,50,20.858,21.261,"kaldt"]],"speaker":"Paul"},{"id":7,"start":22.86,"end":23.401,"text":"Huff ja!","zh":"唉，是啊！","words":[[0,4,22.86,23.22,"huff"],[5,7,23.256,23.401,"ja"]],"speaker":"Monica"},{"id":8,"start":24.456,"end":26.861,"text":"Det er ikke så lett å komme til et nytt sted.","zh":"来到一个新地方并不容易。","words":[[0,3,24.456,24.599,"det"],[4,6,24.599,24.729,"er"],[7,11,24.729,24.928,"ikke"],[12,14,24.928,25.059,"så"],[15,19,25.059,25.358,"lett"],[20,21,25.358,25.481,"å"],[22,27,25.496,25.861,"komme"],[28,31,25.896,26.059,"til"],[32,34,26.059,26.209,"et"],[35,39,26.209,26.481,"nytt"],[40,44,26.496,26.861,"sted"]],"speaker":"Monica"},{"id":9,"start":28.136,"end":30.581,"text":"Jeg savner også ofte familien min.","zh":"我也经常想念家人。","words":[[0,3,28.136,28.321,"jeg"],[4,10,28.376,28.761,"savner"],[11,15,28.796,29.161,"også"],[16,20,29.436,29.801,"ofte"],[21,29,29.836,30.349,"familien"],[30,33,30.349,30.581,"min"]],"speaker":"Monica"},{"id":10,"start":32.076,"end":32.921,"text":"Når kom du hit?","zh":"你是什么时候来这里的？","words":[[0,3,32.076,32.279,"når"],[4,7,32.279,32.441,"kom"],[8,10,32.476,32.601,"du"],[11,14,32.656,32.921,"hit"]],"speaker":"Paul"},{"id":11,"start":34.316,"end":36.081,"text":"For omtrent to år siden.","zh":"大约两年前。","words":[[0,3,34.316,34.519,"for"],[4,11,34.519,35.121,"omtrent"],[12,14,35.296,35.461,"to"],[15,17,35.576,35.758,"år"],[18,23,35.758,36.081,"siden"]],"speaker":"Monica"},{"id":12,"start":37.596,"end":38.901,"text":"Hvorfor flyttet du hit?","zh":"你为什么搬来这里？","words":[[0,7,37.596,38.021,"hvorfor"],[8,15,38.056,38.401,"flyttet"],[16,18,38.416,38.561,"du"],[19,22,38.636,38.901,"hit"]],"speaker":"Paul"},{"id":13,"start":40.396,"end":41.701,"text":"På grunn av kjærlighet!","zh":"因为爱情！","words":[[0,2,40.396,40.541,"på"],[3,8,40.556,40.868,"grunn"],[9,11,40.868,41.001,"av"],[12,22,41.036,41.701,"kjærlighet"]],"speaker":"Monica"},{"id":14,"start":42.816,"end":43.881,"text":"Mannen min er norsk.","zh":"我丈夫是挪威人。","words":[[0,6,42.816,43.118,"mannen"],[7,10,43.118,43.301,"min"],[11,13,43.356,43.489,"er"],[14,19,43.489,43.881,"norsk@pa-vei-norsk-adjective"]],"speaker":"Monica"},{"id":15,"start":44.996,"end":46.801,"text":"Vi giftet oss for et år siden.","zh":"我们一年前结婚了。","words":[[0,2,44.996,45.141,"vi"],[3,9,45.156,45.588,"giftet"],[10,13,45.588,45.821,"oss"],[14,17,45.896,46.061,"for"],[18,20,46.076,46.301,"et"],[21,23,46.316,46.489,"år"],[24,29,46.489,46.801,"siden"]],"speaker":"Monica"},{"id":16,"start":48.476,"end":49.921,"text":"Da lærte du vel norsk raskt?","zh":"那你一定很快就学会挪威语了吧？","words":[[0,2,48.476,48.621,"da"],[3,8,48.636,48.928,"lærte"],[9,11,48.928,49.038,"du"],[12,15,49.038,49.181,"vel"],[16,21,49.196,49.521,"norsk"],[22,27,49.536,49.921,"raskt"]],"speaker":"Paul"},{"id":17,"start":51.116,"end":53.141,"text":"Nei, jeg lærte engelsk!","zh":"没有，我学会的是英语！","words":[[0,3,51.116,51.341,"nei"],[5,8,52.016,52.198,"jeg"],[9,14,52.198,52.541,"lærte"],[15,22,52.576,53.141,"engelsk"]],"speaker":"Monica"},{"id":18,"start":54.396,"end":58.401,"text":"Jeg kunne ikke så mye engelsk, men alle snakket engelsk til meg.","zh":"我原本不太会英语，可大家都跟我说英语。","words":[[0,3,54.396,54.581,"jeg"],[4,9,54.616,54.928,"kunne"],[10,14,54.928,55.148,"ikke"],[15,17,55.148,55.279,"så"],[18,21,55.279,55.541,"mye"],[22,29,55.556,56.101,"engelsk"],[31,34,56.696,56.841,"men"],[35,39,56.896,57.141,"alle"],[40,47,57.156,57.561,"snakket"],[48,55,57.576,58.041,"engelsk"],[56,59,58.056,58.239,"til"],[60,63,58.239,58.401,"meg"]],"speaker":"Monica"},{"id":19,"start":59.416,"end":63.961,"text":"Nå er jeg ganske god i engelsk, men jeg er ikke så flink i norsk!","zh":"现在我的英语相当不错，可挪威语还不太好！","words":[[0,2,59.416,59.541,"nå"],[3,5,59.556,59.678,"er"],[6,9,59.678,59.829,"jeg"],[10,16,59.829,60.341,"ganske"],[17,20,60.356,60.588,"god"],[21,22,60.588,60.681,"i"],[23,30,60.696,61.261,"engelsk"],[32,35,62.216,62.358,"men"],[36,39,62.358,62.489,"jeg"],[40,42,62.489,62.668,"er"],[43,47,62.668,62.868,"ikke"],[48,50,62.868,63.001,"så"],[51,56,63.036,63.421,"flink"],[57,58,63.476,63.569,"i"],[59,64,63.569,63.961,"norsk"]],"speaker":"Monica"},{"id":20,"start":67.566,"end":68.271,"text":"Sammendrag.","zh":"摘要","words":[[0,10,67.566,68.271,"sammendrag"]]},{"id":21,"start":70.446,"end":74.111,"text":"Monica kom til Norge for litt over to år siden.","zh":"莫妮卡两年多前来到挪威。","words":[[0,6,70.446,71.011,"monica"],[7,10,71.066,71.251,"kom"],[11,14,71.286,71.451,"til"],[15,20,71.506,71.931,"norge"],[21,24,72.426,72.591,"for"],[25,29,72.606,72.891,"litt"],[30,34,72.906,73.151,"over"],[35,37,73.226,73.431,"to"],[38,40,73.606,73.791,"år"],[41,46,73.806,74.111,"siden"]]},{"id":22,"start":75.686,"end":77.071,"text":"Mannen hennes er norsk.","zh":"她的丈夫是挪威人。","words":[[0,6,75.686,76.069,"mannen"],[7,13,76.069,76.491,"hennes"],[14,16,76.566,76.698,"er"],[17,22,76.698,77.071,"norsk@pa-vei-norsk-adjective"]]},{"id":23,"start":78.986,"end":80.791,"text":"De giftet seg for et år siden.","zh":"他们一年前结婚了。","words":[[0,2,78.986,79.131,"de"],[3,9,79.166,79.629,"giftet"],[10,13,79.629,79.831,"seg"],[14,17,79.886,80.051,"for"],[18,20,80.086,80.349,"et"],[21,23,80.349,80.499,"år"],[24,29,80.499,80.791,"siden"]]},{"id":24,"start":82.886,"end":87.511,"text":"Alle snakket engelsk til Monica, og hun ble flink i engelsk.","zh":"大家都跟莫妮卡说英语，她的英语也就变好了。","words":[[0,4,82.886,83.149,"alle"],[5,12,83.149,83.531,"snakket"],[13,20,83.606,84.149,"engelsk"],[21,24,84.149,84.328,"til"],[25,31,84.328,84.731,"monica"],[33,35,85.906,86.029,"og"],[36,39,86.029,86.209,"hun"],[40,43,86.209,86.371,"ble"],[44,49,86.426,86.831,"flink"],[50,51,86.846,86.951,"i"],[52,59,86.986,87.511,"engelsk"]]},{"id":25,"start":89.966,"end":93.291,"text":"Paul kom til Norge for litt over tre år siden.","zh":"保罗三年多前来到挪威。","words":[[0,4,89.966,90.331,"paul"],[5,8,90.406,90.591,"kom"],[9,12,90.626,90.811,"til"],[13,18,90.866,91.311,"norge"],[19,22,91.766,91.948,"for"],[23,27,91.948,92.219,"litt"],[28,32,92.219,92.431,"over"],[33,36,92.446,92.711,"tre"],[37,39,92.846,92.999,"år"],[40,45,92.999,93.291,"siden"]]},{"id":26,"start":95.206,"end":97.111,"text":"Det var vanskelig for ham i begynnelsen.","zh":"他一开始过得很艰难。","words":[[0,3,95.206,95.369,"det"],[4,7,95.369,95.519,"var"],[8,17,95.519,96.089,"vanskelig"],[18,21,96.089,96.249,"for"],[22,25,96.249,96.391,"ham"],[26,27,96.426,96.519,"i"],[28,39,96.519,97.111,"begynnelsen"]]},{"id":27,"start":99.206,"end":103.011,"text":"Han var flyktning, og familien hans var ikke i Norge.","zh":"他是难民，家人当时不在挪威。","words":[[0,3,99.206,99.369,"han"],[4,7,99.369,99.531,"var"],[8,17,99.566,100.111,"flyktning"],[19,21,101.046,101.168,"og"],[22,30,101.168,101.791,"familien"],[31,35,101.806,102.159,"hans"],[36,39,102.159,102.398,"var"],[40,44,102.398,102.618,"ikke"],[45,46,102.618,102.698,"i"],[47,52,102.698,103.011,"norge"]]},{"id":28,"start":105.006,"end":109.391,"text":"Han følte seg ensom og savnet kona si og barna sine.","zh":"他感到孤独，想念自己的妻子和孩子。","words":[[0,3,105.006,105.171,"han"],[4,9,105.186,105.478,"følte"],[10,13,105.478,105.631,"seg"],[14,19,105.686,106.211,"ensom"],[20,22,107.066,107.191,"og"],[23,29,107.206,107.631,"savnet"],[30,34,107.646,108.051,"kona"],[35,37,108.086,108.251,"si"],[38,40,108.646,108.768,"og"],[41,46,108.768,109.071,"barna"],[47,51,109.086,109.391,"sine"]]}],"lexicon":{"alene":{"lemma":"alene","zh":"独自；一个人","pos":"副词","ref":"ty-conversation-7-002","clip":null},"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"begynnelsen":{"lemma":"begynnelse","zh":"开始","pos":"名词","ref":"15-051","form":"单数定指","clip":null},"ble":{"lemma":"bli","zh":"变成