{"id":"14.1","title":"Har du erfaring?","audio":"audio/14.1.mp3","duration":184.87,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.7,"text":"14.1 Har du erfaring?","heading":true,"zh":"14.1 你有经验吗？","words":[[0,4,0.15,1.4,"14.1"],[5,8,2.04,2.68,"har"],[9,11,2.68,2.88,"du"],[12,20,2.88,3.62,"erfaring"]]},{"id":1,"start":6.43,"end":9.72,"text":"Biniam snakker med rådgiveren på skolen.","zh":"比尼亚姆在和学校的辅导老师谈话。","words":[[0,6,6.51,7.16,"biniam"],[7,14,7.16,8.02,"snakker"],[15,18,8.02,8.22,"med"],[19,29,8.22,8.92,"rådgiveren"],[30,32,8.92,9.1,"på"],[33,39,9.1,9.64,"skolen"]]},{"id":2,"start":10.54,"end":14.88,"text":"Han vil finne en deltidsjobb, og han trenger noen gode råd.","zh":"他想找一份兼职工作，需要一些好的建议。","words":[[0,3,10.62,10.86,"han"],[4,7,10.86,11.1,"vil"],[8,13,11.1,11.48,"finne"],[14,16,11.48,11.66,"en~a939a9e56dc5"],[17,28,11.66,12.52,"deltidsjobb"],[30,32,13.0,13.12,"og"],[33,36,13.12,13.28,"han"],[37,44,13.28,13.76,"trenger"],[45,49,13.76,13.98,"noen~c766e2ef794d"],[50,54,13.98,14.3,"gode"],[55,58,14.3,14.8,"råd~2845757cee70"]]},{"id":3,"start":16.94,"end":18.99,"text":"Har du søkt på noen jobber?","speaker":"Rådgiver","zh":"你申请过什么工作吗？","words":[[0,3,17.02,17.26,"har~8b9792170cca"],[4,6,17.26,17.48,"du"],[7,11,17.48,17.94,"søkt"],[12,14,17.94,18.14,"på~7aeb7328b615"],[15,19,18.14,18.36,"noen~c766e2ef794d"],[20,26,18.36,18.91,"jobber~b0bbda30cf66"]]},{"id":4,"start":19.71,"end":29.82,"text":"Nei. Jeg synes det er vanskelig, for jeg har ingen arbeidserfaring. Jeg har ikke jobbet i Norge og nesten ikke i Eritrea heller.","speaker":"Biniam","zh":"没有。我觉得很难，因为我没有任何工作经验。我没在挪威工作过，在厄立特里亚也几乎没工作过。","words":[[0,3,19.79,20.24,"nei"],[5,8,20.74,20.96,"jeg"],[9,14,20.96,21.42,"synes"],[15,18,21.42,21.58,"det"],[19,21,21.58,21.68,"er"],[22,31,21.68,22.22,"vanskelig"],[33,36,22.76,22.92,"for~1b22712a94b1"],[37,40,22.92,23.1,"jeg"],[41,44,23.1,23.3,"har"],[45,50,23.3,23.58,"ingen~47148835f7bd"],[51,66,23.58,24.54,"arbeidserfaring"],[68,71,25.73,25.93,"jeg"],[72,75,25.93,26.11,"har~8b9792170cca"],[76,80,26.11,26.31,"ikke"],[81,87,26.31,26.71,"jobbet~bec4250eb05a"],[88,89,26.71,26.95,"i"],[90,95,26.95,27.25,"norge~546b56e35dd5"],[96,98,27.59,27.71,"og"],[99,105,27.71,28.23,"nesten"],[106,110,28.23,28.47,"ikke"],[111,112,28.47,28.67,"i"],[113,120,28.67,29.27,"eritrea"],[121,127,29.27,29.74,"heller"]]},{"id":5,"start":30.69,"end":37.01,"text":"Nei, men det er fordi du er så ung. Du har sikkert litt erfaring med å jobbe?","speaker":"Rådgiver","zh":"嗯，不过那是因为你还这么年轻。你肯定多少有点工作经验吧？","words":[[0,3,30.77,31.15,"nei"],[5,8,31.27,31.47,"men"],[9,12,31.47,31.97,"det"],[13,15,31.97,32.19,"er"],[16,21,32.19,32.45,"fordi"],[22,24,32.45,32.63,"du"],[25,27,32.63,32.81,"er"],[28,30,32.81,32.97,"så~3ce5ee52f624"],[31,34,32.97,33.25,"ung"],[36,38,33.89,34.13,"du"],[39,42,34.13,34.33,"har"],[43,50,34.33,34.71,"sikkert~f29cb042145d"],[51,55,34.71,35.03,"litt~462e893626a5"],[56,64,35.27,35.85,"erfaring"],[65,68,35.85,36.19,"med~e913aa264046"],[69,70,36.19,36.41,"å~0583da7a620a"],[71,76,36.41,36.93,"jobbe"]]},{"id":6,"start":37.28,"end":40.54,"text":"Ja, jeg hjalp bestemora mi mye.","zh":"有，我以前经常帮我的（外）祖母。","words":[[0,2,37.45,38.13,"ja"],[4,7,38.65,38.79,"jeg"],[8,13,38.79,39.19,"hjalp"],[14,23,39.19,39.79,"bestemora"],[24,26,39.79,39.95,"mi"],[27,30,39.95,40.46,"mye~933c5a923198"]]},{"id":7,"start":41.13,"end":45.88,"text":"Hun satt i rullestol, og da bestefar døde, trengte hun mye hjelp.","zh":"她坐轮椅，（外）祖父去世以后，她需要很多帮助。","words":[[0,3,41.21,41.43,"hun"],[4,8,41.43,41.67,"satt"],[9,10,41.67,41.87,"i"],[11,20,41.87,42.49,"rullestol"],[22,24,42.99,43.03,"og"],[25,27,43.03,43.15,"da~3ded9627966c"],[28,36,43.15,43.69,"bestefar"],[37,41,43.69,44.19,"døde~d98886bea945"],[43,50,44.29,44.75,"trengte"],[51,54,44.75,44.89,"hun"],[55,58,44.89,45.23,"mye~cc164d0dc3da"],[59,64,45.23,45.8,"hjelp"]]},{"id":8,"start":46.34,"end":51.66,"text":"Jeg stelte henne, hjalp henne med å lage mat og ryddet og vasket huset hennes.","zh":"我照顾她，帮她做饭，还给她收拾、打扫房子。","words":[[0,3,46.42,46.57,"jeg"],[4,10,46.57,47.07,"stelte"],[11,16,47.07,47.29,"henne"],[18,23,47.81,48.15,"hjalp"],[24,29,48.15,48.31,"henne"],[30,33,48.31,48.47,"med~0cacd71903f3"],[34,35,48.47,48.61,"å~0583da7a620a"],[36,40,48.61,48.83,"lage"],[41,44,48.83,49.13,"mat"],[45,47,49.59,49.67,"og"],[48,54,49.67,50.11,"ryddet"],[55,57,50.11,50.35,"og"],[58,64,50.35,50.73,"vasket"],[65,70,50.73,51.17,"huset"],[71,77,51.17,51.58,"hennes"]]},{"id":9,"start":52.56,"end":63.73,"text":"Så flott! Du har jo arbeidserfaring. Det må du skrive i cv-en din. Du må ikke gi opp. Du kan sikkert mye mer.","speaker":"Rådgiver","zh":"太好了！你明明有工作经验嘛。这一定要写进你的简历里。你可不能放弃。你肯定还会很多别的。","words":[[0,2,52.64,52.88,"så~73c411d516d4"],[3,8,52.88,53.26,"flott"],[10,12,54.12,54.58,"du"],[13,16,54.58,54.94,"har"],[17,19,54.94,55.14,"jo~26e309f3d56e"],[20,35,55.14,56.06,"arbeidserfaring"],[37,40,57.14,57.58,"det"],[41,43,57.58,57.82,"må"],[44,46,57.82,57.98,"du"],[47,53,57.98,58.36,"skrive"],[54,55,58.36,58.74,"i"],[56,61,58.74,59.3,"cv-en"],[62,65,59.3,59.46,"din"],[67,69,60.02,60.48,"du"],[70,72,60.48,60.66,"må"],[73,77,60.66,60.92,"ikke"],[78,80,60.92,61.22,"gi~3662590f3303"],[81,84,61.22,61.46,"opp~41da3c147da4"],[86,88,61.92,62.14,"du"],[89,92,62.14,62.4,"kan~590d3a8829d0"],[93,100,62.4,62.9,"sikkert~f29cb042145d"],[101,104,62.9,63.26,"mye~933c5a923198"],[105,108,63.26,63.65,"mer~564a1acc2512"]]},{"id":10,"start":64.71,"end":72.71,"text":"Læreren min på barneskolen sa alltid at jeg var flink til å hjelpe andre i klassen, og at jeg var tålmodig og rolig.","zh":"我小学的老师总是说，我很会帮助班上的同学，而且我有耐心、性格沉稳。","words":[[0,7,64.79,65.34,"læreren"],[8,11,65.34,65.44,"min"],[12,14,65.44,65.64,"på"],[15,26,65.64,66.36,"barneskolen"],[27,29,66.36,66.72,"sa"],[30,36,66.72,67.18,"alltid~867f85a8b647"],[37,39,67.18,67.4,"at"],[40,43,67.4,67.52,"jeg"],[44,47,67.52,67.66,"var"],[48,53,67.66,68.02,"flink"],[54,57,68.02,68.22,"til~f53df80a7837"],[58,59,68.22,68.32,"å~0583da7a620a"],[60,66,68.32,68.74,"hjelpe"],[67,72,68.74,69.22,"andre~dea7bdd3277b"],[73,74,69.22,69.34,"i"],[75,82,69.34,69.72,"klassen"],[84,86,70.38,70.66,"og"],[87,89,70.66,71.02,"at"],[90,93,71.02,71.16,"jeg"],[94,97,71.16,71.28,"var"],[98,106,71.28,71.98,"tålmodig"],[107,109,71.98,72.16,"og"],[110,115,72.16,72.63,"rolig"]]},{"id":11,"start":72.85,"end":87.24,"text":"Så bra. Det er viktige egenskaper i mange jobber. Hvis du skriver det i en jobbsøknad, gir det et godt inntrykk. Hva sier vennene dine om deg?","speaker":"Rådgiver","zh":"很好。这些在很多工作中都是重要的品质。如果你把这些写进求职信，会给人留下好印象。你的朋友们怎么评价你？","words":[[0,2,73.59,74.23,"så~73c411d516d4"],[3,6,74.23,74.51,"bra~bbb83846e29f"],[8,11,75.41,75.81,"det"],[12,14,75.81,76.09,"er"],[15,22,76.09,76.71,"viktige"],[23,33,76.71,77.53,"egenskaper"],[34,35,77.53,77.75,"i"],[36,41,77.75,77.97,"mange"],[42,48,77.97,78.41,"jobber~b0bbda30cf66"],[50,54,79.5,79.74,"hvis"],[55,57,79.74,79.92,"du"],[58,65,79.92,80.28,"skriver"],[66,69,80.28,80.62,"det"],[70,71,80.62,80.84,"i"],[72,74,80.84,81.04,"en~a939a9e56dc5"],[75,85,81.04,81.76,"jobbsøknad"],[87,90,82.34,82.52,"gir"],[91,94,82.52,82.64,"det"],[95,97,82.64,82.84,"et~054dde72f37b"],[98,102,82.84,83.14,"godt~78a776a84f33"],[103,111,83.14,83.74,"inntrykk"],[113,116,84.98,85.4,"hva"],[117,121,85.4,85.72,"sier"],[122,129,85.72,86.32,"vennene"],[130,134,86.32,86.6,"dine"],[135,137,86.6,86.84,"om~52c0bdc828db"],[138,141,86.84,87.16,"deg"]]},{"id":12,"start":88.08,"end":100.89,"text":"De sier at jeg smiler og ler mye, og de sier at jeg alltid er i godt humør, og at jeg alltid klarer ting alene uten hjelp. Hvordan kan jeg skrive det i en søknad?","speaker":"Biniam","zh":"他们说我常常微笑、爱笑，说我总是心情很好，还说我总能不靠别人帮忙、自己把事情做好。这些在求职信里该怎么写呢？","words":[[0,2,88.16,88.38,"de"],[3,7,88.38,88.64,"sier"],[8,10,88.64,88.86,"at"],[11,14,88.86,89.0,"jeg"],[15,21,89.0,89.62,"smiler"],[22,24,89.62,89.82,"og"],[25,28,89.82,90.12,"ler"],[29,32,90.12,90.5,"mye~933c5a923198"],[34,36,90.98,91.14,"og"],[37,39,91.14,91.28,"de"],[40,44,91.28,91.56,"sier"],[45,47,91.56,91.76,"at"],[48,51,91.76,91.88,"jeg"],[52,58,91.88,92.34,"alltid~867f85a8b647"],[59,61,92.34,92.56,"er"],[62,63,92.56,92.66,"i~7deece28f2d9"],[64,68,92.66,92.92,"godt~4c689535094c"],[69,74,92.92,93.28,"humør"],[76,78,93.98,94.08,"og"],[79,81,94.08,94.22,"at"],[82,85,94.22,94.34,"jeg"],[86,92,94.34,94.8,"alltid~867f85a8b647"],[93,99,94.8,95.32,"klarer"],[100,104,95.32,95.5,"ting"],[105,110,95.5,96.08,"alene"],[111,115,96.08,96.7,"uten"],[116,121,96.7,97.1,"hjelp"],[123,130,98.38,98.62,"hvordan"],[131,134,98.62,98.84,"kan"],[135,138,98.84,98.98,"jeg"],[139,145,98.98,99.4,"skrive"],[146,149,99.4,99.76,"det"],[150,151,99.76,100.04,"i"],[152,154,100.04,100.16,"en~a939a9e56dc5"],[155,161,100.16,100.81,"søknad"]]},{"id":13,"start":101.85,"end":113.24,"text":"Du kan skrive at du er blid og positiv. Hvis du liker å gjøre oppgaver alene, er du en selvstendig person. Det kan du også skrive.","speaker":"Rådgiver","zh":"你可以写你开朗、积极。如果你喜欢独立完成任务，那你就是一个独立的人。这一点你也可以写。","words":[[0,2,101.93,102.06,"du"],[3,6,102.06,102.24,"kan"],[7,13,102.24,102.68,"skrive"],[14,16,102.68,103.04,"at"],[17,19,103.04,103.3,"du"],[20,22,103.3,103.54,"er"],[23,27,103.54,104.02,"blid"],[28,30,104.02,104.16,"og"],[31,38,104.16,104.5,"positiv"],[40,44,106.18,106.38,"hvis"],[45,47,106.38,106.56,"du"],[48,53,106.56,107.08,"liker"],[54,55,107.08,107.26,"å~0583da7a620a"],[56,61,107.26,107.48,"gjøre"],[62,70,107.48,108.0,"oppgaver"],[71,76,108.0,108.4,"alene"],[78,80,109.36,109.58,"er"],[81,83,109.58,109.7,"du"],[84,86,109.7,109.86,"en~a939a9e56dc5"],[87,98,109.86,110.64,"selvstendig"],[99,105,110.64,110.94,"person"],[107,110,111.62,111.96,"det"],[111,114,111.96,112.14,"kan"],[115,117,112.14,112.32,"du"],[118,122,112.32,112.6,"også"],[123,129,112.6,113.16,"skrive"]]},{"id":14,"start":114.21,"end":118.93,"text":"Vennene mine sier også at jeg er litt treg og bruker lang tid på ting.","speaker":"Biniam","zh":"我的朋友们也说我有点慢，做事要花很长时间。","words":[[0,7,114.29,114.8,"vennene"],[8,12,114.8,115.06,"mine"],[13,17,115.06,115.4,"sier"],[18,22,115.4,115.72,"også"],[23,25,115.72,115.88,"at"],[26,29,115.88,116.02,"jeg"],[30,32,116.02,116.18,"er"],[33,37,116.18,116.38,"litt~54360be2a478"],[38,42,116.38,116.86,"treg"],[43,45,116.86,117.3,"og"],[46,52,117.3,117.7,"bruker"],[53,57,117.7,117.94,"lang"],[58,61,117.94,117.94,"tid"],[62,64,117.94,117.94,"på~9ff1cc4a0f4a"],[65,69,117.94,117.94,"ting"]]},{"id":15,"start":119.84,"end":132.12,"text":"Det bør du ikke skrive i søknaden, for det gir et dårlig inntrykk, men du kan skrive at du er grundig. Det viktigste er å være ærlig.","speaker":"Rådgiver","zh":"这一点你最好别写进求职信，因为会给人留下不好的印象，不过你可以写你做事很仔细。最重要的是要诚实。","words":[[0,3,119.92,120.32,"det"],[4,7,120.32,120.56,"bør"],[8,10,120.56,120.74,"du"],[11,15,120.74,121.42,"ikke"],[16,22,121.42,122.04,"skrive"],[23,24,122.04,122.26,"i"],[25,33,122.26,122.84,"søknaden"],[35,38,123.44,123.68,"for~1b22712a94b1"],[39,42,123.68,123.84,"det"],[43,46,123.84,124.06,"gir"],[47,49,124.06,124.34,"et~054dde72f37b"],[50,56,124.34,124.9,"dårlig"],[57,65,124.9,125.46,"inntrykk"],[67,70,125.8,126.38,"men"],[71,73,126.38,126.8,"du"],[74,77,126.8,126.94,"kan"],[78,84,126.94,127.34,"skrive"],[85,87,127.34,127.66,"at"],[88,90,127.66,127.82,"du"],[91,93,127.82,128.0,"er"],[94,101,128.0,128.82,"grundig~066f8c1a9acb"],[103,106,129.5,129.82,"det"],[107,116,129.82,130.42,"viktigste"],[117,119,130.42,130.96,"er"],[120,121,130.96,131.28,"å~0583da7a620a"],[122,126,131.28,131.54,"være"],[127,132,131.54,132.05,"ærlig"]]},{"id":16,"start":132.6,"end":138.19,"text":"Takk for tipset! Nå skal jeg gå hjem og skrive cv og søke på jobber.","speaker":"Biniam","zh":"谢谢你的建议！我现在就回家写简历、申请工作。","words":[[0,4,132.72,133.38,"takk"],[5,8,133.38,133.54,"for~dbf4329b7fe1"],[9,15,133.74,134.04,"tipset"],[17,19,134.52,134.86,"nå~d531d47a7712"],[20,24,134.86,135.04,"skal"],[25,28,135.04,135.2,"jeg"],[29,31,135.2,135.38,"gå"],[32,36,135.38,135.6,"hjem~b247484eda2e"],[37,39,135.6,135.82,"og"],[40,46,135.82,136.14,"skrive"],[47,49,136.14,136.6,"cv"],[50,52,136.6,136.96,"og"],[53,57,136.96,137.36,"søke"],[58,60,137.36,137.56,"på~7aeb7328b615"],[61,67,137.56,138.11,"jobber~b0bbda30cf66"]]},{"id":17,"start":139.09,"end":142.65,"text":"Lykke til! Ta kontakt hvis du trenger mer hjelp.","speaker":"Rådgiver","zh":"祝你好运！如果还需要帮助，就来找我。","words":[[0,5,139.16,139.51,"lykke"],[6,9,139.51,139.77,"til~01d134aa0a9e"],[11,13,140.51,140.77,"ta~641293bdfef8"],[14,21,140.77,141.15,"kontakt"],[22,26,141.33,141.41,"hvis"],[27,29,141.41,141.55,"du"],[30,37,141.55,141.81,"trenger"],[38,41,141.81,142.05,"mer~564a1acc2512"],[42,47,142.05,142.57,"hjelp"]]},{"id":18,"start":146.59,"end":147.68,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,146.67,147.6,"sammendrag"]]},{"id":19,"start":148.96,"end":155.19,"text":"Biniam er hos rådgiveren på skolen og får tips om å skrive cv og jobbsøknad.","zh":"比尼亚姆在学校的辅导老师那里，得到了一些关于写简历和求职信的建议。","words":[[0,6,149.04,149.67,"biniam"],[7,9,149.67,150.05,"er"],[10,13,150.05,150.23,"hos"],[14,24,150.23,150.99,"rådgiveren"],[25,27,150.99,151.11,"på"],[28,34,151.11,151.53,"skolen"],[35,37,151.53,152.21,"og"],[38,41,152.21,152.37,"får"],[42,46,152.37,152.57,"tips"],[47,49,152.57,152.89,"om~52c0bdc828db"],[50,51,152.89,153.03,"å~0583da7a620a"],[52,58,153.03,153.23,"skrive"],[59,61,153.23,153.65,"cv"],[62,64,153.65,154.21,"og"],[65,75,154.21,155.11,"jobbsøknad"]]},{"id":20,"start":156.45,"end":164.14,"text":"Biniam har aldri jobbet i hjemlandet sitt eller i Norge, men han har erfaring med å stelle bestemora si.","zh":"比尼亚姆从来没有在祖国或挪威工作过，但他有照顾（外）祖母的经验。","words":[[0,6,156.53,157.02,"biniam"],[7,10,157.02,157.32,"har~8b9792170cca"],[11,16,157.32,157.78,"aldri"],[17,23,157.78,158.14,"jobbet~bec4250eb05a"],[24,25,158.14,158.3,"i"],[26,36,158.3,158.78,"hjemlandet"],[37,41,158.78,159.02,"sitt~9563d0679965"],[42,47,159.02,159.64,"eller"],[48,49,159.64,159.88,"i"],[50,55,159.88,160.18,"norge~546b56e35dd5"],[57,60,160.88,161.16,"men"],[61,64,161.16,161.54,"han"],[65,68,161.54,161.74,"har"],[69,77,161.74,162.36,"erfaring"],[78,81,162.36,162.6,"med~e913aa264046"],[82,83,162.6,162.76,"å~0583da7a620a"],[84,90,162.76,163.04,"stelle"],[91,100,163.04,163.64,"bestemora"],[101,103,163.64,164.06,"si~21de5ccc8df9"]]},{"id":21,"start":165.06,"end":170.87,"text":"Han har også mange gode egenskaper som er fine å skrive om i en jobbsøknad.","zh":"他还有很多适合写进求职信的好品质。","words":[[0,3,165.14,165.57,"han"],[4,7,165.57,165.75,"har"],[8,12,165.75,166.03,"også"],[13,18,166.03,166.31,"mange"],[19,23,166.31,166.83,"gode"],[24,34,166.83,167.63,"egenskaper"],[35,38,167.63,168.13,"som~b7970b8f941e"],[39,41,168.13,168.29,"er"],[42,46,168.29,168.65,"fine"],[47,48,168.65,168.91,"å~0583da7a620a"],[49,55,168.91,169.25,"skrive"],[56,58,169.25,169.57,"om~8128865a7556"],[59,60,169.71,169.81,"i"],[61,63,169.81,169.93,"en~a939a9e56dc5"],[64,74,169.93,170.79,"jobbsøknad"]]},{"id":22,"start":171.8,"end":176.8,"text":"Når han kommer hjem, skal han skrive cv og søke på noen jobber.","zh":"他回到家后要写简历，申请几份工作。","words":[[0,3,171.88,172.13,"når~8cac549467d0"],[4,7,172.13,172.37,"han"],[8,14,172.37,172.69,"kommer"],[15,19,172.69,173.07,"hjem~b247484eda2e"],[21,25,173.51,173.65,"skal"],[26,29,173.65,173.85,"han"],[30,36,173.85,174.21,"skrive"],[37,39,174.21,174.69,"cv"],[40,42,174.69,175.43,"og"],[43,47,175.43,175.83,"søke"],[48,50,175.83,175.97,"på~7aeb7328b615"],[51,55,175.97,176.25,"noen~c766e2ef794d"],[56,62,176.25,176.72,"jobber~b0bbda30cf66"]]},{"id":23,"start":177.5,"end":181.59,"text":"Hvis han trenger mer hjelp, kan han ta kontakt med rådgiveren.","zh":"如果他还需要帮助，可以联系辅导老师。","words":[[0,4,177.58,177.78,"hvis"],[5,8,177.78,178.02,"han"],[9,16,178.02,178.4,"trenger"],[17,20,178.4,178.66,"mer~564a1acc2512"],[21,26,178.66,179.16,"hjelp"],[28,31,179.58,179.72,"kan"],[32,35,179.72,179.9,"han"],[36,38,179.9,180.06,"ta~332c54eb0064"],[39,46,180.06,180.52,"kontakt"],[47,50,180.52,180.76,"med~dde70b718750"],[51,61,180.76,181.52,"rådgiveren"]]}],"lexicon":{"14.1":{"lemma":"14.1","zh":"第 14.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aldri":{"lemma":"aldri","zh":"从不；从来没