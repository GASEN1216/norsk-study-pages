{"id":"ty-conversation-1.1","bookId":"ty-conversation-guide","readingId":"1.1","title":"Introducing yourself","audio":"audio/ty-conversation/1.1.mp3","duration":31.895521,"synthetic":false,"sentences":[{"id":0,"start":0.7,"end":3.505,"speaker":"Olav","text":"Hei! Hva heter du?","zh":"你好！你叫什么名字？","words":[[0,3,0.7,0.925,"hei"],[5,8,2.14,2.325,"hva"],[9,14,2.56,3.105,"heter"],[15,17,3.36,3.505,"du"]]},{"id":1,"start":4.54,"end":7.765,"speaker":"Kari","text":"Kari. Hva heter du?","zh":"卡里。你叫什么名字？","words":[[0,4,4.54,5.045,"kari"],[6,9,6.62,6.805,"hva"],[10,15,7.06,7.565,"heter"],[16,18,7.62,7.765,"du"]]},{"id":2,"start":8.94,"end":10.825,"speaker":"Olav","text":"Jeg heter Olav.","zh":"我叫奥拉夫。","words":[[0,3,8.94,9.185,"jeg"],[4,9,9.38,9.965,"heter"],[10,14,10.36,10.825,"olav"]]},{"id":3,"start":12.06,"end":13.805,"speaker":"Kari","text":"Bor du i Oslo?","zh":"你住在奥斯陆吗？","words":[[0,3,12.06,12.465,"bor"],[4,6,12.84,12.985,"du"],[7,8,13.2,13.305,"i@ty-place"],[9,13,13.4,13.805,"oslo"]]},{"id":4,"start":15.0,"end":17.285,"speaker":"Olav","text":"Nei, jeg bor i Bergen.","zh":"不，我住在卑尔根。","words":[[0,3,15.0,15.265,"nei"],[5,8,15.96,16.205,"jeg"],[9,12,16.26,16.585,"bor"],[13,14,16.74,16.843,"i@ty-place"],[15,21,16.843,17.285,"bergen"]]},{"id":5,"start":18.5,"end":20.305,"speaker":"Kari","text":"Er du på ferie her?","zh":"你来这里度假吗？","words":[[0,2,18.5,18.765,"er"],[3,5,18.82,18.965,"du"],[6,8,19.14,19.285,"på@ty-holiday"],[9,14,19.44,19.945,"ferie"],[15,18,20.02,20.305,"her"]]},{"id":6,"start":21.6,"end":24.645,"speaker":"Olav","text":"Ja, jeg er på ferie her.","zh":"是的，我来这里度假。","words":[[0,2,21.6,21.765,"ja"],[4,7,22.88,23.145,"jeg"],[8,10,23.3,23.485,"er"],[11,13,23.54,23.685,"på@ty-holiday"],[14,19,23.8,24.265,"ferie"],[20,23,24.34,24.645,"her"]]},{"id":7,"start":26.06,"end":27.425,"speaker":"Olav","text":"Er du på ferie?","zh":"你在度假吗？","words":[[0,2,26.06,26.285,"er"],[3,5,26.36,26.505,"du"],[6,8,26.86,27.005,"på@ty-holiday"],[9,14,27.04,27.425,"ferie"]]},{"id":8,"start":28.26,"end":30.525,"speaker":"Kari","text":"Nei, jeg bor her.","zh":"不，我就住在这里。","words":[[0,3,28.26,28.625,"nei"],[5,8,29.48,29.745,"jeg"],[9,12,29.84,30.145,"bor"],[13,16,30.24,30.525,"her"]]}],"lexicon":{"bergen":{"lemma":"Bergen","zh":"卑尔根（挪威城市）","pos":"专名","ref":"1-059","clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"ferie":{"lemma":"ferie","zh":"假期；度假","pos":"名词","ref":"ty-conversation-1-005","clip":null},"hei":{"lemma":"hei","zh":"你好","pos":"感叹词","ref":"ty-conversation-1-009","clip":null},"her":{"lemma":"her","zh":"这里","pos":"副词","ref":"ty-conversation-1-010","clip":null},"heter":{"lemma":"hete","zh":"名叫；叫做","pos":"动词","ref":"ty-conversation-1-011","clip":null,"form":"现在时"},"hva":{"lemma":"hva","zh":"什么","pos":"疑问代词","ref":"ty-conversation-1-013","clip":null},"i":{"lemma":"i","zh":"在","pos":"介词","ref":"ty-conversation-1-015","clip":null},"i@ty-place":{"lemma":"i","zh":"在（某个地方）","pos":"介词","ref":"ty-conversation-1-015","clip":null,"contextual":true,"baseKey":"i","surface":"i"},"ja":{"lemma":"ja","zh":"是的；好的","pos":"感叹词","ref":"ty-conversation-1-017","clip":null},"jeg":{"lemma":"jeg","zh":"我","pos":"代词","ref":"ty-conversation-1-018","clip":null,"form":"主格"},"kari":{"lemma":"Kari","zh":"卡里（人名）","pos":"专名","ref":null,"clip":null},"nei":{"lemma":"nei","zh":"不；不是","pos":"感叹词","ref":"ty-conversation-1-020","clip":null},"olav":{"lemma":"Olav","zh":"奥拉夫（人名）","pos":"专名","ref":null,"clip":null},"oslo":{"lemma":"Oslo","zh":"奥斯陆（挪威首都）","pos":"专名","ref":"basics:city:Oslo","clip":null},"på":{"lemma":"på","zh":"在","pos":"介词","ref":"ty-conversation-1-022","clip":null},"på@ty-holiday":{"lemma":"på","zh":"（på ferie）在度假","pos":"介词","ref":"ty-conversation-1-022","clip":null,"contextual":true,"baseKey":"på","surface":"på"}}}
