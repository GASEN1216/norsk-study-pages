{"id":"ty-conversation-1.1","bookId":"ty-conversation-guide","readingId":"1.1","title":"Introducing yourself","audio":"audio/ty-conversation/1.1.mp3","duration":31.895521,"synthetic":false,"sentences":[{"id":0,"start":0.37,"end":3.63,"speaker":"Olav","text":"Hei! Hva heter du?","zh":"你好！你叫什么名字？","words":[[0,3,0.37,1.03,"hei"],[5,8,2.07,2.45,"hva"],[9,14,2.45,3.01,"heter"],[15,17,3.01,3.63,"du"]]},{"id":1,"start":4.37,"end":7.89,"speaker":"Kari","text":"Kari. Hva heter du?","zh":"卡里。你叫什么名字？","words":[[0,4,4.37,5.05,"kari"],[6,9,6.01,6.93,"hva"],[10,15,6.93,7.43,"heter"],[16,18,7.43,7.89,"du"]]},{"id":2,"start":8.71,"end":10.75,"speaker":"Olav","text":"Jeg heter Olav.","zh":"我叫奥拉夫。","words":[[0,3,8.71,9.27,"jeg"],[4,9,9.27,9.85,"heter"],[10,14,9.85,10.75,"olav"]]},{"id":3,"start":11.79,"end":13.79,"speaker":"Kari","text":"Bor du i Oslo?","zh":"你住在奥斯陆吗？","words":[[0,3,11.79,12.51,"bor"],[4,6,12.51,13.07,"du"],[7,8,13.07,13.35,"i@ty-place"],[9,13,13.35,13.79,"oslo"]]},{"id":4,"start":14.43,"end":17.23,"speaker":"Olav","text":"Nei, jeg bor i Bergen.","zh":"不，我住在卑尔根。","words":[[0,3,14.43,15.33,"nei"],[5,8,15.91,16.19,"jeg"],[9,12,16.19,16.51,"bor"],[13,14,16.51,16.85,"i@ty-place"],[15,21,16.85,17.23,"bergen"]]},{"id":5,"start":18.27,"end":20.31,"speaker":"Kari","text":"Er du på ferie her?","zh":"你来这里度假吗？","words":[[0,2,18.27,18.79,"er"],[3,5,18.79,19.05,"du"],[6,8,19.05,19.35,"på@ty-holiday"],[9,14,19.35,19.97,"ferie"],[15,18,19.97,20.31,"her"]]},{"id":6,"start":20.81,"end":24.61,"speaker":"Olav","text":"Ja, jeg er på ferie her.","zh":"是的，我来这里度假。","words":[[0,2,20.81,21.89,"ja"],[4,7,22.77,23.17,"jeg"],[8,10,23.17,23.49,"er"],[11,13,23.49,23.71,"på@ty-holiday"],[14,19,23.71,24.29,"ferie"],[20,23,24.29,24.61,"her"]]},{"id":7,"start":25.21,"end":27.43,"speaker":"Olav","text":"Er du på ferie?","zh":"你在度假吗？","words":[[0,2,25.21,26.27,"er"],[3,5,26.27,26.61,"du"],[6,8,26.61,27.01,"på@ty-holiday"],[9,14,27.01,27.43,"ferie"]]},{"id":8,"start":28.4,"end":30.64,"speaker":"Kari","t