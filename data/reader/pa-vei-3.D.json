{"id":"pa-vei-3.D","bookId":"pa-vei-textbook","readingId":"3.D","title":"Er du sjalu?","audio":"audio/pa-vei/3.D.mp3","duration":56.208,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":6.8,"end":9.065,"text":"Irina og Thomas er ofte sammen.","zh":"伊琳娜和托马斯经常在一起。","words":[[0,5,6.8,7.365,"irina"],[6,8,7.42,7.565,"og"],[9,15,7.58,8.125,"thomas"],[16,18,8.2,8.345,"er"],[19,23,8.38,8.705,"ofte"],[24,30,8.72,9.065,"sammen"]]},{"id":1,"start":10.92,"end":15.445,"text":"De sitter i en park, og Irina taster på mobilen.","zh":"他们坐在一座公园里，伊琳娜正在手机上打字。","words":[[0,2,10.92,11.065,"de"],[3,9,11.12,11.545,"sitter"],[10,11,11.56,11.662,"i"],[12,14,11.662,11.803,"en"],[15,19,11.803,12.245,"park"],[21,23,13.56,13.705,"og"],[24,29,13.74,14.245,"irina"],[30,36,14.28,14.765,"taster"],[37,39,14.8,14.942,"på"],[40,47,14.942,15.445,"mobilen"]]},{"id":2,"start":18.0,"end":18.645,"text":"Hva gjør du?","zh":"你在做什么？","words":[[0,3,18.0,18.185,"hva"],[4,8,18.26,18.512,"gjør"],[9,11,18.512,18.645,"du"]],"speaker":"Thomas"},{"id":3,"start":19.592,"end":21.437,"text":"Jeg svarer på en melding fra Vidar.","zh":"我在回复维达尔的一条消息。","words":[[0,3,19.592,19.755,"jeg"],[4,10,19.755,20.125,"svarer"],[11,13,20.125,20.234,"på"],[14,16,20.234,20.364,"en"],[17,24,20.364,20.737,"melding"],[25,28,20.772,20.957,"fra"],[29,34,20.972,21.437,"vidar"]],"speaker":"Irina"},{"id":4,"start":22.332,"end":22.817,"text":"Hvem er det?","zh":"他是谁？","words":[[0,4,22.332,22.537,"hvem"],[5,7,22.552,22.675,"er"],[8,11,22.675,22.817,"det"]],"speaker":"Thomas"},{"id":5,"start":23.772,"end":24.537,"text":"En gammel venn.","zh":"一位老朋友。","words":[[0,2,23.772,23.915,"en"],[3,9,23.915,24.277,"gammel"],[10,14,24.292,24.537,"venn"]],"speaker":"Irina"},{"id":6,"start":25.852,"end":26.657,"text":"Hvor bor han?","zh":"他住在哪里？","words":[[0,4,25.852,26.117,"hvor"],[5,8,26.192,26.485,"bor"],[9,12,26.485,26.657,"han"]],"speaker":"Thomas"},{"id":7,"start":27.612,"end":28.357,"text":"På Lillehammer.","zh":"在利勒哈默尔。","words":[[0,2,27.612,27.737,"på"],[3,14,27.752,28.357,"lillehammer"]],"speaker":"Irina"},{"id":8,"start":29.492,"end":30.137,"text":"Hva gjør han?","zh":"他做什么工作？","words":[[0,3,29.492,29.677,"hva"],[4,8,29.692,29.965,"gjør"],[9,12,29.965,30.137,"han"]],"speaker":"Thomas"},{"id":9,"start":31.152,"end":32.037,"text":"Han er musiker.","zh":"他是音乐家。","words":[[0,3,31.152,31.337,"han"],[4,6,31.352,31.495,"er"],[7,14,31.495,32.037,"musiker"]],"speaker":"Irina"},{"id":10,"start":33.132,"end":34.057,"text":"Hvor gammel er han?","zh":"他多大了？","words":[[0,4,33.132,33.377,"hvor"],[5,11,33.432,33.764,"gammel"],[12,14,33.764,33.895,"er"],[15,18,33.895,34.057,"han"]],"speaker":"Thomas"},{"id":11,"start":35.292,"end":39.077,"text":"Han er 34 år. Hvorfor spør du så mye?","zh":"他 34 岁。你为什么问这么多？","words":[[0,3,35.292,35.477,"han"],[4,6,35.492,35.657,"er"],[7,9,35.672,36.457,"34"],[10,12,36.512,36.757,"år"],[14,21,37.812,38.157,"hvorfor"],[22,26,38.212,38.484,"spør"],[27,29,38.484,38.617,"du"],[30,32,38.632,38.797,"så"],[33,36,38.812,39.077,"mye"]],"speaker":"Irina"},{"id":12,"start":40.412,"end":41.477,"text":"Fordi jeg er nysgjerrig.","zh":"因为我好奇。","words":[[0,5,40.412,40.717,"fordi"],[6,9,40.732,40.874,"jeg"],[10,12,40.874,40.984,"er"],[13,23,40.984,41.477,"nysgjerrig"]],"speaker":"Thomas"},{"id":13,"start":42.612,"end":43.84,"text":"Er du sjalu?","zh":"你吃醋了吗？","words":[[0,2,42.612,42.775,"er"],[3,5,42.775,42.897,"du"],[6,11,42.92,43.84,"sjalu"]],"speaker":"Irina"},{"id":14,"start":44.832,"end":47.797,"text":"Nei, men nå går jeg en tur i kiosken.","zh":"没有，不过我现在要去趟小卖部。","words":[[0,3,44.832,45.137,"nei"],[5,8,46.112,46.377,"men"],[9,11,46.532,46.677,"nå"],[12,15,46.712,46.954,"går"],[16,19,46.954,47.094,"jeg"],[20,22,47.094,47.195,"en"],[23,26,47.195,47.355,"tur"],[27,28,47.355,47.424,"i"],[29,36,47.424,47.797,"kiosken"]],"speaker":"Thomas"},{"id":15,"start":48.812,"end":50.057,"text":"Kjøper du en sjokolade til meg?","zh":"给我买块巧克力好吗？","words":[[0,6,48.812,49.094,"kjøper"],[7,9,49.094,49.184,"du"],[10,12,49.184,49.275,"en"],[13,22,49.275,49.764,"sjokolade"],[23,26,49.764,49.885,"til"],[27,30,49.885,50.057,"meg"]],"speaker":"Irina"},{"id":16,"start":51.092,"end":51.337,"text":"Nei.","zh":"不买。","words":[[0,3,51.092,51.337,"nei"]],"speaker":"Thomas"},{"id":17,"start":52.4,"end":54.197,"text":"Å, du er så dum!","zh":"啊，你真讨厌！","words":[[0,1,52.4,52.82,"å"],[3,5,53.172,53.337,"du"],[6,8,53.352,53.557,"er"],[9,11,53.572,53.717,"så"],[12,15,53.932,54.197,"dum"]],"speaker":"Irina"}],"lexicon":{"34":{"lemma":"34","pos":"数词","zh":"数字 34","ref":null,"clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"dum":{"lemma":"dum","zh":"笨的","pos":"形容词","ref":"ty-conversation-8-004","clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"fordi":{"lemma":"fordi","zh":"因为","pos":"从属连词","ref":"13-010","clip":null},"fra":{"lemma":"fra","zh":"从；来自","pos":"介词","ref":"ty-conversation-1-007","clip":null},"gammel":{"lemma":"gammel","zh":"旧的；年老的","pos":"形容词","ref":"8-023","clip":null},"gjør":{"lemma":"gjøre","pos":"动词","zh":"做","ref":null,"clip":null,"form":"现在时"},"går":{"lemma":"gå","pos":"动词","zh":"走；去；（车）开行","ref":null,"clip":null,"form":"现在时"},"han":{"lemma":"han","zh":"他","pos":"代词","ref":"ty-conversation-8-008","clip":null,"form":"主格"},"hva":{"lemma":"hva","zh":"什么","pos":"疑问代词","ref":"ty-conversation-1-013","clip":null},"hvem":{"lemma":"hvem","zh":"谁","pos":"疑问代词","ref":"1-027","clip":null},"hvor":{"lemma":"hvor","zh":"哪里","pos":"疑问副词","ref":"ty-conversation-2-008","clip":null},"hvorfor":{"le