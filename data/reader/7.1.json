{"id":"7.1","title":"Unnskyld, hvordan kommer jeg til Frognerparken?","audio":"audio/7.1.mp3","duration":202.74,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.92,"text":"7.1 Unnskyld, hvordan kommer jeg til Frognerparken?","heading":true,"zh":"7.1 请问，去弗罗格纳公园怎么走？","words":[[0,3,0.15,1.12,"7.1"],[4,12,2.16,2.66,"unnskyld"],[14,21,3.26,3.74,"hvordan"],[22,28,3.74,4.1,"kommer~72f4d90b3c99"],[29,32,4.1,4.4,"jeg"],[33,36,4.4,4.68,"til"],[37,50,4.68,5.84,"frognerparken"]]},{"id":1,"start":7.69,"end":12.29,"text":"Biniam tar toget til Oslo og går av på Oslo S.","zh":"比尼亚姆坐火车去奥斯陆，在奥斯陆中央车站下车。","words":[[0,6,7.75,8.47,"biniam"],[7,10,8.6,8.84,"tar"],[11,16,8.84,9.22,"toget"],[17,20,9.22,9.4,"til"],[21,25,9.4,9.96,"oslo"],[26,28,10.52,10.66,"og"],[29,32,10.66,10.96,"går~94cc3e99abf6"],[33,35,10.96,11.24,"av~303b66068598"],[36,38,11.24,11.42,"på"],[39,43,11.42,11.96,"oslo"],[44,45,11.96,12.14,"s"]]},{"id":2,"start":13.3,"end":16.25,"text":"Han skal møte ei venninne i Frognerparken.","zh":"他要在弗罗格纳公园和一位女性朋友见面。","words":[[0,3,13.37,13.64,"han"],[4,8,13.64,13.9,"skal"],[9,13,13.9,14.36,"møte~5c5ca137ac81"],[14,16,14.36,14.48,"ei~47aa2d18e376"],[17,25,14.48,15.04,"venninne"],[26,27,15.04,15.12,"i"],[28,41,15.12,16.11,"frognerparken"]]},{"id":3,"start":17.36,"end":25.13,"text":"Venninna heter Sara, og Biniam gleder seg til å møte henne, men hvor er Frognerparken?","zh":"这位朋友叫萨拉，比尼亚姆很期待见到她，可是弗罗格纳公园在哪儿呢？","words":[[0,8,17.41,18.14,"venninna"],[9,14,18.14,18.58,"heter"],[15,19,18.58,19.11,"sara"],[21,23,19.76,19.9,"og"],[24,30,19.9,20.44,"biniam"],[31,37,20.44,20.92,"gleder"],[38,41,20.92,21.22,"seg"],[42,45,21.22,21.38,"til~f6df3d4686b1"],[46,47,21.38,21.48,"å~0583da7a620a"],[48,52,21.48,21.82,"møte~728dce18f64e"],[53,58,21.82,22.27,"henne"],[60,63,22.86,23.22,"men"],[64,68,23.22,23.66,"hvor"],[69,71,23.66,23.98,"er"],[72,85,23.98,24.98,"frognerparken"]]},{"id":4,"start":26.66,"end":32.67,"text":"Biniam tar fram mobilen og slår på GPS-en for å finne Frognerparken.","zh":"比尼亚姆拿出手机，打开 GPS 来找弗罗格纳公园。","words":[[0,6,26.72,27.3,"biniam"],[7,10,27.3,27.6,"tar~e2a4ad6eb84f"],[11,15,27.6,27.88,"fram"],[16,23,27.88,28.61,"mobilen"],[24,26,29.1,29.24,"og"],[27,31,29.24,29.6,"slår~be04a037a690"],[32,34,29.6,29.98,"på~ac8d79526b63"],[35,41,29.98,30.92,"gps-en"],[42,45,30.92,31.06,"for~caaedf1d2285"],[46,47,31.06,31.18,"å~0583da7a620a"],[48,53,31.18,31.56,"finne"],[54,67,31.56,32.52,"frognerparken"]]},{"id":5,"start":33.79,"end":38.12,"text":"Han går gjennom Oslo S og finner Karl Johans gate.","zh":"他穿过奥斯陆中央车站，找到了卡尔·约翰大街。","words":[[0,3,33.85,34.18,"han"],[4,7,34.18,34.5,"går"],[8,15,34.5,34.94,"gjennom"],[16,20,34.94,35.5,"oslo"],[21,22,35.5,35.8,"s"],[23,25,36.14,36.26,"og"],[26,32,36.26,36.68,"finner"],[33,37,36.68,37.0,"karl"],[38,44,37.0,37.48,"johans"],[45,49,37.48,37.97,"gate"]]},{"id":6,"start":38.91,"end":42.2,"text":"Så går han Karl Johans gate opp til Slottet.","zh":"然后他沿着卡尔·约翰大街一直往上走到王宫。","words":[[0,2,38.97,39.46,"så~4a7ed2bb1489"],[3,6,39.46,39.76,"går"],[7,10,39.76,40.06,"han"],[11,15,40.06,40.34,"karl"],[16,22,40.34,40.78,"johans"],[23,27,40.78,41.22,"gate"],[28,31,41.22,41.42,"opp"],[32,35,41.42,41.62,"til"],[36,43,41.62,42.05,"slottet"]]},{"id":7,"start":43.69,"end":46.43,"text":"Plutselig er mobilen tom for batteri.","zh":"突然，手机没电了。","words":[[0,9,43.75,44.48,"plutselig"],[10,12,44.48,44.64,"er"],[13,20,44.64,45.2,"mobilen"],[21,24,45.2,45.5,"tom"],[25,28,45.5,45.7,"for~e38bd984bd19"],[29,36,45.7,46.28,"batteri"]]},{"id":8,"start":47.17,"end":48.77,"text":"Hva skal han gjøre nå?","zh":"他现在该怎么办？","words":[[0,3,47.23,47.52,"hva"],[4,8,47.52,47.76,"skal"],[9,12,47.76,47.94,"han"],[13,18,47.94,48.28,"gjøre"],[19,21,48.28,48.62,"nå~d531d47a7712"]]},{"id":9,"start":50.38,"end":54.94,"text":"Biniam går litt fram og tilbake, men han finner ikke veien.","zh":"比尼亚姆来回走了一会儿，可还是找不到路。","words":[[0,6,50.44,51.0,"biniam"],[7,10,51.0,51.22,"går"],[11,15,51.22,51.48,"litt~54360be2a478"],[16,20,51.48,51.82,"fram"],[21,23,51.82,51.98,"og"],[24,31,51.98,52.8,"tilbake"],[33,36,53.38,53.58,"men"],[37,40,53.58,53.78,"han"],[41,47,53.78,54.1,"finner"],[48,52,54.1,54.32,"ikke"],[53,58,54.32,54.79,"veien"]]},{"id":10,"start":55.6,"end":57.48,"text":"Han spør ei dame om hjelp.","zh":"他向一位女士求助。","words":[[0,3,55.66,55.92,"han"],[4,8,55.92,56.22,"spør"],[9,11,56.22,56.36,"ei~47aa2d18e376"],[12,16,56.36,56.74,"dame"],[17,19,56.74,56.86,"om~348a8c9ff21e"],[20,25,56.86,57.33,"hjelp"]]},{"id":11,"start":59.09,"end":62.24,"text":"Unnskyld, hvordan kommer jeg til Frognerparken?","speaker":"Biniam","zh":"请问，去弗罗格纳公园怎么走？","words":[[0,8,59.16,59.81,"unnskyld"],[10,17,59.96,60.4,"hvordan"],[18,24,60.4,60.68,"kommer~72f4d90b3c99"],[25,28,60.68,60.88,"jeg"],[29,32,60.88,61.14,"til"],[33,46,61.14,62.09,"frognerparken"]]},{"id":12,"start":63.05,"end":71.46,"text":"Trikk nummer 12 går dit. Du kan gå til venstre her og ta trikken der borte på den andre siden av gata.","speaker":"Dame","zh":"12路有轨电车去那儿。你可以在这儿往左走，到街对面那边去坐电车。","words":[[0,5,63.11,63.5,"trikk"],[6,12,63.5,64.0,"nummer"],[13,15,64.0,64.42,"12"],[16,19,64.42,64.68,"går~f010b28fdfbc"],[20,23,64.68,65.22,"dit"],[25,27,65.84,66.02,"du"],[28,31,66.02,66.28,"kan"],[32,34,66.28,66.48,"gå"],[35,38,66.48,66.68,"til"],[39,46,66.68,67.22,"venstre"],[47,50,67.22,67.7,"her"],[51,53,67.98,68.1,"og"],[54,56,68.1,68.38,"ta"],[57,64,68.38,68.82,"trikken"],[65,68,68.82,69.08,"der"],[69,74,69.08,69.54,"borte~cb7d143048ae"],[75,77,69.54,69.72,"på"],[78,81,69.72,70.06,"den~d13fe2f99333"],[82,87,70.06,70.4,"andre~9477191cb4dd"],[88,93,70.4,70.74,"siden~9a3d2d89a980"],[94,96,70.74,70.88,"av"],[97,101,70.88,71.31,"gata"]]},{"id":13,"start":72.08,"end":75.5,"text":"Hvor lang tid tar det til Frognerparken med trikk?","speaker":"Biniam","zh":"坐电车去弗罗格纳公园要多长时间？","words":[[0,4,72.14,72.54,"hvor~8598699b9b8d"],[5,9,72.54,72.82,"lang"],[10,13,72.82,73.2,"tid"],[14,17,73.2,73.5,"tar~376c12518b59"],[18,21,73.5,73.68,"det"],[22,25,73.68,73.92,"til"],[26,39,73.92,74.72,"frognerparken"],[40,43,74.72,74.9,"med~f2bae197f6fb"],[44,49,74.9,75.35,"trikk"]]},{"id":14,"start":76.03,"end":78.2,"text":"Det tar cirka 10 minutter.","speaker":"Dame","zh":"大约需要 10 分钟。","words":[[0,3,76.09,76.26,"det"],[4,7,76.26,76.62,"tar~376c12518b59"],[8,13,76.62,77.24,"cirka"],[14,16,77.24,77.5,"10"],[17,25,77.5,78.05,"minutter"]]},{"id":15,"start":79.09,"end":80.19,"text":"Takk for hjelpen!","speaker":"Biniam","zh":"谢谢你的帮助！","words":[[0,4,79.15,79.42,"takk"],[5,8,79.42,79.58,"for~713e6b1d2094"],[9,16,79.58,80.04,"hjelpen"]]},{"id":16,"start":82.48,"end":86.18,"text":"Biniam tar trikken og går av ved Frognerparken.","zh":"比尼亚姆坐上电车，在弗罗格纳公园下了车。","words":[[0,6,82.54,83.14,"biniam"],[7,10,83.14,83.5,"tar"],[11,18,83.5,84.14,"trikken"],[19,21,84.14,84.4,"og"],[22,25,84.4,84.68,"går~94cc3e99abf6"],[26,28,84.68,84.9,"av~303b66068598"],[29,32,84.9,85.06,"ved"],[33,46,85.06,86.03,"frognerparken"]]},{"id":17,"start":87.42,"end":89.45,"text":"Hvordan skal han finne Sara?","zh":"他要怎么找到萨拉呢？","words":[[0,7,87.48,87.96,"hvordan"],[8,12,87.96,88.16,"skal"],[13,16,88.16,88.38,"han"],[17,22,88.38,88.78,"finne"],[23,27,88.78,89.3,"sara"]]},{"id":18,"start":90.4,"end":95.79,"text":"De skal møtes ved Monolitten, en stor statue, men hvor er den?","zh":"他们约好在巨石柱见面——那是一座很大的雕像，可它在哪儿呢？","words":[[0,2,90.46,90.64,"de"],[3,7,90.64,90.88,"skal"],[8,13,90.88,91.4,"møtes"],[14,17,91.4,91.56,"ved"],[18,28,91.56,92.4,"monolitten"],[30,32,92.72,92.98,"en~a939a9e56dc5"],[33,37,92.98,93.36,"stor"],[38,44,93.36,94.08,"statue"],[46,49,94.44,94.66,"men"],[50,54,94.66,95.04,"hvor"],[55,57,95.04,95.24,"er"],[58,61,95.24,95.64,"den"]]},{"id":19,"start":96.62,"end":98.47,"text":"Han må spørre en gang til.","zh":"他得再问一次。","words":[[0,3,96.68,96.94,"han"],[4,6,96.94,97.1,"må"],[7,13,97.1,97.54,"spørre"],[14,16,97.54,97.78,"en~a939a9e56dc5"],[17,21,97.78,98.02,"gang"],[22,25,98.02,98.32,"til~81ba4d08328a"]]},{"id":20,"start":100.38,"end":104.31,"text":"Unnskyld, hvor er Monolitten?","speaker":"Biniam","zh":"请问，巨石柱在哪儿？","words":[[0,8,100.44,101.14,"unnskyld"],[10,14,101.8,102.28,"hvor"],[15,17,102.28,102.74,"er"],[18,28,103.16,104.16,"monolitten"]]},{"id":21,"start":105.57,"end":117.87,"text":"Du går til høyre og over broen der. Så går du rett fram, og der ser du en veldig høy statue med mange mennesker. Det er Monolitten.","speaker":"Mann","zh":"你往右走，过那边的桥。然后一直往前走，在那儿你会看到一座很高的雕像，上面雕刻着许多人物。那就是巨石柱。","words":[[0,2,105.63,106.16,"du"],[3,6,106.16,106.4,"går"],[7,10,106.4,106.6,"til"],[11,16,106.6,107.18,"høyre"],[17,19,107.44,107.64,"og"],[20,24,107.64,107.98,"over"],[25,30,107.98,108.4,"broen"],[31,34,108.4,108.86,"der"],[36,38,109.84,110.06,"så~4a7ed2bb1489"],[39,42,110.06,110.22,"går"],[43,45,110.22,110.38,"du"],[46,50,110.38,110.66,"rett~7d7de36817bf"],[51,55,110.66,111.1,"fram"],[57,59,111.46,111.64,"og"],[60,63,111.64,112.1,"der"],[64,67,112.1,112.28,"ser"],[68,70,112.28,112.4,"du"],[71,73,112.4,112.58,"en~a939a9e56dc5"],[74,80,112.58,113.06,"veldig"],[81,84,113.06,113.32,"høy"],[85,91,113.32,114.2,"statue"],[92,95,114.2,114.46,"med~429c44429983"],[96,101,114.46,114.92,"mange"],[102,111,114.92,115.6,"mennesker"],[113,116,116.26,116.66,"det"],[117,119,116.66,117.04,"er"],[120,130,117.04,117.72,"monolitten"]]},{"id":22,"start":119.27,"end":121.57,"text":"Hvor langt er det å gå dit?","speaker":"Biniam","zh":"走到那儿有多远？","words":[[0,4,119.33,119.78,"hvor~8598699b9b8d"],[5,10,119.78,120.28,"langt~d19f6c81bf73"],[11,13,120.28,120.44,"er"],[14,17,120.44,120.6,"det"],[18,19,120.6,120.74,"å~0583da7a620a"],[20,22,120.74,121.0,"gå"],[23,26,121.0,121.42,"dit"]]},{"id":23,"start":122.89,"end":125.15,"text":"Det er bare 300 meter.","speaker":"Mann","zh":"只有300米。","words":[[0,3,122.95,123.18,"det"],[4,6,123.18,123.44,"er"],[7,11,123.44,123.76,"bare"],[12,15,123.76,124.56,"300"],[16,21,124.56,125.0,"meter"]]},{"id":24,"start":126.0,"end":127.19,"text":"Takk skal du ha.","speaker":"Biniam","zh":"谢谢你。","words":[[0,4,126.06,126.42,"takk"],[5,9,126.42,126.64,"skal~27c1f26fdfff"],[10,12,126.64,126.78,"du"],[13,15,126.78,127.04,"ha~8e56bc8d3017"]]},{"id":25,"start":128.34,"end":129.3,"text":"Bare hyggelig.","speaker":"Mann","zh":"不客气。","words":[[0,4,128.4,128.76,"bare~44a0f28ba28c"],[5,13,128.76,129.15,"hyggelig~81cac59a5f58"]]},{"id":26,"start":131.09,"end":137.09,"text":"Biniam finner Monolitten og ser mange turister, men han ser ikke Sara.","zh":"比尼亚姆找到了巨石柱，看到很多游客，但没看到萨拉。","words":[[0,6,131.16,131.76,"biniam"],[7,13,131.76,132.16,"finner"],[14,24,132.16,132.97,"monolitten"],[25,27,133.28,133.44,"og"],[28,31,133.44,133.74,"ser"],[32,37,133.74,134.1,"mange"],[38,46,134.1,134.84,"turister"],[48,51,135.34,135.7,"men"],[52,55,135.7,135.96,"han"],[56,59,135.96,136.22,"ser"],[60,64,136.22,136.48,"ikke"],[65,69,136.48,136.94,"sara"]]},{"id":27,"start":137.95,"end":139.1,"text":"Hvor er hun?","zh":"她在哪儿呢？","words":[[0,4,138.01,138.4,"hvor"],[5,7,138.4,138.66,"er"],[8,11,138.66,138.95,"hun"]]},{"id":28,"start":139.96,"end":143.67,"text":"Biniam kan ikke ringe til henne, for mobilen er død.","zh":"比尼亚姆没法给她打电话，因为手机没电了。","words":[[0,6,140.02,140.5,"biniam"],[7,10,140.5,140.72,"kan"],[11,15,140.72,140.94,"ikke"],[16,21,140.94,141.26,"ringe"],[22,25,141.26,141.42,"til"],[26,31,141.42,141.88,"henne"],[33,36,142.22,142.48,"for~1b22712a94b1"],[37,44,142.48,143.04,"mobilen"],[45,47,143.04,143.16,"er"],[48,51,143.16,143.52,"død"]]},{"id":29,"start":145.0,"end":149.9,"text":"«Hva gjorde folk i gamle dager uten mobiltelefon?» tenker han.","zh":"“从前没有手机的时候，人们是怎么办的？”他想。","words":[[1,4,145.06,145.34,"hva"],[5,11,145.34,145.82,"gjorde"],[12,16,145.82,146.18,"folk"],[17,18,146.18,146.26,"i"],[19,24,146.26,146.64,"gamle~d88d08c603b4"],[25,30,146.64,147.1,"dager"],[31,35,147.1,147.5,"uten"],[36,48,147.5,148.66,"mobiltelefon"],[51,57,149.12,149.5,"tenker"],[58,61,149.5,149.75,"han"]]},{"id":30,"start":150.97,"end":154.69,"text":"Han setter seg i trappa foran statuen og venter.","zh":"他在雕像前的台阶上坐下来等着。","words":[[0,3,151.03,151.38,"han"],[4,10,151.38,151.7,"setter"],[11,14,151.7,151.9,"seg"],[15,16,151.9,151.98,"i"],[17,23,151.98,152.46,"trappa"],[24,29,152.46,152.84,"foran~d09b0d7b7ee2"],[30,37,152.84,153.59,"statuen"],[38,40,153.82,153.94,"og"],[41,47,153.94,154.54,"venter"]]},{"id":31,"start":158.48,"end":159.31,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,158.54,159.16,"fakta"]]},{"id":32,"start":160.85,"end":161.7,"text":"Oslo","subheading":true,"zh":"奥斯陆","words":[[0,4,160.91,161.55,"oslo"]]},{"id":33,"start":163.26,"end":166.31,"text":"Oslo er hovedstaden i Norge.","zh":"奥斯陆是挪威的首都。","words":[[0,4,163.32,163.98,"oslo"],[5,7,164.16,164.46,"er"],[8,19,164.46,165.58,"hovedstaden"],[20,21,165.58,165.7,"i"],[22,27,165.7,166.16,"norge~546b56e35dd5"]]},{"id":34,"start":167.68,"end":172.19,"text":"Det er cirka 700 000 innbyggere i byen.","zh":"这座城市约有70万居民。","words":[[0,3,167.74,167.94,"det"],[4,6,167.94,168.2,"er"],[7,12,168.2,168.8,"cirka"],[13,16,169.0,169.9,"700"],[17,20,169.9,170.58,"000~7e10ec26cd77"],[21,31,170.58,171.5,"innbyggere"],[32,33,171.5,171.6,"i"],[34,38,171.6,172.03,"byen"]]},{"id":35,"start":173.59,"end":177.11,"text":"Mange turister besøker Oslo hvert år.","zh":"每年有很多游客来奥斯陆参观。","words":[[0,5,173.65,174.26,"mange"],[6,14,174.26,175.14,"turister"],[15,22,175.14,175.8,"besøker"],[23,27,175.8,176.22,"oslo"],[28,33,176.22,176.64,"hvert"],[34,36,176.64,176.96,"år"]]},{"id":36,"start":178.16,"end":187.59,"text":"De vil se Holmenkollen, Frognerparken, Slottet og Operaen, og mange går på museum.","zh":"他们想看霍尔门科伦、弗罗格纳公园、王宫和歌剧院，很多人还会去参观博物馆。","words":[[0,2,178.22,178.46,"de"],[3,6,178.46,178.76,"vil"],[7,9,178.76,179.12,"se"],[10,22,179.22,180.28,"holmenkollen"],[24,37,180.8,182.02,"frognerparken"],[39,46,182.52,183.24,"slottet"],[47,49,183.74,183.96,"og"],[50,57,183.96,184.68,"operaen"],[59,61,185.5,185.66,"og"],[62,67,185.66,186.34,"mange"],[68,71,186.34,186.62,"går"],[72,74,186.62,186.8,"på~c2594e2175ff"],[75,81,186.8,187.44,"museum"]]},{"id":37,"start":188.63,"end":198.86,"text":"Munchmuseet, Norsk Folkemuseum og Kon-Tiki Museet er eksempler på populære 