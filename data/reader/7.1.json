{"id":"7.1","title":"Unnskyld, hvordan kommer jeg til Frognerparken?","audio":"audio/7.1.mp3","duration":202.74,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.92,"text":"7.1 Unnskyld, hvordan kommer jeg til Frognerparken?","heading":true,"zh":"7.1 请问，去弗罗格纳公园怎么走？","words":[[0,3,0.15,1.12,"7.1"],[4,12,2.16,2.66,"unnskyld"],[14,21,3.26,3.74,"hvordan"],[22,28,3.74,4.1,"kommer~72f4d90b3c99"],[29,32,4.1,4.4,"jeg"],[33,36,4.4,4.68,"til"],[37,50,4.68,5.84,"frognerparken"]]},{"id":1,"start":7.66,"end":12.23,"text":"Biniam tar toget til Oslo og går av på Oslo S.","zh":"比尼亚姆坐火车去奥斯陆，在奥斯陆中央车站下车。","words":[[0,6,7.74,8.24,"biniam"],[7,10,8.24,8.72,"tar"],[11,16,8.78,9.16,"toget"],[17,20,9.3,9.32,"til"],[21,25,9.32,9.76,"oslo"],[26,28,10.42,10.62,"og"],[29,32,10.62,10.9,"går~94cc3e99abf6"],[33,35,10.9,11.1,"av~303b66068598"],[36,38,11.1,11.34,"på"],[39,43,11.34,11.74,"oslo"],[44,45,11.74,12.15,"s"]]},{"id":2,"start":13.27,"end":16.2,"text":"Han skal møte ei venninne i Frognerparken.","zh":"他要在弗罗格纳公园和一位女性朋友见面。","words":[[0,3,13.35,13.56,"han"],[4,8,13.56,13.8,"skal"],[9,13,13.8,14.24,"møte~5c5ca137ac81"],[14,16,14.24,14.44,"ei~47aa2d18e376"],[17,25,14.44,14.92,"venninne"],[26,27,14.92,15.08,"i"],[28,41,15.08,16.12,"frognerparken"]]},{"id":3,"start":17.32,"end":25.08,"text":"Venninna heter Sara, og Biniam gleder seg til å møte henne, men hvor er Frognerparken?","zh":"这位朋友叫萨拉，比尼亚姆很期待见到她，可是弗罗格纳公园在哪儿呢？","words":[[0,8,17.4,17.94,"venninna"],[9,14,17.94,18.46,"heter"],[15,19,18.46,18.78,"sara"],[21,23,19.51,19.83,"og"],[24,30,19.83,20.27,"biniam"],[31,37,20.27,20.87,"gleder"],[38,41,20.87,21.05,"seg"],[42,45,21.05,21.33,"til~f6df3d4686b1"],[46,47,21.33,21.43,"å~0583da7a620a"],[48,52,21.43,21.79,"møte~728dce18f64e"],[53,58,21.79,22.03,"henne"],[60,63,22.56,23.1,"men"],[64,68,23.1,23.46,"hvor"],[69,71,23.46,23.86,"er"],[72,85,23.86,25.0,"frognerparken"]]},{"id":4,"start":26.37,"end":32.62,"text":"Biniam tar fram mobilen og slår på GPS-en for å finne Frognerparken.","zh":"比尼亚姆拿出手机，打开 GPS 来找弗罗格纳公园。","words":[[0,6,26.45,27.12,"biniam"],[7,10,27.3,27.48,"tar~e2a4ad6eb84f"],[11,15,27.48,27.76,"fram"],[16,23,27.76,28.42,"mobilen"],[24,26,28.42,29.18,"og"],[27,31,29.18,29.44,"slår~be04a037a690"],[32,34,29.44,29.8,"på~ac8d79526b63"],[35,41,29.8,30.68,"gps-en"],[42,45,30.68,31.02,"for~caaedf1d2285"],[46,47,31.02,31.12,"å~0583da7a620a"],[48,53,31.12,31.48,"finne"],[54,67,31.48,32.54,"frognerparken"]]},{"id":5,"start":33.75,"end":38.04,"text":"Han går gjennom Oslo S og finner Karl Johans gate.","zh":"他穿过奥斯陆中央车站，找到了卡尔·约翰大街。","words":[[0,3,33.83,34.04,"han"],[4,7,34.04,34.32,"går"],[8,15,34.32,34.84,"gjennom"],[16,20,34.84,35.2,"oslo"],[21,22,35.2,35.56,"s"],[23,25,35.56,36.2,"og"],[26,32,36.2,36.56,"finner"],[33,37,36.56,36.9,"karl"],[38,44,36.9,37.42,"johans"],[45,49,37.42,37.96,"gate"]]},{"id":6,"start":38.48,"end":42.15,"text":"Så går han Karl Johans gate opp til Slottet.","zh":"然后他沿着卡尔·约翰大街一直往上走到王宫。","words":[[0,2,38.64,39.34,"så~4a7ed2bb1489"],[3,6,39.34,39.7,"går"],[7,10,39.7,39.96,"han"],[11,15,39.96,40.26,"karl"],[16,22,40.26,40.68,"johans"],[23,27,40.68,41.02,"gate"],[28,31,41.02,41.34,"opp"],[32,35,41.34,41.54,"til"],[36,43,41.54,42.07,"slottet"]]},{"id":7,"start":43.66,"end":46.37,"text":"Plutselig er mobilen tom for batteri.","zh":"突然，手机没电了。","words":[[0,9,43.73,44.39,"plutselig"],[10,12,44.39,44.55,"er"],[13,20,44.55,45.11,"mobilen"],[21,24,45.11,45.33,"tom"],[25,28,45.33,45.61,"for~e38bd984bd19"],[29,36,45.61,46.29,"batteri"]]},{"id":8,"start":47.15,"end":48.71,"text":"Hva skal han gjøre nå?","zh":"他现在该怎么办？","words":[[0,3,47.23,47.45,"hva"],[4,8,47.45,47.67,"skal"],[9,12,47.67,47.89,"han"],[13,18,47.89,48.11,"gjøre"],[19,21,48.11,48.63,"nå~d531d47a7712"]]},{"id":9,"start":50.36,"end":55.0,"text":"Biniam går litt fram og tilbake, men han finner ikke veien.","zh":"比尼亚姆来回走了一会儿，可还是找不到路。","words":[[0,6,50.44,50.87,"biniam"],[7,10,50.87,51.17,"går"],[11,15,51.17,51.37,"litt~54360be2a478"],[16,20,51.37,51.75,"fram"],[21,23,51.75,51.91,"og"],[24,31,51.95,52.41,"tilbake"],[33,36,53.33,53.49,"men"],[37,40,53.49,53.73,"han"],[41,47,53.73,54.01,"finner"],[48,52,54.01,54.21,"ikke"],[53,58,54.21,54.92,"veien"]]},{"id":10,"start":55.57,"end":57.42,"text":"Han spør ei dame om hjelp.","zh":"他向一位女士求助。","words":[[0,3,55.65,55.85,"han"],[4,8,55.85,56.11,"spør"],[9,11,56.11,56.33,"ei~47aa2d18e376"],[12,16,56.33,56.59,"dame"],[17,19,56.59,56.81,"om~348a8c9ff21e"],[20,25,56.81,57.34,"hjelp"]]},{"id":11,"start":59.06,"end":62.19,"text":"Unnskyld, hvordan kommer jeg til Frognerparken?","speaker":"Biniam","zh":"请问，去弗罗格纳公园怎么走？","words":[[0,8,59.14,59.56,"unnskyld"],[10,17,59.92,60.32,"hvordan"],[18,24,60.32,60.6,"kommer~72f4d90b3c99"],[25,28,60.6,60.78,"jeg"],[29,32,60.78,60.98,"til"],[33,46,60.98,62.11,"frognerparken"]]},{"id":12,"start":62.63,"end":71.38,"text":"Trikk nummer 12 går dit. Du kan gå til venstre her og ta trikken der borte på den andre siden av gata.","speaker":"Dame","zh":"12路有轨电车去那儿。你可以在这儿往左走，到街对面那边去坐电车。","words":[[0,5,62.71,63.33,"trikk"],[6,12,63.33,63.87,"nummer"],[13,15,63.87,64.27,"12"],[16,19,64.27,64.59,"går~f010b28fdfbc"],[20,23,64.59,64.91,"dit"],[25,27,65.79,65.93,"du"],[28,31,65.93,66.17,"kan"],[32,34,66.17,66.39,"gå"],[35,38,66.39,66.59,"til"],[39,46,66.59,67.09,"venstre"],[47,50,67.09,67.43,"her"],[51,53,67.43,68.05,"og"],[54,56,68.05,68.25,"ta"],[57,64,68.25,68.79,"trikken"],[65,68,68.79,68.93,"der"],[69,74,68.93,69.37,"borte~cb7d143048ae"],[75,77,69.37,69.63,"på"],[78,81,69.63,69.85,"den~d13fe2f99333"],[82,87,69.85,70.31,"andre~9477191cb4dd"],[88,93,70.31,70.65,"siden~9a3d2d89a980"],[94,96,70.65,70.81,"av"],[97,101,70.81,71.3,"gata"]]},{"id":13,"start":72.04,"end":75.44,"text":"Hvor lang tid tar det til Frognerparken med trikk?","speaker":"Biniam","zh":"坐电车去弗罗格纳公园要多长时间？","words":[[0,4,72.12,72.42,"hvor~8598699b9b8d"],[5,9,72.42,72.64,"lang"],[10,13,72.64,73.0,"tid"],[14,17,73.0,73.42,"tar~376c12518b59"],[18,21,73.42,73.56,"det"],[22,25,73.56,73.82,"til"],[26,39,73.82,74.66,"frognerparken"],[40,43,74.66,74.8,"med~f2bae197f6fb"],[44,49,74.8,75.36,"trikk"]]},{"id":14,"start":76.02,"end":78.14,"text":"Det tar cirka 10 minutter.","speaker":"Dame","zh":"大约需要 10 分钟。","words":[[0,3,76.09,76.2,"det"],[4,7,76.2,76.48,"tar~376c12518b59"],[8,13,76.48,77.0,"cirka"],[14,16,77.0,77.4,"10"],[17,25,77.4,78.06,"minutter"]]},{"id":15,"start":79.05,"end":80.11,"text":"Takk for hjelpen!","speaker":"Biniam","zh":"谢谢你的帮助！","words":[[0,4,79.13,79.38,"takk"],[5,8,79.38,79.54,"for~713e6b1d2094"],[9,16,79.54,80.03,"hjelpen"]]},{"id":16,"start":82.46,"end":86.12,"text":"Biniam tar trikken og går av ved Frognerparken.","zh":"比尼亚姆坐上电车，在弗罗格纳公园下了车。","words":[[0,6,82.54,83.25,"biniam"],[7,10,83.25,83.35,"tar"],[11,18,83.35,83.95,"trikken"],[19,21,83.95,84.31,"og"],[22,25,84.31,84.57,"går~94cc3e99abf6"],[26,28,84.57,84.81,"av~303b66068598"],[29,32,84.81,85.03,"ved"],[33,46,85.03,86.04,"frognerparken"]]},{"id":17,"start":87.39,"end":89.39,"text":"Hvordan skal han finne Sara?","zh":"他要怎么找到萨拉呢？","words":[[0,7,87.47,87.77,"hvordan"],[8,12,87.77,88.09,"skal"],[13,16,88.09,88.29,"han"],[17,22,88.29,88.69,"finne"],[23,27,88.69,89.31,"sara"]]},{"id":18,"start":90.37,"end":95.73,"text":"De skal møtes ved Monolitten, en stor statue, men hvor er den?","zh":"他们约好在巨石柱见面——那是一座很大的雕像，可它在哪儿呢？","words":[[0,2,90.45,90.6,"de"],[3,7,90.6,90.76,"skal"],[8,13,90.76,91.32,"møtes"],[14,17,91.32,91.5,"ved"],[18,28,91.5,92.12,"monolitten"],[30,32,92.66,92.86,"en~a939a9e56dc5"],[33,37,92.86,93.22,"stor"],[38,44,93.22,93.68,"statue"],[46,49,94.4,94.58,"men"],[50,54,94.58,94.86,"hvor"],[55,57,94.86,95.18,"er"],[58,61,95.18,95.65,"den"]]},{"id":19,"start":96.58,"end":98.4,"text":"Han må spørre en gang til.","zh":"他得再问一次。","words":[[0,3,96.66,96.86,"han"],[4,6,96.86,97.04,"må"],[7,13,97.04,97.48,"spørre"],[14,16,97.48,97.66,"en~a939a9e56dc5"],[17,21,97.66,97.9,"gang"],[22,25,97.9,98.32,"til~81ba4d08328a"]]},{"id":20,"start":100.34,"end":103.82,"text":"Unnskyld, hvor er Monolitten?","speaker":"Biniam","zh":"请问，巨石柱在哪儿？","words":[[0,8,100.42,100.89,"unnskyld"],[10,14,101.65,102.05,"hvor"],[15,17,102.05,102.53,"er"],[18,28,102.53,103.74,"monolitten"]]},{"id":21,"start":105.53,"end":117.8,"text":"Du går til høyre og over broen der. Så går du rett fram, og der ser du en veldig høy statue med mange mennesker. Det er Monolitten.","speaker":"Mann","zh":"你往右走，过那边的桥。然后一直往前走，在那儿你会看到一座很高的雕像，上面雕刻着许多人物。那就是巨石柱。","words":[[0,2,105.61,105.97,"du"],[3,6,105.97,106.29,"går"],[7,10,106.29,106.49,"til"],[11,16,106.49,107.03,"høyre"],[17,19,107.03,107.53,"og"],[20,24,107.53,107.87,"over"],[25,30,107.87,108.35,"broen"],[31,34,108.35,108.57,"der"],[36,38,109.68,109.96,"så~4a7ed2bb1489"],[39,42,109.96,110.16,"går"],[43,45,110.16,110.28,"du"],[46,50,110.28,110.62,"rett~7d7de36817bf"],[51,55,110.62,110.8,"fram"],[57,59,111.46,111.54,"og"],[60,63,111.54,111.88,"der"],[64,67,111.88,112.22,"ser"],[68,70,112.22,112.36,"du"],[71,73,112.36,112.46,"en~a939a9e56dc5"],[74,80,112.46,113.04,"veldig"],[81,84,113.04,113.22,"høy"],[85,91,113.22,113.92,"statue"],[92,95,113.92,114.3,"med~429c44429983"],[96,101,114.3,114.78,"mange"],[102,111,114.78,115.36,"mennesker"],[113,116,116.12,116.48,"det"],[117,119,116.48,116.9,"er"],[120,130,116.9,117.72,"monolitten"]]},{"id":22,"start":119.23,"end":121.51,"text":"Hvor langt er det å gå dit?","speaker":"Biniam","zh":"走到那儿有多远？","words":[[0,4,119.31,119.69,"hvor~8598699b9b8d"],[5,10,119.69,120.17,"langt~d19f6c81bf73"],[11,13,120.17,120.43,"er"],[14,17,120.43,120.55,"det"],[18,19,120.55,120.69,"å~0583da7a620a"],[20,22,120.69,120.91,"gå"],[23,26,120.91,121.43,"dit"]]},{"id":23,"start":122.85,"end":125.09,"text":"Det er bare 300 meter.","speaker":"Mann","zh":"只有300米。","words":[[0,3,122.93,123.12,"det"],[4,6,123.12,123.36,"er"],[7,11,123.36,123.64,"bare"],[12,15,123.64,124.34,"300"],[16,21,124.34,125.01,"meter"]]},{"id":24,"start":125.96,"end":127.13,"text":"Takk skal du ha.","speaker":"Biniam","zh":"谢谢你。","words":[[0,4,126.04,126.35,"takk"],[5,9,126.35,126.59,"skal~27c1f26fdfff"],[10,12,126.59,126.73,"du"],[13,15,126.73,127.05,"ha~8e56bc8d3017"]]},{"id":25,"start":128.3,"end":129.24,"text":"Bare hyggelig.","speaker":"Mann","zh":"不客气。","words":[[0,4,128.38,128.69,"bare~44a0f28ba28c"],[5,13,128.69,129.16,"hyggelig~81cac59a5f58"]]},{"id":26,"start":131.08,"end":137.04,"text":"Biniam finner Monolitten og ser mange turister, men han ser ikke Sara.","zh":"比尼亚姆找到了巨石柱，看到很多游客，但没看到萨拉。","words":[[0,6,131.16,131.58,"biniam"],[7,13,131.58,132.06,"finner"],[14,24,132.06,132.68,"monolitten"],[25,27,132.68,133.38,"og"],[28,31,133.38,133.6,"ser"],[32,37,133.6,134.02,"mange"],[38,46,134.08,134.58,"turister"],[48,51,135.2,135.56,"men"],[52,55,135.56,135.86,"han"],[56,59,135.86,136.14,"ser"],[60,64,136.14,136.38,"ikke"],[65,69,136.38,136.96,"sara"]]},{"id":27,"start":137.94,"end":139.03,"text":"Hvor er hun?","zh":"她在哪儿呢？","words":[[0,4,138.02,138.23,"hvor"],[5,7,138.23,138.61,"er"],[8,11,138.61,138.95,"hun"]]},{"id":28,"start":139.94,"end":143.61,"text":"Biniam kan ikke ringe til henne, for mobilen er død.","zh":"比尼亚姆没法给她打电话，因为手机没电了。","words":[[0,6,140.02,140.34,"biniam"],[7,10,140.34,140.62,"kan"],[11,15,140.62,140.84,"ikke"],[16,21,140.84,141.22,"ringe"],[22,25,141.22,141.36,"til"],[26,31,141.36,141.64,"henne"],[33,36,142.2,142.34,"for~1b22712a94b1"],[37,44,142.34,142.98,"mobilen"],[45,47,142.98,143.1,"er"],[48,51,143.1,143.53,"død"]]},{"id":29,"start":144.97,"end":151.18,"text":"«Hva gjorde folk i gamle dager uten mobiltelefon?» tenker han.","zh":"“从前没有手机的时候，人们是怎么办的？”他想。","words":[[1,4,145.05,145.24,"hva"],[5,11,145.24,145.72,"gjorde"],[12,16,145.72,146.02,"folk"],[17,18,146.02,146.22,"i"],[19,24,146.22,146.58,"gamle~d88d08c603b4"],[25,30,146.58,146.94,"dager"],[31,35,146.94,147.42,"uten"],[36,48,147.42,148.4,"mobiltelefon"],[51,57,148.92,149.44,"tenker"],[58,61,150.96,151.18,"han"]]},{"id":30,"start":151.35,"end":154.64,"text":"Han setter seg i trappa foran statuen og venter.","zh":"他在雕像前的台阶上坐下来等着。","words":[[0,3,151.35,151.35,"han"],[4,10,151.35,151.64,"setter"],[11,14,151.64,151.78,"seg"],[15,16,151.78,151.96,"i"],[17,23,151.96,152.32,"trappa"],[24,29,152.32,152.74,"foran~d09b0d7b7ee2"],[30,37,152.74,153.34,"statuen"],[38,40,153.34,153.88,"og"],[41,47,153.88,154.56,"venter"]]},{"id":31,"start":158.46,"end":159.21,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,158.54,159.13,"fakta"]]},{"id":32,"start":160.83,"end":161.61,"text":"Oslo","subheading":true,"zh":"奥斯陆","words":[[0,4,160.91,161.53,"oslo"]]},{"id":33,"start":161.77,"end":166.24,"text":"Oslo er hovedstaden i Norge.","zh":"奥斯陆是挪威的首都。","words":[[0,4,162.66,163.8,"oslo"],[5,7,163.8,164.34,"er"],[8,19,164.34,165.18,"hovedstaden"],[20,21,165.18,165.66,"i"],[22,27,165.66,166.16,"norge~546b56e35dd5"]]},{"id":34,"start":167.1,"end":172.11,"text":"Det er cirka 700 000 innbyggere i byen.","zh":"这座城市约有70万居民。","words":[[0,3,167.38,167.86,"det"],[4,6,167.86,168.1,"er"],[7,12,168.1,168.66,"cirka"],[13,16,168.66,170.48,"700"],[17,20,168.66,170.48,"000~7e10ec26cd77"],[21,31,170.48,171.22,"innbyggere"],[32,33,171.22,171.56,"i"],[34,38,171.56,172.03,"byen"]]},{"id":35,"start":173.56,"end":177.03,"text":"Mange turister besøker Oslo hvert år.","zh":"每年有很多游客来奥斯陆参观。","words":[[0,5,173.63,174.2,"mange"],[6,14,174.2,174.82,"turister"],[15,22,174.82,175.66,"besøker"],[23,27,175.66,176.14,"oslo"],[28,33,176.14,176.46,"hvert"],[34,36,176.46,176.96,"år"]]},{"id":36,"start":178.12,"end":187.54,"text":"De vil se Holmenkollen, Frognerparken, Slottet og Operaen, og mange går på museum.","zh":"他们想看霍尔门科伦、弗罗格纳公园、王宫和歌剧院，很多人还会去参观博物馆。","words":[[0,2,178.2,178.42,"de"],[3,6,178.42,178.64,"vil"],[7,9,178.64,179.0,"se"],[10,22,179.0,179.96,"holmenkollen"],[24,37,180.68,181.86,"frognerparken"],[39,46,182.4,183.06,"slottet"],[47,49,183.06,183.84,"og"],[50,57,183.84,184.54,"operaen"],[59,61,185.22,185.6,"og"],[62,67,185.6,185.96,"mange"],[68,71,185.96,186.5,"går"],[72,74,186.5,186.72,"på~c2594e2175ff"],[75,81,186.72,187.46,"museum"]]},{"id":37,"start":188.61,"end":198.81,"text":"Munchmuseet, Norsk Folkemuseum og Kon-Tiki Museet er eksempler på populære museer i Oslo.","zh":"蒙克博物馆、挪威民俗博物馆和康提基号博物馆都是奥斯陆热门博物馆的例子。","words":[[0,11,188.69,189.98,"munchmuseet"],[13,18,190.52,191.0,"norsk~300c0d0c4f59"],[19,30,191.0,191.9,"folkemuseum"],[31,33,192.0,193.2,"og"],[34,42,193.2,194.3,"kon-tiki"],[43,49,194.3,194.88,"museet"],[50,52,194.88,195.48,"er"],[53,62,195.48,196.16,"eksempler"],[63,65,196.16,196.52,"på~eaa67e22d05b"],[66,74,196.52,197.34,"populære"],[75,81,197.34,197.98,"museer"],[82,83,197.98,198.24,"i"],[84,88,198.24,198.73,"oslo"]]}],"lexicon":{"000":{"lemma":"tusen","zh":"千（大数字的千位分组，与前面的数字合读）","pos":"数词","ref":null,"clip":null,"kind":"number","form":""},"10":{"lemma":"10","zh":"数字 10","pos":"数词","ref":"basics:numbers:ti","clip":null,"kind":"number"},"12":{"lemma":"12","zh":"数字 12","pos":"数词","ref":"basics:numbers:tolv","clip":null,"kind":"number"},"300":{"lemma":"300","zh":"数字 300","pos":"数词","ref":null,"clip":null,"kind":"number"},"7.1":{"lemma":"7.1","zh":"第 7.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"700":{"lemma":"700","zh":"数字 700","pos":"数词","ref":null,"clip":null,"kind":"number"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre","clip":"pronunciation/bd01b0b648c2c64eb1bd.mp3","ambiguous":true,"candidates":[{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre"},{"lemma":"andre","zh":"第二","pos":"序数词","ref":"basics:ordinals:andre"},{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式"}]},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"batteri":{"lemma":"batteri","zh":"电池","pos":"名词","ref":"7-017","clip":"pronunciation/d8cea1899fa9efa6b14c.mp3"},"besøker":{"lemma":"besøke","zh":"拜访；看望（besøke 的现在时）","pos":"动词","ref":"3-023","form":"现在时","clip":"pronuncia