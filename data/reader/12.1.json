{"id":"12.1","title":"Hvordan føler du deg?","audio":"audio/12.1.mp3","duration":203.95,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.11,"text":"12.1 Hvordan føler du deg?","heading":true,"zh":"12.1 你感觉怎么样？","words":[[0,4,0.15,1.0,"12.1"],[5,12,2.62,3.12,"hvordan"],[13,18,3.12,3.6,"føler"],[19,21,3.6,3.74,"du"],[22,25,3.74,4.03,"deg"]]},{"id":1,"start":6.36,"end":7.54,"text":"Er du syk?","zh":"你生病了吗？","words":[[0,2,6.42,6.62,"er"],[3,5,6.62,6.92,"du"],[6,9,6.92,7.39,"syk"]]},{"id":2,"start":8.56,"end":9.63,"text":"Jeg tror det.","zh":"我想是的。","words":[[0,3,8.62,8.9,"jeg"],[4,8,8.9,9.28,"tror"],[9,12,9.28,9.48,"det"]]},{"id":3,"start":10.03,"end":11.74,"text":"Jeg føler meg dårlig.","zh":"我感觉不舒服。","words":[[0,3,10.09,10.32,"jeg"],[4,9,10.32,10.66,"føler"],[10,13,10.66,10.96,"meg"],[14,20,10.96,11.59,"dårlig~fbe44d3d4956"]]},{"id":4,"start":13.01,"end":15.44,"text":"Jeg synes at du ser blek ut.","zh":"我觉得你看起来脸色苍白。","words":[[0,3,13.07,13.34,"jeg"],[4,9,13.34,13.84,"synes"],[10,12,13.84,13.98,"at"],[13,15,13.98,14.24,"du"],[16,19,14.24,14.56,"ser~926a4d79c96e"],[20,24,14.56,14.96,"blek"],[25,27,14.96,15.29,"ut~5961721b496c"]]},{"id":5,"start":16.7,"end":18.63,"text":"Jeg tror at jeg har feber.","zh":"我觉得我发烧了。","words":[[0,3,16.75,17.22,"jeg"],[4,8,17.22,17.48,"tror"],[9,11,17.48,17.6,"at"],[12,15,17.6,17.72,"jeg"],[16,19,17.72,17.9,"har"],[20,25,17.9,18.48,"feber"]]},{"id":6,"start":19.11,"end":23.81,"text":"Jeg synes at det er så varmt her, og jeg har vondt i hele kroppen.","zh":"我觉得这里好热，而且我浑身疼。","words":[[0,3,19.16,19.36,"jeg"],[4,9,19.36,19.6,"synes"],[10,12,19.6,19.7,"at"],[13,16,19.7,19.86,"det"],[17,19,19.86,20.1,"er"],[20,22,20.1,20.28,"så~b10903249852"],[23,28,20.28,20.7,"varmt"],[29,32,20.7,21.09,"her"],[34,36,21.68,21.78,"og"],[37,40,21.78,21.92,"jeg"],[41,44,21.92,22.08,"har"],[45,50,22.08,22.54,"vondt"],[51,52,22.54,22.74,"i"],[53,57,22.74,23.0,"hele"],[58,65,23.0,23.72,"kroppen"]]},{"id":7,"start":24.93,"end":26.99,"text":"Du har kanskje influensa.","zh":"你可能得了流感。","words":[[0,2,24.98,25.28,"du"],[3,6,25.28,25.52,"har"],[7,14,25.52,26.02,"kanskje"],[15,24,26.02,26.84,"influensa"]]},{"id":8,"start":27.64,"end":29.66,"text":"Du bør gå hjem og legge deg.","zh":"你应该回家躺下休息。","words":[[0,2,27.7,28.06,"du"],[3,6,28.06,28.3,"bør"],[7,9,28.3,28.52,"gå"],[10,14,28.52,28.88,"hjem~3f5fbf6a493e"],[15,17,28.88,29.02,"og"],[18,23,29.02,29.28,"legge~2d39b308954a"],[24,27,29.28,29.51,"deg"]]},{"id":9,"start":30.46,"end":31.5,"text":"God bedring!","zh":"早日康复！","words":[[0,3,30.52,30.8,"god"],[4,11,30.8,31.35,"bedring"]]},{"id":10,"start":35.2,"end":36.32,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,35.26,36.17,"sammendrag"]]},{"id":11,"start":37.7,"end":39.73,"text":"Han spør om hun er syk.","zh":"他问她是不是病了。","words":[[0,3,37.76,38.14,"han"],[4,8,38.14,38.56,"spør"],[9,11,38.56,38.74,"om~744a29d3d900"],[12,15,38.74,38.96,"hun"],[16,18,38.96,39.12,"er"],[19,22,39.12,39.58,"syk"]]},{"id":12,"start":40.85,"end":42.7,"text":"Hun sier at hun tror det.","zh":"她说她觉得是。","words":[[0,3,40.91,41.28,"hun"],[4,8,41.28,41.76,"sier"],[9,11,41.76,41.9,"at"],[12,15,41.9,42.06,"hun"],[16,20,42.06,42.34,"tror"],[21,24,42.34,42.55,"det"]]},{"id":13,"start":43.98,"end":46.46,"text":"Han sier at hun ser blek ut.","zh":"他说她看起来脸色苍白。","words":[[0,3,44.05,44.4,"han"],[4,8,44.4,44.92,"sier"],[9,11,44.92,45.1,"at"],[12,15,45.1,45.3,"hun"],[16,19,45.3,45.6,"ser~926a4d79c96e"],[20,24,45.6,46.0,"blek"],[25,27,46.0,46.31,"ut~5961721b496c"]]},{"id":14,"start":47.81,"end":52.75,"text":"Hun sier at det er varmt, og at hun har vondt i hele kroppen.","zh":"她说很热，而且她浑身疼。","words":[[0,3,47.88,48.22,"hun"],[4,8,48.22,48.7,"sier"],[9,11,48.7,48.9,"at"],[12,15,48.9,49.04,"det"],[16,18,49.04,49.2,"er"],[19,24,49.2,49.85,"varmt"],[26,28,50.38,50.56,"og"],[29,31,50.56,50.72,"at"],[32,35,50.72,50.88,"hun"],[36,39,50.88,51.1,"har"],[40,45,51.1,51.6,"vondt"],[46,47,51.6,51.74,"i"],[48,52,51.74,52.12,"hele"],[53,60,52.12,52.6,"kroppen"]]},{"id":15,"start":54.13,"end":57.87,"text":"Han sier at hun bør gå hjem og legge seg.","zh":"他说她应该回家躺下休息。","words":[[0,3,54.2,54.58,"han"],[4,8,54.58,55.02,"sier"],[9,11,55.02,55.22,"at"],[12,15,55.22,55.5,"hun"],[16,19,55.5,55.74,"bør"],[20,22,55.74,55.98,"gå"],[23,27,55.98,56.4,"hjem~3f5fbf6a493e"],[28,30,56.92,57.08,"og"],[31,36,57.08,57.4,"legge~2d39b308954a"],[37,40,57.4,57.72,"seg"]]},{"id":16,"start":61.01,"end":62.23,"text":"Hos legen","zh":"看医生","words":[[0,3,61.07,61.48,"hos"],[4,9,61.48,62.08,"legen"]]},{"id":17,"start":63.34,"end":66.34,"text":"En liten gutt med mamma hos mannlig lege.","zh":"一个小男孩和妈妈在一位男医生那里看病。","words":[[0,2,63.41,63.72,"en~a939a9e56dc5"],[3,8,63.72,64.12,"liten"],[9,13,64.12,64.44,"gutt"],[14,17,64.44,64.64,"med"],[18,23,64.64,65.04,"mamma"],[24,27,65.04,65.36,"hos"],[28,35,65.36,65.78,"mannlig"],[36,40,65.78,66.19,"lege"]]},{"id":18,"start":68.42,"end":70.02,"text":"Har du vondt i halsen?","speaker":"Lege","zh":"你喉咙疼吗？","words":[[0,3,68.48,68.68,"har"],[4,6,68.68,68.86,"du"],[7,12,68.86,69.22,"vondt"],[13,14,69.22,69.32,"i"],[15,21,69.32,69.87,"halsen"]]},{"id":19,"start":70.75,"end":72.63,"text":"Ja, veldig vondt.","speaker":"Gutt","zh":"是的，很疼。","words":[[0,2,70.81,71.22,"ja"],[4,10,71.56,72.02,"veldig"],[11,16,72.02,72.48,"vondt"]]},{"id":20,"start":73.67,"end":74.88,"text":"Hoster du mye?","speaker":"Lege","zh":"你咳嗽得厉害吗？","words":[[0,6,73.73,74.22,"hoster"],[7,9,74.22,74.36,"du"],[10,13,74.36,74.73,"mye~933c5a923198"]]},{"id":21,"start":75.57,"end":78.72,"text":"Ja, veldig mye. Har jeg feber?","speaker":"Gutt","zh":"是的，咳得很厉害。我发烧了吗？","words":[[0,2,75.63,76.06,"ja"],[4,10,76.4,76.84,"veldig"],[11,14,76.84,77.3,"mye~933c5a923198"],[16,19,77.68,77.84,"har"],[20,23,77.84,78.08,"jeg"],[24,29,78.08,78.57,"feber"]]},{"id":22,"start":79.31,"end":81.33,"text":"Ja, du er litt varm.","speaker":"Lege","zh":"是的，你有点发热。","words":[[0,2,79.37,79.76,"ja"],[4,6,80.16,80.32,"du"],[7,9,80.32,80.48,"er"],[10,14,80.48,80.72,"litt~54360be2a478"],[15,19,80.72,81.18,"varm"]]},{"id":23,"start":85.52,"end":86.65,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,85.58,86.5,"sammendrag"]]},{"id":24,"start":88.09,"end":90.97,"text":"Legen spør om gutten har vondt i halsen.","zh":"医生问男孩喉咙疼不疼。","words":[[0,5,88.16,88.8,"legen"],[6,10,88.8,89.1,"spør"],[11,13,89.1,89.34,"om~744a29d3d900"],[14,20,89.34,89.74,"gutten"],[21,24,89.74,89.92,"har"],[25,30,89.92,90.22,"vondt"],[31,32,90.22,90.3,"i"],[33,39,90.3,90.82,"halsen"]]},{"id":25,"start":91.73,"end":96.7,"text":"Gutten sier at han har veldig vondt og spør om han har feber.","zh":"男孩说他很疼，并问自己是不是发烧了。","words":[[0,6,91.8,92.44,"gutten"],[7,11,92.44,92.82,"sier"],[12,14,92.82,93.02,"at"],[15,18,93.02,93.24,"han"],[19,22,93.24,93.52,"har"],[23,29,93.52,93.9,"veldig"],[30,35,93.9,94.46,"vondt"],[36,38,94.8,95.08,"og"],[39,43,95.18,95.48,"spør"],[44,46,95.48,95.66,"om~744a29d3d900"],[47,50,95.66,95.86,"han"],[51,54,95.86,96.06,"har"],[55,60,96.06,96.55,"feber"]]},{"id":26,"start":97.66,"end":100.12,"text":"Legen sier at han er litt varm.","zh":"医生说他有点发热。","words":[[0,5,97.72,98.32,"legen"],[6,10,98.32,98.68,"sier"],[11,13,98.68,98.9,"at"],[14,17,98.9,99.18,"han"],[18,20,99.18,99.32,"er"],[21,25,99.32,99.52,"litt~54360be2a478"],[26,30,99.52,99.97,"varm"]]},{"id":27,"start":101.04,"end":106.01,"text":"Gutten spør om han må på sykehus, men legen sier at han kan dra hjem.","zh":"男孩问他是否得去医院，但医生说他可以回家。","words":[[0,6,101.1,101.54,"gutten"],[7,11,101.54,101.82,"spør"],[12,14,101.82,101.94,"om~744a29d3d900"],[15,18,101.94,102.1,"han"],[19,21,102.1,102.28,"må"],[22,24,102.28,102.46,"på~b883cf7b2b36"],[25,32,102.46,103.36,"sykehus"],[34,37,103.66,103.94,"men"],[38,43,103.94,104.42,"legen"],[44,48,104.42,104.74,"sier"],[49,51,104.74,104.88,"at"],[52,55,104.88,105.12,"han"],[56,59,105.12,105.32,"kan"],[60,63,105.32,105.56,"dra"],[64,68,105.56,105.86,"hjem~3f5fbf6a493e"]]},{"id":28,"start":109.39,"end":110.34,"text":"Kroppen","zh":"身体","words":[[0,7,109.45,110.21,"kroppen"]]},{"id":29,"start":112.0,"end":112.94,"text":"Hodet","zh":"头","words":[[0,5,112.06,112.94,"hodet"]]},{"id":30,"start":114.11,"end":115.04,"text":"nakken","zh":"后颈","words":[[0,6,114.17,114.89,"nakken"]]},{"id":31,"start":116.31,"end":117.31,"text":"skulderen","zh":"肩膀","words":[[0,9,116.37,117.16,"skulderen"]]},{"id":32,"start":118.83,"end":119.72,"text":"ryggen","zh":"背","words":[[0,6,118.89,119.57,"ryggen"]]},{"id":33,"start":121.08,"end":121.97,"text":"albuen","zh":"胳膊肘","words":[[0,6,121.14,121.82,"albuen"]]},{"id":34,"start":123.44,"end":124.49,"text":"brystet","zh":"胸部","words":[[0,7,123.5,124.34,"brystet"]]},{"id":35,"start":126.17,"end":127.24,"text":"håndleddet","zh":"手腕","words":[[0,10,126.23,127.09,"håndleddet"]]},{"id":36,"start":128.78,"end":129.72,"text":"magen","zh":"肚子","words":[[0,5,128.84,129.56,"magen"]]},{"id":37,"start":131.5,"end":134.3,"text":"Rumpa eller baken,","zh":"屁股或臀部，","words":[[0,5,131.56,132.38,"rumpa"],[6,11,132.84,133.42,"eller"],[12,17,133.52,134.15,"baken"]]},{"id":38,"start":136.11,"end":136.94,"text":"beinet","zh":"腿","words":[[0,6,136.17,136.79,"beinet"]]},{"id":39,"start":138.66,"end":139.62,"text":"foten","zh":"脚","words":[[0,5,138.72,139.47,"foten"]]},{"id":40,"start":141.59,"end":142.58,"text":"halsen","zh":"脖子；喉咙","words":[[0,6,141.65,142.43,"halsen~7e101eb5f0fc"]]},{"id":41,"start":144.2,"end":145.14,"text":"armen","zh":"手臂","words":[[0,5,144.26,144.99,"armen"]]},{"id":42,"start":146.78,"end":147.64,"text":"hånda","zh":"手","words":[[0,5,146.84,147.49,"hånda"]]},{"id":43,"start":149.22,"end":150.24,"text":"fingeren","zh":"手指","words":[[0,8,149.28,150.09,"fingeren"]]},{"id":44,"start":151.81,"end":152.62,"text":"kneet","zh":"膝盖","words":[[0,5,151.87,152.47,"kneet"]]},{"id":45,"start":156.14,"end":157.13,"text":"Ansiktet","zh":"脸","words":[[0,8,156.2,156.98,"ansiktet"]]},{"id":46,"start":159.0,"end":159.74,"text":"øret","zh":"耳朵","words":[[0,4,159.06,159.59,"øret"]]},{"id":47,"start":161.5,"end":162.31,"text":"kinnet","zh":"脸颊","words":[[0,6,161.