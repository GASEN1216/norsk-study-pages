{"id":"12.1","title":"Hvordan føler du deg?","audio":"audio/12.1.mp3","duration":203.95,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.11,"text":"12.1 Hvordan føler du deg?","heading":true,"zh":"12.1 你感觉怎么样？","words":[[0,4,0.15,1.0,"12.1"],[5,12,2.62,3.12,"hvordan"],[13,18,3.12,3.6,"føler"],[19,21,3.6,3.74,"du"],[22,25,3.74,4.03,"deg"]]},{"id":1,"start":6.32,"end":7.39,"text":"Er du syk?","zh":"你生病了吗？","words":[[0,2,6.4,6.58,"er"],[3,5,6.58,6.8,"du"],[6,9,6.8,7.31,"syk"]]},{"id":2,"start":8.57,"end":9.57,"text":"Jeg tror det.","zh":"我想是的。","words":[[0,3,8.65,8.84,"jeg"],[4,8,8.84,9.2,"tror"],[9,12,9.2,9.49,"det"]]},{"id":3,"start":10.0,"end":11.69,"text":"Jeg føler meg dårlig.","zh":"我感觉不舒服。","words":[[0,3,10.08,10.22,"jeg"],[4,9,10.22,10.62,"føler"],[10,13,10.62,10.82,"meg"],[14,20,10.82,11.61,"dårlig~fbe44d3d4956"]]},{"id":4,"start":12.98,"end":15.36,"text":"Jeg synes at du ser blek ut.","zh":"我觉得你看起来脸色苍白。","words":[[0,3,13.06,13.25,"jeg"],[4,9,13.25,13.73,"synes"],[10,12,13.73,13.93,"at"],[13,15,13.93,14.11,"du"],[16,19,14.11,14.41,"ser~926a4d79c96e"],[20,24,14.41,14.91,"blek"],[25,27,14.91,15.28,"ut~5961721b496c"]]},{"id":5,"start":16.66,"end":18.58,"text":"Jeg tror at jeg har feber.","zh":"我觉得我发烧了。","words":[[0,3,16.74,16.93,"jeg"],[4,8,16.93,17.35,"tror"],[9,11,17.35,17.59,"at"],[12,15,17.59,17.71,"jeg"],[16,19,17.71,17.81,"har"],[20,25,17.81,18.5,"feber"]]},{"id":6,"start":19.07,"end":23.79,"text":"Jeg synes at det er så varmt her, og jeg har vondt i hele kroppen.","zh":"我觉得这里好热，而且我浑身疼。","words":[[0,3,19.15,19.31,"jeg"],[4,9,19.31,19.49,"synes"],[10,12,19.49,19.69,"at"],[13,16,19.69,19.79,"det"],[17,19,19.79,19.99,"er"],[20,22,19.99,20.17,"så~b10903249852"],[23,28,20.17,20.57,"varmt"],[29,32,20.57,20.87,"her"],[34,36,21.51,21.77,"og"],[37,40,21.77,21.89,"jeg"],[41,44,21.89,21.99,"har"],[45,50,21.99,22.47,"vondt"],[51,52,22.47,22.65,"i"],[53,57,22.65,22.91,"hele"],[58,65,22.91,23.71,"kroppen"]]},{"id":7,"start":24.89,"end":26.96,"text":"Du har kanskje influensa.","zh":"你可能得了流感。","words":[[0,2,24.97,25.22,"du"],[3,6,25.22,25.42,"har"],[7,14,25.42,25.92,"kanskje"],[15,24,25.92,26.88,"influensa"]]},{"id":8,"start":27.61,"end":29.61,"text":"Du bør gå hjem og legge deg.","zh":"你应该回家躺下休息。","words":[[0,2,27.69,27.94,"du"],[3,6,27.94,28.18,"bør"],[7,9,28.18,28.46,"gå"],[10,14,28.46,28.78,"hjem~3f5fbf6a493e"],[15,17,28.78,28.96,"og"],[18,23,28.96,29.2,"legge~2d39b308954a"],[24,27,29.2,29.53,"deg"]]},{"id":9,"start":30.43,"end":31.43,"text":"God bedring!","zh":"早日康复！","words":[[0,3,30.51,30.72,"god"],[4,11,30.72,31.35,"bedring"]]},{"id":10,"start":35.16,"end":36.25,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,35.24,36.17,"sammendrag"]]},{"id":11,"start":37.67,"end":39.67,"text":"Han spør om hun er syk.","zh":"他问她是不是病了。","words":[[0,3,37.75,38.03,"han"],[4,8,38.03,38.37,"spør"],[9,11,38.37,38.67,"om~744a29d3d900"],[12,15,38.67,38.83,"hun"],[16,18,38.83,39.05,"er"],[19,22,39.05,39.59,"syk"]]},{"id":12,"start":40.82,"end":42.63,"text":"Hun sier at hun tror det.","zh":"她说她觉得是。","words":[[0,3,40.9,41.12,"hun"],[4,8,41.12,41.52,"sier"],[9,11,41.52,41.86,"at"],[12,15,41.86,41.98,"hun"],[16,20,41.98,42.22,"tror"],[21,24,42.22,42.55,"det"]]},{"id":13,"start":43.33,"end":46.4,"text":"Han sier at hun ser blek ut.","zh":"他说她看起来脸色苍白。","words":[[0,3,43.44,44.16,"han"],[4,8,44.16,44.68,"sier"],[9,11,44.68,45.04,"at"],[12,15,45.04,45.22,"hun"],[16,19,45.22,45.46,"ser~926a4d79c96e"],[20,24,45.46,45.96,"blek"],[25,27,45.96,46.32,"ut~5961721b496c"]]},{"id":14,"start":47.78,"end":52.68,"text":"Hun sier at det er varmt, og at hun har vondt i hele kroppen.","zh":"她说很热，而且她浑身疼。","words":[[0,3,47.86,48.12,"hun"],[4,8,48.12,48.46,"sier"],[9,11,48.46,48.8,"at"],[12,15,48.8,48.98,"det"],[16,18,48.98,49.12,"er"],[19,24,49.12,49.6,"varmt"],[26,28,50.32,50.5,"og"],[29,31,50.5,50.66,"at"],[32,35,50.66,50.82,"hun"],[36,39,50.82,50.98,"har"],[40,45,50.98,51.48,"vondt"],[46,47,51.48,51.68,"i"],[48,52,51.68,52.06,"hele"],[53,60,52.06,52.6,"kroppen"]]},{"id":15,"start":54.1,"end":57.81,"text":"Han sier at hun bør gå hjem og legge seg.","zh":"他说她应该回家躺下休息。","words":[[0,3,54.18,54.48,"han"],[4,8,54.48,54.82,"sier"],[9,11,54.82,55.12,"at"],[12,15,55.12,55.36,"hun"],[16,19,55.36,55.64,"bør"],[20,22,55.64,55.92,"gå"],[23,27,55.92,56.22,"hjem~3f5fbf6a493e"],[28,30,56.22,57.0,"og"],[31,36,57.0,57.32,"legge~2d39b308954a"],[37,40,57.32,57.73,"seg"]]},{"id":16,"start":60.97,"end":62.15,"text":"Hos legen","zh":"看医生","words":[[0,3,61.05,61.39,"hos"],[4,9,61.39,62.07,"legen"]]},{"id":17,"start":63.31,"end":66.29,"text":"En liten gutt med mamma hos mannlig lege.","zh":"一个小男孩和妈妈在一位男医生那里看病。","words":[[0,2,63.39,63.65,"en~a939a9e56dc5"],[3,8,63.65,64.01,"liten"],[9,13,64.01,64.35,"gutt"],[14,17,64.35,64.57,"med"],[18,23,64.57,64.97,"mamma"],[24,27,64.97,65.21,"hos"],[28,35,65.21,65.71,"mannlig"],[36,40,65.71,66.21,"lege"]]},{"id":18,"start":68.39,"end":69.96,"text":"Har du vondt i halsen?","speaker":"Lege","zh":"你喉咙疼吗？","words":[[0,3,68.47,68.66,"har"],[4,6,68.66,68.8,"du"],[7,12,68.8,69.16,"vondt"],[13,14,69.16,69.28,"i"],[15,21,69.28,69.88,"halsen"]]},{"id":19,"start":70.53,"end":72.57,"text":"Ja, veldig vondt.","speaker":"Gutt","zh":"是的，很疼。","words":[[0,2,70.53,71.12,"ja"],[4,10,71.48,71.96,"veldig"],[11,16,71.96,72.49,"vondt"]]},{"id":20,"start":73.62,"end":74.82,"text":"Hoster du mye?","speaker":"Lege","zh":"你咳嗽得厉害吗？","words":[[0,6,73.7,74.18,"hoster"],[7,9,74.18,74.3,"du"],[10,13,74.3,74.74,"mye~933c5a923198"]]},{"id":21,"start":74.98,"end":78.66,"text":"Ja, veldig mye. Har jeg feber?","speaker":"Gutt","zh":"是的，咳得很厉害。我发烧了吗？","words":[[0,2,75.2,75.92,"ja"],[4,10,76.3,76.78,"veldig"],[11,14,76.78,77.04,"mye~933c5a923198"],[16,19,77.3,77.8,"har"],[20,23,77.8,77.98,"jeg"],[24,29,77.98,78.58,"feber"]]},{"id":22,"start":79.27,"end":81.27,"text":"Ja, du er litt varm.","speaker":"Lege","zh":"是的，你有点发热。","words":[[0,2,79.35,79.67,"ja"],[4,6,80.05,80.27,"du"],[7,9,80.27,80.41,"er"],[10,14,80.41,80.63,"litt~54360be2a478"],[15,19,80.63,81.19,"varm"]]},{"id":23,"start":85.48,"end":86.58,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,85.56,86.5,"sammendrag"]]},{"id":24,"start":88.06,"end":91.04,"text":"Legen spør om gutten har vondt i halsen.","zh":"医生问男孩喉咙疼不疼。","words":[[0,5,88.14,88.69,"legen"],[6,10,88.69,88.99,"spør"],[11,13,88.99,89.25,"om~744a29d3d900"],[14,20,89.25,89.65,"gutten"],[21,24,89.65,89.85,"har"],[25,30,89.85,90.17,"vondt"],[31,32,90.17,90.27,"i"],[33,39,90.27,90.96,"halsen"]]},{"id":25,"start":91.7,"end":96.63,"text":"Gutten sier at han har veldig vondt og spør om han har feber.","zh":"男孩说他很疼，并问自己是不是发烧了。","words":[[0,6,91.78,92.29,"gutten"],[7,11,92.29,92.65,"sier"],[12,14,92.65,92.95,"at"],[15,18,92.95,93.17,"han"],[19,22,93.17,93.39,"har"],[23,29,93.39,93.85,"veldig"],[30,35,93.85,94.27,"vondt"],[36,38,94.27,95.03,"og"],[39,43,95.03,95.37,"spør"],[44,46,95.37,95.59,"om~744a29d3d900"],[47,50,95.59,95.79,"han"],[51,54,95.79,95.97,"har"],[55,60,95.97,96.55,"feber"]]},{"id":26,"start":97.55,"end":100.06,"text":"Legen sier at han er litt varm.","zh":"医生说他有点发热。","words":[[0,5,97.63,98.22,"legen"],[6,10,98.22,98.5,"sier"],[11,13,98.5,98.82,"at"],[14,17,98.82,99.06,"han"],[18,20,99.06,99.28,"er"],[21,25,99.28,99.44,"litt~54360be2a478"],[26,30,99.44,99.98,"varm"]]},{"id":27,"start":101.01,"end":105.93,"text":"Gutten spør om han må på sykehus, men legen sier at han kan dra hjem.","zh":"男孩问他是否得去医院，但医生说他可以回家。","words":[[0,6,101.09,101.44,"gutten"],[7,11,101.44,101.72,"spør"],[12,14,101.72,101.92,"om~744a29d3d900"],[15,18,101.92,102.08,"han"],[19,21,102.08,102.22,"må"],[22,24,102.22,102.4,"på~b883cf7b2b36"],[25,32,102.4,103.08,"sykehus"],[34,37,103.62,103.82,"men"],[38,43,103.82,104.2,"legen"],[44,48,104.2,104.6,"sier"],[49,51,104.6,104.86,"at"],[52,55,104.86,105.04,"han"],[56,59,105.04,105.26,"kan"],[60,63,105.26,105.52,"dra"],[64,68,105.52,105.85,"hjem~3f5fbf6a493e"]]},{"id":28,"start":109.35,"end":110.18,"text":"Kroppen","zh":"身体","words":[[0,7,109.43,110.1,"kroppen"]]},{"id":29,"start":111.97,"end":112.71,"text":"Hodet","zh":"头","words":[[0,5,112.05,112.63,"hodet"]]},{"id":30,"start":114.08,"end":114.99,"text":"nakken","zh":"后颈","words":[[0,6,114.16,114.91,"nakken"]]},{"id":31,"start":116.27,"end":117.25,"text":"skulderen","zh":"肩膀","words":[[0,9,116.35,117.17,"skulderen"]]},{"id":32,"start":118.79,"end":119.65,"text":"ryggen","zh":"背","words":[[0,6,118.87,119.57,"ryggen"]]},{"id":33,"start":121.03,"end":121.91,"text":"albuen","zh":"胳膊肘","words":[[0,6,121.11,121.83,"albuen"]]},{"id":34,"start":123.41,"end":124.24,"text":"brystet","zh":"胸部","words":[[0,7,123.49,124.16,"brystet"]]},{"id":35,"start":126.14,"end":127.18,"text":"håndleddet","zh":"手腕","words":[[0,10,126.22,127.1,"håndleddet"]]},{"id":36,"start":128.74,"end":129.65,"text":"magen","zh":"肚子","words":[[0,5,128.82,129.57,"magen"]]},{"id":37,"start":129.9,"end":134.23,"text":"Rumpa eller baken,","zh":"屁股或臀部，","words":[[0,5,131.16,132.34,"rumpa"],[6,11,132.34,133.14,"eller"],[12,17,133.14,134.15,"baken"]]},{"id":38,"start":136.08,"end":136.88,"text":"beinet","zh":"腿","words":[[0,6,136.16,136.8,"beinet"]]},{"id":39,"start":138.54,"end":139.53,"text":"foten","zh":"脚","words":[[0,5,138.62,139.45,"foten"]]},{"id":40,"start":141.48,"end":142.48,"text":"halsen","zh":"脖子；喉咙","words":[[0,6,141.56,142.4,"halsen~7e101eb5f0fc"]]},{"id":41,"start":144.16,"end":145.08,"text":"armen","zh":"手臂","words":[[0,5,144.24,145.0,"armen"]]},{"id":42,"start":146.61,"end":147.57,"text":"hånda","zh":"手","words":[[0,5,146.69,147.49,"hånda"]]},{"id":43,"start":149.23,"end":150.17,"text":"fingeren","zh":"手指","words":[[0,8,149.31,150.09,"fingeren"]]},{"id":44,"start":151.73,"end":152.54,"text":"kneet","zh":"膝盖","words":[[0,5,151.81,152.46,"kneet"]]},{"id":45,"start":156.09,"end":157.07,"text":"Ansiktet","zh":"脸","words":[[0,8,156.17,157.0,"ansiktet"]]},{"id":46,"start":158.97,"end":159.67,"text":"øret","zh":"耳朵","words":[[0,4,159.05,159.59,"øret"]]},{"id":47,"start":161.47,"end":162.26,"text":"k