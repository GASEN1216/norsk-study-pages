{"id":"2.1","title":"Kjenner du Marek?","audio":"audio/2.1.mp3","duration":319.37,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.18,"text":"2.1 Kjenner du Marek?","heading":true,"zh":"2.1 你认识马雷克吗？","words":[[0,3,0.15,1.23,"2.1"],[4,11,2.58,3.07,"kjenner"],[12,14,3.07,3.35,"du"],[15,20,3.35,4.1,"marek"]]},{"id":1,"start":6.17,"end":11.34,"text":"Marek er fra Polen, men nå bor han i Norge.","zh":"马雷克来自波兰，但他现在住在挪威。","words":[[0,5,6.25,7.03,"marek"],[6,8,7.03,7.59,"er"],[9,12,7.59,7.83,"fra"],[13,18,7.83,8.35,"polen~488e57c60a08"],[20,23,9.15,9.53,"men"],[24,26,9.53,9.81,"nå~d531d47a7712"],[27,30,9.81,10.31,"bor"],[31,34,10.31,10.55,"han"],[35,36,10.55,10.77,"i"],[37,42,10.77,11.26,"norge~546b56e35dd5"]]},{"id":2,"start":12.52,"end":17.53,"text":"Han går på norskkurs sammen med folk fra mange land.","zh":"他和来自许多国家的人一起上挪威语课。","words":[[0,3,12.6,12.98,"han"],[4,7,12.98,13.28,"går~b93725e46d7b"],[8,10,13.28,13.54,"på~35ec86f98ed0"],[11,20,13.54,14.3,"norskkurs"],[21,27,15.2,15.58,"sammen"],[28,31,15.58,15.76,"med"],[32,36,15.76,16.12,"folk"],[37,40,16.12,16.52,"fra"],[41,46,16.52,16.94,"mange"],[47,51,16.94,17.45,"land"]]},{"id":3,"start":19.03,"end":22.26,"text":"I dag skriver han en tekst til Håvard.","zh":"今天他给霍瓦尔写一篇短文。","words":[[0,1,19.11,19.25,"i~de136e71704d"],[2,5,19.25,19.51,"dag~83a758a6ca25"],[6,13,19.51,20.31,"skriver"],[14,17,20.31,20.57,"han"],[18,20,20.57,20.77,"en~a939a9e56dc5"],[21,26,20.77,21.31,"tekst"],[27,30,21.31,21.55,"til"],[31,37,21.55,22.18,"håvard"]]},{"id":4,"start":22.68,"end":24.59,"text":"Det er lekse.","zh":"这是作业。","words":[[0,3,22.84,23.68,"det"],[4,6,23.68,24.0,"er"],[7,12,24.0,24.51,"lekse"]]},{"id":5,"start":26.37,"end":29.56,"text":"Jeg heter Marek og kommer fra Polen.","zh":"我叫马雷克，来自波兰。","words":[[0,3,26.45,26.8,"jeg"],[4,9,26.8,27.26,"heter"],[10,15,27.26,27.9,"marek"],[16,18,27.9,28.3,"og"],[19,25,28.3,28.62,"kommer"],[26,29,28.62,29.02,"fra"],[30,35,29.02,29.48,"polen~488e57c60a08"]]},{"id":6,"start":30.73,"end":32.92,"text":"Jeg er 26 år.","zh":"我 26 岁。","words":[[0,3,30.81,31.11,"jeg"],[4,6,31.11,31.43,"er"],[7,9,31.43,31.91,"26"],[10,12,31.91,32.84,"år"]]},{"id":7,"start":34.75,"end":38.07,"text":"Jeg kom til Norge i mai 2017.","zh":"我 2017 年 5 月来到挪威。","words":[[0,3,34.83,35.04,"jeg"],[4,7,35.04,35.28,"kom~a03d8aa690db"],[8,11,35.28,35.5,"til"],[12,17,35.5,35.92,"norge~546b56e35dd5"],[18,19,35.92,36.42,"i"],[20,23,36.42,36.86,"mai"],[24,28,36.86,37.99,"2017~b31af0d1044b"]]},{"id":8,"start":39.39,"end":40.56,"text":"Jeg er snekker.","zh":"我是木匠。","words":[[0,3,39.47,39.73,"jeg"],[4,6,39.73,40.09,"er"],[7,14,40.09,40.48,"snekker"]]},{"id":9,"start":42.55,"end":44.91,"text":"Nå går jeg på norskkurs.","zh":"现在我在上挪威语课。","words":[[0,2,42.63,42.98,"nå~d531d47a7712"],[3,6,42.98,43.3,"går~b93725e46d7b"],[7,10,43.3,43.5,"jeg"],[11,13,43.5,43.72,"på~35ec86f98ed0"],[14,23,43.72,44.83,"norskkurs"]]},{"id":10,"start":46.6,"end":49.32,"text":"I Norge bor jeg sammen med en venn.","zh":"在挪威，我和一个朋友住在一起。","words":[[0,1,46.68,46.82,"i"],[2,7,46.82,47.24,"norge~546b56e35dd5"],[8,11,47.24,47.9,"bor"],[12,15,47.9,48.08,"jeg"],[16,22,48.08,48.52,"sammen"],[23,26,48.52,48.64,"med"],[27,29,48.64,48.88,"en~a939a9e56dc5"],[30,34,48.88,49.24,"venn"]]},{"id":11,"start":50.52,"end":54.88,"text":"Jeg er gift med Ewa, men hun bor i Polen.","zh":"我和埃娃结婚了，但她住在波兰。","words":[[0,3,50.6,50.76,"jeg"],[4,6,50.76,50.9,"er"],[7,11,50.9,51.16,"gift"],[12,15,51.16,51.72,"med~303c86438623"],[16,19,51.72,52.16,"ewa"],[21,24,53.0,53.4,"men"],[25,28,53.4,53.68,"hun"],[29,32,53.68,53.98,"bor"],[33,34,53.98,54.36,"i"],[35,40,54.36,54.8,"polen~488e57c60a08"]]},{"id":12,"start":56.66,"end":60.68,"text":"I dag er det lørdag, og jeg har fri.","zh":"今天是星期六，我休息。","words":[[0,1,56.74,56.9,"i~de136e71704d"],[2,5,56.9,57.18,"dag~83a758a6ca25"],[6,8,57.18,57.7,"er"],[9,12,57.7,57.84,"det"],[13,19,57.84,58.4,"lørdag"],[21,23,59.04,59.3,"og"],[24,27,59.3,59.58,"jeg"],[28,31,59.58,60.12,"har~be484e9e1f4d"],[32,35,60.12,60.6,"fri"]]},{"id":13,"start":62.08,"end":65.86,"text":"Jeg bruker pc og chatter med Ewa.","zh":"我用电脑和埃娃聊天。","words":[[0,3,62.16,62.44,"jeg"],[4,10,62.44,63.0,"bruker"],[11,13,63.0,63.44,"pc"],[14,16,63.44,64.24,"og"],[17,24,64.24,64.68,"chatter"],[25,28,64.68,65.3,"med"],[29,32,65.3,65.78,"ewa"]]},{"id":14,"start":67.34,"end":71.01,"text":"Hun er 24 år og studerer i Polen.","zh":"她 24 岁，在波兰上大学。","words":[[0,3,67.42,67.62,"hun"],[4,6,67.62,67.88,"er"],[7,9,67.88,68.44,"24"],[10,12,68.44,68.98,"år"],[13,15,68.98,69.48,"og"],[16,24,69.48,70.04,"studerer"],[25,26,70.04,70.46,"i"],[27,32,70.46,70.93,"polen~488e57c60a08"]]},{"id":15,"start":72.44,"end":77.07,"text":"Vi snakker sammen på Skype og chatter på Messenger.","zh":"我们在 Skype 上通话，在 Messenger 上聊天。","words":[[0,2,72.52,72.79,"vi"],[3,10,72.79,73.29,"snakker"],[11,17,73.29,73.83,"sammen"],[18,20,73.83,74.23,"på~acc985c9313f"],[21,26,74.23,74.81,"skype"],[27,29,74.81,75.29,"og"],[30,37,75.29,75.79,"chatter"],[38,40,75.79,76.27,"på~325e3beb750d"],[41,50,76.27,76.99,"messenger"]]},{"id":16,"start":78.08,"end":83.1,"text":"Månedene","zh":"月份","words":[[0,8,81.08,83.02,"månedene"]]},{"id":17,"start":84.47,"end":86.07,"text":"januar","zh":"一月","words":[[0,6,84.55,85.99,"januar"]]},{"id":18,"start":88.06,"end":89.1,"text":"februar","zh":"二月","words":[[0,7,88.14,89.02,"februar"]]},{"id":19,"start":91.03,"end":91.87,"text":"mars","zh":"三月","words":[[0,4,91.11,91.79,"mars"]]},{"id":20,"start":93.68,"end":94.61,"text":"april","zh":"四月","words":[[0,5,93.76,94.53,"april"]]},{"id":21,"start":96.59,"end":97.36,"text":"mai","zh":"五月","words":[[0,3,96.67,97.28,"mai"]]},{"id":22,"start":99.18,"end":99.98,"text":"juni","zh":"六月","words":[[0,4,99.26,99.9,"juni"]]},{"id":23,"start":101.65,"end":102.42,"text":"juli","zh":"七月","words":[[0,4,101.73,102.34,"juli"]]},{"id":24,"start":104.38,"end":105.51,"text":"august","zh":"八月","words":[[0,6,104.46,105.43,"august"]]},{"id":25,"start":106.8,"end":107.97,"text":"september","zh":"九月","words":[[0,9,106.88,107.89,"s