{"id":"2.1","title":"Kjenner du Marek?","audio":"audio/2.1.mp3","duration":319.37,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.18,"text":"2.1 Kjenner du Marek?","heading":true,"zh":"2.1 你认识马雷克吗？","words":[[0,3,0.15,1.23,"2.1"],[4,11,2.58,3.07,"kjenner"],[12,14,3.07,3.35,"du"],[15,20,3.35,4.1,"marek"]]},{"id":1,"start":6.3,"end":11.42,"text":"Marek er fra Polen, men nå bor han i Norge.","zh":"马雷克来自波兰，但他现在住在挪威。","words":[[0,5,6.36,7.2,"marek"],[6,8,7.42,7.7,"er"],[9,12,7.7,7.9,"fra"],[13,18,7.9,8.54,"polen~488e57c60a08"],[20,23,9.38,9.58,"men"],[24,26,9.58,9.9,"nå~d531d47a7712"],[27,30,10.14,10.4,"bor"],[31,34,10.4,10.68,"han"],[35,36,10.68,10.8,"i"],[37,42,10.8,11.27,"norge~546b56e35dd5"]]},{"id":2,"start":12.54,"end":17.59,"text":"Han går på norskkurs sammen med folk fra mange land.","zh":"他和来自许多国家的人一起上挪威语课。","words":[[0,3,12.6,13.08,"han"],[4,7,13.08,13.44,"går~b93725e46d7b"],[8,10,13.44,13.64,"på~35ec86f98ed0"],[11,20,13.64,14.63,"norskkurs"],[21,27,15.22,15.64,"sammen"],[28,31,15.64,15.86,"med"],[32,36,15.86,16.32,"folk"],[37,40,16.32,16.64,"fra"],[41,46,16.64,17.08,"mange"],[47,51,17.08,17.45,"land"]]},{"id":3,"start":19.07,"end":22.32,"text":"I dag skriver han en tekst til Håvard.","zh":"今天他给霍瓦尔写一篇短文。","words":[[0,1,19.12,19.28,"i~de136e71704d"],[2,5,19.28,19.83,"dag~83a758a6ca25"],[6,13,19.96,20.44,"skriver"],[14,17,20.44,20.7,"han"],[18,20,20.7,20.88,"en~a939a9e56dc5"],[21,26,20.88,21.42,"tekst"],[27,30,21.42,21.68,"til"],[31,37,21.68,22.18,"håvard"]]},{"id":4,"start":23.43,"end":24.66,"text":"Det er lekse.","zh":"这是作业。","words":[[0,3,23.49,23.86,"det"],[4,6,23.86,24.08,"er"],[7,12,24.08,24.51,"lekse"]]},{"id":5,"start":26.4,"end":29.65,"text":"Jeg heter Marek og kommer fra Polen.","zh":"我叫马雷克，来自波兰。","words":[[0,3,26.46,26.92,"jeg"],[4,9,26.92,27.38,"heter"],[10,15,27.38,28.04,"marek"],[16,18,28.2,28.36,"og"],[19,25,28.36,28.88,"kommer"],[26,29,28.88,29.1,"fra"],[30,35,29.1,29.5,"polen~488e57c60a08"]]},{"id":6,"start":30.76,"end":32.91,"text":"Jeg er 26 år.","zh":"我 26 岁。","words":[[0,3,30.82,31.2,"jeg"],[4,6,31.2,31.59,"er"],[7,9,31.72,32.52,"26"],[10,12,32.52,32.77,"år"]]},{"id":7,"start":34.75,"end":38.07,"text":"Jeg kom til Norge i mai 2017.","zh":"我 2017 年 5 月来到挪威。","words":[[0,3,34.83,35.04,"jeg"],[4,7,35.04,35.28,"kom~a03d8aa690db"],[8,11,35.28,35.5,"til"],[12,17,35.5,35.92,"norge~546b56e35dd5"],[18,19,35.92,36.42,"i"],[20,23,36.42,36.86,"mai"],[24,28,36.86,37.99,"2017~b31af0d1044b"]]},{"id":8,"start":39.43,"end":40.99,"text":"Jeg er snekker.","zh":"我是木匠。","words":[[0,3,39.49,39.92,"jeg"],[4,6,39.92,40.26,"er"],[7,14,40.26,40.84,"snekker"]]},{"id":9,"start":42.57,"end":44.96,"text":"Nå går jeg på norskkurs.","zh":"现在我在上挪威语课。","words":[[0,2,42.63,43.08,"nå~d531d47a7712"],[3,6,43.08,43.36,"går~b93725e46d7b"],[7,10,43.36,43.62,"jeg"],[11,13,43.62,43.82,"på~35ec86f98ed0"],[14,23,43.82,44.81,"norskkurs"]]},{"id":10,"start":46.63,"end":49.39,"text":"I Norge bor jeg sammen med en venn.","zh":"在挪威，我和一个朋友住在一起。","words":[[0,1,46.7,46.86,"i"],[2,7,46.86,47.44,"norge~546b56e35dd5"],[8,11,47.7,47.96,"bor"],[12,15,47.96,48.2,"jeg"],[16,22,48.2,48.56,"sammen"],[23,26,48.56,48.74,"med"],[27,29,48.74,48.9,"en~a939a9e56dc5"],[30,34,48.9,49.24,"venn"]]},{"id":11,"start":50.55,"end":54.95,"text":"Jeg er gift med Ewa, men hun bor i Polen.","zh":"我和埃娃结婚了，但她住在波兰。","words":[[0,3,50.62,50.82,"jeg"],[4,6,50.82,50.98,"er"],[7,11,50.98,51.6,"gift"],[12,15,51.6,51.86,"med~303c86438623"],[16,19,51.86,52.4,"ewa"],[21,24,53.3,53.5,"men"],[25,28,53.5,53.8,"hun"],[29,32,53.8,54.3,"bor"],[33,34,54.3,54.44,"i"],[35,40,54.44,54.8,"polen~488e57c60a08"]]},{"id":12,"start":56.68,"end":60.76,"text":"I dag er det lørdag, og jeg har fri.","zh":"今天是星期六，我休息。","words":[[0,1,56.74,56.92,"i~de136e71704d"],[2,5,56.92,57.45,"dag~83a758a6ca25"],[6,8,57.6,57.72,"er"],[9,12,57.72,57.9,"det"],[13,19,57.9,58.59,"lørdag"],[21,23,59.2,59.36,"og"],[24,27,59.36,59.77,"jeg"],[28,31,59.94,60.28,"har~be484e9e1f4d"],[32,35,60.28,60.61,"fri"]]},{"id":13,"start":62.11,"end":65.93,"text":"Jeg bruker pc og chatter med Ewa.","zh":"我用电脑和埃娃聊天。","words":[[0,3,62.17,62.52,"jeg"],[4,10,62.52,63.14,"bruker"],[11,13,63.14,63.84,"pc"],[14,16,64.16,64.34,"og"],[17,24,64.34,65.04,"chatter"],[25,28,65.22,65.42,"med"],[29,32,65.42,65.78,"ewa"]]},{"id":14,"start":67.39,"end":71.1,"text":"Hun er 24 år og studerer i Polen.","zh":"她 24 岁，在波兰上大学。","words":[[0,3,67.45,67.72,"hun"],[4,6,67.72,68.02,"er"],[7,9,68.02,68.8,"24"],[10,12,68.8,69.22,"år"],[13,15,69.4,69.52,"og"],[16,24,69.52,70.4,"studerer"],[25,26,70.4,70.5,"i"],[27,32,70.5,70.95,"polen~488e57c60a08"]]},{"id":15,"start":72.5,"end":78.13,"text":"Vi snakker sammen på Skype og chatter på Messenger hver dag.","zh":"我们每天在 Skype 上通话，在 Messenger 上聊天。","words":[[0,2,72.56,72.88,"vi"],[3,10,72.88,73.46,"snakker"],[11,17,73.46,74.0,"sammen"],[18,20,74.12,74.34,"på~acc985c9313f"],[21,26,74.34,75.0,"skype"],[27,29,75.2,75.4,"og"],[30,37,75.4,76.18,"chatter"],[38,40,76.18,76.32,"på~325e3beb750d"],[41,50,76.32,77.12,"messenger"],[51,55,77.24,77.6,"hver"],[56,59,77.6,77.98,"dag"]]},{"id":16,"start":82.12,"end":83.16,"text":"Månedene","zh":"月份","words":[[0,8,82.18,83.01,"månedene"]]},{"id":17,"start":85.09,"end":86.13,"text":"januar","zh":"一月","words":[[0,6,85.15,85.98,"januar"]]},{"id":18,"start":88.1,"end":89.15,"text":"februar","zh":"二月","words":[[0,7,88.16,89.0,"februar"]]},{"id":19,"start":91.05,"end":91.96,"text":"mars","zh":"三月","words":[[0,4,91.11,91.81,"mars"]]},{"id":20,"start":93.72,"end":94.65,"text":"april","zh":"四月","words":[[0,5,93.78,94.5,"april"]]},{"id":21,"start":96.63,"end":97.4,"text":"mai","zh":"五月","words":[[0,3,96.69,97.25,"mai"]]},{"id":22,"start":99.23,"end":100.04,"text":"juni","zh":"六月","words":[[0,4,99.29,99.89,"juni"]]},{"id":23,"start":101.69,"end":102.5,"text":"juli","zh":"七月","words":[[0,4,101.75,102.35,"juli"]]},{"id":24,"start":104.42,"end":105.46,"text":"august","zh":"八月","words":[[0,6,104.48,105.31,"august"]]},{"id":25,"start":106.86,"end":108.06,"text":"septemb