{"id":"pa-vei-5.D","bookId":"pa-vei-textbook","readingId":"5.D","title":"Monica kommer for sent","audio":"audio/pa-vei/5.D.mp3","duration":68.808,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.36,"end":4.985,"text":"D. Monica kommer for sent","zh":"D. 莫妮卡迟到了","words":[[0,1,1.36,1.86,"d"],[3,9,3.28,3.865,"monica"],[10,16,3.94,4.345,"kommer"],[17,20,4.38,4.545,"for@pa-vei-for-excess"],[21,25,4.56,4.985,"sent"]]},{"id":1,"start":7.1,"end":10.005,"text":"Det er lørdag, og Monica har fri.","zh":"今天是星期六，莫妮卡休息。","words":[[0,3,7.1,7.285,"det"],[4,6,7.3,7.445,"er"],[7,13,7.5,8.065,"lørdag"],[15,17,8.7,8.825,"og"],[18,24,8.86,9.405,"monica"],[25,28,9.48,9.725,"har"],[29,32,9.8,10.005,"fri"]]},{"id":2,"start":11.68,"end":14.065,"text":"Hun skal møte Pablo klokka elleve.","zh":"她要在十一点和巴勃罗见面。","words":[[0,3,11.68,11.885,"hun"],[4,8,11.96,12.185,"skal"],[9,13,12.24,12.625,"møte"],[14,19,12.7,13.185,"pablo"],[20,26,13.3,13.625,"klokka"],[27,33,13.7,14.065,"elleve"]]},{"id":3,"start":15.988,"end":20.173,"text":"Monica og Pablo går sammen på norskkurs og er venner.","zh":"莫妮卡和巴勃罗一起上挪威语课，他们是朋友。","words":[[0,6,15.988,16.533,"monica"],[7,9,16.608,16.751,"og"],[10,15,16.751,17.233,"pablo"],[16,19,17.368,17.633,"går"],[20,26,17.708,18.113,"sammen"],[27,29,18.168,18.313,"på"],[30,39,18.348,19.013,"norskkurs"],[40,42,19.408,19.553,"og"],[43,45,19.608,19.793,"er"],[46,52,19.828,20.173,"venner"]]},{"id":4,"start":22.128,"end":24.833,"text":"Hun må ta bussen klokka ti over halv elleve.","zh":"她得坐十点四十分的公交车。","words":[[0,3,22.128,22.313,"hun"],[4,6,22.328,22.473,"må"],[7,9,22.508,22.653,"ta"],[10,16,22.748,23.173,"bussen"],[17,23,23.228,23.573,"klokka"],[24,26,23.648,23.833,"ti"],[27,31,23.968,24.213,"over"],[32,36,24.268,24.533,"halv"],[37,43,24.548,24.833,"elleve"]]},{"id":5,"start":26.708,"end":31.293,"text":"Men Monica sover for lenge, og hun kommer for sent til bussen.","zh":"可是莫妮卡睡过了头，没赶上公交车。","words":[[0,3,26.708,26.913,"men"],[4,10,26.968,27.533,"monica"],[11,16,27.628,28.073,"sover"],[17,20,28.108,28.293,"for@pa-vei-for-excess"],[21,26,28.328,28.653,"lenge"],[28,30,29.268,29.413,"og"],[31,34,29.428,29.613,"hun"],[35,41,29.648,30.013,"kommer"],[42,45,30.068,30.233,"for@pa-vei-for-excess"],[46,50,30.288,30.751,"sent"],[51,54,30.751,30.913,"til"],[55,61,30.928,31.293,"bussen"]]},{"id":6,"start":32.888,"end":35.753,"text":"Hun må vente i et kvarter på neste buss.","zh":"她得等一刻钟，才能坐下一班公交车。","words":[[0,3,32.888,33.073,"hun"],[4,6,33.088,33.213,"må"],[7,12,33.248,33.621,"vente"],[13,14,33.621,33.733,"i"],[15,17,33.848,34.113,"et"],[18,25,34.128,34.693,"kvarter"],[26,28,34.908,35.033,"på"],[29,34,35.068,35.46,"neste"],[35,39,35.46,35.753,"buss"]]},{"id":7,"start":37.348,"end":41.633,"text":"Nå er klokka kvart over elleve, og Pablo står og venter.","zh":"现在是十一点一刻，巴勃罗正站着等她。","words":[[0,2,37.348,37.493,"nå"],[3,5,37.668,37.853,"er"],[6,12,37.928,38.313,"klokka"],[13,18,38.408,38.831,"kvart"],[19,23,38.831,39.073,"over"],[24,30,39.088,39.393,"elleve"],[32,34,40.148,40.293,"og"],[35,40,40.348,40.833,"pablo"],[41,45,40.888,41.141,"står"],[46,48,41.141,41.24,"og"],[49,55,41.24,41.633,"venter"]]},{"id":8,"start":43.808,"end":47.773,"text":"Hei Pablo! Beklager at jeg kommer for sent!","zh":"嗨，巴勃罗！抱歉，我迟到了！","words":[[0,3,43.808,44.053,"hei"],[4,9,44.168,44.593,"pablo"],[11,19,45.728,46.513,"beklager"],[20,22,46.628,46.751,"at"],[23,26,46.751,46.893,"jeg"],[27,33,46.908,47.221,"kommer"],[34,37,47.221,47.353,"for@pa-vei-for-excess"],[38,42,47.368,47.773,"sent"]],"speaker":"Monica"},{"id":9,"start":48.768,"end":50.533,"text":"Du kommer alltid for sent!","zh":"你总是迟到！","words":[[0,2,48.768,48.893,"du"],[3,9,48.908,49.253,"kommer"],[10,16,49.348,49.853,"alltid"],[17,20,50.028,50.18,"for@pa-vei-for-excess"],[21,25,50.18,50.533,"sent"]],"speaker":"Pablo"},{"id":10,"start":51.488,"end":52.033,"text":"Unnskyld!","zh":"对不起！","words":[[0,8,51.488,52.033,"unnskyld"]],"speaker":"Monica"},{"id":11,"start":52.948,"end":55.533,"text":"Det er greit, men nå må jeg ha noe å drikke.","zh":"没关系，不过我现在得喝点东西。","words":[[0,3,52.948,53.09,"det"],[4,6,53.09,53.171,"er"],[7,12,53.171,53.533,"greit"],[14,17,54.248,54.41,"men"],[18,20,54.41,54.553,"nå"],[21,23,54.608,54.721,"må"],[24,27,54.721,54.85,"jeg"],[28,30,54.85,54.953,"ha"],[31,34,54.968,55.151,"noe"],[35,36,55.151,55.21,"å"],[37,43,55.21,55.533,"drikke"]],"speaker":"Pablo"},{"id":12,"start":56.228,"end":57.973,"text":"Det er så varmt, og jeg er tørst.","zh":"天气这么热，我口渴了。","words":[[0,3,56.228,56.361,"det"],[4,6,56.361,56.46,"er"],[7,9,56.46,56.593,"så"],[10,15,56.628,57.093,"varmt"],[17,19,57.208,57.331,"og"],[20,23,57.331,57.46,"jeg"],[24,26,57.46,57.561,"er"],[27,32,57.561,57.973,"tørst"]],"speaker":"Pablo"},{"id":13,"start":58.948,"end":63.073,"text":"Og jeg er både sulten og tørst. Her er en kafé.","zh":"我又饿又渴。这里有一家咖啡馆。","words":[[0,2,58.948,59.073,"og"],[3,6,59.108,59.313,"jeg"],[7,9,59.348,59.493,"er"],[10,14,59.508,59.793,"både"],[15,21,59.868,60.353,"sulten"],[22,24,60.648,60.77,"og"],[25,30,60.77,61.153,"tørst"],[32,35,62.208,62.413,"her"],[36,38,62.448,62.63,"er"],[39,41,62.63,62.76,"en"],[42,46,62.76,63.073,"kafé"]],"speaker":"Monica"},{"id":14,"start":64.308,"end":65.333,"text":"Skal vi gå inn her?","zh":"我们进去吧？","words":[[0,4,64.308,64.501,"skal"],[5,7,64.501,64.613,"vi"],[8,10,64.648,64.793,"gå"],[11,14,64.888,65.111,"inn"],[15,18,65.111,65.333,"her"]],"speaker":"Monica"},{"id":15,"start":66.448,"end":67.293,"text":"Ja, gjerne.","zh":"好啊。","words":[[0,2,66.448,66.593,"ja"],[4,10,67.008,67.293,"gjerne"]],"speaker":"Pablo"}],"lexicon":{"alltid":{"lemma":"alltid","pos":"副词","zh":"总是；一直","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"beklager":{"lemma":"beklage","pos":"动词","zh":"抱歉；表示歉意","ref":null,"clip":null,"form":"现在时"},"buss":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","clip":null},"bussen":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","form":"单数定指","clip":null},"både":{"lemma":"både","