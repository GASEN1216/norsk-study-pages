{"id":"pa-vei-2.B","bookId":"pa-vei-textbook","readingId":"2.B","title":"Haifa snakker med Magnus","audio":"audio/pa-vei/2.B.mp3","duration":83.328,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.32,"end":6.385,"text":"B. Haifa snakker med Magnus","zh":"B. 海法和马格努斯交谈","words":[[0,1,2.32,2.88,"b"],[3,8,4.4,4.965,"haifa"],[9,16,5.22,5.685,"snakker"],[17,20,5.7,5.865,"med"],[21,27,5.88,6.385,"magnus"]]},{"id":1,"start":8.7,"end":11.365,"text":"Hei Haifa! Hyggelig å se deg!","zh":"嗨，海法！很高兴见到你！","words":[[0,3,8.7,8.945,"hei"],[4,9,9.02,9.405,"haifa"],[11,19,10.34,10.832,"hyggelig"],[20,21,10.832,10.925,"å"],[22,24,10.94,11.105,"se"],[25,28,11.18,11.365,"deg"]],"speaker":"Magnus"},{"id":2,"start":12.18,"end":12.885,"text":"I like måte.","zh":"我也一样。","words":[[0,1,12.18,12.262,"i"],[2,6,12.262,12.562,"like@pa-vei-like-same"],[7,11,12.562,12.885,"måte"]],"speaker":"Haifa"},{"id":3,"start":14.0,"end":14.665,"text":"Hva gjør du?","zh":"你在做什么？","words":[[0,3,14.0,14.185,"hva"],[4,8,14.22,14.485,"gjør"],[9,11,14.52,14.665,"du"]],"speaker":"Magnus"},{"id":4,"start":15.6,"end":16.625,"text":"Ikke noe spesielt.","zh":"没做什么特别的事。","words":[[0,4,15.6,15.822,"ikke"],[5,8,15.822,16.023,"noe"],[9,17,16.023,16.625,"spesielt"]],"speaker":"Haifa"},{"id":5,"start":17.294,"end":19.659,"text":"Jeg drikker kaffe og leser en avis på nettet.","zh":"我在喝咖啡，在网上看报纸。","words":[[0,3,17.294,17.499,"jeg"],[4,11,17.554,17.846,"drikker"],[12,17,17.846,18.199,"kaffe"],[18,20,18.214,18.339,"og"],[21,26,18.374,18.686,"leser"],[27,29,18.686,18.816,"en"],[30,34,18.816,19.197,"avis"],[35,37,19.197,19.306,"på"],[38,44,19.306,19.659,"nettet"]],"speaker":"Haifa"},{"id":6,"start":21.054,"end":22.219,"text":"Er det en norsk avis?","zh":"是挪威报纸吗？","words":[[0,2,21.054,21.216,"er"],[3,6,21.216,21.346,"det"],[7,9,21.346,21.456,"en"],[10,15,21.456,21.826,"norsk@pa-vei-norsk-adjective"],[16,20,21.826,22.219,"avis"]],"speaker":"Magnus"},{"id":7,"start":23.554,"end":25.819,"text":"Nei, jeg leser en engelsk avis.","zh":"不，我看的是一份英文报纸。","words":[[0,3,23.554,23.879,"nei"],[5,8,24.294,24.499,"jeg"],[9,14,24.554,24.856,"leser"],[15,17,24.856,24.979,"en"],[18,25,25.034,25.466,"engelsk@pa-vei-engelsk-adjective"],[26,30,25.466,25.819,"avis"]],"speaker":"Haifa"},{"id":8,"start":26.574,"end":28.059,"text":"Jeg forstår ikke så mye norsk.","zh":"我不太懂挪威语。","words":[[0,3,26.574,26.727,"jeg"],[4,11,26.727,27.166,"forstår"],[12,16,27.166,27.366,"ikke"],[17,19,27.366,27.496,"så"],[20,23,27.496,27.716,"mye"],[24,29,27.716,28.059,"norsk"]],"speaker":"Haifa"},{"id":9,"start":29.094,"end":30.839,"text":"Men jeg forstår engelsk ganske bra.","zh":"不过我的英语还不错。","words":[[0,3,29.094,29.227,"men"],[4,7,29.227,29.366,"jeg"],[8,15,29.366,29.779,"forstår"],[16,23,29.934,30.377,"engelsk"],[24,30,30.377,30.686,"ganske"],[31,34,30.686,30.839,"bra"]],"speaker":"Haifa"},{"id":10,"start":32.134,"end":34.079,"text":"Du er fra Iran, ikke sant?","zh":"你来自伊朗，对吗？","words":[[0,2,32.134,32.279,"du"],[3,5,32.334,32.556,"er"],[6,9,32.556,32.719,"fra"],[10,14,32.774,33.219,"iran"],[16,20,33.554,33.787,"ikke"],[21,25,33.787,34.079,"sant"]],"speaker":"Magnus"},{"id":11,"start":35.034,"end":38.279,"text":"Nei, fra Irak. Jeg snakker arabisk.","zh":"不，是伊拉克。我说阿拉伯语。","words":[[0,3,35.034,35.279,"nei"],[5,8,35.534,35.719,"fra"],[9,13,35.854,36.339,"irak"],[15,18,37.074,37.279,"jeg"],[19,26,37.294,37.639,"snakker"],[27,34,37.654,38.279,"arabisk"]],"speaker":"Haifa"},{"id":12,"start":39.894,"end":41.879,"text":"Du er ganske flink i norsk også.","zh":"你的挪威语也相当不错。","words":[[0,2,39.894,40.037,"du"],[3,5,40.037,40.177,"er"],[6,12,40.177,40.579,"ganske"],[13,18,40.634,41.039,"flink"],[19,20,41.054,41.179,"i"],[21,26,41.194,41.576,"norsk"],[27,31,41.576,41.879,"også"]],"speaker":"Magnus"},{"id":13,"start":43.054,"end":44.319,"text":"Unnskyld, kan du gjenta?","zh":"不好意思，你能重复一遍吗？","words":[[0,8,43.054,43.479,"unnskyld"],[10,13,43.734,43.886,"kan"],[14,16,43.886,43.987,"du"],[17,23,43.987,44.319,"gjenta"]],"speaker":"Haifa"},{"id":14,"start":45.054,"end":45.779,"text":"Jeg forstår ikke.","zh":"我不明白。","words":[[0,3,45.054,45.197,"jeg"],[4,11,45.197,45.546,"forstår"],[12,16,45.546,45.779,"ikke"]],"speaker":"Haifa"},{"id":15,"start":46.794,"end":48.179,"text":"Du er flink i norsk.","zh":"你的挪威语很好。","words":[[0,2,46.794,46.939,"du"],[3,5,46.954,47.099,"er"],[6,11,47.154,47.559,"flink"],[12,13,47.574,47.699,"i"],[14,19,47.714,48.179,"norsk"]],"speaker":"Magnus"},{"id":16,"start":49.414,"end":50.519,"text":"Hva betyr flink?","zh":"flink 是什么意思？","words":[[0,3,49.414,49.579,"hva"],[4,9,49.594,49.939,"betyr"],[10,15,50.054,50.519,"flink"]],"speaker":"Haifa"},{"id":17,"start":56.494,"end":57.199,"text":"Sammendrag.","zh":"摘要","words":[[0,10,56.494,57.199,"sammendrag"]]},{"id":18,"start":58.614,"end":61.019,"text":"Haifa og Magnus snakker sammen.","zh":"海法和马格努斯在聊天。","words":[[0,5,58.614,59.179,"haifa"],[6,8,59.274,59.419,"og"],[9,15,59.434,60.039,"magnus"],[16,23,60.234,60.679,"snakker"],[24,30,60.694,61.019,"sammen"]]},{"id":19,"start":62.894,"end":64.599,"text":"Haifa leser en avis.","zh":"海法在看报纸。","words":[[0,5,62.894,63.399,"haifa"],[6,11,63.574,63.947,"leser"],[12,14,63.947,64.077,"en"],[15,19,64.077,64.599,"avis"]]},{"id":20,"start":66.774,"end":69.979,"text":"Hun kommer fra Irak og snakker arabisk.","zh":"她来自伊拉克，会说阿拉伯语。","words":[[0,3,66.774,66.959,"hun"],[4,10,67.034,67.359,"kommer"],[11,14,67.374,67.559,"fra"],[15,19,67.594,68.179,"irak"],[20,22,68.734,68.857,"og"],[23,30,68.857,69.279,"snakker"],[31,38,69.354,69.979,"arabisk"]]},{"id":21,"start":71.794,"end":77.839,"text":"Hun forstår også engelsk, men Magnus og Haifa snakker norsk sammen.","zh":"她也懂英语，但马格努斯和海法用挪威语交谈。","words":[[0,3,71.794,71.999,"hun"],[4,11,72.054,72.639,"forstår"],[12,16,72.694,72.979,"også"],[17,24,73.054,73.639,"engelsk"],[26,29,75.034,75.199,"men"],[30,36,75.274,75.859,"magnus"],[37,39,75.894,76.019,"og"],[40,45,76.034,76.499,"haifa"],[46,53,76.794,77.139,"snakker"],[54,59,77.154,77.517,"norsk@pa-vei-norsk-adjective"