{"id":"pa-vei-1.C","bookId":"pa-vei-textbook","readingId":"1.C","title":"Hvordan staver du det?","audio":"audio/pa-vei/1.C.mp3","duration":60.312,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.8,"end":6.485,"text":"C. Hvordan staver du det?","zh":"C. 这个怎么拼写？","words":[[0,1,2.8,3.32,"c"],[3,10,4.96,5.465,"hvordan"],[11,17,5.6,6.183,"staver"],[18,20,6.183,6.285,"du"],[21,24,6.32,6.485,"det"]]},{"id":1,"start":8.98,"end":9.205,"text":"Hei!","zh":"你好！","words":[[0,3,8.98,9.205,"hei"]],"speaker":"Mann"},{"id":2,"start":10.02,"end":10.265,"text":"Hei!","zh":"你好！","words":[[0,3,10.02,10.265,"hei"]],"speaker":"Monica"},{"id":3,"start":11.32,"end":12.165,"text":"Hva heter du?","zh":"你叫什么名字？","words":[[0,3,11.32,11.505,"hva"],[4,9,11.62,12.033,"heter"],[10,12,12.033,12.165,"du"]],"speaker":"Mann"},{"id":4,"start":13.53,"end":15.795,"text":"Monica Nowak Jensen.","zh":"莫妮卡·诺瓦克·延森。","words":[[0,6,13.53,14.135,"monica"],[7,12,14.47,15.035,"nowak"],[13,19,15.27,15.795,"jensen"]],"speaker":"Monica"},{"id":5,"start":17.47,"end":19.98,"text":"Er det Monica med k eller c?","zh":"Monica 这个名字是用 k 还是 c 拼写？","words":[[0,2,17.47,17.642,"er"],[3,6,17.642,17.795,"det"],[7,13,17.81,18.355,"monica"],[14,17,18.59,18.755,"med"],[18,19,18.84,19.26,"k"],[20,25,19.29,19.535,"eller"],[26,27,19.56,19.98,"c"]],"speaker":"Mann"},{"id":6,"start":21.01,"end":21.9,"text":"Med c.","zh":"用 c。","words":[[0,3,21.01,21.235,"med"],[4,5,21.36,21.9,"c"]],"speaker":"Monica"},{"id":7,"start":23.05,"end":24.795,"text":"Hvordan staver du Nowak?","zh":"Nowak 怎么拼写？","words":[[0,7,23.05,23.435,"hvordan"],[8,14,23.49,23.892,"staver"],[15,17,23.892,24.015,"du"],[18,23,24.19,24.795,"nowak"]],"speaker":"Mann"},{"id":8,"start":26.15,"end":28.235,"text":"Unnskyld, jeg forstår ikke.","zh":"不好意思，我不明白。","words":[[0,8,26.15,26.655,"unnskyld"],[10,13,27.39,27.555,"jeg"],[14,21,27.57,28.003,"forstår"],[22,26,28.003,28.235,"ikke"]],"speaker":"Monica"},{"id":9,"start":29.43,"end":30.935,"text":"Kan du si det e