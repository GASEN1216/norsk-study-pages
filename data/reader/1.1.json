{"id":"1.1","title":"Hvor kommer du fra?","audio":"audio/1.1.mp3","duration":64.83,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.59,"text":"1.1 Hvor kommer du fra?","heading":true,"zh":"1.1 你从哪里来？","words":[[0,3,0.15,2.02,"1.1"],[4,8,2.02,2.46,"hvor"],[9,15,2.46,2.9,"kommer"],[16,18,2.9,3.12,"du"],[19,22,3.12,3.51,"fra"]]},{"id":1,"start":5.88,"end":6.84,"text":"God morgen!","zh":"早上好！","words":[[0,3,5.96,6.25,"god"],[4,10,6.25,6.76,"morgen"]]},{"id":2,"start":7.76,"end":9.8,"text":"Velkommen til norskkurs.","zh":"欢迎来到挪威语课。","words":[[0,9,7.84,8.38,"velkommen"],[10,13,8.38,8.84,"til"],[14,23,8.84,9.72,"norskkurs"]]},{"id":3,"start":10.5,"end":12.46,"text":"Jeg heter Håvard.","zh":"我叫霍瓦尔。","words":[[0,3,10.58,10.94,"jeg"],[4,9,10.94,11.52,"heter"],[10,16,11.52,12.38,"håvard"]]},{"id":4,"start":12.98,"end":15.06,"text":"Jeg kommer fra Norge.","zh":"我来自挪威。","words":[[0,3,13.06,13.48,"jeg"],[4,10,13.48,13.9,"kommer"],[11,14,13.9,14.36,"fra"],[15,20,14.36,14.98,"norge~546b56e35dd5"]]},{"id":5,"start":17.17,"end":17.8,"text":"Hei!","zh":"你好！","words":[[0,3,17.25,17.72,"hei"]]},{"id":6,"start":18.41,"end":20.25,"text":"Jeg heter Yousef.","zh":"我叫优素福。","words":[[0,3,18.49,18.84,"jeg"],[4,9,18.84,19.28,"heter"],[10,16,19.28,20.17,"yousef"]]},{"id":7,"start":20.93,"end":22.84,"text":"Jeg kommer fra Syria.","zh":"我来自叙利亚。","words":[[0,3,21.01,21.36,"jeg"],[4,10,21.36,21.64,"kommer"],[11,14,21.64,22.14,"fra"],[15,20,22.14,22.76,"syria~2ae242f98808"]]},{"id":8,"start":24.81,"end":25.93,"text":"God morgen!","zh":"早上好！","words":[[0,3,24.89,25.14,"god"],[4,10,25.14,25.85,"morgen"]]},{"id":9,"start":27.04,"end":28.6,"text":"Jeg heter Viola.","zh":"我叫维奥拉。","words":[[0,3,27.12,27.42,"jeg"],[4,9,27.42,27.82,"heter"],[10,15,27.82,28.52,"viola"]]},{"id":10,"start":29.43,"end":31.37,"text":"Jeg kommer fra Italia.","zh":"我来自意大利。","words":[[0,3,29.52,29.84,"jeg"],[4,10,29.84,30.18,"kommer"],[11,14,30.18,30.48,"fra"],[15,21,30.48,31.29,"italia"]]},{"id":11,"start":33.41,"end":34.03,"text":"Hei!","zh":"你好！","words":[[0,3,33.49,33.95,"hei"]]},{"id":12,"start":34.65,"end":39.13,"text":"Jeg heter Biniam og kommer fra Eritrea.","zh":"我叫比尼亚姆，来自厄立特里亚。","words":[[0,3,34.73,35.09,"jeg"],[4,9,35.09,35.61,"heter"],[10,16,35.61,36.19,"biniam"],[17,19,36.19,37.17,"og"],[20,26,37.17,37.57,"kommer"],[27,30,37.57,38.13,"fra"],[31,38,38.13,39.05,"eritrea"]]},{"id":13,"start":41.08,"end":41.7,"text":"Hei!","zh":"你好！","words":[[0,3,41.16,41.62,"hei"]]},{"id":14,"start":42.52,"end":46.88,"text":"Jeg heter Sompit, og jeg kommer fra Thailand.","zh":"我叫松皮特，我来自泰国。","words":[[0,3,42.6,43.02,"jeg"],[4,9,43.02,43.46,"heter"],[10,16,43.46,44.2,"sompit"],[18,20,44.76,45.14,"og"],[21,24,45.14,45.42,"jeg"],[25,31,45.42,45.7,"kommer"],[32,35,45.7,46.08,"fra"],[36,44,46.08,46.8,"thailand"]]},{"id":15,"start":48.82,"end":49.4,"text":"Hei!","zh":"你好！","words":[[0,3,48.9,49.32,"hei"]]},{"id":16,"start":49.79,"end":52.68,"text":"Jeg heter Marek og kommer fra Polen.","zh":"我叫马雷克，来自波兰。","words":[[0,3,49.87,50.18,"jeg"],[4,9,50.18,50.58,"heter"],[10,15,50.58,51.2,"marek"],[16,18,51.2,51.52,"og"],[19,25,51.52,51.8,"kommer"],[26,29,51.8,52.08,"fra"],[30,35,52.08,52.6,"polen~488e57c60a08"]]},{"id":17,"start":52.68,"end":55.64,"text":"God morgen!","zh":"早上好！","words":[[0,3,54.18,55.0,"god"],[4,10,55.0,55.56,"morgen"]]},{"id":18,"start":56.47,"end":58.19,"text":"Jeg heter Hawa.","zh":"我叫哈娃。","words":[[0,3,56.55,57.0,"jeg"],[4,9,57.0,57.44,"heter"],[10,14,57.44,58.11,"hawa"]]},{"id":19,"start":58.9,"end":61.06,"text":"Jeg kommer fra Somalia.","zh":"我来自索马里。","words":[[0,3,58.98,59.28,"jeg"],[4,10,59.28,59.62,"kommer"],[11,14,59.62,60.0,"fra"],[15,22,60.0,60.98,"somalia"]]}],"lexicon":{"1.1":{"lemma":"1.1","zh":"第 1.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"biniam":{"lemma":"Biniam","zh":"比尼亚姆（人名）","pos":"专名","ref":"1-021","clip":"pronunciation/e8a134405844f1e3c9ba.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786