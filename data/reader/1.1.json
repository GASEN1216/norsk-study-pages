{"id":"1.1","title":"Hvor kommer du fra?","audio":"audio/1.1.mp3","duration":64.83,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.59,"text":"1.1 Hvor kommer du fra?","heading":true,"zh":"1.1 你从哪里来？","words":[[0,3,0.15,2.02,"1.1"],[4,8,2.02,2.46,"hvor"],[9,15,2.46,2.9,"kommer"],[16,18,2.9,3.12,"du"],[19,22,3.12,3.51,"fra"]]},{"id":1,"start":5.92,"end":6.92,"text":"God morgen!","zh":"早上好！","words":[[0,3,5.98,6.3,"god"],[4,10,6.3,6.77,"morgen"]]},{"id":2,"start":7.79,"end":9.86,"text":"Velkommen til norskkurs.","zh":"欢迎来到挪威语课。","words":[[0,9,7.85,8.66,"velkommen"],[10,13,8.66,8.94,"til"],[14,23,8.94,9.71,"norskkurs"]]},{"id":3,"start":10.54,"end":12.53,"text":"Jeg heter Håvard.","zh":"我叫霍瓦尔。","words":[[0,3,10.6,11.04,"jeg"],[4,9,11.04,11.78,"heter"],[10,16,11.78,12.38,"håvard"]]},{"id":4,"start":13.1,"end":15.12,"text":"Jeg kommer fra Norge.","zh":"我来自挪威。","words":[[0,3,13.16,13.6,"jeg"],[4,10,13.6,14.12,"kommer"],[11,14,14.12,14.52,"fra"],[15,20,14.52,14.96,"norge~546b56e35dd5"]]},{"id":5,"start":17.21,"end":17.86,"text":"Hei!","zh":"你好！","words":[[0,3,17.27,17.71,"hei"]]},{"id":6,"start":18.45,"end":20.3,"text":"Jeg heter Yousef.","zh":"我叫优素福。","words":[[0,3,18.5,18.96,"jeg"],[4,9,18.96,19.46,"heter"],[10,16,19.46,20.16,"yousef"]]},{"id":7,"start":20.96,"end":22.89,"text":"Jeg kommer fra Syria.","zh":"我来自叙利亚。","words":[[0,3,21.02,21.5,"jeg"],[4,10,21.5,21.98,"kommer"],[11,14,21.98,22.24,"fra"],[15,20,22.24,22.74,"syria~2ae242f98808"]]},{"id":8,"start":24.85,"end":25.99,"text":"God morgen!","zh":"早上好！","words":[[0,3,24.91,25.24,"god"],[4,10,25.24,25.84,"morgen"]]},{"id":9,"start":27.07,"end":28.67,"text":"Jeg heter Viola.","zh":"我叫维奥拉。","words":[[0,3,27.13,27.54,"jeg"],[4,9,27.54,27.96,"heter"],[10,15,27.96,28.52,"viola"]]},{"id":10,"start":29.47,"end":31.43,"text":"Jeg kommer fra Italia.","zh":"我来自意大利。","words":[[0,3,29.53,30.0,"jeg"],[4,10,30.0,30.32,"kommer"],[11,14,30.32,30.64,"fra"],[15,21,30.64,31.28,"italia"]]},{"id":11,"start":33.44,"end":34.09,"text":"Hei!","zh":"你好！","words":[[0,3,33.5,33.94,"hei"]]},{"id":12,"start":34.69,"end":39.19,"text":"Jeg heter Biniam og kommer fra Eritrea.","zh":"我叫比尼亚姆，来自厄立特里亚。","words":[[0,3,34.75,35.24,"jeg"],[4,9,35.24,35.78,"heter"],[10,16,35.78,36.41,"biniam"],[17,19,37.1,37.26,"og"],[20,26,37.26,37.88,"kommer"],[27,30,37.88,38.32,"fra"],[31,38,38.32,39.04,"eritrea"]]},{"id":13,"start":41.11,"end":41.73,"text":"Hei!","zh":"你好！","words":[[0,3,41.17,41.58,"hei"]]},{"id":14,"start":42.6,"end":46.94,"text":"Jeg heter Sompit, og jeg kommer fra Thailand.","zh":"我叫松皮特，我来自泰国。","words":[[0,3,42.66,43.16,"jeg"],[4,9,43.16,43.7,"heter"],[10,16,43.7,44.48,"sompit"],[18,20,45.04,45.22,"og"],[21,24,45.22,45.54,"jeg"],[25,31,45.54,45.94,"kommer"],[32,35,45.94,46.18,"fra"],[36,44,46.18,46.79,"thailand"]]},{"id":15,"start":48.85,"end":49.46,"text":"Hei!","zh":"你好！","words":[[0,3,48.91,49.31,"hei"]]},{"id":16,"start":49.83,"end":52.73,"text":"Jeg heter Marek og kommer fra Polen.","zh":"我叫马雷克，来自波兰。","words":[[0,3,49.89,50.28,"jeg"],[4,9,50.28,50.74,"heter"],[10,15,50.74,51.44,"marek"],[16,18,51.44,51.6,"og"],[19,25,51.6,51.96,"kommer"],[26,29,51.96,52.16,"fra"],[30,35,52.16,52.59,"polen~488e57c60a08"]]},{"id":17,"start":54.7,"end":55.7,"text":"God morgen!","zh":"早上好！","words":[[0,3,54.76,55.1,"god"],[4,10,55.1,55.55,"morgen"]]},{"id":18,"start":56.57,"end":58.24,"text":"Jeg heter Hawa.","zh":"我叫哈娃。","words":[[0,3,56.63,57.14,"jeg"],[4,9,57.14,57.64,"heter"],[10,14,57.64,58.09,"hawa"]]},{"id":19,"start":58.95,"end":61.09,"text":"Jeg kommer fra Somalia.","zh":"我来自索马里。","words":[[0,3,59.01,59.42,"jeg"],[4,10,59.42,59.82,"kommer"],[11,14,59.82,60.28,"fra"],[15,22,60.28,60.95,"somalia"]]}],"lexicon":{"1.1":{"lemma":"1.1","zh":"第 1.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"biniam":{"lemma":"Biniam","zh":"比尼亚姆（人名）","pos":"专名","ref":"1-021","clip":"pronunciation/e8a134405844f1e3c9ba.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea