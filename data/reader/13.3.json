{"id":"13.3","title":"Yrkesfaglig opplæring i Norge","audio":"audio/13.3.mp3","duration":191.71,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.97,"text":"13.3 Yrkesfaglig opplæring i Norge","heading":true,"zh":"13.3 挪威的职业教育","words":[[0,4,0.15,1.39,"13.3"],[5,16,2.68,3.6,"yrkesfaglig"],[17,26,3.6,4.18,"opplæring"],[27,28,4.18,4.4,"i"],[29,34,4.4,4.89,"norge~546b56e35dd5"]]},{"id":1,"start":6.64,"end":9.23,"text":"Pia vil bli ambulansesjåfør.","zh":"皮娅想当救护车司机。","words":[[0,3,6.72,7.17,"pia"],[4,7,7.17,7.61,"vil"],[8,11,7.61,7.87,"bli"],[12,27,7.87,9.15,"ambulansesjåfør"]]},{"id":2,"start":10.4,"end":16.45,"text":"Hun går på Vg1 helse- og oppvekstfag på videregående skole i hjembyen sin.","zh":"她在家乡的高中读一年级（Vg1）健康与成长服务专业。","words":[[0,3,10.48,10.7,"hun"],[4,7,10.7,10.98,"går~35aeb6f96a6d"],[8,10,10.98,11.2,"på~6ded53510870"],[11,14,11.2,11.9,"vg1"],[15,20,11.9,12.62,"helse"],[22,24,12.68,12.88,"og"],[25,36,12.88,13.88,"oppvekstfag"],[37,39,13.88,14.12,"på"],[40,52,14.12,14.78,"videregående"],[53,58,14.78,15.22,"skole"],[59,60,15.22,15.46,"i"],[61,69,15.46,15.98,"hjembyen"],[70,73,15.98,16.37,"sin"]]},{"id":3,"start":17.68,"end":26.14,"text":"Neste år skal hun gå et år på ambulansefag Vg2, og så må hun være lærling i to år etter det.","zh":"明年她要在二年级（Vg2）读一年急救医疗专业，之后还得当两年学徒。","words":[[0,5,17.76,18.21,"neste~367b261d40fe"],[6,8,18.21,18.55,"år"],[9,13,18.55,19.17,"skal"],[14,17,19.17,19.33,"hun"],[18,20,19.33,19.53,"gå~888339907833"],[21,23,19.53,19.87,"et~054dde72f37b"],[24,26,19.87,20.11,"år"],[27,29,20.11,20.31,"på~6ded53510870"],[30,42,20.31,21.31,"ambulansefag"],[43,46,21.31,22.17,"vg2"],[48,50,22.72,23.02,"og"],[51,53,23.02,23.18,"så~4a7ed2bb1489"],[54,56,23.18,23.56,"må"],[57,60,23.56,23.72,"hun"],[61,65,23.72,23.9,"være"],[66,73,23.9,24.58,"lærling"],[74,75,24.58,24.96,"i~38abdafa800a"],[76,78,24.96,25.18,"to"],[79,81,25.18,25.44,"år"],[82,87,25.44,25.78,"etter~66b9279ef1f2"],[88,91,25.78,26.06,"det"]]},{"id":4,"start":27.38,"end":35.15,"text":"Etter lærlingtida si kan hun ta fagbrev og nå målet sitt som er å jobbe som ambulansearbeider.","zh":"学徒期结束后，她就可以考职业资格证书，实现她的目标：当一名救护人员。","words":[[0,5,27.46,27.97,"etter"],[6,17,27.97,28.83,"lærlingtida"],[18,20,28.83,29.09,"si~71b7a59b5fad"],[21,24,29.09,29.75,"kan"],[25,28,29.75,29.93,"hun"],[29,31,29.93,30.11,"ta~e1d422154b52"],[32,39,30.11,30.87,"fagbrev"],[40,42,30.87,31.41,"og"],[43,45,31.41,31.61,"nå~4378228f3149"],[46,51,31.61,32.07,"målet"],[52,56,32.07,32.27,"sitt~9563d0679965"],[57,60,32.27,32.69,"som~b7970b8f941e"],[61,63,32.69,32.95,"er"],[64,65,32.95,33.15,"å~0583da7a620a"],[66,71,33.15,33.47,"jobbe"],[72,75,33.47,33.71,"som~ac9866165f47"],[76,93,33.71,34.39,"ambulansearbeider"]]},{"id":5,"start":36.91,"end":39.5,"text":"Arne skal bli rørlegger.","zh":"阿尔内将成为一名水管工。","words":[[0,4,36.99,37.62,"arne"],[5,9,37.62,38.42,"skal"],[10,13,38.42,38.64,"bli"],[14,23,38.64,39.42,"rørlegger"]]},{"id":6,"start":40.43,"end":50.63,"text":"Han gikk først to år på yrkesfaglig utdanningsprogram på videregående skole, og nå er han lærling i et rørleggerfirma.","zh":"他先在高中读了两年职业教育课程，现在在一家水管工程公司当学徒。","words":[[0,3,40.51,40.74,"han"],[4,8,40.74,41.06,"gikk~b471940dd857"],[9,14,41.06,41.48,"først"],[15,17,41.48,41.78,"to"],[18,20,41.78,42.18,"år"],[21,23,42.18,42.42,"på~5702a4a9739f"],[24,35,42.42,43.28,"yrkesfaglig"],[36,53,43.28,44.3,"utdanningsprogram"],[54,56,44.3,44.66,"på"],[57,69,44.66,45.32,"videregående"],[70,75,45.32,45.7,"skole"],[77,79,46.44,46.74,"og"],[80,82,46.74,47.04,"nå~d531d47a7712"],[83,85,47.04,47.7,"er"],[86,89,47.7,47.9,"han"],[90,97,47.9,48.48,"lærling"],[98,99,48.48,49.06,"i"],[100,102,49.06,49.24,"et~054dde72f37b"],[103,117,49.24,50.55,"rørleggerfirma"]]},{"id":7,"start":51.95,"end":57.68,"text":"Om to år blir han ferdig med lærlingtida si og kan ta fagbrev.","zh":"两年后他的学徒期就结束了，可以考职业资格证书。","words":[[0,2,52.03,52.34,"om~073cc9a18380"],[3,5,52.36,52.66,"to"],[6,8,52.66,53.04,"år"],[9,13,53.04,53.64,"blir"],[14,17,53.64,53.78,"han"],[18,24,53.78,54.26,"ferdig"],[25,28,54.26,54.48,"med~63839ae1a021"],[29,40,54.48,55.3,"lærlingtida"],[41,43,55.3,55.48,"si~21de5ccc8df9"],[44,46,55.48,56.25,"og"],[47,50,56.25,56.47,"kan"],[51,53,56.47,56.75,"ta~e1d422154b52"],[54,61,56.75,57.6,"fagbrev"]]},{"id":8,"start":59.65,"end":61.71,"text":"Mona skal bli bonde.","zh":"莫娜将成为一名农民。","words":[[0,4,59.73,60.26,"mona"],[5,9,60.26,60.88,"skal"],[10,13,60.88,61.12,"bli"],[14,19,61.12,61.63,"bonde"]]},{"id":9,"start":62.69,"end":69.14,"text":"Hun er odelsjente og skal ta over gården etter foreldrene sine når de blir gamle.","zh":"她是农场的优先继承人，等父母老了，她将接手父母的农场。","words":[[0,3,62.77,62.96,"hun"],[4,6,62.96,63.3,"er"],[7,17,63.3,64.4,"odelsjente"],[18,20,64.86,65.14,"og"],[21,25,65.14,65.28,"skal"],[26,28,65.28,65.6,"ta~972817dcd7df"],[29,33,65.6,65.82,"over~5ee3b2c88f91"],[34,40,65.82,66.36,"gården"],[41,46,66.36,66.76,"etter~6a3814f18512"],[47,57,66.76,67.34,"foreldrene"],[58,62,67.34,67.76,"sine"],[63,66,67.76,68.18,"når~8cac549467d0"],[67,69,68.18,68.36,"de"],[70,74,68.36,68.54,"blir"],[75,80,68.54,69.06,"gamle"]]},{"id":10,"start":70.18,"end":77.85,"text":"For å bli bonde skal hun ta Vg1 naturbruk og så Vg2 og Vg3 landbruk.","zh":"为了成为农民，她要先读一年级（Vg1）自然资源利用专业，然后读二年级和三年级（Vg2、Vg3）农业专业。","words":[[0,3,70.26,70.86,"for~6bd3c0f13dd3"],[4,5,70.86,70.86,"å~0583da7a620a"],[6,9,70.86,70.86,"bli"],[10,15,70.86,71.42,"bonde"],[16,20,71.42,71.7,"skal"],[21,24,71.7,71.92,"hun"],[25,27,71.92,72.21,"ta~d0a79a1d6de4"],[28,31,72.24,73.24,"vg1"],[32,41,73.24,74.2,"naturbruk"],[42,44,74.2,74.78,"og"],[45,47,74.78,75.14,"så~4a7ed2bb1489"],[48,51,75.14,76.04,"vg2"],[52,54,76.04,76.32,"og"],[55,58,76.32,76.92,"vg3"],[59,67,76.92,77.77,"landbruk"]]},{"id":11,"start":78.56,"end":86.55,"text":"Etter tre år på videregående skole får hun tittelen agronom, som betyr det samme som bonde.","zh":"读完三年高中后，她将获得“农艺师”的称号，意思和农民一样。","words":[[0,5,78.64,79.32,"etter"],[6,9,79.32,79.64,"tre"],[10,12,79.64,79.92,"år"],[13,15,79.92,80.14,"på"],[16,28,80.14,80.74,"videregående"],[29,34,80.74,81.14,"skole"],[35,38,81.14,81.76,"får"],[39,42,81.76,81.98,"hun"],[43,51,81.98,82.48,"tittelen"],[52,59,82.48,83.76,"agronom"],[61,64,84.36,84.6,"som~b7970b8f941e"],[65,70,84.6,85.0,"betyr"],[71,74,85.0,85.26,"det~98b19107f9a1"],[75,80,85.26,85.62,"samme"],[81,84,85.62,85.82,"som~41be00d4cf1f"],[85,90,85.82,86.47,"bonde"]]},{"id":12,"start":87.48,"end":90.23,"text":"Hun gleder seg til å jobbe på gården sin.","zh":"她盼着在自己的农场上工作。","words":[[0,3,87.56,87.79,"hun"],[4,10,87.79,88.27,"gleder"],[11,14,88.27,88.53,"seg"],[15,18,88.53,88.87,"til~053dd24981ff"],[19,20,88.87,89.01,"å~0583da7a620a"],[21,26,89.01,89.29,"jobbe"],[27,29,89.29,89.47,"på"],[30,36,89.47,89.77,"gården"],[37,40,89.77,90.15,"sin"]]},{"id":13,"start":92.06,"end":95.12,"text":"Martin har lyst til å bli sykepleier.","zh":"马丁想当护士。","words":[[0,6,92.14,92.55,"martin"],[7,10,92.55,93.29,"har"],[11,15,93.29,93.59,"lyst~8d3c7effeabc"],[16,19,93.59,93.83,"til~99ccdd3453b0"],[20,21,93.83,93.93,"å~0583da7a620a"],[22,25,93.93,94.07,"bli"],[26,36,94.07,95.04,"sykepleier"]]},{"id":14,"start":95.13,"end":105.19,"text":"Han gikk på Vg1 helse- og oppvekstfag og Vg2 helsearbeiderfag da han gikk på videregående skole.","zh":"他上高中时读的是一年级（Vg1）健康与成长服务专业和二年级（Vg2）护理员专业。","words":[[0,3,95.82,96.4,"han"],[4,8,96.4,96.76,"gikk~3c6cb4fabf8c"],[9,11,96.76,97.02,"på~6ded53510870"],[12,15,97.02,97.78,"vg1"],[16,21,97.78,98.52,"helse"],[23,25,98.72,98.72,"og"],[26,37,98.72,99.66,"oppvekstfag"],[38,40,100.34,100.44,"og"],[41,44,100.44,101.1,"vg2"],[45,61,101.1,102.9,"helsearbeiderfag"],[62,64,103.0,103.22,"da~3ded9627966c"],[65,68,103.22,103.48,"han"],[69,73,103.48,103.72,"gikk~b33c04bf7fc2"],[74,76,103.72,103.9,"på"],[77,89,103.9,104.58,"videregående"],[90,95,104.58,105.11,"skole"]]},{"id":15,"start":106.16,"end":108.61,"text":"Etter det var han lærling i to år.","zh":"之后他当了两年学徒。","words":[[0,5,106.23,106.64,"etter"],[6,9,106.64,106.86,"det"],[10,13,106.86,107.06,"var"],[14,17,107.06,107.24,"han"],[18,25,107.24,107.74,"lærling"],[26,27,107.74,107.94,"i~38abdafa800a"],[28,30,107.94,108.18,"to"],[31,33,108.18,108.53,"år"]]},{"id":16,"start":109.36,"end":119.42,"text":"Nå har han jobbet som helsefagarbeider på et sykehus i seks år, men han er ikke helt fornøyd med lønna si og arbeidsoppgavene sine.","zh":"现在他已经在一家医院当了六年护理员，但他对自己的工资和工作内容不太满意。","words":[[0,2,109.44,109.85,"nå~d531d47a7712"],[3,6,109.85,110.07,"har~8b9792170cca"],[7,10,110.07,110.23,"han"],[11,17,110.23,110.55,"jobbet~bec4250eb05a"],[18,21,110.55,110.73,"som~ac9866165f47"],[22,38,110.73,111.87,"helsefagarbeider"],[39,41,111.87,112.15,"på"],[42,44,112.15,112.35,"et~054dde72f37b"],[45,52,112.35,113.05,"sykehus"],[53,54,113.05,113.35,"i~ff6caa00ad66"],[55,59,113.35,113.71,"seks"],[60,62,113.71,113.95,"år"],[64,67,114.73,115.09,"men"],[68,71,115.09,115.41,"han"],[72,74,115.41,115.59,"er"],[75,79,115.59,115.83,"ikke"],[80,84,115.83,116.21,"helt~edf97eae2825"],[85,92,116.21,116.67,"fornøyd"],[93,96,116.67,116.83,"med~98c8c4fd376d"],[97,102,116.83,117.25,"lønna"],[103,105,117.25,117.45,"si~21de5ccc8df9"],[106,108,117.45,117.77,"og"],[109,125,117.77,118.89,"arbeidsoppgavene"],[126,130,118.89,119.34,"sine"]]},{"id":17,"start":120.21,"end":126.46,"text":"Neste år skal han ta et år påbygging på videregående skole og få studiekompetanse.","zh":"明年他要在高中读一年补充课程，取得高等教育入学资格。","words":[[0,5,120.29,120.67,"neste~367b261d40fe"],[6,8,120.67,121.29,"år"],[9,13,121.29,121.57,"skal"],[14,17,121.57,121.79,"han"],[18,20,121.79,121.95,"ta~d0a79a1d6de4"],[21,23,121.99,122.21,"et~054dde72f37b"],[24,26,122.21,122.43,"år"],[27,36,122.43,123.25,"påbygging"],[37,39,123.25,123.63,"på"],[40,52,123.63,124.19,"videregående"],[53,58,124.19,124.57,"skole"],[59,61,124.57,124.83,"og"],[62,64,124.83,124.99,"få~65b84e08cd43"],[65,81,124.99,126.38,"studiekompetanse"]]},{"id":18,"start":127.35,"end":131.51,"text":"Så vil han ta sykepleierutdanning og bli sykepleier.","zh":"然后他想读护理专业，成为护士。","words":[[0,2,127.43,127.78,"så~4a7ed2bb1489"],[3,6,127.78,127.98,"vil"],[7,10,127.98,128.12,"han"],[11,13,128.32,128.4,"ta~84801ec429d6"],[14,33,128.4,129.84,"sykepleierutdanning"],[34,36,129.84,130.36,"og"],[37,40,130.36,130.56,"bli"],[41,51,130.56,131.44,"sykepleier"]]},{"id":19,"start":135.22,"end":135.91,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,135.3,135.83,"fakta"]]},{"id":20,"start":136.88,"end":138.82,"text":"Videregående skole i Norge","subheading":true,"zh":"挪威的高中","words":[[0,12,136.96,137.6,"videregående"],[13,18,137.6,138.0,"skole"],[19,20,138.0,138.26,"i"],[21,26,138.26,138.74,"norge~546b56e35dd5"]]},{"id":21,"start":139.35,"end":149.19,"text":"På videregående skole i Norge kan du velge et studieforberedende utdanningsprogram eller et yrkesfaglig utdanningsprogram.","zh":"在挪威上高中，你可以选择升学预备课程或职业教育课程。","words":[[0,2,139.8,140.26,"på"],[3,15,140.26,140.98,"videregående"],[16,21,140.98,141.38,"skole"],[22,23,141.38,141.54,"i"],[24,29,141.54,141.9,"norge~546b56e35dd5"],[30,33,141.9,142.44,"kan"],[34,36,142.44,142.54,"du"],[37,42,142.54,142.92,"velge"],[43,45,142.92,143.14,"et~054dde72f37b"],[46,64,143.14,144.56,"studieforberedende"],[65,82,144.56,145.66,"utdanningsprogram"],[83,88,146.16,146.58,"eller"],[89,91,146.58,146.86,"et~054dde72f37b"],[92,103,146.86,147.84,"yrkesfaglig"],[104,121,147.84,149.11,"utdanningsprogram"]]},{"id":22,"start":150.02,"end":160.46,"text":"Tre år på studieforberedende utdanningsprogram gir studiekompetanse, og du kan søke høyere utdanning på universitet eller høyskole.","zh":"读三年升学预备课程可以取得高等教育入学资格，你可以申请上大学或学院。","words":[[0,3,150.1,150.4,"tre"],[4,6,150.4,150.78,"år"],[7,9,150.78,151.02,"på"],[10,28,151.02,152.24,"studieforberedende"],[29,46,152.24,153.3,"utdanningsprogram"],[47,50,153.3,153.7,"gir"],[51,67,153.7,155.02,"studiekompetanse"],[69,71,155.7,155.82,"og"],[72,74,155.82,155.92,"du"],[75,78,155.92,156.1,"kan"],[79,83,156.1,156.46,"søke"],[84,90,156.46,156.9,"høyere~1b2a22734b36"],[91,100,156.9,157.5,"utdanning"],[101,103,157.5,157.9,"på"],[104,115,157.9,159.06,"universitet"],[116,121,159.06,159.6,"eller"],[122,130,159.6,160.38,"høyskole"]]},{"id":23,"start":161.47,"end":171.28,"text":"Yrkesfaglig utdanningsprogram gir ikke studiekompetanse, men du kan få en yrkesutdanning og ta fagbrev i løpet av fire år.","zh":"职业教育课程不提供高等教育入学资格，但你可以在四年内接受职业教育并考取职业资格证书。","words":[[0,11,161.54,162.82,"yrkesfaglig"],[12,29,162.82,163.66,"utdanningsprogram"],[30,33,163.66,164.26,"gir"],[34,38,164.26,164.72,"ikke"],[39,55,164.72,165.7,"studiekompetanse"],[57,60,166.42,166.78,"men"],[61,63,166.78,166.98,"du"],[64,67,166.98,167.16,"kan"],[68,70,167.16,167.36,"få~65b84e08cd43"],[71,73,167.36,167.54,"en~a939a9e56dc5"],[74,88,167.54,168.5,"yrkesutdanning"],[89,91,168.5,168.74,"og"],[92,94,168.74,169.0,"ta~e1d422154b52"],[95,102,169.0,169.72,"fagbrev"],[103,104,169.72,170.1,"i~cb24e2d831ad"],[105,110,170.1,170.38,"løpet"],[111,113,170.38,170.52,"av~e5733f90a2a5"],[114,118,170.52,170.76,"fire"],[119,121,170.76,171.2,"år"]]},{"id":24,"start":172.16,"end":177.05,"text":"Du kan også ta et år påbygging senere og få studiekompetanse.","zh":"你也可以以后再读一年补充课程，取得高等教育入学资格。","words":[[0,2,172.24,172.33,"du"],[3,6,172.33,172.51,"kan"],[7,11,172.51,172.79,"også"],[12,14,172.79,173.07,"ta~d0a79a1d6de4"],[15,17,173.07,173.37,"et~054dde72f37b"],[18,20,173.37,173.63,"år"],[21,30,173.63,174.37,"påbygging"],[31,37,174.37,174.97,"senere"],[38,40,174.97,175.43,"og"],[41,43,175.43,175.61,"få~65b84e08cd43"],[44,60,175.61,176.97,"studiekompetanse"]]},{"id":25,"start":177.66,"end":188.65,"text":"Du kan lese mer om forskjellige yrker og om utdanning på nettsidene utdanning.no eller på vilbli.no.","zh":"你可以在 utdanning.no 或 vilbli.no 网站上了解更多关于各种职业和教育的信息。","words":[[0,2,177.74,178.35,"du"],[3,6,178.35,178.55,"kan"],[7,11,178.55,178.89,"lese"],[12,15,178.89,179.17,"mer~6e9e1ecc8b41"],[16,18,179.17,179.47,"om~52c0bdc828db"],[19,31,179.47,180.11,"forskjellige"],[32,37,180.11,180.59,"yrker"],[38,40,180.59,180.81,"og"],[41,43,180.81,181.03,"om~52c0bdc828db"],[44,53,181.03,181.59,"utdanning"],[54,56,181.