{"id":"pa-vei-1.A","bookId":"pa-vei-textbook","readingId":"1.A","title":"Jeg heter ...","audio":"audio/pa-vei/1.A.mp3","duration":57.828,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.76,"end":2.805,"text":"A. Jeg heter ...","zh":"A. 我叫……","words":[[0,1,0.76,1.1,"a"],[3,6,1.94,2.185,"jeg"],[7,12,2.28,2.805,"heter"]]},{"id":1,"start":4.66,"end":5.245,"text":"God dag!","zh":"你好！","words":[[0,3,4.66,4.873,"god"],[4,7,4.873,5.245,"dag"]],"speaker":"Anne"},{"id":2,"start":6.16,"end":9.185,"text":"Jeg heter Anne Bjørnsen og er fra Norge.","zh":"我叫安妮·比约恩森，来自挪威。","words":[[0,3,6.16,6.405,"jeg"],[4,9,6.5,6.865,"heter"],[10,14,6.98,7.285,"anne"],[15,23,7.32,7.885,"bjørnsen"],[24,26,8.22,8.363,"og"],[27,29,8.363,8.525,"er"],[30,33,8.56,8.745,"fra"],[34,39,8.78,9.185,"norge"]],"speaker":"Anne"},{"id":3,"start":10.2,"end":12.205,"text":"Jeg snakker norsk og engelsk.","zh":"我会说挪威语和英语。","words":[[0,3,10.2,10.385,"jeg"],[4,11,10.4,10.745,"snakker"],[12,17,10.84,11.245,"norsk@pa-vei-norsk-adjective"],[18,20,11.46,11.585,"og"],[21,28,11.64,12.205,"engelsk"]],"speaker":"Anne"},{"id":4,"start":14.65,"end":14.835,"text":"Hei!","zh":"你好！","words":[[0,3,14.65,14.835,"hei"]],"speaker":"Pablo"},{"id":5,"start":15.83,"end":17.575,"text":"Jeg heter Pablo Rodriguez.","zh":"我叫巴勃罗·罗德里格斯。","words":[[0,3,15.83,16.015,"jeg"],[4,9,16.05,16.375,"heter"],[10,15,16.43,16.835,"pablo"],[16,25,16.95,17.575,"rodriguez"]],"speaker":"Pablo"},{"id":6,"start":18.49,"end":19.835,"text":"Jeg kommer fra Argentina.","zh":"我来自阿根廷。","words":[[0,3,18.49,18.675,"jeg"],[4,10,18.69,19.013,"kommer"],[11,14,19.013,19.195,"fra"],[15,24,19.23,19.835,"argentina"]],"speaker":"Pablo"},{"id":7,"start":20.73,"end":21.835,"text":"Jeg snakker spansk.","zh":"我会说西班牙语。","words":[[0,3,20.73,20.935,"jeg"],[4,11,20.97,21.335,"snakker"],[12,18,21.35,21.835,"spansk"]],"speaker":"Pablo"},{"id":8,"start":23.93,"end":24.275,"text":"Hallo!","zh":"你好！","words":[[0,5,23.93,24.275,"hallo"]],"speaker":"Monica"},{"id":9,"start":25.37,"end":28.395,"text":"Jeg heter Monica Nowak Jensen.","zh":"我叫莫妮卡·诺瓦克·延森。","words":[[0,3,25.37,25.595,"jeg"],[4,9,25.61,26.095,"heter"],[10,16,26.35,26.895,"monica"],[17,22,27.17,27.775,"nowak"],[23,29,27.87,28.395,"jensen"]],"speaker":"Monica"},{"id":10,"start":29.53,"end":30.855,"text":"Jeg kommer fra Polen.","zh":"我来自波兰。","words":[[0,3,29.53,29.695,"jeg"],[4,10,29.75,30.115,"kommer"],[11,14,30.15,30.335,"fra"],[15,20,30.39,30.855,"polen"]],"speaker":"Monica"},{"id":11,"start":32.07,"end":34.335,"text":"Jeg snakker polsk og tysk.","zh":"我会说波兰语和德语。","words":[[0,3,32.07,32.235,"jeg"],[4,11,32.25,32.635,"snakker"],[12,17,32.65,33.275,"polsk"],[18,20,33.71,33.855,"og"],[21,25,33.89,34.335,"tysk"]],"speaker":"Monica"},{"id":12,"start":36.65,"end":36.895,"text":"Hei!","zh":"你好！","words":[[0,3,36.65,36.895,"hei"]],"speaker":"Haifa"},{"id":13,"start":38.07,"end":39.755,"text":"Jeg heter Haifa Al Rammah.","zh":"我叫海法·阿尔·拉马赫。","words":[[0,3,38.07,38.252,"jeg"],[4,9,38.252,38.595,"heter"],[10,15,38.63,39.075,"haifa"],[16,18,39.27,39.415,"al"],[19,25,39.43,39.755,"rammah"]],"speaker":"Haifa"},{"id":14,"start":40.55,"end":41.695,"text":"Jeg kommer fra Irak.","zh":"我来自伊拉克。","words":[[0,3,40.55,40.735,"jeg"],[4,10,40.75,41.043,"kommer"],[11,14,41.043,41.215,"fra"],[15,19,41.27,41.695,"irak"]],"speaker":"Haifa"},{"id":15,"start":42.55,"end":44.675,"text":"Jeg snakker arabisk og engelsk.","zh":"我会说阿拉伯语和英语。","words":[[0,3,42.55,42.712,"jeg"],[4,11,42.712,43.095,"snakker"],[12,19,43.15,43.815,"arabisk"],[20,22,44.01,44.135,"og"],[23,30,44.15,44.675,"engelsk"]],"speaker":"Haifa"},{"id":16,"start":47.67,"end":48.155,"text":"God dag!","zh":"你好！","words":[[0,3,47.67,47.862,"god"],[4,7,47.862,48.155,"dag"]],"speaker":"Safer"},{"id":17,"start":48.99,"end":52.655,"text":"Jeg heter Safer Adib og kommer fra Somalia.","zh":"我叫萨费尔·阿迪布，来自索马里。","words":[[0,3,48.99,49.183,"jeg"],[4,9,49.183,49.475,"heter"],[10,15,49.53,50.015,"safer"],[16,20,50.07,50.455,"adib"],[21,23,51.07,51.195,"og"]