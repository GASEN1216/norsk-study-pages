{"id":"ty-conversation-9.1","bookId":"ty-conversation-guide","readingId":"9.1","title":"Booking a room at a hotel","audio":"audio/ty-conversation/9.1.mp3","duration":59.846531,"synthetic":false,"sentences":[{"id":0,"start":17.71,"end":19.695,"speaker":"Receptionist","text":"Nordlys Hotel, vær så god?","zh":"这里是北极光酒店，请问有什么可以帮您的吗？","words":[[0,7,17.71,18.255,"nordlys"],[8,13,18.33,18.775,"hotel"],[15,18,19.11,19.292,"vær@ty-vær-phone"],[19,21,19.292,19.432,"så@ty-så-phone"],[22,25,19.432,19.695,"god@ty-god-phone"]]},{"id":1,"start":20.45,"end":23.075,"speaker":"Olav","text":"Hallo! Jeg vil gjerne bestille et rom.","zh":"你好！我想订一个房间。","words":[[0,5,20.45,20.775,"hallo"],[7,10,21.53,21.712,"jeg"],[11,14,21.712,21.855,"vil"],[15,21,21.87,22.215,"gjerne"],[22,30,22.27,22.712,"bestille@ty-book-room"],[31,33,22.712,22.873,"et"],[34,37,22.873,23.075,"rom"]]},{"id":2,"start":23.57,"end":25.055,"speaker":"Receptionist","text":"For en person?","zh":"一位住吗？","words":[[0,3,23.57,23.855,"for@ty-for-person"],[4,6,24.05,24.415,"en@ty-one-person"],[7,13,24.61,25.055,"person"]]},{"id":3,"start":25.57,"end":27.095,"speaker":"Olav","text":"Ja. For i morgen natt.","zh":"是的。明晚住。","words":[[0,2,25.57,25.735,"ja"],[4,7,26.19,26.375,"for@ty-for-booking-time"],[8,9,26.39,26.492,"i@ty-time"],[10,16,26.492,26.802,"morgen"],[17,21,26.802,27.095,"natt"]]},{"id":4,"start":27.63,"end":28.755,"speaker":"Receptionist","text":"For en natt?","zh":"住一晚吗？","words":[[0,3,27.63,27.875,"for@ty-for-duration"],[4,6,28.01,28.295,"en@ty-one-night"],[7,11,28.35,28.755,"natt"]]},{"id":5,"start":29.33,"end":30.635,"speaker":"Olav","text":"Ja. Med bad.","zh":"是的。要带浴室的。","words":[[0,2,29.33,29.475,"ja"],[4,7,30.17,30.323,"med@ty-with-facility"],[8,11,30.323,30.635,"bad"]]},{"id":6,"start":31.03,"end":33.375,"speaker":"Receptionist","text":"Alle rommene har dusj og toalett.","zh":"所有房间都有淋浴和卫生间。","words":[[0,4,31.03,31.395,"alle"],[5,12,31.49,31.935,"rommene"],[13,16,32.01,32.235,"har@ty-have-facilities"],[17,21,32.27,32.595,"dusj"],[22,24,32.63,32.752,"og"],[25,32,32.752,33.375,"toalett"]]},{"id":7,"start":34.13,"end":35.515,"speaker":"Olav","text":"Er frokost inkludert?","zh":"包含早餐吗？","words":[[0,2,34.13,34.275,"er@ty-be-description"],[3,10,34.29,34.855,"frokost"],[11,20,34.89,35.515,"inkludert"]]},{"id":8,"start":35.89,"end":38.315,"speaker":"Receptionist","text":"Ja, frokost er inkludert.","zh":"是的，包含早餐。","words":[[0,2,35.89,36.075,"ja"],[4,11,36.77,37.355,"frokost"],[12,14,37.37,37.535,"er@ty-be-description"],[15,24,37.55,38.315,"inkludert"]]},{"id":9,"start":38.81,"end":39.795,"speaker":"Olav","text":"Hva koster rommet?","zh":"房间多少钱？","words":[[0,3,38.81,38.995,"hva"],[4,10,39.03,39.435,"koster"],[11,17,39.51,39.795,"rommet"]]},{"id":10,"start":40.04,"end":44.225,"speaker":"Receptionist","text":"Prisen er sju hundre kroner per natt for en person.","zh":"每人每晚 700 克朗。","words":[[0,6,40.04,40.505,"prisen"],[7,9,40.56,40.825,"er@ty-be-description"],[10,13,40.9,41.085,"sju"],[14,20,41.24,41.665,"hundre"],[21,27,41.72,42.225,"kroner"],[28,31,42.32,42.605,"per"],[32,36,42.66,42.985,"natt"],[37,40,43.02,43.225,"for@ty-for-person"],[41,43,43.3,43.585,"en@ty-one-person"],[44,50,43.64,44.225,"person"]]},{"id":11,"start":44.82,"end":48.585,"speaker":"Olav","text":"Jeg kommer sent. Er restauranten åpen sent?","zh":"我会很晚才到。餐厅营业到很晚吗？","words":[[0,3,44.82,45.005,"jeg"],[4,10,45.02,45.365,"kommer@ty-come-arrival"],[11,15,45.44,45.845,"sent"],[17,19,46.72,46.965,"er@ty-be-description"],[20,32,47.1,47.765,"restauranten"],[33,37,47.88,48.225,"åpen"],[38,42,48.26,48.585,"sent"]]},{"id":12,"start":49.11,"end":52.435,"speaker":"Receptionist","text":"Restauranten er åpen til klokken elleve.","zh":"餐厅营业到十一点。","words":[[0,12,49.11,49.995,"restauranten"],[13,15,50.05,50.235,"er@ty-be-description"],[16,20,50.31,50.835,"åpen"],[21,24,50.95,51.195,"til@ty-until-time"],[25,32,51.37,51.815,"klokken"],[33,39,51.95,52.435,"elleve"]]},{"id":13,"start":52.95,"end":55.495,"speaker":"Olav","text":"Fint. Jeg heter Olav Berg.","zh":"好的。我叫奥拉夫·贝格。","words":[[0,4,52.95,53.375,"fint"],[6,9,53.97,54.195,"jeg"],[10,15,54.21,54.615,"heter"],[16,20,54.73,55.115,"olav"],[21,25,55.13,55.495,"berg"]]},{"id":14,"start":55.87,"end":57.215,"speaker":"Receptionist","text":"Velkommen i morgen.","zh":"欢迎您明天入住。","words":[[0,9,55.87,56.492,"velkommen"],[10,11,56.492,56.582,"i@ty-time"],[12,18,56.582,57.215,"morgen"]]},{"id":15,"start":57.77,"end":58.955,"speaker":"Olav","text":"Takk. Ha det bra.","zh":"谢谢。再见。","words":[[0,4,57.77,58.075,"takk"],[6,8,58.57,58.703,"ha@ty-farewell-ha"],[9,12,58.703,58.822,"det@ty-farewell-det"],[13,16,58.822,58.955,"bra@ty-farewell-bra"]]}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"bad":{"lemma":"bad","zh":"浴室","pos":"名词","ref":"ty-conversation-9-003","clip":null},"berg":{"lemma":"Berg","zh":"贝格（姓氏）","pos":"专名","ref":null,"clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-book-room":{"lemma":"bestille","zh":"预订（酒店房间）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式","contextual":true,"baseKey":"bestille","surface":"bestille"},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"bra@ty-farewell-bra":{"lemma":"bra","zh":"好（Ha det bra!：再见）","pos":"副词","ref":"pa-vei-2-018","clip":null,"contextual":true,"baseKey":"bra","surface":"bra"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-farewell-det":{"lemma":"det","zh":"（Ha det bra!）道别语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dusj":{"lemma":"dusj","zh":"淋浴","pos":"名词","ref":"ty-conversation-9-008","clip":null},"elleve":{"lemma":"elleve","zh":"十一","pos":"数词","ref":"ty-conversation-11-033","clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip"