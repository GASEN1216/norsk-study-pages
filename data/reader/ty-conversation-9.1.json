{"id":"ty-conversation-9.1","bookId":"ty-conversation-guide","readingId":"9.1","title":"Booking a room at a hotel","audio":"audio/ty-conversation/9.1.mp3","duration":59.846531,"synthetic":false,"sentences":[{"id":0,"start":17.3,"end":20.32,"speaker":"Receptionist","text":"Nordlys Hotel, vær så god?","zh":"这里是北极光酒店，请问有什么可以帮您的吗？","words":[[0,7,17.3,18.34,"nordlys"],[8,13,18.34,18.94,"hotel"],[15,18,19.24,19.4,"vær@ty-vær-phone"],[19,21,19.4,19.54,"så@ty-så-phone"],[22,25,19.54,20.32,"god@ty-god-phone"]]},{"id":1,"start":20.52,"end":23.26,"speaker":"Olav","text":"Hallo! Jeg vil gjerne bestille et rom.","zh":"你好！我想订一个房间。","words":[[0,5,20.52,20.8,"hallo"],[7,10,21.6,21.74,"jeg"],[11,14,21.74,21.92,"vil"],[15,21,21.92,22.32,"gjerne"],[22,30,22.32,22.72,"bestille@ty-book-room"],[31,33,22.72,22.94,"et"],[34,37,22.94,23.26,"rom"]]},{"id":2,"start":23.72,"end":25.12,"speaker":"Receptionist","text":"For en person?","zh":"一位住吗？","words":[[0,3,23.72,24.04,"for@ty-for-person"],[4,6,24.04,24.64,"en@ty-one-person"],[7,13,24.64,25.12,"person"]]},{"id":3,"start":25.6,"end":27.36,"speaker":"Olav","text":"Ja. For i morgen natt.","zh":"是的。明晚住。","words":[[0,2,25.6,25.88,"ja"],[4,7,26.24,26.46,"for@ty-for-booking-time"],[8,9,26.46,26.6,"i@ty-time"],[10,16,26.6,26.84,"morgen"],[17,21,26.84,27.36,"natt"]]},{"id":4,"start":27.68,"end":28.96,"speaker":"Receptionist","text":"For en natt?","zh":"住一晚吗？","words":[[0,3,27.68,28.06,"for@ty-for-duration"],[4,6,28.06,28.4,"en@ty-one-night"],[7,11,28.4,28.96,"natt"]]},{"id":5,"start":29.34,"end":30.7,"speaker":"Olav","text":"Ja. Med bad.","zh":"是的。要带浴室的。","words":[[0,2,29.34,29.76,"ja"],[4,7,30.14,30.36,"med@ty-with-facility"],[8,11,30.36,30.7,"bad"]]},{"id":6,"start":31.06,"end":33.5,"speaker":"Receptionist","text":"Alle rommene har dusj og toalett.","zh":"所有房间都有淋浴和卫生间。","words":[[0,4,31.06,31.52,"alle"],[5,12,31.52,32.02,"rommene"],[13,16,32.02,32.28,"har@ty-have-facilities"],[17,21,32.28,32.74,"dusj"],[22,24,32.74,32.86,"og"],[25,32,32.86,33.5,"toalett"]]},{"id":7,"start":34.14,"end":35.62,"speaker":"Olav","text":"Er frokost inkludert?","zh":"包含早餐吗？","words":[[0,2,34.14,34.36,"er@ty-be-description"],[3,10,34.36,34.92,"frokost"],[11,20,34.92,35.62,"inkludert"]]},{"id":8,"start":35.94,"end":38.38,"speaker":"Receptionist","text":"Ja, frokost er inkludert.","zh":"是的，包含早餐。","words":[[0,2,35.94,36.7,"ja"],[4,11,36.8,37.42,"frokost"],[12,14,37.42,37.58,"er@ty-be-description"],[15,24,37.58,38.38,"inkludert"]]},{"id":9,"start":38.78,"end":39.84,"speaker":"Olav","text":"Hva koster rommet?","zh":"房间多少钱？","words":[[0,3,38.78,39.06,"hva"],[4,10,39.06,39.54,"koster"],[11,17,39.54,39.84,"rommet"]]},{"id":10,"start":39.95,"end":44.01,"speaker":"Receptionist","text":"Prisen er sju hundre kroner per natt for en person.","zh":"每人每晚 700 克朗。","words":[[0,6,39.95,40.51,"prisen"],[7,9,40.51,40.79,"er@ty-be-description"],[10,13,40.79,41.19,"sju"],[14,20,41.19,41.69,"hundre"],[21,27,41.69,42.23,"kroner"],[28,31,42.23,42.55,"per"],[32,36,42.55,42.97,"natt"],[37,40,42.97,43.21,"for@ty-for-person"],[41,43,43.21,43.53,"en@ty-one-person"],[44,50,43.53,44.01,"person"]]},{"id":11,"start":44.7,"end":48.62,"speaker":"Olav","text":"Jeg kommer sent. Er restauranten åpen sent?","zh":"我会很晚才到。餐厅营业到很晚吗？","words":[[0,3,44.7,45.04,"jeg"],[4,10,45.04,45.4,"kommer@ty-come-arrival"],[11,15,45.4,45.88,"sent"],[17,19,45.88,47.04,"er@ty-be-description"],[20,32,47.04,47.86,"restauranten"],[33,37,47.86,48.34,"åpen"],[38,42,48.34,48.62,"sent"]]},{"id":12,"start":49.26,"end":52.58,"speaker":"Receptionist","text":"Restauranten er åpen til klokken elleve.","zh":"餐厅营业到十一点。","words":[[0,12,49.26,50.04,"restauranten"],[13,15,50.04,50.44,"er@ty-be-description"],[16,20,50.44,50.96,"åpen"],[21,24,50.96,51.46,"til@ty-until-time"],[25,32,51.46,51.98,"klokken"],[33,39,51.98,52.58,"elleve"]]},{"id":13,"start":53.06,"end":55.54,"speaker":"Olav","text":"Fint. Jeg heter Olav Berg.","zh":"好的。我叫奥拉夫·贝格。","words":[[0,4,53.06,53.54,"fint"],[6,9,54.02,54.26,"jeg"],[10,15,54.26,54.62,"heter"],[16,20,54.62,55.22,"olav"],[21,25,55.22,55.54,"berg"]]},{"id":14,"start":56.02,"end":57.26,"speaker":"Receptionist","text":"Velkommen i morgen.","zh":"欢迎您明天入住。","words":[[0,9,56.02,56.48,"velkommen"],[10,11,56.48,56.74,"i@ty-time"],[12,18,56.74,57.26,"morgen"]]},{"id":15,"start":57.88,"end":59.0,"speaker":"Olav","text":"Takk. Ha det bra.","zh":"谢谢。再见。","words":[[0,4,57.88,58.5,"takk"],[6,8,58.62,58.78,"ha@ty-farewell-ha"],[9,12,58.78,58.88,"det@ty-farewell-det"],[13,16,58.88,59.0,"bra@ty-farewell-bra"]]}],"lexicon":{"alle":{"lemma":"all","zh":"所有的","pos":"数量限定词","ref":"ty-conversation-9-001","clip":null,"form":"复数"},"bad":{"lemma":"bad","zh":"浴室","pos":"名词","ref":"ty-conversation-9-003","clip":null},"berg":{"lemma":"Berg","zh":"贝格（姓氏）","pos":"专名","ref":null,"clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"bestille@ty-book-room":{"lemma":"bestille","zh":"预订（酒店房间）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式","contextual":true,"baseKey":"bestille","surface":"bestille"},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"bra@ty-farewell-bra":{"lemma":"bra","zh":"好（Ha det bra!：再见）","pos":"副词","ref":"pa-vei-2-018","clip":null,"contextual":true,"baseKey":"bra","surface":"bra"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-farewell-det":{"lemma":"det","zh":"（Ha det bra!）道别语中的代词，无须单译","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dusj":{"lemma":"dusj","zh":"淋浴","pos":"名词","ref":"ty-conversation-9-008","clip":null},"elleve":{"lemma":"elleve","zh":"十一","pos":"数词","ref":"ty-conversation-11-033","clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"en@ty-one-night":{"lemma":"en","zh":"一（晚）","pos":"数词","ref":"ty-conversation-4-005","clip":null,"form":"通性",