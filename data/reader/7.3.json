{"id":"7.3","title":"Unnskyld at jeg kommer for sent!","audio":"audio/7.3.mp3","duration":129.89,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.88,"text":"7.3 Unnskyld at jeg kommer for sent!","heading":true,"zh":"7.3 对不起，我迟到了！","words":[[0,3,0.15,1.26,"7.3"],[4,12,2.5,3.14,"unnskyld"],[13,15,3.14,3.4,"at"],[16,19,3.4,3.6,"jeg"],[20,26,3.6,3.86,"kommer"],[27,30,3.86,4.16,"for~79c080957b12"],[31,35,4.16,4.8,"sent"]]},{"id":1,"start":6.44,"end":9.82,"text":"Hawa kommer for sent til språkpraksis i dag.","zh":"哈娃今天语言实习迟到了。","words":[[0,4,6.5,7.14,"hawa"],[5,11,7.14,7.52,"kommer"],[12,15,7.52,7.7,"for~79c080957b12"],[16,20,7.7,8.06,"sent"],[21,24,8.06,8.26,"til"],[25,37,8.26,9.2,"språkpraksis"],[38,39,9.2,9.28,"i~de136e71704d"],[40,43,9.28,9.67,"dag"]]},{"id":2,"start":10.3,"end":13.06,"text":"Hun løper inn til kollegaen Rune.","zh":"她跑进去找同事鲁内。","words":[[0,3,10.37,10.64,"hun"],[4,9,10.64,11.18,"løper"],[10,13,11.18,11.6,"inn"],[14,17,11.6,11.84,"til"],[18,27,11.84,12.54,"kollegaen"],[28,32,12.54,12.91,"rune"]]},{"id":3,"start":14.87,"end":19.18,"text":"Unnskyld at jeg kommer for sent. Jeg forsov meg og mistet bussen.","speaker":"Hawa","zh":"对不起，我迟到了。我睡过头了，没赶上公交车。","words":[[0,8,14.93,15.4,"unnskyld"],[9,11,15.4,15.5,"at"],[12,15,15.5,15.66,"jeg"],[16,22,15.66,15.98,"kommer"],[23,26,15.98,16.18,"for~79c080957b12"],[27,31,16.18,16.75,"sent"],[33,36,17.28,17.44,"jeg"],[37,43,17.44,17.94,"forsov"],[44,47,17.94,18.1,"meg"],[48,50,18.1,18.18,"og"],[51,57,18.18,18.56,"mistet"],[58,64,18.56,19.03,"bussen"]]},{"id":4,"start":19.86,"end":22.29,"text":"Det gjorde du i forrige uke også!","speaker":"Rune","zh":"你上周也是这样！","words":[[0,3,19.92,20.26,"det"],[4,10,20.26,20.62,"gjorde"],[11,13,20.62,20.82,"du"],[14,15,20.82,20.94,"i"],[16,23,20.94,21.36,"forrige"],[24,27,21.36,21.64,"uke"],[28,32,21.64,22.14,"også"]]},{"id":5,"start":22.78,"end":28.08,"text":"Huff, jeg vet det, men bussen går bare én gang i timen.","speaker":"Hawa","zh":"唉，我知道，可是公交车一小时才一班。","words":[[0,4,22.86,23.46,"huff"],[6,9,23.94,24.22,"jeg"],[10,13,24.22,24.54,"vet"],[14,17,24.54,24.84,"det"],[19,22,25.55,25.77,"men"],[23,29,25.77,26.21,"bussen"],[30,33,26.21,26.39,"går~acdc34f0eefd"],[34,38,26.39,26.71,"bare"],[39,41,26.71,27.04,"én"],[42,46,27.04,27.23,"gang"],[47,48,27.23,27.39,"i~ae2f9629e0b1"],[49,54,27.39,28.0,"timen"]]},{"id":6,"start":28.57,"end":35.36,"text":"Det er viktig å komme presis. Sjefen blir ikke glad, og du kan miste jobben.","speaker":"Rune","zh":"准时很重要。老板会不高兴的，你可能会丢掉工作。","words":[[0,3,28.62,28.9,"det"],[4,6,28.9,29.14,"er"],[7,13,29.14,29.7,"viktig"],[14,15,29.7,29.84,"å~0583da7a620a"],[16,21,29.84,30.22,"komme"],[22,28,30.22,30.99,"presis"],[30,36,32.12,32.58,"sjefen"],[37,41,32.58,32.82,"blir"],[42,46,32.82,33.02,"ikke"],[47,51,33.02,33.48,"glad"],[53,55,33.86,34.04,"og"],[56,58,34.04,34.24,"du"],[59,62,34.24,34.44,"kan"],[63,68,34.44,34.8,"miste"],[69,75,34.8,35.21,"jobben"]]},{"id":7,"start":35.98,"end":40.17,"text":"Jeg vet det, men det er vanskelig å stå opp så tidlig.","speaker":"Hawa","zh":"我知道，可是这么早起床太难了。","words":[[0,3,36.05,36.34,"jeg"],[4,7,36.34,36.7,"vet"],[8,11,36.7,37.03,"det"],[13,16,37.84,37.96,"men"],[17,20,37.96,38.08,"det"],[21,23,38.08,38.22,"er"],[24,33,38.22,38.76,"vanskelig"],[34,35,38.76,38.88,"å~0583da7a620a"],[36,39,38.88,39.08,"stå"],[40,43,39.08,39.26,"opp~4bb5dba4f351"],[44,46,39.26,39.44,"så~3871b614434d"],[47,53,39.44,40.02,"tidlig"]]},{"id":8,"start":40.89,"end":42.7,"text":"Jeg skal ikke si det til sjefen.","speaker":"Rune","zh":"我不会告诉老板的。","words":[[0,3,40.95,41.22,"jeg"],[4,8,41.22,41.52,"skal"],[9,13,41.52,41.74,"ikke"],[14,16,41.74,41.9,"si~c139ffdb1a59"],[17,20,41.9,42.02,"det"],[21,24,42.02,42.18,"til"],[25,31,42.18,42.55,"sjefen"]]},{"id":9,"start":43.33,"end":49.43,"text":"Takk! Jeg skal aldri forsove meg igjen. Jeg vil ta førerkort og kjøpe bil.","speaker":"Hawa","zh":"谢谢！我再也不会睡过头了。我想考驾照、买辆车。","words":[[0,4,43.39,43.98,"takk"],[6,9,44.54,44.72,"jeg"],[10,14,44.72,45.04,"skal"],[15,20,45.04,45.56,"aldri"],[21,28,45.56,46.04,"forsove"],[29,32,46.04,46.2,"meg"],[33,38,46.2,46.63,"igjen"],[40,43,47.26,47.38,"jeg"],[44,47,47.38,47.56,"vil"],[48,50,47.56,47.76,"ta~60afc7f37834"],[51,60,47.76,48.46,"førerkort"],[61,63,48.46,48.58,"og"],[64,69,48.58,48.92,"kjøpe"],[70,73,48.92,49.28,"bil"]]},{"id":10,"start":50.03,"end":52.15,"text":"Det er dyrt å ta lappen i Norge.","speaker":"Rune","zh":"在挪威考驾照很贵。","words":[[0,3,50.09,50.28,"det"],[4,6,50.28,50.46,"er"],[7,11,50.46,50.86,"dyrt"],[12,13,50.86,50.96,"å~0583da7a620a"],[14,16,50.96,51.12,"ta~60afc7f37834"],[17,23,51.12,51.48,"lappen"],[24,25,51.48,51.56,"i"],[26,31,51.56,52.0,"norge~546b56e35dd5"]]},{"id":11,"start":52.5,"end":54.74,"text":"Ja, jeg må spare penger.","speaker":"Hawa","zh":"是啊，我得攒钱。","words":[[0,2,52.56,52.91,"ja"],[4,7,53.42,53.54,"jeg"],[8,10,53.54,53.72,"må"],[11,16,53.72,54.18,"spare"],[17,23,54.18,54.59,"penger"]]},{"id":12,"start":55.91,"end":72.18,"text":"Jeg har bil, men jeg sykler ofte til jobben. Jeg liker å sykle. Det tar bare 20 minutter. Det er sunt og gratis, og det er bra for miljøet. Om vinteren tar jeg buss av og til.","speaker":"Rune","zh":"我有车，但我经常骑自行车上班。我喜欢骑车。只要20分钟。既健康又免费，还对环境有好处。冬天我有时坐公交车。","words":[[0,3,55.98,56.26,"jeg"],[4,7,56.26,56.52,"har"],[8,11,56.52,56.98,"bil"],[13,16,57.56,57.7,"men"],[17,20,57.7,58.04,"jeg"],[21,27,58.04,58.72,"sykler"],[28,32,58.72,59.0,"ofte"],[33,36,59.0,59.14,"til"],[37,43,59.14,59.63,"jobben"],[45,48,60.42,60.6,"jeg"],[49,54,60.6,60.98,"liker"],[55,56,60.98,61.1,"å~0583da7a620a"],[57,62,61.1,61.67,"sykle"],[64,67,62.34,62.5,"det"],[68,71,62.5,62.8,"tar~376c12518b59"],[72,76,62.8,63.16,"bare"],[77,79,63.16,63.52,"20"],[80,88,63.52,64.13,"minutter"],[90,93,64.96,65.12,"det"],[94,96,65.12,65.26,"er"],[97,101,65.26,65.82,"sunt"],[102,104,65.82,66.04,"og"],[105,111,66.04,66.88,"gratis~2d64ec2ad302"],[113,115,67.32,67.44,"og"],[116,119,67.44,67.56,"det"],[120,122,67.56,67.7,"er"],[123,126,67.7,68.0,"bra~bbb83846e29f"],[127,130,68.0,68.18,"for~dac524eb595a"],[131,138,68.18,68.78,"miljøet"],[140,142,69.9,70.1,"om~1e753acc270b"],[143,151,70.1,70.82,"vinteren"],[152,155,70.82,71.0,"tar"],[156,159,71.0,71.2,"jeg"],[160,164,71.2,71.58,"buss"],[165,167,71.58,71.72,"av~26a687fec87a"],[168,170,71.72,71.8,"og"],[171,174,71.8,72.03,"til~69fe6862a430"]]},{"id":13,"start":73.14,"end":83.16,"text":"Jeg har ikke sykkel, og jeg har ikke råd til bil og førerkort nå. Men jeg har sikkert råd til å kjøpe en brukt sykkel. Det skal jeg gjøre!","speaker":"Hawa","zh":"我没有自行车，现在也负担不起汽车和驾照。不过买一辆二手自行车我肯定买得起。我就这么办！","words":[[0,3,73.2,73.64,"jeg"],[4,7,73.64,73.98,"har"],[8,12,73.98,74.24,"ikke"],[13,19,74.24,74.78,"sykkel"],[21,23,75.14,75.22,"og"],[24,27,75.22,75.36,"jeg"],[28,31,75.36,75.54,"har"],[32,36,75.54,75.76,"ikke"],[37,40,75.76,75.96,"råd"],[41,44,75.96,76.16,"til~3e06ffb4614d"],[45,48,76.16,76.56,"bil"],[49,51,76.56,76.7,"og"],[52,61,76.7,77.28,"førerkort"],[62,64,77.28,77.58,"nå~d531d47a7712"],[66,69,78.58,78.72,"men"],[70,73,78.72,78.86,"jeg"],[74,77,78.86,79.04,"har"],[78,85,79.04,79.42,"sikkert~51058f485758"],[86,89,79.42,79.62,"råd"],[90,93,79.62,79.76,"til~3e06ffb4614d"],[94,95,79.76,79.86,"å~0583da7a620a"],[96,101,79.86,80.14,"kjøpe"],[102,104,80.14,80.26,"en~a939a9e56dc5"],[105,110,80.26,80.64,"brukt~b790e30c3ba7"],[111,117,80.64,81.18,"sykkel"],[119,122,81.9,82.32,"det"],[123,127,82.32,82.52,"skal"],[128,131,82.52,82.64,"jeg"],[132,137,82.64,83.01,"gjøre"]]},{"id":14,"start":86.4,"end":87.53,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,86.46,87.38,"sammendrag"]]},{"id":15,"start":88.68,"end":92.63,"text":"En dag i uka har Hawa språkpraksis på hotellet.","zh":"哈娃每周有一天在酒店做语言实习。","words":[[0,2,88.74,89.04,"en~a939a9e56dc5"],[3,6,89.04,89.44,"dag"],[7,8,89.44,89.58,"i~82e4f1cd42dc"],[9,12,89.58,90.06,"uka"],[13,16,90.06,90.28,"har"],[17,21,90.28,90.78,"hawa"],[22,34,90.78,91.82,"språkpraksis"],[35,37,91.82,91.94,"på"],[38,46,91.94,92.48,"hotellet"]]},{"id":16,"start":93.49,"end":98.55,"text":"I dag kommer hun for sent, for hun forsov seg og mistet bussen.","zh":"今天她迟到了，因为她睡过头，没赶上公交车。","words":[[0,1,93.55,93.72,"i~de136e71704d"],[2,5,93.72,94.2,"dag"],[6,12,94.2,94.48,"kommer"],[13,16,94.48,94.7,"hun"],[17,20,94.7,94.88,"for~79c080957b12"],[21,25,94.88,95.52,"sent"],[27,30,95.9,96.12,"for~1b22712a94b1"],[31,34,96.12,96.5,"hun"],[35,41,96.5,97.06,"forsov"],[42,45,97.06,97.46,"seg"],[46,48,97.46,97.58,"og"],[49,55,97.58,97.98,"mistet"],[56,62,97.98,98.4,"bussen"]]},{"id":17,"start":99.61,"end":103.47,"text":"Hawa liker ikke å stå opp tidlig og forsover seg ofte.","zh":"哈娃不喜欢早起，经常睡过头。","words":[[0,4,99.67,100.12,"hawa"],[5,10,100.12,100.5,"liker"],[11,15,100.5,100.82,"ikke"],[16,17,100.82,100.92,"å~0583da7a620a"],[18,21,100.92,101.18,"stå"],[22,25,101.18,101.34,"opp~4bb5dba4f351"],[26,32,101.34,102.0,"tidlig"],[33,35,102.0,102.1,"og"],[36,44,102.1,102.62,"forsover"],[45,48,102.62,102.86,"seg"],[49,53,102.86,103.32,"ofte"]]},{"id":18,"start":104.34,"end":106.54,"text":"Det tar tid å reise med buss.","zh":"坐公交车出行很花时间。","words":[[0,3,104.4,104.56,"det"],[4,7,104.56,104.8,"tar~376c12518b59"],[8,11,104.8,105.34,"tid"],[12,13,105.34,105.44,"å~0583da7a620a"],[14,19,105.44,105.86,"reise~63719a6eccb9"],[20,23,105.86,106.0,"med~a7d4af26146c"],[24,28,106.0,106.39,"buss"]]},{"id":19,"start":107.39,"end":110.85,"text":"Hun vil ta førerkort, men det er dyrt.","zh":"她想考驾照，但是很贵。","words":[[0,3,107.45,107.7,"hun"],[4,7,107.7,107.98,"vil"],[8,10,107.98,108.3,"ta~60afc7f37834"],[11,20,108.3,109.32,"førerkort"],[22,25,109.58,109.72,"men"],[26,29,109.72,109.88,"det"],[30,32,109.88,110.1,"er"],[33,37,110.1,110.7,"dyrt"]]},{"id":20,"start":111.68,"end":117.71,"text":"Kollegaen Rune har førerkort og bil, men han pleier å sykle til jobb.","zh":"同事鲁内有驾照也有车，但他通常骑自行车上班。","words":[[0,9,111.74,112.42,"kollegaen"],[10,14,112.42,112.98,"rune"],[15,18,113.24,113.5,"har"],[19,28,113.5,114.34,"førerkort"],[29,31,114.46,114.58,"og"],[32,35,114.58,115.06,"bil"],[37,40,115.44,115.88,"men"],[41,44,115.88,116.16