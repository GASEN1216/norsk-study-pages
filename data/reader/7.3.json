{"id":"7.3","title":"Unnskyld at jeg kommer for sent!","audio":"audio/7.3.mp3","duration":129.89,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.88,"text":"7.3 Unnskyld at jeg kommer for sent!","heading":true,"zh":"7.3 对不起，我迟到了！","words":[[0,3,0.15,1.26,"7.3"],[4,12,2.5,3.14,"unnskyld"],[13,15,3.14,3.4,"at"],[16,19,3.4,3.6,"jeg"],[20,26,3.6,3.86,"kommer"],[27,30,3.86,4.16,"for~79c080957b12"],[31,35,4.16,4.8,"sent"]]},{"id":1,"start":6.4,"end":9.76,"text":"Hawa kommer for sent til språkpraksis i dag.","zh":"哈娃今天语言实习迟到了。","words":[[0,4,6.48,6.8,"hawa"],[5,11,6.8,7.37,"kommer"],[12,15,7.37,7.64,"for~79c080957b12"],[16,20,7.64,7.92,"sent"],[21,24,7.92,8.14,"til"],[25,37,8.14,9.11,"språkpraksis"],[38,39,9.11,9.22,"i~de136e71704d"],[40,43,9.22,9.68,"dag"]]},{"id":2,"start":10.27,"end":13.01,"text":"Hun løper inn til kollegaen Rune.","zh":"她跑进去找同事鲁内。","words":[[0,3,10.35,10.51,"hun"],[4,9,10.51,11.03,"løper"],[10,13,11.03,11.32,"inn"],[14,17,11.32,11.72,"til"],[18,27,11.72,12.45,"kollegaen"],[28,32,12.45,12.93,"rune"]]},{"id":3,"start":14.83,"end":19.12,"text":"Unnskyld at jeg kommer for sent. Jeg forsov meg og mistet bussen.","speaker":"Hawa","zh":"对不起，我迟到了。我睡过头了，没赶上公交车。","words":[[0,8,14.91,15.32,"unnskyld"],[9,11,15.32,15.46,"at"],[12,15,15.46,15.58,"jeg"],[16,22,15.58,15.82,"kommer"],[23,26,15.82,16.1,"for~79c080957b12"],[27,31,16.1,16.4,"sent"],[33,36,17.12,17.38,"jeg"],[37,43,17.38,17.9,"forsov"],[44,47,17.9,18.04,"meg"],[48,50,18.04,18.14,"og"],[51,57,18.14,18.48,"mistet"],[58,64,18.48,19.04,"bussen"]]},{"id":4,"start":19.29,"end":22.22,"text":"Det gjorde du i forrige uke også!","speaker":"Rune","zh":"你上周也是这样！","words":[[0,3,19.54,20.18,"det"],[4,10,20.18,20.58,"gjorde"],[11,13,20.58,20.76,"du"],[14,15,20.76,20.9,"i"],[16,23,20.9,21.36,"forrige"],[24,27,21.36,21.56,"uke"],[28,32,21.56,22.14,"også"]]},{"id":5,"start":22.78,"end":28.08,"text":"Huff, jeg vet det, men bussen går bare én gang i timen.","speaker":"Hawa","zh":"唉，我知道，可是公交车一小时才一班。","words":[[0,4,22.86,23.46,"huff"],[6,9,23.94,24.22,"jeg"],[10,13,24.22,24.54,"vet"],[14,17,24.54,24.84,"det"],[19,22,25.55,25.77,"men"],[23,29,25.77,26.21,"bussen"],[30,33,26.21,26.39,"går~acdc34f0eefd"],[34,38,26.39,26.71,"bare"],[39,41,26.71,27.04,"én"],[42,46,27.04,27.23,"gang"],[47,48,27.23,27.39,"i~ae2f9629e0b1"],[49,54,27.39,28.0,"timen"]]},{"id":6,"start":28.28,"end":35.3,"text":"Det er viktig å komme presis. Sjefen blir ikke glad, og du kan miste jobben.","speaker":"Rune","zh":"准时很重要。老板会不高兴的，你可能会丢掉工作。","words":[[0,3,28.28,28.82,"det"],[4,6,28.82,29.02,"er"],[7,13,29.02,29.64,"viktig"],[14,15,29.64,29.78,"å~0583da7a620a"],[16,21,29.78,30.06,"komme"],[22,28,30.06,30.72,"presis"],[30,36,31.92,32.5,"sjefen"],[37,41,32.5,32.72,"blir"],[42,46,32.72,32.94,"ikke"],[47,51,32.94,33.22,"glad"],[53,55,33.84,33.97,"og"],[56,58,33.97,34.15,"du"],[59,62,34.15,34.37,"kan"],[63,68,34.37,34.77,"miste"],[69,75,34.77,35.22,"jobben"]]},{"id":7,"start":35.54,"end":40.12,"text":"Jeg vet det, men det er vanskelig å stå opp så tidlig.","speaker":"Hawa","zh":"我知道，可是这么早起床太难了。","words":[[0,3,35.7,36.26,"jeg"],[4,7,36.26,36.54,"vet"],[8,11,36.54,36.86,"det"],[13,16,37.72,37.95,"men"],[17,20,37.95,38.05,"det"],[21,23,38.05,38.16,"er"],[24,33,38.16,38.7,"vanskelig"],[34,35,38.7,38.8,"å~0583da7a620a"],[36,39,38.8,39.05,"stå"],[40,43,39.05,39.23,"opp~4bb5dba4f351"],[44,46,39.23,39.34,"så~3871b614434d"],[47,53,39.34,40.04,"tidlig"]]},{"id":8,"start":40.85,"end":42.64,"text":"Jeg skal ikke si det til sjefen.","speaker":"Rune","zh":"我不会告诉老板的。","words":[[0,3,40.93,41.13,"jeg"],[4,8,41.13,41.34,"skal"],[9,13,41.34,41.62,"ikke"],[14,16,41.62,41.85,"si~c139ffdb1a59"],[17,20,41.85,41.98,"det"],[21,24,41.98,42.12,"til"],[25,31,42.12,42.56,"sjefen"]]},{"id":9,"start":43.29,"end":49.36,"text":"Takk! Jeg skal aldri forsove meg igjen. Jeg vil ta førerkort og kjøpe bil.","speaker":"Hawa","zh":"谢谢！我再也不会睡过头了。我想考驾照、买辆车。","words":[[0,4,43.37,43.82,"takk"],[6,9,44.4,44.68,"jeg"],[10,14,44.68,44.86,"skal"],[15,20,44.86,45.48,"aldri"],[21,28,45.48,45.94,"forsove"],[29,32,45.94,46.12,"meg"],[33,38,46.12,46.42,"igjen"],[40,43,46.86,47.34,"jeg"],[44,47,47.34,47.48,"vil"],[48,50,47.48,47.66,"ta~60afc7f37834"],[51,60,47.66,48.3,"førerkort"],[61,63,48.3,48.52,"og"],[64,69,48.52,48.8,"kjøpe"],[70,73,48.8,49.28,"bil"]]},{"id":10,"start":49.36,"end":52.08,"text":"Det er dyrt å ta lappen i Norge.","speaker":"Rune","zh":"在挪威考驾照很贵。","words":[[0,3,49.44,50.27,"det"],[4,6,50.27,50.33,"er"],[7,11,50.33,50.83,"dyrt"],[12,13,50.83,50.92,"å~0583da7a620a"],[14,16,50.92,51.05,"ta~60afc7f37834"],[17,23,51.05,51.42,"lappen"],[24,25,51.42,51.55,"i"],[26,31,51.55,52.0,"norge~546b56e35dd5"]]},{"id":11,"start":52.46,"end":54.68,"text":"Ja, jeg må spare penger.","speaker":"Hawa","zh":"是啊，我得攒钱。","words":[[0,2,52.54,52.8,"ja"],[4,7,53.36,53.52,"jeg"],[8,10,53.52,53.64,"må"],[11,16,53.64,53.98,"spare"],[17,23,53.98,54.6,"penger"]]},{"id":12,"start":54.83,"end":72.12,"text":"Jeg har bil, men jeg sykler ofte til jobben. Jeg liker å sykle. Det tar bare 20 minutter. Det er sunt og gratis, og det er bra for miljøet. Om vinteren tar jeg buss av og til.","speaker":"Rune","zh":"我有车，但我经常骑自行车上班。我喜欢骑车。只要20分钟。既健康又免费，还对环境有好处。冬天我有时坐公交车。","words":[[0,3,55.25,56.19,"jeg"],[4,7,56.19,56.41,"har"],[8,11,56.41,56.71,"bil"],[13,16,57.42,57.65,"men"],[17,20,57.65,57.84,"jeg"],[21,27,57.84,58.59,"sykler"],[28,32,58.59,58.95,"ofte"],[33,36,58.95,59.06,"til"],[37,43,59.06,59.37,"jobben"],[45,48,60.27,60.55,"jeg"],[49,54,60.55,60.93,"liker"],[55,56,60.93,61.07,"å~0583da7a620a"],[57,62,61.07,61.39,"sykle"],[64,67,62.3,62.45,"det"],[68,71,62.45,62.67,"tar~376c12518b59"],[72,76,62.67,62.99,"bare"],[77,79,62.99,63.38,"20"],[80,88,63.38,63.88,"minutter"],[90,93,64.84,65.06,"det"],[94,96,65.06,65.17,"er"],[97,101,65.17,65.44,"sunt"],[102,104,65.44,65.91,"og"],[105,111,65.91,66.75,"gratis~2d64ec2ad302"],[113,115,67.22,67.42,"og"],[116,119,67.42,67.53,"det"],[120,122,67.53,67.62,"er"],[123,126,67.62,67.89,"bra~bbb83846e29f"],[127,130,67.89,68.11,"for~dac524eb595a"],[131,138,68.11,68.64,"miljøet"],[140,142,69.86,70.02,"om~1e753acc270b"],[143,151,70.02,70.72,"vinteren"],[152,155,70.72,70.95,"tar"],[156,159,70.95,71.08,"jeg"],[160,164,71.08,71.53,"buss"],[165,167,71.53,71.67,"av~26a687fec87a"],[168,170,71.67,71.75,"og"],[171,174,71.75,72.04,"til~69fe6862a430"]]},{"id":13,"start":73.11,"end":83.09,"text":"Jeg har ikke sykkel, og jeg har ikke råd til bil og førerkort nå. Men jeg har sikkert råd til å kjøpe en brukt sykkel. Det skal jeg gjøre!","speaker":"Hawa","zh":"我没有自行车，现在也负担不起汽车和驾照。不过买一辆二手自行车我肯定买得起。我就这么办！","words":[[0,3,73.19,73.49,"jeg"],[4,7,73.49,73.87,"har"],[8,12,73.87,74.13,"ikke"],[13,19,74.13,74.53,"sykkel"],[21,23,75.03,75.23,"og"],[24,27,75.23,75.33,"jeg"],[28,31,75.33,75.51,"har"],[32,36,75.51,75.69,"ikke"],[37,40,75.69,75.87,"råd"],[41,44,75.92,76.03,"til~3e06ffb4614d"],[45,48,76.05,76.41,"bil"],[49,51,76.41,76.65,"og"],[52,61,76.65,77.15,"førerkort"],[62,64,77.15,77.45,"nå~d531d47a7712"],[66,69,78.37,78.69,"men"],[70,73,78.69,78.81,"jeg"],[74,77,78.81,78.97,"har"],[78,85,78.97,79.35,"sikkert~51058f485758"],[86,89,79.35,79.55,"råd"],[90,93,79.58,79.69,"til~3e06ffb4614d"],[94,95,79.69,79.81,"å~0583da7a620a"],[96,101,79.81,80.09,"kjøpe"],[102,104,80.09,80.23,"en~a939a9e56dc5"],[105,110,80.23,80.53,"brukt~b790e30c3ba7"],[111,117,80.53,80.95,"sykkel"],[119,122,81.69,82.15,"det"],[123,127,82.15,82.47,"skal"],[128,131,82.47,82.61,"jeg"],[132,137,82.61,83.02,"gjøre"]]},{"id":14,"start":86.37,"end":87.47,"text":"Sammendrag","subheading":true,"zh":"内容概要","words":[[0,10,86.45,87.39,"sammendrag"]]},{"id":15,"start":88.64,"end":92.45,"text":"En dag i uka har Hawa språkpraksis på hotellet.","zh":"哈娃每周有一天在酒店做语言实习。","words":[[0,2,88.72,88.98,"en~a939a9e56dc5"],[3,6,88.98,89.28,"dag"],[7,8,89.28,89.52,"i~82e4f1cd42dc"],[9,12,89.52,89.9,"uka"],[13,16,89.9,90.19,"har"],[17,21,90.24,90.58,"hawa"],[22,34,90.58,91.76,"språkpraksis"],[35,37,91.76,91.9,"på"],[38,46,91.9,92.45,"hotellet"]]},{"id":16,"start":92.57,"end":98.48,"text":"I dag kommer hun for sent, for hun forsov seg og mistet bussen.","zh":"今天她迟到了，因为她睡过头，没赶上公交车。","words":[[0,1,92.57,93.68,"i~de136e71704d"],[2,5,93.68,93.96,"dag"],[6,12,93.96,94.42,"kommer"],[13,16,94.42,94.6,"hun"],[17,20,94.6,94.86,"for~79c080957b12"],[21,25,94.86,95.12,"sent"],[27,30,95.86,96.06,"for~1b22712a94b1"],[31,34,96.06,96.32,"hun"],[35,41,96.32,96.98,"forsov"],[42,45,96.98,97.26,"seg"],[46,48,97.26,97.54,"og"],[49,55,97.54,97.9,"mistet"],[56,62,97.9,98.4,"bussen"]]},{"id":17,"start":99.58,"end":103.4,"text":"Hawa liker ikke å stå opp tidlig og forsover seg ofte.","zh":"哈娃不喜欢早起，经常睡过头。","words":[[0,4,99.66,100.03,"hawa"],[5,10,100.03,100.43,"liker"],[11,15,100.43,100.71,"ikke"],[16,17,100.71,100.89,"å~0583da7a620a"],[18,21,100.89,101.11,"stå"],[22,25,101.11,101.29,"opp~4bb5dba4f351"],[26,32,101.29,101.77,"tidlig"],[33,35,101.77,102.03,"og"],[36,44,102.03,102.55,"forsover"],[45,48,102.55,102.71,"seg"],[49,53,102.71,103.32,"ofte"]]},{"id":18,"start":104.33,"end":106.47,"text":"Det tar tid å reise med buss.","zh":"坐公交车出行很花时间。","words":[[0,3,104.41,104.51,"det"],[4,7,104.51,104.75,"tar~376c12518b59"],[8,11,104.75,105.05,"tid"],[12,13,105.05,105.39,"å~0583da7a620a"],[14,19,105.39,105.75,"reise~63719a6eccb9"],[20,23,105.75,105.95,"med~a7d4af26146c"],[24,28,105.95,106.39,"buss"]]},{"id":19,"start":107.35,"end":110.47,"text":"Hun vil ta førerkort, men det er dyrt.","zh":"她想考驾照，但是很贵。","words":[[0,3,107.43,107.58,"hun"],[4,7,107.58,107.83,"vil"],[8,10,107.83,108.16,"ta~60afc7f37834"],[11,20,108.16,109.06,"førerkort"],[22,25,109.56,109.67,"men"],[26,29,109.67,109.81,"det"],[30,32,109.81,109.97,"er"],[33,37,109.97,110.39,"dyrt"]]},{"id":20,"start":111.64,"end":117.65,"text":"Kollegaen Rune har førerkort og bil, men han pleier å sykle til jobb.","zh":"同事鲁内有驾照也有车，但他通常骑自行车上班。","words":[[0,9,111.72,112.35,"kollegaen"],[10,14,112.35,112.73,"rune"],[15,18,112.73,113.39,"har"],[19,28,113.39,114.05,"førerkort"],[29,31,114.05,114.53,"og"],[32,35,114.53,114.81,"bil"