{"id":"ty-conversation-6.1","bookId":"ty-conversation-guide","readingId":"6.1","title":"Buying clothes","audio":"audio/ty-conversation/6.1.mp3","duration":75.41551,"synthetic":false,"sentences":[{"id":0,"start":24.3,"end":28.02,"speaker":"Olav","text":"Jeg liker disse buksene.","zh":"我喜欢这条裤子。","words":[[0,3,24.3,25.38,"jeg"],[4,9,25.38,26.28,"liker"],[10,15,26.28,26.82,"disse"],[16,23,26.82,28.02,"buksene"]]},{"id":1,"start":28.68,"end":29.98,"speaker":"Assistant","text":"Vil du prøve dem?","zh":"您想试穿一下吗？","words":[[0,3,28.68,29.12,"vil"],[4,6,29.12,29.42,"du"],[7,12,29.42,29.78,"prøve"],[13,16,29.78,29.98,"dem"]]},{"id":2,"start":29.98,"end":33.76,"speaker":"Olav","text":"Det er ikke min størrelse.","zh":"这个尺码不适合我。","words":[[0,3,29.98,31.84,"det@ty-det-size"],[4,6,31.84,32.24,"er@ty-be-identity"],[7,11,32.24,32.56,"ikke"],[12,15,32.56,33.06,"min"],[16,25,33.06,33.76,"størrelse"]]},{"id":3,"start":34.74,"end":36.37,"speaker":"Olav","text":"Har du andre størrelser?","zh":"有别的尺码吗？","words":[[0,3,34.74,34.92,"har@ty-availability"],[4,6,34.92,35.1,"du"],[7,12,35.1,35.86,"andre"],[13,23,35.86,36.37,"størrelser"]]},{"id":4,"start":37.24,"end":39.42,"speaker":"Assistant","text":"Ikke i den fargen.","zh":"这个颜色没有别的尺码。","words":[[0,4,37.24,37.86,"ikke"],[5,6,37.86,38.3,"i@ty-place"],[7,10,38.3,38.74,"den@ty-den-color"],[11,17,38.74,39.42,"fargen"]]},{"id":5,"start":40.04,"end":44.31,"speaker":"Assistant","text":"Men her er brune bukser i den riktige størrelsen.","zh":"不过这里有尺码合适的棕色裤子。","words":[[0,3,40.04,40.4,"men"],[4,7,40.4,40.9,"her"],[8,10,40.9,41.42,"er@ty-be-presentation"],[11,16,41.42,41.9,"brune"],[17,23,41.9,42.62,"bukser"],[24,25,42.62,42.98,"i@ty-place"],[26,29,42.98,43.22,"den@ty-den-definite"],[30,37,43.22,43.8,"riktige"],[38,48,43.8,44.31,"størrelsen"]]},{"id":6,"start":45.86,"end":49.47,"speaker":"Olav","text":"Nei. Jeg vil heller ha svarte bukser.","zh":"不了。我更想要黑色裤子。","words":[[0,3,45.86,46.46,"nei"],[5,8,46.98,47.26,"jeg"],[9,12,47.26,47.54,"vil"],[13,19,47.54,47.96,"heller"],[20,22,47.96,48.32,"ha@ty-want-item"],[23,29,48.32,48.96,"svarte"],[30,36,48.96,49.47,"bukser"]]},{"id":7,"start":50.34,"end":52.78,"speaker":"Assistant","text":"Her er svarte bukser.","zh":"这里有黑色裤子。","words":[[0,3,50.34,50.84,"her"],[4,6,50.84,51.34,"er@ty-be-presentation"],[7,13,51.34,52.0,"svarte"],[14,20,52.0,52.78,"bukser"]]},{"id":8,"start":53.76,"end":54.78,"speaker":"Olav","text":"Hva koster de?","zh":"多少钱？","words":[[0,3,53.76,54.2,"hva"],[4,10,54.2,54.54,"koster"],[11,13,54.54,54.78,"de@ty-de-pronoun"]]},{"id":9,"start":54.8,"end":59.64,"speaker":"Assistant","text":"De svarte koster fem hundre og sekstini kroner.","zh":"黑色的要 569 克朗。","words":[[0,2,54.8,55.82,"de@ty-de-definite"],[3,9,55.82,56.4,"svarte"],[10,16,56.4,57.32,"koster"],[17,20,57.32,57.8,"fem"],[21,27,57.8,58.3,"hundre"],[28,30,58.3,58.44,"og"],[31,39,58.44,59.04,"sekstini"],[40,46,59.04,59.64,"kroner"]]},{"id":10,"start":60.4,"end":65.1,"speaker":"Assistant","text":"De brune buksene koster fire hundre og åtti kroner.","zh":"棕色的裤子要 480 克朗。","words":[[0,2,60.4,60.7,"de@ty-de-definite"],[3,8,60.7,61.18,"brune"],[9,16,61.18,62.18,"buksene"],[17,23,62.18,62.9,"koster"],[24,28,62.9,63.28,"fire"],[29,35,63.28,63.86,"hundre"],[36,38,63.86,64.08,"og"],[39,43,64.08,64.52,"åtti"],[44,50,64.52,65.1,"kroner"]]},{"id":11,"start":66.78,"end":70.24,"speaker":"Olav","text":"Jeg vil gjerne prøve de svarte buksene.","zh":"我想试穿一下黑色裤子。","words":[[0,3,66.78,66.88,"jeg"],[4,7,66.88,67.12,"vil"],[8,14,67.12,67.68,"gjerne"],[15,20,67.68,68.1,"prøve"],[21,23,68.1,68.42,"de@ty-de-definite"],[24,30,68.42,69.24,"svarte"],[31,38,69.24,70.24,"buksene"]]},{"id":12,"start":70.86,"end":73.14,"speaker":"Assistant","text":"Prøverommet er der borte.","zh":"试衣间在那边。","words":[[0,11,70.86,71.9,"prøverommet"],[12,14,71.9,72.18,"er@ty-be-location"],[15,18,72.18,72.78,"der"],[19,24,72.78,73.14,"borte"]]}],"lexicon":{"andre":{"lemma":"annen","zh":"其他的；别的（指尺码）","pos":"限定词","ref":"ty-conversation-6-001","clip":null,"for