{"id":"ty-conversation-6.1","bookId":"ty-conversation-guide","readingId":"6.1","title":"Buying clothes","audio":"audio/ty-conversation/6.1.mp3","duration":75.41551,"synthetic":false,"sentences":[{"id":0,"start":25.09,"end":27.375,"speaker":"Olav","text":"Jeg liker disse buksene.","zh":"我喜欢这条裤子。","words":[[0,3,25.09,25.335,"jeg"],[4,9,25.49,26.015,"liker"],[10,15,26.23,26.675,"disse"],[16,23,26.79,27.375,"buksene"]]},{"id":1,"start":28.81,"end":29.915,"speaker":"Assistant","text":"Vil du prøve dem?","zh":"您想试穿一下吗？","words":[[0,3,28.81,28.995,"vil"],[4,6,29.07,29.215,"du"],[7,12,29.37,29.733,"prøve"],[13,16,29.733,29.915,"dem"]]},{"id":2,"start":31.65,"end":33.595,"speaker":"Olav","text":"Det er ikke min størrelse.","zh":"这个尺码不适合我。","words":[[0,3,31.65,31.815,"det@ty-det-size"],[4,6,31.87,32.112,"er@ty-be-identity"],[7,11,32.112,32.415,"ikke"],[12,15,32.55,32.855,"min"],[16,25,32.97,33.595,"størrelse"]]},{"id":3,"start":34.71,"end":36.375,"speaker":"Olav","text":"Har du andre størrelser?","zh":"有别的尺码吗？","words":[[0,3,34.71,34.882,"har@ty-availability"],[4,6,34.882,34.995,"du"],[7,12,35.11,35.535,"andre"],[13,23,35.79,36.375,"størrelser"]]},{"id":4,"start":37.23,"end":39.115,"speaker":"Assistant","text":"Ikke i den fargen.","zh":"这个颜色没有别的尺码。","words":[[0,4,37.23,37.635,"ikke"],[5,6,37.89,37.995,"i@ty-clothing-specification"],[7,10,38.19,38.415,"den@ty-den-color"],[11,17,38.69,39.115,"fargen"]]},{"id":5,"start":40.17,"end":44.275,"speaker":"Assistant","text":"Men her er brune bukser i den riktige størrelsen.","zh":"不过这里有尺码合适的棕色裤子。","words":[[0,3,40.17,40.355,"men"],[4,7,40.43,40.735,"her"],[8,10,41.05,41.215,"er@ty-be-presentation"],[11,16,41.29,41.815,"brune"],[17,23,41.89,42.355,"bukser"],[24,25,42.79,42.895,"i@ty-clothing-specification"],[26,29,42.93,43.115,"den@ty-den-definite"],[30,37,43.15,43.655,"riktige"],[38,48,43.73,44.275,"størrelsen"]]},{"id":6,"start":45.77,"end":49.375,"speaker":"Olav","text":"Nei. Jeg vil heller ha svarte bukser.","zh":"不了。我更想要黑色裤子。","words":[[0,3,45.77,46.075,"nei"],[5,8,47.01,47.233,"jeg"],[9,12,47.233,47.415,"vil"],[13,19,47.49,47.935,"heller"],[20,22,47.97,48.095,"ha@ty-want-item"],[23,29,48.21,48.775,"svarte"],[30,36,48.93,49.375,"bukser"]]},{"id":7,"start":50.31,"end":52.415,"speaker":"Assistant","text":"Her er svarte bukser.","zh":"这里有黑色裤子。","words":[[0,3,50.31,50.655,"her"],[4,6,50.99,51.135,"er@ty-be-presentation"],[7,13,51.23,51.735,"svarte"],[14,20,51.99,52.415,"bukser"]]},{"id":8,"start":53.91,"end":54.655,"speaker":"Olav","text":"Hva koster de?","zh":"多少钱？","words":[[0,3,53.91,54.075,"hva"],[4,10,54.17,54.543,"koster"],[11,13,54.543,54.655,"de@ty-de-pronoun"]]},{"id":9,"start":55.61,"end":59.655,"speaker":"Assistant","text":"De svarte koster fem hundre og sekstini kroner.","zh":"黑色的要 569 克朗。","words":[[0,2,55.61,55.755,"de@ty-de-definite"],[3,9,55.87,56.355,"svarte"],[10,16,56.83,57.375,"koster"],[17,20,57.53,57.755,"fem"],[21,27,57.81,58.235,"hundre"],[28,30,58.33,58.455,"og"],[31,39,58.51,59.115,"sekstini"],[40,46,59.27,59.655,"kroner"]]},{"id":10,"start":60.55,"end":65.095,"speaker":"Assistant","text":"De brune buksene koster fire hundre og åtti kroner.","zh":"棕色的裤子要 480 克朗。","words":[[0,2,60.55,60.695,"de@ty-de-definite"],[3,8,60.71,61.175,"brune"],[9,16,61.41,61.895,"buksene"],[17,23,62.57,62.955,"koster"],[24,28,63.05,63.395,"fire"],[29,35,63.41,63.795,"hundre"],[36,38,63.93,64.055,"og"],[39,43,64.11,64.475,"åtti"],[44,50,64.73,65.095,"kroner"]]},{"id":11,"start":66.67,"end":69.675,"speaker":"Olav","text":"Jeg vil gjerne prøve de svarte buksene.","zh":"我想试穿一下黑色裤子。","words":[[0,3,66.67,66.855,"jeg"],[4,7,66.87,67.035,"vil"],[8,14,67.07,67.535,"gjerne"],[15,20,67.61,68.055,"prøve"],[21,23,68.07,68.215,"de@ty-de-definite"],[24,30,68.29,68.815,"svarte"],[31,38,69.21,69.675,"buksene"]]},{"id":12,"start":70.71,"end":73.055,"speaker":"Assistant","text":"Prøverommet er der borte.","zh":"试衣间在那边。","words":[[0,11,70.71,71.455,"prøverommet"],[12,14,71.81,72.015,"er@ty-be-location"],[15,18,72.