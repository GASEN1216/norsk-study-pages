{"id":"3.3","title":"Sompit skal besøke svigermor","audio":"audio/3.3.mp3","duration":144.94,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.52,"text":"3.3 Sompit skal besøke svigermor","heading":true,"zh":"3.3 松皮特要去看望婆婆","words":[[0,3,0.15,1.02,"3.3"],[4,10,2.64,3.22,"sompit"],[11,15,3.22,3.78,"skal"],[16,22,3.78,4.5,"besøke"],[23,32,4.5,5.44,"svigermor"]]},{"id":1,"start":7.64,"end":11.85,"text":"Hawa og Sompit snakker sammen etter skolen.","zh":"放学后，哈娃和松皮特在聊天。","words":[[0,4,7.7,8.36,"hawa"],[5,7,8.36,8.66,"og"],[8,14,8.66,9.42,"sompit"],[15,22,9.7,10.22,"snakker"],[23,29,10.22,10.82,"sammen"],[30,35,10.82,11.18,"etter"],[36,42,11.18,11.7,"skolen"]]},{"id":2,"start":13.99,"end":16.45,"text":"Hva skal du gjøre i dag, Sompit?","speaker":"Hawa","zh":"松皮特，你今天要做什么？","words":[[0,3,14.05,14.28,"hva"],[4,8,14.28,14.56,"skal"],[9,11,14.56,14.88,"du"],[12,17,14.88,15.18,"gjøre"],[18,19,15.18,15.28,"i~de136e71704d"],[20,23,15.28,15.72,"dag~83a758a6ca25"],[25,31,15.72,16.3,"sompit"]]},{"id":3,"start":18.04,"end":19.87,"text":"Jeg skal besøke mamma.","speaker":"Sompit","zh":"我要去看妈妈。","words":[[0,3,18.1,18.44,"jeg"],[4,8,18.44,18.72,"skal"],[9,15,18.72,19.36,"besøke"],[16,21,19.36,19.72,"mamma"]]},{"id":4,"start":21.07,"end":23.59,"text":"Mamma? I Thailand?","speaker":"Hawa","zh":"妈妈？在泰国吗？","words":[[0,5,21.12,21.86,"mamma"],[7,8,22.58,22.78,"i"],[9,17,22.78,23.45,"thailand"]]},{"id":5,"start":24.86,"end":31.55,"text":"Nei, svigermor. Jeg har en mamma i Thailand og en mamma i Norge.","speaker":"Sompit","zh":"不是，是婆婆。我在泰国有一个妈妈，在挪威也有一个妈妈。","words":[[0,3,24.91,25.47,"nei"],[5,14,25.92,26.86,"svigermor"],[16,19,27.76,27.96,"jeg"],[20,23,27.96,28.26,"har"],[24,26,28.26,28.56,"en~a939a9e56dc5"],[27,32,28.56,28.94,"mamma"],[33,34,28.94,29.02,"i"],[35,43,29.02,29.65,"thailand"],[44,46,29.98,30.2,"og"],[47,49,30.2,30.48,"en~a939a9e56dc5"],[50,55,30.48,30.9,"mamma"],[56,57,30.9,31.04,"i"],[58,63,31.04,31.4,"norge~546b56e35dd5"]]},{"id":6,"start":32.95,"end":35.55,"text":"Å ja, nå forstår jeg.","speaker":"Hawa","zh":"哦，现在我明白了。","words":[[0,1,33.02,33.31,"å~0583da7a620a"],[2,4,33.52,33.85,"ja"],[6,8,34.44,34.66,"nå~d531d47a7712"],[9,16,34.66,35.12,"forstår"],[17,20,35.12,35.41,"jeg"]]},{"id":7,"start":37.11,"end":45.62,"text":"Jeg må handle mat, for hun kan ikke gå. I dag skal jeg kjøpe melk, brød og egg til henne.","speaker":"Sompit","zh":"我得去买菜，因为她走不了路。今天我要给她买牛奶、面包和鸡蛋。","words":[[0,3,37.17,37.46,"jeg"],[4,6,37.46,37.62,"må"],[7,13,37.62,37.94,"handle"],[14,17,37.94,38.49,"mat"],[19,22,39.04,39.22,"for~a05c87659379"],[23,26,39.22,39.48,"hun"],[27,30,39.48,39.74,"kan"],[31,35,39.74,39.96,"ikke"],[36,38,39.96,40.27,"gå"],[40,41,41.48,41.6,"i~de136e71704d"],[42,45,41.6,41.96,"dag~83a758a6ca25"],[46,50,41.96,42.14,"skal"],[51,54,42.14,42.3,"jeg"],[55,60,42.3,42.66,"kjøpe"],[61,65,42.66,43.34,"melk"],[67,71,43.58,44.12,"brød"],[72,74,44.38,44.64,"og"],[75,78,44.64,45.0,"egg"],[79,82,45.0,45.16,"til"],[83,88,45.16,45.47,"henne"]]},{"id":8,"start":47.17,"end":50.33,"text":"Du er snill. Hva skal dere gjøre?","speaker":"Hawa","zh":"你真好。你们要做什么？","words":[[0,2,47.23,47.56,"du"],[3,5,47.56,47.78,"er"],[6,11,47.78,48.38,"snill"],[13,16,49.16,49.36,"hva"],[17,21,49.36,49.56,"skal"],[22,26,49.56,49.78,"dere"],[27,32,49.78,50.18,"gjøre"]]},{"id":9,"start":51.73,"end":64.04,"text":"Vi skal strikke. Svigermor strikker mye, men jeg kan ikke strikke. Jeg vil strikke ullsokker. Det er kaldt i Norge.","speaker":"Sompit","zh":"我们要织毛线。婆婆经常织，但我不会织。我想织羊毛袜。挪威很冷。","words":[[0,2,51.8,52.08,"vi"],[3,7,52.08,52.48,"skal"],[8,15,52.48,53.12,"strikke"],[17,26,54.04,54.78,"svigermor"],[27,35,54.78,55.32,"strikker"],[36,39,55.32,55.77,"mye~933c5a923198"],[41,44,56.38,56.58,"men"],[45,48,56.58,56.84,"jeg"],[49,52,56.84,57.14,"kan~b3293f875aa1"],[53,57,57.14,57.36,"ikke"],[58,65,57.36,57.9,"strikke"],[67,70,59.12,59.34,"jeg"],[71,74,59.34,59.56,"vil"],[75,82,59.56,60.1,"strikke"],[83,92,60.1,61.02,"ullsokker"],[94,97,62.0,62.24,"det"],[98,100,62.24,62.5,"er"],[101,106,62.5,63.27,"kaldt"],[107,108,63.38,63.5,"i"],[109,114,63.5,63.89,"norge~546b56e35dd5"]]},{"id":10,"start":68.44,"end":69.65,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,68.5,69.5,"sammendrag"]]},{"id":11,"start":71.22,"end":74.03,"text":"Sompit skal besøke svigermor.","zh":"松皮特要去看望婆婆。","words":[[0,6,71.28,72.14,"sompit"],[7,11,72.14,72.54,"skal"],[12,18,72.54,73.16,"besøke"],[19,28,73.16,73.88,"svigermor"]]},{"id":12,"start":76.12,"end":78.35,"text":"Hun må handle mat til henne.","zh":"她得替婆婆买菜。","words":[[0,3,76.18,76.52,"hun"],[4,6,76.52,76.82,"må"],[7,13,76.82,77.26,"handle"],[14,17,77.26,77.64,"mat"],[18,21,77.64,77.84,"til"],[22,27,77.84,78.2,"henne"]]},{"id":13,"start":79.89,"end":85.02,"text":"Svigermor kan strikke, og Sompit vil lære det.","zh":"婆婆会织毛线，松皮特想学。","words":[[0,9,79.95,80.94,"svigermor"],[10,13,80.94,81.3,"kan~b3293f875aa1"],[14,21,81.3,82.0,"strikke"],[23,25,82.72,83.0,"og"],[26,32,83.1,83.92,"sompit"],[33,36,83.92,84.28,"vil"],[37,41,84.28,84.62,"lære~3957d928e32c"],[42,45,84.62,84.87,"det"]]},{"id":14,"start":85.86,"end":88.27,"text":"Hun vil strikke ullsokker.","zh":"她想织羊毛袜。","words":[[0,3,85.92,86.3,"hun"],[4,7,86.3,86.68,"vil"],[8,15,86.68,87.3,"strikke"],[16,25,87.3,88.12,"ullsokker"]]},{"id":15,"start":92.92,"end":96.96,"text":"Skal, kan, vil, må.","zh":"skal（将要）、kan（能、会）、vil（想要）、må（必须）。","words":[[0,4,92.98,93.64,"skal"],[6,9,94.4,94.84,"kan"],[11,14,95.62,96.02,"vil"],[16,18,96.5,96.81,"må"]]},{"id":16,"start":98.76,"end":102.92,"text":"Marek skal snakke med Ewa på Skype.","zh":"马雷克要和埃娃在 Skype 上通话。","words":[[0,5,98.82,99.66,"marek"],[6,10,100.24,100.76,"skal"],[11,17,101.0,101.4,"snakke"],[18,21,101.4,101.6,"med"],[22,25,101.6,102.06,"ewa"],[26,28,102.06,102.22,"på~acc985c9313f"],[29,34,102.22,102.77,"skype"]]},{"id":17,"start":104.58,"end":108.63,"text":"Synne og Viola skal gå på konsert.","zh":"辛妮和维奥拉要去听音乐会。","words":[[0,5,104.64,105.32,"synne"],[6,8,105.32,105.46,"og"],[9,14,105.46,106.22,"viola"],[15,19,106.74,107.34,"skal"],[20,22,107.34,107.56,"gå"],[23,25,107.56,107.72,"på~770498f5459a"],[26,33,107.72,108.48,"konsert"]]},{"id":18,"start":110.24,"end":112.88,"text":"Eivind kan spille fotball.","zh":"埃温德会踢足球。","words":[[0,6,110.3,111.02,"eivind"],[7,10,111.32,111.78,"kan~b3293f875aa1"],[11,17,111.9,112.22,"spille"],[18,25,112.22,112.73,"fotball"]]},{"id":19,"start":114.75,"end":117.59,"text":"Viola kan spille volleyball.","zh":"维奥拉会打排球。","words":[[0,5,114.81,115.5,"viola"],[6,9,115.86,116.28,"kan~b3293f875aa1"],[10,16,116.44,116.82,"spille"],[17,27,116.82,117.44,"volleyball"]]},{"id":20,"start":119.52,"end":122.73,"text":"Håvard kan ikke lese arabisk.","zh":"霍瓦尔不会读阿拉伯语。","words":[[0,6,119.58,120.38,"håvard"],[7,10,120.38,120.94,"kan~b3293f875aa1"],[11,15,120.94,121.38,"ikke"],[16,20,121.38,121.8,"lese"],[21,28,121.8,122.58,"arabisk~3bb978ca6cd0"]]},{"id":21,"start":124.78,"end":127.7,"text":"Hawa vil høre på musikk.","zh":"哈娃想听音乐。","words":[[0,4,124.84,125.48,"hawa"],[5,8,125.98,126.38,"vil"],[9,13,126.48,126.8,"høre~8d32f4406504"],[14,16,126.8,126.98,"på~33449e88ce8b"],[17,23,126.98,127.55,"musikk"]]},{"id":22,"start":129.48,"end":132.17,"text":"Sofie vil spise is.","zh":"苏菲想吃冰淇淋。","words":[[0,5,129.54,130.34,"sofie"],[6,9,130.6,131.0,"vil"],[10,15,131.1,131.54,"spise"],[16,18,131.54,132.02,"is"]]},{"id":23,"start":134.02,"end":135.21,"text":"Han er tørst.","zh":"他口渴了。","words":[[0,3,134.08,134.32,"han"],[4,6,134.32,134.48,"er"],[7,12,134.48,135.06,"tørst"]]},{"id":24,"start":135.47,"end":137.15,"text":"Han må drikke vann.","zh":"他得喝水。","words":[[0,3,135.53,135.88,"han"],[4,6,135.88,136.18,"må"],[7,13,136.28,136.64,"drikke~f9439ee27976"],[14,18,136.64,137.0,"vann"]]},{"id":25,"start":138.73,"end":140.99,"text":"Du må komme presis på skolen.","zh":"你必须准时到校。","words":[[0,2,138.79,139.04,"du"],[3,5,139.04,139.4,"må"],[6,11,139.4,139.72,"komme"],[12,18,139.72,140.18,"presis"],[19,21,140.18,140.32,"på~043eb0410e9c"],[22,28,140.32,140.84,"skolen"]]}],"lexicon":{"3.3":{"lemma":"3.3","zh":"第 3.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"arabisk":{"lemma":"arabisk","zh":"阿拉伯语","pos":"语言名／形容词","ref":"1-073","clip":"pronunciation/746311d8b0ceb97b8645.mp3"},"besøke":{"lemma":"besøke","zh":"拜访；看望；参观","pos":"动词","ref":"6-049","form":"不定式","clip":"pronunciation/040934c1a336145694a6.mp3"},"brød":{"lemma":"brød","zh":"面包","pos":"名词","ref":"3-068","clip":"pronunciation/4c05292094453b460736.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"dere":{"lemma":"dere","zh":"你们（主格和宾格同形）","pos":"代词","ref":"1-052","clip":"pronunciation/63f86c0bc4fdac62d92b.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"drikke":{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式","clip":"pronunciation/61cfa514e9f801ac82b5.mp3","ambiguous":true,"candidates":[{"lemma":"drikke","zh":"喝","pos":"动词","ref":"basics:verbs:drikke","form":"不定式"},{"lemma":"drikke","zh":"饮料","pos":"名词","ref":"basics:shopping:drikke"}]},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"egg":{"lemma":"egg","zh":"鸡蛋","pos":"名词","ref":"3-069","clip":"pronunciation/34707c3f40dfa20c3902.mp3"},"eivind":{"lemma":"Eivind","zh":"埃温德（人名）","pos":"专名","ref":null,"clip":null},"en":{"lemma":"en","zh":"一（个）（阳性不定冠词）；一","pos":"冠词／数词","form":"阳性","ref":"1-106","clip":"pronunciation/dbd3a49d0d906b4ed921.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"etter":{"lemma":"etter","zh":"之后","pos":"介词","ref":"3-062","clip":"pronunciation/1a0e73ca81b760707c80.mp3"},"ewa":{"lemma":"Ewa","zh":"埃娃（人名）","pos":"专名","ref":null,"clip":null},"for":{"lemma":"for","zh":"因为（连词）；为了；对于；（takk for）为……；（for + 形容词）太","pos":"连词／介词","ref":"3-052","clip":"pronunciation/10c22bcf4c768b515be4.mp3"},"forstår":{"lemma":"forst