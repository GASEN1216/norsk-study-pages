{"id":"3.3","title":"Sompit skal besøke svigermor","audio":"audio/3.3.mp3","duration":144.94,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.52,"text":"3.3 Sompit skal besøke svigermor","heading":true,"zh":"3.3 松皮特要去看望婆婆","words":[[0,3,0.15,1.02,"3.3"],[4,10,2.64,3.22,"sompit"],[11,15,3.22,3.78,"skal"],[16,22,3.78,4.5,"besøke"],[23,32,4.5,5.44,"svigermor"]]},{"id":1,"start":7.6,"end":11.79,"text":"Hawa og Sompit snakker sammen etter skolen.","zh":"放学后，哈娃和松皮特在聊天。","words":[[0,4,7.68,8.14,"hawa"],[5,7,8.14,8.56,"og"],[8,14,8.56,9.16,"sompit"],[15,22,9.16,10.12,"snakker"],[23,29,10.12,10.62,"sammen"],[30,35,10.62,11.1,"etter"],[36,42,11.1,11.71,"skolen"]]},{"id":2,"start":13.96,"end":16.4,"text":"Hva skal du gjøre i dag, Sompit?","speaker":"Hawa","zh":"松皮特，你今天要做什么？","words":[[0,3,14.04,14.24,"hva"],[4,8,14.24,14.42,"skal"],[9,11,14.42,14.8,"du"],[12,17,14.8,15.06,"gjøre"],[18,19,15.06,15.24,"i~de136e71704d"],[20,23,15.24,15.48,"dag~83a758a6ca25"],[25,31,15.72,16.32,"sompit"]]},{"id":3,"start":17.83,"end":19.82,"text":"Jeg skal besøke mamma.","speaker":"Sompit","zh":"我要去看妈妈。","words":[[0,3,17.91,18.38,"jeg"],[4,8,18.38,18.62,"skal"],[9,15,18.62,19.22,"besøke"],[16,21,19.22,19.74,"mamma"]]},{"id":4,"start":21.03,"end":23.56,"text":"Mamma? I Thailand?","speaker":"Hawa","zh":"妈妈？在泰国吗？","words":[[0,5,21.11,21.72,"mamma"],[7,8,22.2,22.7,"i"],[9,17,22.7,23.48,"thailand"]]},{"id":5,"start":24.79,"end":31.51,"text":"Nei, svigermor. Jeg har en mamma i Thailand og en mamma i Norge.","speaker":"Sompit","zh":"不是，是婆婆。我在泰国有一个妈妈，在挪威也有一个妈妈。","words":[[0,3,24.87,25.34,"nei"],[5,14,25.84,26.62,"svigermor"],[16,19,27.4,27.92,"jeg"],[20,23,27.92,28.12,"har"],[24,26,28.12,28.48,"en~a939a9e56dc5"],[27,32,28.48,28.8,"mamma"],[33,34,28.8,28.98,"i"],[35,43,28.98,29.28,"thailand"],[44,46,29.28,30.06,"og"],[47,49,30.06,30.4,"en~a939a9e56dc5"],[50,55,30.4,30.7,"mamma"],[56,57,30.7,30.98,"i"],[58,63,30.98,31.43,"norge~546b56e35dd5"]]},{"id":6,"start":32.92,"end":35.59,"text":"Å ja, nå forstår jeg.","speaker":"Hawa","zh":"哦，现在我明白了。","words":[[0,1,33.0,33.4,"å~0583da7a620a"],[2,4,33.4,33.76,"ja"],[6,8,34.26,34.58,"nå~d531d47a7712"],[9,16,34.58,35.06,"forstår"],[17,20,35.06,35.51,"jeg"]]},{"id":7,"start":36.28,"end":45.62,"text":"Jeg må handle mat, for hun kan ikke gå. I dag skal jeg kjøpe melk, brød og egg til henne.","speaker":"Sompit","zh":"我得去买菜，因为她走不了路。今天我要给她买牛奶、面包和鸡蛋。","words":[[0,3,36.4,37.38,"jeg"],[4,6,37.38,37.58,"må"],[7,13,37.58,37.82,"handle"],[14,17,37.82,38.14,"mat"],[19,22,38.86,39.16,"for~a05c87659379"],[23,26,39.16,39.4,"hun"],[27,30,39.4,39.64,"kan"],[31,35,39.64,39.9,"ikke"],[36,38,39.9,40.12,"gå"],[40,41,41.35,41.53,"i~de136e71704d"],[42,45,41.53,41.77,"dag~83a758a6ca25"],[46,50,41.77,42.09,"skal"],[51,54,42.09,42.23,"jeg"],[55,60,42.23,42.53,"kjøpe"],[61,65,42.53,43.15,"melk"],[67,71,43.61,44.03,"brød"],[72,74,44.03,44.47,"og"],[75,78,44.47,44.85,"egg"],[79,82,44.85,45.09,"til"],[83,88,45.09,45.54,"henne"]]},{"id":8,"start":47.14,"end":50.27,"text":"Du er snill. Hva skal dere gjøre?","speaker":"Hawa","zh":"你真好。你们要做什么？","words":[[0,2,47.22,47.47,"du"],[3,5,47.47,47.67,"er"],[6,11,47.67,48.09,"snill"],[13,16,48.93,49.31,"hva"],[17,21,49.31,49.49,"skal"],[22,26,49.49,49.71,"dere"],[27,32,49.71,50.19,"gjøre"]]},{"id":9,"start":51.7,"end":63.98,"text":"Vi skal strikke. Svigermor strikker mye, men jeg kan ikke strikke. Jeg vil strikke ullsokker. Det er kaldt i Norge.","speaker":"Sompit","zh":"我们要织毛线。婆婆经常织，但我不会织。我想织羊毛袜。挪威很冷。","words":[[0,2,51.78,52.03,"vi"],[3,7,52.03,52.31,"skal"],[8,15,52.31,52.91,"strikke"],[17,26,53.99,54.61,"svigermor"],[27,35,54.61,55.19,"strikker"],[36,39,55.19,55.57,"mye~933c5a923198"],[41,44,56.35,56.49,"men"],[45,48,56.49,56.77,"jeg"],[49,52,56.77,57.03,"kan~b3293f875aa1"],[53,57,57.03,57.29,"ikke"],[58,65,57.29,57.65,"strikke"],[67,70,58.94,59.3,"jeg"],[71,74,59.3,59.48,"vil"],[75,82,59.48,59.92,"strikke"],[83,92,59.92,60.78,"ullsokker"],[94,97,61.88,62.14,"det"],[98,100,62.14,62.4,"er"],[101,106,62.4,63.0,"kaldt"],[107,108,63.0,63.46,"i"],[109,114,63.46,63.9,"norge~546b56e35dd5"]]},{"id":10,"start":68.4,"end":69.64,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,68.48,69.56,"sammendrag"]]},{"id":11,"start":71.18,"end":73.97,"text":"Sompit skal besøke svigermor.","zh":"松皮特要去看望婆婆。","words":[[0,6,71.26,71.9,"sompit"],[7,11,71.9,72.34,"skal"],[12,18,72.34,73.04,"besøke"],[19,28,73.04,73.89,"svigermor"]]},{"id":12,"start":75.96,"end":78.29,"text":"Hun må handle mat til henne.","zh":"她得替婆婆买菜。","words":[[0,3,76.04,76.38,"hun"],[4,6,76.38,76.68,"må"],[7,13,76.68,77.1,"handle"],[14,17,77.1,77.52,"mat"],[18,21,77.52,77.78,"til"],[22,27,77.78,78.21,"henne"]]},{"id":13,"start":78.4,"end":85.03,"text":"Svigermor kan strikke, og Sompit vil lære det.","zh":"婆婆会织毛线，松皮特想学。","words":[[0,9,78.82,80.78,"svigermor"],[10,13,80.78,81.12,"kan~b3293f875aa1"],[14,21,81.12,81.78,"strikke"],[23,25,82.44,82.96,"og"],[26,32,82.96,83.62,"sompit"],[33,36,83.62,84.1,"vil"],[37,41,84.1,84.56,"lære~3957d928e32c"],[42,45,84.56,84.95,"det"]]},{"id":14,"start":85.82,"end":88.21,"text":"Hun vil strikke ullsokker.","zh":"她想织羊毛袜。","words":[[0,3,85.9,86.17,"hun"],[4,7,86.17,86.53,"vil"],[8,15,86.53,87.11,"strikke"],[16,25,87.11,88.13,"ullsokker"]]},{"id":15,"start":92.88,"end":96.91,"text":"Skal, kan, vil, må.","zh":"skal（将要）、kan（能、会）、vil（想要）、må（必须）。","words":[[0,4,92.96,93.6,"skal"],[6,9,94.42,94.68,"kan"],[11,14,95.54,95.82,"vil"],[16,18,96.5,96.83,"må"]]},{"id":16,"start":98.72,"end":102.86,"text":"Marek skal snakke med Ewa på Skype.","zh":"马雷克要和埃娃在 Skype 上通话。","words":[[0,5,98.8,99.5,"marek"],[6,10,99.5,100.56,"skal"],[11,17,100.56,101.34,"snakke"],[18,21,101.34,101.48,"med"],[22,25,101.48,101.9,"ewa"],[26,28,101.9,102.16,"på~acc985c9313f"],[29,34,102.16,102.78,"skype"]]},{"id":17,"start":104.54,"end":108.23,"text":"Synne og Viola skal gå på konsert.","zh":"辛妮和维奥拉要去听音乐会。","words":[[0,5,104.62,105.23,"synne"],[6,8,105.23,105.45,"og"],[9,14,105.45,105.89,"viola"],[15,19,105.89,107.07,"skal"],[20,22,107.07,107.49,"gå"],[23,25,107.49,107.67,"på~770498f5459a"],[26,33,107.67,108.15,"konsert"]]},{"id":18,"start":110.2,"end":112.8,"text":"Eivind kan spille fotball.","zh":"埃温德会踢足球。","words":[[0,6,110.28,110.78,"eivind"],[7,10,110.78,111.56,"kan~b3293f875aa1"],[11,17,111.56,112.14,"spille"],[18,25,112.14,112.72,"fotball"]]},{"id":19,"start":114.71,"end":117.5,"text":"Viola kan spille volleyball.","zh":"维奥拉会打排球。","words":[[0,5,114.79,115.22,"viola"],[6,9,115.22,116.1,"kan~b3293f875aa1"],[10,16,116.1,116.72,"spille"],[17,27,116.72,117.42,"volleyball"]]},{"id":20,"start":119.49,"end":122.66,"text":"Håvard kan ikke lese arabisk.","zh":"霍瓦尔不会读阿拉伯语。","words":[[0,6,119.57,120.16,"håvard"],[7,10,120.16,120.6,"kan~b3293f875aa1"],[11,15,120.88,121.2,"ikke"],[16,20,121.2,121.7,"lese"],[21,28,121.7,122.58,"arabisk~3bb978ca6cd0"]]},{"id":21,"start":124.75,"end":127.64,"text":"Hawa vil høre på musikk.","zh":"哈娃想听音乐。","words":[[0,4,124.83,125.41,"hawa"],[5,8,125.41,126.21,"vil"],[9,13,126.21,126.71,"høre~8d32f4406504"],[14,16,126.71,126.89,"på~33449e88ce8b"],[17,23,126.89,127.56,"musikk"]]},{"id":22,"start":129.44,"end":132.11,"text":"Sofie vil spise is.","zh":"苏菲想吃冰淇淋。","words":[[0,5,129.52,130.19,"sofie"],[6,9,130.19,130.83,"vil"],[10,15,130.83,131.45,"spise"],[16,18,131.45,132.03,"is"]]},{"id":23,"start":133.98,"end":135.15,"text":"Han er tørst.","zh":"他口渴了。","words":[[0,3,134.06,134.25,"han"],[4,6,134.25,134.41,"er"],[7,12,134.41,135.07,"tørst"]]},{"id":24,"start":135.3,"end":136.84,"text":"Han må drikke vann.","zh":"他得喝水。","words":[[0,3,135.38,135.75,"han"],[4,6,135.75,136.09,"må"],[7,13,136.09,136.57,"drikke~f9439ee27976"],[14,18,136.57,136.84,"vann"]]},{"id":25,"start":136.98,"end":140.91,"text":"Du må komme presis på skolen.","zh":"你必须准时到校。","words":[[0,2,136.98,137.71,"du"],[3,5,138.93,139.23,"må"],[6,11,139.23,139.55,"komme"],[12,18,139.55,140.11,"presis"],[19,21,140.11,140.25,"på~043eb0410e9c"],[22,28,140.25,140.83,"skolen"]]}],"lexicon":{"3.3":{"lemma":"3.3","zh