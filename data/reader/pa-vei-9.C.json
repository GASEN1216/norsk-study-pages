{"id":"pa-vei-9.C","bookId":"pa-vei-textbook","readingId":"9.C","title":"Barnedåp","audio":"audio/pa-vei/9.C.mp3","duration":93.264,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.02,"end":2.765,"text":"Pablo er gift med Julia.","zh":"巴勃罗和尤莉娅结婚了。","words":[[0,5,1.02,1.485,"pablo"],[6,8,1.6,1.785,"er"],[9,13,1.84,2.213,"gift"],[14,17,2.213,2.362,"med"],[18,23,2.362,2.765,"julia"]]},{"id":1,"start":3.98,"end":5.105,"text":"De har ei datter.","zh":"他们有一个女儿。","words":[[0,2,3.98,4.125,"de"],[3,6,4.24,4.485,"har"],[7,9,4.5,4.645,"ei"],[10,16,4.68,5.105,"datter"]]},{"id":2,"start":6.12,"end":7.365,"text":"Hun heter Maria.","zh":"她叫玛丽亚。","words":[[0,3,6.12,6.325,"hun"],[4,9,6.44,6.865,"heter"],[10,15,6.92,7.365,"maria"]]},{"id":3,"start":8.78,"end":11.545,"text":"Nå er Maria snart 3 måneder gammel.","zh":"现在玛丽亚快满三个月了。","words":[[0,2,8.78,8.925,"nå"],[3,5,9.1,9.285,"er"],[6,11,9.3,9.705,"maria"],[12,17,9.8,10.185,"snart"],[18,19,10.28,10.545,"3"],[20,27,10.7,11.205,"måneder"],[28,34,11.22,11.545,"gammel"]]},{"id":4,"start":13.286,"end":17.291,"text":"Julia er katolikk, og hun vil døpe Maria i kirken.","zh":"尤莉娅是天主教徒，她想让玛丽亚在教堂受洗。","words":[[0,5,13.286,13.771,"julia"],[6,8,13.826,14.011,"er"],[9,17,14.046,14.651,"katolikk"],[19,21,15.186,15.331,"og"],[22,25,15.346,15.531,"hun"],[26,29,15.566,15.731,"vil"],[30,34,15.786,16.211,"døpe"],[35,40,16.226,16.691,"maria"],[41,42,16.726,16.828,"i"],[43,49,16.828,17.291,"kirken"]]},{"id":5,"start":18.566,"end":19.871,"text":"Det vil ikke Pablo.","zh":"巴勃罗不愿意。","words":[[0,3,18.566,18.771,"det"],[4,7,18.846,19.051,"vil"],[8,12,19.166,19.451,"ikke"],[13,18,19.466,19.871,"pablo"]]},{"id":6,"start":20.826,"end":24.651,"text":"Han er ikke religiøs og vil heller ha en navnefest.","zh":"他没有宗教信仰，宁愿办一场命名庆典。","words":[[0,3,20.826,21.011,"han"],[4,6,21.066,21.231,"er"],[7,11,21.286,21.611,"ikke"],[12,20,21.646,22.331,"religiøs"],[21,23,22.846,22.979,"og"],[24,27,22.979,23.131,"vil"],[28,34,23.146,23.468,"heller"],[35,37,23.468,23.611,"ha"],[38,40,23.666,23.811,"en"],[41,50,23.826,24.651,"navnefest"]]},{"id":7,"start":27.296,"end":29.541,"text":"Det er klart at vi må døpe dattera vår!","zh":"我们当然得给女儿施洗！","words":[[0,3,27.296,27.468,"det"],[4,6,27.468,27.601,"er"],[7,12,27.636,28.118,"klart"],[13,15,28.118,28.268,"at"],[16,18,28.268,28.379,"vi"],[19,21,28.379,28.501,"må"],[22,26,28.516,28.838,"døpe"],[27,34,28.838,29.241,"dattera"],[35,38,29.276,29.541,"vår"]],"speaker":"Julia"},{"id":8,"start":30.696,"end":31.401,"text":"Men hvorfor det?","zh":"可为什么呢？","words":[[0,3,30.696,30.858,"men"],[4,11,30.858,31.248,"hvorfor"],[12,15,31.248,31.401,"det"]],"speaker":"Pablo"},{"id":9,"start":32.416,"end":36.301,"text":"Jeg synes Maria kan bestemme senere om hun vil være medlem i en kirke.","zh":"我觉得玛丽亚以后可以自己决定要不要加入教会。","words":[[0,3,32.416,32.601,"jeg"],[4,9,32.616,32.948,"synes"],[10,15,32.948,33.381,"maria"],[16,19,33.496,33.659,"kan"],[20,28,33.659,34.041,"bestemme"],[29,35,34.076,34.501,"senere"],[36,38,34.696,34.819,"om@pa-vei-om-whether"],[39,42,34.819,34.959,"hun"],[43,46,34.959,35.101,"vil"],[47,51,35.116,35.341,"være"],[52,58,35.376,35.741,"medlem"],[59,60,35.756,35.838,"i"],[61,63,35.838,35.939,"en"],[64,69,35.939,36.301,"kirke"]],"speaker":"Pablo"},{"id":10,"start":37.506,"end":41.811,"text":"Å døpe henne er viktig for meg, og det er viktig for foreldrene mine.","zh":"让她受洗对我很重要，对我的父母也很重要。","words":[[0,1,37.506,37.611,"å"],[2,6,37.706,38.129,"døpe"],[7,12,38.129,38.431,"henne"],[13,15,38.546,38.691,"er"],[16,22,38.726,39.129,"viktig"],[23,26,39.129,39.288,"for"],[27,30,39.288,39.511,"meg"],[32,34,40.066,40.169,"og"],[35,38,40.169,40.278,"det"],[39,41,40.278,40.389,"er"],[42,48,40.389,40.778,"viktig"],[49,52,40.778,40.951,"for"],[53,63,40.986,41.558,"foreldrene"],[64,68,41.558,41.811,"mine"]],"speaker":"Julia"},{"id":11,"start":42.706,"end":44.611,"text":"Men jeg er ikke religiøs, Julia.","zh":"可是尤莉娅，我没有宗教信仰。","words":[[0,3,42.706,42.871,"men"],[4,7,42.886,43.091,"jeg"],[8,10,43.186,43.411,"er"],[11,15,43.426,43.648,"ikke"],[16,24,43.648,44.291,"religiøs"],[26,31,44.306,44.611,"julia"]],"speaker":"Pablo"},{"id":12,"start":45.386,"end":47.111,"text":"Kan vi ikke bare ha en navnefest?","zh":"我们就办个命名庆典不行吗？","words":[[0,3,45.386,45.571,"kan"],[4,6,45.606,45.709,"vi"],[7,11,45.709,45.889,"ikke"],[12,16,45.889,46.111,"bare"],[17,19,46.126,46.251,"ha"],[20,22,46.266,46.398,"en"],[23,32,46.398,47.111,"navnefest"]],"speaker":"Pablo"},{"id":13,"start":48.146,"end":49.371,"text":"En navnefest?","zh":"命名庆典？","words":[[0,2,48.146,48.331,"en"],[3,12,48.406,49.371,"navnefest"]],"speaker":"Julia"},{"id":14,"start":49.996,"end":50.461,"text":"Hva er det?","zh":"那是什么？","words":[[0,3,49.996,50.181,"hva"],[4,6,50.196,50.319,"er"],[7,10,50.319,50.461,"det"]],"speaker":"Julia"},{"id":15,"start":51.736,"end":55.141,"text":"Vi lager en fin fest for Maria og inviterer familiene våre.","zh":"我们为玛丽亚办一场美好的庆典，邀请双方的家人来。","words":[[0,2,51.736,51.858,"vi"],[3,8,51.858,52.168,"lager"],[9,11,52.168,52.301,"en"],[12,15,52.356,52.661,"fin"],[16,20,52.716,53.028,"fest"],[21,24,53.028,53.168,"for"],[25,30,53.168,53.561,"maria"],[31,33,53.696,53.819,"og"],[34,43,53.819,54.401,"inviterer"],[44,53,54.416,54.919,"familiene"],[54,58,54.919,55.141,"våre"]],"speaker":"Pablo"},{"id":16,"start":56.216,"end":57.261,"text":"Hva skal vi feire?","zh":"我们要庆祝什么呢？","words":[[0,3,56.216,56.401,"hva"],[4,8,56.476,56.701,"skal"],[9,11,56.716,56.841,"vi"],[12,17,56.876,57.261,"feire"]],"speaker":"Julia"},{"id":17,"start":58.296,"end":62.161,"text":"Vi skal selvfølgelig feire at Maria er født, og at hun heter Maria.","zh":"当然是庆祝玛丽亚出生了，也庆祝她取名叫玛丽亚。","words":[[0,2,58.296,58.409,"vi"],[3,7,58.409,58.601,"skal"],[8,20,58.616,59.181,"selvfølgelig"],[21,26,59.196,59.541,"feire"],[27,29,59.616,59.779,"at"],[30,35,59.779,60.181,"maria"],[36,38,60.216,60.361,"er"],[39,43,60.416,60.721,"født"],[45,47,60.856,60.998,"og"],[48,50,60.998,61.139,"at"],[51,54,61.139,61.281,"hun"],[55,60,61.296,61.681,"heter"],[61,66,61.796,62.161,"maria"]],"speaker":"Pablo"},{"id":18,"start":63.256,"end":64.761,"text":"Det er ikke nok, Pablo.","zh":"巴勃罗，这还不够。","words":[[0,3,63.256,63.441,"det"],[4,6,63.476,63.718,"er"],[7,11,63.718,63.981,"ikke"],[12,15,64.016,64.301,"nok"],[17,22,64.336,64.761,"pablo"]],"speaker":"Julia"},{"id":19,"start":65.796,"end":68.541,"text":"Jeg vil at Gud skal velsigne henne.","zh":"我希望上帝祝福她。","words":[[0,3,65.796,66.081,"jeg"],[4,7,66.136,66.361,"vil"],[8,10,66.596,66.781,"at"],[11,14,66.856,67.201,"gud"],[15,19,67.276,67.521,"skal"],[20,28,67.556,68.219,"velsigne"],[29,34,68.219,68.541,"henne"]],"speaker":"Julia"},{"id":20,"start":69.416,"end":73.361,"text":"I dåpen lover vi å oppdra henne i kristen tro.","zh":"在洗礼上，我们要承诺按基督教信仰养育她。","words":[[0,1,69.416,69.521,"i"],[2,7,69.576,70.101,"dåpen"],[8,13,70.476,70.881,"lover"],[14,16,70.896,71.041,"vi"],[17,18,71.276,71.381,"å"],[19,25,71.456,71.858,"oppdra"],[26,31,71.858,72.181,"henne"],[32,33,72.476,72.581,"i"],[34,41,72.616,73.121,"kristen"],[42,45,73.156,73.361,"tro"]],"speaker":"Julia"},{"id":21,"start":74.276,"end":75.621,"text":"Men det er jo problemet!","zh":"可这就是问题所在呀！","words":[[0,3,74.276,74.441,"men"],[4,7,74.476,74.661,"det"],[8,10,74.776,74.941,"er"],[11,13,74.956,75.119,"jo"],[14,23,75.119,75.621,"problemet"]],"speaker":"Pablo"},{"id":22,"start":76.296,"end":77.401,"text":"Jeg tror ikke på Gud.","zh":"我不相信上帝。","words":[[0,3,76.296,76.521,"jeg"],[4,8,76.576,76.809,"tror"],[9,13,76.809,76.999,"ikke"],[14,16,76.999,77.099,"på"],[17,20,77.099,77.401,"gud"]],"speaker":"Pablo"},{"id":23,"start":77.916,"end":79.201,"text":"Jeg vil ikke love noe slikt!","zh":"我不愿意作这样的承诺！","words":[[0,3,77.916,78.038,"jeg"],[4,7,78.038,78.159,"vil"],[8,12,78.159,78.379,"ikke"],[13,17,78.379,78.728,"love"],[18,21,78.728,78.879,"noe"],[22,27,78.879,79.201,"slikt"]],"speaker":"Pablo"},{"id":24,"start":80.436,"end":82.701,"text":"Nå er du fryktelig vanskelig, Pablo.","zh":"巴勃罗，你现在真是太难沟通了。","words":[[0,2,80.436,80.581,"nå"],[3,5,80.776,80.928,"er"],[6,8,80.928,81.061,"du"],[9,18,81.236,81.858,"fryktelig"],[19,28,81.858,82.349,"vanskelig"],[30,35,82.349,82.701,"pablo"]],"speaker":"Julia"},{"id":25,"start":83.956,"end":85.261,"text":"Hva sier foreldrene dine?","zh":"你的父母怎么说？","words":[[0,3,83.956,84.121,"hva"],[4,8,84.136,84.399,"sier"],[9,19,84.399,84.999,"foreldrene"],[20,24,84.999,85.261,"dine"]],"speaker":"Julia"},{"id":26,"start":86.336,"end":88.321,"text":"Mamma og pappa er sikkert enige med deg.","zh":"我爸妈肯定赞同你。","words":[[0,5,86.336,86.641,"mamma"],[6,8,86.656,86.788,"og"],[9,14,86.788,87.101,"pappa"],[15,17,87.256,87.399,"er"],[18,25,87.399,87.738,"sikkert"],[26,31,87.738,88.038,"enige"],[32,35,88.038,88.159,"med"],[36,39,88.159,88.321,"deg"]],"speaker":"Pablo"},{"id":27,"start":89.056,"end":90.921,"text":"De regner med at vi skal ha barnedåp.","zh":"他们想当然地认为我们会给孩子办洗礼。","words":[[0,2,89.056,89.201,"de"],[3,9,89.256,89.599,"regner"],[10,13,89.599,89.761,"med"],[14,16,89.776,89.898,"at"],[17,19,89.898,89.999,"vi"],[20,24,89.999,90.168,"skal"],[25,27,90.168,90.281,"ha"],[28,36,90.356,90.921,"barnedåp"]],"speaker":"Pablo"},{"id":28,"start":91.926,"end":92.611,"text":"Der ser du!","zh":"你看吧！","words":[[0,3,91.926,92.151,"der"],[4,7,92.206,92.488,"ser"],[8,10,92.488,92.611,"du"]],"speaker":"Julia"}],"lexicon":{"3":{"lemma":"3","pos":"数词","zh":"数字 3","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"barnedåp":{"lemma":"barnedåp","zh":"婴儿洗礼","pos":"名词","ref":"10-088","clip":null},"bestemme":{"lemma":"bestemme","zh":"决定；做主","pos":"动词","ref":"14-050","clip":null},"datter":{"lemma":"datter","zh":"女儿","pos":"名词","ref":"ty-conversation-8-002","clip":null},"dattera":{"lemma":"datter","zh":"女儿","pos":"名词","ref":"3-006","form":"单数定指","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dine":{"lemma":"dine","zh":"你的（复数）","pos":"物主限定词","ref":"10-011","clip":null},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"dåpen":{"lemma":"dåp","pos":"名词","zh":"洗礼","ref":null,"clip":null,"form":"单数定指"},"døpe":{"lemma":"døpe","zh":"施洗","pos":"动词","ref":"10-090","clip":null},"ei":{"lemma":"ei","pos":"冠词","form":"阴性","zh":"一（个）（阴性不定冠词）","ref":null,"clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"enige":{"lemma":"enig","zh":"同意","pos":"形容词","ref":"8-073","form":"复数/定指","clip":null},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"familiene":{"lemma":"familie","zh":"家庭","pos":"名词","ref":"2-056","form":"复数定指","clip":null},"feire":{"lemma":"feire","zh":"庆祝","pos":"动词","ref":"8-132","clip":null},"fest":{"lemma":"fest","zh":"聚会","pos":"名词","ref":"6-072","clip":null},"fin":{"lemma":"fin","zh":"好的；美好的","pos":"形容词","ref":"ty-conversation-1-006","clip":null,"form":"通性"},"for":{"lemma":"for","pos":"介词","zh":"为；对于；因为（依结构而定）","ref":null,"clip":null},"foreldrene":{"lemma":"foreldre","zh":"父母","pos":"名词","ref":"3-036","form":"复数定指","clip":null},"fryktelig":{"lemma":"fryktelig","zh":"可怕的；糟糕的","pos":"形容词","ref":"pa-vei-9-105","clip":null},"født":{"lemma":"føde","pos":"动词","zh":"出生","ref":null,"clip":null,"form":"过去分词"},"gammel":{"lemma":"gammel","zh":"旧的；年老的","pos":"形容词","ref":"8-023","clip":null},"gift":{"lemma":"gift","zh":"已婚","pos":"形容词","ref":"2-009","clip":null},"gud":{"lemma":"gud","pos":"名词","zh":"神","ref":null,"clip":null},"ha":{"lemma":"ha","zh":"有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"不定式"},"han":{"lemma":"han","zh":"他","pos":"代词","ref":"ty-conversation-8-008