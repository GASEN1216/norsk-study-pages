{"id":"pa-vei-4.A","bookId":"pa-vei-textbook","readingId":"4.A","title":"God morgen!","audio":"audio/pa-vei/4.A.mp3","duration":93.204,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.98,"end":2.805,"text":"A. God morgen!","zh":"A. 早上好！","words":[[0,1,0.98,1.32,"a"],[3,6,2.24,2.422,"god"],[7,13,2.422,2.805,"morgen"]]},{"id":1,"start":4.68,"end":6.685,"text":"Hei, Emma! God morgen.","zh":"嗨，埃玛！早上好。","words":[[0,3,4.68,4.945,"hei"],[5,9,5.04,5.305,"emma"],[11,14,6.1,6.293,"god"],[15,21,6.293,6.685,"morgen"]],"speaker":"Henrik"},{"id":2,"start":7.82,"end":10.705,"text":"God morgen. Å, jeg er så trøtt!","zh":"早上好。啊，我好困！","words":[[0,3,7.82,7.982,"god"],[4,10,7.982,8.445,"morgen"],[12,13,9.0,9.48,"å"],[15,18,9.5,9.703,"jeg"],[19,21,9.703,9.845,"er"],[22,24,9.88,10.045,"så"],[25,30,10.16,10.705,"trøtt"]],"speaker":"Emma"},{"id":3,"start":11.9,"end":13.285,"text":"Det hjelper med litt frokost.","zh":"吃点早餐会好一些。","words":[[0,3,11.9,12.033,"det"],[4,11,12.033,12.383,"hjelper"],[12,15,12.383,12.482,"med"],[16,20,12.482,12.683,"litt"],[21,28,12.683,13.285,"frokost"]],"speaker":"Henrik"},{"id":4,"start":14.28,"end":17.965,"text":"Her er to brødskiver, ei med salami og ei med syltetøy.","zh":"这里有两片面包，一片配萨拉米香肠，一片抹果酱。","words":[[0,3,14.28,14.502,"her"],[4,6,14.502,14.645,"er"],[7,9,14.66,14.825,"to"],[10,20,14.84,15.445,"brødskiver"],[22,24,16.02,16.172,"ei"],[25,28,16.172,16.322,"med"],[29,35,16.322,16.825,"salami"],[36,38,16.88,17.025,"og"],[39,41,17.04,17.203,"ei"],[42,45,17.203,17.422,"med"],[46,54,17.422,17.965,"syltetøy"]],"speaker":"Henrik"},{"id":5,"start":18.82,"end":19.285,"text":"Vær så god.","zh":"给你。","words":[[0,3,18.82,18.983,"vær@pa-vei-vær-be"],[4,6,18.983,19.102,"så"],[7,10,19.102,19.285,"god"]],"speaker":"Henrik"},{"id":6,"start":20.46,"end":22.625,"text":"Takk. Hvor er melka?","zh":"谢谢。牛奶在哪里？","words":[[0,4,20.46,21.025,"takk"],[6,10,21.8,21.962,"hvor"],[11,13,21.962,22.125,"er"],[14,19,22.18,22.625,"melka"]],"speaker":"Emma"},{"id":7,"start":23.86,"end":24.825,"text":"Den står på bordet.","zh":"在桌上。","words":[[0,3,23.86,24.045,"den"],[4,8,24.08,24.343,"står"],[9,11,24.343,24.465,"på"],[12,18,24.48,24.825,"bordet"]],"speaker":"Henrik"},{"id":8,"start":26.1,"end":30.185,"text":"Pappa, mat! Jeg er sulten.","zh":"爸爸，我要吃饭！我饿了。","words":[[0,5,26.1,26.785,"pappa"],[7,10,27.82,28.445,"mat"],[12,15,28.84,29.005,"jeg"],[16,18,29.02,29.165,"er"],[19,25,29.32,30.185,"sulten"]],"speaker":"Jonas"},{"id":9,"start":31.66,"end":33.245,"text":"Her har du ei brødskive med ost.","zh":"给你一片奶酪面包。","words":[[0,3,31.66,31.852,"her"],[4,7,31.852,32.002,"har"],[8,10,32.002,32.123,"du"],[11,13,32.123,32.242,"ei"],[14,23,32.242,32.772,"brødskive"],[24,27,32.772,32.912,"med"],[28,31,32.912,33.245,"ost"]],"speaker":"Henrik"},{"id":10,"start":34.5,"end":36.325,"text":"Har du lyst på et glass jus, Marianne?","zh":"玛丽安娜，你想喝一杯果汁吗？","words":[[0,3,34.5,34.623,"har"],[4,6,34.623,34.742,"du"],[7,11,34.742,34.972,"lyst@pa-vei-lyst-desire"],[12,14,34.972,35.073,"på"],[15,17,35.073,35.213,"et"],[18,23,35.213,35.505,"glass"],[24,27,35.58,35.905,"jus"],[29,37,35.92,36.325,"marianne"]],"speaker":"Henrik"},{"id":11,"start":37.54,"end":38.105,"text":"Ja, takk.","zh":"好的，谢谢。","words":[[0,2,37.54,37.685,"ja"],[4,8,37.82,38.105,"takk"]],"speaker":"Marianne"},{"id":12,"start":39.2,"end":40.245,"text":"Hvordan går det med kaffen?","zh":"咖啡怎么样了？","words":[[0,7,39.2,39.483,"hvordan"],[8,11,39.483,39.642,"går"],[12,15,39.642,39.763,"det"],[16,19,39.763,39.873,"med"],[20,26,39.873,40.245,"kaffen"]],"speaker":"Henrik"},{"id":13,"start":41.28,"end":42.525,"text":"Den er snart ferdig.","zh":"快好了。","words":[[0,3,41.28,41.462,"den"],[4,6,41.462,41.605,"er"],[7,12,41.66,42.125,"snart"],[13,19,42.16,42.525,"ferdig"]],"speaker":"Marianne"},{"id":14,"start":45.4,"end":46.465,"text":"Hvor er sekken?","zh":"书包在哪里？","words":[[0,4,45.4,45.663,"hvor"],[5,7,45.663,45.825,"er"],[8,14,45.88,46.465,"sekken"]],"speaker":"Emma"},{"id":15,"start":48.06,"end":49.225,"text":"Den står under bordet.","zh":"在桌子下面。","words":[[0,3,48.06,48.225,"den"],[4,8,48.26,48.565,"står"],[9,14,48.6,48.885,"under"],[15,21,48.9,49.225,"bordet"]],"speaker":"Henrik"},{"id":16,"start":50.06,"end":52.105,"text":"Og matpakka ligger på bordet.","zh":"带去吃的午餐放在桌上。","words":[[0,2,50.06,50.183,"og"],[3,11,50.183,50.785,"matpakka"],[12,18,51.28,51.545,"ligger"],[19,21,51.56,51.705,"på"],[22,28,51.78,52.105,"bordet"]],"speaker":"Henrik"},{"id":17,"start":53.42,"end":54.725,"text":"Hva er det på brødet?","zh":"面包上抹了什么？","words":[[0,3,53.42,53.565,"hva"],[4,6,53.72,53.993,"er"],[7,10,53.993,54.132,"det"],[11,13,54.132,54.245,"på"],[14,20,54.28,54.725,"brødet"]],"speaker":"Emma"},{"id":18,"start":55.98,"end":57.285,"text":"Leverpostei og ost.","zh":"肝酱和奶酪。","words":[[0,11,55.98,56.705,"leverpostei"],[12,14,56.8,56.925,"og"],[15,18,56.94,57.285,"ost"]],"speaker":"Henrik"},{"id":19,"start":58.2,"end":59.225,"text":"Og så får du et eple.","zh":"另外再给你一个苹果。","words":[[0,2,58.2,58.312,"og"],[3,5,58.312,58.445,"så"],[6,9,58.46,58.623,"får"],[10,12,58.623,58.742,"du"],[13,15,58.742,58.892,"et"],[16,20,58.892,59.225,"eple"]],"speaker":"Henrik"},{"id":20,"start":60.92,"end":63.925,"text":"Hvor er eplet? Jeg ser det ikke.","zh":"苹果在哪里？我没看到。","words":[[0,4,60.92,61.185,"hvor"],[5,7,61.64,61.903,"er"],[8,13,61.903,62.285,"eplet"],[15,18,62.82,63.005,"jeg"],[19,22,63.1,63.465,"ser"],[23,26,63.48,63.632,"det"],[27,31,63.632,63.925,"ikke"]],"speaker":"Emma"},{"id":21,"start":65.14,"end":67.725,"text":"Huff! Det ligger på gulvet.","zh":"哎呀！在地板上。","words":[[0,4,65.14,65.84,"huff"],[6,9,66.34,66.505,"det"],[10,16,66.52,66.905,"ligger"],[17,19,66.92,67.045,"på"],[20,26,67.18,67.725,"gulvet"]],"speaker":"Marianne"},{"id":22,"start":69.04,"end":70.605,"text":"Men nå er kaffen ferdig!","zh":"不过现在咖啡好了！","words":[[0,3,69.04,69.225,"men"],[4,6,69.26,69.405,"nå"],[7,9,69.5,69.645,"er"],[10,16,69.68,70.105,"kaffen"],[17,23,70.16,70.605,"ferdig"]],"speaker":"Marianne"},{"id":23,"start":71.72,"end":74.395,"text":"Oi. Jeg har ikke tid til kaffe.","zh":"哎哟。我没时间喝咖啡了。","words":[[0,2,71.72,72.04,"oi"],[4,7,73.09,73.252,"jeg"],[8,11,73.252,73.433,"har"],[12,16,73.433,73.653,"ikke"],[17,20,73.653,73.893,"tid"],[21,24,73.893,74.035,"til"],[25,30,74.05,74.395,"kaffe"]],"speaker":"Henrik"},{"id":24,"start":75.09,"end":76.015,"text":"Bussen går snart.","zh":"公交车快开了。","words":[[0,6,75.09,75.475,"bussen"],[7,10,75.49,75.703,"går"],[11,16,75.703,76.015,"snart"]],"speaker":"Henrik"},{"id":25,"start":77.03,"end":78.655,"text":"Emma, er du klar?","zh":"埃玛，你准备好了吗？","words":[[0,4,77.03,77.295,"emma"],[6,8,78.01,78.142,"er"],[9,11,78.142,78.255,"du"],[12,16,78.31,78.655,"klar"]],"speaker":"Henrik"},{"id":26,"start":79.61,"end":82.355,"text":"Snart. Jeg finner ikke kammen.","zh":"快好了。我找不到梳子。","words":[[0,5,79.61,80.195,"snart"],[7,10,80.65,80.835,"jeg"],[11,17,80.95,81.375,"finner"],[18,22,81.39,81.655,"ikke"],[23,29,81.71,82.355,"kammen"]],"speaker":"Emma"},{"id":27,"start":83.62,"end":88.725,"text":"Her er en hårbørste. Sånn. Nå er du fin på håret.","zh":"这里有把发刷。好了。现在你的头发很漂亮了。","words":[[0,3,83.62,83.905,"her"],[4,6,83.96,84.143,"er"],[7,9,84.143,84.282,"en"],[10,19,84.282,85.045,"hårbørste"],[21,25,86.22,86.645,"sånn"],[27,29,87.44,87.565,"nå"],[30,32,87.68,87.802,"er"],[33,35,87.802,87.905,"du"],[36,39,87.96,88.222,"fin"],[40,42,88.222,88.345,"på"],[43,48,88.36,88.725,"håret"]],"speaker":"Marianne"},{"id":28,"start":90.26,"end":91.585,"text":"Men hvor er Jonas?","zh":"可是约纳斯在哪里？","words":[[0,3,90.26,90.425,"men"],[4,8,90.46,90.703,"hvor"],[9,11,90.703,90.865,"er"],[12,17,90.92,91.585,"jonas"]],"speaker":"Marianne"}],"lexicon":{"a":{"lemma":"A","pos":"字母","zh":"字母 A","ref":null,"clip":null},"bordet":{"lemma":"bord","zh":"桌子","pos":"名词","ref":"basics:housing:bord","form":"单数定指","clip":null},"brødet":{"lemma":"brød","zh":"面包","pos":"名词","ref":"3-068","form":"单数定指","clip":null},"brødskive":{"lemma":"brødskive","zh":"一片面包","pos":"名词","ref":"pa-vei-4-004","clip":null},"brødskiver":{"l