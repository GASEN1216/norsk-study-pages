{"id":"10.2","title":"Vil dere komme i bryllupet vårt?","audio":"audio/10.2.mp3","duration":154.0,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.52,"text":"10.2 Vil dere komme i bryllupet vårt?","heading":true,"zh":"10.2 你们愿意来参加我们的婚礼吗？","words":[[0,4,0.15,1.07,"10.2"],[5,8,2.0,2.56,"vil"],[9,13,2.56,2.82,"dere"],[14,19,2.82,3.32,"komme"],[20,21,3.32,3.52,"i~53ced13da10d"],[22,31,3.52,4.06,"bryllupet"],[32,36,4.06,4.44,"vårt"]]},{"id":1,"start":6.57,"end":15.48,"text":"Sompit og Kjetil skal reise til Ålesund i morgen tidlig, for de har fått en invitasjon til et bryllup.","zh":"松皮特和谢蒂尔明天一早要去奥勒松，因为他们收到了一份婚礼邀请。","words":[[0,6,6.65,7.33,"sompit"],[7,9,7.33,7.51,"og"],[10,16,7.51,8.07,"kjetil"],[17,21,8.65,8.87,"skal"],[22,27,8.87,9.29,"reise~e552edad1657"],[28,31,9.29,9.51,"til"],[32,39,9.51,10.17,"ålesund"],[40,41,10.17,10.49,"i~46048fbe603f"],[42,48,10.49,10.77,"morgen~709e4ceb9c48"],[49,55,10.77,11.55,"tidlig"],[57,60,11.86,12.42,"for~1b22712a94b1"],[61,63,12.42,12.64,"de"],[64,67,12.64,12.84,"har~8b9792170cca"],[68,72,12.84,13.06,"fått"],[73,75,13.06,13.26,"en~a939a9e56dc5"],[76,86,13.26,14.04,"invitasjon"],[87,90,14.28,14.56,"til"],[91,93,14.56,14.78,"et~054dde72f37b"],[94,101,14.78,15.4,"bryllup"]]},{"id":2,"start":16.77,"end":19.87,"text":"Nå pakker de og gjør seg klare til å reise.","zh":"现在他们正在收拾行李，准备出发。","words":[[0,2,16.85,17.09,"nå~d531d47a7712"],[3,9,17.09,17.53,"pakker~d543e26d4b10"],[10,12,17.53,17.73,"de"],[13,15,17.73,18.25,"og"],[16,20,18.25,18.43,"gjør"],[21,24,18.43,18.57,"seg"],[25,30,18.57,18.99,"klare~4f46751f7e8d"],[31,34,19.09,19.17,"til"],[35,36,19.17,19.29,"å~0583da7a620a"],[37,42,19.29,19.79,"reise~4e66e596f7e3"]]},{"id":3,"start":21.57,"end":22.82,"text":"Gleder du deg?","speaker":"Kjetil","zh":"你期待吗？","words":[[0,6,21.66,22.25,"gleder"],[7,9,22.25,22.39,"du"],[10,13,22.39,22.74,"deg"]]},{"id":4,"start":23.78,"end":29.25,"text":"Ja, jeg har jo aldri vært i bryllup i Norge. Og du?","speaker":"Sompit","zh":"是啊，我可从来没参加过挪威的婚礼。你呢？","words":[[0,2,23.86,24.22,"ja"],[4,7,25.34,25.54,"jeg"],[8,11,25.54,25.78,"har~8b9792170cca"],[12,14,25.78,25.94,"jo~c8a41e45585d"],[15,20,25.94,26.3,"aldri"],[21,25,26.3,26.56,"vært"],[26,27,26.56,26.7,"i~74358c3ac557"],[28,35,26.7,27.16,"bryllup"],[36,37,27.16,27.36,"i"],[38,43,27.36,27.62,"norge~546b56e35dd5"],[45,47,28.28,28.84,"og"],[48,50,28.84,29.17,"du"]]},{"id":5,"start":30.13,"end":43.65,"text":"Ja, jeg gleder meg veldig til å se Morten igjen. Vi var sammen nesten hver dag på ungdomsskolen og på videregående. Han flyttet til Ålesund for mange år siden.","speaker":"Kjetil","zh":"是啊，我非常期待再见到莫滕。初中和高中时我们几乎天天在一起。他很多年前搬到了奥勒松。","words":[[0,2,30.21,30.41,"ja"],[4,7,30.91,31.55,"jeg"],[8,14,31.55,31.83,"gleder"],[15,18,31.83,31.99,"meg"],[19,25,31.99,32.49,"veldig"],[26,29,32.49,32.73,"til~053dd24981ff"],[30,31,32.73,32.85,"å~0583da7a620a"],[32,34,32.85,33.03,"se"],[35,41,33.03,33.43,"morten"],[42,47,33.43,33.69,"igjen"],[49,51,34.55,35.11,"vi"],[52,55,35.11,35.29,"var"],[56,62,35.29,35.71,"sammen"],[63,69,35.71,36.15,"nesten"],[70,74,36.15,36.35,"hver"],[75,78,36.35,36.53,"dag"],[79,81,36.55,36.83,"på"],[82,95,36.83,37.55,"ungdomsskolen"],[96,98,37.55,38.35,"og"],[99,101,38.35,38.59,"på"],[102,114,38.59,39.33,"videregående"],[116,119,40.43,40.75,"han"],[120,127,40.75,41.21,"flyttet"],[128,131,41.21,41.49,"til"],[132,139,41.49,42.13,"ålesund"],[140,143,42.13,42.43,"for~e753a937d19e"],[144,149,42.43,42.83,"mange"],[150,152,42.83,43.11,"år"],[153,158,43.11,43.57,"siden~9a3d2d89a980"]]},{"id":6,"start":44.49,"end":46.28,"text":"Kommer Signe fra Ålesund?","speaker":"Sompit","zh":"西格妮是奥勒松人吗？","words":[[0,6,44.57,44.87,"kommer"],[7,12,44.87,45.29,"signe"],[13,16,45.29,45.63,"fra"],[17,24,45.63,46.2,"ålesund"]]},{"id":7,"start":47.2,"end":55.2,"text":"Ja, de bor ved sjøen litt utenfor sentrum, i et gammelt, nyoppusset hus.","speaker":"Kjetil","zh":"是的，他们住在市中心外不远的海边，一栋刚翻修过的老房子里。","words":[[0,2,47.28,47.5,"ja"],[4,6,48.18,48.6,"de"],[7,10,48.6,48.9,"bor"],[11,14,48.9,49.2,"ved"],[15,20,49.2,49.7,"sjøen"],[21,25,50.28,50.48,"litt~54360be2a478"],[26,33,50.48,51.04,"utenfor"],[34,41,51.04,51.6,"sentrum"],[43,44,52.22,52.56,"i"],[45,47,52.56,52.84,"et~054dde72f37b"],[48,55,52.84,53.56,"gammelt"],[57,67,53.86,54.68,"nyoppusset"],[68,71,54.68,55.12,"hus"]]},{"id":8,"start":56.18,"end":57.59,"text":"Hvor skal vi bo, da?","speaker":"Sompit","zh":"那我们住哪儿呢？","words":[[0,4,56.26,56.49,"hvor"],[5,9,56.49,56.73,"skal"],[10,12,56.73,57.01,"vi"],[13,15,57.01,57.21,"bo"],[17,19,57.25,57.51,"da~38911ce223ea"]]},{"id":9,"start":58.5,"end":66.82,"text":"Jeg har bestilt rom på et lite hotell i sentrum. Hotellet vårt er veldig koselig.","speaker":"Kjetil","zh":"我在市中心的一家小酒店订了房间。我们住的酒店非常温馨。","words":[[0,3,58.58,58.88,"jeg"],[4,7,58.88,59.16,"har~8b9792170cca"],[8,15,59.16,59.68,"bestilt"],[16,19,59.68,60.04,"rom"],[20,22,60.04,60.9,"på"],[23,25,60.9,61.12,"et~054dde72f37b"],[26,30,61.12,61.52,"lite"],[31,37,61.52,62.04,"hotell"],[38,39,62.04,62.32,"i"],[40,47,62.32,62.82,"sentrum"],[49,57,64.08,64.54,"hotellet"],[58,62,64.54,64.82,"vårt"],[63,65,64.82,65.6,"er"],[66,72,65.6,66.14,"veldig"],[73,80,66.14,66.74,"koselig"]]},{"id":10,"start":67.73,"end":69.98,"text":"Kan foreldrene dine passe Bella?","speaker":"Sompit","zh":"你父母能照看贝拉吗？","words":[[0,3,67.81,68.01,"kan"],[4,14,68.01,68.63,"foreldrene"],[15,19,68.63,68.91,"dine"],[20,25,68.91,69.27,"passe~65edbc1cf062"],[26,31,69.27,69.9,"bella"]]},{"id":11,"start":70.11,"end":74.34,"text":"Ja, mora mi henter henne i kveld.","speaker":"Kjetil","zh":"能，我妈妈今晚来接它。","words":[[0,2,70.42,71.08,"ja"],[4,8,71.92,72.44,"mora"],[9,11,72.44,72.76,"mi"],[12,18,72.76,73.32,"henter"],[19,24,73.32,73.58,"henne~e95eea9a9b77"],[25,26,73.58,73.84,"i~b771fab22ceb"],[27,32,73.84,74.26,"kveld"]]},{"id":12,"start":75.49,"end":78.95,"text":"Kan jeg ha på meg den gule kjolen min i bryllupet?","speaker":"Sompit","zh":"我能在婚礼上穿我那条黄色连衣裙吗？","words":[[0,3,75.57,75.77,"kan"],[4,7,75.77,75.99,"jeg"],[8,10,75.99,76.21,"ha~c8c0687d8865"],[11,13,76.21,76.35,"på~c626281c000c"],[14,17,76.35,76.53,"meg"],[18,21,76.53,76.75,"den~5f413bef0ba1"],[22,26,76.75,77.29,"gule"],[27,33,77.29,77.69,"kjolen"],[34,37,77.69,77.87,"min"],[38,39,77.87,78.31,"i"],[40,49,78.31,78.87,"bryllupet"]]},{"id":13,"start":79.52,"end":85.01,"text":"Ja, du er fin i den. Har du kjøpt en gave?","speaker":"Kjetil","zh":"可以，你穿它很好看。你买礼物了吗？","words":[[0,2,79.6,79.89,"ja"],[4,6,80.63,80.87,"du"],[7,9,80.87,81.13,"er"],[10,13,81.13,81.53,"fin~a8872ba7f154"],[14,15,81.53,81.73,"i~c7e3ac8c257b"],[16,19,81.73,81.93,"den"],[21,24,83.17,83.65,"har~8b9792170cca"],[25,27,83.65,83.81,"du"],[28,33,83.81,84.19,"kjøpt"],[34,36,84.19,84.43,"en~a939a9e56dc5"],[37,41,84.43,84.93,"gave"]]},{"id":14,"start":85.01,"end":94.77,"text":"Ja, jeg har kjøpt en pen vase. Det er en typisk gave til et brudepar, sa de i butikken.","speaker":"Sompit","zh":"买了，我买了一个漂亮的花瓶。店里的人说，这是送给新婚夫妇的典型礼物。","words":[[0,2,85.78,86.44,"ja"],[4,7,87.34,87.66,"jeg"],[8,11,87.66,87.84,"har~8b9792170cca"],[12,17,87.84,88.18,"kjøpt"],[18,20,88.18,88.48,"en~a939a9e56dc5"],[21,24,88.48,88.78,"pen"],[25,29,88.78,89.1,"vase"],[31,34,90.42,90.7,"det"],[35,37,90.7,90.84,"er"],[38,40,90.84,91.0,"en~a939a9e56dc5"],[41,47,91.0,91.62,"typisk"],[48,52,91.62,92.14,"gave"],[53,56,92.2,92.38,"til"],[57,59,92.38,92.56,"et~054dde72f37b"],[60,68,92.56,93.18,"brudepar"],[70,72,93.66,93.84,"sa"],[73,75,93.84,94.04,"de"],[76,77,94.04,94.18,"i"],[78,86,94.18,94.69,"butikken"]]},{"id":15,"start":95.74,"end":96.42,"text":"Bra!","speaker":"Kjetil","zh":"很好！","words":[[0,3,95.82,96.34,"bra~bbb83846e29f"]]},{"id":16,"start":96.43,"end":99.07,"text":"Har vi pakket alt?","speaker":"Sompit","zh":"我们都收拾好了吗？","words":[[0,3,97.48,98.02,"har~8b9792170cca"],[4,6,98.02,98.14,"vi"],[7,13,98.14,98.48,"pakket~3c40427d3964"],[14,17,98.48,98.99,"alt"]]},{"id":17,"start":100.14,"end":111.75,"text":"Ja, det tror jeg. Vi har med klær til både grillfesten og bryllupet: sko, toalettsakene våre og gaven til brudeparet.","speaker":"Kjetil","zh":"是的，我想都收拾好了。我们带了烧烤派对和婚礼要穿的衣服，还有鞋子、洗漱用品，以及给新婚夫妇的礼物。","words":[[0,2,100.22,100.46,"ja"],[4,7,100.72,100.88,"det"],[8,12,100.88,101.14,"tror"],[13,16,101.14,101.4,"jeg"],[18,20,102.38,102.7,"vi"],[21,24,102.7,102.98,"har~00cb822f5062"],[25,28,102.98,103.2,"med~6f41e4627a11"],[29,33,103.2,103.52,"klær"],[34,37,103.52,103.84,"til~500041fe316e"],[38,42,103.84,104.08,"både"],[43,54,104.08,105.04,"grillfesten"],[55,57,105.04,105.7,"og"],[58,67,105.7,106.28,"bryllupet"],[69,72,106.92,107.56,"sko"],[74,87,108.34,109.14,"toalettsakene"],[88,92,109.14,109.4,"våre"],[93,95,109.4,110.16,"og"],[96,101,110.16,110.62,"gaven"],[102,105,110.62,110.92,"til"],[106,116,110.92,111.67,"brudeparet"]]},{"id":18,"start":115.42,"end":116.5,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,115.5,116.42,"sammendrag"]]},{"id":19,"start":118.16,"end":122.08,"text":"Sompit og Kjetil skal reise til Ålesund i bryllup.","zh":"松皮特和谢蒂尔要去奥勒松参加婚礼。","words":[[0,6,118.23,118.82,"sompit"],[7,9,118.82,118.96,"og"],[10,16,118.96,119.46,"kjetil"],[17,21,119.46,119.76,"skal"],[22,27,119.76,120.28,"reise~e552edad1657"],[28,31,120.28,120.5,"til"],[32,39,120.5,121.2,"ålesund"],[40,41,121.2,121.42,"i~d742d6f193c7"],[42,49,121.42,122.0,"bryllup"]]},{"id":20,"start":123.31,"end":128.26,"text":"Sompit gleder seg, for hun har aldri vært i et norsk bryllup før.","zh":"松皮特很期待，因为她以前从没参加过挪威的婚礼。","words":[[0,6,123.39,123.88,"sompit"],[7,13,123.88,124.36,"gleder"],[14,17,124.36,124.6,"seg"],[19,22,125.2,125.48,"for~1b22712a94b1"],[23,26,125.48,125.74,"hun"],[27,30,125.74,125.98,"har~8b9792170cca"],[31,36,125.98,126.36,"aldri"],[37,41,126.36,126.62,"vært"],[42,43,126.62,126.86,"i~74358c3ac557"],[44,46,126.86,127.04,"et~054dde72f37b"],[47,52,127.04,127.42,"norsk~300c0d0c4f59"],[53,60,127.42,127.82,"bryllup"],[61,64,127.82,128.18,"før~f9c047e06941"]]},{"id":21,"start":129.28,"end":132.23,"text":"Kjetil gleder seg til å se Morten igjen.","zh":"谢蒂尔盼着再见到莫滕。","words":[[0,6,129.36,129.98,"kjetil"],[7,13,129.98,130.52,"gleder"],[14,17,130.52,130.72,"seg"],[18,21,130.72,131.0,"til~053dd24981ff"],[22,23,131.0,131.1,"å~0583da7a620a"],[24,26,131.1,131.3,"se"],[27,33,131.3,131.72,"morten"],[34,39,131.72,132.15,"igjen"]]},{"id":22,"start":133.1,"end":137.45,"text":"De er barndomsvenner, men nå bor Morten i Ålesund.","zh":"他们是儿时的朋友，但现在莫滕住在奥勒松。","words":[[0,2,133.18,133.47,"de"],[3,5,133.47,133.79,"er"],[6,20,133.79,134.71,"barndomsvenner"],[22,25,135.23,135.43,"men"],[26,28,135.43,135.75,"nå~d531d47a7712"],[29,32,135.75,136.05,"bor"],[33,39,136.05,136.53,"morten"],[40,41,136.53,136.67,"i"],[42,49,136.67,137.37,"ålesund"]]},{"id":23,"start":138.76,"end":144.98,"text":"Sompit og Kjetil har pakket alt, og Kjetil har bestilt rom på et hotell i sentrum.","zh":"松皮特和谢蒂尔把东西都收拾好了，谢蒂尔还在市中心的一家酒店订了房间。","words":[[0,6,138.84,139.37,"sompit"],[7,9,139.37,139.51,"og"],[10,16,139.51,139.95,"kjetil"],[17,20,139.95,140.11,"har~8b9792170cca"],[21,27,140.11,140.53,"pakket~3c40427d3964"],[28,31,140.53,140.91,"alt"],[33,35,141.41,141.61,"og"],[36,42,141.61,142.17,"kjetil"],[43,46,142.17,142.43,"har~8b9792170cca"],[47,54,142.43,142.77,"bestilt"],[55,58,142.77,143.13,"rom"],[59,61,143.13,143.49,"på"],[62,64,143.49,143.63,"et~054dde72f37b"],[65,71,143.63,144.11,"hotell"],[72,73,144.11,144.27,"i"],[74,81,144.27,144.9,"sentrum"]]},{"id":24,"start":146.02,"end":150.11,"text":"Foreldrene hans skal passe Bella, hunden deres, i helga.","zh":"周末他的父母会照看他们的狗贝拉。","words":[[0,10,146.1,146.82,"foreldrene"],[11,15,146.82,147.18,"hans"],[16,20,147.18,147.5,"skal"],[21,26,147.5,147.8,"passe~65edbc1cf062"],[27,32,147.8,148.18,"bella"],[34,40,148.62,148.9,"hunden"],[41,46,148.9,149.4,"deres"],[48,49,149.48,149.58,"i"],[50,55,149.58,150.03,"helga"]]}],"lexicon":{"10.2":{"lemma":"10.2","zh":"第 10.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aldri":{"lemma":"aldri","zh":"从不；从来没有","pos":"副词","ref":"basics:grammar:aldri","clip":"pronunciation/d1f5a7278af42576f5dd.mp3"},"alt":{"lemma":"alt","zh":"一切","pos":"代词","ref":"10-054