{"id":"10.2","title":"Vil dere komme i bryllupet vårt?","audio":"audio/10.2.mp3","duration":154.0,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.52,"text":"10.2 Vil dere komme i bryllupet vårt?","heading":true,"zh":"10.2 你们愿意来参加我们的婚礼吗？","words":[[0,4,0.15,1.07,"10.2"],[5,8,2.0,2.56,"vil"],[9,13,2.56,2.82,"dere"],[14,19,2.82,3.32,"komme"],[20,21,3.32,3.52,"i~53ced13da10d"],[22,31,3.52,4.06,"bryllupet"],[32,36,4.06,4.44,"vårt"]]},{"id":1,"start":6.61,"end":15.54,"text":"Sompit og Kjetil skal reise til Ålesund i morgen tidlig, for de har fått en invitasjon til et bryllup.","zh":"松皮特和谢蒂尔明天一早要去奥勒松，因为他们收到了一份婚礼邀请。","words":[[0,6,6.67,7.42,"sompit"],[7,9,7.42,7.58,"og"],[10,16,7.58,8.26,"kjetil"],[17,21,8.7,8.98,"skal"],[22,27,8.98,9.38,"reise~e552edad1657"],[28,31,9.38,9.62,"til"],[32,39,9.62,10.42,"ålesund"],[40,41,10.42,10.54,"i~46048fbe603f"],[42,48,10.54,10.82,"morgen~709e4ceb9c48"],[49,55,10.82,11.34,"tidlig"],[57,60,12.32,12.48,"for~1b22712a94b1"],[61,63,12.48,12.74,"de"],[64,67,12.74,12.94,"har~8b9792170cca"],[68,72,12.94,13.18,"fått"],[73,75,13.18,13.34,"en~a939a9e56dc5"],[76,86,13.34,14.29,"invitasjon"],[87,90,14.44,14.66,"til"],[91,93,14.66,14.84,"et~054dde72f37b"],[94,101,14.84,15.39,"bryllup"]]},{"id":2,"start":16.8,"end":19.93,"text":"Nå pakker de og gjør seg klare til å reise.","zh":"现在他们正在收拾行李，准备出发。","words":[[0,2,16.86,17.2,"nå~d531d47a7712"],[3,9,17.2,17.58,"pakker~d543e26d4b10"],[10,12,17.58,17.88,"de"],[13,15,18.2,18.28,"og"],[16,20,18.28,18.48,"gjør"],[21,24,18.48,18.66,"seg"],[25,30,18.66,19.08,"klare~4f46751f7e8d"],[31,34,19.08,19.22,"til"],[35,36,19.22,19.32,"å~0583da7a620a"],[37,42,19.32,19.79,"reise~4e66e596f7e3"]]},{"id":3,"start":21.61,"end":22.89,"text":"Gleder du deg?","speaker":"Kjetil","zh":"你期待吗？","words":[[0,6,21.66,22.3,"gleder"],[7,9,22.3,22.46,"du"],[10,13,22.46,22.74,"deg"]]},{"id":4,"start":23.81,"end":29.3,"text":"Ja, jeg har jo aldri vært i bryllup i Norge. Og du?","speaker":"Sompit","zh":"是啊，我可从来没参加过挪威的婚礼。你呢？","words":[[0,2,23.87,24.31,"ja"],[4,7,25.4,25.64,"jeg"],[8,11,25.64,25.82,"har~8b9792170cca"],[12,14,25.82,26.02,"jo~c8a41e45585d"],[15,20,26.02,26.44,"aldri"],[21,25,26.44,26.66,"vært"],[26,27,26.66,26.74,"i~74358c3ac557"],[28,35,26.74,27.3,"bryllup"],[36,37,27.3,27.4,"i"],[38,43,27.4,27.89,"norge~546b56e35dd5"],[45,47,28.74,28.9,"og"],[48,50,28.9,29.15,"du"]]},{"id":5,"start":30.16,"end":43.71,"text":"Ja, jeg gleder meg veldig til å se Morten igjen. Vi var sammen nesten hver dag på ungdomsskolen og på videregående. Han flyttet til Ålesund for mange år siden.","speaker":"Kjetil","zh":"是啊，我非常期待再见到莫滕。初中和高中时我们几乎天天在一起。他很多年前搬到了奥勒松。","words":[[0,2,30.22,30.57,"ja"],[4,7,31.4,31.62,"jeg"],[8,14,31.62,31.9,"gleder"],[15,18,31.9,32.12,"meg"],[19,25,32.12,32.62,"veldig"],[26,29,32.62,32.8,"til~053dd24981ff"],[30,31,32.8,32.9,"å~0583da7a620a"],[32,34,32.9,33.12,"se"],[35,41,33.12,33.46,"morten"],[42,47,33.46,33.88,"igjen"],[49,51,34.94,35.18,"vi"],[52,55,35.18,35.36,"var"],[56,62,35.36,35.84,"sammen"],[63,69,35.84,36.18,"nesten"],[70,74,36.18,36.44,"hver"],[75,78,36.44,36.74,"dag"],[79,81,36.74,36.9,"på"],[82,95,36.9,37.88,"ungdomsskolen"],[96,98,38.24,38.42,"og"],[99,101,38.42,38.74,"på"],[102,114,38.74,39.58,"videregående"],[116,119,40.6,40.9,"han"],[120,127,40.9,41.36,"flyttet"],[128,131,41.36,41.62,"til"],[132,139,41.62,42.34,"ålesund"],[140,143,42.34,42.6,"for~e753a937d19e"],[144,149,42.6,43.02,"mange"],[150,152,43.02,43.18,"år"],[153,158,43.18,43.56,"siden~9a3d2d89a980"]]},{"id":6,"start":44.53,"end":46.34,"text":"Kommer Signe fra Ålesund?","speaker":"Sompit","zh":"西格妮是奥勒松人吗？","words":[[0,6,44.59,45.0,"kommer"],[7,12,45.0,45.5,"signe"],[13,16,45.5,45.72,"fra"],[17,24,45.72,46.19,"ålesund"]]},{"id":7,"start":47.23,"end":55.25,"text":"Ja, de bor ved sjøen litt utenfor sentrum, i et gammelt, nyoppusset hus.","speaker":"Kjetil","zh":"是的，他们住在市中心外不远的海边，一栋刚翻修过的老房子里。","words":[[0,2,47.3,47.63,"ja"],[4,6,48.38,48.7,"de"],[7,10,48.7,49.06,"bor"],[11,14,49.06,49.26,"ved"],[15,20,49.26,49.84,"sjøen"],[21,25,50.32,50.6,"litt~54360be2a478"],[26,33,50.6,51.16,"utenfor"],[34,41,51.16,51.84,"sentrum"],[43,44,52.4,52.64,"i"],[45,47,52.64,53.06,"et~054dde72f37b"],[48,55,53.06,53.9,"gammelt"],[57,67,53.9,54.74,"nyoppusset"],[68,71,54.74,55.1,"hus"]]},{"id":8,"start":56.22,"end":57.65,"text":"Hvor skal vi bo, da?","speaker":"Sompit","zh":"那我们住哪儿呢？","words":[[0,4,56.28,56.58,"hvor"],[5,9,56.58,56.86,"skal"],[10,12,56.86,57.08,"vi"],[13,15,57.08,57.32,"bo"],[17,19,57.32,57.5,"da~38911ce223ea"]]},{"id":9,"start":58.53,"end":66.9,"text":"Jeg har bestilt rom på et lite hotell i sentrum. Hotellet vårt er veldig koselig.","speaker":"Kjetil","zh":"我在市中心的一家小酒店订了房间。我们住的酒店非常温馨。","words":[[0,3,58.59,58.98,"jeg"],[4,7,58.98,59.24,"har~8b9792170cca"],[8,15,59.24,59.86,"bestilt"],[16,19,59.86,60.27,"rom"],[20,22,60.76,60.98,"på"],[23,25,60.98,61.28,"et~054dde72f37b"],[26,30,61.28,61.66,"lite"],[31,37,61.66,62.24,"hotell"],[38,39,62.24,62.4,"i"],[40,47,62.4,63.05,"sentrum"],[49,57,64.14,64.58,"hotellet"],[58,62,64.58,65.02,"vårt"],[63,65,65.44,65.78,"er"],[66,72,65.78,66.2,"veldig"],[73,80,66.2,66.75,"koselig"]]},{"id":10,"start":67.77,"end":70.04,"text":"Kan foreldrene dine passe Bella?","speaker":"Sompit","zh":"你父母能照看贝拉吗？","words":[[0,3,67.83,68.14,"kan"],[4,14,68.14,68.76,"foreldrene"],[15,19,68.76,69.06,"dine"],[20,25,69.06,69.48,"passe~65edbc1cf062"],[26,31,69.48,69.89,"bella"]]},{"id":11,"start":70.84,"end":74.4,"text":"Ja, mora mi henter henne i kveld.","speaker":"Kjetil","zh":"能，我妈妈今晚来接它。","words":[[0,2,70.91,71.26,"ja"],[4,8,72.16,72.56,"mora"],[9,11,72.56,72.96,"mi"],[12,18,72.96,73.4,"henter"],[19,24,73.4,73.74,"henne~e95eea9a9b77"],[25,26,73.74,73.86,"i~b771fab22ceb"],[27,32,73.86,74.25,"kveld"]]},{"id":12,"start":75.52,"end":79.01,"text":"Kan jeg ha på meg den gule kjolen min i bryllupet?","speaker":"Sompit","zh":"我能在婚礼上穿我那条黄色连衣裙吗？","words":[[0,3,75.58,75.84,"kan"],[4,7,75.84,76.06,"jeg"],[8,10,76.06,76.26,"ha~c8c0687d8865"],[11,13,76.26,76.4,"på~c626281c000c"],[14,17,76.4,76.62,"meg"],[18,21,76.62,76.86,"den~5f413bef0ba1"],[22,26,76.86,77.36,"gule"],[27,33,77.36,77.74,"kjolen"],[34,37,77.74,78.1,"min"],[38,39,78.26,78.34,"i"],[40,49,78.34,78.86,"bryllupet"]]},{"id":13,"start":79.56,"end":85.07,"text":"Ja, du er fin i den. Har du kjøpt en gave?","speaker":"Kjetil","zh":"可以，你穿它很好看。你买礼物了吗？","words":[[0,2,79.62,80.0,"ja"],[4,6,80.74,80.98,"du"],[7,9,80.98,81.28,"er"],[10,13,81.28,81.68,"fin~a8872ba7f154"],[14,15,81.68,81.78,"i~c7e3ac8c257b"],[16,19,81.78,82.14,"den"],[21,24,83.42,83.68,"har~8b9792170cca"],[25,27,83.68,83.92,"du"],[28,33,83.92,84.34,"kjøpt"],[34,36,84.34,84.5,"en~a939a9e56dc5"],[37,41,84.5,84.92,"gave"]]},{"id":14,"start":86.08,"end":94.83,"text":"Ja, jeg har kjøpt en pen vase. Det er en typisk gave til et brudepar, sa de i butikken.","speaker":"Sompit","zh":"买了，我买了一个漂亮的花瓶。店里的人说，这是送给新婚夫妇的典型礼物。","words":[[0,2,86.14,86.56,"ja"],[4,7,87.48,87.72,"jeg"],[8,11,87.72,87.94,"har~8b9792170cca"],[12,17,87.94,88.34,"kjøpt"],[18,20,88.34,88.54,"en~a939a9e56dc5"],[21,24,88.54,88.92,"pen"],[25,29,88.92,89.52,"vase"],[31,34,90.6,90.76,"det"],[35,37,90.76,90.9,"er"],[38,40,90.9,91.06,"en~a939a9e56dc5"],[41,47,91.06,91.78,"typisk"],[48,52,91.78,92.26,"gave"],[53,56,92.26,92.46,"til"],[57,59,92.46,92.66,"et~054dde72f37b"],[60,68,92.66,93.42,"brudepar"],[70,72,93.72,93.94,"sa"],[73,75,93.94,94.12,"de"],[76,77,94.12,94.2,"i"],[78,86,94.2,94.68,"butikken"]]},{"id":15,"start":95.75,"end":96.5,"text":"Bra!","speaker":"Kjetil","zh":"很好！","words":[[0,3,95.81,96.37,"bra~bbb83846e29f"]]},{"id":16,"start":97.75,"end":99.13,"text":"Har vi pakket alt?","speaker":"Sompit","zh":"我们都收拾好了吗？","words":[[0,3,97.81,98.06,"har~8b9792170cca"],[4,6,98.06,98.2,"vi"],[7,13,98.2,98.6,"pakket~3c40427d3964"],[14,17,98.6,98.98,"alt"]]},{"id":17,"start":100.18,"end":111.83,"text":"Ja, det tror jeg. Vi har med klær til både grillfesten og bryllupet: sko, toalettsakene våre og gaven til brudeparet.","speaker":"Kjetil","zh":"是的，我想都收拾好了。我们带了烧烤派对和婚礼要穿的衣服，还有鞋子、洗漱用品，以及给新婚夫妇的礼物。","words":[[0,2,100.24,100.62,"ja"],[4,7,100.72,101.0,"det"],[8,12,101.0,101.3,"tror"],[13,16,101.3,101.64,"jeg"],[18,20,102.58,102.84,"vi"],[21,24,102.84,103.12,"har~00cb822f5062"],[25,28,103.12,103.26,"med~6f41e4627a11"],[29,33,103.26,103.7,"klær"],[34,37,103.7,103.96,"til~500041fe316e"],[38,42,103.96,104.28,"både"],[43,54,104.28,105.24,"grillfesten"],[55,57,105.64,105.78,"og"],[58,67,105.78,106.48,"bryllupet"],[69,72,107.24,107.64,"sko"],[74,87,108.4,109.22,"toalettsakene"],[88,92,109.22,109.66,"våre"],[93,95,110.08,110.24,"og"],[96,101,110.24,110.82,"gaven"],[102,105,110.82,111.04,"til"],[106,116,111.04,111.68,"brudeparet"]]},{"id":18,"start":115.46,"end":116.55,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,115.52,116.4,"sammendrag"]]},{"id":19,"start":118.2,"end":122.15,"text":"Sompit og Kjetil skal reise til Ålesund i bryllup.","zh":"松皮特和谢蒂尔要去奥勒松参加婚礼。","words":[[0,6,118.26,118.88,"sompit"],[7,9,118.88,119.0,"og"],[10,16,119.0,119.66,"kjetil"],[17,21,119.66,119.94,"skal"],[22,27,119.94,120.38,"reise~e552edad1657"],[28,31,120.38,120.62,"til"],[32,39,120.62,121.38,"ålesund"],[40,41,121.38,121.46,"i~d742d6f193c7"],[42,49,121.46,122.0,"bryllup"]]},{"id":20,"start":123.35,"end":128.32,"text":"Sompit gleder seg, for hun har aldri vært i et norsk bryllup før.","zh":"松皮特很期待，因为她以前从没参加过挪威的婚礼。","words":[[0,6,123.41,124.0,"sompit"],[7,13,124.0,124.42,"gleder"],[14,17,124.42,124.82,"seg"],[19,22,125.28,125.6,"for~1b22712a94b1"],[23,26,125.6,125.82,"hun"],[27,30,125.82,126.1,"har~8b9792170cca"],[31,36,126.1,126.44,"aldri"],[37,41,126.44,126.8,"vært"],[42,43,126.8,126.92,"i~74358c3ac557"],[44,46,126.92,127.1,"et~054dde72f37b"],[47,52,127.1,127.48,"norsk~300c0d0c4f59"],[53,60,127.48,127.88,"bryllup"],[61,64,127.88,128.17,"før~f9c047e06941"]]},{"id":21,"start":129.33,"end":132.29,"text":"Kjetil gleder seg til å se Morten igjen.","zh":"谢蒂尔盼着再见到莫滕。","words":[[0,6,129.39,130.16,"kjetil"],[7,13,130.16,130.58,"gleder"],[14,17,130.58,130.88,"seg"],[18,21,130.88,131.06,"til~053dd24981ff"],[22,23,131.06,131.18,"å~0583da7a620a"],[24,26,131.18,131.42,"se"],[27,33,131.42,131.76,"morten"],[34,39,131.76,132.14,"igjen"]]},{"id":22,"start":133.21,"end":137.52,"text":"De er barndomsvenner, men nå bor Morten i Ålesund.","zh":"他们是儿时的朋友，但现在莫滕住在奥勒松。","words":[[0,2,133.27,133.6,"de"],[3,5,133.6,133.92,"er"],[6,20,133.92,134.96,"barndomsvenner"],[22,25,135.3,135.54,"men"],[26,28,135.54,135.86,"nå~d531d47a7712"],[29,32,135.86,136.18,"bor"],[33,39,136.18,136.6,"morten"],[40,41,136.6,136.72,"i"],[42,49,136.72,137.37,"ålesund"]]},{"id":23,"start":138.79,"end":145.03,"text":"Sompit og Kjetil har pakket alt, og Kjetil har bestilt rom på et hotell i sentrum.","zh":"松皮特和谢蒂尔把东西都收拾好了，谢蒂尔还在市中心的一家酒店订了房间。","words":[[0,6,138.85,139.44,"sompit"],[7,9,139.44,139.56,"og"],[10,16,139.56,140.02,"kjetil"],[17,20,140.02,140.2,"har~8b9792170cca"],[21,27,140.2,140.68,"pakket~3c40427d3964"],[28,31,140.68,141.25,"alt"],[33,35,141.52,141.7,"og"],[36,42,141.7,142.3,"kjetil"],[43,46,142.3,142.5,"har~8b9792170cca"],[47,54,142.5,142.92,"bestilt"],[55,58,142.92,143.38,"rom"],[59,61,143.38,143.52,"på"],[62,64,143.52,143.68,"et~054dde72f37b"],[65,71,143.68,144.22,"hotell"],[72,73,144.22,144.34,"i"],[74,81,144.34,144.88,"sentrum"]]},{"id":24,"start":146.07,"end":150.18,"text":"Foreldrene hans skal passe Bella, hunden deres, i helga.","zh":"周末他的父母会照看他们的狗贝拉。","words":[[0,10,146.13,146.88,"foreldrene"],[11,15,146.88,147.34,"hans"],[16,20,147.34,147.6,"skal"],[21,26,147.6,147.94,"passe~65edbc1cf062"],[27,32,147.94,148.46,"bella"],[34,40,148.6,149.0,"hunden"],[41,46,149.0,149.52,"deres"],[48,49,149.52,149.62,"i"],[50,55,149.62,150.03,"helga"]]}],"lexicon":{"10.2":{"lemma":"10.2","zh":"第 10.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"aldri":{"lemma":"aldri","zh":"从不；从来没有","pos":"副词","ref":"basics:grammar:aldri","clip":"pronunciation/d1f5a7278af42576f5dd.mp3"},"alt":{"lemma":"alt","zh":"所有东西；全部；一切","pos":"代词","ref":"10-054","clip":"pronunciation/4d48fba6cf5