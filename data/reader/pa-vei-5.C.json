{"id":"pa-vei-5.C","bookId":"pa-vei-textbook","readingId":"5.C","title":"Jeg står opp klokka seks","audio":"audio/pa-vei/5.C.mp3","duration":160.152,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":2.2,"end":5.885,"text":"C. Jeg står opp klokka seks","zh":"C. 我六点起床","words":[[0,1,2.2,2.72,"c"],[3,6,4.04,4.245,"jeg"],[7,11,4.36,4.762,"står"],[12,15,4.762,5.045,"opp"],[16,22,5.18,5.485,"klokka"],[23,27,5.54,5.885,"seks"]]},{"id":1,"start":8.0,"end":9.125,"text":"Monica forteller:","zh":"莫妮卡讲述：","words":[[0,6,8.0,8.565,"monica"],[7,16,8.62,9.125,"forteller"]]},{"id":2,"start":10.78,"end":14.345,"text":"Vekkerklokka på mobilen ringer klokka seks om morgenen.","zh":"手机闹钟早上六点响。","words":[[0,12,10.78,11.545,"vekkerklokka"],[13,15,11.66,11.805,"på"],[16,23,11.82,12.305,"mobilen"],[24,30,12.32,12.725,"ringer"],[31,37,12.86,13.185,"klokka"],[38,42,13.26,13.645,"seks"],[43,45,13.82,13.965,"om"],[46,54,13.98,14.345,"morgenen"]],"speaker":"Monica"},{"id":3,"start":15.836,"end":19.941,"text":"Da våkner jeg, men jeg er trøtt og kaffetørst.","zh":"那时我就醒了，但我很困，想喝咖啡。","words":[[0,2,15.836,15.961,"da"],[3,9,16.016,16.438,"våkner"],[10,13,16.438,16.581,"jeg"],[15,18,17.656,17.798,"men"],[19,22,17.798,17.928,"jeg"],[23,25,17.928,18.041,"er"],[26,31,18.056,18.481,"trøtt"],[32,34,19.036,19.159,"og"],[35,45,19.159,19.941,"kaffetørst"]],"speaker":"Monica"},{"id":4,"start":21.836,"end":23.881,"text":"Jeg står opp og lager kaffe.","zh":"我起床煮咖啡。","words":[[0,3,21.836,22.001,"jeg"],[4,8,22.056,22.369,"står"],[9,12,22.369,22.641,"opp"],[13,15,23.076,23.189,"og"],[16,21,23.189,23.519,"lager"],[22,27,23.519,23.881,"kaffe"]],"speaker":"Monica"},{"id":5,"start":25.676,"end":31.601,"text":"Så går jeg på badet. Jeg tar en dusj og sminker meg.","zh":"然后我去浴室，洗澡、化妆。","words":[[0,2,25.676,25.841,"så"],[3,6,26.136,26.328,"går"],[7,10,26.328,26.448,"jeg"],[11,13,26.448,26.581,"på"],[14,19,26.596,27.001,"badet"],[21,24,29.376,29.541,"jeg"],[25,28,29.556,29.768,"tar"],[29,31,29.768,29.889,"en"],[32,36,29.889,30.201,"dusj"],[37,39,30.856,30.981,"og"],[40,47,31.016,31.438,"sminker"],[48,51,31.438,31.601,"meg"]],"speaker":"Monica"},{"id":6,"start":34.036,"end":40.201,"text":"Klokka halv sju spiser jeg frokost, men jeg orker ikke å spise så mye.","zh":"六点半我吃早餐，但吃不下太多。","words":[[0,6,34.036,34.381,"klokka"],[7,11,34.416,34.701,"halv"],[12,15,34.756,34.941,"sju"],[16,22,35.576,35.989,"spiser"],[23,26,35.989,36.121,"jeg"],[27,34,36.136,36.781,"frokost"],[36,39,38.196,38.338,"men"],[40,43,38.338,38.481,"jeg"],[44,49,38.496,38.909,"orker"],[50,54,38.909,39.099,"ikke"],[55,56,39.099,39.181,"å"],[57,62,39.196,39.701,"spise"],[63,65,39.736,39.881,"så"],[66,69,39.896,40.201,"mye"]],"speaker":"Monica"},{"id":7,"start":42.536,"end":47.721,"text":"Jeg drikker to eller tre kopper kaffe. Det hjelper litt.","zh":"我喝两三杯咖啡，这会好一点。","words":[[0,3,42.536,42.689,"jeg"],[4,11,42.689,43.021,"drikker"],[12,14,43.056,43.241,"to"],[15,20,43.996,44.241,"eller"],[21,24,44.256,44.481,"tre"],[25,31,44.576,44.888,"kopper"],[32,37,44.888,45.221,"kaffe"],[39,42,46.836,46.989,"det"],[43,50,46.989,47.388,"hjelper"],[51,55,47.388,47.721,"litt"]],"speaker":"Monica"},{"id":8,"start":49.396,"end":51.681,"text":"Etterpå pusser jeg tennene.","zh":"然后我刷牙。","words":[[0,7,49.396,49.841,"etterpå"],[8,14,50.736,51.078,"pusser"],[15,18,51.078,51.221,"jeg"],[19,26,51.256,51.681,"tennene"]],"speaker":"Monica"},{"id":9,"start":53.536,"end":55.461,"text":"Bussen går klokka sju.","zh":"公交车七点发车。","words":[[0,6,53.536,53.981,"bussen"],[7,10,54.196,54.481,"går"],[11,17,54.896,55.221,"klokka"],[18,21,55.256,55.461,"sju"]],"speaker":"Monica"},{"id":10,"start":57.716,"end":59.281,"text":"Jeg har jobb på et hotell.","zh":"我在一家酒店工作。","words":[[0,3,57.716,57.881,"jeg"],[4,7,57.896,58.061,"har"],[8,12,58.116,58.421,"jobb"],[13,15,58.516,58.659,"på"],[16,18,58.659,58.829,"et"],[19,25,58.829,59.281,"hotell"]],"speaker":"Monica"},{"id":11,"start":60.836,"end":63.401,"text":"Der vasker jeg rommene og rer opp sengene.","zh":"在那里，我打扫房间、整理床铺。","words":[[0,3,60.836,61.099,"der"],[4,10,61.099,61.409,"vasker"],[11,14,61.409,61.508,"jeg"],[15,22,61.508,61.921,"rommene"],[23,25,62.276,62.409,"og"],[26,29,62.409,62.678,"rer"],[30,33,62.678,62.921,"opp"],[34,41,62.936,63.401,"sengene"]],"speaker":"Monica"},{"id":12,"start":64.896,"end":67.861,"text":"Jeg jobber cirka fem timer hver formiddag.","zh":"我每天上午大约工作五个小时。","words":[[0,3,64.896,65.061,"jeg"],[4,10,65.076,65.441,"jobber"],[11,16,65.516,65.861,"cirka"],[17,20,65.996,66.221,"fem"],[21,26,66.376,66.781,"timer"],[27,31,66.856,67.181,"hver"],[32,41,67.296,67.861,"formiddag"]],"speaker":"Monica"},{"id":13,"start":69.536,"end":74.061,"text":"Jeg begynner klokka halv åtte og er ferdig omtrent halv ett.","zh":"我七点半开始工作，十二点半左右结束。","words":[[0,3,69.536,69.698,"jeg"],[4,12,69.698,70.201,"begynner"],[13,19,70.296,70.601,"klokka"],[20,24,70.636,70.879,"halv"],[25,29,70.879,71.201,"åtte"],[30,32,71.816,71.939,"og"],[33,35,71.939,72.061,"er"],[36,42,72.096,72.521,"ferdig"],[43,50,72.616,73.201,"omtrent"],[51,55,73.276,73.601,"halv"],[56,59,73.736,74.061,"ett"]],"speaker":"Monica"},{"id":14,"start":75.896,"end":80.321,"text":"Til lunsj pleier jeg å spise varm mat i kantina på jobben.","zh":"午饭我通常在工作单位的食堂吃热饭菜。","words":[[0,3,75.896,76.081,"til"],[4,9,76.096,76.541,"lunsj"],[10,16,77.236,77.538,"pleier"],[17,20,77.538,77.659,"jeg"],[21,22,77.659,77.738,"å"],[23,28,77.738,78.141,"spise"],[29,33,78.196,78.518,"varm"],[34,37,78.518,78.941,"mat"],[38,39,79.076,79.178,"i"],[40,47,79.178,79.761,"kantina"],[48,50,79.836,79.961,"på"],[51,57,79.976,80.321,"jobben"]],"speaker":"Monica"},{"id":15,"start":81.596,"end":83.001,"text":"Jeg lager ikke matpakke.","zh":"我不准备自带的午餐。","words":[[0,3,81.596,81.761,"jeg"],[4,9,81.776,82.159,"lager"],[10,14,82.159,82.379,"ikke"],[15,23,82.379,83.001,"matpakke"]],"speaker":"Monica"},{"id":16,"start":84.956,"end":87.561,"text":"Etter lunsj skynder jeg meg til bussen.","zh":"午饭后，我赶去坐公交车。","words":[[0,5,84.956,85.298,"etter"],[6,11,85.298,85.721,"lunsj"],[12,19,86.256,86.618,"skynder"],[20,23,86.618,86.739,"jeg"],[24,27,86.739,86.881,"meg"],[28,31,86.956,87.121,"til"],[32,38,87.136,87.561,"bussen"]],"speaker":"Monica"},{"id":17,"start":89.276,"end":93.561,"text":"Jeg går på norskkurs fra kvart over to til kvart på fem.","zh":"我从下午两点一刻到四点三刻上挪威语课。","words":[[0,3,89.276,89.439,"jeg"],[4,7,89.439,89.641,"går"],[8,10,89.656,89.801,"på"],[11,20,89.816,90.521,"norskkurs"],[21,24,90.796,90.981,"fra"],[25,30,91.016,91.401,"kvart"],[31,35,91.416,91.661,"over"],[36,38,91.676,91.861,"to"],[39,42,92.656,92.801,"til"],[43,48,92.856,93.178,"kvart"],[49,51,93.178,93.321,"på"],[52,55,93.336,93.561,"fem"]],"speaker":"Monica"},{"id":18,"start":95.676,"end":99.101,"text":"På kurset prøver vi å snakke norsk med hverandre.","zh":"上课时，我们尽量用挪威语互相交谈。","words":[[0,2,95.676,95.801,"på"],[3,9,95.896,96.401,"kurset"],[10,16,96.996,97.418,"prøver"],[17,19,97.418,97.559,"vi"],[20,21,97.559,97.661,"å"],[22,28,97.676,98.081,"snakke"],[29,34,98.096,98.518,"norsk"],[35,38,98.518,98.659,"med"],[39,48,98.659,99.101,"hverandre"]],"speaker":"Monica"},{"id":19,"start":101.256,"end":103.741,"text":"Etter norskkurset går jeg hjem.","zh":"挪威语课结束后，我走回家。","words":[[0,5,101.256,101.599,"etter"],[6,17,101.599,102.341,"norskkurset"],[18,21,103.136,103.379,"går"],[22,25,103.379,103.529,"jeg"],[26,30,103.529,103.741,"hjem"]],"speaker":"Monica"},{"id":20,"start":106.356,"end":110.101,"text":"Jeg er gift med Ole, men han er ikke hjemme nå.","zh":"我和奥勒结婚了，但他现在不在家。","words":[[0,3,106.356,106.518,"jeg"],[4,6,106.518,106.661,"er"],[7,11,106.676,107.121,"gift"],[12,15,107.196,107.361,"med"],[16,19,107.396,107.741,"ole"],[21,24,108.836,109.001,"men"],[25,28,109.016,109.201,"han"],[29,31,109.276,109.428,"er"],[32,36,109.428,109.648,"ikke"],[37,43,109.648,109.969,"hjemme"],[44,46,109.969,110.101,"nå"]],"speaker":"Monica"},{"id":21,"start":111.716,"end":113.221,"text":"Han jobber i Nordsjøen.","zh":"他在北海工作。","words":[[0,3,111.716,111.901,"han"],[4,10,111.956,112.381,"jobber"],[11,12,112.456,112.561,"i"],[13,22,112.576,113.221,"nordsjøen"]],"speaker":"Monica"},{"id":22,"start":115.956,"end":125.121,"text":"Noen dager lager jeg middag hjemme, men ofte tar jeg bare en kopp te og spiser noen kjeks eller litt sjokolade.","zh":"有时我会在家做晚饭，但经常只是喝杯茶，吃些饼干或一点巧克力。","words":[[0,4,115.956,116.279,"noen"],[5,10,116.279,116.701,"dager"],[11,16,117.076,117.358,"lager"],[17,20,117.358,117.499,"jeg"],[21,27,117.499,117.849,"middag"],[28,34,117.849,118.181,"hjemme"],[36,39,119.056,119.241,"men"],[40,44,119.296,119.681,"ofte"],[45,48,120.356,120.589,"tar"],[49,52,120.589,120.719,"jeg"],[53,57,120.719,120.918,"bare"],[58,60,120.918,121.041,"en"],[61,65,121.056,121.321,"kopp"],[66,68,121.376,121.541,"te"],[69,71,122.176,122.301,"og"],[72,78,122.336,122.788,"spiser"],[79,83,122.788,123.021,"noen"],[84,89,123.056,123.461,"kjeks"],[90,95,123.976,124.238,"eller"],[96,100,124.238,124.521,"litt"],[101,110,124.536,125.121,"sjokolade"]],"speaker":"Monica"},{"id":23,"start":127.196,"end":133.081,"text":"Etterpå sover jeg litt på sofaen. Så gjør jeg norskleksene.","zh":"之后我在沙发上睡一会儿，再做挪威语作业。","words":[[0,7,127.196,127.661,"etterpå"],[8,13,128.436,128.809,"sover"],[14,17,128.809,128.928,"jeg"],[18,22,128.928,129.201,"litt"],[23,25,129.216,129.341,"på"],[26,32,129.356,129.781,"sofaen"],[34,36,131.476,131.641,"så"],[37,41,131.916,132.118,"gjør"],[42,45,132.118,132.261,"jeg"],[46,58,132.276,133.081,"norskleksene"]],"speaker":"Monica"},{"id":24,"start":135.576,"end":139.281,"text":"Om kvelden liker jeg å se på tv og slappe av.","zh":"晚上我喜欢看电视、放松一下。","words":[[0,2,135.576,135.701,"om"],[3,10,135.776,136.201,"kvelden"],[11,16,136.796,137.139,"liker"],[17,20,137.139,137.258,"jeg"],[21,22,137.258,137.361,"å"],[23,25,137.376,137.541,"se"],[26,28,137.576,137.701,"på"],[29,31,137.736,138.161,"tv"],[32,34,138.616,138.738,"og"],[35,41,138.738,139.108,"slappe"],[42,44,139.108,139.281,"av"]],"speaker":"Monica"},{"id":25,"start":141.196,"end":144.001,"text":"Noen ganger blir jeg sulten om kvelden.","zh":"有时我晚上会饿。","words":[[0,4,141.196,141.481,"noen"],[5,11,141.496,141.881,"ganger"],[12,16,142.556,142.738,"blir"],[17,20,142.738,142.861,"jeg"],[21,27,142.876,143.401,"sulten"],[28,30,143.456,143.601,"om"],[31,38,143.636,144.001,"kvelden"]],"speaker":"Monica"},{"id":26,"start":146.296,"end":151.961,"text":"Da tar jeg noen skiver brød og kanskje et glass vin eller to.","zh":"那时我会吃几片面包，也许再喝一两杯葡萄酒。","words":[[0,2,146.296,146.441,"da"],[3,6,146.736,146.948,"tar"],[7,10,146.948,147.099,"jeg"],[11,15,147.099,147.361,"noen"],[16,22,147.396,147.781,"skiver"],[23,27,147.816,148.101,"brød"],[28,30,149.276,149.401,"og"],[31,38,149.436,149.941,"kanskje"],[39,41,150.356,150.558,"et"],[42,47,150.558,150.881,"glass"],[48,51,150.896,151.201,"vin"],[52,57,151.536,151.781,"eller"],[58,60,151.796,151.961,"to"]],"speaker":"Monica"},{"id":27,"start":154.416,"end":158.621,"text":"Jeg pleier å legge meg før elleve og sover til klokka seks.","zh":"我通常十一点前睡觉，一直睡到六点。","words":[[0,3,154.416,154.561,"jeg"],[4,10,154.596,155.021,"pleier"],[11,12,155.036,155.138,"å"],[13,18,155.138,155.459,"legge"],[19,22,155.459,155.621,"meg"],[23,26,155.676,155.901,"før"],[27,33,155.936,156.281,"elleve"],[34,36,156.936,157.081,"og"],[37,42,157.136,157.561,"sover"],[43,46,157.736,157.901,"til"],[47,53,157.936,158.221,"klokka"],[54,58,158.256,158.621,"seks"]],"speaker":"Monica"}],"lexicon":{"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"badet":{"lemma":"bad","pos":"名词","form":"单数定指","zh":"浴室；卫生间（bad 的定指）","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"begynner":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","form":"现在时","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"brød":{"lemma":"brød","zh":"面包","pos":"名词","ref":"ty-conversation-5-005","clip":null},"bussen":{"lemma":"buss","zh":"公交车","pos":"名词","ref":"6-089","form":"单数定指","