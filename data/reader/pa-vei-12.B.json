{"id":"pa-vei-12.B","bookId":"pa-vei-textbook","readingId":"12.B","title":"På safari","audio":"audio/pa-vei/12.B.mp3","duration":140.136,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.92,"end":1.525,"text":"Hei Haifa.","zh":"嗨，海法。","words":[[0,3,0.92,1.145,"hei"],[4,9,1.18,1.525,"haifa"]],"speaker":"Pablo"},{"id":1,"start":2.1,"end":4.305,"text":"Hei Pablo. Lenge siden sist!","zh":"嗨，巴勃罗。好久不见！","words":[[0,3,2.1,2.305,"hei"],[4,9,2.36,2.765,"pablo"],[11,16,3.38,3.663,"lenge"],[17,22,3.663,3.922,"siden"],[23,27,3.922,4.305,"sist"]],"speaker":"Haifa"},{"id":2,"start":4.62,"end":6.865,"text":"Ja, det er det. Vet du hva jeg har gjort?","zh":"是啊。你知道我去做了什么吗？","words":[[0,2,4.62,4.765,"ja"],[4,7,4.86,4.992,"det"],[8,10,4.992,5.112,"er"],[11,14,5.112,5.245,"det"],[16,19,5.88,6.072,"vet"],[20,22,6.072,6.152,"du"],[23,26,6.152,6.285,"hva"],[27,30,6.32,6.502,"jeg"],[31,34,6.502,6.623,"har"],[35,40,6.623,6.865,"gjort"]],"speaker":"Pablo"},{"id":3,"start":7.76,"end":8.885,"text":"Jeg har vært på safari.","zh":"我去观赏野生动物了。","words":[[0,3,7.76,7.902,"jeg"],[4,7,7.902,8.033,"har"],[8,12,8.033,8.203,"vært"],[13,15,8.203,8.322,"på"],[16,22,8.322,8.885,"safari"]],"speaker":"Pablo"},{"id":4,"start":9.54,"end":10.385,"text":"I Afrika?","zh":"在非洲吗？","words":[[0,1,9.54,9.665,"i"],[2,8,9.92,10.385,"afrika"]],"speaker":"Haifa"},{"id":5,"start":11.24,"end":16.205,"text":"Nei, jeg har vært på hvalsafari i Nord-Norge, på et sted som heter Andenes.","zh":"不是，我去挪威北部一个叫安德内斯的地方观鲸了。","words":[[0,3,11.24,11.485,"nei"],[5,8,12.0,12.143,"jeg"],[9,12,12.143,12.252,"har"],[13,17,12.252,12.422,"vært"],[18,20,12.422,12.523,"på"],[21,31,12.523,13.345,"hvalsafari"],[32,33,13.38,13.505,"i"],[34,44,13.56,14.125,"nord-norge"],[46,48,14.64,14.762,"på"],[49,51,14.762,14.883,"et"],[52,56,14.883,15.082,"sted"],[57,60,15.082,15.182,"som"],[61,66,15.182,15.445,"heter"],[67,74,15.56,16.205,"andenes"]],"speaker":"Pablo"},{"id":6,"start":16.92,"end":17.5,"text":"Så du hval?","zh":"你看到鲸了吗？","words":[[0,2,16.92,17.085,"så@pa-vei-så-saw"],[3,5,17.16,17.282,"du"],[6,10,17.32,17.5,"hval"]],"speaker":"Haifa"},{"id":7,"start":18.06,"end":23.845,"text":"Ja, tre store spermhvaler. Det var helt fantastisk. Jeg dro ut med båt.","zh":"看到了，三头巨大的抹香鲸。太棒了！我是坐船出海的。","words":[[0,2,18.06,18.205,"ja"],[4,7,18.82,19.045,"tre"],[8,13,19.2,19.605,"store"],[14,25,19.64,20.345,"spermhvaler"],[27,30,20.92,21.062,"det"],[31,34,21.062,21.163,"var"],[35,39,21.163,21.343,"helt"],[40,50,21.343,22.105,"fantastisk"],[52,55,22.86,23.012,"jeg"],[56,59,23.012,23.165,"dro"],[60,62,23.2,23.352,"ut"],[63,66,23.352,23.492,"med"],[67,70,23.492,23.845,"båt"]],"speaker":"Pablo"},{"id":8,"start":24.48,"end":24.965,"text":"Alene?","zh":"你一个人？","words":[[0,5,24.48,24.965,"alene"]],"speaker":"Haifa"},{"id":9,"start":25.92,"end":29.205,"text":"Mm - nei, sammen med kona mi og 80 andre.","zh":"嗯……不是，和我妻子以及另外 80 个人一起。","words":[[0,2,25.92,26.145,"mm"],[5,8,26.42,26.685,"nei"],[10,16,27.14,27.433,"sammen"],[17,20,27.433,27.585,"med"],[21,25,27.6,27.973,"kona"],[26,28,27.973,28.105,"mi"],[29,31,28.28,28.425,"og"],[32,34,28.54,28.902,"80"],[35,40,28.902,29.205,"andre"]],"speaker":"Pablo"},{"id":10,"start":30.02,"end":33.085,"text":"Alle tok bilder og ropte «hval, hval».","zh":"大家都在拍照，喊着“鲸，鲸”。","words":[[0,4,30.02,30.345,"alle"],[5,8,30.36,30.583,"tok"],[9,15,30.583,30.985,"bilder"],[16,18,31.28,31.392,"og"],[19,24,31.392,31.705,"ropte"],[26,30,31.94,32.325,"hval"],[32,36,32.54,33.085,"hval"]],"speaker":"Pablo"},{"id":11,"start":33.92,"end":37.045,"text":"Har du sett spermhval noen gang? Den er kjempestor.","zh":"你见过抹香鲸吗？它非常大。","words":[[0,3,33.92,34.062,"har"],[4,6,34.062,34.165,"du"],[7,11,34.18,34.442,"sett"],[12,21,34.442,35.025,"spermhval"],[22,26,35.04,35.212,"noen"],[27,31,35.212,35.405,"gang"],[33,36,35.88,36.043,"den"],[37,39,36.043,36.165,"er"],[40,50,36.24,37.045,"kjempestor"]],"speaker":"Pablo"},{"id":12,"start":37.88,"end":43.265,"text":"Jeg har bare sett den på tv. Men nordmenn spiser hvalkjøtt, gjør de ikke?","zh":"我只在电视上见过。不过挪威人吃鲸肉，不是吗？","words":[[0,3,37.88,38.032,"jeg"],[4,7,38.032,38.245,"har"],[8,12,38.26,38.485,"bare"],[13,17,38.5,38.742,"sett"],[18,21,38.742,38.862,"den"],[22,24,38.862,39.002,"på"],[25,27,39.002,39.345,"tv"],[29,32,40.06,40.285,"men"],[33,41,40.76,41.165,"nordmenn"],[42,48,41.2,41.772,"spiser"],[49,58,41.772,42.325,"hvalkjøtt"],[60,64,42.82,42.972,"gjør"],[65,67,42.972,43.062,"de"],[68,72,43.062,43.265,"ikke"]],"speaker":"Haifa"},{"id":13,"start":44.04,"end":46.645,"text":"Jo. Det er typisk norsk, tror jeg.","zh":"是的。我想这是很典型的挪威习惯。","words":[[0,2,44.04,44.205,"jo"],[4,7,45.14,45.303,"det"],[8,10,45.303,45.465,"er"],[11,17,45.5,45.945,"typisk"],[18,23,45.96,46.322,"norsk@pa-vei-norsk-adjective"],[25,29,46.322,46.502,"tror"],[30,33,46.502,46.645,"jeg"]],"speaker":"Pablo"},{"id":14,"start":59.36,"end":61.865,"text":"Har du lyst til å treffe «skogens konge»?","zh":"你想见见“森林之王”吗？","words":[[0,3,59.36,59.532,"har"],[4,6,59.532,59.665,"du"],[7,11,59.7,60.032,"lyst@pa-vei-lyst-desire"],[12,15,60.032,60.185,"til"],[16,17,60.2,60.305,"å"],[18,24,60.32,60.765,"treffe"],[26,33,60.84,61.513,"skogens"],[34,39,61.513,61.865,"konge"]]},{"id":15,"start":63.32,"end":65.965,"text":"Da skal du bli med oss på elgsafari.","zh":"那就跟我们一起去观赏驼鹿吧。","words":[[0,2,63.32,63.465,"da"],[3,7,63.56,63.763,"skal"],[8,10,63.763,63.905,"du"],[11,14,63.96,64.165,"bli"],[15,18,64.26,64.425,"med"],[19,22,64.44,64.725,"oss"],[23,25,64.96,65.085,"på"],[26,35,65.2,65.965,"elgsafari"]]},{"id":16,"start":67.7,"end":74.305,"text":"Fra midten av juni til slutten av august kjører vi med minibuss inn i skogen.","zh":"从六月中旬到八月底，我们乘小巴进入森林。","words":[[0,3,67.7,67.905,"fra"],[4,10,67.96,68.405,"midten"],[11,13,68.5,68.665,"av"],[14,18,68.7,69.105,"juni"],[19,22,69.54,69.725,"til"],[23,30,69.84,70.365,"slutten"],[31,33,70.44,70.605,"av"],[34,40,70.62,71.225,"august"],[41,47,72.0,72.412,"kjører"],[48,50,72.412,72.525,"vi"],[51,54,72.56,72.745,"med"],[55,63,72.78,73.485,"minibuss"],[64,67,73.66,73.843,"inn"],[68,69,73.843,73.912,"i"],[70,76,73.912,74.305,"skogen"]]},{"id":17,"start":75.94,"end":82.505,"text":"Vi starter om kvelden når det begynner å bli mørkt, for da er sjansene store til å møte elg.","zh":"我们在傍晚天色开始变暗时出发，因为那时遇到驼鹿的机会很大。","words":[[0,2,75.94,76.085,"vi"],[3,10,76.1,76.542,"starter"],[11,13,76.542,76.685,"om"],[14,21,76.74,77.205,"kvelden"],[22,25,77.58,77.722,"når@pa-vei-når-when"],[26,29,77.722,77.843,"det"],[30,38,77.843,78.142,"begynner"],[39,40,78.142,78.213,"å"],[41,44,78.213,78.365,"bli"],[45,50,78.38,78.905,"mørkt"],[52,55,79.78,79.933,"for@pa-vei-for-because"],[56,58,79.933,80.065,"da"],[59,61,80.12,80.265,"er"],[62,70,80.32,80.925,"sjansene"],[71,76,81.02,81.545,"store"],[77,80,81.6,81.782,"til"],[81,82,81.782,81.873,"å"],[83,87,81.873,82.165,"møte"],[88,91,82.2,82.505,"elg"]]},{"id":18,"start":84.22,"end":88.945,"text":"Vi kjenner området godt, og vi kan love deg en spennende opplevelse.","zh":"我们非常熟悉这一带，保证给你一次精彩的体验。","words":[[0,2,84.22,84.345,"vi"],[3,10,84.4,84.745,"kjenner"],[11,18,84.8,85.292,"området"],[19,23,85.292,85.585,"godt"],[25,27,86.38,86.513,"og"],[28,30,86.513,86.623,"vi"],[31,34,86.623,86.805,"kan"],[35,39,86.84,87.153,"love"],[40,43,87.153,87.325,"deg"],[44,46,87.4,87.545,"en"],[47,56,87.64,88.265,"spennende"],[57,67,88.36,88.945,"opplevelse"]]},{"id":19,"start":91.2,"end":100.925,"text":"For mer informasjon og bestilling, ring Kristoffer på 124 40 315.","zh":"如需更多信息或预订，请拨打 124 40 315 联系克里斯托弗。","words":[[0,3,91.2,91.405,"for"],[4,7,91.46,91.725,"mer"],[8,19,91.78,92.585,"informasjon"],[20,22,92.66,92.773,"og"],[23,33,92.773,93.325,"bestilling"],[35,39,94.36,94.605,"ring"],[40,50,94.64,95.365,"kristoffer"],[51,53,96.18,96.305,"på"],[54,64,96.36,100.925,"124 40 315"]]},{"id":20,"start":110.66,"end":112.765,"text":"Vil du vite hvordan det er på Svalbard?","zh":"你想知道斯瓦尔巴是什么样的吗？","words":[[0,3,110.66,110.845,"vil"],[4,6,110.88,111.025,"du"],[7,11,111.04,111.412,"vite"],[12,19,111.412,111.713,"hvordan"],[20,23,111.713,111.845,"det"],[24,26,111.86,112.065,"er"],[27,29,112.1,112.225,"på"],[30,38,112.24,112.765,"svalbard"]]},{"id":21,"start":114.24,"end":117.485,"text":"Vil du se om isbjørnen går rundt i gatene midt på dagen?","zh":"你想看看北极熊是否会在大白天走在街上吗？","words":[[0,3,114.24,114.403,"vil"],[4,6,114.403,114.545,"du"],[7,9,114.56,114.725,"se"],[10,12,114.74,114.865,"om@pa-vei-om-whether"],[13,22,114.96,115.685,"isbjørnen"],[23,26,115.7,115.912,"går"],[27,32,115.912,116.192,"rundt"],[33,34,116.192,116.282,"i"],[35,41,116.282,116.803,"gatene"],[42,46,116.803,117.032,"midt"],[47,49,117.032,117.132,"på"],[50,55,117.132,117.485,"dagen"]]},{"id":22,"start":119.32,"end":123.525,"text":"Bli med oss på scootertur om vinteren eller båttur om sommeren.","zh":"冬天和我们一起骑雪地摩托，或者夏天一起乘船游览吧。","words":[[0,3,119.32,119.505,"bli"],[4,7,119.58,119.733,"med"],[8,11,119.733,119.942,"oss"],[12,14,119.942,120.085,"på"],[15,25,120.14,120.905,"scootertur"],[26,28,120.96,121.105,"om"],[29,37,121.12,121.645,"vinteren"],[38,43,121.98,122.285,"eller"],[44,50,122.32,122.965,"båttur"],[51,53,123.0,123.125,"om"],[54,62,123.14,123.525,"sommeren"]]},{"id":23,"start":124.66,"end":131.545,"text":"Her vil du oppleve en vakker og vill natur, og kanskje møter du også «kongen av Arktis».","zh":"在这里，你将体验美丽而原始的自然风光，也许还会遇见“北极之王”。","words":[[0,3,124.66,124.922,"her"],[4,7,124.922,125.072,"vil"],[8,10,125.072,125.205,"du"],[11,18,125.22,125.705,"oppleve"],[19,21,125.78,125.925,"en"],[22,28,126.02,126.485,"vakker"],[29,31,126.58,126.745,"og"],[32,36,126.82,127.125,"vill"],[37,42,127.14,127.605,"natur"],[44,46,128.26,128.405,"og"],[47,54,128.48,129.005,"kanskje"],[55,60,129.02,129.412,"møter"],[61,63,129.412,129.545,"du"],[64,68,129.56,129.865,"også"],[70,76,130.34,130.863,"kongen"],[77,79,130.863,131.002,"av"],[80,86,131.002,131.545,"arktis"]]},{"id":24,"start":133.12,"end":134.165,"text":"Velkommen til oss!","zh":"欢迎加入我们！","words":[[0,9,133.12,133.705,"velkommen"],[10,13,133.72,133.885,"til"],[14,17,133.9,134.165,"oss"]]},{"id"