{"id":"10.5","title":"Yrkestekst: Jeg er kokk","audio":"audio/10.5.mp3","duration":98.97,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.58,"text":"10.5 Yrke: Jeg er kokk","heading":true,"zh":"10.5 职业：我是厨师","words":[[0,4,0.15,1.18,"10.5"],[5,9,2.06,2.44,"yrke"],[11,14,3.25,3.55,"jeg"],[15,17,3.55,3.89,"er"],[18,22,3.89,4.5,"kokk"]]},{"id":1,"start":6.8,"end":10.01,"text":"Jeg er kokk og jobber på en restaurant.","zh":"我是厨师，在一家餐厅工作。","words":[[0,3,6.86,7.28,"jeg"],[4,6,7.28,7.56,"er"],[7,11,7.56,8.07,"kokk"],[12,14,8.34,8.48,"og"],[15,21,8.48,8.9,"jobber~ab83dbee3ee4"],[22,24,8.9,9.02,"på"],[25,27,9.02,9.14,"en~a939a9e56dc5"],[28,38,9.14,9.86,"restaurant"]]},{"id":2,"start":11.31,"end":20.2,"text":"Jeg lager mat, setter opp menyer og planlegger innkjøp. Det er mye å gjøre på kjøkkenet.","zh":"我做饭、制定菜单、计划采购。厨房里有很多事要做。","words":[[0,3,11.38,11.62,"jeg"],[4,9,11.62,12.04,"lager~c7ae645a60b1"],[10,13,12.04,12.66,"mat"],[15,21,13.24,13.6,"setter~7c60a996b61a"],[22,25,13.6,13.82,"opp~02e7848a2399"],[26,32,13.82,14.54,"menyer"],[33,35,14.94,15.14,"og"],[36,46,15.14,16.02,"planlegger"],[47,54,16.02,16.79,"innkjøp"],[56,59,18.18,18.36,"det"],[60,62,18.36,18.64,"er"],[63,66,18.64,19.0,"mye~cc164d0dc3da"],[67,68,19.0,19.1,"å~0583da7a620a"],[69,74,19.1,19.46,"gjøre"],[75,77,19.46,19.58,"på"],[78,87,19.58,20.05,"kjøkkenet"]]},{"id":3,"start":21.14,"end":27.45,"text":"Gjestene bestiller mat, og vi lager maten og gjør den klar til servering.","zh":"客人点菜，我们做菜，并把菜准备好上桌。","words":[[0,8,21.2,22.0,"gjestene"],[9,18,22.0,22.62,"bestiller"],[19,22,22.62,23.2,"mat"],[24,26,23.6,23.8,"og"],[27,29,23.8,24.16,"vi"],[30,35,24.16,24.68,"lager~c7ae645a60b1"],[36,41,24.68,25.29,"maten"],[42,44,25.5,25.64,"og"],[45,49,25.64,25.82,"gjør"],[50,53,25.82,26.02,"den"],[54,58,26.02,26.46,"klar"],[59,62,26.46,26.66,"til~02fd64b69086"],[63,72,26.66,27.3,"servering"]]},{"id":4,"start":28.86,"end":31.8,"text":"Jeg jobber om kveldene og i helgene.","zh":"我在晚上和周末工作。","words":[[0,3,28.92,29.24,"jeg"],[4,10,29.24,29.6,"jobber~ab83dbee3ee4"],[11,13,29.6,29.76,"om~3a9f4eb45714"],[14,22,29.76,30.49,"kveldene"],[23,25,30.86,31.04,"og"],[26,27,31.04,31.14,"i"],[28,35,31.14,31.65,"helgene"]]},{"id":5,"start":33.22,"end":39.06,"text":"I dag lager jeg mat til en bryllupsmiddag, og det er mange gjester.","zh":"今天我为一场婚宴做饭，客人很多。","words":[[0,1,33.28,33.46,"i"],[2,5,33.46,33.99,"dag"],[6,11,34.2,34.62,"lager~c7ae645a60b1"],[12,15,34.62,34.88,"jeg"],[16,19,34.88,35.28,"mat"],[20,23,35.28,35.46,"til~3c00872f5cfc"],[24,26,35.46,35.6,"en~a939a9e56dc5"],[27,41,35.6,36.77,"bryllupsmiddag"],[43,45,37.12,37.3,"og"],[46,49,37.3,37.46,"det"],[50,52,37.46,37.84,"er"],[53,58,37.84,38.48,"mange"],[59,66,38.48,38.91,"gjester"]]},{"id":6,"start":40.19,"end":45.51,"text":"Det er veldig travelt, for alle gjestene skal ha maten samtidig.","zh":"非常忙，因为所有客人都要同时上菜。","words":[[0,3,40.25,40.46,"det"],[4,6,40.46,40.66,"er"],[7,13,40.66,41.14,"veldig"],[14,21,41.14,41.85,"travelt"],[23,26,42.34,42.64,"for~1b22712a94b1"],[27,31,42.64,43.0,"alle~6873d9584096"],[32,40,43.0,43.72,"gjestene"],[41,45,43.72,43.98,"skal"],[46,48,43.98,44.14,"ha~31a9f83a159c"],[49,54,44.14,44.66,"maten"],[55,63,44.66,45.36,"samtidig"]]},{"id":7,"start":47.3,"end":55.36,"text":"Det er litt slitsomt å være kokk, men det er en variert og flott jobb, og jeg trives veldig godt.","zh":"当厨师有点累，但这是一份多样又出色的工作，我做得很开心。","words":[[0,3,47.37,47.62,"det"],[4,6,47.62,47.88,"er"],[7,11,47.88,48.12,"litt~54360be2a478"],[12,20,48.12,48.8,"slitsomt"],[21,22,48.8,48.88,"å~0583da7a620a"],[23,27,48.88,49.14,"være"],[28,32,49.14,49.62,"kokk"],[34,37,50.32,50.66,"men"],[38,41,50.66,50.82,"det"],[42,44,50.82,50.98,"er"],[45,47,50.98,51.12,"en~a939a9e56dc5"],[48,55,51.12,51.78,"variert~b45daaaf3278"],[56,58,51.78,51.94,"og"],[59,64,51.94,52.34,"flott"],[65,69,52.34,52.8,"jobb"],[71,73,53.22,53.4,"og"],[74,77,53.4,53.7,"jeg"],[78,84,53.7,54.48,"trives"],[85,91,54.48,54.88,"veldig"],[92,96,54.88,55.21,"godt~28a24c509f3c"]]},{"id":8,"start":59.0,"end":60.2,"text":"På kjøkkenet","zh":"在厨房里","words":[[0,2,59.06,59.42,"på"],[3,12,59.42,60.05,"kjøkkenet"]]},{"id":9,"start":62.29,"end":68.3,"text":"Er hovedretten ferdig snart? Bryllupsgjestene er ferdige med forretten nå.","speaker":"Servitør","zh":"主菜快好了吗？婚礼客人们现在已经吃完前菜了。","words":[[0,2,62.35,62.74,"er"],[3,14,62.74,63.58,"hovedretten"],[15,21,63.58,63.88,"ferdig"],[22,27,63.88,64.46,"snart"],[29,45,65.4,66.44,"bryllupsgjestene"],[46,48,66.44,66.68,"er"],[49,56,66.68,67.14,"ferdige~0a2fcae1850a"],[57,60,67.14,67.38,"med~8890ea3853f1"],[61,70,67.38,67.92,"forretten"],[71,73,67.92,68.15,"nå~d531d47a7712"]]},{"id":10,"start":68.94,"end":71.9,"text":"Ja, jeg skal bare lage ferdig sausen.","speaker":"Kokk","zh":"快了，我只需要把酱汁做好。","words":[[0,2,69.0,69.38,"ja"],[4,7,69.66,69.92,"jeg"],[8,12,69.92,70.26,"skal"],[13,17,70.26,70.54,"bare"],[18,22,70.54,70.86,"lage"],[23,29,70.86,71.26,"ferdig"],[30,36,71.26,71.75,"sausen"]]},{"id":11,"start":72.83,"end":75.06,"text":"Skal jeg sette tallerkenene her?","speaker":"Servitør","zh":"我要把盘子放在这里吗？","words":[[0,4,72.89,73.24,"skal"],[5,8,73.24,73.54,"jeg"],[9,14,73.54,73.86,"sette~8293a6baa8db"],[15,27,73.86,74.56,"tallerkenene"],[28,31,74.56,74.91,"her"]]},{"id":12,"start":75.7,"end":83.71,"text":"Ja, takk. Jeg legger på kjøtt, grønnsaker og poteter nå, og så har jeg på sausen til slutt.","speaker":"Kokk","zh":"好的，谢谢。我现在先放上肉、蔬菜和土豆，然后最后再浇上酱汁。","words":[[0,2,75.76,76.0,"ja"],[4,8,76.0,76.44,"takk"],[10,13,77.06,77.28,"jeg"],[14,20,77.28,77.64,"legger~c6d91f2240ee"],[21,23,77.64,77.94,"på~4f0ad5d2b9c0"],[24,29,77.94,78.48,"kjøtt"],[31,41,78.88,80.0,"grønnsaker"],[42,44,80.0,80.1,"og"],[45,52,80.1,80.58,"poteter"],[53,55,80.58,80.88,"nå~d531d47a7712"],[57,59,81.84,81.94,"og"],[60,62,81.94,82.08,"så~4a7ed2bb1489"],[63,66,82.08,82.28,"har~edbb7fc3ef2f"],[67,70,82.28,82.42,"jeg"],[71,73,82.42,82.58,"på~51c5e420c80d"],[74,80,82.58,83.02,"sausen"],[81,84,83.02,83.18,"til~7f99cd564e6b"],[85,90,83.18,83.56,"slutt~c1f0b812cb07"]]},{"id":13,"start":84.75,"end":87.85,"text":"Har du smakt på sausen? Er den god?","speaker":"Servitør","zh":"你尝过酱汁了吗？好吃吗？","words":[[0,3,84.81,85.0,"har~8b9792170cca"],[4,6,85.0,85.2,"du"],[7,12,85.2,85.56,"smakt"],[13,15,85.56,85.68,"på~75e16a86d63d"],[16,22,85.68,86.32,"sausen"],[24,26,87.08,87.2,"er"],[27,30,87.2,87.42,"den"],[31,34,87.42,87.7,"god~60898ca5b522"]]},{"id":14,"start":88.95,"end":97.44,"text":"Vent litt, jeg smaker nå. Mm, den er veldig god! Jeg håper brudeparet og gjestene blir fornøyde.","speaker":"Kokk","zh":"等一下，我现在尝尝。嗯，非常好吃！希望新婚夫妇和客人们会满意。","words":[[0,4,89.01,89.26,"vent"],[5,9,89.26,89.66,"litt~54360be2a478"],[11,14,89.66,89.82,"jeg"],[15,21,89.82,90.16,"smaker"],[22,24,90.16,90.46,"nå~d531d47a7712"],[26,28,91.54,91.96,"mm"],[30,33,92.36,92.54,"den"],[34,36,92.54,92.66,"er"],[37,43,92.66,93.02,"veldig"],[44,47,93.02,93.42,"god~60898ca5b522"],[49,52,94.48,94.68,"jeg"],[53,58,94.68,95.08,"håper"],[59,69,95.08,95.92,"brudeparet"],[70,72,95.92,96.06,"og"],[73,81,96.06,96.52,"gjestene"],[82,86,96.52,96.72,"blir"],[87,95,96.72,97.29,"fornøyde"]]}],"lexicon":{"10.5":{"lemma":"10.5","zh":"第 10.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bestiller":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","form":"现在时","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":"pronunciation/9422127081333b8048f1.mp3"},"brudeparet":{"lemma":"brudepar","zh":"新娘和新郎","pos":"名词","ref":"10-053","form":"单数定指","clip":null},"bryllupsgjestene":{"lemma":"bryllupsgjest","zh":"婚礼宾客（复数定指）","pos":"名词","ref":null,"clip":null},"bryllupsmiddag":{"lemma":"bryllupsmiddag","zh":"婚宴","pos":"名词","ref":null,"clip":null},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","c