{"id":"10.5","title":"Yrkestekst: Jeg er kokk","audio":"audio/10.5.mp3","duration":98.97,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.58,"text":"10.5 Yrke: Jeg er kokk","heading":true,"zh":"10.5 职业：我是厨师","words":[[0,4,0.15,1.18,"10.5"],[5,9,2.06,2.44,"yrke"],[11,14,3.25,3.55,"jeg"],[15,17,3.55,3.89,"er"],[18,22,3.89,4.5,"kokk"]]},{"id":1,"start":6.76,"end":9.92,"text":"Jeg er kokk og jobber på en restaurant.","zh":"我是厨师，在一家餐厅工作。","words":[[0,3,6.84,7.16,"jeg"],[4,6,7.16,7.48,"er"],[7,11,7.48,7.94,"kokk"],[12,14,7.94,8.42,"og"],[15,21,8.42,8.76,"jobber~ab83dbee3ee4"],[22,24,8.76,8.98,"på"],[25,27,8.98,9.12,"en~a939a9e56dc5"],[28,38,9.12,9.84,"restaurant"]]},{"id":2,"start":11.29,"end":20.11,"text":"Jeg lager mat, setter opp menyer og planlegger innkjøp. Det er mye å gjøre på kjøkkenet.","zh":"我做饭、制定菜单、计划采购。厨房里有很多事要做。","words":[[0,3,11.37,11.56,"jeg"],[4,9,11.56,11.94,"lager~c7ae645a60b1"],[10,13,11.94,12.28,"mat"],[15,21,13.2,13.52,"setter~7c60a996b61a"],[22,25,13.52,13.72,"opp~02e7848a2399"],[26,32,13.72,14.22,"menyer"],[33,35,14.22,15.04,"og"],[36,46,15.04,15.84,"planlegger"],[47,54,15.84,16.62,"innkjøp"],[56,59,17.66,18.3,"det"],[60,62,18.3,18.5,"er"],[63,66,18.5,18.88,"mye~cc164d0dc3da"],[67,68,18.88,19.04,"å~0583da7a620a"],[69,74,19.04,19.3,"gjøre"],[75,77,19.3,19.54,"på"],[78,87,19.54,20.03,"kjøkkenet"]]},{"id":3,"start":21.11,"end":27.39,"text":"Gjestene bestiller mat, og vi lager maten og gjør den klar til servering.","zh":"客人点菜，我们做菜，并把菜准备好上桌。","words":[[0,8,21.19,21.84,"gjestene"],[9,18,21.84,22.44,"bestiller"],[19,22,22.44,22.84,"mat"],[24,26,23.6,23.68,"og"],[27,29,23.68,24.0,"vi"],[30,35,24.0,24.5,"lager~c7ae645a60b1"],[36,41,24.5,25.16,"maten"],[42,44,25.16,25.58,"og"],[45,49,25.58,25.8,"gjør"],[50,53,25.8,25.9,"den"],[54,58,25.9,26.26,"klar"],[59,62,26.26,26.56,"til~02fd64b69086"],[63,72,26.56,27.31,"servering"]]},{"id":4,"start":28.83,"end":31.74,"text":"Jeg jobber om kveldene og i helgene.","zh":"我在晚上和周末工作。","words":[[0,3,28.91,29.16,"jeg"],[4,10,29.16,29.5,"jobber~ab83dbee3ee4"],[11,13,29.5,29.7,"om~3a9f4eb45714"],[14,22,29.7,30.26,"kveldene"],[23,25,30.26,30.96,"og"],[26,27,30.96,31.1,"i"],[28,35,31.1,31.66,"helgene"]]},{"id":5,"start":33.11,"end":39.01,"text":"I dag lager jeg mat til en bryllupsmiddag, og det er mange gjester.","zh":"今天我为一场婚宴做饭，客人很多。","words":[[0,1,33.19,33.4,"i"],[2,5,33.4,33.66,"dag"],[6,11,33.66,34.48,"lager~c7ae645a60b1"],[12,15,34.48,34.7,"jeg"],[16,19,34.7,35.06,"mat"],[20,23,35.06,35.4,"til~3c00872f5cfc"],[24,26,35.4,35.52,"en~a939a9e56dc5"],[27,41,35.52,36.54,"bryllupsmiddag"],[43,45,36.94,37.22,"og"],[46,49,37.22,37.38,"det"],[50,52,37.38,37.6,"er"],[53,58,37.6,38.22,"mange"],[59,66,38.22,38.93,"gjester"]]},{"id":6,"start":40.15,"end":45.45,"text":"Det er veldig travelt, for alle gjestene skal ha maten samtidig.","zh":"非常忙，因为所有客人都要同时上菜。","words":[[0,3,40.23,40.42,"det"],[4,6,40.42,40.56,"er"],[7,13,40.56,41.12,"veldig"],[14,21,41.12,41.56,"travelt"],[23,26,42.22,42.5,"for~1b22712a94b1"],[27,31,42.5,42.9,"alle~6873d9584096"],[32,40,42.9,43.54,"gjestene"],[41,45,43.54,43.88,"skal"],[46,48,43.88,44.08,"ha~31a9f83a159c"],[49,54,44.08,44.54,"maten"],[55,63,44.54,45.37,"samtidig"]]},{"id":7,"start":47.27,"end":55.3,"text":"Det er litt slitsomt å være kokk, men det er en variert og flott jobb, og jeg trives veldig godt.","zh":"当厨师有点累，但这是一份多样又出色的工作，我做得很开心。","words":[[0,3,47.35,47.6,"det"],[4,6,47.6,47.8,"er"],[7,11,47.8,48.0,"litt~54360be2a478"],[12,20,48.0,48.72,"slitsomt"],[21,22,48.72,48.84,"å~0583da7a620a"],[23,27,48.84,49.0,"være"],[28,32,49.0,49.48,"kokk"],[34,37,49.96,50.52,"men"],[38,41,50.52,50.78,"det"],[42,44,50.78,50.9,"er"],[45,47,50.9,51.06,"en~a939a9e56dc5"],[48,55,51.06,51.68,"variert~b45daaaf3278"],[56,58,51.68,51.86,"og"],[59,64,51.86,52.26,"flott"],[65,69,52.26,52.48,"jobb"],[71,73,53.12,53.3,"og"],[74,77,53.3,53.56,"jeg"],[78,84,53.56,54.28,"trives"],[85,91,54.28,54.84,"veldig"],[92,96,54.84,55.23,"godt~28a24c509f3c"]]},{"id":8,"start":55.63,"end":60.07,"text":"På kjøkkenet","zh":"在厨房里","words":[[0,2,58.56,59.28,"på"],[3,12,59.28,59.99,"kjøkkenet"]]},{"id":9,"start":62.13,"end":68.24,"text":"Er hovedretten ferdig snart? Bryllupsgjestene er ferdige med forretten nå.","speaker":"Servitør","zh":"主菜快好了吗？婚礼客人们现在已经吃完前菜了。","words":[[0,2,62.21,62.66,"er"],[3,14,62.66,63.42,"hovedretten"],[15,21,63.42,63.82,"ferdig"],[22,27,63.82,64.14,"snart"],[29,45,65.58,66.34,"bryllupsgjestene"],[46,48,66.34,66.56,"er"],[49,56,66.56,67.0,"ferdige~0a2fcae1850a"],[57,60,67.0,67.22,"med~8890ea3853f1"],[61,70,67.22,67.88,"forretten"],[71,73,67.88,68.16,"nå~d531d47a7712"]]},{"id":10,"start":68.9,"end":71.84,"text":"Ja, jeg skal bare lage ferdig sausen.","speaker":"Kokk","zh":"快了，我只需要把酱汁做好。","words":[[0,2,68.98,69.22,"ja"],[4,7,69.66,69.84,"jeg"],[8,12,69.84,70.12,"skal"],[13,17,70.12,70.44,"bare"],[18,22,70.44,70.74,"lage"],[23,29,70.74,71.18,"ferdig"],[30,36,71.18,71.76,"sausen"]]},{"id":11,"start":72.78,"end":75.0,"text":"Skal jeg sette tallerkenene her?","speaker":"Servitør","zh":"我要把盘子放在这里吗？","words":[[0,4,72.86,73.18,"skal"],[5,8,73.18,73.42,"jeg"],[9,14,73.42,73.76,"sette~8293a6baa8db"],[15,27,73.76,74.48,"tallerkenene"],[28,31,74.48,74.92,"her"]]},{"id":12,"start":75.45,"end":83.64,"text":"Ja, takk. Jeg legger på kjøtt, grønnsaker og poteter nå, og så har jeg på sausen til slutt.","speaker":"Kokk","zh":"好的，谢谢。我现在先放上肉、蔬菜和土豆，然后最后再浇上酱汁。","words":[[0,2,75.45,75.96,"ja"],[4,8,76.0,76.28,"takk"],[10,13,76.84,77.22,"jeg"],[14,20,77.22,77.5,"legger~c6d91f2240ee"],[21,23,77.5,77.78,"på~4f0ad5d2b9c0"],[24,29,77.78,78.3,"kjøtt"],[31,41,78.84,79.52,"grønnsaker"],[42,44,79.52,80.04,"og"],[45,52,80.04,80.52,"poteter"],[53,55,80.52,80.72,"nå~d531d47a7712"],[57,59,81.44,81.94,"og"],[60,62,81.94,82.04,"så~4a7ed2bb1489"],[63,66,82.04,82.22,"har~edbb7fc3ef2f"],[67,70,82.22,82.34,"jeg"],[71,73,82.34,82.48,"på~51c5e420c80d"],[74,80,82.48,82.96,"sausen"],[81,84,82.96,83.08,"til~7f99cd564e6b"],[85,90,83.08,83.56,"slutt~c1f0b812cb07"]]},{"id":13,"start":84.33,"end":87.79,"text":"Har du smakt på sausen? Er den god?","speaker":"Servitør","zh":"你尝过酱汁了吗？好吃吗？","words":[[0,3,84.49,84.95,"har~8b9792170cca"],[4,6,84.95,85.11,"du"],[7,12,85.11,85.47,"smakt"],[13,15,85.47,85.63,"på~75e16a86d63d"],[16,22,85.63,86.11,"sausen"],[24,26,86.75,87.17,"er"],[27,30,87.17,87.33,"den"],[31,34,87.33,87.71,"god~60898ca5b522"]]},{"id":14,"start":88.91,"end":97.37,"text":"Vent litt, jeg smaker nå. Mm, den er veldig god! Jeg håper brudeparet og gjestene blir fornøyde.","speaker":"Kokk","zh":"等一下，我现在尝尝。嗯，非常好吃！希望新婚夫妇和客人们会满意。","words":[[0,4,88.98,89.14,"vent"],[5,9,89.14,89.38,"litt~54360be2a478"],[11,14,89.68,89.74,"jeg"],[15,21,89.74,90.08,"smaker"],[22,24,90.08,90.24,"nå~d531d47a7712"],[26,28,91.44,91.84,"mm"],[30,33,92.32,92.44,"den"],[34,36,92.44,92.58,"er"],[37,43,92.58,92.98,"veldig"],[44,47,92.98,93.14,"god~60898ca5b522"],[49,52,94.2,94.64,"jeg"],[53,58,94.64,95.02,"håper"],[59,69,95.02,95.78,"brudeparet"],[70,72,95.78,95.98,"og"],[73,81,95.98,96.48,"gjestene"],[82,86,96.48,96.62,"blir"],[87,95,96.62,97.29,"fornøyde"]]}],"lexicon":{"10.5":{"lemma":"10.5","zh":"第 10.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bestiller":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","form":"现在时","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":"pronunciation/9422127081333b8048f1.mp3"},"brudeparet":{"lemma":"brudepar","zh":"新娘和新郎","pos":"名词","ref":"10-053","form":"单数定指","clip":null},"bryllupsgjestene":{"lemma":"bryllupsgjest","zh":"婚礼宾客（复数定指）","pos":"名词","ref":null,"clip":null},"bryllupsmiddag":{"lemma":"bryllupsmiddag","zh":"婚宴","pos":"名词","ref":null,"clip":null},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","c