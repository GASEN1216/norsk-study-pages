{"id":"pa-vei-8.B","bookId":"pa-vei-textbook","readingId":"8.B","title":"En dag i mars","audio":"audio/pa-vei/8.B.mp3","duration":82.8,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.94,"end":2.545,"text":"Huff, for et vær!","zh":"哎呀，这是什么天气！","words":[[0,4,0.94,1.42,"huff"],[6,9,1.94,2.103,"for@pa-vei-for-exclamation"],[10,12,2.103,2.263,"et"],[13,16,2.263,2.545,"vær"]],"speaker":"Nils"},{"id":1,"start":3.7,"end":4.485,"text":"Jeg fryser.","zh":"我冷得发抖。","words":[[0,3,3.7,3.865,"jeg"],[4,10,3.9,4.485,"fryser"]],"speaker":"Nils"},{"id":2,"start":5.8,"end":7.925,"text":"Ja, i dag er det surt.","zh":"是啊，今天阴冷难受。","words":[[0,2,5.8,5.965,"ja"],[4,5,6.48,6.585,"i"],[6,9,6.62,7.005,"dag"],[10,12,7.06,7.213,"er"],[13,16,7.213,7.365,"det"],[17,21,7.5,7.925,"surt"]],"speaker":"Harald"},{"id":3,"start":8.66,"end":10.485,"text":"Nå håper jeg våren kommer snart.","zh":"我希望春天快点来。","words":[[0,2,8.66,8.805,"nå"],[3,8,8.88,9.182,"håper"],[9,12,9.182,9.325,"jeg"],[13,18,9.38,9.785,"våren"],[19,25,9.8,10.133,"kommer"],[26,31,10.133,10.485,"snart"]],"speaker":"Harald"},{"id":4,"start":11.624,"end":12.809,"text":"Det tviler jeg på.","zh":"我看未必。","words":[[0,3,11.624,11.869,"det"],[4,10,11.964,12.466,"tviler"],[11,14,12.466,12.629,"jeg"],[15,17,12.644,12.809,"på"]],"speaker":"Nils"},{"id":5,"start":13.884,"end":15.889,"text":"I dag morges snødde det!","zh":"今天早上还下雪了！","words":[[0,1,13.884,13.989,"i"],[2,5,14.024,14.329,"dag"],[6,12,14.344,14.889,"morges"],[13,19,15.104,15.709,"snødde"],[20,23,15.724,15.889,"det"]],"speaker":"Nils"},{"id":6,"start":16.444,"end":17.749,"text":"Og det er midt i mars!","zh":"现在都三月中旬了！","words":[[0,2,16.444,16.547,"og"],[3,6,16.547,16.666,"det"],[7,9,16.666,16.789,"er"],[10,14,16.844,17.189,"midt"],[15,16,17.264,17.389,"i"],[17,21,17.404,17.749,"mars"]],"speaker":"Nils"},{"id":7,"start":18.844,"end":21.589,"text":"Det er alt for kaldt å bo i Norge om vinteren!","zh":"冬天住在挪威实在太冷了！","words":[[0,3,18.844,18.997,"det"],[4,6,18.997,19.129,"er"],[7,10,19.304,19.637,"alt"],[11,14,19.637,19.806,"for@pa-vei-for-excess"],[15,20,19.806,20.206,"kaldt"],[21,22,20.206,20.306,"å"],[23,25,20.306,20.469,"bo"],[26,27,20.544,20.666,"i"],[28,33,20.666,20.977,"norge"],[34,36,20.977,21.087,"om"],[37,45,21.087,21.589,"vinteren"]],"speaker":"Nils"},{"id":8,"start":23.124,"end":25.569,"text":"Det er jo hyggelig at årstidene er forskjellige.","zh":"四季各不相同也挺好的呀。","words":[[0,3,23.124,23.287,"det"],[4,6,23.287,23.436,"er"],[7,9,23.436,23.569,"jo"],[10,18,23.604,24.066,"hyggelig"],[19,21,24.066,24.216,"at"],[22,31,24.216,24.746,"årstidene"],[32,34,24.746,24.867,"er"],[35,47,24.867,25.569,"forskjellige"]],"speaker":"Harald"},{"id":9,"start":26.244,"end":27.049,"text":"Jeg liker det.","zh":"我喜欢这样。","words":[[0,3,26.244,26.469,"jeg"],[4,9,26.544,26.907,"liker"],[10,13,26.907,27.049,"det"]],"speaker":"Harald"},{"id":10,"start":27.864,"end":29.109,"text":"Men du må kle deg godt.","zh":"不过你得穿暖和。","words":[[0,3,27.864,28.089,"men"],[4,6,28.144,28.267,"du"],[7,9,28.267,28.407,"må"],[10,13,28.407,28.589,"kle"],[14,17,28.644,28.827,"deg"],[18,22,28.827,29.109,"godt"]],"speaker":"Harald"},{"id":11,"start":30.184,"end":33.409,"text":"Det finnes ikke dårlig vær, bare dårlige klær, vet du!","zh":"你知道，没有坏天气，只有不合适的衣服！","words":[[0,3,30.184,30.349,"det"],[4,10,30.364,30.736,"finnes"],[11,15,30.736,30.947,"ikke"],[16,22,30.947,31.327,"dårlig"],[23,26,31.327,31.609,"vær"],[28,32,32.024,32.269,"bare"],[33,40,32.304,32.767,"dårlige"],[41,45,32.767,33.117,"klær"],[47,50,33.117,33.306,"vet"],[51,53,33.306,33.409,"du"]],"speaker":"Harald"},{"id":12,"start":34.704,"end":35.569,"text":"For noe tull!","zh":"胡说八道！","words":[[0,3,34.704,34.909,"for@pa-vei-for-exclamation"],[4,7,34.924,35.129,"noe"],[8,12,35.184,35.569,"tull"]],"speaker":"Nils"},{"id":13,"start":36.664,"end":39.289,"text":"Jeg er iskald – og tørst!","zh":"我冻透了，而且还口渴！","words":[[0,3,36.664,36.846,"jeg"],[4,6,36.846,36.969,"er"],[7,13,37.064,37.769,"iskald"],[16,18,38.564,38.709,"og"],[19,24,38.764,39.289,"tørst"]],"speaker":"Nils"},{"id":14,"start":40.264,"end":41.589,"text":"Nå trenger jeg noe å drikke.","zh":"现在我需要喝点东西。","words":[[0,2,40.264,40.409,"nå"],[3,10,40.424,40.746,"trenger"],[11,14,40.746,40.877,"jeg"],[15,18,40.877,41.056,"noe"],[19,20,41.056,41.136,"å"],[21,27,41.136,41.589,"drikke"]],"speaker":"Nils"},{"id":15,"start":42.644,"end":43.569,"text":"Blir du med på kafé?","zh":"你跟我去咖啡馆吗？","words":[[0,4,42.644,42.877,"blir"],[5,7,42.877,42.977,"du"],[8,11,42.977,43.136,"med"],[12,14,43.136,43.246,"på"],[15,19,43.246,43.569,"kafé"]],"speaker":"Nils"},{"id":16,"start":47.1,"end":47.845,"text":"Sammendrag.","zh":"摘要","words":[[0,10,47.1,47.845,"sammendrag"]]},{"id":17,"start":49.86,"end":54.985,"text":"Det er en kald dag i midten av mars, og Nils klager på været.","zh":"三月中旬的一个寒冷日子，尼尔斯在抱怨天气。","words":[[0,3,49.86,50.025,"det"],[4,6,50.04,50.172,"er"],[7,9,50.172,50.305,"en"],[10,14,50.34,50.725,"kald"],[15,18,50.8,51.225,"dag"],[19,20,51.42,51.523,"i"],[21,27,51.523,51.942,"midten"],[28,30,51.942,52.052,"av"],[31,35,52.052,52.345,"mars"],[37,39,53.26,53.405,"og"],[40,44,53.42,53.805,"nils"],[45,51,53.86,54.465,"klager"],[52,54,54.5,54.625,"på"],[55,60,54.64,54.985,"været"]]},{"id":18,"start":56.52,"end":59.045,"text":"Han vil ikke bo i Norge om vinteren.","zh":"他不想冬天住在挪威。","words":[[0,3,56.52,56.705,"han"],[4,7,56.76,56.945,"vil"],[8,12,56.98,57.225,"ikke"],[13,15,57.26,57.425,"bo"],[16,17,57.64,57.745,"i"],[18,23,57.78,58.205,"norge"],[24,26,58.4,58.525,"om"],[27,35,58.56,59.045,"vinteren"]]},{"id":19,"start":60.814,"end":67.419,"text":"Harald liker at årstidene er forskjellige, men han håper også at våren kommer snart.","zh":"哈拉尔喜欢四季的变化，不过他也希望春天快点来。","words":[[0,6,60.814,61.359,"harald"],[7,12,61.394,61.939,"liker"],[13,15,61.954,62.117,"at"],[16,25,62.117,62.716,"årstidene"],[26,28,62.716,62.859,"er"],[29,41,62.874,63.379,"forskjellige"],[43,46,64.694,64.879,"men"],[47,50,64.934,65.139,"han"],[51,56,65.214,65.619,"håper"],[57,61,65.674,66.079,"også"],[62,64,66.194,66.359,"at"],[65,70,66.394,66.739,"våren"],[71,77,66.754,67.099,"kommer"],[78,83,67.114,67.419,"snart"]]},{"id":20,"start":69.614,"end":73.039,"text":"Nils fryser, og derfor vil han på kafé.","zh":"尼尔斯觉得冷，所以想去咖啡馆。","words":[[0,4,69.614,70.019,"nils"],[5,11,70.074,70.619,"fryser"],[13,15,71.574,71.699,"og"],[16,22,71.734,72.179,"derfor"],[23,26,72.194,72.357,"vil"],[27,30,72.357,72.517,"han"],[31,33,72.517,72.656,"på"],[34,38,72.656,73.039,"kafé"]]},{"id":21,"start":74.644,"end":76.949,"text":"Han sier at han må ha noe å drikke.","zh":"他说自己得喝点东西。","words":[[0,3,74.644,74.849,"han"],[4,8,74.964,75.389,"sier"],[9,11,75.484,75.626,"at"],[12,15,75.626,75.767,"han"],[16,18,75.767,75.889,"må"],[19,21,75.944,76.089,"ha"],[22,25,76.204,76.397,"noe"],[26,27,76.397,76.477,"å"],[28,34,76.477,76.949,"drikke"]]},{"id":22,"start":78.684,"end":81.049,"text":"Han spør om Harald vil bli med på kafé.","zh":"他问哈拉尔要不要一起去咖啡馆。","words":[[0,3,78.684,78.869,"han"],[4,8,78.944,79.189,"spør"],[9,11,79.204,79.329,"om"],[12,18,79.384,79.869,"harald"],[19,22,79.884,80.047,"vil"],[23,26,80.047,80.229,"bli"],[27,30,80.304,80.469,"med"],[31,33,80.604,80.746,"på"],[34,38,80.746,81.049,"kafé"]]}],"lexicon":{"alt":{"lemma":"alt","zh":"一切","pos":"代词","ref":"10-054","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"bli":{"lemma":"bli","pos":"动词","zh":"变成；成为；留下","ref":null,"clip":null,"form":"不定式"},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"bo":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"不定式","clip":null},"dag":{"lemma":"dag","zh":"天；日（i dag：今天）","pos":"名词","ref":"basics:time:dag","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"derfor":{"lemma":"derfor","zh":"因此","