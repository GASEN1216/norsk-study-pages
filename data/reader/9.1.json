{"id":"9.1","title":"Hvordan bor du?","audio":"audio/9.1.mp3","duration":228.26,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.53,"text":"9.1 Hvordan bor du?","heading":true,"zh":"9.1 你住得怎么样？","words":[[0,3,0.15,1.3,"9.1"],[4,11,2.24,2.8,"hvordan"],[12,15,2.8,3.1,"bor"],[16,18,3.1,3.45,"du"]]},{"id":1,"start":6.19,"end":13.09,"text":"På biblioteket er det språkkafé, og Viola og Biniam går dit en gang i uka.","zh":"图书馆里有语言咖啡馆，维奥拉和比尼亚姆每周去那里一次。","words":[[0,2,6.27,6.54,"på"],[3,14,6.54,7.58,"biblioteket"],[15,17,7.58,7.82,"er"],[18,21,7.82,7.98,"det"],[22,31,7.98,8.84,"språkkafé"],[33,35,9.56,9.68,"og"],[36,41,9.68,10.16,"viola"],[42,44,10.16,10.52,"og"],[45,51,10.52,11.08,"biniam"],[52,55,11.08,11.48,"går"],[56,59,11.48,11.68,"dit"],[60,62,11.68,12.1,"en~a939a9e56dc5"],[63,67,12.1,12.34,"gang~14f58c07f8a2"],[68,69,12.34,12.58,"i~5e0003d1c512"],[70,73,12.58,13.01,"uka"]]},{"id":2,"start":13.96,"end":17.79,"text":"I dag snakker de om bolig med ei eldre, norsk dame.","zh":"今天他们和一位上了年纪的挪威女士谈论住房。","words":[[0,1,14.04,14.28,"i"],[2,5,14.28,14.48,"dag"],[6,13,14.48,14.98,"snakker"],[14,16,14.98,15.12,"de"],[17,19,15.12,15.3,"om~52c0bdc828db"],[20,25,15.3,15.76,"bolig"],[26,29,15.76,16.12,"med"],[30,32,16.12,16.32,"ei~47aa2d18e376"],[33,38,16.32,16.76,"eldre"],[40,45,16.76,17.22,"norsk~300c0d0c4f59"],[46,50,17.22,17.71,"dame"]]},{"id":3,"start":19.82,"end":33.84,"text":"Jeg bodde i en stor enebolig før, men for to år siden flyttet jeg til en liten leilighet i sentrum. Bor dere i enebolig eller i leilighet?","speaker":"Dame","zh":"我以前住在一栋很大的独栋住宅里，但两年前我搬到了市中心的一套小公寓。你们住独栋住宅还是公寓？","words":[[0,3,19.9,20.28,"jeg"],[4,9,20.28,20.78,"bodde"],[10,11,20.78,21.08,"i"],[12,14,21.08,21.3,"en~a939a9e56dc5"],[15,19,21.3,21.76,"stor"],[20,28,21.76,22.88,"enebolig"],[29,32,22.88,23.12,"før~f9c047e06941"],[34,37,23.96,24.36,"men"],[38,41,24.36,24.84,"for~e753a937d19e"],[42,44,24.84,25.17,"to"],[45,47,25.22,25.46,"år"],[48,53,25.46,25.8,"siden~9a3d2d89a980"],[54,61,25.8,26.62,"flyttet"],[62,65,26.62,26.9,"jeg"],[66,69,27.22,27.24,"til"],[70,72,27.24,27.42,"en~a939a9e56dc5"],[73,78,27.42,27.86,"liten"],[79,88,27.86,28.66,"leilighet"],[89,90,28.66,28.94,"i"],[91,98,28.94,29.42,"sentrum"],[100,103,30.67,30.93,"bor"],[104,108,30.93,31.19,"dere"],[109,110,31.19,31.53,"i"],[111,119,31.53,32.29,"enebolig"],[120,125,32.29,32.79,"eller"],[126,127,32.79,32.95,"i"],[128,137,32.95,33.76,"leilighet"]]},{"id":4,"start":35.57,"end":55.49,"text":"Jeg leier en leilighet i fjerde etasje i ei blokk, i et rolig område utenfor sentrum. Jeg har bodd der i et år. Leiligheten er gammel og ganske liten. Den er bare 35 kvadratmeter, men den har balkong.","speaker":"Biniam","zh":"我在一栋公寓楼的四楼租了一套公寓，在市中心外一个安静的地区。我在那里已经住了一年。公寓很旧，而且相当小。它只有35平方米，但是有阳台。","words":[[0,3,35.65,35.97,"jeg"],[4,9,35.97,36.43,"leier~cf28fde32c3d"],[10,12,36.43,36.69,"en~a939a9e56dc5"],[13,22,36.69,37.25,"leilighet"],[23,24,37.25,37.41,"i"],[25,31,37.41,37.81,"fjerde"],[32,38,37.81,38.39,"etasje"],[39,40,38.39,38.63,"i"],[41,43,38.63,38.77,"ei~47aa2d18e376"],[44,49,38.77,39.23,"blokk"],[51,52,39.23,40.13,"i"],[53,55,40.13,40.31,"et~054dde72f37b"],[56,61,40.31,40.75,"rolig"],[62,68,40.75,41.27,"område"],[69,76,41.27,41.83,"utenfor"],[77,84,41.83,42.33,"sentrum"],[86,89,43.62,43.86,"jeg"],[90,93,43.86,44.0,"har~8b9792170cca"],[94,98,44.0,44.4,"bodd"],[99,102,44.4,44.64,"der"],[103,104,44.64,44.84,"i~6fee0f940b9f"],[105,107,44.84,45.0,"et~054dde72f37b"],[108,110,45.0,45.28,"år"],[112,123,47.0,47.62,"leiligheten"],[124,126,47.62,47.92,"er"],[127,133,47.92,48.38,"gammel"],[134,136,48.38,48.76,"og"],[137,143,48.76,49.24,"ganske"],[144,149,49.24,49.62,"liten"],[151,154,50.92,51.16,"den"],[155,157,51.16,51.34,"er"],[158,162,51.34,51.72,"bare"],[163,165,51.72,52.42,"35"],[166,178,52.42,53.3,"kvadratmeter"],[180,183,54.16,54.34,"men"],[184,187,54.34,54.52,"den"],[188,191,54.52,54.74,"har"],[192,199,54.74,55.41,"balkong"]]},{"id":5,"start":56.83,"end":77.67,"text":"På balkongen har jeg et lite, grønt bord og to stoler. Jeg har ei lita stue med en kjempegod sofa. Kjøkkenet er lite og mørkt. Jeg trives ikke så godt, for det bor mange små barn i blokka, og de bråker mye.","speaker":"Biniam","zh":"阳台上我放了一张绿色的小桌子和两把椅子。我有一个小客厅，里面有一张超级舒服的沙发。厨房又小又暗。我住得不太舒心，因为楼里住着很多小孩，他们很吵。","words":[[0,2,56.91,57.09,"på"],[3,12,57.09,57.79,"balkongen"],[13,16,57.79,58.03,"har"],[17,20,58.03,58.19,"jeg"],[21,23,58.19,58.45,"et~054dde72f37b"],[24,28,58.45,58.73,"lite"],[30,35,58.73,59.39,"grønt~c1ed56a199c5"],[36,40,59.39,59.69,"bord"],[41,43,59.69,60.15,"og"],[44,46,60.15,60.43,"to"],[47,53,60.43,60.89,"stoler"],[55,58,62.54,62.78,"jeg"],[59,62,62.78,63.06,"har"],[63,65,63.06,63.3,"ei~47aa2d18e376"],[66,70,63.3,63.7,"lita"],[71,75,63.7,64.2,"stue"],[76,79,64.2,64.6,"med"],[80,82,64.6,64.82,"en~a939a9e56dc5"],[83,92,64.82,65.44,"kjempegod"],[93,97,65.44,65.68,"sofa"],[99,108,67.6,68.14,"kjøkkenet"],[109,111,68.14,68.32,"er"],[112,116,68.32,68.78,"lite"],[117,119,68.78,69.16,"og"],[120,125,69.16,69.62,"mørkt"],[127,130,70.88,71.04,"jeg"],[131,137,71.04,71.64,"trives"],[138,142,71.64,71.8,"ikke"],[143,145,71.8,71.98,"så~0ccb28b00948"],[146,150,71.98,72.26,"godt~28a24c509f3c"],[152,155,72.71,73.35,"for~1b22712a94b1"],[156,159,73.35,73.47,"det"],[160,163,73.47,73.67,"bor"],[164,169,73.67,74.01,"mange"],[170,173,74.01,74.53,"små"],[174,178,74.53,74.87,"barn"],[179,180,74.87,75.05,"i"],[181,187,75.05,75.49,"blokka"],[189,191,76.19,76.33,"og"],[192,194,76.33,76.53,"de"],[195,201,76.53,77.13,"bråker~f7900df14af7"],[202,205,77.13,77.59,"mye~933c5a923198"]]},{"id":6,"start":79.22,"end":84.34,"text":"Jeg drømmer om å bo sentralt, i en ny, moderne leilighet.","speaker":"Biniam","zh":"我梦想住在市中心，住一套新的现代化公寓。","words":[[0,3,79.3,79.44,"jeg"],[4,11,79.44,79.92,"drømmer~7b5338107788"],[12,14,79.92,80.1,"om~e2d0d94aac3f"],[15,16,80.1,80.24,"å~0583da7a620a"],[17,19,80.24,80.46,"bo"],[20,28,80.46,81.34,"sentralt~45b4f61a8691"],[30,31,81.96,82.1,"i"],[32,34,82.1,82.26,"en~a939a9e56dc5"],[35,37,82.26,82.62,"ny"],[39,46,82.86,83.52,"moderne"],[47,56,83.52,84.26,"leilighet"]]},{"id":7,"start":86.12,"end":105.68,"text":"Jeg er au pair og bor hos en norsk familie med to barn. De eier en fin enebolig i Elgveien i nærheten av skogen. Huset er nesten 300 kvadratmeter og har tre etasjer. Det er veldig moderne, for de pusset opp i fjor.","speaker":"Viola","zh":"我是互惠生（au pair），住在一个有两个孩子的挪威家庭里。他们在森林附近的Elgveien街有一栋漂亮的独栋住宅。房子将近300平方米，有三层。房子很现代，因为他们去年翻修过。","words":[[0,3,86.2,86.55,"jeg"],[4,6,86.55,86.81,"er"],[7,9,86.81,87.07,"au"],[10,14,87.07,87.35,"pair"],[15,17,87.35,87.93,"og"],[18,21,87.93,88.13,"bor"],[22,25,88.13,88.35,"hos"],[26,28,88.35,88.57,"en~a939a9e56dc5"],[29,34,88.57,88.91,"norsk~300c0d0c4f59"],[35,42,88.91,89.49,"familie"],[43,46,89.49,89.89,"med"],[47,49,89.89,90.17,"to"],[50,54,90.17,90.45,"barn"],[56,58,91.52,91.88,"de"],[59,63,91.88,92.2,"eier"],[64,66,92.2,92.48,"en~a939a9e56dc5"],[67,70,92.48,92.72,"fin"],[71,79,92.72,93.56,"enebolig"],[80,81,93.56,94.0,"i"],[82,90,94.0,94.74,"elgveien"],[91,92,94.74,95.1,"i"],[93,101,95.1,95.62,"nærheten"],[102,104,95.62,95.78,"av~3514b4bb86e2"],[105,111,95.78,96.14,"skogen"],[113,118,97.47,97.91,"huset"],[119,121,97.91,98.07,"er"],[122,128,98.07,98.49,"nesten"],[129,132,98.49,98.91,"300"],[133,145,98.91,100.01,"kvadratmeter"],[146,148,100.01,100.67,"og"],[149,152,100.67,100.79,"har"],[153,156,100.79,101.11,"tre"],[157,164,101.11,101.69,"etasjer"],[166,169,102.7,102.86,"det"],[170,172,102.86,102.92,"er"],[173,179,102.92,103.36,"veldig"],[180,187,103.36,103.86,"moderne"],[189,192,104.18,104.46,"for~1b22712a94b1"],[193,195,104.46,104.58,"de"],[196,202,104.58,104.88,"pusset~a5924599ef6a"],[203,206,104.88,105.1,"opp~10d7fedbe51f"],[207,208,105.1,105.2,"i~e809b2e9b139"],[209,213,105.2,105.6,"fjor"]]},{"id":8,"start":106.86,"end":126.18,"text":"Familien har bodd der i mange år, men jeg har bare bodd der i fem måneder. Vi har ei koselig stue. I stua har vi en deilig og myk sofa foran en stor tv. Kjøkkenet er lyst og fint, og det er fem soverom i huset.","speaker":"Viola","zh":"这家人在那里住了很多年，但我在那里才住了五个月。我们有一个温馨的客厅。客厅里，一台大电视前面放着一张舒服柔软的沙发。厨房明亮漂亮，房子里有五间卧室。","words":[[0,8,106.94,107.3,"familien"],[9,12,107.3,107.62,"har~8b9792170cca"],[13,17,107.62,107.84,"bodd"],[18,21,107.84,107.98,"der"],[22,23,107.98,108.1,"i~c0bbfa552007"],[24,29,108.1,108.32,"mange"],[30,32,108.32,108.72,"år"],[34,37,109.34,109.44,"men"],[38,41,109.44,109.66,"jeg"],[42,45,109.66,109.82,"har~8b9792170cca"],[46,50,109.82,110.08,"bare"],[51,55,110.08,110.32,"bodd"],[56,59,110.32,110.48,"der"],[60,61,110.48,110.82,"i~b1bf51b6020a"],[62,65,110.82,111.04,"fem"],[66,73,111.04,111.56,"måneder"],[75,77,112.86,113.02,"vi"],[78,81,113.02,113.14,"har"],[82,84,113.14,113.3,"ei~47aa2d18e376"],[85,92,113.3,113.92,"koselig"],[93,97,113.92,114.26,"stue"],[99,100,115.18,115.42,"i"],[101,105,115.42,115.88,"stua"],[106,109,115.88,116.42,"har"],[110,112,116.42,116.52,"vi"],[113,115,116.52,116.7,"en~a939a9e56dc5"],[116,122,116.7,117.2,"deilig~a40a3aeaf456"],[123,125,117.2,117.36,"og"],[126,129,117.36,117.66,"myk"],[130,134,117.66,117.92,"sofa"],[135,140,117.92,118.68,"foran~d09b0d7b7ee2"],[141,143,118.68,118.92,"en~a939a9e56dc5"],[144,148,118.92,119.24,"stor"],[149,151,119.24,119.58,"tv"],[153,162,121.03,121.63,"kjøkkenet"],[163,165,121.63,122.05,"er"],[166,170,122.05,122.57,"lyst~a771b91023dc"],[171,173,122.57,122.79,"og"],[174,178,122.79,123.19,"fint"],[180,182,124.03,124.25,"og"],[183,186,124.25,124.43,"det"],[187,189,124.43,124.61,"er"],[190,193,124.61,124.99,"fem"],[194,201,124.99,125.55,"soverom"],[202,203,125.55,125.71,"i"],[204,209,125.71,126.1,"huset"]]},{"id":9,"start":127.23,"end":146.38,"text":"Soverommene er i andre etasje. Rommene til barna er små, men jeg har et stort rom. På rommet har jeg et lite skrivebord, en tv og en blå sofa.","speaker":"Viola","zh":"卧室在二楼。孩子们的房间很小，但我有一个大房间。我的房间里有一张小书桌、一台电视和一张蓝色沙发。","words":[[0,11,127.31,128.06,"soverommene"],[12,14,128.06,128.54,"er"],[15,16,128.54,128.68,"i"],[17,22,128.68,128.96,"andre~bb01123fb98a"],[23,29,128.96,129.44,"etasje"],[31,38,130.86,131.34,"rommene"],[39,42,131.34,131.54,"til~8de1a9181f86"],[43,48,131.54,131.9,"barna"],[49,51,131.9,132.14,"er"],[52,55,132.14,132.48,"små"],[57,60,133.02,133.22,"men"],[61,64,133.22,133.46,"jeg"],[65,68,133.46,133.62,"har"],[69,71,133.62,133.82,"et~054dde72f37b"],[72,77,133.82,134.1,"stort"],[78,81,134.1,134.42,"rom"],[83,85,136.07,136.27,"på"],[86,92,136.27,136.67,"rommet"],[93,96,136.67,137.11,"har"],[97,100,137.11,137.25,"jeg"],[101,103,137.25,137.41,"et~054dde72f37b"],[104,108,137.41,137.67,"lite"],[109,119,137.67,138.45,"skrivebord"],[121,123,139.03,139.25,"en~a939a9e56dc5"],[124,126,139.25,139.65,"tv"],[127,129,139.65,140.27,"og"],[130,132,140.27,140.39,"en~a939a9e56dc5"],[133,136,140.39,140.61,"blå"],[137,141,145.73,146.3,"sofa"]]},{"id":10,"start":147.3,"end":151.02,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,149.27,150.94,"sammendrag"]]},{"id":11,"start":152.14,"end":157.92,"text":"Viola og Biniam er på språkkafeen på biblioteket og snakker norsk.","zh":"维奥拉和比尼亚姆在图书馆的语言咖啡馆里说挪威语。","words":[[0,5,152.22,152.76,"viola"],[6,8,152.76,153.12,"og"],[9,15,153.12,153.6,"biniam"],[16,18,153.6,154.04,"er"],[19,21,154.04,154.3,"på"],[22,33,154.3,155.4,"språkkafeen"],[34,36,155.4,155.62,"på"],[37,48,155.62,156.68,"biblioteket"],[49,51,156.68,156.84,"og"],[52,59,156.84,157.18,"snakker"],[60,65,157.18,157.84,"norsk~4de5d75feae1"]]},{"id":12,"start":158.69,"end":162.05,"text":"I dag snakker de om bolig med ei eldre dame.","zh":"今天他们和一位上了年纪的女士谈论住房。","words":[[0,1,158.77,159.0,"i"],[2,5,159.0,159.2,"dag"],[6,13,159.2,159.7,"snakker"],[14,16,159.7,159.82,"de"],[17,19,159.82,159.98,"om~52c0bdc828db"],[20,25,159.98,160.44,"bolig"],[26,29,160.44,160.92,"med"],[30,32,160.92,161.1,"ei~47aa2d18e376"],[33,38,161.1,161.52,"eldre"],[39,43,161.52,161.97,"dame"]]},{"id":13,"start":163.11,"end":168.94,"text":"Hun bodde i en enebolig før, men nå bor hun i en liten leilighet.","zh":"她以前住在一栋独栋住宅里，但现在她住在一套小公寓里。","words":[[0,3,163.19,163.42,"hun"],[4,9,163.42,163.8,"bodde"],[10,11,163.8,163.96,"i"],[12,14,163.96,164.14,"en~a939a9e56dc5"],[15,23,164.14,164.96,"enebolig"],[24,27,164.96,165.22,"før~f9c047e06941"],[29,32,165.78,165.94,"men"],[33,35,165.94,166.28,"nå~d531d47a7712"],[36,39,166.28,166.88,"bor"],[40,43,166.88,167.14,"hun"],[44,45,167.14,167.32,"i"],[46,48,167.32,167.5,"en~a939a9e56dc5"],[49,54,167.5,167.88,"liten"],[55,64,167.88,168.87,"leilighet"]]},{"id":14,"start":169.83,"end":176.6,"text":"Biniam leier en gammel leilighet, men han har lyst til å flytte, for han trives ikke der.","zh":"比尼亚姆租了一套旧公寓，但他想搬家，因为他在那里住得不舒心。","words":[[0,6,169.91,170.39,"biniam"],[7,12,170.39,171.11,"leier~cf28fde32c3d"],[13,15,171.11,171.29,"en~a939a9e56dc5"],[16,22,171.29,171.69,"gammel"],[23,32,171.69,172.39,"leilighet"],[34,37,172.69,173.05,"men"],[38,41,173.05,173.41,"han"],[42,45,173.41,173.59,"har"],[46,50,173.59,173.85,"lyst~868273f22b73"],[51,54,173.85,174.03,"til~99ccdd3453b0"],[55,56,174.03,174.11,"å~0583da7a620a"],[57,63,174.11,174.55,"flytte"],[65,68,174.97,175.19,"for~1b22712a94b1"],[69,72,175.19,175.39,"han"],[73,79,175.39,175.95,"trives"],[80,84,175.95,176.13,"ikke"],[85,88,176.13,176.52,"der"]]},{"id":15,"start":177.51,"end":182.14,"text":"Viola bor i en stor enebolig sammen med en norsk familie.","zh":"维奥拉和一个挪威家庭一起住在一栋很大的独栋住宅里。","words":[[0,5,177.59,178.24,"viola"],[6,9,178.24,178.7,"bor"],[10,11,178.7,178.82,"i"],[12,14,178.82,179.02,"en~a939a9e56dc5"],[15,19,179.02,179.38,"stor"],[20,28,179.38,180.24,"enebolig"],[29,35,180.24,180.74,"sammen"],[36,39,180.74,180.88,"med"],[40,42,180.88,181.08,"en~a939a9e56dc5"],[43,48,181.08,181.42,"norsk~300c0d0c4f59"],[49,56,181.42,182.06,"familie"]]},{"id":16,"start":182.58,"end":186.32,"text":"Hun har et stort rom der og trives veldig godt.","zh":"她在那里有一个大房间，过得非常舒心。","words":[[0,3,182.66,182.94,"hun"],[4,7,182.94,183.14,"har"],[8,10,183.14,183.3,"et~054dde72f37b"],[11,16,183.3,183.64,"stort"],[17,20,183.64,183.88,"rom"],[21,24,183.88,184.14,"der"],[25,27,184.5,184.68,"og"],[28,34,184.68,185.14,"trives"],[35,41,185.14,185.6,"veldig"],[42,46,185.6,186.24,"godt~28a24c509f3c"]]},{"id":17,"start":190.02,"end":190.75,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,190.1,190.67,"fakta"]]},{"id":18,"start":192.07,"end":193.49,"text":"Boliger i Norge","subheading":true,"zh":"挪威的住房","words":[[0,7,192.15,192.64,"boliger"],[8,9,192.64,192.88,"i"],[10,15,192.88,193.41,"norge~546b56e35dd5"]]},{"id":19,"start":195.0,"end":197.97,"text":"Det er vanlig å eie egen bolig i Norge.","zh":"在挪威，拥有自己的住房是很普遍的。","words":[[0,3,195.08,195.18,"det"],[4,6,195.18,195.28,"er"],[7,13,195.28,195.74,"vanlig"],[14,15,195.74,195.84,"å~0583da7a620a"],[16,19,195.84,196.22,"eie"],[20,24,196.22,196.68,"egen"],[25,30,196.68,197.24,"bolig"],[31,32,197.24,197.44,"i"],[33,38,197.44,197.89,"norge~546b56e35dd5"]]},{"id":20,"start":198.99,"end":203.85,"text":"Nordmenn tar ofte kontakt med banken for å få lån til å kjøpe bolig.","zh":"挪威人常常联系银行，以获得贷款来买房。","words":[[0,8,199.07,199.58,"nordmenn"],[9,12,199.58,199.92,"tar~02e1bdd0ce18"],[13,17,199.92,200.4,"ofte"],[18,25,200.4,200.84,"kontakt"],[26,29,200.84,201.04,"med"],[30,36,201.04,201.68,"banken"],[37,40,201.68,201.92,"for~eb8cd4a9a3ad"],[41,42,201.92,202.04,"å~0583da7a620a"],[43,45,202.04,202.14,"få~65b84e08cd43"],[46,49,202.14,202.54,"lån"],[50,53,202.54,202.84,"til~8aee8aba5922"],[54,55,202.84,202.94,"å~0583da7a620a"],[56,61,202.94,203.3,"kjøpe"],[62,67,203.3,203.77,"bolig"]]},{"id":21,"start":204.92,"end":209.62,"text":"Noen kjøper leilighet, og noen kjøper enebolig.","zh":"有些人买公寓，有些人买独栋住宅。","words":[[0,4,205.0,205.51,"noen~8e23a4fd3f2f"],[5,11,205.51,206.07,"kjøper"],[12,21,206.07,206.49,"leilighet"],[23,25,207.45,207.65,"og"],[26,30,207.65,208.19,"noen~8e23a4fd3f2f"],[31,37,208.19,208.77,"kjøper"],[38,46,208.77,209.54,"enebolig"]]},{"id":22,"start":210.55,"end":217.56,"text":"I byene bor mange i leiligheter, men på små steder er det vanlig å bo i enebolig.","zh":"在城市里，很多人住公寓，但在小地方，住独栋住宅很普遍。","words":[[0,1,210.63,210.76,"i"],[2,7,210.76,211.22,"byene"],[8,11,211.22,211.54,"bor"],[12,17,211.54,211.9,"mange"],[18,19,211.9,212.26,"i"],[20,31,212.26,212.96,"leiligheter"],[33,36,213.56,213.76,"men"],[37,39,213.76,213.94,"på"],[40,43,213.94,214.32,"små"],[44,50,214.32,214.88,"steder"],[51,53,214.88,215.48,"er"],[54,57,215.48,215.58,"det"],[58,64,215.58,216.06,"vanlig"],[65,66,216.06,216.26,"å~0583da7a620a"],[67,69,216.26,216.48,"bo"],[70,71,216.48,216.66,"i"],[72,80,216.66,217.48,"enebolig"]]},{"id":23,"start":218.58,"end":224.86,"text":"Mange eneboliger har en leilighet i kjelleren, og den kan huseier leie ut.","zh":"很多独栋住宅的地下室里有一套公寓，房主可以把它租出去。","words":[[0,5,218.66,219.0,"mange"],[6,16,219.0,219.86,"eneboliger"],[17,20,219.86,220.08,"har"],[21,23,220.08,220.28,"en~a939a9e56dc5"],[24,33,220.28,220.92,"leilighet"],[34,35,220.92,221.02,"i"],[36,45,221.02,221.44,"kjelleren"],[47,49,221.94,222.16,"og"],[50,53,222.16,222.44,"den"],[54,57,222.44,222.76,"kan"],[58,65,222.76,223.42,"huseier"],[66,70,223.42,223.88,"leie~98b2d7497efd"],[71,73,223.88,224.06,"ut~7d11fd252301"]]}],"lexicon":{"300":{"lemma":"300","zh":"数字 300","pos":"数词","ref":null,"clip":null,"kind":"number"},"35":{"lemma":"35","zh":"数字 35","pos":"数词","ref":"basics:numbers:trettifem","clip":null,"kind":"number"},"9.1":{"lemma":"9.1","zh":"第 9.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre","clip":"pronunciation/bd01b0b648c2c64eb1bd.mp3","ambiguous":true,"candidates":[{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre"},{"lemma":"andre","zh":"第二","pos":"序数词","ref":"basics:ordinals:andre"},{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式"}]},"au":{"lemma":"au pair","zh":"（au pair）互惠生","pos":"名词","ref":null,"clip":null},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"balkong":{"le