{"id":"9.1","title":"Hvordan bor du?","audio":"audio/9.1.mp3","duration":228.26,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.53,"text":"9.1 Hvordan bor du?","heading":true,"zh":"9.1 你住得怎么样？","words":[[0,3,0.15,1.3,"9.1"],[4,11,2.24,2.8,"hvordan"],[12,15,2.8,3.1,"bor"],[16,18,3.1,3.45,"du"]]},{"id":1,"start":6.23,"end":13.14,"text":"På biblioteket er det språkkafé, og Viola og Biniam går dit en gang i uka.","zh":"图书馆里有语言咖啡馆，维奥拉和比尼亚姆每周去那里一次。","words":[[0,2,6.29,6.68,"på"],[3,14,6.68,7.7,"biblioteket"],[15,17,7.7,7.86,"er"],[18,21,7.86,8.08,"det"],[22,31,8.08,8.98,"språkkafé"],[33,35,9.6,9.72,"og"],[36,41,9.72,10.4,"viola"],[42,44,10.4,10.6,"og"],[45,51,10.6,11.28,"biniam"],[52,55,11.28,11.54,"går"],[56,59,11.54,11.94,"dit"],[60,62,11.94,12.18,"en~a939a9e56dc5"],[63,67,12.18,12.5,"gang~14f58c07f8a2"],[68,69,12.5,12.64,"i~5e0003d1c512"],[70,73,12.64,12.99,"uka"]]},{"id":2,"start":13.99,"end":17.83,"text":"I dag snakker de om bolig med ei eldre, norsk dame.","zh":"今天他们和一位上了年纪的挪威女士谈论住房。","words":[[0,1,14.05,14.26,"i"],[2,5,14.26,14.7,"dag"],[6,13,14.7,15.04,"snakker"],[14,16,15.04,15.2,"de"],[17,19,15.2,15.36,"om~52c0bdc828db"],[20,25,15.36,15.92,"bolig"],[26,29,16.02,16.18,"med"],[30,32,16.18,16.4,"ei~47aa2d18e376"],[33,38,16.4,16.88,"eldre"],[40,45,16.88,17.28,"norsk~300c0d0c4f59"],[46,50,17.28,17.68,"dame"]]},{"id":3,"start":19.86,"end":33.89,"text":"Jeg bodde i en stor enebolig før, men for to år siden flyttet jeg til en liten leilighet i sentrum. Bor dere i enebolig eller i leilighet?","speaker":"Dame","zh":"我以前住在一栋很大的独栋住宅里，但两年前我搬到了市中心的一套小公寓。你们住独栋住宅还是公寓？","words":[[0,3,19.91,20.38,"jeg"],[4,9,20.38,21.02,"bodde"],[10,11,21.02,21.12,"i"],[12,14,21.12,21.36,"en~a939a9e56dc5"],[15,19,21.36,22.12,"stor"],[20,28,22.12,22.94,"enebolig"],[29,32,22.94,23.36,"før~f9c047e06941"],[34,37,24.14,24.57,"men"],[38,41,24.72,24.96,"for~e753a937d19e"],[42,44,24.96,25.34,"to"],[45,47,25.34,25.52,"år"],[48,53,25.52,26.04,"siden~9a3d2d89a980"],[54,61,26.22,26.7,"flyttet"],[62,65,26.7,27.14,"jeg"],[66,69,27.14,27.3,"til"],[70,72,27.3,27.48,"en~a939a9e56dc5"],[73,78,27.48,28.0,"liten"],[79,88,28.0,28.88,"leilighet"],[89,90,28.88,29.02,"i"],[91,98,29.02,29.63,"sentrum"],[100,103,30.8,30.96,"bor"],[104,108,30.96,31.44,"dere"],[109,110,31.44,31.6,"i"],[111,119,31.6,32.39,"enebolig"],[120,125,32.6,32.88,"eller"],[126,127,32.88,32.98,"i"],[128,137,32.98,33.74,"leilighet"]]},{"id":4,"start":35.61,"end":55.55,"text":"Jeg leier en leilighet i fjerde etasje i ei blokk, i et rolig område utenfor sentrum. Jeg har bodd der i et år. Leiligheten er gammel og ganske liten. Den er bare 35 kvadratmeter, men den har balkong.","speaker":"Biniam","zh":"我在一栋公寓楼的四楼租了一套公寓，在市中心外一个安静的地区。我在那里已经住了一年。公寓很旧，而且相当小。它只有35平方米，但是有阳台。","words":[[0,3,35.67,36.06,"jeg"],[4,9,36.06,36.54,"leier~cf28fde32c3d"],[10,12,36.54,36.74,"en~a939a9e56dc5"],[13,22,36.74,37.34,"leilighet"],[23,24,37.34,37.46,"i"],[25,31,37.46,37.84,"fjerde"],[32,38,37.84,38.56,"etasje"],[39,40,38.56,38.68,"i"],[41,43,38.68,38.84,"ei~47aa2d18e376"],[44,49,38.84,39.38,"blokk"],[51,52,40.04,40.18,"i"],[53,55,40.18,40.38,"et~054dde72f37b"],[56,61,40.38,40.84,"rolig"],[62,68,40.84,41.36,"område"],[69,76,41.36,41.92,"utenfor"],[77,84,41.92,42.53,"sentrum"],[86,89,43.76,43.9,"jeg"],[90,93,43.9,44.12,"har~8b9792170cca"],[94,98,44.12,44.42,"bodd"],[99,102,44.42,44.76,"der"],[103,104,44.76,44.88,"i~6fee0f940b9f"],[105,107,44.88,45.1,"et~054dde72f37b"],[108,110,45.1,45.52,"år"],[112,123,47.06,47.8,"leiligheten"],[124,126,47.8,48.0,"er"],[127,133,48.0,48.58,"gammel"],[134,136,48.68,48.82,"og"],[137,143,48.82,49.32,"ganske"],[144,149,49.32,49.9,"liten"],[151,154,51.02,51.22,"den"],[155,157,51.22,51.42,"er"],[158,162,51.42,51.88,"bare"],[163,165,51.88,52.56,"35"],[166,178,52.56,53.67,"kvadratmeter"],[180,183,54.22,54.38,"men"],[184,187,54.38,54.58,"den"],[188,191,54.58,54.84,"har"],[192,199,54.84,55.41,"balkong"]]},{"id":5,"start":56.86,"end":77.75,"text":"På balkongen har jeg et lite, grønt bord og to stoler. Jeg har ei lita stue med en kjempegod sofa. Kjøkkenet er lite og mørkt. Jeg trives ikke så godt, for det bor mange små barn i blokka, og de bråker mye.","speaker":"Biniam","zh":"阳台上我放了一张绿色的小桌子和两把椅子。我有一个小客厅，里面有一张超级舒服的沙发。厨房又小又暗。我住得不太舒心，因为楼里住着很多小孩，他们很吵。","words":[[0,2,56.92,57.2,"på"],[3,12,57.2,57.86,"balkongen"],[13,16,57.86,58.1,"har"],[17,20,58.1,58.34,"jeg"],[21,23,58.34,58.54,"et~054dde72f37b"],[24,28,58.54,59.1,"lite"],[30,35,59.1,59.54,"grønt~c1ed56a199c5"],[36,40,59.54,60.08,"bord"],[41,43,60.08,60.22,"og"],[44,46,60.22,60.58,"to"],[47,53,60.58,61.2,"stoler"],[55,58,62.66,62.88,"jeg"],[59,62,62.88,63.2,"har"],[63,65,63.2,63.36,"ei~47aa2d18e376"],[66,70,63.36,63.82,"lita"],[71,75,63.82,64.44,"stue"],[76,79,64.54,64.72,"med"],[80,82,64.72,64.88,"en~a939a9e56dc5"],[83,92,64.88,65.54,"kjempegod"],[93,97,65.54,66.08,"sofa"],[99,108,67.72,68.2,"kjøkkenet"],[109,111,68.2,68.4,"er"],[112,116,68.4,69.08,"lite"],[117,119,69.08,69.22,"og"],[120,125,69.22,69.88,"mørkt"],[127,130,70.94,71.18,"jeg"],[131,137,71.18,71.7,"trives"],[138,142,71.7,71.92,"ikke"],[143,145,71.92,72.06,"så~0ccb28b00948"],[146,150,72.06,72.56,"godt~28a24c509f3c"],[152,155,73.24,73.38,"for~1b22712a94b1"],[156,159,73.38,73.52,"det"],[160,163,73.52,73.8,"bor"],[164,169,73.8,74.24,"mange"],[170,173,74.24,74.64,"små"],[174,178,74.64,75.0,"barn"],[179,180,75.0,75.1,"i"],[181,187,75.1,75.68,"blokka"],[189,191,76.24,76.38,"og"],[192,194,76.38,76.62,"de"],[195,201,76.62,77.22,"bråker~f7900df14af7"],[202,205,77.22,77.59,"mye~933c5a923198"]]},{"id":6,"start":79.26,"end":84.41,"text":"Jeg drømmer om å bo sentralt, i en ny, moderne leilighet.","speaker":"Biniam","zh":"我梦想住在市中心，住一套新的现代化公寓。","words":[[0,3,79.32,79.52,"jeg"],[4,11,79.52,80.02,"drømmer~7b5338107788"],[12,14,80.02,80.16,"om~e2d0d94aac3f"],[15,16,80.16,80.28,"å~0583da7a620a"],[17,19,80.28,80.62,"bo"],[20,28,80.62,81.5,"sentralt~45b4f61a8691"],[30,31,82.02,82.14,"i"],[32,34,82.14,82.34,"en~a939a9e56dc5"],[35,37,82.34,82.66,"ny"],[39,46,82.86,83.58,"moderne"],[47,56,83.58,84.26,"leilighet"]]},{"id":7,"start":86.16,"end":105.75,"text":"Jeg er au pair og bor hos en norsk familie med to barn. De eier en fin enebolig i Elgveien i nærheten av skogen. Huset er nesten 300 kvadratmeter og har tre etasjer. Det er veldig moderne, for de pusset opp i fjor.","speaker":"Viola","zh":"我是互惠生（au pair），住在一个有两个孩子的挪威家庭里。他们在森林附近的Elgveien街有一栋漂亮的独栋住宅。房子将近300平方米，有三层。房子很现代，因为他们去年翻修过。","words":[[0,3,86.22,86.64,"jeg"],[4,6,86.64,86.94,"er"],[7,9,86.94,87.1,"au"],[10,14,87.1,87.66,"pair"],[15,17,87.86,87.98,"og"],[18,21,87.98,88.22,"bor"],[22,25,88.22,88.46,"hos"],[26,28,88.46,88.62,"en~a939a9e56dc5"],[29,34,88.62,88.98,"norsk~300c0d0c4f59"],[35,42,88.98,89.7,"familie"],[43,46,89.8,89.98,"med"],[47,49,89.98,90.26,"to"],[50,54,90.26,90.74,"barn"],[56,58,91.72,91.98,"de"],[59,63,91.98,92.28,"eier"],[64,66,92.28,92.52,"en~a939a9e56dc5"],[67,70,92.52,92.94,"fin"],[71,79,92.94,93.76,"enebolig"],[80,81,93.92,94.1,"i"],[82,90,94.1,95.04,"elgveien"],[91,92,95.04,95.14,"i"],[93,101,95.14,95.72,"nærheten"],[102,104,95.72,95.86,"av~3514b4bb86e2"],[105,111,95.86,96.44,"skogen"],[113,118,97.62,98.02,"huset"],[119,121,98.02,98.14,"er"],[122,128,98.14,98.64,"nesten"],[129,132,98.64,99.32,"300"],[133,145,99.32,100.34,"kvadratmeter"],[146,148,100.6,100.7,"og"],[149,152,100.7,100.88,"har"],[153,156,100.88,101.22,"tre"],[157,164,101.22,101.92,"etasjer"],[166,169,102.76,102.88,"det"],[170,172,102.88,103.0,"er"],[173,179,103.0,103.38,"veldig"],[180,187,103.38,104.06,"moderne"],[189,192,104.36,104.48,"for~1b22712a94b1"],[193,195,104.48,104.64,"de"],[196,202,104.64,104.98,"pusset~a5924599ef6a"],[203,206,104.98,105.16,"opp~10d7fedbe51f"],[207,208,105.16,105.26,"i~e809b2e9b139"],[209,213,105.26,105.6,"fjor"]]},{"id":8,"start":106.9,"end":126.24,"text":"Familien har bodd der i mange år, men jeg har bare bodd der i fem måneder. Vi har ei koselig stue. I stua har vi en deilig og myk sofa foran en stor tv. Kjøkkenet er lyst og fint, og det er fem soverom i huset.","speaker":"Viola","zh":"这家人在那里住了很多年，但我在那里才住了五个月。我们有一个温馨的客厅。客厅里，一台大电视前面放着一张舒服柔软的沙发。厨房明亮漂亮，房子里有五间卧室。","words":[[0,8,106.96,107.54,"familien"],[9,12,107.54,107.68,"har~8b9792170cca"],[13,17,107.68,107.88,"bodd"],[18,21,107.88,108.06,"der"],[22,23,108.06,108.16,"i~c0bbfa552007"],[24,29,108.16,108.52,"mange"],[30,32,108.52,108.96,"år"],[34,37,109.36,109.5,"men"],[38,41,109.5,109.74,"jeg"],[42,45,109.74,109.88,"har~8b9792170cca"],[46,50,109.88,110.14,"bare"],[51,55,110.14,110.34,"bodd"],[56,59,110.34,110.76,"der"],[60,61,110.76,110.9,"i~b1bf51b6020a"],[62,65,110.9,111.12,"fem"],[66,73,111.12,111.76,"måneder"],[75,77,112.92,113.04,"vi"],[78,81,113.04,113.2,"har"],[82,84,113.2,113.42,"ei~47aa2d18e376"],[85,92,113.42,113.96,"koselig"],[93,97,113.96,114.52,"stue"],[99,100,115.34,115.46,"i"],[101,105,115.46,116.04,"stua"],[106,109,116.28,116.44,"har"],[110,112,116.44,116.58,"vi"],[113,115,116.58,116.74,"en~a939a9e56dc5"],[116,122,116.74,117.24,"deilig~a40a3aeaf456"],[123,125,117.24,117.38,"og"],[126,129,117.38,117.72,"myk"],[130,134,117.72,118.28,"sofa"],[135,140,118.4,118.74,"foran~d09b0d7b7ee2"],[141,143,118.74,118.98,"en~a939a9e56dc5"],[144,148,118.98,119.34,"stor"],[149,151,119.34,119.84,"tv"],[153,162,121.16,121.84,"kjøkkenet"],[163,165,121.94,122.1,"er"],[166,170,122.1,122.7,"lyst~a771b91023dc"],[171,173,122.7,122.86,"og"],[174,178,122.86,123.5,"fint"],[180,182,124.06,124.34,"og"],[183,186,124.34,124.48,"det"],[187,189,124.48,124.74,"er"],[190,193,124.74,125.14,"fem"],[194,201,125.14,125.66,"soverom"],[202,203,125.66,125.76,"i"],[204,209,125.76,126.09,"huset"]]},{"id":9,"start":127.27,"end":141.24,"text":"Soverommene er i andre etasje. Rommene til barna er små, men jeg har et stort rom. På rommet har jeg et lite skrivebord, en tv og en blå sofa.","speaker":"Viola","zh":"卧室在二楼。孩子们的房间很小，但我有一个大房间。我的房间里有一张小书桌、一台电视和一张蓝色沙发。","words":[[0,11,127.33,128.24,"soverommene"],[12,14,128.46,128.6,"er"],[15,16,128.6,128.74,"i"],[17,22,128.74,129.08,"andre~bb01123fb98a"],[23,29,129.08,129.68,"etasje"],[31,38,131.02,131.44,"rommene"],[39,42,131.44,131.62,"til~8de1a9181f86"],[43,48,131.62,132.04,"barna"],[49,51,132.04,132.22,"er"],[52,55,132.22,132.62,"små"],[57,60,133.12,133.3,"men"],[61,64,133.3,133.52,"jeg"],[65,68,133.52,133.7,"har"],[69,71,133.7,133.88,"et~054dde72f37b"],[72,77,133.88,134.26,"stort"],[78,81,134.26,134.62,"rom"],[83,85,136.18,136.3,"på"],[86,92,136.3,136.84,"rommet"],[93,96,136.98,137.14,"har"],[97,100,137.14,137.32,"jeg"],[101,103,137.32,137.46,"et~054dde72f37b"],[104,108,137.46,137.82,"lite"],[109,119,137.82,138.72,"skrivebord"],[121,123,139.12,139.32,"en~a939a9e56dc5"],[124,126,139.32,139.9,"tv"],[127,129,140.2,140.32,"og"],[130,132,140.32,140.42,"en~a939a9e56dc5"],[133,136,140.42,140.7,"blå"],[137,141,140.7,141.09,"sofa"]]},{"id":10,"start":149.93,"end":151.09,"text":"Sammendrag","subheading":true,"zh":"摘要","words":[[0,10,149.99,150.94,"sammendrag"]]},{"id":11,"start":152.17,"end":157.88,"text":"Viola og Biniam er på språkkafeen på biblioteket og snakker norsk.","zh":"维奥拉和比尼亚姆在图书馆的语言咖啡馆里说挪威语。","words":[[0,5,152.23,152.98,"viola"],[6,8,152.98,153.2,"og"],[9,15,153.2,153.86,"biniam"],[16,18,153.86,154.16,"er"],[19,21,154.16,154.44,"på"],[22,33,154.44,155.5,"språkkafeen"],[34,36,155.5,155.72,"på"],[37,48,155.72,156.76,"biblioteket"],[49,51,156.76,156.88,"og"],[52,59,156.88,157.26,"snakker"],[60,65,157.26,157.73,"norsk~4de5d75feae1"]]},{"id":12,"start":158.72,"end":162.09,"text":"I dag snakker de om bolig med ei eldre dame.","zh":"今天他们和一位上了年纪的女士谈论住房。","words":[[0,1,158.78,158.98,"i"],[2,5,158.98,159.38,"dag"],[6,13,159.38,159.72,"snakker"],[14,16,159.72,159.88,"de"],[17,19,159.88,160.02,"om~52c0bdc828db"],[20,25,160.02,160.59,"bolig"],[26,29,160.84,160.98,"med"],[30,32,160.98,161.18,"ei~47aa2d18e376"],[33,38,161.18,161.56,"eldre"],[39,43,161.56,161.94,"dame"]]},{"id":13,"start":163.15,"end":168.95,"text":"Hun bodde i en enebolig før, men nå bor hun i en liten leilighet.","zh":"她以前住在一栋独栋住宅里，但现在她住在一套小公寓里。","words":[[0,3,163.21,163.52,"hun"],[4,9,163.52,163.86,"bodde"],[10,11,163.86,164.0,"i"],[12,14,164.0,164.22,"en~a939a9e56dc5"],[15,23,164.22,165.04,"enebolig"],[24,27,165.04,165.48,"før~f9c047e06941"],[29,32,165.82,166.04,"men"],[33,35,166.04,166.36,"nå~d531d47a7712"],[36,39,166.7,166.98,"bor"],[40,43,166.98,167.26,"hun"],[44,45,167.26,167.38,"i"],[46,48,167.38,167.54,"en~a939a9e56dc5"],[49,54,167.54,168.02,"liten"],[55,64,168.02,168.8,"leilighet"]]},{"id":14,"start":169.87,"end":176.66,"text":"Biniam leier en gammel leilighet, men han har lyst til å flytte, for han trives ikke der.","zh":"比尼亚姆租了一套旧公寓，但他想搬家，因为他在那里住得不舒心。","words":[[0,6,169.93,170.72,"biniam"],[7,12,170.72,171.22,"leier~cf28fde32c3d"],[13,15,171.22,171.4,"en~a939a9e56dc5"],[16,22,171.4,171.78,"gammel"],[23,32,171.78,172.59,"leilighet"],[34,37,172.94,173.28,"men"],[38,41,173.28,173.5,"han"],[42,45,173.5,173.64,"har"],[46,50,173.64,173.92,"lyst~868273f22b73"],[51,54,173.92,174.08,"til~99ccdd3453b0"],[55,56,174.08,174.18,"å~0583da7a620a"],[57,63,174.18,174.78,"flytte"],[65,68,175.08,175.28,"for~1b22712a94b1"],[69,72,175.28,175.56,"han"],[73,79,175.56,176.02,"trives"],[80,84,176.02,176.22,"ikke"],[85,88,176.22,176.5,"der"]]},{"id":15,"start":177.69,"end":182.19,"text":"Viola bor i en stor enebolig sammen med en norsk familie.","zh":"维奥拉和一个挪威家庭一起住在一栋很大的独栋住宅里。","words":[[0,5,177.75,178.52,"viola"],[6,9,178.52,178.76,"bor"],[10,11,178.76,178.86,"i"],[12,14,178.86,179.06,"en~a939a9e56dc5"],[15,19,179.06,179.6,"stor"],[20,28,179.6,180.42,"enebolig"],[29,35,180.42,180.78,"sammen"],[36,39,180.78,180.96,"med"],[40,42,180.96,181.12,"en~a939a9e56dc5"],[43,48,181.12,181.48,"norsk~300c0d0c4f59"],[49,56,181.48,182.04,"familie"]]},{"id":16,"start":182.76,"end":186.22,"text":"Hun har et stort rom der og trives veldig godt.","zh":"她在那里有一个大房间，过得非常舒心。","words":[[0,3,182.82,183.04,"hun"],[4,7,183.04,183.24,"har"],[8,10,183.24,183.4,"et~054dde72f37b"],[11,16,183.4,183.78,"stort"],[17,20,183.78,184.02,"rom"],[21,24,184.02,184.42,"der"],[25,27,184.6,184.76,"og"],[28,34,184.76,185.32,"trives"],[35,41,185.32,185.66,"veldig"],[42,46,185.66,186.06,"godt~28a24c509f3c"]]},{"id":17,"start":190.06,"end":190.83,"text":"Fakta","subheading":true,"zh":"小知识","words":[[0,5,190.12,190.68,"fakta"]]},{"id":18,"start":192.1,"end":193.53,"text":"Boliger i Norge","subheading":true,"zh":"挪威的住房","words":[[0,7,192.16,192.8,"boliger"],[8,9,192.8,192.92,"i"],[10,15,192.92,193.38,"norge~546b56e35dd5"]]},{"id":19,"start":195.0,"end":198.02,"text":"Det er vanlig å eie egen bolig i Norge.","zh":"在挪威，拥有自己的住房是很普遍的。","words":[[0,3,195.06,195.2,"det"],[4,6,195.2,195.36,"er"],[7,13,195.36,195.8,"vanlig"],[14,15,195.8,195.98,"å~0583da7a620a"],[16,19,195.98,196.38,"eie"],[20,24,196.38,196.84,"egen"],[25,30,196.84,197.38,"bolig"],[31,32,197.38,197.48,"i"],[33,38,197.48,197.87,"norge~546b56e35dd5"]]},{"id":20,"start":199.02,"end":203.91,"text":"Nordmenn tar ofte kontakt med banken for å få lån til å kjøpe bolig.","zh":"挪威人常常联系银行，以获得贷款来买房。","words":[[0,8,199.08,199.74,"nordmenn"],[9,12,199.74,200.12,"tar~02e1bdd0ce18"],[13,17,200.12,200.48,"ofte"],[18,25,200.48,200.98,"kontakt"],[26,29,200.98,201.14,"med"],[30,36,201.14,201.82,"banken"],[37,40,201.82,201.98,"for~eb8cd4a9a3ad"],[41,42,201.98,202.08,"å~0583da7a620a"],[43,45,202.08,202.26,"få~65b84e08cd43"],[46,49,202.26,202.72,"lån"],[50,53,202.72,202.9,"til~8aee8aba5922"],[54,55,202.9,203.0,"å~0583da7a620a"],[56,61,203.0,203.4,"kjøpe"],[62,67,203.4,203.75,"bolig"]]},{"id":21,"start":204.95,"end":209.68,"text":"Noen kjøper leilighet, og noen kjøper enebolig.","zh":"有些人买公寓，有些人买独栋住宅。","words":[[0,4,205.01,205.7,"noen~8e23a4fd3f2f"],[5,11,205.7,206.24,"kjøper"],[12,21,206.24,207.14,"leilighet"],[23,25,207.5,207.76,"og"],[26,30,207.76,208.4,"noen~8e23a4fd3f2f"],[31,37,208.4,208.88,"kjøper"],[38,46,208.88,209.53,"enebolig"]]},{"id":22,"start":210.58,"end":217.61,"text":"I byene bor mange i leiligheter, men på små steder er det vanlig å bo i enebolig.","zh":"在城市里，很多人住公寓，但在小地方，住独栋住宅很普遍。","words":[[0,1,210.64,210.84,"i"],[2,7,210.84,211.36,"byene"],[8,11,211.36,211.7,"bor"],[12,17,211.7,212.18,"mange"],[18,19,212.18,212.3,"i"],[20,31,212.3,213.18,"leiligheter"],[33,36,213.62,213.84,"men"],[37,39,213.84,214.06,"på"],[40,43,214.06,214.4,"små"],[44,50,214.4,215.06,"steder"],[51,53,215.4,215.5,"er"],[54,57,215.5,215.66,"det"],[58,64,215.66,216.18,"vanlig"],[65,66,216.18,216.3,"å~0583da7a620a"],[67,69,216.3,216.6,"bo"],[70,71,216.6,216.76,"i"],[72,80,216.76,217.46,"enebolig"]]},{"id":23,"start":218.62,"end":224.92,"text":"Mange eneboliger har en leilighet i kjelleren, og den kan huseier leie ut til andre.","zh":"很多独栋住宅的地下室里有一套公寓，房主可以把它租给别人。","words":[[0,5,218.68,219.12,"mange"],[6,16,219.12,219.96,"eneboliger"],[17,20,219.96,220.16,"har"],[21,23,220.16,220.34,"en~a939a9e56dc5"],[24,33,220.34,220.98,"leilighet"],[34,35,220.98,221.08,"i"],[36,45,221.08,221.68,"kjelleren"],[47,49,222.0,222.24,"og"],[50,53,222.24,222.62,"den"],[54,57,222.62,222.88,"kan"],[58,65,222.88,223.54,"huseier"],[66,70,223.54,223.96,"leie~98b2d7497efd"],[71,73,223.96,224.2,"ut~7d11fd252301"],[74,77,224.2,224.4,"til"],[78,83,224.4,224.77,"andre~dea7bdd3277b"]]}],"lexicon":{"300":{"lemma":"300","zh":"数字 300","pos":"数词","ref":null,"clip":null,"kind":"number"},"35":{"lemma":"35","zh":"数字 35","pos":"数词","ref":"basics:numbers:trettifem","clip":null,"kind":"number"},"9.1":{"lemma":"9.1","zh":"第 9.1 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"andre":{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre","clip":"pronunciation/bd01b0b648c2c64eb1bd.mp3","ambiguous":true,"candidates":[{"lemma":"andre","zh":"其他的；别的（annen 的复数）；第二","pos":"代词／序数词","ref":"basics:ordinals:andre"},{"lemma":"andre","zh":"第二","pos":"序数词","ref":"basics:ordinals:andre"},{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式"}]},"au":{"lemma":"au pair","zh":"（au pair）互惠生","pos":"名词","ref":null,"clip":null},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26b