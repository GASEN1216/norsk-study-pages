{"id":"ty-conversation-5.2","bookId":"ty-conversation-guide","readingId":"5.2","title":"Room service at the hotel","audio":"audio/ty-conversation/5.2.mp3","duration":47.124917,"synthetic":false,"sentences":[{"id":0,"start":7.22,"end":10.54,"speaker":"Receptionist 1","text":"Restauranten. Kan jeg hjelpe deg?","zh":"这里是餐厅。有什么可以帮你的吗？","words":[[0,12,7.22,8.14,"restauranten"],[14,17,8.52,8.98,"kan"],[18,21,8.98,9.36,"jeg"],[22,28,9.36,10.06,"hjelpe"],[29,32,10.06,10.54,"deg"]]},{"id":1,"start":10.98,"end":16.4,"speaker":"Olav","text":"Det er Olav Berg i rom 236.","zh":"我是 236 号房的奥拉夫·贝格。","words":[[0,3,10.98,11.12,"det@ty-phone"],[4,6,11.12,11.72,"er@ty-be-identity"],[7,11,11.72,12.58,"olav"],[12,16,12.58,13.0,"berg"],[17,18,13.0,13.72,"i@ty-place"],[19,22,13.72,14.36,"rom"],[23,26,14.36,16.4,"236@ty-number-236"]]},{"id":2,"start":16.82,"end":19.44,"speaker":"Olav","text":"Jeg vil gjerne bestille mat.","zh":"我想订餐。","words":[[0,3,16.82,17.2,"jeg"],[4,7,17.2,17.52,"vil"],[8,14,17.52,18.16,"gjerne"],[15,23,18.16,18.82,"bestille"],[24,27,18.82,19.44,"mat"]]},{"id":3,"start":19.86,"end":21.3,"speaker":"Receptionist 1","text":"Et øyeblikk.","zh":"请稍等。","words":[[0,2,19.86,20.14,"et"],[3,11,20.14,21.3,"øyeblikk"]]},{"id":4,"start":21.8,"end":26.62,"speaker":"Olav","text":"Jeg vil gjerne ha mat til rom 236.","zh":"我想请你们送餐到 236 号房。","words":[[0,3,21.8,22.0,"jeg"],[4,7,22.0,22.28,"vil"],[8,14,22.28,22.84,"gjerne"],[15,17,22.84,23.06,"ha@ty-want-food"],[18,21,23.06,23.66,"mat"],[22,25,23.66,24.06,"til"],[26,29,24.06,24.6,"rom"],[30,33,24.6,26.62,"236@ty-number-236"]]},{"id":5,"start":26.72,"end":28.08,"speaker":"Receptionist 2","text":"Hva skal vi sende?","zh":"您想让我们送些什么？","words":[[0,3,26.72,27.16,"hva"],[4,8,27.16,27.52,"skal"],[9,11,27.52,27.76,"vi"],[12,17,27.76,28.08,"sende"]]},{"id":6,"start":28.8,"end":33.08,"speaker":"Olav","text":"Jeg vil gjerne ha en omelett med asparges.","zh":"我想要一份芦笋煎蛋卷。","words":[[0,3,28.8,29.26,"jeg"],[4,7,29.26,29.52,"vil"],[8,14,29.52,29.98,"gjerne"],[15,17,29.98,30.66,"ha@ty-want-food"],[18,20,30.66,31.04,"en"],[21,28,31.04,31.88,"omelett"],[29,32,31.88,32.4,"med@ty-with-ingredient"],[33,41,32.4,33.08,"asparges"]]},{"id":7,"start":33.68,"end":39.92,"speaker":"Olav","text":"Jeg vil gjerne ha et glass rødvin og en flaske mineralvann.","zh":"我还想要一杯红葡萄酒和一瓶矿泉水。","words":[[0,3,33.68,33.98,"jeg"],[4,7,34.06,34.32,"vil"],[8,14,34.32,35.28,"gjerne"],[15,17,35.28,35.52,"ha@ty-want-drink"],[18,20,35.52,35.72,"et"],[21,26,35.72,36.0,"glass"],[27,33,36.0,36.56,"rødvin"],[34,36,37.62,37.8,"og"],[37,39,37.8,38.06,"en"],[40,46,38.06,38.82,"flaske"],[47,58,38.82,39.92,"mineralvann"]]},{"id":8,"start":40.4,"end":41.8,"speaker":"Olav","text":"Og brød og smør.","zh":"还有面包和黄油。","words":[[0,2,40.4,40.62,"og"],[3,7,40.62,40.86,"brød"],[8,10,40.86,41.06,"og"],[11,15,41.06,41.8,"smør"]]},{"id":9,"start":42.14,"end":45.86,"speaker":"Receptionist 2","text":"OK. Maten kommer om tjue minutter.","zh":"好的。餐点 20 分钟后送到。","words":[[0,2,42.14,42.34,"ok"],[4,9,43.26,43.78,"maten"],[10,16,43.78,44.14,"kommer@ty-food-arrival"],[17,19,44.14,44.64,"om@ty-time-after"],[20,24,44.64,45.14,"tjue"],[25,33,45.14,45.86,"minutter"]]},{"id":10,"start":46.12,"end":46.56,"speaker":"Olav","text":"Takk.","zh":"谢谢。","words":[[0,4,46.12,46.56,"takk"]]}],"lexicon":{"236":{"lemma":"236","zh":"二百三十六（房间号）","pos":"数词","ref":null,"clip":null},"236@ty-number-236":{"lemma":"236","zh":"二百三十六（房间号）","pos":"数词","ref":null,"clip":null,"contextual":true,"baseKey":"236","surface":"236"},"asparges":{"lemma":"asparges","zh":"芦笋","pos":"名词","ref":"ty-conversation-5-003","clip":null},"berg":{"lemma":"Berg","zh":"贝格（姓氏）","pos":"专名","ref":null,"clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"brød":{"lemma":"brød","zh":"面包","pos":"名词","ref":"ty-conversation-5-005","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos