{"id":"ty-conversation-5.2","bookId":"ty-conversation-guide","readingId":"5.2","title":"Room service at the hotel","audio":"audio/ty-conversation/5.2.mp3","duration":47.124917,"synthetic":false,"sentences":[{"id":0,"start":7.27,"end":10.275,"speaker":"Receptionist 1","text":"Restauranten. Kan jeg hjelpe deg?","zh":"这里是餐厅。有什么可以帮你的吗？","words":[[0,12,7.27,8.015,"restauranten"],[14,17,8.53,8.775,"kan"],[18,21,9.03,9.255,"jeg"],[22,28,9.35,9.835,"hjelpe"],[29,32,10.07,10.275,"deg"]]},{"id":1,"start":10.93,"end":16.255,"speaker":"Olav","text":"Det er Olav Berg i rom 236.","zh":"我是 236 号房的奥拉夫·贝格。","words":[[0,3,10.93,11.115,"det@ty-phone"],[4,6,11.17,11.415,"er@ty-be-identity"],[7,11,11.79,12.335,"olav"],[12,16,12.51,12.915,"berg"],[17,18,13.49,13.595,"i@ty-place"],[19,22,13.63,13.855,"rom"],[23,26,14.43,16.255,"236@ty-number-236"]]},{"id":2,"start":16.95,"end":19.355,"speaker":"Olav","text":"Jeg vil gjerne bestille mat.","zh":"我想订餐。","words":[[0,3,16.95,17.172,"jeg"],[4,7,17.172,17.355,"vil"],[8,14,17.47,17.895,"gjerne"],[15,23,18.11,18.715,"bestille"],[24,27,18.89,19.355,"mat"]]},{"id":3,"start":19.81,"end":20.875,"speaker":"Receptionist 1","text":"Et øyeblikk.","zh":"请稍等。","words":[[0,2,19.81,20.055,"et"],[3,11,20.29,20.875,"øyeblikk"]]},{"id":4,"start":21.75,"end":26.555,"speaker":"Olav","text":"Jeg vil gjerne ha mat til rom 236.","zh":"我想请你们送餐到 236 号房。","words":[[0,3,21.75,21.955,"jeg"],[4,7,21.97,22.155,"vil"],[8,14,22.23,22.655,"gjerne"],[15,17,22.85,22.995,"ha@ty-want-food"],[18,21,23.07,23.515,"mat"],[22,25,23.77,23.975,"til"],[26,29,24.05,24.255,"rom"],[30,33,24.73,26.555,"236@ty-number-236"]]},{"id":5,"start":26.67,"end":28.055,"speaker":"Receptionist 2","text":"Hva skal vi sende?","zh":"您想让我们送些什么？","words":[[0,3,26.67,26.855,"hva"],[4,8,27.19,27.435,"skal"],[9,11,27.49,27.635,"vi"],[12,17,27.69,28.055,"sende"]]},{"id":6,"start":29.03,"end":33.115,"speaker":"Olav","text":"Jeg vil gjerne ha en omelett med asparges.","zh":"我想要一份芦笋煎蛋卷。","words":[[0,3,29.03,29.233,"jeg"],[4,7,29.233,29.415,"vil"],[8,14,29.47,29.875,"gjerne"],[15,17,30.45,30.615,"ha@ty-want-food"],[18,20,30.77,31.055,"en"],[21,28,31.25,31.875,"omelett"],[29,32,32.27,32.422,"med@ty-with-ingredient"],[33,41,32.422,33.115,"asparges"]]},{"id":7,"start":33.87,"end":39.575,"speaker":"Olav","text":"Jeg vil gjerne ha et glass rødvin og en flaske mineralvann.","zh":"我还想要一杯红葡萄酒和一瓶矿泉水。","words":[[0,3,33.87,34.053,"jeg"],[4,7,34.053,34.215,"vil"],[8,14,34.25,34.675,"gjerne"],[15,17,35.33,35.475,"ha@ty-want-drink"],[18,20,35.49,35.642,"et"],[21,26,35.642,35.955,"glass"],[27,33,36.01,36.535,"rødvin"],[34,36,37.47,37.595,"og"],[37,39,37.67,37.915,"en"],[40,46,37.97,38.515,"flaske"],[47,58,38.77,39.575,"mineralvann"]]},{"id":8,"start":40.29,"end":41.235,"speaker":"Olav","text":"Og brød og smør.","zh":"还有面包和黄油。","words":[[0,2,40.29,40.435,"og"],[3,7,40.45,40.755,"brød"],[8,10,40.81,40.935,"og"],[11,15,40.95,41.235,"smør"]]},{"id":9,"start":41.99,"end":45.675,"speaker":"Receptionist 2","text":"OK. Maten kommer om tjue minutter.","zh":"好的。餐点 20 分钟后送到。","words":[[0,2,41.99,42.255,"ok"],[4,9,43.19,43.635,"maten"],[10,16,43.73,44.155,"kommer@ty-food-arrival"],[17,19,44.25,44.435,"om@ty-time-after"],[20,24,44.65,45.035,"tjue"],[25,33,45.23,45.675,"minutter"]]},{"id":10,"start":46.03,"end":46.355,"speaker":"Olav","text":"Takk.","zh":"谢谢。","words":[[0,4,46.03,46.355,"takk"]]}],"lexicon":{"236":{"lemma":"236","zh":"二百三十六（房间号）","pos":"数词","ref":null,"clip":null},"236@ty-number-236":{"lemma":"236","zh":"二百三十六（房间号）","pos":"数词","ref":null,"clip":null,"contextual":true,"baseKey":"236","surface":"236"},"asparges":{"lemma":"asparges","zh":"芦笋","pos":"名词","ref":"ty-conversation-5-003","clip":null},"berg":{"lemma":"Berg","zh":"贝格（姓氏）","pos":"专名","ref":null,"clip":null},"bestille":{"lemma":"bestille","zh":"订（餐）","pos":"动词","ref":"ty-conversation-5-004","clip":null,"form":"不定式"},"brød":{"lemma":"brød","zh":"面包","pos":"名词","ref":"ty-conversation-5-005","clip":null},"deg":{"lemma":"du","zh":"你（宾格）",