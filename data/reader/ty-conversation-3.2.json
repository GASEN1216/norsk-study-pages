{"id":"ty-conversation-3.2","bookId":"ty-conversation-guide","readingId":"3.2","title":"Going to a café","audio":"audio/ty-conversation/3.2.mp3","duration":29.649,"synthetic":false,"sentences":[{"id":0,"start":0.0,"end":2.68,"speaker":"Olav","text":"Jeg er sulten.","zh":"我饿了。","words":[[0,3,0.0,1.12,"jeg"],[4,6,1.12,1.76,"er@ty-be-state"],[7,13,1.76,2.68,"sulten"]]},{"id":1,"start":2.72,"end":4.7,"speaker":"Eva","text":"Og jeg er tørst.","zh":"我口渴了。","words":[[0,2,2.72,3.06,"og"],[3,6,3.06,3.52,"jeg"],[7,9,3.52,4.0,"er@ty-be-state"],[10,15,4.0,4.7,"tørst"]]},{"id":2,"start":5.22,"end":8.8,"speaker":"Olav","text":"Jeg vil gjerne ha et smørbrød.","zh":"我想要一个开放式三明治。","words":[[0,3,5.22,5.52,"jeg"],[4,7,5.52,5.86,"vil"],[8,14,5.86,6.86,"gjerne"],[15,17,6.86,7.2,"ha@ty-want-food"],[18,20,7.2,7.58,"et"],[21,29,7.58,8.8,"smørbrød"]]},{"id":3,"start":8.88,"end":11.68,"speaker":"Olav","text":"Et smørbrød med røkelaks.","zh":"一个烟熏三文鱼三明治。","words":[[0,2,8.88,9.24,"et"],[3,11,9.24,10.52,"smørbrød"],[12,15,10.52,10.74,"med@ty-with-ingredient"],[16,24,10.74,11.68,"røkelaks"]]},{"id":4,"start":12.38,"end":15.54,"speaker":"Eva","text":"Jeg vil gjerne ha et wienerbrød.","zh":"我想要一个丹麦酥。","words":[[0,3,12.38,12.74,"jeg"],[4,7,12.74,13.0,"vil"],[8,14,13.0,13.66,"gjerne"],[15,17,13.66,13.94,"ha@ty-want-food"],[18,20,13.94,14.3,"et"],[21,31,14.3,15.54,"wienerbrød"]]},{"id":5,"start":15.68,"end":17.04,"speaker":"Olav","text":"Vil du ha kaffe?","zh":"你要喝咖啡吗？","words":[[0,3,15.68,15.94,"vil"],[4,6,15.94,16.34,"du"],[7,9,16.34,16.62,"ha@ty-want-drink"],[10,15,16.62,17.04,"kaffe"]]},{"id":6,"start":17.82,"end":21.32,"speaker":"Eva","text":"Nei takk, jeg vil heller ha te.","zh":"不了，谢谢。我更想喝茶。","words":[[0,3,17.82,18.36,"nei"],[4,8,18.42,19.14,"takk"],[10,13,19.22,19.58,"jeg"],[14,17,19.58,19.86,"vil"],[18,24,19.86,20.42,"heller"],[25,27,20.42,20.84,"ha@ty-want-drink"],[28,30,20.84,21.32,"te"]]},{"id":7,"start":21.96,"end":23.86,"speaker":"Eva","text":"Jeg liker ikke kaffe.","zh":"我不喜欢咖啡。","word