{"id":"ty-conversation-3.2","bookId":"ty-conversation-guide","readingId":"3.2","title":"Going to a café","audio":"audio/ty-conversation/3.2.mp3","duration":29.649,"synthetic":false,"sentences":[{"id":0,"start":0.74,"end":2.305,"speaker":"Olav","text":"Jeg er sulten.","zh":"我饿了。","words":[[0,3,0.74,1.005,"jeg"],[4,6,1.36,1.605,"er@ty-be-state"],[7,13,1.72,2.305,"sulten"]]},{"id":1,"start":2.8,"end":4.425,"speaker":"Eva","text":"Og jeg er tørst.","zh":"我口渴了。","words":[[0,2,2.8,2.925,"og"],[3,6,3.0,3.245,"jeg"],[7,9,3.64,3.785,"er@ty-be-state"],[10,15,3.88,4.425,"tørst"]]},{"id":2,"start":5.2,"end":8.065,"speaker":"Olav","text":"Jeg vil gjerne ha et smørbrød.","zh":"我想要一个开放式三明治。","words":[[0,3,5.2,5.445,"jeg"],[4,7,5.5,5.685,"vil"],[8,14,5.8,6.325,"gjerne"],[15,17,6.96,7.105,"ha@ty-want-food"],[18,20,7.22,7.425,"et"],[21,29,7.48,8.065,"smørbrød"]]},{"id":3,"start":8.92,"end":11.565,"speaker":"Olav","text":"Et smørbrød med røkelaks.","zh":"一个烟熏三文鱼三明治。","words":[[0,2,8.92,9.145,"et"],[3,11,9.24,9.945,"smørbrød"],[12,15,10.5,10.662,"med@ty-with-ingredient"],[16,24,10.662,11.565,"røkelaks"]]},{"id":4,"start":12.33,"end":14.915,"speaker":"Eva","text":"Jeg vil gjerne ha et wienerbrød.","zh":"我想要一个丹麦酥。","words":[[0,3,12.33,12.555,"jeg"],[4,7,12.73,12.915,"vil"],[8,14,12.95,13.355,"gjerne"],[15,17,13.65,13.795,"ha@ty-want-food"],[18,20,13.95,14.135,"et"],[21,31,14.23,14.915,"wienerbrød"]]},{"id":5,"start":15.67,"end":16.955,"speaker":"Olav","text":"Vil du ha kaffe?","zh":"你要喝咖啡吗？","words":[[0,3,15.67,15.835,"vil"],[4,6,15.91,16.055,"du"],[7,9,16.37,16.495,"ha@ty-want-drink"],[10,15,16.55,16.955,"kaffe"]]},{"id":6,"start":17.83,"end":21.035,"speaker":"Eva","text":"Nei takk, jeg vil heller ha te.","zh":"不了，谢谢。我更想喝茶。","words":[[0,3,17.83,18.055,"nei"],[4,8,18.29,18.575,"takk"],[10,13,19.33,19.535,"jeg"],[14,17,19.57,19.735,"vil"],[18,24,19.79,20.195,"heller"],[25,27,20.53,20.655,"ha@ty-want-drink"],[28,30,20.81,21.035,"te"]]},{"id":7,"start":22.07,"end":23.655,"speaker":"Eva","text":"Jeg liker ikke kaffe.","zh":"我不喜欢咖啡。","words":[[0,3,22.07,22.275,"jeg"],[4,9,22.55,22.935,"liker"],[10,14,22.97,23.295,"ikke"],[15,20,23.31,23.655,"kaffe"]]},{"id":8,"start":24.61,"end":25.975,"speaker":"Olav","text":"Jeg liker kaffe.","zh":"我喜欢咖啡。","words":[[0,3,24.61,24.895,"jeg"],[4,9,25.13,25.555,"liker"],[10,15,25.59,25.975,"kaffe"]]},{"id":9,"start":26.91,"end":29.075,"speaker":"Olav","text":"Jeg vil gjerne ha kaffe.","zh":"我想喝咖啡。","words":[[0,3,26.91,27.135,"jeg"],[4,7,27.15,27.315,"vil"],[8,14,27.39,27.835,"gjerne"],[15,17,27.95,28.095,"ha@ty-want-drink"],[18,23,28.73,29.075,"kaffe"]]}],"lexicon":{"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-state":{"lemma":"være","zh":"处于（饥饿、生病、度假等状态）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"et":{"lemma":"et","zh":"一个（用于中性名词）","pos":"不定冠词","ref":"ty-conversation-3-001","clip":null,"form":"中性"},"gjerne":{"lemma":"gjerne","zh":"乐意（vil gjerne：想要）","pos":"副词","ref":"3-081","clip":null},"ha":{"lemma":"ha","zh":"有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"不定式"},"ha@ty-want-drink":{"lemma":"ha","zh":"喝（某种饮品）","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"不定式","contextual":true,"baseKey":"ha","surface":"ha"},"ha@ty-want-food":{"lemma":"ha","zh":"要（某种食物）","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"不定式","contextual":true,"baseKey":"ha","surface":"ha"},"heller":{"lemma":"heller","zh":"更愿意（vil heller：更想）","pos":"副词","ref":null,"clip":null},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-016","clip":null},"jeg":{"lemma":"jeg","zh":"我","pos":"代词","ref":"ty-conversation-1-018","clip":null,"form":"主格"},"kaffe":{"lemma":"kaffe","zh":"咖啡","pos":"名词","ref":"ty-conversation-3-005","clip":null},"liker":{"lemma":"like","zh":"喜欢","p