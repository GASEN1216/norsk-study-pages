{"id":"7.4","title":"Går denne bussen til Førde?","audio":"audio/7.4.mp3","duration":165.54,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.82,"text":"7.4 Går denne bussen til Førde?","heading":true,"zh":"7.4 这辆公交车去弗尔德吗？","words":[[0,3,0.15,1.23,"7.4"],[4,7,2.74,3.0,"går~f010b28fdfbc"],[8,13,3.0,3.54,"denne"],[14,20,3.54,3.94,"bussen"],[21,24,3.94,4.1,"til"],[25,30,4.1,4.74,"førde"]]},{"id":1,"start":6.74,"end":8.74,"text":"Marit er på busstasjonen.","zh":"玛丽特在汽车站。","words":[[0,5,6.82,7.32,"marit"],[6,8,7.32,7.62,"er"],[9,11,7.62,7.82,"på"],[12,24,7.82,8.66,"busstasjonen"]]},{"id":2,"start":9.71,"end":12.32,"text":"Hun skal besøke ei venninne i Førde.","zh":"她要去弗尔德看望一位女性朋友。","words":[[0,3,9.79,10.05,"hun"],[4,8,10.05,10.31,"skal"],[9,15,10.31,10.89,"besøke"],[16,18,10.89,11.11,"ei~47aa2d18e376"],[19,27,11.11,11.53,"venninne"],[28,29,11.53,11.69,"i"],[30,35,11.69,12.24,"førde"]]},{"id":3,"start":13.35,"end":17.19,"text":"Hun vil ta buss, for det er langt å kjøre bil alene.","zh":"她想坐公交车去，因为一个人开车去路很远。","words":[[0,3,13.43,13.6,"hun"],[4,7,13.6,13.78,"vil"],[8,10,13.78,13.98,"ta"],[11,15,13.98,14.62,"buss"],[17,20,14.8,15.0,"for~1b22712a94b1"],[21,24,15.0,15.14,"det"],[25,27,15.14,15.22,"er"],[28,33,15.22,15.74,"langt~d19f6c81bf73"],[34,35,15.74,15.86,"å~0583da7a620a"],[36,41,15.86,16.08,"kjøre"],[42,45,16.08,16.42,"bil"],[46,51,16.42,17.11,"alene"]]},{"id":4,"start":17.54,"end":22.12,"text":"Hei! Går denne bussen til Førde?","speaker":"Marit","zh":"你好！这辆公交车去弗尔德吗？","words":[[0,3,19.11,19.57,"hei"],[5,8,20.05,20.29,"går~f010b28fdfbc"],[9,14,20.29,20.67,"denne"],[15,21,20.67,21.11,"bussen"],[22,25,21.11,21.31,"til"],[26,31,21.31,21.83,"førde"]]},{"id":5,"start":22.3,"end":24.77,"text":"Ja, det er riktig.","speaker":"Bussjåfør","zh":"是的，没错。","words":[[0,2,22.95,23.33,"ja"],[4,7,23.7,23.98,"det"],[8,10,23.98,24.12,"er"],[11,17,24.12,24.48,"riktig"]]},{"id":6,"start":25.53,"end":28.73,"text":"Så fint! Hvor lang tid tar turen?","speaker":"Marit","zh":"太好了！路上要多长时间？","words":[[0,2,25.53,25.75,"så~db4a353c3cdb"],[3,7,25.75,26.09,"fint"],[9,13,27.02,27.3,"hvor~8598699b9b8d"],[14,18,27.3,27.5,"lang"],[19,22,27.5,27.72,"tid"],[23,26,27.72,27.94,"tar~376c12518b59"],[27,32,27.94,28.24,"turen"]]},{"id":7,"start":29.53,"end":35.35,"text":"Det tar cirka fem og en halv time dit. Skal jeg hjelpe deg med bagasjen?","speaker":"Bussjåfør","zh":"到那儿大约要五个半小时。要我帮你拿行李吗？","words":[[0,3,29.55,29.77,"det"],[4,7,29.77,30.09,"tar~376c12518b59"],[8,13,30.09,30.55,"cirka"],[14,17,30.55,30.89,"fem"],[18,20,30.89,31.19,"og"],[21,23,31.19,31.33,"en~a939a9e56dc5"],[24,28,31.33,31.63,"halv~1969e66ac8e9"],[29,33,31.63,31.79,"time"],[34,37,31.79,32.15,"dit"],[39,43,33.01,33.41,"skal"],[44,47,33.41,33.61,"jeg"],[48,54,33.61,34.07,"hjelpe"],[55,58,34.07,34.25,"deg"],[59,62,34.25,34.43,"med"],[63,71,34.43,35.03,"bagasjen"]]},{"id":8,"start":35.87,"end":39.04,"text":"Ja takk! Jeg har ganske mye bagasje.","speaker":"Marit","zh":"好的，谢谢！我的行李挺多的。","words":[[0,2,36.04,36.34,"ja"],[3,7,36.34,36.76,"takk"],[9,12,37.12,37.26,"jeg"],[13,16,37.26,37.38,"har"],[17,23,37.38,37.82,"ganske"],[24,27,37.82,38.1,"mye~cc164d0dc3da"],[28,35,38.1,38.72,"bagasje"]]},{"id":9,"start":39.28,"end":46.9,"text":"Å! Har du alle disse veskene? Hvor mange uker skal du være borte?","speaker":"Bussjåfør","zh":"哇！这些包都是你的吗？你要出门几个星期啊？","words":[[0,1,39.95,40.23,"å~496a48c13525"],[3,6,40.89,41.13,"har"],[7,9,41.13,41.39,"du"],[10,14,41.39,41.93,"alle~6873d9584096"],[15,20,41.93,42.23,"disse"],[21,28,42.23,42.79,"veskene"],[30,34,44.02,44.32,"hvor~8598699b9b8d"],[35,40,44.32,44.72,"mange"],[41,45,44.72,45.4,"uker"],[46,50,45.4,45.64,"skal"],[51,53,45.64,45.84,"du"],[54,58,45.84,46.04,"være"],[59,64,46.04,46.5,"borte"]]},{"id":10,"start":47.44,"end":50.08,"text":"Jeg skal være der i fem dager.","speaker":"Marit","zh":"我要在那儿待五天。","words":[[0,3,47.44,48.02,"jeg"],[4,8,48.02,48.46,"skal"],[9,13,48.46,48.74,"være"],[14,17,48.74,48.94,"der"],[18,19,48.94,49.12,"i~418737c67580"],[20,23,49.12,49.38,"fem"],[24,29,49.38,49.72,"dager"]]},{"id":11,"start":50.34,"end":54.04,"text":"Ja vel. Har du billett?","speaker":"Bussjåfør","zh":"好的。你有票吗？","words":[[0,2,50.52,50.82,"ja"],[3,6,50.82,51.14,"vel~26edb5ae7c1a"],[8,11,52.32,52.96,"har"],[12,14,52.96,53.08,"du"],[15,22,53.08,53.48,"billett"]]},{"id":12,"start":54.05,"end":57.48,"text":"Ja, jeg har den på mobilen. Se her.","speaker":"Marit","zh":"有，在我手机上。你看。","words":[[0,2,54.2,54.54,"ja"],[4,7,54.8,55.02,"jeg"],[8,11,55.02,55.28,"har"],[12,15,55.28,55.42,"den"],[16,18,55.42,55.56,"på"],[19,26,55.56,56.14,"mobilen"],[28,30,56.62,56.82,"se~26e2daf31e48"],[31,34,56.82,57.04,"her"]]},{"id":13,"start":57.74,"end":61.98,"text":"Fint. Takk skal du ha. God tur!","speaker":"Bussjåfør","zh":"好的。谢谢。一路顺风！","words":[[0,4,58.0,58.46,"fint"],[6,10,59.1,59.5,"takk"],[11,15,59.5,59.66,"skal~27c1f26fdfff"],[16,18,59.66,59.8,"du"],[19,21,59.8,59.96,"ha~8e56bc8d3017"],[23,26,61.07,61.31,"god"],[27,30,61.31,61.53,"tur~add812ac29ce"]]},{"id":14,"start":62.51,"end":64.75,"text":"Tusen takk!","speaker":"Marit","zh":"非常感谢！","words":[[0,5,62.58,62.86,"tusen"],[6,10,62.86,63.2,"takk"]]},{"id":15,"start":65.13,"end":70.63,"text":"Det er mange passasjerer på bussen, og Marit prøver å finne en ledig plass.","zh":"车上乘客很多，玛丽特想找一个空座位。","words":[[0,3,65.21,65.35,"det"],[4,6,65.35,65.43,"er"],[7,12,65.43,65.77,"mange"],[13,24,65.77,66.69,"passasjerer"],[25,27,66.69,66.85,"på"],[28,34,66.85,67.23,"bussen"],[36,38,67.99,68.09,"og"],[39,44,68.09,68.59,"marit"],[45,51,68.59,68.95,"prøver~18b05bd56cd4"],[52,53,68.95,69.11,"å~0583da7a620a"],[54,59,69.11,69.41,"finne"],[60,62,69.41,69.67,"en~a939a9e56dc5"],[63,68,69.67,70.01,"ledig"],[69,74,70.01,70.55,"plass"]]},{"id":16,"start":71.77,"end":77.76,"text":"Ei ung jente sitter alene, men hun har en sekk på setet ved siden av seg.","zh":"一个年轻女孩独自坐着，但她把背包放在了旁边的座位上。","words":[[0,2,71.85,72.13,"ei~47aa2d18e376"],[3,6,72.13,72.41,"ung"],[7,12,72.41,72.99,"jente"],[13,19,72.99,73.33,"sitter"],[20,25,73.33,73.91,"alene"],[27,30,74.65,74.89,"men"],[31,34,74.89,75.23,"hun"],[35,38,75.23,75.49,"har"],[39,41,75.49,75.71,"en~a939a9e56dc5"],[42,46,75.71,76.07,"sekk"],[47,49,76.07,76.25,"på"],[50,55,76.25,76.65,"setet"],[56,59,76.65,76.83,"ved"],[60,65,76.83,77.15,"siden~68789c658db2"],[66,68,77.15,77.33,"av~38cf00d29ad7"],[69,72,77.33,77.68,"seg"]]},{"id":17,"start":78.83,"end":80.25,"text":"Marit går videre.","zh":"玛丽特继续往前走。","words":[[0,5,78.91,79.33,"marit"],[6,9,79.33,79.61,"går"],[10,16,79.61,80.17,"videre"]]},{"id":18,"start":81.27,"end":84.61,"text":"Alle setene er opptatt av folk eller bagasje.","zh":"所有座位都被人或行李占着。","words":[[0,4,81.35,81.66,"alle~6873d9584096"],[5,11,81.66,82.22,"setene"],[12,14,82.22,82.4,"er"],[15,22,82.4,82.84,"opptatt~4935a6fa3786"],[23,25,82.84,83.06,"av~f10355d3c566"],[26,30,83.06,83.4,"folk"],[31,36,83.4,83.86,"eller"],[37,44,83.86,84.53,"bagasje"]]},{"id":19,"start":85.28,"end":88.44,"text":"Hun stopper ved siden av en gutt og spør ham.","zh":"她在一个小伙子旁边停下来问他。","words":[[0,3,85.35,85.89,"hun"],[4,11,85.89,86.41,"stopper"],[12,15,86.41,86.59,"ved"],[16,21,86.59,86.87,"siden~68789c658db2"],[22,24,86.87,87.05,"av~38cf00d29ad7"],[25,27,87.05,87.21,"en~a939a9e56dc5"],[28,32,87.21,87.53,"gutt"],[33,35,87.53,87.71,"og"],[36,40,87.71,87.97,"spør"],[41,44,87.97,88.36,"ham"]]},{"id":20,"start":89.25,"end":92.0,"text":"Han har også en sekk på setet ved siden av seg.","zh":"他旁边的座位上也放着一个背包。","words":[[0,3,89.33,89.63,"han"],[4,7,89.63,89.77,"har"],[8,12,89.77,90.07,"også"],[13,15,90.07,90.27,"en~a939a9e56dc5"],[16,20,90.27,90.53,"sekk"],[21,23,90.53,90.71,"på"],[24,29,90.71,91.09,"setet"],[30,33,91.09,91.21,"ved"],[34,39,91.21,91.45,"siden~68789c658db2"],[40,42,91.45,91.63,"av~38cf00d29ad7"],[43,46,91.63,91.92,"seg"]]},{"id":21,"start":92.12,"end":95.26,"text":"Unnskyld, er det ledig her?","speaker":"Marit","zh":"请问，这里空着吗？","words":[[0,8,93.4,93.96,"unnskyld"],[10,12,94.12,94.3,"er"],[13,16,94.3,94.42,"det"],[17,22,94.42,94.78,"ledig"],[23,26,94.78,95.0,"her"]]},{"id":22,"start":95.27,"end":104.26,"text":"Ja, vær så god. Dette setet er ledig. Du kan sitte her. Jeg skal bare flytte sekken.","speaker":"Gutt","zh":"是的，请坐。这个座位是空的。你可以坐这儿。我把背包挪一下就好。","words":[[0,2,95.72,96.28,"ja"],[4,7,96.74,96.94,"vær~2378ba4e3ccb"],[8,10,96.94,97.04,"så~a7d338ef408a"],[11,14,97.04,97.2,"god~f534b04ae485"],[16,21,97.94,98.5,"dette"],[22,27,98.5,98.86,"setet"],[28,30,98.86,98.96,"er"],[31,36,98.96,99.26,"ledig"],[38,40,99.86,99.94,"du"],[41,44,99.94,100.06,"kan"],[45,50,100.06,100.32,"sitte"],[51,54,100.32,100.6,"her"],[56,59,101.5,101.7,"jeg"],[60,64,101.7,101.86,"skal"],[65,69,101.86,102.22,"bare"],[70,76,102.22,102.6,"flytte"],[77,83,102.6,103.02,"sekken"]]},{"id":23,"start":104.26,"end":107.36,"text":"Marit setter seg, og bussen kjører.","zh":"玛丽特坐下，公交车开动了。","words":[[0,5,104.33,104.74,"marit"],[6,12,104.74,105.06,"setter"],[13,16,105.06,105.26,"seg"],[18,20,106.06,106.3,"og"],[21,27,106.3,106.64,"bussen"],[28,34,106.64,107.28,"kjører"]]},{"id":24,"start":108.37,"end":113.03,"text":"Hun tar opp ei bok og er klar for mange timer på bussen.","zh":"她拿出一本书，准备好在车上待好几个小时。","words":[[0,3,108.45,108.63,"hun"],[4,7,108.63,108.87,"tar~ab355ba42ec9"],[8,11,108.87,109.09,"opp~fc2a3d99c099"],[12,14,109.09,109.25,"ei~47aa2d18e376"],[15,18,109.25,109.51,"bok"],[19,21,109.51,110.41,"og"],[22,24,110.41,110.55,"er"],[25,29,110.55,110.85,"klar"],[30,33,110.85,111.13,"for~cd4ce35eba0e"],[34,39,111.13,111.65,"mange"],[40,45,111.65,112.11,"timer"],[46,48,112.11,112.35,"på"],[49,55,112.35,112.95,"bussen"]]},{"id":25,"start":114.51,"end":119.36,"text":"Liker du å reise med …?","zh":"你喜欢乘坐……出行吗？","words":[[0,5,116.8,117.8,"liker"],[6,8,117.8,118.0,"du"],[9,10,118.0,118.18,"å~0583da7a620a"],[11,16,118.18,118.62,"reise~b6b0d7d6c228"],[17,20,118.62,119.28,"med~a7d4af26146c"]]},{"id":26,"start":120.74,"end":122.15,"text":"Ja, det gjør jeg.","zh":"是的，我喜欢。","words":[[0,2,120.82,121.08,"ja"],[4,7,121.46,121.48,"det"],[8,12,121.48,121.76,"gjør~6a8152bc5f32"],[13,16,121.76,122.07,"jeg"]]},{"id":27,"start":123.15,"end":124.85,"text":"Nei, det gjør jeg ikke.","zh":"不，我不喜欢。","words":[[0,3,123.23,123.56,"nei"],[5,8,123.92,124.08,"det"],[9,13,124.08,124.3,"gjør~2fb85b28cb2e"],[14,17,124.3,124.48,"jeg"],[18,22,124.48,124.77,"ikke"]]},{"id":28,"start":126.6,"end":128.42,"text":"Jeg pleier å ta tog.","zh":"我一般坐火车。","words":[[0,3,126.68,127.0,"jeg"],[4,10,127.0,127.42,"pleier"],[11,12,127.42,127.62,"å~0583da7a620a"],[13,15,127.62,127.66,"ta"],[16,19,127.66,128.34,"tog"]]},{"id":29,"start":129.9,"end":132.28,"text":"Hun tar buss til jobben hver dag.","zh":"她每天坐公交车上班。","words":[[0,3,129.98,130.17,"hun"],[4,7,130.17,130.47,"tar"],[8,12,130.47,130.93,"buss"],[13,16,130.93,131.09,"til"],[17,23,131.09,131.47,"jobben"],[24,28,131.47,131.75,"hver"],[29,32,131.75,132.21,"dag"]]},{"id":30,"start":133.7,"end":135.68,"text":"Vi må bestille en taxi.","zh":"我们得叫一辆出租车。","words":[[0,2,133.78,134.02,"vi"],[3,5,134.02,134.28,"må"],[6,14,134.28,134.8,"bestille"],[15,17,134.8,135.0,"en~a939a9e56dc5"],[18,22,135.08,135.6,"taxi"]]},{"id":31,"start":137.46,"end":139.36,"text":"Jeg liker å ta trikk.","zh":"我喜欢坐有轨电车。","words":[[0,3,137.54,137.73,"jeg"],[4,9,137.73,138.29,"liker"],[10,11,138.29,138.47,"å~0583da7a620a"],[12,14,138.47,138.71,"ta"],[15,20,138.71,139.28,"trikk"]]},{"id":32,"start":140.79,"end":143.39,"text":"I Oslo kan vi ta T-banen.","zh":"在奥斯陆我们可以坐地铁。","words":[[0,1,140.87,141.11,"i"],[2,6,141.11,141.63,"oslo"],[7,10,141.63,142.03,"kan"],[11,13,142.03,142.17,"vi"],[14,16,142.35,142.47,"ta"],[17,24,142.47,143.31,"t-banen"]]},{"id":33,"start":145.05,"end":147.3,"text":"Du kan ta med bilen på ferga.","zh":"你可以把车带上渡轮。","words":[[0,2,145.13,145.35,"du"],[3,6,145.35,145.63,"kan"],[7,9,145.71,145.93,"ta~c75796e98741"],[10,13,145.93,146.11,"med~e3b603f5b243"],[14,19,146.11,146.51,"bilen"],[20,22,146.51,146.69,"på"],[23,28,146.69,147.22,"ferga"]]},{"id":34,"start":149.76,"end":151.34,"text":"Det er morsomt å fly.","zh":"坐飞机很有意思。","words":[[0,3,149.84,149.95,"det"],[4,6,149.95,150.09,"er"],[7,14,150.09,150.65,"morsomt"],[15,16,150.65,150.81,"å~0583da7a620a"],[17,20,150.81,151.26,"fly~3c74cea8b3a2"]]},{"id":35,"start":151.65,"end":155.18,"text":"Jeg ser mange syklister.","zh":"我看到很多骑自行车的人。","words":[[0,3,152.94,153.58,"jeg"],[4,7,153.58,153.88,"ser"],[8,13,153.88,154.28,"mange"],[14,23,154.28,155.1,"syklister"]]},{"id":36,"start":155.82,"end":158.18,"text":"De sykler til skolen og jobben.","zh":"他们骑自行车上学和上班。","words":[[0,2,155.9,156.02,"de"],[3,9,156.02,156.48,"sykler"],[10,13,156.48,156.66,"til"],[14,20,156.66,157.14,"skolen"],[21,23,157.14,157.5,"og"],[24,30,157.5,158.1,"jobben"]]},{"id":37,"start":160.01,"end":161.78,"text":"Hun kjører motorsykkel.","zh":"她骑摩托车。","words":[[0,3,160.09,160.34,"hun"],[4,10,160.34,160.86,"kjører"],[11,22,160.86,161.7,"motorsykkel"]]}],"lexicon":{"7.4":{"lemma":"7.4","zh":"第 7.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alene":{"lemma":"alene","zh":"独自一人","pos":"副词","ref":"2-054","clip":"pronunciation/3c24fdbe3fdf986a62b0.mp3"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bagasje":{"lemma":"bagasje","zh":"行李","pos":"名词","ref":"7-113","clip":"pronunciation/c28042591e9cfa87135d.mp3"},"bagasjen":{"lemma":"bagasje","zh":"行李","pos":"名词","ref":"7-113","form":"单数定指","clip":null},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bestille":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","clip":"pronunciation/e2e34eab95ffd4810bf0.mp3"},"besøke":{"lemma":"besøke","zh":"拜访；看望；参观","pos":"动词","ref":"6-049","form":"不定式","clip":"pronunciation/040934c1a336145694a6.mp3"},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","clip":"pronunciation/c03f6631cf7e0e1bcbd0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","re