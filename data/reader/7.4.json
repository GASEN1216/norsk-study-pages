{"id":"7.4","title":"Går denne bussen til Førde?","audio":"audio/7.4.mp3","duration":165.54,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.82,"text":"7.4 Går denne bussen til Førde?","heading":true,"zh":"7.4 这辆公交车去弗尔德吗？","words":[[0,3,0.15,1.23,"7.4"],[4,7,2.74,3.0,"går~f010b28fdfbc"],[8,13,3.0,3.54,"denne"],[14,20,3.54,3.94,"bussen"],[21,24,3.94,4.1,"til"],[25,30,4.1,4.74,"førde"]]},{"id":1,"start":6.77,"end":8.81,"text":"Marit er på busstasjonen.","zh":"玛丽特在汽车站。","words":[[0,5,6.83,7.46,"marit"],[6,8,7.46,7.72,"er"],[9,11,7.72,7.86,"på"],[12,24,7.86,8.66,"busstasjonen"]]},{"id":2,"start":9.74,"end":12.38,"text":"Hun skal besøke ei venninne i Førde.","zh":"她要去弗尔德看望一位女性朋友。","words":[[0,3,9.8,10.14,"hun"],[4,8,10.14,10.42,"skal"],[9,15,10.42,11.0,"besøke"],[16,18,11.0,11.14,"ei~47aa2d18e376"],[19,27,11.14,11.62,"venninne"],[28,29,11.62,11.74,"i"],[30,35,11.74,12.22,"førde"]]},{"id":3,"start":13.38,"end":17.25,"text":"Hun vil ta buss, for det er langt å kjøre bil alene.","zh":"她想坐公交车去，因为一个人开车去路很远。","words":[[0,3,13.45,13.68,"hun"],[4,7,13.68,13.88,"vil"],[8,10,13.88,14.08,"ta"],[11,15,14.08,14.58,"buss"],[17,20,14.88,15.02,"for~1b22712a94b1"],[21,24,15.02,15.16,"det"],[25,27,15.16,15.34,"er"],[28,33,15.34,15.8,"langt~d19f6c81bf73"],[34,35,15.8,15.92,"å~0583da7a620a"],[36,41,15.92,16.22,"kjøre"],[42,45,16.22,16.6,"bil"],[46,51,16.6,17.11,"alene"]]},{"id":4,"start":18.96,"end":22.25,"text":"Hei! Går denne bussen til Førde?","speaker":"Marit","zh":"你好！这辆公交车去弗尔德吗？","words":[[0,3,18.96,19.68,"hei"],[5,8,20.18,20.4,"går~f010b28fdfbc"],[9,14,20.4,20.76,"denne"],[15,21,20.76,21.22,"bussen"],[22,25,21.22,21.44,"til"],[26,31,21.44,22.25,"førde"]]},{"id":5,"start":23.04,"end":24.72,"text":"Ja, det er riktig.","speaker":"Bussjåfør","zh":"是的，没错。","words":[[0,2,23.09,23.47,"ja"],[4,7,23.86,24.04,"det"],[8,10,24.04,24.16,"er"],[11,17,24.16,24.57,"riktig"]]},{"id":6,"start":25.53,"end":28.54,"text":"Så fint! Hvor lang tid tar turen?","speaker":"Marit","zh":"太好了！路上要多长时间？","words":[[0,2,25.59,25.84,"så~db4a353c3cdb"],[3,7,25.84,26.36,"fint"],[9,13,27.18,27.38,"hvor~8598699b9b8d"],[14,18,27.38,27.62,"lang"],[19,22,27.62,27.8,"tid"],[23,26,27.8,28.02,"tar~376c12518b59"],[27,32,28.02,28.39,"turen"]]},{"id":7,"start":29.57,"end":35.23,"text":"Det tar cirka fem og en halv time dit. Skal jeg hjelpe deg med bagasjen?","speaker":"Bussjåfør","zh":"到那儿大约要五个半小时。要我帮你拿行李吗？","words":[[0,3,29.62,29.84,"det"],[4,7,29.84,30.18,"tar~376c12518b59"],[8,13,30.18,30.72,"cirka"],[14,17,30.72,31.1,"fem"],[18,20,31.1,31.22,"og"],[21,23,31.22,31.36,"en~a939a9e56dc5"],[24,28,31.36,31.66,"halv~1969e66ac8e9"],[29,33,31.66,31.94,"time"],[34,37,31.94,32.39,"dit"],[39,43,33.2,33.52,"skal"],[44,47,33.52,33.74,"jeg"],[48,54,33.74,34.14,"hjelpe"],[55,58,34.14,34.34,"deg"],[59,62,34.34,34.52,"med"],[63,71,34.52,35.08,"bagasjen"]]},{"id":8,"start":36.1,"end":38.88,"text":"Ja takk! Jeg har ganske mye bagasje.","speaker":"Marit","zh":"好的，谢谢！我的行李挺多的。","words":[[0,2,36.16,36.46,"ja"],[3,7,36.46,36.91,"takk"],[9,12,37.16,37.3,"jeg"],[13,16,37.3,37.44,"har"],[17,23,37.44,37.94,"ganske"],[24,27,37.94,38.22,"mye~cc164d0dc3da"],[28,35,38.22,38.73,"bagasje"]]},{"id":9,"start":39.95,"end":46.77,"text":"Å! Har du alle disse veskene? Hvor mange uker skal du være borte?","speaker":"Bussjåfør","zh":"哇！这些包都是你的吗？你要出门几个星期啊？","words":[[0,1,40.02,40.31,"å~496a48c13525"],[3,6,40.98,41.24,"har"],[7,9,41.24,41.58,"du"],[10,14,41.68,42.06,"alle~6873d9584096"],[15,20,42.06,42.36,"disse"],[21,28,42.36,43.03,"veskene"],[30,34,44.14,44.46,"hvor~8598699b9b8d"],[35,40,44.46,44.92,"mange"],[41,45,44.92,45.54,"uker"],[46,50,45.54,45.76,"skal"],[51,53,45.76,45.94,"du"],[54,58,45.94,46.2,"være"],[59,64,46.2,46.62,"borte"]]},{"id":10,"start":48.12,"end":50.05,"text":"Jeg skal være der i fem dager.","speaker":"Marit","zh":"我要在那儿待五天。","words":[[0,3,48.18,48.36,"jeg"],[4,8,48.36,48.56,"skal"],[9,13,48.56,48.84,"være"],[14,17,48.84,49.06,"der"],[18,19,49.06,49.22,"i~418737c67580"],[20,23,49.22,49.5,"fem"],[24,29,49.5,49.9,"dager"]]},{"id":11,"start":50.54,"end":53.77,"text":"Ja vel. Har du billett?","speaker":"Bussjåfør","zh":"好的。你有票吗？","words":[[0,2,50.6,50.96,"ja"],[3,6,50.96,51.35,"vel~26edb5ae7c1a"],[8,11,52.82,52.98,"har"],[12,14,52.98,53.12,"du"],[15,22,53.12,53.62,"billett"]]},{"id":12,"start":54.3,"end":57.2,"text":"Ja, jeg har den på mobilen. Se her.","speaker":"Marit","zh":"有，在我手机上。你看。","words":[[0,2,54.36,54.71,"ja"],[4,7,54.92,55.1,"jeg"],[8,11,55.1,55.34,"har"],[12,15,55.34,55.5,"den"],[16,18,55.5,55.64,"på"],[19,26,55.64,56.34,"mobilen"],[28,30,56.7,56.9,"se~26e2daf31e48"],[31,34,56.9,57.05,"her"]]},{"id":13,"start":58.16,"end":61.82,"text":"Fint. Takk skal du ha. God tur!","speaker":"Bussjåfør","zh":"好的。谢谢。一路顺风！","words":[[0,4,58.22,58.73,"fint"],[6,10,59.3,59.54,"takk"],[11,15,59.54,59.72,"skal~27c1f26fdfff"],[16,18,59.72,59.84,"du"],[19,21,59.84,60.13,"ha~8e56bc8d3017"],[23,26,61.18,61.38,"god"],[27,30,61.38,61.67,"tur~add812ac29ce"]]},{"id":14,"start":62.36,"end":63.58,"text":"Tusen takk!","speaker":"Marit","zh":"非常感谢！","words":[[0,5,62.37,62.94,"tusen"],[6,10,62.94,63.58,"takk"]]},{"id":15,"start":65.14,"end":70.69,"text":"Det er mange passasjerer på bussen, og Marit prøver å finne en ledig plass.","zh":"车上乘客很多，玛丽特想找一个空座位。","words":[[0,3,65.2,65.34,"det"],[4,6,65.34,65.56,"er"],[7,12,65.56,65.98,"mange"],[13,24,65.98,66.76,"passasjerer"],[25,27,66.76,66.9,"på"],[28,34,66.9,67.44,"bussen"],[36,38,68.02,68.16,"og"],[39,44,68.16,68.7,"marit"],[45,51,68.7,69.04,"prøver~18b05bd56cd4"],[52,53,69.04,69.14,"å~0583da7a620a"],[54,59,69.14,69.54,"finne"],[60,62,69.54,69.7,"en~a939a9e56dc5"],[63,68,69.7,70.08,"ledig"],[69,74,70.08,70.53,"plass"]]},{"id":16,"start":71.81,"end":77.82,"text":"Ei ung jente sitter alene, men hun har en sekk på setet ved siden av seg.","zh":"一个年轻女孩独自坐着，但她把背包放在了旁边的座位上。","words":[[0,2,71.87,72.28,"ei~47aa2d18e376"],[3,6,72.28,72.54,"ung"],[7,12,72.54,73.14,"jente"],[13,19,73.14,73.56,"sitter"],[20,25,73.56,74.22,"alene"],[27,30,74.68,75.08,"men"],[31,34,75.08,75.38,"hun"],[35,38,75.38,75.58,"har"],[39,41,75.58,75.78,"en~a939a9e56dc5"],[42,46,75.78,76.16,"sekk"],[47,49,76.16,76.32,"på"],[50,55,76.32,76.74,"setet"],[56,59,76.74,76.9,"ved"],[60,65,76.9,77.26,"siden~68789c658db2"],[66,68,77.26,77.4,"av~38cf00d29ad7"],[69,72,77.4,77.67,"seg"]]},{"id":17,"start":78.87,"end":80.34,"text":"Marit går videre.","zh":"玛丽特继续往前走。","words":[[0,5,78.93,79.44,"marit"],[6,9,79.44,79.72,"går"],[10,16,79.72,80.19,"videre"]]},{"id":18,"start":81.31,"end":84.71,"text":"Alle setene er opptatt av folk eller bagasje.","zh":"所有座位都被人或行李占着。","words":[[0,4,81.37,81.76,"alle~6873d9584096"],[5,11,81.76,82.3,"setene"],[12,14,82.3,82.46,"er"],[15,22,82.46,82.98,"opptatt~4935a6fa3786"],[23,25,82.98,83.14,"av~f10355d3c566"],[26,30,83.14,83.68,"folk"],[31,36,83.68,83.98,"eller"],[37,44,83.98,84.56,"bagasje"]]},{"id":19,"start":85.61,"end":88.51,"text":"Hun stopper ved siden av en gutt og spør ham.","zh":"她在一个小伙子旁边停下来问他。","words":[[0,3,85.67,86.04,"hun"],[4,11,86.04,86.48,"stopper"],[12,15,86.48,86.62,"ved"],[16,21,86.62,86.98,"siden~68789c658db2"],[22,24,86.98,87.1,"av~38cf00d29ad7"],[25,27,87.1,87.26,"en~a939a9e56dc5"],[28,32,87.26,87.64,"gutt"],[33,35,87.64,87.76,"og"],[36,40,87.76,88.06,"spør"],[41,44,88.06,88.36,"ham"]]},{"id":20,"start":89.28,"end":92.07,"text":"Han har også en sekk på setet ved siden av seg.","zh":"他旁边的座位上也放着一个背包。","words":[[0,3,89.34,89.66,"han"],[4,7,89.66,89.84,"har"],[8,12,89.84,90.18,"også"],[13,15,90.18,90.3,"en~a939a9e56dc5"],[16,20,90.3,90.62,"sekk"],[21,23,90.62,90.76,"på"],[24,29,90.76,91.14,"setet"],[30,33,91.14,91.26,"ved"],[34,39,91.26,91.52,"siden~68789c658db2"],[40,42,91.52,91.66,"av~38cf00d29ad7"],[43,46,91.66,91.92,"seg"]]},{"id":21,"start":93.37,"end":95.44,"text":"Unnskyld, er det ledig her?","speaker":"Marit","zh":"请问，这里空着吗？","words":[[0,8,93.43,94.2,"unnskyld"],[10,12,94.2,94.32,"er"],[13,16,94.32,94.46,"det"],[17,22,94.46,94.86,"ledig"],[23,26,94.86,95.44,"her"]]},{"id":22,"start":96.01,"end":103.22,"text":"Ja, vær så god. Dette setet er ledig. Du kan sitte her. Jeg skal bare flytte sekken.","speaker":"Gutt","zh":"是的，请坐。这个座位是空的。你可以坐这儿。我把背包挪一下就好。","words":[[0,2,96.07,96.44,"ja"],[4,7,96.82,96.96,"vær~2378ba4e3ccb"],[8,10,96.96,97.08,"så~a7d338ef408a"],[11,14,97.08,97.44,"god~f534b04ae485"],[16,21,98.26,98.6,"dette"],[22,27,98.6,98.9,"setet"],[28,30,98.9,98.98,"er"],[31,36,98.98,99.48,"ledig"],[38,40,99.86,99.98,"du"],[41,44,99.98,100.1,"kan"],[45,50,100.1,100.42,"sitte"],[51,54,100.42,100.8,"her"],[56,59,101.58,101.72,"jeg"],[60,64,101.72,101.94,"skal"],[65,69,101.94,102.32,"bare"],[70,76,102.32,102.7,"flytte"],[77,83,102.7,103.07,"sekken"]]},{"id":23,"start":104.28,"end":107.42,"text":"Marit setter seg, og bussen kjører.","zh":"玛丽特坐下，公交车开动了。","words":[[0,5,104.34,104.82,"marit"],[6,12,104.82,105.12,"setter"],[13,16,105.12,105.5,"seg"],[18,20,106.22,106.34,"og"],[21,27,106.34,106.72,"bussen"],[28,34,106.72,107.27,"kjører"]]},{"id":24,"start":108.41,"end":113.09,"text":"Hun tar opp ei bok og er klar for mange timer på bussen.","zh":"她拿出一本书，准备好在车上待好几个小时。","words":[[0,3,108.47,108.68,"hun"],[4,7,108.68,108.94,"tar~ab355ba42ec9"],[8,11,108.94,109.14,"opp~fc2a3d99c099"],[12,14,109.14,109.28,"ei~47aa2d18e376"],[15,18,109.28,109.88,"bok"],[19,21,110.32,110.44,"og"],[22,24,110.44,110.64,"er"],[25,29,110.64,111.02,"klar"],[30,33,111.02,111.28,"for~cd4ce35eba0e"],[34,39,111.28,111.74,"mange"],[40,45,111.74,112.26,"timer"],[46,48,112.26,112.4,"på"],[49,55,112.4,112.94,"bussen"]]},{"id":25,"start":117.38,"end":119.3,"text":"Liker du å reise med …?","zh":"你喜欢乘坐……出行吗？","words":[[0,5,117.44,117.88,"liker"],[6,8,117.88,118.1,"du"],[9,10,118.1,118.22,"å~0583da7a620a"],[11,16,118.22,118.72,"reise~b6b0d7d6c228"],[17,20,118.72,119.26,"med~a7d4af26146c"]]},{"id":26,"start":120.78,"end":122.21,"text":"Ja, det gjør jeg.","zh":"是的，我喜欢。","words":[[0,2,120.84,121.28,"ja"],[4,7,121.28,121.62,"det"],[8,12,121.62,121.82,"gjør~6a8152bc5f32"],[13,16,121.82,122.06,"jeg"]]},{"id":27,"start":123.18,"end":124.92,"text":"Nei, det gjør jeg ikke.","zh":"不，我不喜欢。","words":[[0,3,123.24,123.76,"nei"],[5,8,123.88,124.16,"det"],[9,13,124.16,124.34,"gjør~2fb85b28cb2e"],[14,17,124.34,124.48,"jeg"],[18,22,124.48,124.77,"ikke"]]},{"id":28,"start":126.64,"end":128.48,"text":"Jeg pleier å ta tog.","zh":"我一般坐火车。","words":[[0,3,126.7,127.1,"jeg"],[4,10,127.1,127.52,"pleier"],[11,12,127.52,127.64,"å~0583da7a620a"],[13,15,127.64,127.84,"ta"],[16,19,127.84,128.33,"tog"]]},{"id":29,"start":129.94,"end":132.34,"text":"Hun tar buss til jobben hver dag.","zh":"她每天坐公交车上班。","words":[[0,3,130.0,130.32,"hun"],[4,7,130.32,130.62,"tar"],[8,12,130.62,130.98,"buss"],[13,16,130.98,131.2,"til"],[17,23,131.2,131.58,"jobben"],[24,28,131.58,131.82,"hver"],[29,32,131.82,132.19,"dag"]]},{"id":30,"start":133.74,"end":135.73,"text":"Vi må bestille en taxi.","zh":"我们得叫一辆出租车。","words":[[0,2,133.8,134.1,"vi"],[3,5,134.1,134.38,"må"],[6,14,134.38,134.92,"bestille"],[15,17,134.92,135.04,"en~a939a9e56dc5"],[18,22,135.04,135.58,"taxi"]]},{"id":31,"start":137.49,"end":139.42,"text":"Jeg liker å ta trikk.","zh":"我喜欢坐有轨电车。","words":[[0,3,137.55,137.84,"jeg"],[4,9,137.84,138.38,"liker"],[10,11,138.38,138.58,"å~0583da7a620a"],[12,14,138.58,138.8,"ta"],[15,20,138.8,139.27,"trikk"]]},{"id":32,"start":140.83,"end":143.45,"text":"I Oslo kan vi ta T-banen.","zh":"在奥斯陆我们可以坐地铁。","words":[[0,1,140.89,141.22,"i"],[2,6,141.22,141.8,"oslo"],[7,10,141.92,142.08,"kan"],[11,13,142.08,142.24,"vi"],[14,16,142.24,142.62,"ta"],[17,24,142.62,143.3,"t-banen"]]},{"id":33,"start":145.09,"end":147.37,"text":"Du kan ta med bilen på ferga.","zh":"你可以把车带上渡轮。","words":[[0,2,145.15,145.44,"du"],[3,6,145.44,145.72,"kan"],[7,9,145.72,146.0,"ta~c75796e98741"],[10,13,146.0,146.18,"med~e3b603f5b243"],[14,19,146.18,146.6,"bilen"],[20,22,146.6,146.74,"på"],[23,28,146.74,147.22,"ferga"]]},{"id":34,"start":149.77,"end":151.39,"text":"Det er morsomt å fly.","zh":"坐飞机很有意思。","words":[[0,3,149.83,149.98,"det"],[4,6,149.98,150.18,"er"],[7,14,150.18,150.76,"morsomt"],[15,16,150.76,150.88,"å~0583da7a620a"],[17,20,150.88,151.24,"fly~3c74cea8b3a2"]]},{"id":35,"start":153.26,"end":155.23,"text":"Jeg ser mange syklister.","zh":"我看到很多骑自行车的人。","words":[[0,3,153.32,153.72,"jeg"],[4,7,153.72,154.02,"ser"],[8,13,154.02,154.44,"mange"],[14,23,154.44,155.08,"syklister"]]},{"id":36,"start":155.81,"end":158.25,"text":"De sykler til skolen og jobben.","zh":"他们骑自行车上学和上班。","words":[[0,2,155.88,156.12,"de"],[3,9,156.12,156.56,"sykler"],[10,13,156.56,156.8,"til"],[14,20,156.8,157.34,"skolen"],[21,23,157.34,157.64,"og"],[24,30,157.64,158.09,"jobben"]]},{"id":37,"start":160.03,"end":161.82,"text":"Hun kjører motorsykkel.","zh":"她骑摩托车。","words":[[0,3,160.09,160.46,"hun"],[4,10,160.46,160.94,"kjører"],[11,22,160.94,161.67,"motorsykkel"]]}],"lexicon":{"7.4":{"lemma":"7.4","zh":"第 7.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"alene":{"lemma":"alene","zh":"独自一人","pos":"副词","ref":"2-054","clip":"pronunciation/3c24fdbe3fdf986a62b0.mp3"},"alle":{"lemma":"all","zh":"所有的；所有人；全部","pos":"数量限定词／代词","form":"复数","ref":null,"clip":"pronunciation/2146a029ad5e62ec7869.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bagasje":{"lemma":"bagasje","zh":"行李","pos":"名词","ref":"7-113","clip":"pronunciation/c28042591e9cfa87135d.mp3"},"bagasjen":{"lemma":"bagasje","zh":"行李","pos":"名词","ref":"7-113","form":"单数定指","clip":null},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"bestille":{"lemma":"bestille","zh":"点餐；订购；预约","pos":"动词","ref":"8-170","clip":"pronunciation/e2e34eab95ffd4810bf0.mp3"},"besøke":{"lemma":"besøke","zh":"拜访；看望；参观","pos":"动词","ref":"6-049","form":"不定式","clip":"pronunciation/040934c1a336145694a6.mp3"},"bil":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","clip":"pronunciation/c03f6631cf7e0e1bcbd0.mp3"},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form"