{"id":"pa-vei-6.D","bookId":"pa-vei-textbook","readingId":"6.D","title":"Hilde var hjemme","audio":"audio/pa-vei/6.D.mp3","duration":47.598813,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.62,"end":4.325,"text":"D. Hilde var hjemme","zh":"D. 希尔德待在家里","words":[[0,1,1.62,2.16,"d"],[3,8,3.28,3.785,"hilde"],[9,12,3.8,3.982,"var"],[13,19,3.982,4.325,"hjemme"]]},{"id":1,"start":6.3,"end":8.185,"text":"Hilde var hjemme i ferien.","zh":"希尔德假期待在家里。","words":[[0,5,6.3,6.805,"hilde"],[6,9,6.84,7.045,"var"],[10,16,7.1,7.545,"hjemme"],[17,18,7.6,7.705,"i"],[19,25,7.72,8.185,"ferien"]]},{"id":2,"start":9.78,"end":11.345,"text":"Om morgenen tok hun det med ro.","zh":"她早上悠闲地度过。","words":[[0,2,9.78,9.925,"om"],[3,11,10.0,10.525,"morgenen"],[12,15,10.6,10.803,"tok"],[16,19,10.803,10.933,"hun"],[20,23,10.933,11.072,"det"],[24,27,11.072,11.203,"med"],[28,30,11.203,11.345,"ro"]]},{"id":3,"start":13.06,"end":19.245,"text":"Hun dusjet og vasket håret, spiste lang frokost og leste avisen.","zh":"她洗澡、洗头，慢慢吃早餐，再看看报纸。","words":[[0,3,13.06,13.245,"hun"],[4,10,13.28,13.992,"dusjet"],[11,13,13.992,14.092,"og"],[14,20,14.092,14.453,"vasket"],[21,26,14.453,14.805,"håret"],[28,34,15.9,16.305,"spiste"],[35,39,16.34,16.645,"lang"],[40,47,16.74,17.465,"frokost"],[48,50,17.84,17.985,"og"],[51,56,18.02,18.585,"leste"],[57,63,18.7,19.245,"avisen"]]},{"id":4,"start":21.312,"end":26.277,"text":"Etterpå dro hun på biblioteket eller traff venner i byen.","zh":"之后她去图书馆，或者到城里见朋友。","words":[[0,7,21.312,21.957,"etterpå"],[8,11,22.072,22.257,"dro"],[12,15,22.312,22.477,"hun"],[16,18,22.492,22.617,"på"],[19,30,22.652,23.477,"biblioteket"],[31,36,24.552,24.837,"eller"],[37,42,24.892,25.217,"traff"],[43,49,25.332,25.777,"venner"],[50,51,25.872,25.965,"i"],[52,56,25.965,26.277,"byen"]]},{"id":5,"start":28.782,"end":38.487,"text":"Noen ganger jogget hun og ei venninne opp til en stor park i byen, og hun besøkte også et par museer og gallerier.","zh":"有时她和一位女性朋友慢跑到城里的一个大公园，她还参观了几家博物馆和美术馆。","words":[[0,4,28.782,29.124,"noen"],[5,11,29.124,29.467,"ganger"],[12,18,29.482,29.987,"jogget"],[19,22,30.002,30.207,"hun"],[23,25,30.282,30.404,"og"],[26,28,30.404,30.547,"ei"],[29,37,30.562,31.127,"venninne"],[38,41,31.462,31.654,"opp"],[42,45,31.654,31.804,"til"],[46,48,31.804,31.947,"en"],[49,53,32.022,32.387,"stor"],[54,58,32.422,32.864,"park"],[59,60,32.864,32.954,"i"],[61,65,32.954,33.267,"byen"],[67,69,34.882,35.027,"og"],[70,73,35.042,35.227,"hun"],[74,81,35.242,35.907,"besøkte"],[82,86,35.962,36.287,"også"],[87,89,36.342,36.525,"et"],[90,93,36.525,36.807,"par"],[94,100,36.822,37.487,"museer"],[101,103,37.722,37.855,"og"],[104,113,37.855,38.487,"gallerier"]]},{"id":6,"start":40.762,"end":46.387,"text":"Hilde hadde en fin ferie, uten vekkerklokke og uten planer.","zh":"希尔德过了一个愉快的假期，没有闹钟，也没有计划。","words":[[0,5,40.762,41.247,"hilde"],[6,11,41.282,41.587,"hadde"],[12,14,41.622,41.767,"en"],[15,18,41.882,42.247,"fin"],[19,24,42.282,42.707,"ferie"],[26,30,43.442,43.864,"uten"],[31,43,43.864,44.627,"vekkerklokke"],[44,46,45.302,45.427,"og"],[47,51,45.502,45.907,"uten"],[52,58,45.922,46.387,"planer"]]}],"lexicon":{"avisen":{"lemma":"avis","pos":"名词","zh":"报纸","ref":null,"clip":null,"form":"单数定指"},"besøkte":{"lemma":"besøke","zh":"拜访；看望；参观","pos":"动词","ref":"6-049","form":"过去时","clip":null},"biblioteket":{"lemma":"bibliotek","zh":"图书馆","pos":"名词","ref":"basics:city:bibliotek","form":"单数定指","clip":null},"byen":{"lemma":"by","zh":"城市","pos":"名词","ref":"basics:city:by","form":"单数定指","clip":null},"d":{"lemma":"D","pos":"字母","zh":"字母 D","ref":null,"clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dro":{"lemma":"dra","zh":"去；离开；拉","pos":"动词","ref":"6-023","form":"过去时","clip":null},"dusjet":{"lemma":"dusje","pos":"动词","zh":"淋浴","ref":null,"clip":null,"form":"过去时"},"ei":{"lemma":"ei","pos":"冠词","form":"阴性","zh":"一（个）（阴性不定冠词）","ref":null,"clip":null},"eller":{"lemma":"eller","pos":"连词","zh":"或者；还是","ref":null,"clip":n