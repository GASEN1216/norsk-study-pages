{"id":"2.4","title":"Hva betyr det?","audio":"audio/2.4.mp3","duration":160.11,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.04,"text":"2.4 Hva betyr det?","heading":true,"zh":"2.4 这是什么意思？","words":[[0,3,0.15,1.24,"2.4"],[4,7,2.16,3.16,"hva"],[8,13,3.16,3.62,"betyr"],[14,17,3.62,3.96,"det"]]},{"id":1,"start":6.24,"end":8.33,"text":"Det er onsdag i dag.","zh":"今天是星期三。","words":[[0,3,6.32,6.5,"det"],[4,6,6.5,6.88,"er"],[7,13,6.88,7.6,"onsdag"],[14,15,7.6,7.82,"i~de136e71704d"],[16,19,7.82,8.25,"dag~83a758a6ca25"]]},{"id":2,"start":9.34,"end":12.22,"text":"Håvard underviser i klassen.","zh":"霍瓦尔在班上讲课。","words":[[0,6,9.42,9.98,"håvard"],[7,17,9.98,11.24,"underviser"],[18,19,11.24,11.58,"i"],[20,27,11.58,12.14,"klassen"]]},{"id":3,"start":13.35,"end":16.68,"text":"De lytter og gjentar etter Håvard.","zh":"他们听，并跟着霍瓦尔重复。","words":[[0,2,13.43,13.7,"de"],[3,9,13.7,14.2,"lytter"],[10,12,14.2,14.72,"og"],[13,20,14.72,15.38,"gjentar"],[21,26,15.38,16.04,"etter~9d660b5aa14f"],[27,33,16.04,16.6,"håvard"]]},{"id":4,"start":17.98,"end":21.02,"text":"Han skriver ord og setninger.","zh":"他写单词和句子。","words":[[0,3,18.06,18.36,"han"],[4,11,18.36,18.76,"skriver"],[12,15,18.76,19.34,"ord"],[16,18,19.34,20.14,"og"],[19,28,20.14,20.94,"setninger"]]},{"id":5,"start":22.34,"end":25.63,"text":"I dag lærer de V2-regelen.","zh":"今天他们学习 V2 规则。","words":[[0,1,22.43,22.66,"i~de136e71704d"],[2,5,22.66,22.9,"dag~83a758a6ca25"],[6,11,22.9,23.7,"lærer~0769c7af9c2d"],[12,14,23.7,23.94,"de"],[15,25,23.94,25.55,"v2-regelen"]]},{"id":6,"start":26.72,"end":32.2,"text":"Viola og Biniam sitter sammen og skriver på pc.","zh":"维奥拉和比尼亚姆坐在一起，用电脑写东西。","words":[[0,5,26.8,27.64,"viola"],[6,8,27.64,28.06,"og"],[9,15,28.06,28.58,"biniam"],[16,22,28.58,29.32,"sitter"],[23,29,29.32,30.04,"sammen"],[30,32,30.04,30.58,"og"],[33,40,30.58,30.98,"skriver"],[41,43,30.98,31.44,"på~58f7c55ec6af"],[44,46,31.44,32.12,"pc"]]},{"id":7,"start":33.41,"end":35.1,"text":"Biniam rekker opp hånda.","zh":"比尼亚姆举起手。","words":[[0,6,33.49,33.96,"biniam"],[7,13,33.96,34.38,"rekker~dc25f007ad8b"],[14,17,34.38,34.56,"opp"],[18,23,34.56,35.02,"hånda"]]},{"id":8,"start":35.73,"end":37.17,"text":"Han forstår ikke.","zh":"他没听懂。","words":[[0,3,35.81,36.16,"han"],[4,11,36.16,36.62,"forstår"],[12,16,36.62,37.09,"ikke"]]},{"id":9,"start":38.33,"end":42.52,"text":"Hva betyr V2-regelen, Håvard?","speaker":"Biniam","zh":"霍瓦尔，V2 规则是什么意思？","words":[[0,3,38.61,39.75,"hva"],[4,9,39.75,40.27,"betyr"],[10,20,40.73,41.75,"v2-regelen"],[22,28,41.91,42.44,"håvard"]]},{"id":10,"start":43.77,"end":47.46,"text":"Verb har plass nummer to i en setning.","speaker":"Håvard","zh":"动词在句子中处于第二位。","words":[[0,4,43.85,44.21,"verb"],[5,8,44.21,44.81,"har"],[9,14,44.81,45.31,"plass"],[15,21,45.31,45.71,"nummer"],[22,24,45.71,46.09,"to"],[25,26,46.09,46.65,"i"],[27,29,46.65,46.77,"en~a939a9e56dc5"],[30,37,46.77,47.38,"setning"]]},{"id":11,"start":48.9,"end":51.68,"text":"Betyr verb det vi gjør?","speaker":"Biniam","zh":"动词的意思是我们做的事吗？","words":[[0,5,48.98,49.68,"betyr"],[6,10,49.68,50.14,"verb"],[11,14,50.14,50.8,"det~3883f1202f8e"],[15,17,50.8,51.04,"vi"],[18,22,51.04,51.6,"gjør"]]},{"id":12,"start":52.56,"end":60.69,"text":"Det er riktig, Biniam. Bor, snakker og skriver er verb.","speaker":"Håvard","zh":"没错，比尼亚姆。bor（住）、snakker（说）和 skriver（写）都是动词。","words":[[0,3,52.64,52.94,"det"],[4,6,52.94,53.3,"er"],[7,13,53.3,53.82,"riktig"],[15,21,54.02,54.48,"biniam"],[23,26,55.93,56.47,"bor"],[28,35,57.38,57.94,"snakker"],[36,38,57.94,58.58,"og"],[39,46,58.61,59.07,"skriver"],[47,49,59.14,60.04,"er"],[50,54,60.04,60.61,"verb"]]},{"id":13,"start":61.9,"end":67.5,"text":"Er kommer, går, liker også verb?","speaker":"Biniam","zh":"kommer（来）、går（走）、liker（喜欢）也是动词吗？","words":[[0,2,61.98,62.27,"er"],[3,9,62.83,63.13,"kommer"],[11,14,64.11,64.31,"går"],[16,21,65.27,65.81,"liker"],[22,26,66.45,66.75,"også"],[27,31,66.75,67.42,"verb"]]},{"id":14,"start":67.98,"end":70.25,"text":"Ja, det er riktig.","speaker":"Håvard","zh":"是的，没错。","words":[[0,2,68.06,68.36,"ja"],[4,7,68.94,69.24,"det"],[8,10,69.24,69.68,"er"],[11,17,69.68,70.17,"riktig"]]},{"id":15,"start":71.28,"end":72.87,"text":"Nå forstår jeg.","speaker":"Biniam","zh":"现在我明白了。","words":[[0,2,71.36,71.84,"nå~d531d47a7712"],[3,10,71.84,72.4,"forstår"],[11,14,72.4,72.79,"jeg"]]},{"id":16,"start":74.05,"end":92.53,"text":"I spørsmål med spørreord er verb nummer to. «Hvor bor du?» «Hva liker du?» I ja/nei-spørsmål er verb nummer én. «Liker du kaffe?» «Snakker du arabisk?»","speaker":"Håvard","zh":"在带疑问词的问句中，动词在第二位：“你住在哪里？”“你喜欢什么？”在是非问句中，动词在第一位：“你喜欢咖啡吗？”“你会说阿拉伯语吗？”","words":[[0,1,74.13,74.23,"i"],[2,10,74.23,74.99,"spørsmål"],[11,14,74.99,75.21,"med~737441dae6a6"],[15,24,75.21,76.01,"spørreord"],[25,27,76.01,76.63,"er"],[28,32,76.63,76.97,"verb"],[33,39,76.97,77.45,"nummer"],[40,42,77.45,77.75,"to"],[45,49,79.34,79.74,"hvor"],[50,53,79.74,80.2,"bor"],[54,56,80.2,80.46,"du"],[60,63,81.06,81.62,"hva"],[64,69,81.62,82.18,"liker"],[70,72,82.18,82.36,"du"],[75,76,83.86,84.22,"i"],[77,92,84.22,85.5,"ja/nei-spørsmål"],[93,95,85.5,85.82,"er"],[96,100,85.82,86.12,"verb"],[101,107,86.12,86.5,"nummer"],[108,110,86.5,86.86,"én"],[113,118,88.48,89.08,"liker"],[119,121,89.08,89.24,"du"],[122,127,89.24,89.62,"kaffe"],[131,138,90.68,91.44,"snakker"],[139,141,91.44,91.62,"du"],[142,149,91.62,92.45,"arabisk~3bb978ca6cd0"]]},{"id":17,"start":96.77,"end":99.55,"text":"Jeg forstår ikke «setning».","zh":"我不懂“setning”（句子）这个词。","words":[[0,3,96.85,97.19,"jeg"],[4,11,97.19,97.81,"forstår"],[12,16,97.81,98.19,"ikke"],[18,25,98.59,99.47,"setning"]]},{"id":18,"start":100.49,"end":102.23,"text":"Hva betyr det, Håvard?","zh":"霍瓦尔，这是什么意思？","words":[[0,3,100.57,100.83,"hva"],[4,9,100.83,101.27,"betyr"],[10,13,101.27,101.51,"det"],[15,21,101.61,102.15,"håvard"]]},{"id":19,"start":103.84,"end":107.63,"text":"En setning har subjekt og verb.","zh":"一个句子有主语和动词。","words":[[0,2,103.92,104.11,"en~a939a9e56dc5"],[3,10,104.11,104.69,"setning"],[11,14,104.69,105.51,"har"],[15,22,105.51,106.09,"subjekt"],[23,25,106.09,107.01,"og"],[26,30,107.01,107.55,"verb"]]},{"id":20,"start":108.52,"end":117.4,"text":"Setninger har stor bokstav først og punktum, spørsmålstegn eller utropstegn til slutt.","zh":"句子开头是大写字母，结尾是句号、问号或感叹号。","words":[[0,9,108.6,109.36,"setninger"],[10,13,109.36,109.9,"har"],[14,18,109.9,110.36,"stor~407825634dda"],[19,26,110.36,111.0,"bokstav"],[27,32,111.0,111.46,"først"],[33,35,111.84,112.24,"og"],[36,43,112.24,112.9,"punktum"],[45,58,113.41,114.37,"spørsmålstegn"],[59,64,114.44,115.12,"eller"],[65,75,115.12,116.24,"utropstegn"],[76,79,116.68,116.8,"til~a6400a95af28"],[80,85,116.8,117.32,"slutt~8b571dca0f08"]]},{"id":21,"start":121.38,"end":122.81,"text":"Hva liker du?","zh":"你喜欢什么？","words":[[0,3,121.46,121.8,"hva"],[4,9,121.8,122.42,"liker"],[10,12,122.42,122.73,"du"]]},{"id":22,"start":125.11,"end":127.0,"text":"Jeg liker vann.","zh":"我喜欢水。","words":[[0,3,125.19,125.63,"jeg"],[4,9,125.63,126.37,"liker"],[10,14,126.37,126.92,"vann"]]},{"id":23,"start":129.15,"end":131.59,"text":"Jeg liker God i norsk.","zh":"我喜欢《God i norsk》。","words":[[0,3,129.23,129.6,"jeg"],[4,9,129.6,130.18,"liker"],[10,13,130.18,130.74,"god~6da943f79ce0"],[14,15,130.74,130.98,"i~8c50789c626a"],[16,21,130.98,131.51,"norsk~4de5d75feae1"]]},{"id":24,"start":133.66,"end":136.05,"text":"Jeg liker musikk.","zh":"我喜欢音乐。","words":[[0,3,133.74,134.26,"jeg"],[4,9,134.26,135.22,"liker"],[10,16,135.22,135.97,"musikk"]]},{"id":25,"start":138.11,"end":139.96,"text":"Han liker fotball.","zh":"他喜欢足球。","words":[[0,3,138.19,138.52,"han"],[4,9,138.52,139.18,"liker"],[10,17,139.18,139.88,"fotball"]]},{"id":26,"start":142.03,"end":143.68,"text":"Jeg liker Skype.","zh":"我喜欢 Skype。","words":[[0,3,142.11,142.49,"jeg"],[4,9,142.49,143.17,"liker"],[10,15,143.17,143.6,"skype"]]},{"id":27,"start":145.94,"end":147.75,"text":"Hun liker is.","zh":"她喜欢冰淇淋。","words":[[0,3,146.02,146.35,"hun"],[4,9,146.35,146.97,"liker"],[10,12,146.97,147.67,"is"]]},{"id":28,"start":149.8,"end":152.08,"text":"Jeg liker klassen.","zh":"我喜欢这个班。","words":[[0,3,149.88,150.33,"jeg"],[4,9,150.33,151.23,"liker"],[10,17,151.23,152.0,"klassen"]]},{"id":29,"start":154.17,"end":155.85,"text":"Han liker henne.","zh":"他喜欢她。","words":[[0,3,154.25,154.62,"han"],[4,9,154.62,155.28,"liker"],[10,15,155.28,155.77,"henne"]]}],"lexicon":{"2.4":{"lemma":"2.4","zh":"第 2.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"arabisk":{"lemma":"arabisk","zh":"阿拉伯语","pos":"语言名／形容词","ref":"1-073","clip":"pronunciation/746311d8b0ceb97b8645.mp3"},"betyr":{"lemma":"bety","zh":"意思是；意味着","pos":"动词","form":"现在时","ref":null,"clip":"pronunciation/52f56f7728b57f1a5345.mp3"},"biniam":{"lemma":"Biniam","zh":"比尼亚姆（人名）","pos":"专名","ref":"1-021","clip":"pronunciation/e8a134405844f1e3c9ba.mp3"},"bokstav":{"lemma":"bokstav","zh":"字母","pos":"名词","ref":null,"clip":null},"bor":{"lemma":"bo","zh":"居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e3751847918c.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"eller":{"lemma":"eller","zh":"或者","pos":"连词","ref":"basics:frequency:eller","clip":"pronunciation/563259f099deb633b0fc.mp3"},"en":{"lemma":"en","zh":"一（个）（阳性不定冠词）；一","pos":"冠词／数词","form":"阳性","ref":"1-106","clip":"pronunciation/dbd3a49d0d906b4ed921.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"etter":{"lemma":"etter","zh":"之后","pos":"介词","ref":"3-062","clip":"pronunciation/1a0e73ca81b760707c80.mp3"},"forstår":{"lemma":"forstå","zh":"理解；听懂","pos":"动词","ref":"1-031","form":"现在时","clip":"pronunciation/e0462