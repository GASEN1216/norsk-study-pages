{"id":"2.4","title":"Hva betyr det?","audio":"audio/2.4.mp3","duration":160.11,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.04,"text":"2.4 Hva betyr det?","heading":true,"zh":"2.4 这是什么意思？","words":[[0,3,0.15,1.24,"2.4"],[4,7,2.16,3.16,"hva"],[8,13,3.16,3.62,"betyr"],[14,17,3.62,3.96,"det"]]},{"id":1,"start":6.28,"end":8.39,"text":"Det er onsdag i dag.","zh":"今天是星期三。","words":[[0,3,6.34,6.62,"det"],[4,6,6.62,7.06,"er"],[7,13,7.06,7.74,"onsdag"],[14,15,7.74,7.82,"i~de136e71704d"],[16,19,7.82,8.24,"dag~83a758a6ca25"]]},{"id":2,"start":9.38,"end":12.29,"text":"Håvard underviser i klassen.","zh":"霍瓦尔在班上讲课。","words":[[0,6,9.45,10.21,"håvard"],[7,17,10.42,11.4,"underviser"],[18,19,11.52,11.62,"i"],[20,27,11.62,12.14,"klassen"]]},{"id":3,"start":13.38,"end":16.73,"text":"De lytter og gjentar etter Håvard.","zh":"他们听，并跟着霍瓦尔重复。","words":[[0,2,13.45,13.82,"de"],[3,9,13.82,14.46,"lytter"],[10,12,14.62,14.8,"og"],[13,20,14.8,15.63,"gjentar"],[21,26,15.76,16.1,"etter~9d660b5aa14f"],[27,33,16.1,16.59,"håvard"]]},{"id":4,"start":18.02,"end":21.07,"text":"Han skriver ord og setninger.","zh":"他写单词和句子。","words":[[0,3,18.07,18.46,"han"],[4,11,18.46,19.08,"skriver"],[12,15,19.08,19.61,"ord"],[16,18,20.04,20.2,"og"],[19,28,20.2,20.92,"setninger"]]},{"id":5,"start":22.34,"end":25.63,"text":"I dag lærer de V2-regelen.","zh":"今天他们学习 V2 规则。","words":[[0,1,22.43,22.66,"i~de136e71704d"],[2,5,22.66,22.9,"dag~83a758a6ca25"],[6,11,22.9,23.7,"lærer~0769c7af9c2d"],[12,14,23.7,23.94,"de"],[15,25,23.94,25.55,"v2-regelen"]]},{"id":6,"start":27.04,"end":32.25,"text":"Viola og Biniam sitter sammen og skriver på pc.","zh":"维奥拉和比尼亚姆坐在一起，用电脑写东西。","words":[[0,5,27.1,27.88,"viola"],[6,8,27.88,28.12,"og"],[9,15,28.12,28.81,"biniam"],[16,22,29.16,29.64,"sitter"],[23,29,29.64,30.25,"sammen"],[30,32,30.48,30.66,"og"],[33,40,30.66,31.24,"skriver"],[41,43,31.24,31.54,"på~58f7c55ec6af"],[44,46,31.54,32.1,"pc"]]},{"id":7,"start":33.43,"end":35.15,"text":"Biniam rekker opp hånda.","zh":"比尼亚姆举起手。","words":[[0,6,33.49,34.12,"biniam"],[7,13,34.12,34.44,"rekker~dc25f007ad8b"],[14,17,34.44,34.62,"opp"],[18,23,34.62,35.0,"hånda"]]},{"id":8,"start":35.77,"end":37.22,"text":"Han forstår ikke.","zh":"他没听懂。","words":[[0,3,35.83,36.26,"han"],[4,11,36.26,36.72,"forstår"],[12,16,36.72,37.07,"ikke"]]},{"id":9,"start":39.29,"end":42.58,"text":"Hva betyr V2-regelen, Håvard?","speaker":"Biniam","zh":"霍瓦尔，V2 规则是什么意思？","words":[[0,3,39.35,39.84,"hva"],[4,9,39.84,40.5,"betyr"],[10,20,40.5,41.96,"v2-regelen"],[22,28,41.96,42.43,"håvard"]]},{"id":10,"start":43.8,"end":47.53,"text":"Verb har plass nummer to i en setning.","speaker":"Håvard","zh":"动词在句子中处于第二位。","words":[[0,4,43.87,44.55,"verb"],[5,8,44.72,44.94,"har"],[9,14,44.94,45.48,"plass"],[15,21,45.48,45.8,"nummer"],[22,24,45.8,46.17,"to"],[25,26,46.56,46.68,"i"],[27,29,46.68,46.82,"en~a939a9e56dc5"],[30,37,46.82,47.38,"setning"]]},{"id":11,"start":48.94,"end":51.74,"text":"Betyr verb det vi gjør?","speaker":"Biniam","zh":"动词的意思是我们做的事吗？","words":[[0,5,49.0,49.82,"betyr"],[6,10,49.82,50.45,"verb"],[11,14,50.6,50.92,"det~3883f1202f8e"],[15,17,50.92,51.2,"vi"],[18,22,51.2,51.59,"gjør"]]},{"id":12,"start":52.59,"end":60.77,"text":"Det er riktig, Biniam. Bor, snakker og skriver er verb.","speaker":"Håvard","zh":"没错，比尼亚姆。bor（住）、snakker（说）和 skriver（写）都是动词。","words":[[0,3,52.66,53.12,"det"],[4,6,53.12,53.32,"er"],[7,13,53.32,53.98,"riktig"],[15,21,54.08,54.73,"biniam"],[23,26,56.16,56.67,"bor"],[28,35,57.4,58.16,"snakker"],[36,38,58.52,58.7,"og"],[39,46,58.7,59.44,"skriver"],[47,49,59.88,60.18,"er"],[50,54,60.18,60.62,"verb"]]},{"id":13,"start":61.94,"end":67.57,"text":"Er kommer, går, liker også verb?","speaker":"Biniam","zh":"kommer（来）、går（走）、liker（喜欢）也是动词吗？","words":[[0,2,62.0,62.49,"er"],[3,9,62.78,63.48,"kommer"],[11,14,64.1,64.68,"går"],[16,21,65.22,65.98,"liker"],[22,26,66.44,66.98,"også"],[27,31,66.98,67.42,"verb"]]},{"id":14,"start":68.02,"end":70.31,"text":"Ja, det er riktig.","speaker":"Håvard","zh":"是的，没错。","words":[[0,2,68.08,68.5,"ja"],[4,7,69.12,69.54,"det"],[8,10,69.54,69.74,"er"],[11,17,69.74,70.16,"riktig"]]},{"id":15,"start":71.31,"end":72.91,"text":"Nå forstår jeg.","speaker":"Biniam","zh":"现在我明白了。","words":[[0,2,71.38,71.88,"nå~d531d47a7712"],[3,10,71.98,72.48,"forstår"],[11,14,72.48,72.76,"jeg"]]},{"id":16,"start":74.09,"end":92.57,"text":"I spørsmål med spørreord er verb nummer to. «Hvor bor du?» «Hva liker du?» I ja/nei-spørsmål er verb nummer én. «Liker du kaffe?» «Snakker du arabisk?»","speaker":"Håvard","zh":"在带疑问词的问句中，动词在第二位：“你住在哪里？”“你喜欢什么？”在是非问句中，动词在第一位：“你喜欢咖啡吗？”“你会说阿拉伯语吗？”","words":[[0,1,74.15,74.32,"i"],[2,10,74.32,75.16,"spørsmål"],[11,14,75.16,75.36,"med~737441dae6a6"],[15,24,75.36,76.3,"spørreord"],[25,27,76.56,76.74,"er"],[28,32,76.74,77.22,"verb"],[33,39,77.22,77.52,"nummer"],[40,42,77.52,77.88,"to"],[45,49,79.5,79.92,"hvor"],[50,53,79.92,80.28,"bor"],[54,56,80.28,80.6,"du"],[60,63,81.36,81.74,"hva"],[64,69,81.74,82.22,"liker"],[70,72,82.22,82.52,"du"],[75,76,84.02,84.22,"i"],[77,92,84.22,85.72,"ja/nei-spørsmål"],[93,95,85.72,85.9,"er"],[96,100,85.9,86.24,"verb"],[101,107,86.24,86.64,"nummer"],[108,110,86.64,87.12,"én"],[113,118,88.68,89.14,"liker"],[119,121,89.14,89.3,"du"],[122,127,89.3,89.86,"kaffe"],[131,138,90.92,91.5,"snakker"],[139,141,91.5,91.7,"du"],[142,149,91.7,92.42,"arabisk~3bb978ca6cd0"]]},{"id":17,"start":96.8,"end":99.61,"text":"Jeg forstår ikke «setning».","zh":"我不懂“setning”（句子）这个词。","words":[[0,3,96.86,97.32,"jeg"],[4,11,97.32,97.94,"forstår"],[12,16,97.94,98.42,"ikke"],[18,25,98.78,99.46,"setning"]]},{"id":18,"start":100.53,"end":102.29,"text":"Hva betyr det, Håvard?","zh":"霍瓦尔，这是什么意思？","words":[[0,3,100.59,100.92,"hva"],[4,9,100.92,101.32,"betyr"],[10,13,101.32,101.68,"det"],[15,21,101.68,102.14,"håvard"]]},{"id":19,"start":103.88,"end":107.71,"text":"En setning har subjekt og verb.","zh":"一个句子有主语和动词。","words":[[0,2,103.94,104.2,"en~a939a9e56dc5"],[3,10,104.2,104.92,"setning"],[11,14,105.3,105.64,"har"],[15,22,105.64,106.48,"subjekt"],[23,25,106.9,107.12,"og"],[26,30,107.12,107.56,"verb"]]},{"id":20,"start":108.57,"end":117.46,"text":"Setninger har stor bokstav først og punktum, spørsmålstegn eller utropstegn til slutt.","zh":"句子开头是大写字母，结尾是句号、问号或感叹号。","words":[[0,9,108.63,109.54,"setninger"],[10,13,109.74,110.04,"har"],[14,18,110.04,110.44,"stor~407825634dda"],[19,26,110.44,111.12,"bokstav"],[27,32,111.12,111.72,"først"],[33,35,112.14,112.32,"og"],[36,43,112.32,113.06,"punktum"],[45,58,113.5,114.62,"spørsmålstegn"],[59,64,114.94,115.38,"eller"],[65,75,115.38,116.42,"utropstegn"],[76,79,116.66,116.88,"til~a6400a95af28"],[80,85,116.88,117.31,"slutt~8b571dca0f08"]]},{"id":21,"start":121.41,"end":122.87,"text":"Hva liker du?","zh":"你喜欢什么？","words":[[0,3,121.47,121.96,"hva"],[4,9,121.96,122.46,"liker"],[10,12,122.46,122.72,"du"]]},{"id":22,"start":125.15,"end":127.07,"text":"Jeg liker vann.","zh":"我喜欢水。","words":[[0,3,125.21,125.86,"jeg"],[4,9,125.86,126.48,"liker"],[10,14,126.48,126.92,"vann"]]},{"id":23,"start":129.19,"end":131.65,"text":"Jeg liker God i norsk.","zh":"我喜欢《God i norsk》。","words":[[0,3,129.25,129.68,"jeg"],[4,9,129.68,130.31,"liker"],[10,13,130.56,130.88,"god~6da943f79ce0"],[14,15,130.88,131.02,"i~8c50789c626a"],[16,21,131.02,131.5,"norsk~4de5d75feae1"]]},{"id":24,"start":133.71,"end":136.11,"text":"Jeg liker musikk.","zh":"我喜欢音乐。","words":[[0,3,133.77,134.4,"jeg"],[4,9,134.64,135.34,"liker"],[10,16,135.34,135.96,"musikk"]]},{"id":25,"start":138.15,"end":140.02,"text":"Han liker fotball.","zh":"他喜欢足球。","words":[[0,3,138.21,138.7,"han"],[4,9,138.7,139.24,"liker"],[10,17,139.24,139.87,"fotball"]]},{"id":26,"start":142.08,"end":143.98,"text":"Jeg liker Skype.","zh":"我喜欢 Skype。","words":[[0,3,142.14,142.66,"jeg"],[4,9,142.66,143.26,"liker"],[10,15,143.26,143.83,"skype"]]},{"id":27,"start":145.97,"end":147.81,"text":"Hun liker is.","zh":"她喜欢冰淇淋。","words":[[0,3,146.03,146.54,"hun"],[4,9,146.54,147.08,"liker"],[10,12,147.08,147.66,"is"]]},{"id":28,"start":149.83,"end":152.13,"text":"Jeg liker klassen.","zh":"我喜欢这个班。","words":[[0,3,149.89,150.46,"jeg"],[4,9,150.64,151.34,"liker"],[10,17,151.34,151.98,"klassen"]]},{"id":29,"start":154.2,"end":155.97,"text":"Han liker henne.","zh":"他喜欢她。","words":[[0,3,154.26,154.84,"han"],[4,9,154.84,155.32,"liker"],[10,15,155.32,155.81,"henne"]]}],"lexicon":{"2.4":{"lemma":"2.4","zh":"第 2.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"arabisk":{"lemma":"arabisk","zh":"阿拉伯语","pos":"语言名／形容词","ref":"1-073","clip":"pronunciation/746311d8b0ceb97b8645.mp3"},"betyr":{"lemma":"bety","zh":"意思是；意味着","pos":"动词","form":"现在时","ref":null,"clip":"pronunciation/52f56f7728b57f1a5345.mp3"},"biniam":{"lemma":"Biniam","zh":"比尼亚姆（人名）","pos":"专名","ref":"1-021","clip":"pronunciation/e8a134405844f1e3c9ba.mp3"},"bokstav":{"lemma":"bokstav","zh":"字母","pos":"名词","ref":null,"clip":null},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"1-053","form":"现在时","clip":"pronunciation/c69e28f7e3751847918c.mp3"},"dag":{"lemma":"dag","zh":"一天；白天","pos":"名词","ref":"basics:time:dag","clip":"pronunciation/512d0f29088c76daad57.mp3"},"de":{"lemma":"de","zh":"他们/她们/它们（主格）","pos":"代词","ref":"1-062","clip":"pronunciation/959a45d44e6fcf58361e.mp3"},"det":{"lemma":"det","zh":"它（中性，主宾同形）；这；那；形式主语","pos":"代词","ref":"1-037","clip":"pronunciation/3c2d493a01a75bfecc82.mp3"},"du":{"lemma":"du","zh":"你（单数主格）","pos":"代词","ref":"1-036","clip":"pronunciation/601b2c2473811afea786.mp3"},"eller":{"lemma":"eller","zh":"或者","pos":"连词","ref":"basics:frequency:eller","clip":"pronunciation/563259f099deb633b0fc.mp3"},"en":{"lemma":"en","zh":"一（个）（阳性不定冠词）；一","pos":"冠词／数词","form":"阳性","ref":"1-106","clip":"pronunciation/dbd3a49d0d906b4ed921.mp3"},"er":{"lemma":"være","zh":"是；处于（å være 现在时）","pos":"动词","ref":"1-028","form":"现在时","clip":"pronunciation/cc7e4412564ba8a761bd.mp3"},"etter":{"lemma":"etter","zh":"之后","pos":"介词","ref":"3-062","clip":"pronunciation/1a0e73ca81b760707c80.mp3"},"forstår":{"lemma":"forstå","zh":"理解；听懂","pos":"动词","ref":"1-031","form":"现在时","clip":"pronunciation/e04