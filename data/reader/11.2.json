{"id":"11.2","title":"Det er typisk norsk å dra på hytta","audio":"audio/11.2.mp3","duration":153.06,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.5,"text":"11.2 Det er typisk norsk å dra på hytta","heading":true,"zh":"11.2 去小木屋度假很有挪威特色","words":[[0,4,0.15,1.19,"11.2"],[5,8,2.62,2.8,"det"],[9,11,2.8,3.06,"er"],[12,18,3.06,3.76,"typisk"],[19,24,3.76,4.24,"norsk~300c0d0c4f59"],[25,26,4.24,4.52,"å~0583da7a620a"],[27,30,4.52,4.74,"dra"],[31,33,4.74,4.94,"på"],[34,39,4.94,5.42,"hytta"]]},{"id":1,"start":7.52,"end":12.95,"text":"Synne studerer i Trondheim, men i helga besøker hun foreldrene.","zh":"辛妮在特隆赫姆上大学，但周末她回去看望父母。","words":[[0,5,7.6,8.12,"synne"],[6,14,8.12,8.68,"studerer"],[15,16,8.68,8.94,"i"],[17,26,8.94,9.42,"trondheim"],[28,31,10.3,10.78,"men"],[32,33,10.78,10.94,"i"],[34,39,10.94,11.34,"helga"],[40,47,11.34,11.94,"besøker"],[48,51,11.94,12.12,"hun"],[52,62,12.12,12.87,"foreldrene"]]},{"id":2,"start":14.03,"end":17.39,"text":"Hun møter Viola, og de snakker sammen.","zh":"她遇到了维奥拉，她们聊了起来。","words":[[0,3,14.11,14.3,"hun"],[4,9,14.3,14.78,"møter~427d7b57b797"],[10,15,14.78,15.26,"viola"],[17,19,16.02,16.14,"og"],[20,22,16.14,16.28,"de"],[23,30,16.28,16.68,"snakker"],[31,37,16.68,17.31,"sammen"]]},{"id":3,"start":19.11,"end":21.69,"text":"Hva skal du gjøre i ferien, Viola?","speaker":"Synne","zh":"维奥拉，你假期打算做什么？","words":[[0,3,19.19,19.42,"hva"],[4,8,19.42,19.6,"skal"],[9,11,19.6,19.86,"du"],[12,17,19.86,20.2,"gjøre"],[18,19,20.2,20.46,"i"],[20,26,20.46,20.98,"ferien"],[28,33,21.04,21.61,"viola"]]},{"id":4,"start":22.21,"end":32.47,"text":"Jeg skal være sammen med familien på hytta som ligger på fjellet. Jeg liker godt å være på hytta. Det er så koselig der. Og du, da?","speaker":"Viola","zh":"我要和这家人一起待在山上的小木屋里。我很喜欢待在小木屋。那里特别温馨。那你呢？","words":[[0,3,22.21,22.74,"jeg"],[4,8,22.74,22.92,"skal"],[9,13,22.92,23.12,"være"],[14,20,23.12,23.54,"sammen"],[21,24,23.54,23.68,"med"],[25,33,23.68,24.28,"familien"],[34,36,24.28,24.44,"på"],[37,42,24.44,24.86,"hytta"],[43,46,25.28,25.3,"som~b7970b8f941e"],[47,53,25.3,25.46,"ligger"],[54,56,25.46,25.66,"på"],[57,64,25.66,26.12,"fjellet"],[66,69,26.68,27.22,"jeg"],[70,75,27.22,27.6,"liker"],[76,80,27.6,27.82,"godt~51756f0f9616"],[81,82,27.82,27.96,"å~0583da7a620a"],[83,87,27.96,28.14,"være"],[88,90,28.14,28.32,"på"],[91,96,28.32,28.7,"hytta"],[98,101,29.32,29.54,"det"],[102,104,29.54,29.58,"er"],[105,107,29.58,29.74,"så~89d85de5e862"],[108,115,29.74,30.2,"koselig"],[116,119,30.2,30.4,"der"],[121,123,31.76,31.9,"og"],[124,126,31.9,32.08,"du"],[128,130,32.22,32.39,"da~38911ce223ea"]]},{"id":5,"start":33.05,"end":38.43,"text":"Jeg liker bedre å reise til utlandet i ferien. Jeg skal reise til Syden.","speaker":"Synne","zh":"我更喜欢假期出国旅行。我要去南方的温暖国家。","words":[[0,3,33.13,33.29,"jeg"],[4,9,33.29,33.63,"liker"],[10,15,33.63,34.09,"bedre~c3b163ae5f2b"],[16,17,34.09,34.27,"å~0583da7a620a"],[18,23,34.27,34.57,"reise~c20d06e82654"],[24,27,34.57,34.75,"til"],[28,36,34.75,35.45,"utlandet"],[37,38,35.45,35.61,"i"],[39,45,35.61,35.99,"ferien"],[47,50,36.34,36.96,"jeg"],[51,55,36.96,37.18,"skal"],[56,61,37.18,37.48,"reise~c20d06e82654"],[62,65,37.48,37.7,"til"],[66,71,37.7,38.35,"syden"]]},{"id":6,"start":38.96,"end":43.55,"text":"Jeg gleder meg til litt varmere vær, men hyttetur er også koselig.","zh":"我盼着暖和一点的天气，不过去小木屋度假也很惬意。","words":[[0,3,39.04,39.21,"jeg"],[4,10,39.21,39.69,"gleder"],[11,14,39.69,39.89,"meg"],[15,18,39.89,40.07,"til~053dd24981ff"],[19,23,40.07,40.25,"litt~54360be2a478"],[24,31,40.25,40.75,"varmere~a4845a136b89"],[32,35,40.75,41.09,"vær~c9ef13faaa9b"],[37,40,41.53,41.69,"men"],[41,49,41.69,42.23,"hyttetur"],[50,52,42.23,42.47,"er"],[53,57,42.47,42.73,"også"],[58,65,42.73,43.47,"koselig"]]},{"id":7,"start":43.81,"end":49.91,"text":"Ja, men hytta er enkel, uten strøm og vann, og vi må gå på utedo.","speaker":"Viola","zh":"是啊，不过那座小木屋很简陋，没有电也没有自来水，我们得去户外旱厕。","words":[[0,2,43.89,44.27,"ja"],[4,7,44.83,45.07,"men"],[8,13,45.07,45.53,"hytta"],[14,16,45.53,45.59,"er"],[17,22,45.59,46.07,"enkel"],[24,28,46.51,47.07,"uten"],[29,34,47.07,47.55,"strøm"],[35,37,47.55,47.77,"og"],[38,42,47.77,48.05,"vann"],[44,46,48.55,48.67,"og"],[47,49,48.67,48.79,"vi"],[50,52,48.79,48.91,"må"],[53,55,48.91,49.07,"gå"],[56,58,49.07,49.23,"på~8e88523449d6"],[59,64,49.23,49.83,"utedo"]]},{"id":8,"start":50.4,"end":53.59,"text":"Det er ganske vanlig med gammeldagse hytter i Norge.","speaker":"Synne","zh":"在挪威，老式小木屋挺常见的。","words":[[0,3,50.48,50.56,"det"],[4,6,50.56,50.66,"er"],[7,13,50.66,51.06,"ganske"],[14,20,51.06,51.58,"vanlig"],[21,24,51.58,51.74,"med~b70526d326cc"],[25,36,51.74,52.46,"gammeldagse"],[37,43,52.46,52.9,"hytter"],[44,45,52.9,53.04,"i"],[46,51,53.04,53.52,"norge~546b56e35dd5"]]},{"id":9,"start":54.7,"end":57.1,"text":"De kan være koseligere enn moderne hytter.","zh":"它们可能比现代的小木屋更温馨。","words":[[0,2,54.78,54.92,"de"],[3,6,54.92,55.08,"kan"],[7,11,55.08,55.22,"være"],[12,22,55.22,55.88,"koseligere"],[23,26,55.88,56.06,"enn"],[27,34,56.06,56.5,"moderne"],[35,41,56.5,57.02,"hytter"]]},{"id":10,"start":57.68,"end":59.47,"text":"Er det fint å gå på tur der?","zh":"那里适合徒步吗？","words":[[0,2,57.76,57.85,"er"],[3,6,57.85,57.95,"det"],[7,11,57.95,58.25,"fint"],[12,13,58.25,58.43,"å~0583da7a620a"],[14,16,58.43,58.53,"gå"],[17,19,58.53,58.67,"på~c4c5454bb2c7"],[20,23,58.67,58.95,"tur"],[24,27,58.95,59.39,"der"]]},{"id":11,"start":59.82,"end":63.8,"text":"Ja, veldig. I ferien skal vi gå opp på Galdhøpiggen.","speaker":"Viola","zh":"是的，非常适合。假期里我们要登上加尔赫峰。","words":[[0,2,59.9,60.12,"ja"],[4,10,60.18,60.72,"veldig"],[12,13,61.4,61.62,"i"],[14,20,61.62,62.1,"ferien"],[21,25,62.1,62.34,"skal"],[26,28,62.34,62.5,"vi"],[29,31,62.5,62.64,"gå"],[32,35,62.64,62.82,"opp"],[36,38,62.82,62.96,"på"],[39,51,62.96,63.72,"galdhøpiggen"]]},{"id":12,"start":64.35,"end":66.7,"text":"Det blir sikkert en fin tur.","speaker":"Synne","zh":"那一定会是一次很棒的远足。","words":[[0,3,64.43,64.7,"det"],[4,8,64.7,64.88,"blir"],[9,16,64.88,65.48,"sikkert~d382a896cfb2"],[17,19,65.48,65.66,"en~a939a9e56dc5"],[20,23,65.66,66.12,"fin"],[24,27,66.12,66.62,"tur"]]},{"id":13,"start":66.99,"end":81.52,"text":"Ja, jeg gleder meg. Vi skal gå lange turer og ta med matpakke og kakao. I Italia har vi mange fjelltopper som er mye høyere enn Galdhøpiggen, men jeg pleier ikke å gå på fjelltur i Italia.","speaker":"Viola","zh":"是啊，我很期待。我们要走很远的路，还要带上便当和热可可。在意大利我们有很多比加尔赫峰高得多的山峰，但我在意大利一般不去爬山。","words":[[0,2,67.07,67.3,"ja"],[4,7,67.76,67.9,"jeg"],[8,14,67.9,68.46,"gleder"],[15,18,68.46,68.6,"meg"],[20,22,69.34,69.46,"vi"],[23,27,69.46,69.62,"skal"],[28,30,69.62,69.8,"gå"],[31,36,69.8,70.22,"lange"],[37,42,70.22,70.86,"turer"],[43,45,70.86,71.2,"og"],[46,48,71.2,71.34,"ta~25a38a641c1e"],[49,52,71.34,71.52,"med~883b5b600e8d"],[53,61,71.52,72.2,"matpakke"],[62,64,72.2,72.38,"og"],[65,70,72.38,72.94,"kakao"],[72,73,73.52,74.14,"i"],[74,80,74.14,74.5,"italia"],[81,84,74.5,75.0,"har"],[85,87,75.0,75.1,"vi"],[88,93,75.1,75.42,"mange"],[94,105,75.42,76.2,"fjelltopper"],[106,109,76.2,76.54,"som~b7970b8f941e"],[110,112,76.54,76.68,"er"],[113,116,76.68,77.06,"mye~933c5a923198"],[117,123,77.06,77.4,"høyere~aac6d8c867d4"],[124,127,77.4,77.56,"enn"],[128,140,77.56,78.24,"galdhøpiggen"],[142,145,78.88,79.08,"men"],[146,149,79.08,79.2,"jeg"],[150,156,79.2,79.48,"pleier"],[157,161,79.48,79.68,"ikke"],[162,163,79.68,79.78,"å~0583da7a620a"],[164,166,79.78,79.9,"gå"],[167,169,79.9,80.06,"på~2460f2e26566"],[170,178,80.06,80.62,"fjelltur"],[179,180,80.62,80.88,"i"],[181,187,80.88,81.44,"italia"]]},{"id":14,"start":81.74,"end":83.81,"text":"Husk at det er kaldt på fjellet, da!","speaker":"Synne","zh":"那你可要记住，山上很冷哦！","words":[[0,4,81.82,82.18,"husk"],[5,7,82.18,82.3,"at"],[8,11,82.3,82.38,"det"],[12,14,82.38,82.5,"er"],[15,20,82.5,82.92,"kaldt"],[21,23,82.92,83.06,"på"],[24,31,83.06,83.46,"fjellet"],[33,35,83.46,83.73,"da~ff85ae6a2fc5"]]},{"id":15,"start":84.07,"end":86.68,"text":"Ja, det er mye varmere i Syden.","speaker":"Viola","zh":"是啊，南方暖和多了。","words":[[0,2,84.15,84.44,"ja"],[4,7,84.98,85.1,"det"],[8,10,85.1,85.18,"er"],[11,14,85.18,85.52,"mye~933c5a923198"],[15,22,85.52,85.98,"varmere~a4845a136b89"],[23,24,85.98,86.18,"i"],[25,30,86.18,86.6,"syden"]]},{"id":16,"start":87.24,"end":90.27,"text":"Jeg skal ligge på stranda og slappe av ei uke, jeg.","speaker":"Synne","zh":"我嘛，要在海滩上躺一个星期，好好放松。","words":[[0,3,87.32,87.5,"jeg"],[4,8,87.5,87.68,"skal"],[9,14,87.68,87.86,"ligge"],[15,17,87.86,88.06,"på"],[18,25,88.06,88.54,"stranda"],[26,28,88.54,88.7,"og"],[29,35,88.7,88.96,"slappe~f12305fe3dd8"],[36,38,88.96,89.28,"av~e2175249f92f"],[39,41,89.28,89.54,"ei~47aa2d18e376"],[42,45,89.54,89.88,"uke"],[47,50,89.92,90.19,"jeg"]]},{"id":17,"start":90.67,"end":95.66,"text":"Vi skal også slappe av. Vi skal lese bøker og spille spill.","speaker":"Viola","zh":"我们也要放松。我们要看书、玩游戏。","words":[[0,2,90.75,91.32,"vi"],[3,7,91.32,91.5,"skal"],[8,12,91.5,91.86,"også"],[13,19,91.86,92.18,"slappe~f12305fe3dd8"],[20,22,92.18,92.38,"av~e2175249f92f"],[24,26,92.78,93.32,"vi"],[27,31,93.32,93.46,"skal"],[32,36,93.46,93.72,"lese"],[37,42,93.72,94.46,"bøker"],[43,45,94.46,94.82,"og"],[46,52,94.82,95.14,"spille"],[53,58,95.14,95.58,"spill"]]},{"id":18,"start":95.86,"end":100.69,"text":"Det høres fint ut. Etter sydenturen skal jeg bare være hjemme.","speaker":"Synne","zh":"听起来不错。南方旅行回来后，我就只在家待着。","words":[[0,3,95.86,96.48,"det"],[4,9,96.48,96.82,"høres~8bd429d18814"],[10,14,96.82,97.16,"fint"],[15,17,97.16,97.42,"ut~e714e39fa98b"],[19,24,97.92,98.4,"etter"],[25,35,98.4,98.98,"sydenturen"],[36,40,98.98,99.46,"skal"],[41,44,99.46,99.6,"jeg"],[45,49,99.6,99.92,"bare"],[50,54,99.92,100.14,"være"],[55,61,100.14,100.61,"hjemme"]]},{"id":19,"start":101.56,"end":103.93,"text":"Pleier nordmenn å være hjemme i ferien?","speaker":"Viola","zh":"挪威人假期通常待在家里吗？","words":[[0,6,101.64,101.96,"pleier"],[7,15,101.96,102.36,"nordmenn"],[16,17,102.36,102.52,"å~0583da7a620a"],[18,22,102.52,102.7,"være"],[23,29,102.7,103.14,"hjemme"],[30,31,103.14,103.28,"i"],[32,38,103.28,103.85,"ferien"]]},{"id":20,"start":104.28,"end":111.67,"text":"Ja, mange nordmenn liker best å kose seg hjemme. Nå må jeg gå. Jeg skal hjem og spise middag.","speaker":"Synne","zh":"是的，很多挪威人最喜欢在家里舒舒服服地待着。我现在得走了。我要回家吃晚饭。","words":[[0,2,104.36,104.72,"ja"],[4,9,105.34,105.66,"mange"],[10,18,105.66,106.12,"nordmenn"],[19,24,106.12,106.44,"liker"],[25,29,106.44,106.76,"best~fbe395e1504f"],[30,31,106.76,106.94,"å~0583da7a620a"],[32,36,106.94,107.26,"kose~acdddfb47687"],[37,40,107.26,107.44,"seg"],[41,47,107.44,107.86,"hjemme"],[49,51,108.58,108.9,"nå~d531d47a7712"],[52,54,108.9,109.02,"må"],[55,58,109.02,109.2,"jeg"],[59,61,109.2,109.42,"gå"],[63,66,109.88,110.12,"jeg"],[67,71,110.12,110.32,"skal"],[72,76,110.32,110.64,"hjem~3f5fbf6a493e"],[77,79,110.64,110.8,"og"],[80,85,110.8,111.08,"spise"],[86,92,111.08,111.59,"middag"]]},{"id":21,"start":112.44,"end":120.76,"text":"Men klokka er jo bare fire. Å, ja! Nordmenn spiser middag mye tidligere enn italienere.","speaker":"Viola","zh":"可现在才四点啊。哦，对了！挪威人吃晚饭比意大利人早得多。","words":[[0,3,112.52,112.8,"men"],[4,10,112.8,113.32,"klokka"],[11,13,113.32,113.44,"er"],[14,16,113.44,113.56,"jo~72a7cae10a25"],[17,21,113.56,113.78,"bare"],[22,26,113.78,114.2,"fire"],[28,29,115.47,115.83,"å~496a48c13525"],[31,33,115.83,116.29,"ja"],[35,43,116.97,117.73,"nordmenn"],[44,50,117.73,118.17,"spiser"],[51,57,118.17,118.55,"middag"],[58,61,118.55,119.09,"mye~933c5a923198"],[62,71,119.27,119.61,"tidligere~53d6149549ad"],[72,75,119.61,119.87,"enn"],[76,86,119.87,120.68,"italienere"]]},{"id":22,"start":124.68,"end":129.2,"text":"Sammendrag Viola og Synne snakker om ferien.","zh":"摘要 维奥拉和辛妮在谈论假期。","words":[[0,10,124.76,125.52,"sammendrag"],[11,16,125.52,127.18,"viola"],[17,19,127.18,127.48,"og"],[20,25,127.48,127.92,"synne"],[26,33,127.92,128.28,"snakker"],[34,36,128.28,128.48,"om~52c0bdc828db"],[37,43,128.48,129.12,"ferien"]]},{"id":23,"start":129.64,"end":131.91,"text":"Viola skal på hyttetur.","zh":"维奥拉要去小木屋度假。","words":[[0,5,129.72,130.47,"viola"],[6,10,130.47,130.79,"skal"],[11,13,130.79,131.09,"på~7a031bcdff09"],[14,22,131.09,131.83,"hyttetur"]]},{"id":24,"start":132.77,"end":138.27,"text":"Familien som hun bor hos, har ei enkel hytte som har utedo.","zh":"她寄住的那家人有一座简陋的小木屋，用的是户外旱厕。","words":[[0,8,132.85,133.24,"familien"],[9,12,133.24,133.74,"som~b7970b8f941e"],[13,16,133.74,133.92,"hun"],[17,20,133.92,134.16,"bor"],[21,24,134.16,134.54,"hos"],[26,29,134.98,135.24,"har"],[30,32,135.24,135.6,"ei~47aa2d18e376"],[33,38,135.6,136.06,"enkel"],[39,44,136.06,136.58,"hytte"],[45,48,136.58,136.96,"som~b7970b8f941e"],[49,52,136.96,137.2,"har"],[53,58,137.2,138.19,"utedo"]]},{"id":25,"start":139.14,"end":141.5,"text":"Synne skal reise til Syden.","zh":"辛妮要去南方的温暖国家旅行。","words":[[0,5,139.22,139.71,"synne"],[6,10,139.71,140.03,"skal"],[11,16,140.03,140.53,"reise~c20d06e82654"],[17,20,140.53,140.71,"til"],[21,26,140.71,141.42,"syden"]]},{"id":26,"start":142.21,"end":144.39,"text":"Det er varmere der enn i Norge.","zh":"那里比挪威暖和。","words":[[0,3,142.29,142.37,"det"],[4,6,142.37,142.49,"er"],[7,14,142.49,143.07,"varmere~a4845a136b89"],[15,18,143.07,143.39,"der"],[19,22,143.39,143.77,"enn"],[23,24,143.77,143.83,"i"],[25,30,143.83,144.31,"norge~546b56e35dd5"]]},{"id":27,"start":145.21,"end":149.42,"text":"Både Synne og Viola skal slappe av i ferien.","zh":"辛妮和维奥拉假期都要好好放松。","words":[[0,4,145.29,145.79,"både"],[5,10,145.79,146.37,"synne"],[11,13,146.37,146.59,"og"],[14,19,146.59,147.05,"viola"],[20,24,147.05,147.67,"skal"],[25,31,147.67,148.19,"slappe~f12305fe3dd8"],[32,34,148.19,148.47,"av~e2175249f92f"],[35,36,148.47,148.75,"i"],[37,43,148.75,149.34,"ferien"]]}],"lexicon":{"11.2":{"lemma":"11.2","zh":"第 11.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":"pronunciation/b1d6b91b67c2afa5e322.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9