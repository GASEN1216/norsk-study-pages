{"id":"11.2","title":"Det er typisk norsk å dra på hytta","audio":"audio/11.2.mp3","duration":153.06,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.5,"text":"11.2 Det er typisk norsk å dra på hytta","heading":true,"zh":"11.2 去小木屋度假很有挪威特色","words":[[0,4,0.15,1.19,"11.2"],[5,8,2.62,2.8,"det"],[9,11,2.8,3.06,"er"],[12,18,3.06,3.76,"typisk"],[19,24,3.76,4.24,"norsk~300c0d0c4f59"],[25,26,4.24,4.52,"å~0583da7a620a"],[27,30,4.52,4.74,"dra"],[31,33,4.74,4.94,"på"],[34,39,4.94,5.42,"hytta"]]},{"id":1,"start":7.56,"end":13.03,"text":"Synne studerer i Trondheim, men i helga besøker hun foreldrene.","zh":"辛妮在特隆赫姆上大学，但周末她回去看望父母。","words":[[0,5,7.62,8.22,"synne"],[6,14,8.22,8.88,"studerer"],[15,16,8.88,8.98,"i"],[17,26,8.98,9.7,"trondheim"],[28,31,10.62,10.88,"men"],[32,33,10.88,11.0,"i"],[34,39,11.0,11.46,"helga"],[40,47,11.46,12.02,"besøker"],[48,51,12.02,12.26,"hun"],[52,62,12.26,12.88,"foreldrene"]]},{"id":2,"start":14.05,"end":17.46,"text":"Hun møter Viola, og de snakker sammen.","zh":"她遇到了维奥拉，她们聊了起来。","words":[[0,3,14.12,14.4,"hun"],[4,9,14.4,14.88,"møter~427d7b57b797"],[10,15,14.88,15.52,"viola"],[17,19,16.04,16.16,"og"],[20,22,16.16,16.34,"de"],[23,30,16.34,16.82,"snakker"],[31,37,16.82,17.32,"sammen"]]},{"id":3,"start":19.14,"end":21.74,"text":"Hva skal du gjøre i ferien, Viola?","speaker":"Synne","zh":"维奥拉，你假期打算做什么？","words":[[0,3,19.2,19.46,"hva"],[4,8,19.46,19.7,"skal"],[9,11,19.7,19.96,"du"],[12,17,19.96,20.36,"gjøre"],[18,19,20.36,20.5,"i"],[20,26,20.5,21.04,"ferien"],[28,33,21.04,21.59,"viola"]]},{"id":4,"start":22.44,"end":32.53,"text":"Jeg skal være sammen med familien på hytta som ligger på fjellet. Jeg liker godt å være på hytta. Det er så koselig der. Og du, da?","speaker":"Viola","zh":"我要和这家人一起待在山上的小木屋里。我很喜欢待在小木屋。那里特别温馨。那你呢？","words":[[0,3,22.5,22.78,"jeg"],[4,8,22.78,23.02,"skal"],[9,13,23.02,23.26,"være"],[14,20,23.26,23.6,"sammen"],[21,24,23.6,23.76,"med"],[25,33,23.76,24.36,"familien"],[34,36,24.36,24.48,"på"],[37,42,24.48,25.02,"hytta"],[43,46,25.18,25.32,"som~b7970b8f941e"],[47,53,25.32,25.58,"ligger"],[54,56,25.58,25.74,"på"],[57,64,25.74,26.29,"fjellet"],[66,69,27.1,27.24,"jeg"],[70,75,27.24,27.68,"liker"],[76,80,27.68,27.92,"godt~51756f0f9616"],[81,82,27.92,28.0,"å~0583da7a620a"],[83,87,28.0,28.24,"være"],[88,90,28.24,28.36,"på"],[91,96,28.36,28.86,"hytta"],[98,101,29.4,29.52,"det"],[102,104,29.52,29.6,"er"],[105,107,29.6,29.78,"så~89d85de5e862"],[108,115,29.78,30.24,"koselig"],[116,119,30.24,30.63,"der"],[121,123,31.82,31.96,"og"],[124,126,31.96,32.14,"du"],[128,130,32.14,32.38,"da~38911ce223ea"]]},{"id":5,"start":33.09,"end":38.51,"text":"Jeg liker bedre å reise til utlandet i ferien. Jeg skal reise til Syden.","speaker":"Synne","zh":"我更喜欢假期出国旅行。我要去南方的温暖国家。","words":[[0,3,33.15,33.42,"jeg"],[4,9,33.42,33.78,"liker"],[10,15,33.78,34.22,"bedre~c3b163ae5f2b"],[16,17,34.22,34.32,"å~0583da7a620a"],[18,23,34.32,34.66,"reise~c20d06e82654"],[24,27,34.66,34.92,"til"],[28,36,34.92,35.54,"utlandet"],[37,38,35.54,35.66,"i"],[39,45,35.66,36.3,"ferien"],[47,50,36.82,37.04,"jeg"],[51,55,37.04,37.26,"skal"],[56,61,37.26,37.54,"reise~c20d06e82654"],[62,65,37.54,37.82,"til"],[66,71,37.82,38.36,"syden"]]},{"id":6,"start":39.0,"end":43.58,"text":"Jeg gleder meg til litt varmere vær, men hyttetur er også koselig.","zh":"我盼着暖和一点的天气，不过去小木屋度假也很惬意。","words":[[0,3,39.06,39.34,"jeg"],[4,10,39.34,39.78,"gleder"],[11,14,39.78,39.98,"meg"],[15,18,39.98,40.14,"til~053dd24981ff"],[19,23,40.14,40.36,"litt~54360be2a478"],[24,31,40.36,40.84,"varmere~a4845a136b89"],[32,35,40.84,41.27,"vær~c9ef13faaa9b"],[37,40,41.58,41.76,"men"],[41,49,41.76,42.42,"hyttetur"],[50,52,42.42,42.56,"er"],[53,57,42.56,42.88,"også"],[58,65,42.88,43.43,"koselig"]]},{"id":7,"start":43.88,"end":50.01,"text":"Ja, men hytta er enkel, uten strøm og vann, og vi må gå på utedo.","speaker":"Viola","zh":"是啊，不过那座小木屋很简陋，没有电也没有自来水，我们得去户外旱厕。","words":[[0,2,43.95,44.45,"ja"],[4,7,44.96,45.16,"men"],[8,13,45.16,45.54,"hytta"],[14,16,45.54,45.76,"er"],[17,22,45.76,46.35,"enkel"],[24,28,46.8,47.2,"uten"],[29,34,47.2,47.7,"strøm"],[35,37,47.7,47.82,"og"],[38,42,47.82,48.3,"vann"],[44,46,48.6,48.7,"og"],[47,49,48.7,48.84,"vi"],[50,52,48.84,48.98,"må"],[53,55,48.98,49.16,"gå"],[56,58,49.16,49.36,"på~8e88523449d6"],[59,64,49.36,49.86,"utedo"]]},{"id":8,"start":50.39,"end":53.65,"text":"Det er ganske vanlig med gammeldagse hytter i Norge.","speaker":"Synne","zh":"在挪威，老式小木屋挺常见的。","words":[[0,3,50.45,50.58,"det"],[4,6,50.58,50.72,"er"],[7,13,50.72,51.18,"ganske"],[14,20,51.18,51.66,"vanlig"],[21,24,51.66,51.84,"med~b70526d326cc"],[25,36,51.84,52.54,"gammeldagse"],[37,43,52.54,53.0,"hytter"],[44,45,53.0,53.08,"i"],[46,51,53.08,53.5,"norge~546b56e35dd5"]]},{"id":9,"start":54.73,"end":57.16,"text":"De kan være koseligere enn moderne hytter.","zh":"它们可能比现代的小木屋更温馨。","words":[[0,2,54.8,54.96,"de"],[3,6,54.96,55.14,"kan"],[7,11,55.14,55.36,"være"],[12,22,55.36,55.96,"koseligere"],[23,26,55.96,56.12,"enn"],[27,34,56.12,56.56,"moderne"],[35,41,56.56,57.01,"hytter"]]},{"id":10,"start":57.72,"end":59.53,"text":"Er det fint å gå på tur der?","zh":"那里适合徒步吗？","words":[[0,2,57.78,57.88,"er"],[3,6,57.88,58.04,"det"],[7,11,58.04,58.36,"fint"],[12,13,58.36,58.44,"å~0583da7a620a"],[14,16,58.44,58.6,"gå"],[17,19,58.6,58.76,"på~c4c5454bb2c7"],[20,23,58.76,59.04,"tur"],[24,27,59.04,59.38,"der"]]},{"id":11,"start":59.85,"end":63.85,"text":"Ja, veldig. I ferien skal vi gå opp på Galdhøpiggen.","speaker":"Viola","zh":"是的，非常适合。假期里我们要登上加尔赫峰。","words":[[0,2,59.91,60.24,"ja"],[4,10,60.24,60.94,"veldig"],[12,13,61.54,61.68,"i"],[14,20,61.68,62.2,"ferien"],[21,25,62.2,62.42,"skal"],[26,28,62.42,62.54,"vi"],[29,31,62.54,62.7,"gå"],[32,35,62.7,62.88,"opp"],[36,38,62.88,63.0,"på"],[39,51,63.0,63.7,"galdhøpiggen"]]},{"id":12,"start":64.52,"end":66.76,"text":"Det blir sikkert en fin tur.","speaker":"Synne","zh":"那一定会是一次很棒的远足。","words":[[0,3,64.58,64.78,"det"],[4,8,64.78,65.04,"blir"],[9,16,65.04,65.6,"sikkert~d382a896cfb2"],[17,19,65.6,65.84,"en~a939a9e56dc5"],[20,23,65.84,66.2,"fin"],[24,27,66.2,66.61,"tur"]]},{"id":13,"start":67.03,"end":81.58,"text":"Ja, jeg gleder meg. Vi skal gå lange turer og ta med matpakke og kakao. I Italia har vi mange fjelltopper som er mye høyere enn Galdhøpiggen, men jeg pleier ikke å gå på fjelltur i Italia.","speaker":"Viola","zh":"是啊，我很期待。我们要走很远的路，还要带上便当和热可可。在意大利我们有很多比加尔赫峰高得多的山峰，但我在意大利一般不去爬山。","words":[[0,2,67.09,67.52,"ja"],[4,7,67.82,68.02,"jeg"],[8,14,68.02,68.5,"gleder"],[15,18,68.5,68.86,"meg"],[20,22,69.4,69.52,"vi"],[23,27,69.52,69.7,"skal"],[28,30,69.7,69.96,"gå"],[31,36,69.96,70.38,"lange"],[37,42,70.38,71.0,"turer"],[43,45,71.12,71.24,"og"],[46,48,71.24,71.42,"ta~25a38a641c1e"],[49,52,71.42,71.58,"med~883b5b600e8d"],[53,61,71.58,72.3,"matpakke"],[62,64,72.3,72.4,"og"],[65,70,72.4,73.12,"kakao"],[72,73,74.04,74.14,"i"],[74,80,74.14,74.92,"italia"],[81,84,74.92,75.04,"har"],[85,87,75.04,75.2,"vi"],[88,93,75.2,75.6,"mange"],[94,105,75.6,76.42,"fjelltopper"],[106,109,76.42,76.6,"som~b7970b8f941e"],[110,112,76.6,76.78,"er"],[113,116,76.78,77.12,"mye~933c5a923198"],[117,123,77.12,77.44,"høyere~aac6d8c867d4"],[124,127,77.44,77.64,"enn"],[128,140,77.64,78.44,"galdhøpiggen"],[142,145,78.96,79.08,"men"],[146,149,79.08,79.24,"jeg"],[150,156,79.24,79.56,"pleier"],[157,161,79.56,79.74,"ikke"],[162,163,79.74,79.8,"å~0583da7a620a"],[164,166,79.8,79.96,"gå"],[167,169,79.96,80.12,"på~2460f2e26566"],[170,178,80.12,80.8,"fjelltur"],[179,180,80.8,80.92,"i"],[181,187,80.92,81.43,"italia"]]},{"id":14,"start":81.84,"end":83.87,"text":"Husk at det er kaldt på fjellet, da!","speaker":"Synne","zh":"那你可要记住，山上很冷哦！","words":[[0,4,81.9,82.22,"husk"],[5,7,82.22,82.32,"at"],[8,11,82.32,82.42,"det"],[12,14,82.42,82.58,"er"],[15,20,82.58,82.98,"kaldt"],[21,23,82.98,83.14,"på"],[24,31,83.14,83.48,"fjellet"],[33,35,83.48,83.72,"da~ff85ae6a2fc5"]]},{"id":15,"start":84.11,"end":86.76,"text":"Ja, det er mye varmere i Syden.","speaker":"Viola","zh":"是啊，南方暖和多了。","words":[[0,2,84.17,84.58,"ja"],[4,7,85.0,85.1,"det"],[8,10,85.1,85.32,"er"],[11,14,85.32,85.64,"mye~933c5a923198"],[15,22,85.64,86.1,"varmere~a4845a136b89"],[23,24,86.1,86.22,"i"],[25,30,86.22,86.61,"syden"]]},{"id":16,"start":87.28,"end":90.33,"text":"Jeg skal ligge på stranda og slappe av ei uke, jeg.","speaker":"Synne","zh":"我嘛，要在海滩上躺一个星期，好好放松。","words":[[0,3,87.34,87.54,"jeg"],[4,8,87.54,87.72,"skal"],[9,14,87.72,87.98,"ligge"],[15,17,87.98,88.12,"på"],[18,25,88.12,88.6,"stranda"],[26,28,88.6,88.72,"og"],[29,35,88.72,89.12,"slappe~f12305fe3dd8"],[36,38,89.12,89.42,"av~e2175249f92f"],[39,41,89.42,89.64,"ei~47aa2d18e376"],[42,45,89.64,89.92,"uke"],[47,50,89.92,90.18,"jeg"]]},{"id":17,"start":91.02,"end":95.73,"text":"Vi skal også slappe av. Vi skal lese bøker og spille spill.","speaker":"Viola","zh":"我们也要放松。我们要看书、玩游戏。","words":[[0,2,91.08,91.36,"vi"],[3,7,91.36,91.64,"skal"],[8,12,91.64,91.94,"også"],[13,19,91.94,92.26,"slappe~f12305fe3dd8"],[20,22,92.26,92.6,"av~e2175249f92f"],[24,26,93.22,93.34,"vi"],[27,31,93.34,93.54,"skal"],[32,36,93.54,93.92,"lese"],[37,42,93.92,94.74,"bøker"],[43,45,94.74,94.86,"og"],[46,52,94.86,95.22,"spille"],[53,58,95.22,95.58,"spill"]]},{"id":18,"start":96.3,"end":100.75,"text":"Det høres fint ut. Etter sydenturen skal jeg bare være hjemme.","speaker":"Synne","zh":"听起来不错。南方旅行回来后，我就只在家待着。","words":[[0,3,96.36,96.52,"det"],[4,9,96.52,96.9,"høres~8bd429d18814"],[10,14,96.9,97.28,"fint"],[15,17,97.28,97.74,"ut~e714e39fa98b"],[19,24,98.16,98.5,"etter"],[25,35,98.5,99.32,"sydenturen"],[36,40,99.32,99.5,"skal"],[41,44,99.5,99.7,"jeg"],[45,49,99.7,100.0,"bare"],[50,54,100.0,100.22,"være"],[55,61,100.22,100.6,"hjemme"]]},{"id":19,"start":101.6,"end":103.93,"text":"Pleier nordmenn å være hjemme i ferien?","speaker":"Viola","zh":"挪威人假期通常待在家里吗？","words":[[0,6,101.66,102.02,"pleier"],[7,15,102.02,102.48,"nordmenn"],[16,17,102.48,102.58,"å~0583da7a620a"],[18,22,102.58,102.78,"være"],[23,29,102.78,103.22,"hjemme"],[30,31,103.22,103.32,"i"],[32,38,103.32,103.78,"ferien"]]},{"id":20,"start":104.35,"end":111.73,"text":"Ja, mange nordmenn liker best å kose seg hjemme. Nå må jeg gå. Jeg skal hjem og spise middag.","speaker":"Synne","zh":"是的，很多挪威人最喜欢在家里舒舒服服地待着。我现在得走了。我要回家吃晚饭。","words":[[0,2,104.41,104.86,"ja"],[4,9,105.44,105.8,"mange"],[10,18,105.8,106.2,"nordmenn"],[19,24,106.2,106.52,"liker"],[25,29,106.52,106.88,"best~fbe395e1504f"],[30,31,106.88,106.98,"å~0583da7a620a"],[32,36,106.98,107.34,"kose~acdddfb47687"],[37,40,107.34,107.54,"seg"],[41,47,107.54,108.04,"hjemme"],[49,51,108.78,108.94,"nå~d531d47a7712"],[52,54,108.94,109.06,"må"],[55,58,109.06,109.26,"jeg"],[59,61,109.26,109.58,"gå"],[63,66,109.96,110.18,"jeg"],[67,71,110.18,110.42,"skal"],[72,76,110.42,110.74,"hjem~3f5fbf6a493e"],[77,79,110.74,110.82,"og"],[80,85,110.82,111.14,"spise"],[86,92,111.14,111.58,"middag"]]},{"id":21,"start":112.48,"end":120.81,"text":"Men klokka er jo bare fire. Å, ja! Nordmenn spiser middag mye tidligere enn italienere.","speaker":"Viola","zh":"可现在才四点啊。哦，对了！挪威人吃晚饭比意大利人早得多。","words":[[0,3,112.54,113.02,"men"],[4,10,113.02,113.36,"klokka"],[11,13,113.36,113.48,"er"],[14,16,113.48,113.62,"jo~72a7cae10a25"],[17,21,113.62,113.92,"bare"],[22,26,113.92,114.48,"fire"],[28,29,115.68,116.0,"å~496a48c13525"],[31,33,116.0,116.34,"ja"],[35,43,117.32,117.86,"nordmenn"],[44,50,117.86,118.26,"spiser"],[51,57,118.26,118.8,"middag"],[58,61,118.8,119.18,"mye~933c5a923198"],[62,71,119.18,119.72,"tidligere~53d6149549ad"],[72,75,119.72,119.9,"enn"],[76,86,119.9,120.66,"italienere"]]},{"id":22,"start":124.72,"end":129.25,"text":"Sammendrag Viola og Synne snakker om ferien.","zh":"摘要 维奥拉和辛妮在谈论假期。","words":[[0,10,124.78,125.76,"sammendrag"],[11,16,126.74,127.4,"viola"],[17,19,127.4,127.54,"og"],[20,25,127.54,128.0,"synne"],[26,33,128.0,128.38,"snakker"],[34,36,128.38,128.54,"om~52c0bdc828db"],[37,43,128.54,129.1,"ferien"]]},{"id":23,"start":129.97,"end":131.97,"text":"Viola skal på hyttetur.","zh":"维奥拉要去小木屋度假。","words":[[0,5,130.03,130.7,"viola"],[6,10,130.7,131.02,"skal"],[11,13,131.02,131.14,"på~7a031bcdff09"],[14,22,131.14,131.81,"hyttetur"]]},{"id":24,"start":132.81,"end":138.33,"text":"Familien som hun bor hos, har ei enkel hytte som har utedo.","zh":"她寄住的那家人有一座简陋的小木屋，用的是户外旱厕。","words":[[0,8,132.88,133.62,"familien"],[9,12,133.62,133.82,"som~b7970b8f941e"],[13,16,133.82,134.0,"hun"],[17,20,134.0,134.28,"bor"],[21,24,134.28,134.75,"hos"],[26,29,135.06,135.4,"har"],[30,32,135.4,135.72,"ei~47aa2d18e376"],[33,38,135.72,136.14,"enkel"],[39,44,136.14,136.82,"hytte"],[45,48,136.82,137.04,"som~b7970b8f941e"],[49,52,137.04,137.42,"har"],[53,58,137.42,138.18,"utedo"]]},{"id":25,"start":139.17,"end":141.56,"text":"Synne skal reise til Syden.","zh":"辛妮要去南方的温暖国家旅行。","words":[[0,5,139.23,139.92,"synne"],[6,10,139.92,140.28,"skal"],[11,16,140.28,140.62,"reise~c20d06e82654"],[17,20,140.62,140.88,"til"],[21,26,140.88,141.41,"syden"]]},{"id":26,"start":142.19,"end":144.44,"text":"Det er varmere der enn i Norge.","zh":"那里比挪威暖和。","words":[[0,3,142.25,142.4,"det"],[4,6,142.4,142.6,"er"],[7,14,142.6,143.2,"varmere~a4845a136b89"],[15,18,143.2,143.6,"der"],[19,22,143.6,143.8,"enn"],[23,24,143.8,143.88,"i"],[25,30,143.88,144.29,"norge~546b56e35dd5"]]},{"id":27,"start":145.24,"end":149.47,"text":"Både Synne og Viola skal slappe av i ferien.","zh":"辛妮和维奥拉假期都要好好放松。","words":[[0,4,145.3,145.94,"både"],[5,10,145.94,146.48,"synne"],[11,13,146.48,146.64,"og"],[14,19,146.64,147.25,"viola"],[20,24,147.52,147.82,"skal"],[25,31,147.82,148.3,"slappe~f12305fe3dd8"],[32,34,148.3,148.68,"av~e2175249f92f"],[35,36,148.68,148.8,"i"],[37,43,148.8,149.31,"ferien"]]}],"lexicon":{"11.2":{"lemma":"11.2","zh":"第 11.2 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":"pronunciation/b1d6b91b67c2afa5e322.mp3"},"av":{"lemma":"av","zh":"……的；从；由","pos":"介词","ref":"pa-vei-3-029","clip":"pronunciation/27a26bca625b22397190.mp3"},"bare":{"lemma":"bare","zh":"只；仅仅；就","pos":"副词","ref":"basics:frequency:bare","clip":"pronunciation/9b828d53402d6e332ef0.mp3"},"b