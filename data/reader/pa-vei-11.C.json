{"id":"pa-vei-11.C","bookId":"pa-vei-textbook","readingId":"11.C","title":"En ulykke","audio":"audio/pa-vei/11.C.mp3","duration":125.904,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.94,"end":2.025,"text":"Det ringer på døra.","zh":"门铃响了。","words":[[0,3,0.94,1.103,"det"],[4,10,1.103,1.505,"ringer"],[11,13,1.54,1.665,"på"],[14,18,1.68,2.025,"døra"]]},{"id":1,"start":3.54,"end":8.625,"text":"Michelle åpner, og Elias, sønnen til naboen, står utenfor.","zh":"米歇尔打开门，邻居的儿子埃利亚斯站在门外。","words":[[0,8,3.54,4.085,"michelle"],[9,14,4.1,4.585,"åpner"],[16,18,5.3,5.425,"og"],[19,24,5.44,6.045,"elias"],[26,32,6.48,6.863,"sønnen"],[33,36,6.863,7.025,"til"],[37,43,7.08,7.605,"naboen"],[45,49,7.9,8.143,"står"],[50,57,8.143,8.625,"utenfor"]]},{"id":2,"start":10.4,"end":12.765,"text":"Hjelp! Pappa ligger på gulvet!","zh":"救命！爸爸躺在地板上！","words":[[0,5,10.4,10.945,"hjelp"],[7,12,11.32,11.705,"pappa"],[13,19,11.76,12.053,"ligger"],[20,22,12.053,12.185,"på"],[23,29,12.26,12.765,"gulvet"]],"speaker":"Elias"},{"id":3,"start":13.912,"end":14.597,"text":"Hva har skjedd?","zh":"发生什么事了？","words":[[0,3,13.912,14.077,"hva"],[4,7,14.092,14.255,"har"],[8,14,14.255,14.597,"skjedd"]],"speaker":"Michelle"},{"id":4,"start":15.832,"end":17.737,"text":"Han har falt ned fra stigen.","zh":"他从梯子上掉下来了。","words":[[0,3,15.832,16.005,"han"],[4,7,16.005,16.177,"har"],[8,12,16.252,16.715,"falt"],[13,16,16.715,16.864,"ned"],[17,20,16.864,17.017,"fra"],[21,27,17.092,17.737,"stigen"]],"speaker":"Elias"},{"id":5,"start":18.652,"end":19.637,"text":"Har han skadet seg?","zh":"他受伤了吗？","words":[[0,3,18.652,18.825,"har"],[4,7,18.825,18.957,"han"],[8,14,18.992,19.445,"skadet"],[15,18,19.445,19.637,"seg"]],"speaker":"Michelle"},{"id":6,"start":20.592,"end":21.417,"text":"Jeg tror det.","zh":"我想是的。","words":[[0,3,20.592,20.777,"jeg"],[4,8,20.812,21.244,"tror"],[9,12,21.244,21.417,"det"]],"speaker":"Elias"},{"id":7,"start":22.232,"end":23.397,"text":"Jeg kommer med en gang.","zh":"我马上就来。","words":[[0,3,22.232,22.397,"jeg"],[4,10,22.412,22.744,"kommer"],[11,14,22.744,22.897,"med"],[15,17,22.952,23.154,"en"],[18,22,23.154,23.397,"gang"]],"speaker":"Michelle"},{"id":8,"start":25.062,"end":29.647,"text":"Michelle løper ned trappa til 3. etasje og inn til naboen.","zh":"米歇尔跑下楼梯，来到三楼，走进邻居家。","words":[[0,8,25.062,25.647,"michelle"],[9,14,25.802,26.264,"løper"],[15,18,26.264,26.467,"ned"],[19,25,26.482,26.847,"trappa"],[26,29,26.862,27.027,"til"],[30,31,27.122,27.555,"3"],[33,39,27.555,28.047,"etasje"],[40,42,28.662,28.787,"og"],[43,46,28.842,29.065,"inn"],[47,50,29.065,29.224,"til"],[51,57,29.224,29.647,"naboen"]]},{"id":9,"start":30.622,"end":34.107,"text":"Gaute ligger på gulvet. Han er stille.","zh":"高特躺在地板上，一声不响。","words":[[0,5,30.622,31.105,"gaute"],[6,12,31.105,31.404,"ligger"],[13,15,31.404,31.544,"på"],[16,22,31.544,31.887,"gulvet"],[24,27,33.362,33.527,"han"],[28,30,33.542,33.667,"er"],[31,37,33.702,34.107,"stille"]]},{"id":10,"start":35.862,"end":39.807,"text":"Michelle bøyer seg ned og klapper ham forsiktig på kinnet.","zh":"米歇尔弯下腰，轻轻拍他的脸颊。","words":[[0,8,35.862,36.385,"michelle"],[9,14,36.385,36.745,"bøyer"],[15,18,36.745,36.927,"seg"],[19,22,36.982,37.347,"ned"],[23,25,37.882,38.007,"og"],[26,33,38.022,38.495,"klapper"],[34,37,38.495,38.647,"ham"],[38,47,38.742,39.355,"forsiktig"],[48,50,39.355,39.465,"på"],[51,57,39.465,39.807,"kinnet"]]},{"id":11,"start":41.582,"end":43.767,"text":"Hei, er du våken?","zh":"喂，你醒着吗？","words":[[0,3,41.582,41.927,"hei"],[5,7,42.922,43.044,"er"],[8,10,43.044,43.167,"du"],[11,16,43.202,43.767,"våken"]],"speaker":"Michelle"},{"id":12,"start":45.202,"end":47.327,"text":"Er det deg, Michelle?","zh":"是你吗，米歇尔？","words":[[0,2,45.202,45.364,"er"],[3,6,45.364,45.547,"det"],[7,10,45.882,46.187,"deg"],[12,20,46.722,47.327,"michelle"]],"speaker":"Gaute"},{"id":13,"start":48.462,"end":51.587,"text":"Ja, det er meg. Har du skadet deg?","zh":"是的，是我。你受伤了吗？","words":[[0,2,48.462,48.607,"ja"],[4,7,49.262,49.444,"det"],[8,10,49.444,49.584,"er"],[11,14,49.584,49.787,"meg"],[16,19,50.662,50.805,"har"],[20,22,50.805,50.927,"du"],[23,29,50.942,51.415,"skadet"],[30,33,51.415,51.587,"deg"]],"speaker":"Michelle"},{"id":14,"start":52.732,"end":58.217,"text":"Ja, det gjør vondt. Jeg tror jeg har brukket armen.","zh":"是的，很疼。我觉得我的手臂骨折了。","words":[[0,2,52.732,52.917,"ja"],[4,7,54.092,54.255,"det"],[8,12,54.255,54.457,"gjør"],[13,18,54.532,55.097,"vondt"],[20,23,56.752,56.915,"jeg"],[24,28,56.915,57.124,"tror"],[29,32,57.124,57.245,"jeg"],[33,36,57.245,57.374,"har"],[37,44,57.374,57.777,"brukket"],[45,50,57.812,58.217,"armen"]],"speaker":"Gaute"},{"id":15,"start":59.332,"end":62.257,"text":"Ligg stille. Jeg skal undersøke deg litt.","zh":"躺着别动。我给你检查一下。","words":[[0,4,59.332,59.597,"ligg"],[5,11,59.652,60.057,"stille"],[13,16,60.752,60.904,"jeg"],[17,21,60.904,61.097,"skal"],[22,31,61.132,61.814,"undersøke"],[32,35,61.814,61.995,"deg"],[36,40,61.995,62.257,"litt"]],"speaker":"Michelle"},{"id":16,"start":63.502,"end":66.587,"text":"Au! Det gjør vondt i skulderen også.","zh":"哎哟！肩膀也疼。","words":[[0,2,63.502,63.607,"au"],[4,7,65.002,65.154,"det"],[8,12,65.154,65.327,"gjør"],[13,18,65.362,65.684,"vondt"],[19,20,65.684,65.787,"i"],[21,30,65.802,66.334,"skulderen"],[31,35,66.334,66.587,"også"]],"speaker":"Gaute"},{"id":17,"start":67.882,"end":71.887,"text":"Du har slått deg kraftig. Vi ringer etter ambulanse.","zh":"你摔得很重。我们打电话叫救护车。","words":[[0,2,67.882,68.014,"du"],[3,6,68.014,68.167,"har"],[7,12,68.202,68.544,"slått"],[13,16,68.544,68.707,"deg"],[17,24,68.842,69.507,"kraftig"],[26,28,70.542,70.667,"vi"],[29,35,70.742,71.064,"ringer"],[36,41,71.064,71.294,"etter"],[42,51,71.294,71.887,"ambulanse"]],"speaker":"Michelle"},{"id":18,"start":72.832,"end":79.957,"text":"Jeg har så mye å gjøre. Jeg må male ferdig taket, og Elias kan ikke være alene.","zh":"我还有很多事要做。我得把天花板刷完，而且埃利亚斯不能一个人待着。","words":[[0,3,72.832,72.997,"jeg"],[4,7,73.032,73.277,"har"],[8,10,73.292,73.434,"så"],[11,14,73.434,73.684,"mye"],[15,16,73.684,73.777,"å"],[17,22,73.792,74.217,"gjøre"],[24,27,75.052,75.184,"jeg"],[28,30,75.184,75.317,"må"],[31,35,75.372,75.837,"male"],[36,42,75.852,76.197,"ferdig"],[43,48,76.232,77.097,"taket"],[50,52,77.852,77.997,"og"],[53,58,78.372,78.937,"elias"],[59,62,78.952,79.157,"kan"],[63,67,79.172,79.374,"ikke"],[68,72,79.374,79.535,"være"],[73,78,79.535,79.957,"alene"]],"speaker":"Gaute"},{"id":19,"start":81.012,"end":85.157,"text":"Ikke tenk på det! Vi skal hjelpe deg. Elias kan bo hos oss.","zh":"别担心这些！我们会帮你的。埃利亚斯可以住在我们家。","words":[[0,4,81.012,81.277,"ikke"],[5,9,81.292,81.577,"tenk"],[10,12,81.592,81.704,"på"],[13,16,81.704,81.857,"det"],[18,20,82.372,82.497,"vi"],[21,25,82.592,82.764,"skal"],[26,32,82.764,83.075,"hjelpe"],[33,36,83.075,83.237,"deg"],[38,43,83.752,84.277,"elias"],[44,47,84.352,84.535,"kan"],[48,50,84.535,84.677,"bo"],[51,54,84.692,84.915,"hos"],[55,58,84.915,85.157,"oss"]],"speaker":"Michelle"},{"id":20,"start":87.852,"end":90.817,"text":"Ambulansen har kjørt Gaute til sykehuset.","zh":"救护车把高特送到了医院。","words":[[0,10,87.852,88.677,"ambulansen"],[11,14,88.752,88.917,"har"],[15,20,88.992,89.357,"kjørt"],[21,26,89.392,89.877,"gaute"],[27,30,89.912,90.077,"til"],[31,40,90.112,90.817,"sykehuset"]]},{"id":21,"start":93.052,"end":96.637,"text":"Nå ligger han der med brudd i armen og skulderen.","zh":"现在他因手臂和肩部骨折住在医院里。","words":[[0,2,93.052,93.177,"nå"],[3,9,93.292,93.654,"ligger"],[10,13,93.654,93.797,"han"],[14,17,93.812,94.077,"der"],[18,21,94.672,94.837,"med"],[22,27,94.872,95.204,"brudd"],[28,29,95.204,95.317,"i"],[30,35,95.372,95.777,"armen"],[36,38,95.992,96.124,"og"],[39,48,96.124,96.637,"skulderen"]]},{"id":22,"start":98.192,"end":100.257,"text":"Michelle og Paul besøker ham.","zh":"米歇尔和保罗去看望他。","words":[[0,8,98.192,98.794,"michelle"],[9,11,98.794,98.937,"og"],[12,16,98.972,99.357,"paul"],[17,24,99.552,100.105,"besøker"],[25,28,100.105,100.257,"ham"]]},{"id":23,"start":101.832,"end":108.117,"text":"Gaute har hjulpet dem mange ganger, og han har også oppmuntret Paul til å søke nye jobber.","zh":"高特帮过他们很多次，还鼓励过保罗申请新工作。","words":[[0,5,101.832,102.355,"gaute"],[6,9,102.355,102.537,"har"],[10,17,102.552,103.084,"hjulpet"],[18,21,103.084,103.257,"dem"],[22,27,103.312,103.654,"mange"],[28,34,103.654,103.977,"ganger"],[36,38,104.992,105.124,"og"],[39,42,105.124,105.264,"han"],[43,46,105.264,105.417,"har"],[47,51,105.432,105.757,"også"],[52,62,105.812,106.517,"oppmuntret"],[63,67,106.532,106.877,"paul"],[68,71,106.892,107.054,"til"],[72,73,107.054,107.154,"å"],[74,78,107.154,107.457,"søke"],[79,82,107.472,107.757,"nye"],[83,89,107.772,108.117,"jobber"]]},{"id":24,"start":109.772,"end":112.097,"text":"Nå kan Paul hjelpe naboen sin litt.","zh":"现在保罗可以帮邻居一点忙了。","words":[[0,2,109.772,109.897,"nå"],[3,6,109.932,110.117,"kan"],[7,11,110.232,110.635,"paul"],[12,18,110.635,111.057,"hjelpe"],[19,25,111.072,111.614,"naboen"],[26,29,111.614,111.844,"sin"],[30,34,111.844,112.097,"litt"]]},{"id":25,"start":113.912,"end":118.877,"text":"Han har malt ferdig taket hans, og Elias har flyttet inn på rommet til Ben.","zh":"他给高特刷完了天花板，埃利亚斯也搬进了本的房间。","words":[[0,3,113.912,114.095,"han"],[4,7,114.095,114.257,"har"],[8,12,114.272,114.595,"malt"],[13,19,114.595,114.954,"ferdig"],[20,25,114.954,115.325,"taket"],[26,30,115.325,115.617,"hans"],[32,34,116.652,116.777,"og"],[35,40,116.792,117.334,"elias"],[41,44,117.334,117.477,"har"],[45,52,117.492,117.904,"flyttet@pa-vei-flyttet-perfect"],[53,56,117.904,118.084,"inn"],[57,59,118.084,118.195,"på"],[60,66,118.195,118.514,"rommet"],[67,70,118.514,118.657,"til"],[71,74,118.672,118.877,"ben"]]},{"id":26,"start":120.672,"end":123.417,"text":"Der hører de på musikk og spiller dataspill.","zh":"他们在那里听音乐、玩电脑游戏。","words":[[0,3,120.672,120.915,"der"],[4,9,120.915,121.215,"hører"],[10,12,121.215,121.334,"de"],[13,15,121.334,121.457,"på"],[16,22,121.472,121.977,"musikk"],[23,25,122.372,122.505,"og"],[26,33,122.505,122.815,"spiller"],[34,43,122.815,123.417,"dataspill"]]}],"lexicon":{"3":{"lemma":"3","pos":"数词","zh":"数字 3","ref":null,"clip":null},"alene":{"lemma":"alene","zh":"独自；一个人","pos":"副词","ref":"ty-conversation-7-002","clip":null},"ambulanse":{"lemma":"ambulanse","zh":"救护车","pos":"名词","ref":"12-125","clip":null},"ambulansen":{"lemma":"ambulanse","zh":"救护车","pos":"名词","ref":"12-125","form":"单数定指","clip":null},"armen":{"lemma":"arm","zh":"手臂","pos":"名词","ref":"12-031","form":"单数定指","clip":null},"au":{"lemma":"au","pos":"感叹词","zh":"哎哟（表示疼痛）","ref":null,"clip":null},"ben":{"lemma":"Ben","pos":"专名","zh":"本（人名）","ref":null,"clip":null},"besøker":{"lemma":"besøke","zh":"拜访；看望（besøke 的现在时）","pos":"动词","ref":"3-023","form":"现在时","clip":null},"bo":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"不定式","clip":null},"brudd":{"lemma":"brudd","zh":"骨折","pos":"名词","ref":"pa-vei-11-090","clip":null},"brukket":{"lemma":"brekke","pos":"动词","zh":"折断；骨折","ref":null,"clip":null,"form":"过去分词"},"bøyer":{"lemma":"bøye","zh":"弯腰；俯身（bøye seg）","pos":"动词","ref":"pa-vei-11-077","form":"现在时","clip":null},"dataspill":{"lemma":"dataspill","zh":"电脑游戏","pos":"名词","ref":"6-083","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"dem":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数宾格"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"døra":{"lemma":"dør","zh":"门","pos":"名词","ref":"basics:housing:dør","form":"单数定指","clip":null},"elias":{"lemma":"Elias","pos":"专名","zh":"埃利亚斯（人名）","ref":null,"clip":null},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"etasje":{"lemma":"