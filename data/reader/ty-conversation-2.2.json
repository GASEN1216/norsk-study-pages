{"id":"ty-conversation-2.2","bookId":"ty-conversation-guide","readingId":"2.2","title":"Arranging to meet","audio":"audio/ty-conversation/2.2.mp3","duration":23.849813,"synthetic":false,"sentences":[{"id":0,"start":0.0,"end":3.4,"speaker":"Olav","text":"Når skal jeg treffe deg?","zh":"我们什么时候见面？","words":[[0,3,0.0,1.02,"når@ty-when"],[4,8,1.02,1.46,"skal"],[9,12,1.46,1.82,"jeg"],[13,19,1.82,2.28,"treffe"],[20,23,2.28,3.4,"deg"]]},{"id":1,"start":3.84,"end":5.3,"speaker":"Kari","text":"Klokken to?","zh":"两点怎么样？","words":[[0,7,3.84,4.68,"klokken"],[8,10,4.68,5.3,"to"]]},{"id":2,"start":5.66,"end":8.08,"speaker":"Olav","text":"Hvor skal jeg treffe deg?","zh":"我们在哪里见面？","words":[[0,4,5.66,6.34,"hvor"],[5,9,6.34,6.88,"skal"],[10,13,6.88,7.18,"jeg"],[14,20,7.18,7.54,"treffe"],[21,24,7.54,8.08,"deg"]]},{"id":3,"start":8.54,"end":10.28,"speaker":"Kari","text":"Ved Stortinget.","zh":"在议会大厦旁边。","words":[[0,3,8.54,9.24,"ved"],[4,14,9.24,10.28,"stortinget"]]},{"id":4,"start":10.8,"end":15.52,"speaker":"Olav","text":"Fint. Jeg skal treffe deg ved Stortinget i morgen.","zh":"好。明天我在议会大厦旁边和你见面。","words":[[0,4,10.8,11.26,"fint"],[6,9,11.54,11.78,"jeg"],[10,14,11.78,12.06,"skal"],[15,21,12.06,12.48,"treffe"],[22,25,12.48,13.16,"deg"],[26,29,13.16,13.58,"ved"],[30,40,13.58,14.96,"stortinget"],[41,42,14.96,15.16,"i@ty-time"],[43,49,15.16,15.52,"morgen"]]},{"id":5,"start":16.18,"end":20.92,"speaker":"Kari","text":"OK. Jeg skal treffe deg i morgen klokken to.","zh":"好的。明天两点见。","words":[[0,2,16.18,16.46,"ok"],[4,7,16.98,17.36,"jeg"],[8,12,17.36,17.76,"skal"],[13,19,17.76,18.28,"treffe"],[20,23,18.28,18.92,"deg"],[24,25,18.92,19.24,"i@ty-time"],[26,32,19.24,19.8,"morgen"],[33,40,19.8,20.56,"klokken"],[41,43,20.56,20.92,"to"]]},{"id":6,"start":21.3,"end":21.94,"speaker":"Olav","text":"Ha det bra!","zh":"再见！","words":[[0,2,21.3,21.5,"ha@ty-farewell-ha"],[3,6,21.5,21.66,"det@ty-farewell-det"],[7,10,21.66,21.94,"bra@ty-farewell-bra"]]},{"id":7,"start":22.42,"end":23.26,"speaker":"Kari","text":"