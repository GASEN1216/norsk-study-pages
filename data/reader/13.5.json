{"id":"13.5","title":"Yrkestekst: Jeg er renholder","audio":"audio/13.5.mp3","duration":112.54,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.6,"text":"13.5 Yrke: Jeg er renholder","heading":true,"zh":"13.5 职业：我是清洁工","words":[[0,4,0.15,1.45,"13.5"],[5,9,2.05,2.65,"yrke"],[11,14,3.9,4.32,"jeg"],[15,17,4.32,4.64,"er"],[18,27,4.64,5.52,"renholder"]]},{"id":1,"start":7.47,"end":10.64,"text":"Jeg er renholder og jobber på en stor skole.","zh":"我是清洁工，在一所规模较大的学校工作。","words":[[0,3,7.53,7.9,"jeg"],[4,6,7.9,8.1,"er"],[7,16,8.1,8.92,"renholder"],[17,19,8.92,9.06,"og"],[20,26,9.06,9.36,"jobber~003ddb6d77e6"],[27,29,9.36,9.48,"på"],[30,32,9.48,9.64,"en~a939a9e56dc5"],[33,37,9.64,10.06,"stor"],[38,43,10.06,10.49,"skole"]]},{"id":2,"start":11.57,"end":14.85,"text":"Kollegaene mine og jeg vasker skolen hver dag.","zh":"我和同事们每天打扫学校。","words":[[0,10,11.63,12.4,"kollegaene"],[11,15,12.4,12.74,"mine"],[16,18,12.74,12.86,"og"],[19,22,12.86,13.14,"jeg"],[23,29,13.14,13.66,"vasker~d85e5ad2a7d7"],[30,36,13.66,14.06,"skolen"],[37,41,14.06,14.3,"hver"],[42,45,14.3,14.7,"dag"]]},{"id":3,"start":15.39,"end":19.09,"text":"Det er mye å gjøre fordi det er mange elever på skolen.","zh":"活儿很多，因为学校里学生很多。","words":[[0,3,15.46,15.58,"det~867d8114b1e7"],[4,6,15.58,15.76,"er"],[7,10,15.76,16.22,"mye~cc164d0dc3da"],[11,12,16.22,16.34,"å~0583da7a620a"],[13,18,16.34,16.96,"gjøre"],[19,24,16.96,17.22,"fordi"],[25,28,17.22,17.34,"det~867d8114b1e7"],[29,31,17.34,17.52,"er"],[32,37,17.52,17.86,"mange"],[38,44,17.86,18.36,"elever"],[45,47,18.36,18.48,"på"],[48,54,18.48,18.95,"skolen"]]},{"id":4,"start":20.01,"end":23.86,"text":"Når det er dårlig vær ute, blir det skittent på gulvet.","zh":"外面天气不好的时候，地板就会变脏。","words":[[0,3,20.07,20.26,"når~8cac549467d0"],[4,7,20.26,20.42,"det~5e977a82af29"],[8,10,20.42,20.68,"er"],[11,17,20.68,21.08,"dårlig"],[18,21,21.08,21.38,"vær~c9ef13faaa9b"],[22,25,21.38,21.88,"ute"],[27,31,22.24,22.4,"blir"],[32,35,22.4,22.54,"det~5e977a82af29"],[36,44,22.54,23.12,"skittent"],[45,47,23.12,23.26,"på"],[48,54,23.26,23.71,"gulvet"]]},{"id":5,"start":24.71,"end":27.9,"text":"Når det er snø ute, blir det vått inne.","zh":"外面有雪的时候，室内就会湿漉漉的。","words":[[0,3,24.77,24.92,"når~8cac549467d0"],[4,7,24.92,25.08,"det~867d8114b1e7"],[8,10,25.08,25.36,"er"],[11,14,25.36,25.84,"snø~69b7bb3b3cf7"],[15,18,25.84,26.31,"ute"],[20,24,26.68,26.84,"blir"],[25,28,26.84,27.02,"det~5e977a82af29"],[29,33,27.02,27.42,"vått"],[34,38,27.42,27.75,"inne"]]},{"id":6,"start":28.94,"end":34.42,"text":"Det er tungt å være renholder, men det er et viktig arbeid å holde skolen ren.","zh":"当清洁工很辛苦，但保持学校干净是一项重要的工作。","words":[[0,3,29.0,29.12,"det~5e977a82af29"],[4,6,29.12,29.28,"er"],[7,12,29.28,29.84,"tungt~0c70fbbfc895"],[13,14,29.84,29.96,"å~0583da7a620a"],[15,19,29.96,30.26,"være"],[20,29,30.26,31.05,"renholder"],[31,34,31.4,31.54,"men"],[35,38,31.54,31.68,"det~5e977a82af29"],[39,41,31.68,31.8,"er"],[42,44,31.8,31.98,"et~054dde72f37b"],[45,51,31.98,32.44,"viktig"],[52,58,32.44,33.06,"arbeid"],[59,60,33.06,33.16,"å~0583da7a620a"],[61,66,33.16,33.42,"holde~d96a3e2acec2"],[67,73,33.42,33.9,"skolen"],[74,77,33.9,34.27,"ren"]]},{"id":7,"start":35.45,"end":39.71,"text":"Lærerne og elevene er glade når klasserommene er fine og rene.","zh":"教室又漂亮又干净的时候，老师和学生们都很高兴。","words":[[0,7,35.51,36.18,"lærerne"],[8,10,36.18,36.32,"og"],[11,18,36.32,36.84,"elevene"],[19,21,36.84,37.04,"er"],[22,27,37.04,37.62,"glade"],[28,31,37.62,37.82,"når~8cac549467d0"],[32,45,37.82,38.54,"klasserommene"],[46,48,38.54,38.72,"er"],[49,53,38.72,39.04,"fine"],[54,56,39.04,39.14,"og"],[57,61,39.14,39.56,"rene"]]},{"id":8,"start":41.09,"end":45.68,"text":"Vi må vaske toalettene nøye fordi det er viktig med god hygiene.","zh":"我们必须仔细清洗厕所，因为良好的卫生很重要。","words":[[0,2,41.16,41.46,"vi"],[3,5,41.46,41.68,"må"],[6,11,41.68,42.04,"vaske"],[12,22,42.04,42.74,"toalettene"],[23,27,42.74,43.3,"nøye"],[28,33,43.58,43.84,"fordi"],[34,37,43.84,43.98,"det~5e977a82af29"],[38,40,43.98,44.14,"er"],[41,47,44.14,44.54,"viktig"],[48,51,44.54,44.7,"med~5c4b20d0700d"],[52,55,44.7,44.94,"god"],[56,63,44.94,45.53,"hygiene"]]},{"id":9,"start":46.59,"end":50.56,"text":"Noen ganger roter barna på toalettet, og det liker jeg ikke.","zh":"孩子们有时会把厕所弄得乱七八糟，我不喜欢这样。","words":[[0,4,46.66,46.98,"noen~c766e2ef794d"],[5,11,46.98,47.36,"ganger~16c4f7d3feb9"],[12,17,47.36,47.82,"roter"],[18,23,47.82,48.18,"barna"],[24,26,48.18,48.3,"på"],[27,36,48.3,49.08,"toalettet"],[38,40,49.18,49.44,"og"],[41,44,49.44,49.66,"det"],[45,50,49.66,49.96,"liker"],[51,54,49.96,50.1,"jeg"],[55,59,50.1,50.41,"ikke"]]},{"id":10,"start":52.13,"end":55.91,"text":"For tre år siden tok jeg fagbrev som renholder.","zh":"三年前我考取了清洁工职业资格证书。","words":[[0,3,52.2,52.54,"for~e753a937d19e"],[4,7,52.54,52.86,"tre"],[8,10,52.86,53.06,"år"],[11,16,53.06,53.58,"siden~9a3d2d89a980"],[17,20,53.88,54.1,"tok~d7e69edc9607"],[21,24,54.1,54.38,"jeg"],[25,32,54.38,55.0,"fagbrev"],[33,36,55.0,55.16,"som~ac9866165f47"],[37,46,55.16,55.77,"renholder"]]},{"id":11,"start":56.65,"end":61.69,"text":"Når man har fagbrev, får man bedre lønn, og det er lettere å få jobb.","zh":"有了职业资格证书，工资会更高，找工作也更容易。","words":[[0,3,56.71,56.94,"når~8cac549467d0"],[4,7,56.94,57.1,"man"],[8,11,57.1,57.34,"har"],[12,19,57.34,58.12,"fagbrev"],[21,24,58.4,58.6,"får"],[25,28,58.6,58.86,"man"],[29,34,58.86,59.24,"bedre~712146b6b6d7"],[35,39,59.24,59.71,"lønn"],[41,43,60.0,60.1,"og"],[44,47,60.1,60.22,"det~5e977a82af29"],[48,50,60.22,60.36,"er"],[51,58,60.36,60.94,"lettere"],[59,60,60.94,61.04,"å~0583da7a620a"],[61,63,61.04,61.2,"få~65b84e08cd43"],[64,68,61.2,61.54,"jobb"]]},{"id":12,"start":64.69,"end":66.33,"text":"Hvor skal jeg vaske i dag?","zh":"我今天要打扫哪里？","words":[[0,4,64.75,65.0,"hvor"],[5,9,65.0,65.22,"skal"],[10,13,65.22,65.4,"jeg"],[14,19,65.4,65.78,"vaske"],[20,21,65.78,65.86,"i~de136e71704d"],[22,25,65.86,66.17,"dag"]]},{"id":13,"start":67.36,"end":70.55,"text":"Du skal vaske sone 2 og 5 i dag.","zh":"你今天要打扫2区和5区。","words":[[0,2,67.42,67.74,"du"],[3,7,67.74,67.98,"skal"],[8,13,67.98,68.46,"vaske"],[14,18,68.46,68.98,"sone"],[19,20,68.98,69.42,"2"],[21,23,69.42,69.7,"og"],[24,25,69.7,69.96,"5"],[26,27,69.96,70.04,"i~de136e71704d"],[28,31,70.04,70.4,"dag"]]},{"id":14,"start":70.94,"end":71.8,"text":"Forstår du?","zh":"你明白吗？","words":[[0,7,71.0,71.42,"forstår"],[8,10,71.42,71.65,"du"]]},{"id":15,"start":72.89,"end":73.76,"text":"Ja, ja.","zh":"嗯，嗯。","words":[[0,2,72.95,73.26,"ja"],[4,6,73.26,73.61,"ja"]]},{"id":16,"start":73.79,"end":74.63,"text":"Jeg forstår.","zh":"我明白。","words":[[0,3,73.85,74.04,"jeg"],[4,11,74.04,74.48,"forstår"]]},{"id":17,"start":75.86,"end":77.22,"text":"Er du helt sikker?","zh":"你真的确定吗？","words":[[0,2,75.92,76.02,"er"],[3,5,76.02,76.22,"du"],[6,10,76.22,76.6,"helt~c34e8440563f"],[11,17,76.6,77.07,"sikker"]]},{"id":18,"start":77.22,"end":79.55,"text":"Hvor er sone 5?","zh":"5区在哪里？","words":[[0,4,77.22,78.37,"hvor"],[5,7,78.37,78.67,"er"],[8,12,78.67,78.97,"sone"],[13,14,78.97,79.47,"5"]]},{"id":19,"start":80.44,"end":83.46,"text":"Eh.. er det i andre etasje?","zh":"呃……是在二楼吗？","words":[[0,2,80.5,81.66,"eh"],[5,7,81.66,81.84,"er"],[8,11,81.84,82.0,"det"],[12,13,82.0,82.32,"i"],[14,19,82.32,82.78,"andre~bb01123fb98a"],[20,26,82.78,83.31,"etasje"]]},{"id":20,"start":84.09,"end":86.29,"text":"Nei, det er i første etasje.","zh":"不，是在一楼。","words":[[0,3,84.15,84.74,"nei"],[5,8,84.74,84.92,"det"],[9,11,84.92,85.06,"er"],[12,13,85.06,85.18,"i"],[14,20,85.18,85.62,"første"],[21,27,85.62,86.14,"etasje"]]},{"id":21,"start":86.88,"end":89.36,"text":"Du må ikke si ja når du ikke forstår!","zh":"你不明白的时候，可不能说“是”！","words":[[0,2,86.94,87.12,"du"],[3,5,87.12,87.28,"må"],[6,10,87.28,87.48,"ikke"],[11,13,87.48,87.72,"si~5200b5e94403"],[14,16,87.72,88.06,"ja"],[17,20,88.16,88.3,"når~8cac549467d0"],[21,23,88.3,88.46,"du"],[24,28,88.46,88.7,"ikke"],[29,36,88.7,89.21,"forstår"]]},{"id":22,"start":92.23,"end":95.0,"text":"Har du tatt med alt du trenger på vasketralla di?","zh":"你需要的东西都放到你的清洁推车上了吗？","words":[[0,3,92.29,92.44,"har~8b9792170cca"],[4,6,92.44,92.6,"du"],[7,11,92.6,92.92,"tatt~d030fd31cc68"],[12,15,92.92,93.08,"med~883b5b600e8d"],[16,19,93.08,93.3,"alt"],[20,22,93.3,93.44,"du"],[23,30,93.44,93.88,"trenger"],[31,33,93.88,94.02,"på"],[34,45,94.02,94.66,"vasketralla"],[46,48,94.66,94.84,"di"]]},{"id":23,"start":95.78,"end":97.31,"text":"Ja, det har jeg.","zh":"是的，都放好了。","words":[[0,2,95.84,96.22,"ja"],[4,7,96.56,96.74,"det~31499a59c588"],[8,11,96.74,96.92,"har~59680c2db1c2"],[12,15,96.92,97.16,"jeg"]]},{"id":24,"start":97.94,"end":101.77,"text":"Hvor er vaskemiddelet og plastikkhanskene?","zh":"清洁剂和塑料手套在哪儿？","words":[[0,4,98.0,98.28,"hvor"],[5,7,98.28,98.42,"er"],[8,21,98.42,100.0,"vaskemiddelet"],[22,24,100.3,100.5,"og"],[25,41,100.5,101.62,"plastikkhanskene"]]},{"id":25,"start":102.96,"end":105.75,"text":"Å, det har jeg glemt!","zh":"哎呀，我忘了！","words":[[0,1,103.02,103.3,"å~496a48c13525"],[3,6,104.28,104.66,"det~eb763443ea79"],[7,10,104.66,104.82,"har~8b9792170cca"],[11,14,104.82,105.0,"jeg"],[15,20,105.0,105.6,"glemt"]]},{"id":26,"start":106.57,"end":111.24,"text":"Det må du alltid ha, for vi skal vaske toalettene hver dag.","zh":"这些你必须随时备着，因为我们每天都要清洗厕所。","words":[[0,3,106.63,106.84,"det~2ab795a0e0eb"],[4,6,106.84,106.98,"må"],[7,9,106.98,107.18,"du"],[10,16,107.18,107.56,"alltid~867f85a8b647"],[17,19,107.56,107.88,"ha~d91a2b1668c0"],[21,24,108.42,108.6,"for~1b22712a94b1"],[25,27,108.6,108.74,"vi"],[28,32,108.74,109.02,"skal"],[33,38,109.02,109.5,"vaske"],[39,49,109.5,110.38,"toalettene"],[50,54,110.38,110.74,"hver"],[55,58,110.74,111.09,"dag"]]}],"lexicon":{"13.5":{"lemma":"13.5","zh":"第 13.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"2":{"lemma":"2","zh":"数字 2","pos":"数词","ref":"basics:numbers:to","clip":null,"kind":"number"},"5":{"lemma":"5","zh":"数字 5","pos":"数词","ref":"basics:numbers:fem","clip":null,"kind":"number"},"alltid":{"lemma":"alltid","zh":"总是；一直","pos":"副词","ref":"basics:frequency:alltid","clip":"pronunciation/fca234bf04bff719be01.mp3"},"alt":{"lemma":"alt","zh":"所有东西；全部；一