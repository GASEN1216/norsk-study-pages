{"id":"13.5","title":"Yrkestekst: Jeg er renholder","audio":"audio/13.5.mp3","duration":112.54,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":5.6,"text":"13.5 Yrke: Jeg er renholder","heading":true,"zh":"13.5 职业：我是清洁工","words":[[0,4,0.15,1.45,"13.5"],[5,9,2.05,2.65,"yrke"],[11,14,3.9,4.32,"jeg"],[15,17,4.32,4.64,"er"],[18,27,4.64,5.52,"renholder"]]},{"id":1,"start":7.43,"end":10.58,"text":"Jeg er renholder og jobber på en stor skole.","zh":"我是清洁工，在一所规模较大的学校工作。","words":[[0,3,7.51,7.75,"jeg"],[4,6,7.75,8.03,"er"],[7,16,8.03,8.59,"renholder"],[17,19,8.59,8.99,"og"],[20,26,8.99,9.27,"jobber~003ddb6d77e6"],[27,29,9.27,9.43,"på"],[30,32,9.43,9.59,"en~a939a9e56dc5"],[33,37,9.59,9.91,"stor"],[38,43,9.91,10.5,"skole"]]},{"id":2,"start":11.55,"end":14.79,"text":"Kollegaene mine og jeg vasker skolen hver dag.","zh":"我和同事们每天打扫学校。","words":[[0,10,11.63,12.32,"kollegaene"],[11,15,12.32,12.54,"mine"],[16,18,12.54,12.8,"og"],[19,22,12.8,13.04,"jeg"],[23,29,13.04,13.56,"vasker~d85e5ad2a7d7"],[30,36,13.56,13.98,"skolen"],[37,41,13.98,14.24,"hver"],[42,45,14.24,14.71,"dag"]]},{"id":3,"start":15.38,"end":19.04,"text":"Det er mye å gjøre fordi det er mange elever på skolen.","zh":"活儿很多，因为学校里学生很多。","words":[[0,3,15.46,15.56,"det~867d8114b1e7"],[4,6,15.56,15.68,"er"],[7,10,15.68,16.08,"mye~cc164d0dc3da"],[11,12,16.08,16.3,"å~0583da7a620a"],[13,18,16.3,16.64,"gjøre"],[19,24,16.64,17.16,"fordi"],[25,28,17.16,17.32,"det~867d8114b1e7"],[29,31,17.32,17.44,"er"],[32,37,17.44,17.7,"mange"],[38,44,17.7,18.24,"elever"],[45,47,18.24,18.44,"på"],[48,54,18.44,18.96,"skolen"]]},{"id":4,"start":19.97,"end":23.79,"text":"Når det er dårlig vær ute, blir det skittent på gulvet.","zh":"外面天气不好的时候，地板就会变脏。","words":[[0,3,20.05,20.23,"når~8cac549467d0"],[4,7,20.23,20.35,"det~5e977a82af29"],[8,10,20.35,20.61,"er"],[11,17,20.61,20.99,"dårlig"],[18,21,20.99,21.27,"vær~c9ef13faaa9b"],[22,25,21.27,21.71,"ute"],[27,31,22.19,22.37,"blir"],[32,35,22.37,22.49,"det~5e977a82af29"],[36,44,22.49,23.05,"skittent"],[45,47,23.05,23.23,"på"],[48,54,23.23,23.71,"gulvet"]]},{"id":5,"start":24.6,"end":27.84,"text":"Når det er snø ute, blir det vått inne.","zh":"外面有雪的时候，室内就会湿漉漉的。","words":[[0,3,24.68,24.92,"når~8cac549467d0"],[4,7,24.92,25.04,"det~867d8114b1e7"],[8,10,25.04,25.22,"er"],[11,14,25.22,25.68,"snø~69b7bb3b3cf7"],[15,18,25.68,26.14,"ute"],[20,24,26.64,26.8,"blir"],[25,28,26.8,26.92,"det~5e977a82af29"],[29,33,26.92,27.34,"vått"],[34,38,27.34,27.76,"inne"]]},{"id":6,"start":27.91,"end":34.37,"text":"Det er tungt å være renholder, men det er et viktig arbeid å holde skolen ren.","zh":"当清洁工很辛苦，但保持学校干净是一项重要的工作。","words":[[0,3,28.65,29.11,"det~5e977a82af29"],[4,6,29.11,29.19,"er"],[7,12,29.19,29.73,"tungt~0c70fbbfc895"],[13,14,29.73,29.89,"å~0583da7a620a"],[15,19,29.89,30.13,"være"],[20,29,30.13,30.83,"renholder"],[31,34,31.33,31.51,"men"],[35,38,31.51,31.63,"det~5e977a82af29"],[39,41,31.63,31.73,"er"],[42,44,31.73,31.87,"et~054dde72f37b"],[45,51,31.87,32.23,"viktig"],[52,58,32.23,32.87,"arbeid"],[59,60,32.87,33.11,"å~0583da7a620a"],[61,66,33.11,33.35,"holde~d96a3e2acec2"],[67,73,33.35,33.69,"skolen"],[74,77,33.69,34.29,"ren"]]},{"id":7,"start":35.41,"end":39.66,"text":"Lærerne og elevene er glade når klasserommene er fine og rene.","zh":"教室又漂亮又干净的时候，老师和学生们都很高兴。","words":[[0,7,35.49,36.1,"lærerne"],[8,10,36.1,36.28,"og"],[11,18,36.28,36.76,"elevene"],[19,21,36.76,36.94,"er"],[22,27,36.94,37.3,"glade"],[28,31,37.3,37.74,"når~8cac549467d0"],[32,45,37.74,38.44,"klasserommene"],[46,48,38.44,38.64,"er"],[49,53,38.64,38.92,"fine"],[54,56,38.92,39.1,"og"],[57,61,39.1,39.58,"rene"]]},{"id":8,"start":41.06,"end":45.62,"text":"Vi må vaske toalettene nøye fordi det er viktig med god hygiene.","zh":"我们必须仔细清洗厕所，因为良好的卫生很重要。","words":[[0,2,41.14,41.34,"vi"],[3,5,41.34,41.58,"må"],[6,11,41.58,41.98,"vaske"],[12,22,41.98,42.62,"toalettene"],[23,27,42.62,43.14,"nøye"],[28,33,43.44,43.78,"fordi"],[34,37,43.78,43.92,"det~5e977a82af29"],[38,40,43.92,44.04,"er"],[41,47,44.04,44.38,"viktig"],[48,51,44.38,44.62,"med~5c4b20d0700d"],[52,55,44.62,44.88,"god"],[56,63,44.88,45.54,"hygiene"]]},{"id":9,"start":46.56,"end":50.51,"text":"Noen ganger roter barna på toalettet, og det liker jeg ikke.","zh":"孩子们有时会把厕所弄得乱七八糟，我不喜欢这样。","words":[[0,4,46.64,46.92,"noen~c766e2ef794d"],[5,11,46.92,47.24,"ganger~16c4f7d3feb9"],[12,17,47.24,47.74,"roter"],[18,23,47.74,48.1,"barna"],[24,26,48.1,48.26,"på"],[27,36,48.26,48.7,"toalettet"],[38,40,48.7,49.34,"og"],[41,44,49.34,49.6,"det"],[45,50,49.6,49.92,"liker"],[51,54,49.92,50.08,"jeg"],[55,59,50.08,50.43,"ikke"]]},{"id":10,"start":52.09,"end":55.86,"text":"For tre år siden tok jeg fagbrev som renholder.","zh":"三年前我考取了清洁工职业资格证书。","words":[[0,3,52.17,52.38,"for~e753a937d19e"],[4,7,52.38,52.74,"tre"],[8,10,52.74,52.96,"år"],[11,16,52.96,53.36,"siden~9a3d2d89a980"],[17,20,53.36,54.0,"tok~d7e69edc9607"],[21,24,54.0,54.2,"jeg"],[25,32,54.2,54.92,"fagbrev"],[33,36,54.92,55.06,"som~ac9866165f47"],[37,46,55.06,55.78,"renholder"]]},{"id":11,"start":56.62,"end":61.65,"text":"Når man har fagbrev, får man bedre lønn, og det er lettere å få jobb.","zh":"有了职业资格证书，工资会更高，找工作也更容易。","words":[[0,3,56.7,56.86,"når~8cac549467d0"],[4,7,56.86,57.04,"man"],[8,11,57.04,57.24,"har"],[12,19,57.24,57.94,"fagbrev"],[21,24,58.38,58.54,"får"],[25,28,58.54,58.74,"man"],[29,34,58.74,59.18,"bedre~712146b6b6d7"],[35,39,59.18,59.54,"lønn"],[41,43,59.54,60.08,"og"],[44,47,60.08,60.22,"det~5e977a82af29"],[48,50,60.22,60.3,"er"],[51,58,60.3,60.8,"lettere"],[59,60,60.8,61.02,"å~0583da7a620a"],[61,63,61.02,61.14,"få~65b84e08cd43"],[64,68,61.14,61.57,"jobb"]]},{"id":12,"start":64.65,"end":66.28,"text":"Hvor skal jeg vaske i dag?","zh":"我今天要打扫哪里？","words":[[0,4,64.73,64.95,"hvor"],[5,9,64.95,65.13,"skal"],[10,13,65.13,65.33,"jeg"],[14,19,65.33,65.71,"vaske"],[20,21,65.71,65.83,"i~de136e71704d"],[22,25,65.83,66.2,"dag"]]},{"id":13,"start":67.32,"end":70.49,"text":"Du skal vaske sone 2 og 5 i dag.","zh":"你今天要打扫2区和5区。","words":[[0,2,67.4,67.66,"du"],[3,7,67.66,67.9,"skal"],[8,13,67.9,68.36,"vaske"],[14,18,68.36,68.78,"sone"],[19,20,68.78,69.28,"2"],[21,23,69.28,69.6,"og"],[24,25,69.6,69.86,"5"],[26,27,69.86,70.02,"i~de136e71704d"],[28,31,70.02,70.41,"dag"]]},{"id":14,"start":70.87,"end":71.75,"text":"Forstår du?","zh":"你明白吗？","words":[[0,7,70.95,71.34,"forstår"],[8,10,71.34,71.67,"du"]]},{"id":15,"start":72.32,"end":73.7,"text":"Ja, ja.","zh":"嗯，嗯。","words":[[0,2,72.45,73.17,"ja"],[4,6,73.25,73.62,"ja"]]},{"id":16,"start":73.75,"end":74.56,"text":"Jeg forstår.","zh":"我明白。","words":[[0,3,73.83,73.99,"jeg"],[4,11,73.99,74.48,"forstår"]]},{"id":17,"start":75.76,"end":77.15,"text":"Er du helt sikker?","zh":"你真的确定吗？","words":[[0,2,75.84,76.01,"er"],[3,5,76.01,76.13,"du"],[6,10,76.13,76.49,"helt~c34e8440563f"],[11,17,76.49,77.07,"sikker"]]},{"id":18,"start":77.15,"end":79.55,"text":"Hvor er sone 5?","zh":"5区在哪里？","words":[[0,4,77.22,78.37,"hvor"],[5,7,78.37,78.67,"er"],[8,12,78.67,78.97,"sone"],[13,14,78.97,79.47,"5"]]},{"id":19,"start":80.4,"end":83.39,"text":"Eh.. er det i andre etasje?","zh":"呃……是在二楼吗？","words":[[0,2,80.48,80.86,"eh"],[5,7,81.42,81.82,"er"],[8,11,81.82,81.96,"det"],[12,13,81.96,82.18,"i"],[14,19,82.18,82.62,"andre~bb01123fb98a"],[20,26,82.62,83.31,"etasje"]]},{"id":20,"start":83.6,"end":86.23,"text":"Nei, det er i første etasje.","zh":"不，是在一楼。","words":[[0,3,83.78,84.5,"nei"],[5,8,84.72,84.86,"det"],[9,11,84.86,85.0,"er"],[12,13,85.0,85.1,"i"],[14,20,85.1,85.52,"første"],[21,27,85.52,86.15,"etasje"]]},{"id":21,"start":86.84,"end":89.3,"text":"Du må ikke si ja når du ikke forstår!","zh":"你不明白的时候，可不能说“是”！","words":[[0,2,86.92,87.08,"du"],[3,5,87.08,87.22,"må"],[6,10,87.22,87.42,"ikke"],[11,13,87.42,87.6,"si~5200b5e94403"],[14,16,87.6,87.98,"ja"],[17,20,87.98,88.28,"når~8cac549467d0"],[21,23,88.28,88.4,"du"],[24,28,88.4,88.6,"ikke"],[29,36,88.6,89.22,"forstår"]]},{"id":22,"start":92.19,"end":94.94,"text":"Har du tatt med alt du trenger på vasketralla di?","zh":"你需要的东西都放到你的清洁推车上了吗？","words":[[0,3,92.27,92.39,"har~8b9792170cca"],[4,6,92.39,92.51,"du"],[7,11,92.51,92.75,"tatt~d030fd31cc68"],[12,15,92.75,92.99,"med~883b5b600e8d"],[16,19,92.99,93.21,"alt"],[20,22,93.21,93.37,"du"],[23,30,93.37,93.77,"trenger"],[31,33,93.77,93.95,"på"],[34,45,93.95,94.63,"vasketralla"],[46,48,94.67,94.86,"di"]]},{"id":23,"start":95.74,"end":97.25,"text":"Ja, det har jeg.","zh":"是的，都放好了。","words":[[0,2,95.82,96.05,"ja"],[4,7,96.43,96.67,"det~31499a59c588"],[8,11,96.67,96.87,"har~59680c2db1c2"],[12,15,96.87,97.17,"jeg"]]},{"id":24,"start":97.9,"end":101.72,"text":"Hvor er vaskemiddelet og plastikkhanskene?","zh":"清洁剂和塑料手套在哪儿？","words":[[0,4,97.98,98.19,"hvor"],[5,7,98.19,98.35,"er"],[8,21,98.35,99.19,"vaskemiddelet"],[22,24,99.19,99.39,"og"],[25,41,99.39,101.64,"plastikkhanskene"]]},{"id":25,"start":102.92,"end":105.69,"text":"Å, det har jeg glemt!","zh":"哎呀，我忘了！","words":[[0,1,103.0,103.32,"å~496a48c13525"],[3,6,103.9,104.56,"det~eb763443ea79"],[7,10,104.56,104.78,"har~8b9792170cca"],[11,14,104.78,104.92,"jeg"],[15,20,104.92,105.61,"glemt"]]},{"id":26,"start":106.53,"end":111.17,"text":"Det må du alltid ha, for vi skal vaske toalettene hver dag.","zh":"这些你必须随时备着，因为我们每天都要清洗厕所。","words":[[0,3,106.61,106.78,"det~2ab795a0e0eb"],[4,6,106.78,106.92,"må"],[7,9,106.92,107.04,"du"],[10,16,107.04,107.44,"alltid~867f85a8b647"],[17,19,107.44,107.72,"ha~d91a2b1668c0"],[21,24,108.34,108.52,"for~1b22712a94b1"],[25,27,108.52,108.68,"vi"],[28,32,108.68,108.86,"skal"],[33,38,108.86,109.42,"vaske"],[39,49,109.42,110.1,"toalettene"],[50,54,110.1,110.62,"hver"],[55,58,110.62,111.09,"dag"]]}],"lexicon":{"13.5":{"lemma":"13.5","zh":"第 13.5 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"2":{"lemma":"2","zh":"数字 2","pos":"数词","ref":"basics:numbers:to","clip":null,"kind":"number"},"5":{"lemma":"5","zh":"数字 5","pos":"数词","ref":"basics:numbers:fem","clip":null,"kind":"number"},"alltid":{"lemma":"alltid","zh":"总是；一直","pos":"副词","ref":"basics:frequency:alltid","clip":"pronunciation/fca234bf04bff719be01.mp3"},"alt":{"lemma":"alt","z