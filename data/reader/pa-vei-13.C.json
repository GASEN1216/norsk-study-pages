{"id":"pa-vei-13.C","bookId":"pa-vei-textbook","readingId":"13.C","title":"I byen eller på landet?","audio":"audio/pa-vei/13.C.mp3","duration":137.448,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.18,"end":5.525,"text":"Annette og Steinar bor i Akershus, fire mil fra Lillestrøm.","zh":"安妮特和斯泰纳住在阿克什胡斯，离利勒斯特伦四十公里。","words":[[0,7,1.18,1.725,"annette"],[8,10,1.78,1.902,"og"],[11,18,1.902,2.445,"steinar"],[19,22,2.5,2.732,"bor"],[23,24,2.732,2.825,"i"],[25,33,2.88,3.565,"akershus"],[35,39,4.04,4.425,"fire"],[40,43,4.44,4.745,"mil"],[44,47,4.78,4.965,"fra"],[48,58,4.98,5.525,"lillestrøm"]]},{"id":1,"start":6.86,"end":10.105,"text":"De bor i en treroms leilighet på 82 kvadratmeter.","zh":"他们住在一套有三个房间、面积 82 平方米的公寓里。","words":[[0,2,6.86,6.985,"de"],[3,6,7.02,7.232,"bor"],[7,8,7.232,7.322,"i"],[9,11,7.322,7.445,"en"],[12,19,7.46,8.072,"treroms"],[20,29,8.072,8.623,"leilighet"],[30,32,8.623,8.762,"på"],[33,35,8.762,9.245,"82"],[36,48,9.32,10.105,"kvadratmeter"]]},{"id":2,"start":11.312,"end":17.677,"text":"Steinar jobber i Lillestrøm, og Annette er hjemmeværende med to små jenter på fire og to år.","zh":"斯泰纳在利勒斯特伦工作，安妮特在家照顾两个女儿，一个四岁，一个两岁。","words":[[0,7,11.312,11.837,"steinar"],[8,14,11.852,12.124,"jobber"],[15,16,12.124,12.215,"i"],[17,27,12.215,12.757,"lillestrøm"],[29,31,13.292,13.417,"og"],[32,39,13.432,13.897,"annette"],[40,42,13.952,14.114,"er"],[43,56,14.114,14.854,"hjemmeværende"],[57,60,14.854,15.014,"med"],[61,63,15.014,15.197,"to"],[64,67,15.312,15.517,"små"],[68,74,15.612,16.077,"jenter"],[75,77,16.372,16.517,"på"],[78,82,16.592,16.997,"fire"],[83,85,17.072,17.197,"og"],[86,88,17.212,17.377,"to"],[89,91,17.452,17.677,"år"]]},{"id":3,"start":19.032,"end":22.417,"text":"Nå har hun besøk av Line, ei venninne fra skoledagene.","zh":"现在，学生时代的朋友莉内来探望她。","words":[[0,2,19.032,19.177,"nå"],[3,6,19.272,19.414,"har"],[7,10,19.414,19.554,"hun"],[11,16,19.554,19.997,"besøk"],[17,19,20.012,20.135,"av"],[20,24,20.135,20.517,"line"],[26,28,21.012,21.157,"ei"],[29,37,21.192,21.575,"venninne"],[38,41,21.575,21.734,"fra"],[42,53,21.734,22.417,"skoledagene"]]},{"id":4,"start":24.592,"end":25.997,"text":"Hvor lenge har dere bodd her?","zh":"你们在这里住多久了？","words":[[0,4,24.592,24.785,"hvor"],[5,10,24.785,25.024,"lenge"],[11,14,25.024,25.145,"har"],[15,19,25.145,25.357,"dere"],[20,24,25.392,25.657,"bodd"],[25,28,25.692,25.997,"her"]],"speaker":"Line"},{"id":5,"start":26.712,"end":35.837,"text":"I fire år. Leiligheten er fin og utsikten er nydelig, men vi, eller særlig jeg, har lyst til å flytte.","zh":"四年了。公寓很好，景色也很漂亮，可是我们，尤其是我，想搬家。","words":[[0,1,26.712,26.817,"i"],[2,6,26.872,27.257,"fire"],[7,9,27.332,27.557,"år"],[11,22,28.532,29.035,"leiligheten"],[23,25,29.035,29.177,"er"],[26,29,29.192,29.497,"fin"],[30,32,29.792,29.917,"og"],[33,41,29.952,30.457,"utsikten"],[42,44,30.512,30.697,"er"],[45,52,30.772,31.337,"nydelig"],[54,57,31.952,32.117,"men"],[58,60,32.172,32.317,"vi"],[62,67,33.092,33.377,"eller"],[68,74,33.472,33.924,"særlig"],[75,78,33.924,34.117,"jeg"],[80,83,34.692,34.897,"har"],[84,88,34.932,35.204,"lyst@pa-vei-lyst-desire"],[89,92,35.204,35.355,"til"],[93,94,35.355,35.445,"å"],[95,101,35.445,35.837,"flytte"]],"speaker":"Annette"},{"id":6,"start":37.052,"end":37.597,"text":"Hvorfor det?","zh":"为什么？","words":[[0,7,37.052,37.445,"hvorfor"],[8,11,37.445,37.597,"det"]],"speaker":"Line"},{"id":7,"start":38.892,"end":40.597,"text":"Jeg vil gjerne flytte til Lillestrøm.","zh":"我想搬到利勒斯特伦。","words":[[0,3,38.892,39.085,"jeg"],[4,7,39.085,39.204,"vil"],[8,14,39.204,39.517,"gjerne"],[15,21,39.532,39.865,"flytte"],[22,25,39.865,40.004,"til"],[26,36,40.004,40.597,"lillestrøm"]],"speaker":"Annette"},{"id":8,"start":41.592,"end":46.397,"text":"Nå har jeg vært hjemme med ungene ganske lenge og har lyst til å finne meg en jobb.","zh":"我在家带孩子已经很久了，想找份工作。","words":[[0,2,41.592,41.737,"nå"],[3,6,41.792,41.974,"har"],[7,10,41.974,42.157,"jeg"],[11,15,42.212,42.424,"vært"],[16,22,42.424,42.734,"hjemme"],[23,26,42.734,42.897,"med"],[27,33,42.912,43.297,"ungene"],[34,40,43.432,44.057,"ganske"],[41,46,44.072,44.417,"lenge"],[47,49,44.912,45.044,"og"],[50,53,45.044,45.204,"har"],[54,58,45.204,45.425,"lyst@pa-vei-lyst-desire"],[59,62,45.425,45.514,"til"],[63,64,45.514,45.575,"å"],[65,70,45.575,45.825,"finne"],[71,74,45.825,45.965,"meg"],[75,77,45.965,46.097,"en"],[78,82,46.112,46.397,"jobb"]],"speaker":"Annette"},{"id":9,"start":47.232,"end":50.457,"text":"Det er lettere å få seg en jobb i Lillestrøm enn her.","zh":"在利勒斯特伦比在这里更容易找到工作。","words":[[0,3,47.232,47.385,"det"],[4,6,47.385,47.495,"er"],[7,14,47.495,47.957,"lettere"],[15,16,48.112,48.217,"å"],[17,19,48.232,48.377,"få"],[20,23,48.492,48.665,"seg"],[24,26,48.665,48.784,"en"],[27,31,48.784,49.014,"jobb"],[32,33,49.014,49.094,"i"],[34,44,49.094,49.637,"lillestrøm"],[45,48,49.952,50.177,"enn"],[49,52,50.192,50.457,"her"]],"speaker":"Annette"},{"id":10,"start":52.412,"end":53.637,"text":"Jeg trives godt her.","zh":"我在这里住得很开心。","words":[[0,3,52.412,52.577,"jeg"],[4,10,52.612,52.997,"trives"],[11,15,53.012,53.357,"godt"],[16,19,53.392,53.637,"her"]],"speaker":"Steinar"},{"id":11,"start":54.792,"end":59.937,"text":"Her er det både boligblokker og rekkehus, og det er store grøntområder.","zh":"这里既有公寓楼，也有联排住宅，还有大片绿地。","words":[[0,3,54.792,54.974,"her"],[4,6,54.974,55.075,"er"],[7,10,55.075,55.174,"det"],[11,15,55.174,55.397,"både"],[16,28,55.432,56.484,"boligblokker"],[29,31,56.484,56.637,"og"],[32,40,56.792,57.637,"rekkehus"],[42,44,58.192,58.294,"og"],[45,48,58.294,58.395,"det"],[49,51,58.395,58.495,"er"],[52,57,58.495,58.937,"store"],[58,70,58.972,59.937,"grøntområder"]],"speaker":"Steinar"},{"id":12,"start":61.472,"end":64.017,"text":"Dessuten er alt dyrere i Lillestrøm.","zh":"而且利勒斯特伦的东西都更贵。","words":[[0,8,61.472,61.924,"dessuten"],[9,11,61.924,62.037,"er"],[12,15,62.152,62.457,"alt"],[16,22,62.472,63.037,"dyrere"],[23,24,63.352,63.454,"i"],[25,35,63.454,64.017,"lillestrøm"]],"speaker":"Steinar"},{"id":13,"start":65.032,"end":69.197,"text":"Det er synd at alt er så dyrt, men vi kan ta opp mer lån.","zh":"东西那么贵是挺遗憾的，不过我们可以多贷些款。","words":[[0,3,65.032,65.184,"det"],[4,6,65.184,65.297,"er"],[7,11,65.392,65.797,"synd"],[12,14,65.832,65.975,"at"],[15,18,65.975,66.195,"alt"],[19,21,66.195,66.334,"er"],[22,24,66.334,66.477,"så"],[25,29,66.512,66.857,"dyrt"],[31,34,67.672,67.825,"men"],[35,37,67.825,67.937,"vi"],[38,41,67.952,68.157,"kan"],[42,44,68.212,68.357,"ta"],[45,48,68.412,68.605,"opp"],[49,52,68.605,68.817,"mer"],[53,56,68.912,69.197,"lån"]],"speaker":"Annette"},{"id":14,"start":70.252,"end":71.797,"text":"Har dere sett etter ny bolig?","zh":"你们在找新房子了吗？","words":[[0,3,70.252,70.434,"har"],[4,8,70.434,70.677,"dere"],[9,13,70.712,71.005,"sett"],[14,19,71.005,71.255,"etter"],[20,22,71.255,71.397,"ny"],[23,28,71.452,71.797,"bolig"]],"speaker":"Line"},{"id":15,"start":72.692,"end":78.757,"text":"Ikke Steinar, men jeg leser boligannonsene i lokalavisen og følger med på finn.no.","zh":"斯泰纳没有，不过我会看当地报纸的房产广告，也会关注 finn.no。","words":[[0,4,72.692,72.977,"ikke"],[5,12,72.992,73.477,"steinar"],[14,17,74.092,74.257,"men"],[18,21,74.272,74.497,"jeg"],[22,27,74.712,75.035,"leser"],[28,42,75.035,75.837,"boligannonsene"],[43,44,75.852,75.954,"i"],[45,56,75.954,76.737,"lokalavisen"],[57,59,77.052,77.197,"og"],[60,66,77.212,77.535,"følger"],[67,70,77.535,77.695,"med"],[71,73,77.695,77.837,"på"],[74,78,77.892,78.157,"finn"],[79,81,78.512,78.757,"no"]],"speaker":"Annette"},{"id":16,"start":79.872,"end":83.157,"text":"I går så jeg en fin leilighet midt i Lillestrøm.","zh":"昨天我在利勒斯特伦市中心看到了一套不错的公寓。","words":[[0,1,79.872,79.975,"i"],[2,5,79.975,80.257,"går"],[6,8,80.552,80.697,"så@pa-vei-så-saw"],[9,12,80.712,80.834,"jeg"],[13,15,80.834,80.957,"en"],[16,19,81.032,81.394,"fin"],[20,29,81.394,81.857,"leilighet"],[30,34,82.072,82.397,"midt"],[35,36,82.472,82.577,"i"],[37,47,82.632,83.157,"lillestrøm"]],"speaker":"Annette"},{"id":17,"start":84.172,"end":89.097,"text":"Leiligheten er litt mindre enn denne, men ikke så mye dyrere enn den vi har nå.","zh":"那套公寓比这套小一点，不过比我们现在的公寓贵不了多少。","words":[[0,11,84.172,84.737,"leiligheten"],[12,14,84.872,85.097,"er"],[15,19,85.112,85.377,"litt"],[20,26,85.392,85.695,"mindre"],[27,30,85.695,85.834,"enn"],[31,36,85.834,86.077,"denne"],[38,41,86.672,86.834,"men"],[42,46,86.834,87.075,"ikke"],[47,49,87.075,87.217,"så"],[50,53,87.292,87.657,"mye"],[54,60,87.672,88.117,"dyrere"],[61,64,88.332,88.514,"enn"],[65,68,88.514,88.657,"den"],[69,71,88.672,88.794,"vi"],[72,75,88.794,88.965,"har"],[76,78,88.965,89.097,"nå"]],"speaker":"Annette"},{"id":18,"start":90.272,"end":91.557,"text":"Skal dere legge inn bud?","zh":"你们准备出价吗？","words":[[0,4,90.272,90.517,"skal"],[5,9,90.532,90.757,"dere"],[10,15,90.772,91.025,"legge"],[16,19,91.025,91.225,"inn"],[20,23,91.225,91.557,"bud"]],"speaker":"Line"},{"id":19,"start":92.832,"end":96.237,"text":"Jeg har lyst til å overta gården etter foreldrene mine.","zh":"我想接手父母的农场。","words":[[0,3,92.832,92.994,"jeg"],[4,7,92.994,93.154,"har"],[8,12,93.154,93.477,"lyst@pa-vei-lyst-desire"],[13,16,93.492,93.654,"til"],[17,18,93.654,93.757,"å"],[19,25,93.812,94.237,"overta"],[26,32,94.332,94.817,"gården"],[33,38,95.112,95.375,"etter"],[39,49,95.375,95.975,"foreldrene"],[50,54,95.975,96.237,"mine"]],"speaker":"Steinar"},{"id":20,"start":97.352,"end":99.357,"text":"De er gamle og trenger hjelp.","zh":"他们年纪大了，需要帮助。","words":[[0,2,97.352,97.475,"de"],[3,5,97.475,97.595,"er"],[6,11,97.595,98.017,"gamle"],[12,14,98.592,98.704,"og"],[15,22,98.704,98.995,"trenger"],[23,28,98.995,99.357,"hjelp"]],"speaker":"Steinar"},{"id":21,"start":100.512,"end":102.337,"text":"Da må vi i hvert fall ta opp mer lån!","zh":"那我们肯定得多贷款！","words":[[0,2,100.512,100.637,"da"],[3,5,100.672,100.794,"må"],[6,8,100.794,100.904,"vi"],[9,10,100.904,100.975,"i"],[11,16,100.975,101.234,"hvert"],[17,21,101.234,101.434,"fall"],[22,24,101.434,101.597,"ta"],[25,28,101.652,101.834,"opp"],[29,32,101.834,102.057,"mer"],[33,36,102.072,102.337,"lån"]],"speaker":"Annette"},{"id":22,"start":103.032,"end":109.457,"text":"Det er en gammel bondegård, og foreldrene til Steinar har ikke pusset opp gården på mange, mange år.","zh":"那是一个老农场，斯泰纳的父母已经很多很多年没有翻修了。","words":[[0,3,103.032,103.165,"det"],[4,6,103.165,103.264,"er"],[7,9,103.264,103.397,"en"],[10,16,103.512,104.035,"gammel"],[17,26,104.035,104.517,"bondegård"],[28,30,104.972,105.117,"og"],[31,41,105.132,105.695,"foreldrene"],[42,45,105.695,105.844,"til"],[46,53,105.844,106.257,"steinar"],[54,57,106.372,106.584,"har"],[58,62,106.584,106.815,"ikke"],[63,69,106.815,107.174,"pusset"],[70,73,107.174,107.325,"opp"],[74,80,107.325,107.597,"gården"],[81,83,107.732,107.877,"på"],[84,89,108.112,108.617,"mange"],[91,96,108.772,109.197,"mange"],[97,99,109.252,109.457,"år"]],"speaker":"Annette"},{"id":23,"start":111.232,"end":116.037,"text":"Hva mener du, Annette? Har du lyst til å flytte på landet og bli bondekone?","zh":"安妮特，你怎么想？你想搬到乡下，当个农场主的妻子吗？","words":[[0,3,111.232,111.417,"hva"],[4,9,111.472,111.764,"mener"],[10,12,111.764,111.897,"du"],[14,21,111.932,112.377,"annette"],[23,26,113.312,113.465,"har"],[27,29,113.465,113.597,"du"],[30,34,113.612,113.834,"lyst@pa-vei-lyst-desire"],[35,38,113.834,113.975,"til"],[39,40,113.975,114.075,"å"],[41,47,114.075,114.394,"flytte"],[48,50,114.394,114.514,"på"],[51,57,114.514,114.877,"landet@pa-vei-landet-countryside"],[58,60,114.972,115.105,"og"],[61,64,115.105,115.257,"bli"],[65,74,115.312,116.037,"bondekone"]],"speaker":"Line"},{"id":24,"start":116.772,"end":120.657,"text":"Jeg vet ikke. Jeg trives både i byen og på landet.","zh":"我不知道。城里和乡下我都喜欢。","words":[[0,3,116.772,116.957,"jeg"],[4,7,117.012,117.364,"vet"],[8,12,117.364,117.617,"ikke"],[14,17,118.412,118.575,"jeg"],[18,24,118.575,118.994,"trives"],[25,29,118.994,119.315,"både"],[30,31,119.315,119.434,"i"],[32,36,119.434,119.717,"byen"],[37,39,119.972,120.117,"og"],[40,42,120.212,120.355,"på"],[43,49,120.355,120.657,"landet@pa-vei-landet-countryside"]],"speaker":"Annette"},{"id":25,"start":121.692,"end":123.637,"text":"Du liker jo å være på gården.","zh":"你不是很喜欢待在农场吗？","words":[[0,2,121.692,121.837,"du"],[3,8,121.912,122.437,"liker"],[9,11,122.452,122.595,"jo"],[12,13,122.595,122.715,"å"],[14,18,122.715,123.077,"være"],[19,21,123.092,123.217,"på"],[22,28,123.232,123.637,"gården"]],"speaker":"Steinar"},{"id":26,"start":124.692,"end":134.137,"text":"Ja, det gjør jeg, og jeg er glad i dyr. Men jeg er veldig glad i bylivet også. Huff, dette er vanskelig.","zh":"是的，我喜欢，我也喜欢动物。不过我也很喜欢城市生活。唉，这可真难选。","words":[[0,2,124.692,124.857,"ja"],[4,7,125.172,125.344,"det"],[8,12,125.344,125.514,"gjør"],[13,16,125.514,125.657,"jeg"],[18,20,126.072,126.204,"og"],[21,24,126.204,126.357,"jeg"],[25,27,126.392,126.637,"er"],[28,32,126.672,126.975,"glad"],[33,34,126.975,127.065,"i"],[35,38,127.065,127.317,"dyr"],[40,43,128.112,128.264,"men"],[44,47,128.264,128.415,"jeg"],[48,50,128.415,128.537,"er"],[51,57,128.612,129.174,"veldig"],[58,62,129.174,129.457,"glad"],[63,64,129.492,129.617,"i"],[65,72,129.632,130.277,"bylivet"],[73,77,130.352,130.677,"også"],[79,83,131.712,132.097,"huff"],[85,90,132.812,133.217,"dette"],[91,93,133.252,133.437,"er"],[94,103,133.472,134.137,"vanskelig"]],"speaker":"Annette"}],"lexicon":{"82":{"lemma":"82","pos":"数词","zh":"数字 82","ref":null,"clip":null},"akershus":{"lemma":"Akershus","pos":"专名","zh":"阿克什胡斯（挪威地区）","ref":null,"clip":null},"alt":{"lemma":"alt","zh":"一切","pos":"代词","ref":"10-054","clip":null},"annette":{"lemma":"Annette","pos":"专名","zh":"安妮特（人名）","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"besøk":{"lemma":"besøk","zh":"拜访；做客","pos":"名词","ref":"6-001","clip":null},"bli":{"lemma":"bli","pos":"动词","zh":"变成；成为；留下","ref":null,"clip":null,"form":"不定式"},"bodd":{"lemma":"bo","zh":"居住","pos":"动词","ref":"9-001","form":"过去分词","clip":null},"bolig":{"lemma":"bolig","zh":"住房；住宅","pos":"名词","ref":"8-035","clip":null},"boligannonsene":{"lemma":"boliganno