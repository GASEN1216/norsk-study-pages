{"id":"pa-vei-3.A","bookId":"pa-vei-textbook","readingId":"3.A","title":"På fest","audio":"audio/pa-vei/3.A.mp3","duration":121.212,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.94,"end":2.565,"text":"På fest.","zh":"在聚会上。","words":[[0,2,1.94,2.085,"på"],[3,7,2.14,2.565,"fest"]]},{"id":1,"start":4.5,"end":5.065,"text":"Velkommen!","zh":"欢迎！","words":[[0,9,4.5,5.065,"velkommen"]],"speaker":"Pablo"},{"id":2,"start":6.0,"end":7.125,"text":"Tusen takk, Pablo.","zh":"非常感谢，巴勃罗。","words":[[0,5,6.0,6.485,"tusen"],[6,10,6.5,6.742,"takk"],[12,17,6.742,7.125,"pablo"]],"speaker":"Irina"},{"id":3,"start":8.28,"end":11.885,"text":"Jeg har en gave til deg. Vær så god!","zh":"我有一份礼物送给你。给你！","words":[[0,3,8.28,8.465,"jeg"],[4,7,8.48,8.652,"har"],[8,10,8.652,8.785,"en"],[11,15,8.8,9.165,"gave"],[16,19,9.18,9.332,"til"],[20,23,9.332,9.505,"deg"],[25,28,10.92,11.145,"vær@pa-vei-vær-be"],[29,31,11.24,11.405,"så"],[32,35,11.42,11.885,"god"]],"speaker":"Irina"},{"id":4,"start":13.5,"end":16.825,"text":"Åh! Ei eske med sjokolade. Tusen takk.","zh":"啊！一盒巧克力。非常感谢。","words":[[0,2,13.5,13.96,"åh"],[4,6,14.34,14.485,"ei"],[7,11,14.56,14.893,"eske"],[12,15,14.893,15.023,"med"],[16,25,15.023,15.805,"sjokolade"],[27,32,16.16,16.532,"tusen"],[33,37,16.532,16.825,"takk"]],"speaker":"Pablo"},{"id":5,"start":17.44,"end":18.805,"text":"Jeg elsker sjokolade.","zh":"我最爱巧克力。","words":[[0,3,17.44,17.625,"jeg"],[4,10,17.76,18.285,"elsker"],[11,20,18.3,18.805,"sjokolade"]],"speaker":"Pablo"},{"id":6,"start":20.9,"end":24.865,"text":"Der sitter to fra norskkurset, men hvem er det?","zh":"那里坐着两个挪威语班的同学，可是他们是谁呢？","words":[[0,3,20.9,21.142,"der"],[4,10,21.142,21.445,"sitter"],[11,13,21.5,21.665,"to"],[14,17,21.76,21.945,"fra"],[18,29,21.96,22.825,"norskkurset"],[31,34,23.28,23.465,"men"],[35,39,24.06,24.285,"hvem"],[40,42,24.4,24.545,"er"],[43,46,24.64,24.865,"det"]],"speaker":"Irina"},{"id":7,"start":26.1,"end":26.325,"text":"Hvor?","zh":"哪里？","words":[[0,4,26.1,26.325,"hvor"]],"speaker":"Pablo"},{"id":8,"start":27.22,"end":27.765,"text":"Der borte.","zh":"那边。","words":[[0,3,27.22,27.453,"der"],[4,9,27.453,27.765,"borte"]],"speaker":"Irina"},{"id":9,"start":29.44,"end":33.195,"text":"Å ja, det er Nelson. Han er en god venn.","zh":"哦，那是纳尔逊。他是个好朋友。","words":[[0,1,29.44,29.52,"å"],[2,4,29.55,29.695,"ja"],[6,9,30.63,30.792,"det"],[10,12,30.792,30.915,"er"],[13,19,30.95,31.475,"nelson"],[21,24,32.17,32.335,"han"],[25,27,32.37,32.502,"er"],[28,30,32.502,32.635,"en"],[31,34,32.67,32.933,"god"],[35,39,32.933,33.195,"venn"]],"speaker":"Pablo"},{"id":10,"start":34.49,"end":35.735,"text":"Heter han Nelson?","zh":"他叫纳尔逊吗？","words":[[0,5,34.49,34.882,"heter"],[6,9,34.882,35.035,"han"],[10,16,35.13,35.735,"nelson"]],"speaker":"Irina"},{"id":11,"start":36.93,"end":39.515,"text":"Vi sier Nelson, men han heter Thomas.","zh":"我们叫他纳尔逊，不过他名字叫托马斯。","words":[[0,2,36.93,37.055,"vi"],[3,7,37.11,37.433,"sier"],[8,14,37.433,37.915,"nelson"],[16,19,38.33,38.513,"men"],[20,23,38.513,38.675,"han"],[24,29,38.69,39.032,"heter"],[30,36,39.032,39.515,"thomas"]],"speaker":"Pablo"},{"id":12,"start":40.33,"end":41.095,"text":"Thomas Nelson.","zh":"托马斯·纳尔逊。","words":[[0,6,40.33,40.722,"thomas"],[7,13,40.722,41.095,"nelson"]],"speaker":"Pablo"},{"id":13,"start":42.56,"end":42.985,"text":"Thomas!","zh":"托马斯！","words":[[0,6,42.56,42.985,"thomas"]],"speaker":"Pablo"},{"id":14,"start":44.14,"end":45.365,"text":"Nei, nei, Pablo.","zh":"别，别，巴勃罗。","words":[[0,3,44.14,44.405,"nei"],[5,8,44.56,44.805,"nei"],[10,15,44.94,45.365,"pablo"]],"speaker":"Irina"},{"id":15,"start":46.68,"end":49.285,"text":"Thomas er hyggelig. Nå kommer han hit.","zh":"托马斯人很好。他现在过来了。","words":[[0,6,46.68,47.032,"thomas"],[7,9,47.032,47.153,"er"],[10,18,47.153,47.485,"hyggelig"],[20,22,48.52,48.645,"nå"],[23,29,48.7,48.932,"kommer"],[30,33,48.932,49.052,"han"],[34,37,49.052,49.285,"hit"]],"speaker":"Pablo"},{"id":16,"start":51.32,"end":52.165,"text":"Thomas kommer:","zh":"托马斯来了：","words":[[0,6,51.32,51.782,"thomas"],[7,13,51.782,52.165,"kommer"]]},{"id":17,"start":54.38,"end":54.605,"text":"Hei!","zh":"你好！","words":[[0,3,54.38,54.605,"hei"]],"speaker":"Thomas"},{"id":18,"start":55.38,"end":57.025,"text":"Irina, dette er Thomas.","zh":"伊琳娜，这位是托马斯。","words":[[0,5,55.38,55.765,"irina"],[7,12,56.1,56.405,"dette"],[13,15,56.42,56.562,"er"],[16,22,56.562,57.025,"thomas"]],"speaker":"Pablo"},{"id":19,"start":57.72,"end":60.145,"text":"Hei Irina. Hyggelig å hilse på deg.","zh":"嗨，伊琳娜。很高兴认识你。","words":[[0,3,57.72,57.945,"hei"],[4,9,58.02,58.405,"irina"],[11,19,59.12,59.483,"hyggelig"],[20,21,59.483,59.552,"å"],[22,27,59.552,59.862,"hilse"],[28,30,59.862,59.972,"på"],[31,34,59.972,60.145,"deg"]],"speaker":"Thomas"},{"id":20,"start":61.1,"end":61.965,"text":"I like måte.","zh":"我也一样。","words":[[0,1,61.1,61.205,"i"],[2,6,61.22,61.565,"like@pa-vei-like-same"],[7,11,61.58,61.965,"måte"]],"speaker":"Irina"},{"id":21,"start":62.96,"end":63.745,"text":"Hvor kommer du fra?","zh":"你来自哪里？","words":[[0,4,62.96,63.185,"hvor"],[5,11,63.2,63.483,"kommer"],[12,14,63.483,63.573,"du"],[15,18,63.573,63.745,"fra"]],"speaker":"Thomas"},{"id":22,"start":64.88,"end":65.705,"text":"Fra Latvia.","zh":"来自拉脱维亚。","words":[[0,3,64.88,65.065,"fra"],[4,10,65.16,65.705,"latvia"]],"speaker":"Irina"},{"id":23,"start":67.02,"end":68.405,"text":"Jeg kommer fra New Zealand.","zh":"我来自新西兰。","words":[[0,3,67.02,67.225,"jeg"],[4,10,67.26,67.532,"kommer"],[11,14,67.532,67.705,"fra"],[15,18,67.82,68.023,"new"],[19,26,68.023,68.405,"zealand"]],"speaker":"Thomas"},{"id":24,"start":70.0,"end":71.325,"text":"Hva gjør du, Irina?","zh":"伊琳娜，你在做什么？","words":[[0,3,70.0,70.185,"hva"],[4,8,70.54,70.812,"gjør"],[9,11,70.812,70.945,"du"],[13,18,70.98,71.325,"irina"]],"speaker":"Thomas"},{"id":25,"start":72.44,"end":75.105,"text":"Ingenting. Jeg står bare her.","zh":"没做什么。我就站在这里。","words":[[0,9,72.44,73.085,"ingenting"],[11,14,73.7,73.905,"jeg"],[15,19,74.0,74.345,"står"],[20,24,74.38,74.645,"bare"],[25,28,74.86,75.105,"her"]],"speaker":"Irina"},{"id":26,"start":76.24,"end":78.985,"text":"Jeg mener: Jobber du eller studerer du?","zh":"我的意思是：你在工作还是读书？","words":[[0,3,76.24,76.392,"jeg"],[4,9,76.392,76.765,"mener"],[11,17,77.46,77.812,"jobber"],[18,20,77.812,77.945,"du"],[21,26,78.24,78.463,"eller"],[27,35,78.463,78.882,"studerer"],[36,38,78.882,78.985,"du"]],"speaker":"Thomas"},{"id":27,"start":80.34,"end":81.445,"text":"Jeg er student.","zh":"我是学生。","words":[[0,3,80.34,80.565,"jeg"],[4,6,80.62,80.805,"er"],[7,14,80.84,81.445,"student"]],"speaker":"Irina"},{"id":28,"start":82.64,"end":83.365,"text":"Hva studerer du?","zh":"你学什么？","words":[[0,3,82.64,82.805,"hva"],[4,12,82.86,83.263,"studerer"],[13,15,83.263,83.365,"du"]],"speaker":"Thomas"},{"id":29,"start":84.46,"end":85.745,"text":"Jeg studerer norsk.","zh":"我学挪威语。","words":[[0,3,84.46,84.665,"jeg"],[4,12,84.72,85.225,"studerer"],[13,18,85.24,85.745,"norsk@pa-vei-norsk-adjective"]],"speaker":"Irina"},{"id":30,"start":86.86,"end":87.305,"text":"Går det bra?","zh":"学得顺利吗？","words":[[0,3,86.86,87.023,"går"],[4,7,87.023,87.142,"det"],[8,11,87.142,87.305,"bra"]],"speaker":"Thomas"},{"id":31,"start":88.56,"end":89.305,"text":"Ganske bra.","zh":"挺顺利的。","words":[[0,6,88.56,89.105,"ganske"],[7,10,89.12,89.305,"bra"]],"speaker":"Irina"},{"id":32,"start":90.34,"end":92.305,"text":"Så fint. Vi ses.","zh":"那太好了。回头见。","words":[[0,2,90.34,90.485,"så"],[3,7,90.52,90.905,"fint"],[9,11,91.86,91.985,"vi"],[12,15,92.0,92.305,"ses"]],"speaker":"Thomas"},{"id":33,"start":93.16,"end":93.385,"text":"Hei.","zh":"再见。","words":[[0,3,93.16,93.385,"hei"]],"speaker":"Irina"},{"id":34,"start":98.32,"end":99.085,"text":"Sammendrag.","zh":"摘要","words":[[0,10,98.32,99.085,"sammendrag"]]},{"id":35,"start":101.1,"end":107.465,"text":"Irina er på fest hos Pablo, og han får ei eske med sjokolade av henne.","zh":"伊琳娜在巴勃罗家参加聚会，送给他一盒巧克力。","words":[[0,5,101.1,101.785,"irina"],[6,8,101.9,102.065,"er"],[9,11,102.08,102.205,"på"],[12,16,102.28,102.612,"fest"],[17,20,102.612,102.825,"hos"],[21,26,10