{"id":"4.4","title":"På kafé","audio":"audio/4.4.mp3","duration":214.31,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.4,"text":"4.4 På kafé","heading":true,"zh":"4.4 在咖啡馆","words":[[0,3,0.15,1.21,"4.4"],[4,6,2.52,2.69,"på"],[7,11,2.69,3.32,"kafé"]]},{"id":1,"start":4.95,"end":9.99,"text":"Håvard og Bjørnar er på kafeen og venter på et ledig bord.","zh":"霍瓦尔和比约纳尔在咖啡馆里，等着空桌。","words":[[0,6,5.01,5.5,"håvard"],[7,9,5.5,5.62,"og"],[10,17,5.62,6.34,"bjørnar"],[18,20,6.44,6.7,"er"],[21,23,6.7,6.82,"på"],[24,30,6.82,7.56,"kafeen"],[31,33,8.04,8.18,"og"],[34,40,8.18,8.72,"venter"],[41,43,8.72,8.92,"på~1da53a3cc68f"],[44,46,8.92,9.12,"et~054dde72f37b"],[47,52,9.12,9.46,"ledig"],[53,57,9.46,9.84,"bord"]]},{"id":2,"start":10.93,"end":12.4,"text":"Det er mye folk.","zh":"人很多。","words":[[0,3,10.99,11.14,"det"],[4,6,11.14,11.4,"er"],[7,10,11.4,11.78,"mye~cc164d0dc3da"],[11,15,11.78,12.25,"folk"]]},{"id":3,"start":13.32,"end":18.95,"text":"Servitøren kommer, og det er Sompit fra klassen til Håvard.","zh":"服务员来了，原来是霍瓦尔班上的松皮特。","words":[[0,10,13.38,14.26,"servitøren"],[11,17,14.26,14.78,"kommer"],[19,21,15.36,15.56,"og"],[22,25,15.56,15.86,"det~e00592c2ff56"],[26,28,15.86,16.26,"er"],[29,35,16.26,17.15,"sompit"],[36,39,17.28,17.64,"fra"],[40,47,17.64,18.08,"klassen"],[48,51,18.08,18.28,"til~8de1a9181f86"],[52,58,18.28,18.8,"håvard"]]},{"id":4,"start":20.56,"end":24.81,"text":"Hei, Sompit! Har du et ledig bord til oss?","speaker":"Håvard","zh":"你好，松皮特！有空桌给我们吗？","words":[[0,3,20.56,21.18,"hei"],[5,11,21.18,21.89,"sompit"],[13,16,22.98,23.22,"har"],[17,19,23.22,23.38,"du"],[20,22,23.38,23.58,"et~054dde72f37b"],[23,28,23.58,24.0,"ledig"],[29,33,24.0,24.26,"bord"],[34,37,24.26,24.42,"til"],[38,41,24.42,24.66,"oss"]]},{"id":5,"start":26.02,"end":30.07,"text":"Det er mye folk i dag, men nå har vi et ledig bord.","speaker":"Sompit","zh":"今天人很多，不过现在我们有一张空桌。","words":[[0,3,26.07,26.26,"det"],[4,6,26.26,26.52,"er"],[7,10,26.52,26.92,"mye~cc164d0dc3da"],[11,15,26.92,27.28,"folk"],[16,17,27.28,27.36,"i~de136e71704d"],[18,21,27.36,27.79,"dag~83a758a6ca25"],[23,26,28.22,28.44,"men"],[27,29,28.44,28.7,"nå~d531d47a7712"],[30,33,28.7,28.9,"har"],[34,36,28.9,29.04,"vi"],[37,39,29.04,29.16,"et~054dde72f37b"],[40,45,29.16,29.44,"ledig"],[46,50,29.44,30.07,"bord"]]},{"id":6,"start":31.82,"end":34.57,"text":"Håvard og Bjørnar leser menyen.","zh":"霍瓦尔和比约纳尔看菜单。","words":[[0,6,31.88,32.4,"håvard"],[7,9,32.4,32.5,"og"],[10,17,32.5,33.17,"bjørnar"],[18,23,33.38,33.86,"leser"],[24,30,33.86,34.42,"menyen"]]},{"id":7,"start":35.9,"end":41.3,"text":"Vil dere bestille? Vi har ei nydelig fiskesuppe.","speaker":"Sompit","zh":"你们要点餐吗？我们有一道很美味的鱼汤。","words":[[0,3,35.91,36.42,"vil"],[4,8,36.42,36.7,"dere"],[9,17,36.7,37.34,"bestille"],[19,21,38.62,38.8,"vi"],[22,25,38.8,39.06,"har"],[26,28,39.06,39.39,"ei~47aa2d18e376"],[29,36,39.62,40.44,"nydelig"],[37,47,40.44,41.16,"fiskesuppe"]]},{"id":8,"start":42.52,"end":46.0,"text":"Det vil jeg gjerne ha. Jeg er veldig sulten.","speaker":"Bjørnar","zh":"我想要那个。我很饿。","words":[[0,3,42.58,42.82,"det~3af465fe7469"],[4,7,42.82,42.98,"vil"],[8,11,42.98,43.18,"jeg"],[12,18,43.18,43.62,"gjerne"],[19,21,43.62,43.91,"ha~7724ec04e04d"],[23,26,44.64,44.88,"jeg"],[27,29,44.88,45.1,"er"],[30,36,45.1,45.44,"veldig"],[37,43,45.44,45.85,"sulten"]]},{"id":9,"start":47.55,"end":52.27,"text":"Jeg er ikke så glad i fisk. Jeg har lyst på tomatsuppe.","speaker":"Håvard","zh":"我不太喜欢鱼。我想要番茄汤。","words":[[0,3,47.62,48.08,"jeg"],[4,6,48.08,48.26,"er"],[7,11,48.26,48.5,"ikke"],[12,14,48.5,48.7,"så~234c1b75eda3"],[15,19,48.7,49.04,"glad~520df1f02aa1"],[20,21,49.04,49.16,"i~e5138c62e355"],[22,26,49.16,49.76,"fisk"],[28,31,50.44,50.66,"jeg"],[32,35,50.66,50.78,"har~2fe5eb128613"],[36,40,50.78,51.1,"lyst~0eef5d2ccab2"],[41,43,51.1,51.3,"på~40ad664c0969"],[44,54,51.3,52.12,"tomatsuppe"]]},{"id":10,"start":53.16,"end":59.87,"text":"Kan vi få ei fiskesuppe, ei tomatsuppe og to glass vann, takk? Jeg er så tørst.","speaker":"Bjørnar","zh":"请给我们一份鱼汤、一份番茄汤和两杯水，好吗？我好渴。","words":[[0,3,53.22,53.5,"kan"],[4,6,53.5,53.72,"vi"],[7,9,53.72,54.1,"få~2d76753498da"],[10,12,54.1,54.32,"ei~47aa2d18e376"],[13,23,54.32,55.21,"fiskesuppe"],[25,27,55.5,55.8,"ei~47aa2d18e376"],[28,38,55.8,56.84,"tomatsuppe"],[39,41,56.84,57.04,"og"],[42,44,57.04,57.4,"to"],[45,50,57.4,57.84,"glass"],[51,55,57.84,58.08,"vann"],[57,61,58.08,58.55,"takk"],[63,66,58.92,59.1,"jeg"],[67,69,59.1,59.26,"er"],[70,72,59.26,59.4,"så~3eb4f5820d33"],[73,78,59.4,59.72,"tørst"]]},{"id":11,"start":60.94,"end":63.52,"text":"Jeg kan hente ei mugge med vann.","speaker":"Sompit","zh":"我可以拿一壶水来。","words":[[0,3,60.95,61.48,"jeg"],[4,7,61.48,61.66,"kan"],[8,13,61.66,62.12,"hente"],[14,16,62.12,62.34,"ei~47aa2d18e376"],[17,22,62.34,62.68,"mugge"],[23,26,62.68,62.84,"med~a913f6e412f6"],[27,31,62.84,63.52,"vann"]]},{"id":12,"start":65.58,"end":68.72,"text":"Bjørnar og Håvard venter på maten.","zh":"比约纳尔和霍瓦尔在等上菜。","words":[[0,7,65.64,66.18,"bjørnar"],[8,10,66.18,66.3,"og"],[11,17,66.3,66.96,"håvard"],[18,24,67.46,67.94,"venter"],[25,27,67.94,68.08,"på~1da53a3cc68f"],[28,33,68.08,68.56,"maten"]]},{"id":13,"start":70.34,"end":73.63,"text":"Hva pleier du å gjøre i helgene uten barna?","speaker":"Håvard","zh":"孩子不在的周末，你通常做什么？","words":[[0,3,70.35,70.92,"hva"],[4,10,70.92,71.24,"pleier"],[11,13,71.24,71.42,"du"],[14,15,71.42,71.52,"å~0583da7a620a"],[16,21,71.52,71.8,"gjøre"],[22,23,71.8,71.88,"i~0e9dae9ea653"],[24,31,71.88,72.54,"helgene"],[32,36,72.54,72.98,"uten"],[37,42,72.98,73.48,"barna"]]},{"id":14,"start":74.36,"end":87.83,"text":"Av og til spiser jeg frokost på kafé og leser nyheter. Jeg pleier å trene, og jeg sykler ofte. Noen ganger går jeg på fjelltur. Jeg pleier også å jogge i skogen.","speaker":"Bjørnar","zh":"有时我在咖啡馆吃早餐、看新闻。我通常会锻炼，还经常骑自行车。有时我去爬山。我也常在树林里慢跑。","words":[[0,2,74.42,74.62,"av~26a687fec87a"],[3,5,74.62,74.74,"og~a1e5742503b8"],[6,9,74.74,75.08,"til~69fe6862a430"],[10,16,75.08,75.4,"spiser"],[17,20,75.4,75.58,"jeg"],[21,28,75.58,76.14,"frokost"],[29,31,76.14,76.3,"på"],[32,36,76.3,76.82,"kafé"],[37,39,76.82,76.94,"og"],[40,45,76.94,77.3,"leser"],[46,53,77.3,77.96,"nyheter"],[55,58,79.24,79.46,"jeg"],[59,65,79.46,79.76,"pleier"],[66,67,79.76,79.86,"å~0583da7a620a"],[68,73,79.86,80.44,"trene"],[75,77,80.64,80.74,"og"],[78,81,80.74,80.94,"jeg"],[82,88,80.94,81.44,"sykler"],[89,93,81.44,81.92,"ofte"],[95,99,82.84,83.2,"noen~c766e2ef794d"],[100,106,83.2,83.6,"ganger~cc17bde91843"],[107,110,83.6,83.78,"går~0e06df6d213c"],[111,114,83.78,83.92,"jeg"],[115,117,83.92,84.12,"på~2460f2e26566"],[118,126,84.12,84.92,"fjelltur"],[128,131,85.78,85.96,"jeg"],[132,138,85.96,86.3,"pleier"],[139,143,86.3,86.68,"også"],[144,145,86.68,86.86,"å~0583da7a620a"],[146,151,86.86,87.24,"jogge"],[152,153,87.24,87.34,"i"],[154,160,87.34,87.68,"skogen"]]},{"id":15,"start":88.93,"end":98.89,"text":"Så aktiv du er! Jeg pleier bare å se på tv i helgene. Det er slitsomt å være lærer. Jeg liker å slappe av.","speaker":"Håvard","zh":"你真爱运动！我周末通常只看电视。当老师很累，我喜欢放松。","words":[[0,2,88.99,89.42,"så~62ff2f35e607"],[3,8,89.42,89.92,"aktiv"],[9,11,89.92,90.06,"du"],[12,14,90.06,90.4,"er"],[16,19,91.36,91.62,"jeg"],[20,26,91.62,91.92,"pleier"],[27,31,91.92,92.08,"bare"],[32,33,92.08,92.2,"å~0583da7a620a"],[34,36,92.2,92.38,"se"],[37,39,92.38,92.56,"på~fab38a6838d6"],[40,42,92.56,93.08,"tv"],[43,44,93.08,93.18,"i~0e9dae9ea653"],[45,52,93.18,93.76,"helgene"],[54,57,94.8,94.96,"det~58558718702a"],[58,60,94.96,95.14,"er"],[61,69,95.14,95.84,"slitsomt"],[70,71,95.84,95.9,"å~0583da7a620a"],[72,76,95.9,96.12,"være"],[77,82,96.12,96.64,"lærer~37398342c31f"],[84,87,97.5,97.72,"jeg"],[88,93,97.72,98.1,"liker"],[94,95,98.1,98.22,"å~0583da7a620a"],[96,102,98.22,98.6,"slappe~75bc27ca2f9a"],[103,105,98.6,98.74,"av~6aef60c561bf"]]},{"id":16,"start":99.16,"end":101.42,"text":"Ja, det ser jeg på magen.","speaker":"Bjørnar","zh":"是啊，从你的肚子就看得出来。","words":[[0,2,99.22,99.72,"ja"],[4,7,99.72,99.96,"det~b79888f9f677"],[8,11,99.96,100.22,"ser~f2377de43ae0"],[12,15,100.22,100.4,"jeg"],[16,18,100.4,100.56,"på~b9254829c613"],[19,24,100.56,101.42,"magen"]]},{"id":17,"start":102.59,"end":104.4,"text":"Håvard og Bjørnar ler.","zh":"霍瓦尔和比约纳尔笑了。","words":[[0,6,102.66,103.2,"håvard"],[7,9,103.2,103.32,"og"],[10,17,103.32,103.84,"bjørnar"],[18,21,103.84,104.25,"ler"]]},{"id":18,"start":105.37,"end":108.17,"text":"Sompit kommer med maten og vannet.","zh":"松皮特端来了饭菜和水。","words":[[0,6,105.43,106.3,"sompit"],[7,13,106.3,106.7,"kommer"],[14,17,106.7,106.86,"med~ed87d9f28f46"],[18,23,106.86,107.48,"maten"],[24,26,107.48,107.62,"og"],[27,33,107.62,108.02,"vannet"]]},{"id":19,"start":112.33,"end":113.35,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,112.39,113.2,"sammendrag"]]},{"id":20,"start":114.8,"end":117.41,"text":"Bjørnar og Håvard er på kafé.","zh":"比约纳尔和霍瓦尔在咖啡馆。","words":[[0,7,114.86,115.5,"bjørnar"],[8,10,115.5,115.62,"og"],[11,17,115.62,116.3,"håvard"],[18,20,116.48,116.7,"er"],[21,23,116.7,116.84,"på"],[24,28,116.84,117.26,"kafé"]]},{"id":21,"start":118.68,"end":123.71,"text":"De bestiller suppe og mye vann, for Bjørnar er veldig tørst.","zh":"他们点了汤和很多水，因为比约纳尔很渴。","words":[[0,2,118.74,119.02,"de"],[3,12,119.02,119.62,"bestiller"],[13,18,119.62,120.22,"suppe"],[19,21,120.22,120.46,"og"],[22,25,120.46,120.8,"mye~cc164d0dc3da"],[26,30,120.8,121.26,"vann"],[32,35,121.68,121.9,"for~a05c87659379"],[36,43,121.9,122.44,"bjørnar"],[44,46,122.44,122.72,"er"],[47,53,122.72,123.06,"veldig"],[54,59,123.06,123.56,"tørst"]]},{"id":22,"start":124.84,"end":127.68,"text":"De venter på maten og snakker sammen.","zh":"他们一边等上菜一边聊天。","words":[[0,2,124.9,125.2,"de"],[3,9,125.2,125.64,"venter"],[10,12,125.64,125.78,"på~1da53a3cc68f"],[13,18,125.78,126.36,"maten"],[19,21,126.6,126.72,"og"],[22,29,126.72,127.14,"snakker"],[30,36,127.14,127.53,"sammen"]]},{"id":23,"start":128.99,"end":132.06,"text":"Bjørnar pleier å være aktiv i helgene.","zh":"比约纳尔周末通常很爱运动。","words":[[0,7,129.05,129.78,"bjørnar"],[8,14,130.12,130.54,"pleier"],[15,16,130.54,130.64,"å~0583da7a620a"],[17,21,130.64,130.88,"være"],[22,27,130.88,131.32,"aktiv"],[28,29,131.32,131.4,"i~0e9dae9ea653"],[30,37,131.4,131.91,"helgene"]]},{"id":24,"start":133.39,"end":136.09,"text":"Håvard pleier bare å slappe av.","zh":"霍瓦尔通常只是放松休息。","words":[[0,6,133.45,134.22,"håvard"],[7,13,134.4,134.82,"pleier"],[14,18,134.82,135.08,"bare"],[19,20,135.08,135.28,"å~0583da7a620a"],[21,27,135.28,135.7,"slappe~75bc27ca2f9a"],[28,30,135.7,135.94,"av~6aef60c561bf"]]},{"id":25,"start":137.28,"end":139.55,"text":"De har det hyggelig og ler mye.","zh":"他们过得很愉快，笑个不停。","words":[[0,2,137.34,137.62,"de"],[3,6,137.62,137.8,"har~57b46e8e722d"],[7,10,137.8,137.94,"det~aef4434dacc8"],[11,19,137.94,138.48,"hyggelig"],[20,22,138.48,138.66,"og"],[23,26,138.66,139.02,"ler"],[27,30,139.02,139.4,"mye~933c5a923198"]]},{"id":26,"start":141.12,"end":143.94,"text":"Servitøren kommer med maten og vannet.","zh":"服务员端来了饭菜和水。","words":[[0,10,141.18,142.14,"servitøren"],[11,17,142.24,142.58,"kommer"],[18,21,142.58,142.74,"med~ed87d9f28f46"],[22,27,142.74,143.32,"maten"],[28,30,143.32,143.44,"og"],[31,37,143.44,143.78,"vannet"]]},{"id":27,"start":148.17,"end":149.78,"text":"Hva liker du å gjøre?","zh":"你喜欢做什么？","words":[[0,3,148.23,148.56,"hva"],[4,9,148.56,148.96,"liker"],[10,12,148.96,149.12,"du"],[13,14,149.12,149.22,"å~0583da7a620a"],[15,20,149.22,149.63,"gjøre"]]},{"id":28,"start":151.53,"end":152.84,"text":"Jeg liker å …","zh":"我喜欢……","words":[[0,3,151.59,151.98,"jeg"],[4,9,151.98,152.38,"liker"],[10,11,152.38,152.69,"å~0583da7a620a"]]},{"id":29,"start":155.0,"end":157.88,"text":"Sofie liker å spise is.","zh":"苏菲喜欢吃冰淇淋。","words":[[0,5,155.06,155.84,"sofie"],[6,11,156.12,156.72,"liker"],[12,13,156.72,156.86,"å~0583da7a620a"],[14,19,156.86,157.3,"spise"],[20,22,157.3,157.73,"is"]]},{"id":30,"start":159.47,"end":162.63,"text":"Eivind liker å spille fotball.","zh":"埃温德喜欢踢足球。","words":[[0,6,159.53,160.3,"eivind"],[7,12,160.66,161.36,"liker"],[13,14,161.36,161.64,"å~0583da7a620a"],[15,21,161.64,161.96,"spille"],[22,29,161.96,162.48,"fotball"]]},{"id":31,"start":164.31,"end":167.19,"text":"Hawa liker å høre på musikk.","zh":"哈娃喜欢听音乐。","words":[[0,4,164.38,164.96,"hawa"],[5,10,165.32,165.9,"liker"],[11,12,165.9,166.06,"å~0583da7a620a"],[13,17,166.06,166.34,"høre~8d32f4406504"],[18,20,166.34,166.52,"på~33449e88ce8b"],[21,27,166.52,167.04,"musikk"]]},{"id":32,"start":169.06,"end":171.97,"text":"Synne liker å gå på konsert.","zh":"辛妮喜欢去听音乐会。","words":[[0,5,169.12,169.84,"synne"],[6,11,170.2,170.72,"liker"],[12,13,170.72,170.84,"å~0583da7a620a"],[14,16,170.84,171.06,"gå"],[17,19,171.06,171.2,"på~770498f5459a"],[20,27,171.2,171.81,"konsert"]]},{"id":33,"start":173.97,"end":176.97,"text":"Sompit liker å lære norsk.","zh":"松皮特喜欢学挪威语。","words":[[0,6,174.03,175.1,"sompit"],[7,12,175.1,175.78,"liker"],[13,14,175.78,175.92,"å~0583da7a620a"],[15,19,175.92,176.3,"lære~50d7c648b04b"],[20,25,176.3,176.82,"norsk~4de5d75feae1"]]},{"id":34,"start":178.61,"end":181.45,"text":"Markus liker å se på barne-tv.","zh":"马库斯喜欢看儿童电视节目。","words":[[0,6,178.67,179.5,"markus"],[7,12,179.6,180.14,"liker"],[13,14,180.14,180.26,"å~0583da7a620a"],[15,17,180.26,180.46,"se"],[18,20,180.46,180.62,"på~fab38a6838d6"],[21,29,180.62,181.3,"barne-tv"]]},{"id":35,"start":183.4,"end":186.62,"text":"Marek liker å snakke med Ewa på Skype.","zh":"马雷克喜欢在 Skype 上和埃娃聊天。","words":[[0,5,183.46,184.16,"marek"],[6,11,184.16,184.68,"liker"],[12,13,184.68,184.78,"å~0583da7a620a"],[14,20,184.78,185.18,"snakke"],[21,24,185.18,185.36,"med"],[25,28,185.36,185.78,"ewa"],[29,31,185.78,185.94,"på~acc985c9313f"],[32,37,185.94,186.47,"skype"]]},{"id":36,"start":188.37,"end":191.59,"text":"Bjørnar liker å være sammen med barna.","zh":"比约纳尔喜欢和孩子们待在一起。","words":[[0,7,188.43,189.14,"bjørnar"],[8,13,189.5,190.14,"liker"],[14,15,190.14,190.26,"å~0583da7a620a"],[16,20,190.26,190.48,"være"],[21,27,190.48,190.84,"sammen"],[28,31,190.84,191.0,"med"],[32,37,191.0,191.44,"barna"]]},{"id":37,"start":193.23,"end":199.69,"text":"Det er infinitiv med «å» etter «liker», men 