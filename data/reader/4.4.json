{"id":"4.4","title":"På kafé","audio":"audio/4.4.mp3","duration":214.31,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.4,"text":"4.4 På kafé","heading":true,"zh":"4.4 在咖啡馆","words":[[0,3,0.15,1.21,"4.4"],[4,6,2.52,2.69,"på"],[7,11,2.69,3.32,"kafé"]]},{"id":1,"start":4.91,"end":9.93,"text":"Håvard og Bjørnar er på kafeen og venter på et ledig bord.","zh":"霍瓦尔和比约纳尔在咖啡馆里，等着空桌。","words":[[0,6,4.99,5.42,"håvard"],[7,9,5.42,5.58,"og"],[10,17,5.58,6.08,"bjørnar"],[18,20,6.08,6.58,"er"],[21,23,6.58,6.78,"på"],[24,30,6.78,7.42,"kafeen"],[31,33,7.42,8.12,"og"],[34,40,8.12,8.6,"venter"],[41,43,8.6,8.86,"på~1da53a3cc68f"],[44,46,8.86,9.06,"et~054dde72f37b"],[47,52,9.06,9.38,"ledig"],[53,57,9.38,9.85,"bord"]]},{"id":2,"start":10.91,"end":12.35,"text":"Det er mye folk.","zh":"人很多。","words":[[0,3,10.99,11.11,"det"],[4,6,11.11,11.27,"er"],[7,10,11.27,11.71,"mye~cc164d0dc3da"],[11,15,11.71,12.27,"folk"]]},{"id":3,"start":13.13,"end":18.89,"text":"Servitøren kommer, og det er Sompit fra klassen til Håvard.","zh":"服务员来了，原来是霍瓦尔班上的松皮特。","words":[[0,10,13.21,14.18,"servitøren"],[11,17,14.18,14.5,"kommer"],[19,21,15.37,15.46,"og"],[22,25,15.46,15.72,"det~e00592c2ff56"],[26,28,15.72,16.07,"er"],[29,35,16.07,16.93,"sompit"],[36,39,16.93,17.43,"fra"],[40,47,17.43,17.98,"klassen"],[48,51,17.98,18.18,"til~8de1a9181f86"],[52,58,18.18,18.81,"håvard"]]},{"id":4,"start":18.97,"end":24.74,"text":"Hei, Sompit! Har du et ledig bord til oss?","speaker":"Håvard","zh":"你好，松皮特！有空桌给我们吗？","words":[[0,3,20.61,21.16,"hei"],[5,11,21.27,21.61,"sompit"],[13,16,22.91,23.16,"har"],[17,19,23.16,23.32,"du"],[20,22,23.32,23.52,"et~054dde72f37b"],[23,28,23.52,23.95,"ledig"],[29,33,23.95,24.14,"bord"],[34,37,24.14,24.34,"til"],[38,41,24.34,24.55,"oss"]]},{"id":5,"start":25.61,"end":31.39,"text":"Det er mye folk i dag, men nå har vi et ledig bord.","speaker":"Sompit","zh":"今天人很多，不过现在我们有一张空桌。","words":[[0,3,26.0,26.16,"det"],[4,6,26.16,26.38,"er"],[7,10,26.38,26.84,"mye~cc164d0dc3da"],[11,15,26.84,27.09,"folk"],[16,17,27.09,27.34,"i~de136e71704d"],[18,21,27.34,27.48,"dag~83a758a6ca25"],[23,26,28.07,28.3,"men"],[27,29,28.3,28.57,"nå~d531d47a7712"],[30,33,28.57,28.82,"har"],[34,36,28.82,28.98,"vi"],[37,39,28.98,29.09,"et~054dde72f37b"],[40,45,29.09,29.39,"ledig"],[46,50,29.39,29.59,"bord"]]},{"id":6,"start":31.79,"end":34.53,"text":"Håvard og Bjørnar leser menyen.","zh":"霍瓦尔和比约纳尔看菜单。","words":[[0,6,31.87,32.31,"håvard"],[7,9,32.31,32.45,"og"],[10,17,32.45,32.9,"bjørnar"],[18,23,32.9,33.76,"leser"],[24,30,33.76,34.45,"menyen"]]},{"id":7,"start":34.77,"end":41.53,"text":"Vil dere bestille? Vi har ei nydelig fiskesuppe.","speaker":"Sompit","zh":"你们要点餐吗？我们有一道很美味的鱼汤。","words":[[0,3,35.91,36.35,"vil"],[4,8,36.35,36.58,"dere"],[9,17,36.58,37.05,"bestille"],[19,21,38.38,38.72,"vi"],[22,25,38.72,38.95,"har"],[26,28,38.95,39.17,"ei~47aa2d18e376"],[29,36,39.17,40.35,"nydelig"],[37,47,40.35,41.16,"fiskesuppe"]]},{"id":8,"start":42.11,"end":45.7,"text":"Det vil jeg gjerne ha. Jeg er veldig sulten.","speaker":"Bjørnar","zh":"我想要那个。我很饿。","words":[[0,3,42.48,42.77,"det~3af465fe7469"],[4,7,42.77,42.91,"vil"],[8,11,42.91,43.06,"jeg"],[12,18,43.06,43.52,"gjerne"],[19,21,43.52,43.73,"ha~7724ec04e04d"],[23,26,44.56,44.74,"jeg"],[27,29,44.74,44.97,"er"],[30,36,44.97,45.42,"veldig"],[37,43,45.42,45.7,"sulten"]]},{"id":9,"start":46.66,"end":52.56,"text":"Jeg er ikke så glad i fisk. Jeg har lyst på tomatsuppe.","speaker":"Håvard","zh":"我不太喜欢鱼。我想要番茄汤。","words":[[0,3,47.23,47.88,"jeg"],[4,6,47.88,48.23,"er"],[7,11,48.23,48.38,"ikke"],[12,14,48.38,48.59,"så~234c1b75eda3"],[15,19,48.59,48.92,"glad~520df1f02aa1"],[20,21,48.92,49.12,"i~e5138c62e355"],[22,26,49.12,49.59,"fisk"],[28,31,50.02,50.58,"jeg"],[32,35,50.58,50.73,"har~2fe5eb128613"],[36,40,50.73,50.98,"lyst~0eef5d2ccab2"],[41,43,50.98,51.17,"på~40ad664c0969"],[44,54,51.17,52.09,"tomatsuppe"]]},{"id":10,"start":52.57,"end":59.89,"text":"Kan vi få ei fiskesuppe, ei tomatsuppe og to glass vann, takk? Jeg er så tørst.","speaker":"Bjørnar","zh":"请给我们一份鱼汤、一份番茄汤和两杯水，好吗？我好渴。","words":[[0,3,53.19,53.34,"kan"],[4,6,53.34,53.59,"vi"],[7,9,53.59,53.88,"få~2d76753498da"],[10,12,53.88,54.2,"ei~47aa2d18e376"],[13,23,54.2,55.06,"fiskesuppe"],[25,27,55.45,55.65,"ei~47aa2d18e376"],[28,38,55.65,56.73,"tomatsuppe"],[39,41,56.73,56.91,"og"],[42,44,56.91,57.24,"to"],[45,50,57.24,57.69,"glass"],[51,55,57.69,58.0,"vann"],[57,61,58.0,58.31,"takk"],[63,66,58.83,59.01,"jeg"],[67,69,59.01,59.2,"er"],[70,72,59.2,59.34,"så~3eb4f5820d33"],[73,78,59.34,59.69,"tørst"]]},{"id":11,"start":61.01,"end":65.09,"text":"Jeg kan hente ei mugge med vann.","speaker":"Sompit","zh":"我可以拿一壶水来。","words":[[0,3,61.15,61.37,"jeg"],[4,7,61.37,61.59,"kan"],[8,13,61.59,61.92,"hente"],[14,16,61.92,62.23,"ei~47aa2d18e376"],[17,22,62.23,62.6,"mugge"],[23,26,62.6,62.74,"med~a913f6e412f6"],[27,31,62.74,63.05,"vann"]]},{"id":12,"start":65.55,"end":68.66,"text":"Bjørnar og Håvard venter på maten.","zh":"比约纳尔和霍瓦尔在等上菜。","words":[[0,7,65.63,66.11,"bjørnar"],[8,10,66.11,66.25,"og"],[11,17,66.25,66.71,"håvard"],[18,24,67.3,67.75,"venter"],[25,27,67.75,68.02,"på~1da53a3cc68f"],[28,33,68.02,68.58,"maten"]]},{"id":13,"start":68.88,"end":73.73,"text":"Hva pleier du å gjøre i helgene uten barna?","speaker":"Håvard","zh":"孩子不在的周末，你通常做什么？","words":[[0,3,70.64,70.8,"hva"],[4,10,70.8,71.14,"pleier"],[11,13,71.14,71.33,"du"],[14,15,71.33,71.45,"å~0583da7a620a"],[16,21,71.45,71.72,"gjøre"],[22,23,71.72,71.83,"i~0e9dae9ea653"],[24,31,71.83,72.31,"helgene"],[32,36,72.31,72.89,"uten"],[37,42,72.89,73.28,"barna"]]},{"id":14,"start":74.01,"end":88.03,"text":"Av og til spiser jeg frokost på kafé og leser nyheter. Jeg pleier å trene, og jeg sykler ofte. Noen ganger går jeg på fjelltur. Jeg pleier også å jogge i skogen.","speaker":"Bjørnar","zh":"有时我在咖啡馆吃早餐、看新闻。我通常会锻炼，还经常骑自行车。有时我去爬山。我也常在树林里慢跑。","words":[[0,2,74.31,74.59,"av~26a687fec87a"],[3,5,74.59,74.67,"og~a1e5742503b8"],[6,9,74.67,74.89,"til~69fe6862a430"],[10,16,74.89,75.36,"spiser"],[17,20,75.36,75.53,"jeg"],[21,28,75.53,76.06,"frokost"],[29,31,76.06,76.22,"på"],[32,36,76.22,76.53,"kafé"],[37,39,76.53,76.89,"og"],[40,45,76.89,77.22,"leser"],[46,53,77.22,77.66,"nyheter"],[55,58,79.06,79.34,"jeg"],[59,65,79.34,79.64,"pleier"],[66,67,79.64,79.83,"å~0583da7a620a"],[68,73,79.83,80.2,"trene"],[75,77,80.53,80.72,"og"],[78,81,80.72,80.84,"jeg"],[82,88,80.84,81.34,"sykler"],[89,93,81.34,81.7,"ofte"],[95,99,82.69,83.14,"noen~c766e2ef794d"],[100,106,83.14,83.5,"ganger~cc17bde91843"],[107,110,83.5,83.7,"går~0e06df6d213c"],[111,114,83.7,83.84,"jeg"],[115,117,83.84,84.0,"på~2460f2e26566"],[118,126,84.0,84.64,"fjelltur"],[128,131,85.64,85.89,"jeg"],[132,138,85.89,86.17,"pleier"],[139,143,86.17,86.55,"også"],[144,145,86.55,86.81,"å~0583da7a620a"],[146,151,86.81,87.2,"jogge"],[152,153,87.2,87.31,"i"],[154,160,87.31,87.61,"skogen"]]},{"id":15,"start":88.26,"end":99.17,"text":"Så aktiv du er! Jeg pleier bare å se på tv i helgene. Det er slitsomt å være lærer. Jeg liker å slappe av.","speaker":"Håvard","zh":"你真爱运动！我周末通常只看电视。当老师很累，我喜欢放松。","words":[[0,2,88.89,89.22,"så~62ff2f35e607"],[3,8,89.22,89.75,"aktiv"],[9,11,89.75,90.02,"du"],[12,14,90.02,90.16,"er"],[16,19,91.19,91.5,"jeg"],[20,26,91.5,91.8,"pleier"],[27,31,91.8,92.02,"bare"],[32,33,92.02,92.16,"å~0583da7a620a"],[34,36,92.16,92.3,"se"],[37,39,92.3,92.45,"på~fab38a6838d6"],[40,42,92.45,92.89,"tv"],[43,44,92.89,93.16,"i~0e9dae9ea653"],[45,52,93.16,93.47,"helgene"],[54,57,94.69,94.92,"det~58558718702a"],[58,60,94.92,95.05,"er"],[61,69,95.05,95.78,"slitsomt"],[70,71,95.78,95.83,"å~0583da7a620a"],[72,76,95.83,96.0,"være"],[77,82,96.0,96.39,"lærer~37398342c31f"],[84,87,97.36,97.62,"jeg"],[88,93,97.62,98.05,"liker"],[94,95,98.05,98.14,"å~0583da7a620a"],[96,102,98.14,98.5,"slappe~75bc27ca2f9a"],[103,105,98.5,98.67,"av~6aef60c561bf"]]},{"id":16,"start":99.18,"end":102.3,"text":"Ja, det ser jeg på magen.","speaker":"Bjørnar","zh":"是啊，从你的肚子就看得出来。","words":[[0,2,99.19,99.53,"ja"],[4,7,99.7,99.84,"det~b79888f9f677"],[8,11,99.84,100.12,"ser~f2377de43ae0"],[12,15,100.12,100.31,"jeg"],[16,18,100.31,100.48,"på~b9254829c613"],[19,24,100.48,100.91,"magen"]]},{"id":17,"start":102.57,"end":104.33,"text":"Håvard og Bjørnar ler.","zh":"霍瓦尔和比约纳尔笑了。","words":[[0,6,102.65,103.09,"håvard"],[7,9,103.09,103.25,"og"],[10,17,103.25,103.69,"bjørnar"],[18,21,103.69,104.25,"ler"]]},{"id":18,"start":105.33,"end":108.11,"text":"Sompit kommer med maten og vannet.","zh":"松皮特端来了饭菜和水。","words":[[0,6,105.41,106.16,"sompit"],[7,13,106.16,106.54,"kommer"],[14,17,106.54,106.78,"med~ed87d9f28f46"],[18,23,106.78,107.32,"maten"],[24,26,107.32,107.56,"og"],[27,33,107.56,108.03,"vannet"]]},{"id":19,"start":112.29,"end":113.28,"text":"Sammendrag","subheading":true,"zh":"内容摘要","words":[[0,10,112.37,113.2,"sammendrag"]]},{"id":20,"start":114.77,"end":117.35,"text":"Bjørnar og Håvard er på kafé.","zh":"比约纳尔和霍瓦尔在咖啡馆。","words":[[0,7,114.85,115.32,"bjørnar"],[8,10,115.32,115.58,"og"],[11,17,115.58,116.08,"håvard"],[18,20,116.08,116.62,"er"],[21,23,116.62,116.78,"på"],[24,28,116.78,117.27,"kafé"]]},{"id":21,"start":117.72,"end":123.64,"text":"De bestiller suppe og mye vann, for Bjørnar er veldig tørst.","zh":"他们点了汤和很多水，因为比约纳尔很渴。","words":[[0,2,118.36,118.91,"de"],[3,12,118.91,119.42,"bestiller"],[13,18,119.42,120.0,"suppe"],[19,21,120.0,120.33,"og"],[22,25,120.33,120.75,"mye~cc164d0dc3da"],[26,30,120.75,121.05,"vann"],[32,35,121.28,121.83,"for~a05c87659379"],[36,43,121.83,122.25,"bjørnar"],[44,46,122.25,122.58,"er"],[47,53,122.58,123.03,"veldig"],[54,59,123.03,123.56,"tørst"]]},{"id":22,"start":124.81,"end":127.62,"text":"De venter på maten og snakker sammen.","zh":"他们一边等上菜一边聊天。","words":[[0,2,124.89,125.1,"de"],[3,9,125.1,125.56,"venter"],[10,12,125.56,125.72,"på~1da53a3cc68f"],[13,18,125.72,126.18,"maten"],[19,21,126.18,126.68,"og"],[22,29,126.68,127.04,"snakker"],[30,36,127.04,127.54,"sammen"]]},{"id":23,"start":128.95,"end":131.99,"text":"Bjørnar pleier å være aktiv i helgene.","zh":"比约纳尔周末通常很爱运动。","words":[[0,7,129.03,129.56,"bjørnar"],[8,14,129.56,130.44,"pleier"],[15,16,130.44,130.58,"å~0583da7a620a"],[17,21,130.58,130.76,"være"],[22,27,130.76,131.2,"aktiv"],[28,29,131.2,131.36,"i~0e9dae9ea653"],[30,37,131.36,131.91,"helgene"]]},{"id":24,"start":133.36,"end":136.04,"text":"Håvard pleier bare å slappe av.","zh":"霍瓦尔通常只是放松休息。","words":[[0,6,133.44,133.98,"håvard"],[7,13,133.98,134.72,"pleier"],[14,18,134.72,134.96,"bare"],[19,20,134.96,135.2,"å~0583da7a620a"],[21,27,135.2,135.6,"slappe~75bc27ca2f9a"],[28,30,135.6,135.96,"av~6aef60c561bf"]]},{"id":25,"start":137.24,"end":139.49,"text":"De har det hyggelig og ler mye.","zh":"他们过得很愉快，笑个不停。","words":[[0,2,137.32,137.54,"de"],[3,6,137.54,137.76,"har~57b46e8e722d"],[7,10,137.76,137.88,"det~aef4434dacc8"],[11,19,137.88,138.34,"hyggelig"],[20,22,138.34,138.56,"og"],[23,26,138.56,138.9,"ler"],[27,30,138.9,139.41,"mye~933c5a923198"]]},{"id":26,"start":141.08,"end":143.88,"text":"Servitøren kommer med maten og vannet.","zh":"服务员端来了饭菜和水。","words":[[0,10,141.16,141.94,"servitøren"],[11,17,141.94,142.44,"kommer"],[18,21,142.44,142.68,"med~ed87d9f28f46"],[22,27,142.68,143.18,"maten"],[28,30,143.18,143.38,"og"],[31,37,143.38,143.8,"vannet"]]},{"id":27,"start":148.11,"end":149.73,"text":"Hva liker du å gjøre?","zh":"你喜欢做什么？","words":[[0,3,148.19,148.45,"hva"],[4,9,148.45,148.93,"liker"],[10,12,148.93,149.05,"du"],[13,14,149.05,149.19,"å~0583da7a620a"],[15,20,149.19,149.65,"gjøre"]]},{"id":28,"start":151.5,"end":152.76,"text":"Jeg liker å …","zh":"我喜欢……","words":[[0,3,151.58,151.88,"jeg"],[4,9,151.88,152.28,"liker"],[10,11,152.28,152.68,"å~0583da7a620a"]]},{"id":29,"start":154.97,"end":157.83,"text":"Sofie liker å spise is.","zh":"苏菲喜欢吃冰淇淋。","words":[[0,5,155.05,155.64,"sofie"],[6,11,155.64,156.54,"liker"],[12,13,156.54,156.82,"å~0583da7a620a"],[14,19,156.82,157.2,"spise"],[20,22,157.2,157.75,"is"]]},{"id":30,"start":158.54,"end":162.58,"text":"Eivind liker å spille fotball.","zh":"埃温德喜欢踢足球。","words":[[0,6,159.05,160.09,"eivind"],[7,12,160.09,161.19,"liker"],[13,14,161.19,161.55,"å~0583da7a620a"],[15,21,161.55,161.87,"spille"],[22,29,161.87,162.5,"fotball"]]},{"id":31,"start":164.28,"end":167.18,"text":"Hawa liker å høre på musikk.","zh":"哈娃喜欢听音乐。","words":[[0,4,164.36,164.85,"hawa"],[5,10,164.85,165.73,"liker"],[11,12,165.73,165.99,"å~0583da7a620a"],[13,17,165.99,166.27,"høre~8d32f4406504"],[18,20,166.27,166.45,"på~33449e88ce8b"],[21,27,166.45,167.1,"musikk"]]},{"id":32,"start":169.02,"end":171.66,"text":"Synne liker å gå på konsert.","zh":"辛妮喜欢去听音乐会。","words":[[0,5,169.09,169.74,"synne"],[6,11,169.74,170.6,"liker"],[12,13,170.6,170.8,"å~0583da7a620a"],[14,16,170.8,170.98,"gå"],[17,19,170.98,171.14,"på~770498f5459a"],[20,27,171.14,171.58,"konsert"]]},{"id":33,"start":173.94,"end":177.01,"text":"Sompit liker å lære norsk.","zh":"松皮特喜欢学挪威语。","words":[[0,6,174.02,174.91,"sompit"],[7,12,174.91,175.57,"liker"],[13,14,175.57,175.89,"å~0583da7a620a"],[15,19,175.89,176.19,"lære~50d7c648b04b"],[20,25,176.19,176.93,"norsk~4de5d75feae1"]]},{"id":34,"start":178.57,"end":181.54,"text":"Markus liker å se på barne-tv.","zh":"马库斯喜欢看儿童电视节目。","words":[[0,6,178.65,179.02,"markus"],[7,12,179.02,179.98,"liker"],[13,14,179.98,180.2,"å~0583da7a620a"],[15,17,180.2,180.38,"se"],[18,20,180.38,180.54,"på~fab38a6838d6"],[21,29,180.54,181.46,"barne-tv"]]},{"id":35,"start":183.36,"end":186.62,"text":"Marek liker å snakke med Ewa på Skype.","zh":"马雷克喜欢在 Skype 上和埃娃聊天。","words":[[0,5,183.44,184.04,"marek"],[6,11,184.04,184.56,"liker"],[12,13,184.56,184.76,"å~0583da7a620a"],[14,20,184.76,185.12,"snakke"],[21,24,185.12,185.26,"med"],[25,28,185.26,185.66,"ewa"],[29,31,185.66,185.88,"på~acc985c9313f"],[32,37,185.88,186.54,"skype"]]},{"id":36,"start":188.34,"end":191.54,"text":"Bjørnar liker å være sammen med barna.","zh":"比约纳尔喜欢和孩子们待在一起。","words":[[0,7,188.42,188.87,"bjørnar"],[8,13,188.87,189.89,"liker"],[14,15,189.89,190.19,"å~0583da7a620a"],[16,20,190.19,190.39,"være"],[21,27,190.39,190.75,"sammen"],[28,31,190.75,190.93,"med"],[32,37,190.93,191.46,"barna"]]},{"id":37,"start":193.19,"end":