{"id":"pa-vei-10.D","bookId":"pa-vei-textbook","readingId":"10.D","title":"Vi vant 3–1!","audio":"audio/pa-vei/10.D.mp3","duration":122.016,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.12,"end":3.705,"text":"Michelle er på kjøkkenet og lager middag.","zh":"米歇尔正在厨房做晚饭。","words":[[0,8,1.12,1.785,"michelle"],[9,11,1.82,1.985,"er"],[12,14,2.0,2.145,"på"],[15,24,2.2,2.745,"kjøkkenet"],[25,27,2.86,2.982,"og"],[28,33,2.982,3.263,"lager"],[34,40,3.263,3.705,"middag"]]},{"id":1,"start":5.04,"end":6.885,"text":"Ben kommer hjem og ser fornøyd ut.","zh":"本回到家，看起来很开心。","words":[[0,3,5.04,5.265,"ben"],[4,10,5.34,5.662,"kommer"],[11,15,5.662,5.885,"hjem"],[16,18,5.92,6.032,"og"],[19,22,6.032,6.225,"ser"],[23,30,6.24,6.672,"fornøyd"],[31,33,6.672,6.885,"ut"]]},{"id":2,"start":8.04,"end":9.345,"text":"Elias er sammen med ham.","zh":"埃利亚斯和他在一起。","words":[[0,5,8.04,8.582,"elias"],[6,8,8.582,8.742,"er"],[9,15,8.742,9.082,"sammen"],[16,19,9.082,9.203,"med"],[20,23,9.203,9.345,"ham"]]},{"id":3,"start":12.2,"end":12.845,"text":"Hei, Ben!","zh":"嗨，本！","words":[[0,3,12.2,12.445,"hei"],[5,8,12.58,12.845,"ben"]],"speaker":"Michelle"},{"id":4,"start":13.34,"end":14.205,"text":"Hvordan gikk det?","zh":"比赛怎么样？","words":[[0,7,13.34,13.685,"hvordan"],[8,12,13.72,14.005,"gikk"],[13,16,14.02,14.205,"det"]],"speaker":"Michelle"},{"id":5,"start":15.26,"end":17.345,"text":"Vi vant 3-1!","zh":"我们三比一赢了！","words":[[0,2,15.26,15.405,"vi"],[3,7,15.62,16.165,"vant"],[8,11,16.38,17.345,"3-1"]],"speaker":"Ben"},{"id":6,"start":18.056,"end":20.101,"text":"Pappa er en super trener.","zh":"爸爸是个超级棒的教练。","words":[[0,5,18.056,18.461,"pappa"],[6,8,18.476,18.618,"er"],[9,11,18.618,18.781,"en"],[12,17,18.956,19.618,"super"],[18,24,19.618,20.101,"trener@pa-vei-trener-coach"]],"speaker":"Ben"},{"id":7,"start":21.096,"end":22.701,"text":"Det sier Gaute også.","zh":"高特也这么说。","words":[[0,3,21.096,21.301,"det"],[4,8,21.416,21.741,"sier"],[9,14,21.796,22.319,"gaute"],[15,19,22.319,22.701,"også"]],"speaker":"Ben"},{"id":8,"start":24.036,"end":24.901,"text":"Så flott!","zh":"太棒了！","words":[[0,2,24.036,24.241,"så"],[3,8,24.516,24.901,"flott"]],"speaker":"Michelle"},{"id":9,"start":25.496,"end":26.661,"text":"Gratulerer!","zh":"祝贺你！","words":[[0,10,25.496,26.661,"gratulerer"]],"speaker":"Michelle"},{"id":10,"start":27.656,"end":28.341,"text":"Hvor er pappa?","zh":"爸爸在哪儿？","words":[[0,4,27.656,27.879,"hvor"],[5,7,27.879,28.009,"er"],[8,13,28.009,28.341,"pappa"]],"speaker":"Michelle"},{"id":11,"start":29.276,"end":30.881,"text":"Kom han ikke hjem sammen med deg?","zh":"他没跟你一起回家吗？","words":[[0,3,29.276,29.461,"kom"],[4,7,29.496,29.678,"han"],[8,12,29.678,29.919,"ikke"],[13,17,29.919,30.161,"hjem"],[18,24,30.256,30.569,"sammen"],[25,28,30.569,30.709,"med"],[29,32,30.709,30.881,"deg"]],"speaker":"Michelle"},{"id":12,"start":32.036,"end":36.501,"text":"Nei, han og Gaute gikk på puben for å diskutere kampen.","zh":"没有，他和高特去酒吧讨论比赛了。","words":[[0,3,32.036,32.341,"nei"],[5,8,32.736,32.941,"han"],[9,11,32.996,33.209,"og"],[12,17,33.209,33.641,"gaute"],[18,22,33.676,33.909,"gikk"],[23,25,33.909,34.041,"på"],[26,31,34.156,34.741,"puben"],[32,35,34.936,35.109,"for"],[36,37,35.109,35.198,"å"],[38,47,35.198,35.961,"diskutere"],[48,54,35.996,36.501,"kampen"]],"speaker":"Ben"},{"id":13,"start":37.596,"end":38.881,"text":"Men jeg er sulten.","zh":"不过我饿了。","words":[[0,3,37.596,37.761,"men"],[4,7,37.816,38.041,"jeg"],[8,10,38.096,38.221,"er"],[11,17,38.256,38.881,"sulten"]],"speaker":"Ben"},{"id":14,"start":40.176,"end":41.821,"text":"Maten er snart ferdig.","zh":"饭很快就好。","words":[[0,5,40.176,40.601,"maten"],[6,8,40.636,40.821,"er"],[9,14,40.936,41.461,"snart"],[15,21,41.476,41.821,"ferdig"]],"speaker":"Michelle"},{"id":15,"start":42.516,"end":43.821,"text":"Men først må du dusje.","zh":"不过你得先洗澡。","words":[[0,3,42.516,42.681,"men"],[4,9,42.736,43.121,"først"],[10,12,43.136,43.261,"må"],[13,15,43.296,43.421,"du"],[16,21,43.436,43.821,"dusje"]],"speaker":"Michelle"},{"id":16,"start":44.856,"end":46.541,"text":"Kan Elias spise hos oss?","zh":"埃利亚斯可以在我们家吃饭吗？","words":[[0,3,44.856,45.061,"kan"],[4,9,45.096,45.678,"elias"],[10,15,45.678,46.159,"spise"],[16,19,46.159,46.288,"hos"],[20,23,46.288,46.541,"oss"]],"speaker":"Ben"},{"id":17,"start":47.696,"end":48.561,"text":"Selvfølgelig.","zh":"当然可以。","words":[[0,12,47.696,48.561,"selvfølgelig"]],"speaker":"Michelle"},{"id":18,"start":49.576,"end":50.901,"text":"Vi skal ha fiskekaker.","zh":"我们吃鱼饼。","words":[[0,2,49.576,49.701,"vi"],[3,7,49.736,49.928,"skal"],[8,10,49.928,50.061,"ha"],[11,21,50.116,50.901,"fiskekaker"]],"speaker":"Michelle"},{"id":19,"start":52.056,"end":55.361,"text":"Fint, og så må vi snakke om kampen, vi også.","zh":"太好了，我们也得聊聊比赛。","words":[[0,4,52.056,52.601,"fint"],[6,8,52.876,53.001,"og"],[9,11,53.036,53.181,"så"],[12,14,53.256,53.401,"må"],[15,17,53.436,53.581,"vi"],[18,24,53.636,54.041,"snakke"],[25,27,54.056,54.201,"om"],[28,34,54.256,54.781,"kampen"],[36,38,54.816,54.961,"vi"],[39,43,55.036,55.361,"også"]],"speaker":"Ben"},{"id":20,"start":56.536,"end":58.261,"text":"Elias spilte dødsbra!","zh":"埃利亚斯踢得棒极了！","words":[[0,5,56.536,57.078,"elias"],[6,12,57.078,57.461,"spilte"],[13,20,57.596,58.261,"dødsbra"]],"speaker":"Ben"},{"id":21,"start":59.376,"end":60.201,"text":"Han er helt rå.","zh":"他简直太牛了。","words":[[0,3,59.376,59.538,"han"],[4,6,59.538,59.639,"er"],[7,11,59.639,59.961,"helt"],[12,14,60.036,60.201,"rå"]],"speaker":"Ben"},{"id":22,"start":61.276,"end":61.461,"text":"Rå?","zh":"牛？","words":[[0,2,61.276,61.461,"rå"]],"speaker":"Michelle"},{"id":23,"start":62.736,"end":65.221,"text":"Ja, god eller tøff.","zh":"就是厉害，或者很酷。","words":[[0,2,62.736,62.941,"ja"],[4,7,63.496,63.821,"god"],[8,13,64.276,64.641,"eller"],[14,18,64.836,65.221,"tøff"]],"speaker":"Ben"},{"id":24,"start":66.116,"end":67.081,"text":"Det forstår du vel?","zh":"你懂的吧？","words":[[0,3,66.116,66.281,"det"],[4,11,66.316,66.758,"forstår"],[12,14,66.758,66.879,"du"],[15,18,66.879,67.081,"vel"]],"speaker":"Ben"},{"id":25,"start":68.216,"end":68.681,"text":"Nei-i.","zh":"不——不懂。","words":[[0,5,68.216,68.681,"nei-i"]],"speaker":"Michelle"},{"id":26,"start":69.516,"end":71.72,"text":"Jeg lærte ikke det på norskkurset.","zh":"挪威语课上可没教我这个。","words":[[0,3,69.516,69.721,"jeg"],[4,9,69.756,70.058,"lærte"],[10,14,70.058,70.281,"ikke"],[15,18,70.296,70.521,"det"],[19,21,70.656,70.801,"på"],[22,33,70.84,71.72,"norskkurset"]],"speaker":"Michelle"},{"id":27,"start":74.406,"end":76.071,"text":"Innvandrere på dugnad","zh":"参加集体义务劳动的移民","words":[[0,11,74.406,75.271,"innvandrere"],[12,14,75.306,75.451,"på"],[15,21,75.506,76.071,"dugnad"]]},{"id":28,"start":77.646,"end":78.511,"text":"- Vil du ha pølse?","zh":"要来根香肠吗？","words":[[2,5,77.646,77.809,"vil"],[6,8,77.809,77.928,"du"],[9,11,77.928,78.051,"ha"],[12,17,78.066,78.511,"pølse"]]},{"id":29,"start":79.386,"end":79.771,"text":"Vaffel?","zh":"华夫饼呢？","words":[[0,6,79.386,79.771,"vaffel"]]},{"id":30,"start":80.386,"end":80.951,"text":"Vær så god!","zh":"请享用！","words":[[0,3,80.386,80.551,"vær@pa-vei-vær-be"],[4,6,80.566,80.709,"så"],[7,10,80.709,80.951,"god"]]},{"id":31,"start":82.246,"end":87.471,"text":"Stortingsrepresentant Akhtar Chaudhry fra SV er på foreldredugnad på Norway Cup.","zh":"社会主义左翼党的议会议员阿克塔尔·乔德里正在挪威杯足球赛现场参加家长义工活动。","words":[[0,21,82.246,83.571,"stortingsrepresentant"],[22,28,83.706,84.071,"akhtar"],[29,37,84.126,84.571,"chaudhry"],[38,41,84.686,84.851,"fra"],[42,44,85.046,85.251,"sv"],[45,47,85.426,85.559,"er"],[48,50,85.559,85.671,"på"],[51,65,85.706,86.659,"foreldredugnad"],[66,68,86.659,86.771,"på"],[69,75,86.806,87.189,"norway"],[76,79,87.189,87.471,"cup"]]},{"id":32,"start":88.146,"end":92.471,"text":"Der selger han pølser, vafler og brus til ivrige fotballspillere.","zh":"他在那里向热情的足球运动员出售香肠、华夫饼和汽水。","words":[[0,3,88.146,88.451,"der"],[4,10,88.506,88.788,"selger"],[11,14,88.788,88.931,"han"],[15,21,88.966,89.511,"pølser"],[23,29,89.666,90.151,"vafler"],[30,32,90.346,90.471,"og"],[33,37,90.486,90.839,"brus"],[38,41,90.839,90.971,"til"],[42,48,91.106,91.611,"ivrige"],[49,64,91.686,92.471,"fotballspillere"]]},{"id":33,"start":94.126,"end":99.831,"text":"- Noen tror at innvandrere ikke deltar på dugnader og annet frivillig arbeid her i landet.","zh":"有人以为，移民不参加这个国家的集体义务劳动和其他志愿活动。","words":[[2,6,94.126,94.591,"noen"],[7,11,94.686,94.978,"tror"],[12,14,94.978,95.131,"at"],[15,26,95.166,95.931,"innvandrere"],[27,31,96.006,96.311,"ikke"],[32,38,96.346,96.851,"deltar"],[39,41,96.866,97.011,"på"],[42,50,97.026,97.611,"dugnader"],[51,53,97.766,97.891,"og"],[54,59,97.946,98.409,"annet"],[60,69,98.409,98.891,"frivillig"],[70,76,98.926,99.288,"arbeid"],[77,80,99.288,99.459,"her"],[81,82,99.459,99.559,"i"],[83,89,99.559,99.831,"landet"]]},{"id":34,"start":100.546,"end":103.551,"text":"Nå viser forskning at dette er feil, sier Chaudhry.","zh":"乔德里说，现在研究表明这种看法是错的。","words":[[0,2,100.546,100.671,"nå"],[3,8,100.806,101.118,"viser"],[9,18,101.118,101.631,"forskning"],[19,21,101.686,101.819,"at"],[22,27,101.819,102.071,"dette"],[28,30,102.106,102.251,"er"],[31,35,102.326,102.731,"feil@pa-vei-extra-10"],[37,41,102.926,103.159,"sier"],[42,50,103.159,103.551,"chaudhry"]]},{"id":35,"start":104.246,"end":105.791,"text":"- Innvandrere stiller opp.","zh":"移民会积极参与。","words":[[2,13,104.246,104.971,"innvandrere"],[14,21,105.146,105.559,"stiller@pa-vei-extra-8"],[22,25,105.559,105.791,"opp@pa-vei-extra-9"]]},{"id":36,"start":107.526,"end":114.871,"text":"En ny rapport fra Institutt for samfunnsforskning viser at minoritetsbefolkningen deltar i mange typer frivillig arbeid.","zh":"挪威社会研究所的一份新报告显示，少数族裔居民参加多种志愿活动。","words":[[0,2,107.526,107.691,"en"],[3,5,107.826,107.971,"ny"],[6,13,108.106,108.529,"rapport"],[14,17,108.529,108.691,"fra"],[18,27,108.726,109.249,"institutt"],[28,31,109.249,109.388,"for"],[32,49,109.388,110.371,"samfunnsforskning"],[50,55,110.486,110.828,"viser"],[56,58,110.828,110.988,"at"],[59,81,110.988,112.311,"minoritetsbefolkningen"],[82,88,112.446,112.931,"deltar"],[89,90,112.966,113.071,"i"],[91,96,113.146,113.551,"mange"],[97,102,113.606,113.951,"typer"],[103,112,113.986,114.471,"frivillig"],[113,119,114.486,114.871,"arbeid"]]},{"id":37,"start":115.726,"end":120.531,"text":"Når det gjelder dugnad i borettslag, er minoritetene like mye med som nordmenn.","zh":"就住房合作社的集体义务劳动而言，少数族裔的参与程度和挪威人一样高。","words":[[0,3,115.726,115.868,"når"],[4,7,115.868,115.969,"det"],[8,15,115.969,116.228,"gjelder@pa-vei-extra-11"],[16,22,116.228,116.791,"dugnad"],[23,24,116.826,116.931,"i"],[25,35,116.966,117.611,"borettslag"],[37,39,117.786,117.928,"er"],[40,52,117.928,118.671,"minoritetene"],[53,57,118.806,119.271,"like@pa-vei-extra-12"],[58,61,119.306,119.591,"mye"],[62,65,119.606,119.831,"med@pa-vei-extra-13"],[66,69,119.846,120.011,"som"],[70,78,120.046,120.531,"nordmenn"]]}],"lexicon":{"3-1":{"lemma":"3-1","pos":"比分","zh":"三比一","ref":null,"clip":null},"akhtar":{"lemma":"Akhtar","pos":"专名","zh":"阿克塔尔（人名）","ref":null,"clip":null},"annet":{"lemma":"annen","zh":"其他","pos":"形容词","ref":"11-037","form":"变化形式","clip":null},"arbeid":{"lemma":"arbeid","pos":"名词","zh":"工作；劳动","ref":null,"clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"ben":{"lemma":"Ben","pos":"专名","zh":"本（人名）","ref":null,"clip":null},"borettslag":{"lemma":"borettslag","pos":"名词","zh":"住房合作社","ref":null,"clip":null},"brus":{"lemma":"brus","zh":"汽水","pos":"名词","ref":"10-004","clip":null},"chaudhry":{"lemma":"Chaudhry","pos":"专名","zh":"乔德里（人名中的姓）","ref":null,"clip":null},"cup":{"lemma":"Cup","pos":"专名","zh":"杯赛（Norway Cup：挪威杯青少年足球赛）","ref":null,"clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"deltar":{"lemma":"delta","pos":"动词","zh":"参加；参与","ref":null,"clip":null,"form":"现在时"},"der":{"lemma":"der","zh":"那里","pos":"副词","ref":"ty-conversation-6-008","clip":null},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conver