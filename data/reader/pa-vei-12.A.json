{"id":"pa-vei-12.A","bookId":"pa-vei-textbook","readingId":"12.A","title":"Norge er langt og smalt","audio":"audio/pa-vei/12.A.mp3","duration":144.984,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.28,"end":3.805,"text":"Norge er langt og smalt.","zh":"挪威的国土又长又窄。","words":[[0,5,1.28,1.765,"norge"],[6,8,1.98,2.205,"er"],[9,14,2.34,2.905,"langt"],[15,17,3.0,3.145,"og"],[18,23,3.18,3.805,"smalt"]]},{"id":1,"start":5.16,"end":10.465,"text":"Fra nord til sør er det 1752 kilometer.","zh":"从北到南有 1752 公里。","words":[[0,3,5.16,5.365,"fra"],[4,8,5.44,5.785,"nord"],[9,12,5.84,6.025,"til"],[13,16,6.14,6.505,"sør"],[17,19,6.98,7.133,"er"],[20,23,7.133,7.285,"det"],[24,28,7.38,9.745,"1752"],[29,38,9.88,10.465,"kilometer"]]},{"id":2,"start":12.06,"end":16.545,"text":"Litt sør for Narvik er landet bare 6 kilometer bredt.","zh":"在纳尔维克稍南的地方，国土只有 6 公里宽。","words":[[0,4,12.06,12.325,"litt"],[5,8,12.38,12.745,"sør"],[9,12,12.76,12.965,"for"],[13,19,13.0,13.645,"narvik"],[20,22,14.06,14.225,"er"],[23,29,14.26,14.592,"landet"],[30,34,14.592,14.865,"bare"],[35,36,15.0,15.445,"6"],[37,46,15.54,16.185,"kilometer"],[47,52,16.2,16.545,"bredt"]]},{"id":3,"start":18.86,"end":25.385,"text":"Det er mange øyer, fjorder og fjell her i landet, og det er også store skoger.","zh":"这个国家有很多岛屿、峡湾和山脉，也有大片森林。","words":[[0,3,18.86,19.025,"det"],[4,6,19.04,19.182,"er"],[7,12,19.182,19.545,"mange"],[13,17,19.68,20.205,"øyer"],[19,26,20.5,21.145,"fjorder"],[27,29,21.36,21.505,"og"],[30,35,21.56,21.965,"fjell"],[36,39,22.06,22.263,"her"],[40,41,22.263,22.352,"i"],[42,48,22.352,22.685,"landet"],[50,52,23.38,23.502,"og"],[53,56,23.502,23.663,"det"],[57,59,23.663,23.805,"er"],[60,64,23.84,24.165,"også"],[65,70,24.26,24.825,"store"],[71,77,24.88,25.385,"skoger"]]},{"id":4,"start":26.82,"end":28.985,"text":"Men vi har lite dyrket mark.","zh":"不过我们的耕地很少。","words":[[0,3,26.82,27.005,"men"],[4,6,27.02,27.145,"vi"],[7,10,27.16,27.345,"har"],[11,15,27.38,27.845,"lite"],[16,22,27.92,28.542,"dyrket"],[23,27,28.542,28.985,"mark"]]},{"id":5,"start":30.42,"end":38.625,"text":"Faktisk er cirka 25 % av Norge skog. Bare 3 % er dyrket mark.","zh":"实际上，挪威大约 25% 的国土是森林，只有 3% 是耕地。","words":[[0,7,30.42,30.943,"faktisk"],[8,10,30.943,31.125,"er"],[11,16,31.18,31.605,"cirka"],[17,19,31.72,32.325,"25"],[22,24,33.08,33.213,"av"],[25,30,33.213,33.625,"norge"],[31,35,33.88,34.305,"skog"],[37,41,35.6,35.925,"bare"],[42,43,36.0,36.845,"3"],[46,48,37.32,37.545,"er"],[49,55,37.64,38.222,"dyrket"],[56,60,38.222,38.625,"mark"]]},{"id":6,"start":41.0,"end":51.625,"text":"Naturen er vakker mange steder, kanskje særlig på Vestlandet og i Nord-Norge, og det kommer mange turister hit for å oppleve naturen.","zh":"很多地方的自然风光都很美，尤其是挪威西部和北部，许多游客来到这里体验大自然。","words":[[0,7,41.0,41.625,"naturen"],[8,10,41.72,41.925,"er"],[11,17,42.04,42.585,"vakker"],[18,23,42.66,43.025,"mange"],[24,30,43.04,43.485,"steder"],[32,39,44.22,44.645,"kanskje"],[40,46,44.72,45.185,"særlig"],[47,49,45.22,45.365,"på"],[50,60,45.38,46.045,"vestlandet"],[61,63,46.4,46.545,"og"],[64,65,46.56,46.665,"i"],[66,76,46.7,47.405,"nord-norge"],[78,80,48.3,48.442,"og"],[81,84,48.442,48.582,"det"],[85,91,48.582,48.903,"kommer"],[92,97,48.903,49.205,"mange"],[98,106,49.24,49.825,"turister"],[107,110,49.84,50.205,"hit"],[111,114,50.32,50.472,"for"],[115,116,50.472,50.565,"å"],[117,124,50.6,51.132,"oppleve"],[125,132,51.132,51.625,"naturen"]]},{"id":7,"start":53.1,"end":57.985,"text":"På Vestlandet er det høye, bratte fjell og mange lange fjorder.","zh":"挪威西部有高耸陡峭的山脉和许多绵长的峡湾。","words":[[0,2,53.1,53.245,"på"],[3,13,53.28,53.922,"vestlandet"],[14,16,53.922,54.043,"er"],[17,20,54.043,54.185,"det"],[21,25,54.22,54.765,"høye"],[27,33,54.9,55.445,"bratte"],[34,39,55.48,55.845,"fjell"],[40,42,56.3,56.445,"og"],[43,48,56.52,56.965,"mange"],[49,54,57.06,57.525,"lange"],[55,62,57.56,57.985,"fjorder"]]},{"id":8,"start":59.6,"end":62.325,"text":"En av disse fjordene er Sognefjorden.","zh":"松恩峡湾就是其中之一。","words":[[0,2,59.6,59.885,"en@pa-vei-en-one"],[3,5,59.92,60.052,"av"],[6,11,60.052,60.325,"disse"],[12,20,60.34,60.825,"fjordene"],[21,23,60.98,61.165,"er"],[24,36,61.3,62.325,"sognefjorden"]]},{"id":9,"start":63.42,"end":68.585,"text":"Den er 200 kilometer lang og 1300 meter dyp.","zh":"它长 200 公里，深 1300 米。","words":[[0,3,63.42,63.625,"den"],[4,6,63.66,63.845,"er"],[7,10,63.96,64.725,"200"],[11,20,64.76,65.322,"kilometer"],[21,25,65.322,65.585,"lang"],[26,28,66.06,66.205,"og"],[29,33,66.28,67.825,"1300"],[34,39,67.84,68.213,"meter"],[40,43,68.213,68.585,"dyp"]]},{"id":10,"start":70.92,"end":73.445,"text":"I Nord-Norge kan man se midnattssola.","zh":"在挪威北部可以看到午夜太阳。","words":[[0,1,70.92,71.025,"i"],[2,12,71.1,71.765,"nord-norge"],[13,16,71.84,72.002,"kan"],[17,20,72.002,72.165,"man"],[21,23,72.26,72.425,"se"],[24,36,72.58,73.445,"midnattssola"]]},{"id":11,"start":74.74,"end":81.725,"text":"Om sommeren er det lyst både natt og dag, og i pent vær kan man se sola midt på natta.","zh":"夏天无论白天还是夜晚都很亮，天气晴好时，半夜也能看见太阳。","words":[[0,2,74.74,74.905,"om"],[3,11,75.0,75.505,"sommeren"],[12,14,75.54,75.642,"er"],[15,18,75.642,75.785,"det"],[19,23,75.8,76.305,"lyst"],[24,28,76.32,76.605,"både"],[29,33,76.7,77.093,"natt"],[34,36,77.093,77.213,"og"],[37,40,77.213,77.565,"dag"],[42,44,78.24,78.365,"og"],[45,46,78.4,78.505,"i"],[47,51,78.54,78.942,"pent"],[52,55,78.942,79.185,"vær"],[56,59,79.66,79.825,"kan"],[60,63,79.84,80.005,"man"],[64,66,80.06,80.245,"se"],[67,71,80.36,80.765,"sola"],[72,76,80.98,81.262,"midt"],[77,79,81.262,81.385,"på"],[80,85,81.4,81.725,"natta"]]},{"id":12,"start":83.8,"end":89.825,"text":"Langs sørlandskysten er det ikke så høye fjell, men massevis av øyer og små fjorder.","zh":"挪威南部沿海的山没有那么高，却有许许多多岛屿和小峡湾。","words":[[0,5,83.8,84.143,"langs"],[6,20,84.143,85.185,"sørlandskysten"],[21,23,85.28,85.412,"er"],[24,27,85.412,85.553,"det"],[28,32,85.553,85.792,"ikke"],[33,35,85.792,85.925,"så"],[36,40,85.98,86.345,"høye"],[41,46,86.36,86.685,"fjell"],[48,51,87.14,87.305,"men"],[52,60,87.38,87.972,"massevis"],[61,63,87.972,88.105,"av"],[64,68,88.2,88.685,"øyer"],[69,71,88.82,88.945,"og"],[72,75,89.0,89.225,"små"],[76,83,89.36,89.825,"fjorder"]]},{"id":13,"start":91.4,"end":94.005,"text":"Langs kysten ligger det hvite trehus.","zh":"沿着海岸坐落着白色的木屋。","words":[[0,5,91.4,91.743,"langs"],[6,12,91.743,92.225,"kysten"],[13,19,92.34,92.602,"ligger"],[20,23,92.602,92.743,"det"],[24,29,92.743,93.285,"hvite"],[30,36,93.32,94.005,"trehus"]]},{"id":14,"start":95.6,"end":100.125,"text":"Det er populært å ha hytte på Sørlandet og være der i sommerferien.","zh":"在挪威南部有一间度假屋、暑假去那里住，很受欢迎。","words":[[0,3,95.6,95.765,"det"],[4,6,95.78,95.925,"er"],[7,15,95.98,96.623,"populært"],[16,17,96.623,96.722,"å"],[18,20,96.722,96.865,"ha"],[21,26,96.94,97.343,"hytte"],[27,29,97.343,97.485,"på"],[30,39,97.54,98.125,"sørlandet"],[40,42,98.54,98.665,"og"],[43,47,98.7,99.025,"være"],[48,51,99.04,99.273,"der"],[52,53,99.273,99.382,"i"],[54,66,99.382,100.125,"sommerferien"]]},{"id":15,"start":101.86,"end":104.525,"text":"Det er også populært å ha hytte på fjellet.","zh":"在山里拥有度假屋也很受欢迎。","words":[[0,3,101.86,102.023,"det"],[4,6,102.023,102.165,"er"],[7,11,102.2,102.525,"også"],[12,20,102.6,103.205,"populært"],[21,22,103.22,103.322,"å"],[23,25,103.322,103.445,"ha"],[26,31,103.58,103.982,"hytte"],[32,34,103.982,104.125,"på"],[35,42,104.14,104.525,"fjellet"]]},{"id":16,"start":105.76,"end":110.365,"text":"Der kan folk være i feriene både om sommeren og om vinteren.","zh":"无论夏天还是冬天，人们都可以在那里度假。","words":[[0,3,105.76,106.025,"der"],[4,7,106.06,106.225,"kan"],[8,12,106.3,106.625,"folk"],[13,17,106.64,106.945,"være"],[18,19,106.98,107.085,"i"],[20,27,107.1,107.645,"feriene"],[28,32,107.96,108.405,"både"],[33,35,108.44,108.585,"om"],[36,44,108.64,109.085,"sommeren"],[45,47,109.4,109.545,"og"],[48,50,109.72,109.865,"om"],[51,59,109.88,110.365,"vinteren"]]},{"id":17,"start":112.92,"end":115.285,"text":"Hvor velger folk å bo i Norge?","zh":"在挪威，人们选择住在哪里呢？","words":[[0,4,112.92,113.205,"hvor"],[5,11,113.32,113.785,"velger"],[12,16,113.82,114.185,"folk"],[17,18,114.2,114.305,"å"],[19,21,114.4,114.585,"bo"],[22,23,114.84,114.942,"i"],[24,29,114.942,115.285,"norge"]]},{"id":18,"start":117.62,"end":127.265,"text":"9 av 10 bor ved kysten, og mange har flyttet fra små steder til tettsteder (det vil si steder med mer enn 200 mennesker).","zh":"十个人中有九个住在沿海，许多人从小地方搬到了城镇聚居区，也就是人口超过 200 人的地方。","words":[[0,1,117.62,117.765,"9"],[2,4,117.98,118.145,"av"],[5,7,118.2,118.365,"10"],[8,11,118.56,118.845,"bor"],[12,15,118.86,119.025,"ved"],[16,22,119.06,119.545,"kysten"],[24,26,120.48,120.605,"og"],[27,32,120.62,120.925,"mange"],[33,36,120.94,121.125,"har"],[37,44,121.14,121.553,"flyttet@pa-vei-flyttet-perfect"],[45,48,121.553,121.705,"fra"],[49,52,121.76,121.985,"små"],[53,59,122.14,122.605,"steder"],[60,63,122.78,122.965,"til"],[64,74,123.02,123.745,"tettsteder"],[76,79,124.48,124.632,"det"],[80,83,124.632,124.785,"vil"],[84,86,124.8,124.985,"si"],[87,93,125.08,125.523,"steder"],[94,97,125.523,125.685,"med"],[98,101,125.74,126.062,"mer"],[102,105,126.062,126.265,"enn"],[106,109,126.28,126.852,"200"],[110,119,126.852,127.265,"mennesker"]]},{"id":19,"start":129.3,"end":134.025,"text":"I dag bor 3 av 4 nordmenn i en by eller på et tettsted.","zh":"如今，四个挪威人中有三个住在城市或城镇聚居区。","words":[[0,1,129.3,129.403,"i"],[2,5,129.403,129.685,"dag"],[6,9,129.7,129.925,"bor"],[10,11,130.04,130.285,"3"],[12,14,130.5,130.665,"av"],[15,16,130.68,131.082,"4"],[17,25,131.082,131.565,"nordmenn"],[26,27,131.72,131.825,"i"],[28,30,131.88,132.025,"en"],[31,33,132.12,132.265,"by"],[34,39,132.94,133.183,"eller"],[40,42,133.183,133.285,"på"],[43,45,133.3,133.442,"et"],[46,54,133.442,134.025,"tettsted"]]},{"id":20,"start":135.62,"end":143.245,"text":"Halvparten av landets befolkning bor på Østlandet, og der ligger også Oslo, hovedstaden i landet.","zh":"全国一半的人口住在挪威东部，首都奥斯陆也在那里。","words":[[0,10,135.62,136.252,"halvparten"],[11,13,136.252,136.405,"av"],[14,21,136.42,136.843,"landets"],[22,32,136.843,137.425,"befolkning"],[33,36,137.46,137.7