{"id":"pa-vei-16.C","bookId":"pa-vei-textbook","readingId":"16.C","title":"Amira får en telefon","audio":"audio/pa-vei/16.C.mp3","duration":110.88,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.98,"end":2.785,"text":"Telefonen til Amira ringer.","zh":"阿米拉的电话响了。","words":[[0,9,0.98,1.703,"telefonen"],[10,13,1.703,1.882,"til"],[14,19,1.882,2.325,"amira"],[20,26,2.42,2.785,"ringer"]]},{"id":1,"start":4.66,"end":4.965,"text":"Hallo?","zh":"喂？","words":[[0,5,4.66,4.965,"hallo"]],"speaker":"Amira"},{"id":2,"start":5.9,"end":10.945,"text":"Ja, hei, dette er Malik Doran, klassekontakt i Jasmins klasse.","zh":"你好，我是马利克·多兰，亚斯明班上的家长代表。","words":[[0,2,5.9,6.045,"ja"],[4,7,6.28,6.465,"hei"],[9,14,7.08,7.332,"dette"],[15,17,7.332,7.465,"er"],[18,23,7.48,7.905,"malik"],[24,29,7.96,8.365,"doran"],[31,44,9.08,9.885,"klassekontakt"],[45,46,9.9,10.005,"i"],[47,54,10.04,10.592,"jasmins"],[55,61,10.592,10.945,"klasse"]],"speaker":"Malik"},{"id":3,"start":11.9,"end":13.171,"text":"Å ja. Hei!","zh":"哦，你好！","words":[[0,1,11.9,12.02,"å"],[2,4,12.046,12.191,"ja"],[6,9,12.946,13.171,"hei"]],"speaker":"Amira"},{"id":4,"start":14.866,"end":17.711,"text":"Jeg håper at dere kan komme på foreldremøtet på torsdag.","zh":"希望你们能来参加星期四的家长会。","words":[[0,3,14.866,15.031,"jeg"],[4,9,15.066,15.389,"håper"],[10,12,15.389,15.479,"at"],[13,17,15.479,15.688,"dere"],[18,21,15.688,15.829,"kan"],[22,27,15.829,16.108,"komme"],[28,30,16.108,16.231,"på"],[31,44,16.266,17.099,"foreldremøtet"],[45,47,17.099,17.209,"på"],[48,55,17.209,17.711,"torsdag"]],"speaker":"Malik"},{"id":5,"start":19.166,"end":23.191,"text":"Ja, jeg har tenkt å komme. Mannen min skal passe barna.","zh":"好的，我打算来。我丈夫会照顾孩子。","words":[[0,2,19.166,19.311,"ja"],[4,7,19.886,20.048,"jeg"],[8,11,20.048,20.198,"har"],[12,17,20.198,20.479,"tenkt"],[18,19,20.479,20.548,"å"],[20,25,20.548,20.811,"komme"],[27,33,21.866,22.169,"mannen"],[34,37,22.169,22.351,"min"],[38,42,22.386,22.591,"skal"],[43,48,22.606,22.898,"passe"],[49,54,22.898,23.191,"barna"]],"speaker":"Amira"},{"id":6,"start":24.656,"end":25.901,"text":"Jeg har et spørsmål til deg.","zh":"我想问你一件事。","words":[[0,3,24.656,24.838,"jeg"],[4,7,24.838,24.998,"har"],[8,10,24.998,25.128,"et"],[11,19,25.128,25.578,"spørsmål"],[20,23,25.578,25.739,"til"],[24,27,25.739,25.901,"deg"]],"speaker":"Malik"},{"id":7,"start":26.616,"end":31.381,"text":"Den andre klassekontakten, mor til Ingrid, skal flytte, og nå trenger vi en ny.","zh":"另一位家长代表，也就是英格丽的妈妈，要搬家了，现在我们需要一位新的代表。","words":[[0,3,26.616,26.781,"den@pa-vei-den-definite"],[4,9,26.816,27.141,"andre@pa-vei-andre-other"],[10,25,27.156,28.081,"klassekontakten"],[27,30,28.316,28.549,"mor"],[31,34,28.549,28.701,"til"],[35,41,28.736,29.141,"ingrid"],[43,47,29.236,29.441,"skal"],[48,54,29.456,29.821,"flytte"],[56,58,30.316,30.428,"og"],[59,61,30.428,30.561,"nå"],[62,69,30.636,30.988,"trenger"],[70,72,30.988,31.101,"vi"],[73,75,31.136,31.258,"en"],[76,78,31.258,31.381,"ny"]],"speaker":"Malik"},{"id":8,"start":32.436,"end":33.581,"text":"Kan du overta, tror du?","zh":"你觉得你能接任吗？","words":[[0,3,32.436,32.599,"kan"],[4,6,32.599,32.741,"du"],[7,13,32.816,33.221,"overta"],[15,19,33.276,33.469,"tror"],[20,22,33.469,33.581,"du"]],"speaker":"Malik"},{"id":9,"start":34.96,"end":36.951,"text":"Å nei, det tør jeg ikke.","zh":"啊不，我不敢。","words":[[0,1,34.96,35.08,"å"],[2,5,35.106,35.411,"nei"],[7,10,36.006,36.231,"det"],[11,14,36.306,36.569,"tør@pa-vei-extra-134"],[15,18,36.569,36.709,"jeg"],[19,23,36.709,36.951,"ikke"]],"speaker":"Amira"},{"id":10,"start":37.966,"end":40.131,"text":"Jeg vet ikke hva en klassekontakt gjør.","zh":"我不知道家长代表要做什么。","words":[[0,3,37.966,38.118,"jeg"],[4,7,38.118,38.379,"vet"],[8,12,38.379,38.579,"ikke"],[13,16,38.579,38.731,"hva"],[17,19,38.766,38.911,"en"],[20,33,38.946,39.791,"klassekontakt"],[34,38,39.826,40.131,"gjør"]],"speaker":"Amira"},{"id":11,"start":41.486,"end":43.491,"text":"Det visste ikke jeg heller da jeg begynte.","zh":"我刚开始的时候也不知道。","words":[[0,3,41.486,41.671,"det"],[4,10,41.686,41.968,"visste"],[11,15,41.968,42.159,"ikke"],[16,19,42.159,42.351,"jeg"],[20,26,42.406,42.758,"heller"],[27,29,42.758,42.871,"da"],[30,33,42.886,43.038,"jeg"],[34,41,43.038,43.491,"begynte"]],"speaker":"Malik"},{"id":12,"start":44.356,"end":48.261,"text":"Men man skal være kontaktperson mellom læreren og de andre foreldrene.","zh":"就是在老师和其他家长之间负责联络。","words":[[0,3,44.356,44.508,"men"],[4,7,44.508,44.659,"man"],[8,12,44.659,44.838,"skal"],[13,17,44.838,45.101,"være"],[18,31,45.116,46.058,"kontaktperson"],[32,38,46.058,46.361,"mellom"],[39,46,46.376,46.921,"læreren"],[47,49,47.196,47.319,"og"],[50,52,47.319,47.439,"de@pa-vei-de-definite"],[53,58,47.439,47.721,"andre"],[59,69,47.736,48.261,"foreldrene"]],"speaker":"Malik"},{"id":13,"start":49.236,"end":51.341,"text":"Vi får god informasjon om hva vi skal gjøre.","zh":"我们会得到清楚的说明，知道该做什么。","words":[[0,2,49.236,49.368,"vi"],[3,6,49.368,49.521,"får"],[7,10,49.536,49.748,"god"],[11,22,49.748,50.428,"informasjon"],[23,25,50.428,50.549,"om"],[26,29,50.549,50.701,"hva"],[30,32,50.736,50.858,"vi"],[33,37,50.858,51.028,"skal"],[38,43,51.028,51.341,"gjøre"]],"speaker":"Malik"},{"id":14,"start":52.836,"end":54.221,"text":"Jeg vet ikke, jeg.","zh":"我不太确定。","words":[[0,3,52.836,53.081,"jeg"],[4,7,53.256,53.698,"vet"],[8,12,53.698,53.948,"ikke"],[14,17,53.948,54.221,"jeg"]],"speaker":"Amira"},{"id":15,"start":55.716,"end":56.981,"text":"Du kan jo tenke litt på det.","zh":"你可以先考虑一下。","words":[[0,2,55.716,55.838,"du"],[3,6,55.838,55.998,"kan"],[7,9,55.998,56.139,"jo"],[10,15,56.139,56.489,"tenke"],[16,20,56.489,56.689,"litt"],[21,23,56.689,56.801,"på"],[24,27,56.816,56.981,"det"]],"speaker":"Malik"},{"id":16,"start":57.876,"end":60.941,"text":"Jeg sender deg litt mer informasjon på e-post. Er det ok?","zh":"我用电子邮件给你发一些更详细的信息，可以吗？","words":[[0,3,57.876,58.061,"jeg"],[4,10,58.076,58.368,"sender@pa-vei-extra-133"],[11,14,58.368,58.501,"deg"],[15,19,58.516,58.761,"litt"],[20,23,58.776,59.019,"mer"],[24,35,59.019,59.698,"informasjon"],[36,38,59.698,59.821,"på"],[39,45,59.836,60.361,"e-post"],[47,49,60.396,60.528,"er"],[50,53,60.528,60.681,"det"],[54,56,60.716,60.941,"ok"]],"speaker":"Malik"},{"id":17,"start":61.916,"end":63.221,"text":"Så ringer jeg deg igjen i morgen.","zh":"然后我明天再给你打电话。","words":[[0,2,61.916,62.058,"så"],[3,9,62.058,62.329,"ringer"],[10,13,62.329,62.459,"jeg"],[14,17,62.459,62.609,"deg"],[18,23,62.609,62.821,"igjen"],[24,25,62.836,62.919,"i"],[26,32,62.919,63.221,"morgen"]],"speaker":"Malik"},{"id":18,"start":64.696,"end":71.101,"text":"Ja, gjør det. Men jeg er ikke sikker på om jeg vil. Jeg har det veldig travelt.","zh":"好，你发吧。不过我还不确定愿不愿意，我很忙。","words":[[0,2,64.696,64.841,"ja"],[4,8,65.336,65.569,"gjør"],[9,12,65.569,65.741,"det"],[14,17,66.776,66.928,"men"],[18,21,66.928,67.079,"jeg"],[22,24,67.079,67.219,"er"],[25,29,67.219,67.461,"ikke"],[30,36,67.476,67.798,"sikker"],[37,39,67.798,67.921,"på"],[40,42,67.956,68.078,"om"],[43,46,68.078,68.258,"jeg"],[47,50,68.258,68.461,"vil"],[52,55,69.576,69.728,"jeg"],[56,59,69.728,69.898,"har"],[60,63,69.898,70.041,"det"],[64,70,70.056,70.501,"veldig"],[71,78,70.516,71.101,"travelt"]],"speaker":"Amira"},{"id":19,"start":72.316,"end":73.361,"text":"Jeg håper du sier ja.","zh":"我希望你能答应。","words":[[0,3,72.316,72.459,"jeg"],[4,9,72.459,72.769,"håper"],[10,12,72.769,72.881,"du"],[13,17,72.896,73.181,"sier"],[18,20,73.196,73.361,"ja"]],"speaker":"Malik"},{"id":20,"start":74.516,"end":76.521,"text":"Det er en fin måte å bli kjent med skolen på.","zh":"这是了解学校的一个好机会。","words":[[0,3,74.516,74.648,"det"],[4,6,74.648,74.749,"er"],[7,9,74.749,74.881,"en"],[10,13,74.896,75.129,"fin"],[14,18,75.129,75.418,"måte"],[19,20,75.418,75.478,"å"],[21,24,75.478,75.619,"bli"],[25,30,75.619,75.879,"kjent@pa-vei-extra-132"],[31,34,75.879,76.008,"med"],[35,41,76.008,76.379,"skolen"],[42,44,76.379,76.521,"på"]],"speaker":"Malik"},{"id":21,"start":78.956,"end":79.661,"text":"Sammendrag.","zh":"摘要","words":[[0,10,78.956,79.661,"sammendrag"]]},{"id":22,"start":81.216,"end":83.081,"text":"Malik ringer til Amira.","zh":"马利克给阿米拉打电话。","words":[[0,5,81.216,81.801,"malik"],[6,12,82.036,82.379,"ringer"],[13,16,82.379,82.561,"til"],[17,22,82.656,83.081,"amira"]]},{"id":23,"start":84.336,"end":89.541,"text":"Han er klassekontakt i Jasmins klasse og vil at Amira også skal bli det.","zh":"他是亚斯明班上的家长代表，希望阿米拉也来担任。","words":[[0,3,84.336,84.521,"han"],[4,6,84.536,84.681,"er"],[7,20,84.736,85.578,"klassekontakt"],[21,22,85.578,85.681,"i"],[23,30,85.696,86.379,"jasmins"],[31,37,86.379,86.741,"klasse"],[38,40,87.316,87.459,"og"],[41,44,87.459,87.621,"vil"],[45,47,87.656,87.821,"at"],[48,53,87.896,88.501,"amira"],[54,58,88.656,88.961,"også"],[59,63,88.976,89.181,"skal"],[64,67,89.196,89.379,"bli"],[68,71,89.379,89.541,"det"]]},{"id":24,"start":91.016,"end":92.661,"text":"Men Amira er usikker.","zh":"可是阿米拉不太确定。","words":[[0,3,91.016,91.201,"men"],[4,9,91.216,91.681,"amira"],[10,12,91.816,92.021,"er"],[13,20,92.096,92.661,"usikker"]]},{"id":25,"start":94.216,"end":98.561,"text":"Hun vet ikke hva en klassekontakt er, og hun har mye å gjøre.","zh":"她不知道家长代表是做什么的，而且有很多事要忙。","words":[[0,3,94.216,94.401,"hun"],[4,7,94.476,94.779,"vet"],[8,12,94.779,94.999,"ikke"],[13,16,94.999,95.141,"hva"],[17,19,95.156,95.321,"en"],[20,33,95.356,96.261,"klassekontakt"],[34,36,96.316,96.581,"er"],[38,40,97.276,97.418,"og"],[41,44,97.418,97.569,"hun"],[45,48,97.569,97.741,"har"],[49,52,97.756,98.101,"mye"],[53,54,98.116,98.219,"å"],[55,60,98.219,98.561,"gjøre"]]},{"id":26,"start":100.236,"end":103.521,"text":"Malik sier at han vil sende mer informasjon til henne.","zh":"马利克说会给她发更多信息。","words":[[0,5,100.236,100.801,"malik"],[6,10,100.856,101.129,"sier"],[11,13,101.129,101.258,"at"],[14,17,101.258,101.399,"han"],[18,21,101.399,101.541,"vil"],[22,27,101.616,101.961,"sende@pa-vei-extra-135"],[28,31,102.016,102.321,"mer"],[32,43,102.356,103.138,"informasjon"],[44,47,103.138,103.288,"til"],[48,53,103.288,103.521,"henne"]]},{"id":27,"start":104.716,"end":109.341,"text":"Han håper at hun sier ja når hun har lest hva en klassekontakt er.","zh":"他希望她了解家长代表的职责后能答应。","words":[[0,3,104.716,104.901,"han"],[4,9,104.936,105.279,"håper"],[10,12,105.279,105.418,"at"],[13,16,105.418,105.541,"hun"],[17,21,105.576,105.921,"sier"],[22,24,105.976,106.141,"ja"],[25,28,106.836,107.008,"når@pa-vei-når-when"],[29,32,107.008,107.148,"hun"],[33,36,107.148,107.298,"har"],[37,41,107.298,107.698,"lest"],[42,45,107.698,107.901,"hva"],[46,48,108.056,108.201,"en"],[49,62,108.216,109.021,"klassekontakt"],[63,65,109.076,109.341,"er"]]}],"lexicon":{"amira":{"lemma":"Amira","pos":"专名","zh":"阿米拉（人名）","ref":null,"clip":null},"andre":{"lemma":"annen","pos":"限定词","zh":"其他的；别的","ref":null,"clip":null,"form":"复数"},"andre@pa-vei-andre-other":{"lemma":"annen","pos":"限定词","zh":"另一个；另一侧的","ref":null,"clip":null,"form":"定指形式","contextual":true,"baseKey":"andre","surface":"andre"},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"barna":{"lemma":"barn","zh":"孩子","pos":"名词","ref":"basics:family:barn","form":"复数定指","clip":null},"begynte":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","form":"过去时","clip":null},"bli":{"lemma":"bli","pos":"动词","zh":"变成；成为；留下","ref":null,"clip":null,"form":"不定式"},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"de@pa-vei-de-definite":{"lemma":"de","pos":"定冠词","zh":"这些；那些（形容词前的复数定冠词）","ref":null,"clip":null,"contextual":true,"baseKey":"de","surface":"de"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"den@pa-vei-den-definite":{"lemma":"den","pos":"定冠词","zh":"这个；那个（形容词或序数词前的通性定冠词）","ref":null,"clip":null,"contextual":true,"baseKey":"den","surface":"den"},"dere":{"lemma":"dere","zh":"你们","pos":"代词","ref":"ty-conversation-4-004","clip":null,"form":"主格"},"det":{"lemma":"det"