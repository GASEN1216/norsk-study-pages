{"id":"pa-vei-13.story","bookId":"pa-vei-textbook","readingId":"13.story","title":"Hunden og ulven","audio":"audio/pa-vei/13.story.mp3","duration":90.696,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.12,"end":4.765,"text":"En ulv og en hund kom i snakk med hverandre.","zh":"一只狼和一条狗聊起了天。","words":[[0,2,1.12,1.285,"en"],[3,6,1.42,1.845,"ulv"],[7,9,2.14,2.263,"og"],[10,12,2.263,2.405,"en"],[13,17,2.46,2.845,"hund"],[18,21,3.44,3.625,"kom"],[22,23,3.66,3.763,"i"],[24,29,3.763,4.085,"snakk"],[30,33,4.1,4.252,"med"],[34,43,4.252,4.765,"hverandre"]]},{"id":1,"start":6.56,"end":11.965,"text":"Ulven var så sulten og tynn. Den kunne nesten ikke stå på beina.","zh":"狼又饿又瘦，几乎都站不稳了。","words":[[0,5,6.56,7.005,"ulven"],[6,9,7.02,7.203,"var"],[10,12,7.203,7.345,"så"],[13,19,7.46,8.043,"sulten"],[20,22,8.043,8.165,"og"],[23,27,8.18,8.545,"tynn"],[29,32,9.56,9.725,"den"],[33,38,9.76,10.065,"kunne"],[39,45,10.12,10.585,"nesten"],[46,50,10.64,10.945,"ikke"],[51,54,11.02,11.245,"stå"],[55,57,11.42,11.565,"på"],[58,63,11.58,11.965,"beina"]]},{"id":2,"start":14.052,"end":22.557,"text":"Det er vanskelige tider, sa ulven til hunden. Jeg klarer nesten ikke å få tak i noe å spise.","zh":"“日子真难过。”狼对狗说，“我几乎找不到吃的。”","words":[[0,3,14.052,14.204,"det"],[4,6,14.204,14.317,"er"],[7,17,14.372,15.137,"vanskelige"],[18,23,15.172,15.717,"tider"],[25,27,16.392,16.557,"sa"],[28,33,16.612,17.037,"ulven"],[34,37,17.052,17.237,"til"],[38,44,17.252,17.677,"hunden"],[46,49,19.412,19.575,"jeg"],[50,56,19.575,19.937,"klarer"],[57,63,19.972,20.537,"nesten"],[64,68,20.612,20.934,"ikke"],[69,70,20.934,21.057,"å"],[71,73,21.072,21.197,"få"],[74,77,21.252,21.637,"tak"],[78,79,21.652,21.744,"i"],[80,83,21.744,21.974,"noe"],[84,85,21.974,22.064,"å"],[86,91,22.064,22.557,"spise"]]},{"id":3,"start":24.812,"end":27.997,"text":"Da kan vi dele jobben min, sa hunden.","zh":"“那我们可以分担我的工作。”狗说。","words":[[0,2,24.812,24.957,"da"],[3,6,25.032,25.194,"kan"],[7,9,25.194,25.317,"vi"],[10,14,25.332,25.677,"dele"],[15,21,25.732,26.157,"jobben"],[22,25,26.192,26.517,"min"],[27,29,27.352,27.517,"sa"],[30,36,27.552,27.997,"hunden"]]},{"id":4,"start":29.132,"end":36.217,"text":"Jeg bor hos menneskene, og de kommer med kjøtt til meg og gir meg alt jeg trenger hver dag.","zh":"“我和人住在一起，他们会送肉给我，每天给我需要的一切。”","words":[[0,3,29.132,29.377,"jeg"],[4,7,29.432,29.645,"bor"],[8,11,29.645,29.877,"hos"],[12,22,29.892,30.677,"menneskene"],[24,26,31.392,31.537,"og"],[27,29,31.552,31.717,"de"],[30,36,31.832,32.144,"kommer"],[37,40,32.144,32.297,"med"],[41,46,32.332,32.697,"kjøtt"],[47,50,32.712,32.877,"til"],[51,54,32.912,33.117,"meg"],[55,57,33.692,33.837,"og"],[58,61,33.852,34.097,"gir"],[62,65,34.112,34.277,"meg"],[66,69,34.412,34.877,"alt"],[70,73,34.892,35.055,"jeg"],[74,81,35.055,35.477,"trenger"],[82,86,35.492,35.817,"hver"],[87,90,35.872,36.217,"dag"]]},{"id":5,"start":38.252,"end":44.797,"text":"Det var en fantastisk idé, sa ulven, jeg kommer og bor hos deg med det samme.","zh":"“这主意太好了。”狼说，“我马上就去你那里住。”","words":[[0,3,38.252,38.417,"det"],[4,7,38.452,38.675,"var"],[8,10,38.675,38.817,"en"],[11,21,38.852,39.857,"fantastisk"],[22,25,39.892,40.137,"idé"],[27,29,40.912,41.057,"sa"],[30,35,41.132,41.517,"ulven"],[37,40,42.492,42.657,"jeg"],[41,47,42.672,43.064,"kommer"],[48,50,43.064,43.194,"og"],[51,54,43.194,43.474,"bor"],[55,58,43.474,43.715,"hos"],[59,62,43.715,43.897,"deg"],[63,66,44.172,44.314,"med"],[67,70,44.314,44.454,"det"],[71,76,44.454,44.797,"samme"]]},{"id":6,"start":47.292,"end":50.177,"text":"Så fikk den øye på noe rundt hundens hals.","zh":"这时，它看见狗脖子上套着一个东西。","words":[[0,2,47.292,47.437,"så"],[3,7,47.512,47.715,"fikk"],[8,11,47.715,47.937,"den"],[12,15,48.012,48.297,"øye"],[16,18,48.312,48.457,"på"],[19,22,48.492,48.757,"noe"],[23,28,48.792,49.117,"rundt"],[29,36,49.152,49.737,"hundens"],[37,41,49.772,50.177,"hals"]]},{"id":7,"start":51.812,"end":54.857,"text":"Hva er det du har rundt halsen? spurte den.","zh":"“你脖子上是什么？”它问。","words":[[0,3,51.812,52.017,"hva"],[4,6,52.072,52.264,"er"],[7,10,52.264,52.404,"det"],[11,13,52.404,52.537,"du"],[14,17,52.592,52.855,"har"],[18,23,52.855,53.157,"rundt"],[24,30,53.172,53.717,"halsen"],[32,38,54.292,54.684,"spurte"],[39,42,54.684,54.857,"den"]]},{"id":8,"start":55.8,"end":60.577,"text":"Å det ... Det er bare halsbåndet mitt, det, sa hunden.","zh":"“哦，那个……那只是我的项圈。”狗说。","words":[[0,1,55.8,56.22,"å"],[2,5,56.252,56.437,"det"],[10,13,57.572,57.757,"det"],[14,16,57.792,57.934,"er"],[17,21,57.934,58.177,"bare"],[22,32,58.232,58.934,"halsbåndet"],[33,37,58.934,59.165,"mitt"],[39,42,59.165,59.317,"det"],[44,46,59.952,60.097,"sa"],[47,53,60.132,60.577,"hunden"]]},{"id":9,"start":61.532,"end":65.057,"text":"Menneskene bruker det for å binde meg fast utenfor huset.","zh":"“人用它把我拴在屋外。”","words":[[0,10,61.532,62.157,"menneskene"],[11,17,62.192,62.624,"bruker"],[18,21,62.624,62.775,"det"],[22,25,62.775,62.934,"for"],[26,27,62.934,63.025,"å"],[28,33,63.025,63.294,"binde"],[34,37,63.294,63.457,"meg"],[38,42,63.532,63.977,"fast"],[43,50,64.052,64.577,"utenfor"],[51,56,64.612,65.057,"huset"]]},{"id":10,"start":66.832,"end":71.837,"text":"Mener du at du ikke kan komme og gå som du vil? spurte ulven.","zh":"“你是说，你不能想来就来、想走就走吗？”狼问。","words":[[0,5,66.832,67.195,"mener"],[6,8,67.195,67.317,"du"],[9,11,67.332,67.484,"at"],[12,14,67.484,67.617,"du"],[15,19,67.692,67.977,"ikke"],[20,23,67.992,68.197,"kan"],[24,29,68.272,68.757,"komme"],[30,32,68.812,68.937,"og"],[33,35,69.012,69.177,"gå"],[36,39,69.412,69.597,"som"],[40,42,69.612,69.737,"du"],[43,46,69.792,69.997,"vil"],[48,54,71.012,71.417,"spurte"],[55,60,71.452,71.837,"ulven"]]},{"id":11,"start":73.112,"end":80.977,"text":"Jeg må jo holde meg i nærheten av huset når jeg skal passe på menneskene og holde vakt over huset, forklarte hunden.","zh":"“既然我要保护人、看守房子，当然就得待在房子附近。”狗解释说。","words":[[0,3,73.112,73.264,"jeg"],[4,6,73.264,73.397,"må"],[7,9,73.432,73.575,"jo"],[10,15,73.575,73.844,"holde"],[16,19,73.844,74.005,"meg"],[20,21,74.005,74.084,"i"],[22,30,74.084,74.717,"nærheten"],[31,33,74.812,74.977,"av"],[34,39,75.052,75.535,"huset"],[40,43,75.535,75.704,"når@pa-vei-når-when"],[44,47,75.704,75.844,"jeg"],[48,52,75.844,76.037,"skal"],[53,58,76.112,76.535,"passe"],[59,61,76.535,76.677,"på"],[62,72,76.732,77.477,"menneskene"],[73,75,77.772,77.885,"og"],[76,81,77.885,78.157,"holde"],[82,86,78.192,78.595,"vakt"],[87,91,78.595,78.817,"over"],[92,97,78.832,79.297,"huset"],[99,108,80.072,80.575,"forklarte"],[109,115,80.575,80.977,"hunden"]]},{"id":12,"start":82.712,"end":89.517,"text":"Da løp ulven tilbake til skogen igjen, og den tenkte aldri mer på å dele jobb med hunden.","zh":"狼于是跑回了森林，再也没想过和狗分担工作。","words":[[0,2,82.712,82.857,"da"],[3,6,82.952,83.277,"løp"],[7,12,83.332,83.717,"ulven"],[13,20,83.732,84.294,"tilbake"],[21,24,84.294,84.457,"til"],[25,31,84.512,85.035,"skogen"],[32,37,85.035,85.257,"igjen"],[39,41,85.952,86.065,"og"],[42,45,86.065,86.234,"den"],[46,52,86.234,86.597,"tenkte"],[53,58,86.792,87.297,"aldri"],[59,62,87.352,87.637,"mer"],[63,65,87.712,87.857,"på"],[66,67,87.892,87.997,"å"],[68,72,88.012,88.357,"dele"],[73,77,88.392,88.717,"jobb"],[78,81,88.932,89.095,"med"],[82,88,89.095,89.517,"hunden"]]}],"lexicon":{"aldri":{"lemma":"aldri","pos":"副词","zh":"从不；从来没有","ref":null,"clip":null},"alt":{"lemma":"alt","zh":"一切","pos":"代词","ref":"10-054","clip":null},"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"bare":{"lemma":"bare","pos":"副词","zh":"只；仅仅；就","ref":null,"clip":null},"beina":{"lemma":"bein","zh":"腿；骨头（身体词汇）","pos":"名词","ref":"12-028","form":"复数定指","clip":null},"binde":{"lemma":"binde","pos":"动词","zh":"绑；系","ref":null,"clip":null,"form":"不定式"},"bor":{"lemma":"bo","zh":"住；居住","pos":"动词","ref":"ty-conversation-1-002","clip":null,"form":"现在时"},"bruker":{"lemma":"bruke","zh":"使用；花（钱、时间）","pos":"动词","ref":"10-010","form":"现在时","clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-0