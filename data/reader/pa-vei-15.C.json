{"id":"pa-vei-15.C","bookId":"pa-vei-textbook","readingId":"15.C","title":"Pablo får jobb","audio":"audio/pa-vei/15.C.mp3","duration":69.96,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":0.9,"end":3.465,"text":"Endelig! Nå har jeg fått fast jobb.","zh":"终于！我找到一份正式工作了。","words":[[0,7,0.9,1.545,"endelig"],[9,11,2.22,2.345,"nå"],[12,15,2.4,2.542,"har"],[16,19,2.542,2.673,"jeg"],[20,24,2.673,2.905,"fått@pa-vei-extra-79"],[25,29,2.92,3.223,"fast"],[30,34,3.223,3.465,"jobb"]],"speaker":"Pablo"},{"id":1,"start":4.04,"end":5.245,"text":"Jeg skal begynne på mandag.","zh":"我星期一开始上班。","words":[[0,3,4.04,4.192,"jeg"],[4,8,4.192,4.385,"skal"],[9,16,4.4,4.752,"begynne"],[17,19,4.752,4.883,"på"],[20,26,4.883,5.245,"mandag"]],"speaker":"Pablo"},{"id":2,"start":5.92,"end":6.965,"text":"Hvordan klarte du det?","zh":"你是怎么找到的？","words":[[0,7,5.92,6.245,"hvordan"],[8,14,6.28,6.672,"klarte@pa-vei-extra-81"],[15,17,6.672,6.803,"du"],[18,21,6.803,6.965,"det"]],"speaker":"Safer"},{"id":3,"start":7.82,"end":11.165,"text":"En venn av meg jobber i et transportbyrå, og de trengte folk.","zh":"我的一个朋友在一家运输公司工作，他们需要人手。","words":[[0,2,7.82,7.965,"en"],[3,7,7.98,8.203,"venn"],[8,10,8.203,8.303,"av"],[11,14,8.303,8.465,"meg"],[15,21,8.48,8.773,"jobber"],[22,23,8.773,8.842,"i"],[24,26,8.842,8.943,"et"],[27,40,8.943,9.765,"transportbyrå"],[42,44,10.26,10.383,"og"],[45,47,10.383,10.502,"de"],[48,55,10.502,10.843,"trengte"],[56,60,10.843,11.165,"folk"]],"speaker":"Pablo"},{"id":4,"start":12.068,"end":13.593,"text":"Jeg var til intervju i forrige uke.","zh":"我上星期去面试了。","words":[[0,3,12.068,12.2,"jeg"],[4,7,12.2,12.341,"var"],[8,11,12.341,12.491,"til"],[12,20,12.491,12.873,"intervju@pa-vei-extra-82"],[21,22,12.968,13.07,"i"],[23,30,13.07,13.361,"forrige"],[31,34,13.361,13.593,"uke"]],"speaker":"Pablo"},{"id":5,"start":14.248,"end":16.393,"text":"Så flott! Hva slags jobb er det?","zh":"太好了！是什么工作？","words":[[0,2,14.248,14.393,"så"],[3,8,14.448,14.813,"flott"],[10,13,15.468,15.633,"hva"],[14,19,15.648,15.91,"slags"],[20,24,15.91,16.151,"jobb"],[25,27,16.151,16.27,"er"],[28,31,16.27,16.393,"det"]],"speaker":"Safer"},{"id":6,"start":17.328,"end":19.413,"text":"Jeg skal være hjelpemann på en lastebil.","zh":"我要当货车上的助手。","words":[[0,3,17.328,17.5,"jeg"],[4,8,17.5,17.691,"skal"],[9,13,17.691,17.913,"være"],[14,24,17.928,18.601,"hjelpemann"],[25,27,18.601,18.721,"på"],[28,30,18.721,18.84,"en"],[31,39,18.84,19.413,"lastebil"]],"speaker":"Pablo"},{"id":7,"start":20.328,"end":23.573,"text":"Vi leverer vaskemaskiner og komfyrer og sånt hjem til folk.","zh":"我们把洗衣机、炉灶之类的东西送到顾客家里。","words":[[0,2,20.328,20.473,"vi"],[3,10,20.528,20.891,"leverer"],[11,24,20.891,21.673,"vaskemaskiner"],[25,27,21.788,21.921,"og"],[28,36,21.921,22.49,"komfyrer"],[37,39,22.49,22.59,"og"],[40,44,22.59,22.873,"sånt"],[45,49,22.968,23.17,"hjem"],[50,53,23.17,23.3,"til"],[54,58,23.3,23.573,"folk"]],"speaker":"Pablo"},{"id":8,"start":23.968,"end":24.953,"text":"Er ikke det tungt?","zh":"这活儿不累吗？","words":[[0,2,23.968,24.14,"er"],[3,7,24.14,24.35,"ikke"],[8,11,24.35,24.473,"det"],[12,17,24.528,24.953,"tungt@pa-vei-extra-80"]],"speaker":"Safer"},{"id":9,"start":25.448,"end":28.693,"text":"Jo, det er en ganske tung jobb, men jeg får jo god trening!","zh":"累，是相当费体力的工作，不过也能好好锻炼身体！","words":[[0,2,25.448,25.613,"jo"],[4,7,25.648,25.791,"det"],[8,10,25.791,25.881,"er"],[11,13,25.881,26.011,"en"],[14,20,26.011,26.493,"ganske"],[21,25,26.508,26.73,"tung"],[26,30,26.73,26.953,"jobb"],[32,35,27.508,27.691,"men"],[36,39,27.691,27.82,"jeg"],[40,43,27.82,27.95,"får"],[44,46,27.95,28.071,"jo"],[47,50,28.071,28.291,"god"],[51,58,28.291,28.693,"trening@pa-vei-extra-83"]],"speaker":"Pablo"},{"id":10,"start":30.008,"end":32.233,"text":"Det verste er at vi begynner så tidlig om morgenen.","zh":"最难的是，我们早上开工太早了。","words":[[0,3,30.008,30.151,"det@pa-vei-det-definite"],[4,10,30.151,30.511,"verste"],[11,13,30.511,30.651,"er"],[14,16,30.651,30.77,"at"],[17,19,30.77,30.861,"vi"],[20,28,30.861,31.18,"begynner"],[29,31,31.18,31.293,"så"],[32,38,31.368,31.8,"tidlig"],[39,41,31.8,31.91,"om"],[42,50,31.91,32.233,"morgenen"]],"speaker":"Pablo"},{"id":11,"start":33.208,"end":34.633,"text":"Jeg må være på jobben klokka sju.","zh":"我必须七点到单位。","words":[[0,3,33.208,33.341,"jeg"],[4,6,33.341,33.45,"må"],[7,11,33.45,33.68,"være"],[12,14,33.68,33.791,"på"],[15,21,33.791,34.04,"jobben"],[22,28,34.04,34.313,"klokka"],[29,32,34.448,34.633,"sju"]],"speaker":"Pablo"},{"id":12,"start":35.668,"end":37.193,"text":"Da begynner vi å laste på bilen.","zh":"那时我们开始往车上装货。","words":[[0,2,35.668,35.813,"da"],[3,11,35.908,36.24,"begynner"],[12,14,36.24,36.353,"vi"],[15,16,36.428,36.52,"å"],[17,22,36.52,36.781,"laste"],[23,25,36.781,36.9,"på"],[26,31,36.9,37.193,"bilen"]],"speaker":"Pablo"},{"id":13,"start":38.388,"end":40.093,"text":"Men hvordan går det med deg, da?","zh":"那你怎么样了？","words":[[0,3,38.388,38.593,"men"],[4,11,39.168,39.451,"hvordan"],[12,15,39.451,39.56,"går"],[16,19,39.56,39.66,"det"],[20,23,39.66,39.781,"med"],[24,27,39.781,39.953,"deg"],[29,31,39.968,40.093,"da"]],"speaker":"Pablo"},{"id":14,"start":40.888,"end":42.793,"text":"Jeg har søkt mange jobber uten å få svar.","zh":"我申请了很多工作，都没收到回复。","words":[[0,3,40.888,41.031,"jeg"],[4,7,41.031,41.171,"har"],[8,12,41.171,41.49,"søkt"],[13,18,41.49,41.751,"mange"],[19,25,41.751,42.04,"jobber"],[26,30,42.04,42.26,"uten"],[31,32,42.26,42.341,"å"],[33,35,42.341,42.453,"få"],[36,40,42.488,42.793,"svar"]],"speaker":"Safer"},{"id":15,"start":43.388,"end":44.653,"text":"Det er ganske deprimerende.","zh":"这相当让人沮丧。","words":[[0,3,43.388,43.54,"det"],[4,6,43.54,43.693,"er"],[7,13,43.708,44.061,"ganske"],[14,26,44.061,44.653,"deprimerende"]],"speaker":"Safer"},{"id":16,"start":45.228,"end":47.153,"text":"Ja, jeg vet hvordan det er.","zh":"是啊，我知道那种感觉。","words":[[0,2,45.228,45.373,"ja"],[4,7,46.328,46.46,"jeg"],[8,11,46.46,46.671,"vet"],[12,19,46.671,46.91,"hvordan"],[20,23,46.91,47.031,"det"],[24,26,47.031,47.153,"er"]],"speaker":"Pablo"},{"id":17,"start":48.028,"end":51.093,"text":"Men nå har jeg kontakt med et vikarbyrå her i byen.","zh":"不过现在我联系上了城里的一家临时工作中介。","words":[[0,3,48.028,48.233,"men"],[4,6,48.508,48.653,"nå"],[7,10,48.928,49.111,"har"],[11,14,49.111,49.251,"jeg"],[15,22,49.251,49.691,"kontakt"],[23,26,49.691,49.811,"med"],[27,29,49.811,49.91,"et"],[30,39,49.91,50.611,"vikarbyrå"],[40,43,50.611,50.76,"her"],[44,45,50.76,50.831,"i"],[46,50,50.831,51.093,"byen"]],"speaker":"Safer"},{"id":18,"start":51.788,"end":54.973,"text":"De har fått cv-en min, og i neste uke skal jeg til intervju.","zh":"他们收到了我的简历，下星期我要去面试。","words":[[0,2,51.788,51.91,"de"],[3,6,51.91,52.061,"har"],[7,11,52.061,52.273,"fått@pa-vei-extra-75"],[12,17,52.288,52.701,"cv-en"],[18,21,52.701,52.893,"min"],[23,25,53.468,53.581,"og"],[26,27,53.581,53.651,"i"],[28,33,53.651,53.96,"neste"],[34,37,53.96,54.213,"uke"],[38,42,54.228,54.431,"skal"],[43,46,54.431,54.55,"jeg"],[47,50,54.55,54.671,"til"],[51,59,54.671,54.973,"intervju@pa-vei-extra-76"]],"speaker":"Safer"},{"id":19,"start":55.688,"end":59.153,"text":"Det er bra. Jeg har hørt at mange får jobb gjennom vikarbyrå.","zh":"这很好。我听说很多人通过临时工作中介找到工作。","words":[[0,3,55.688,55.85,"det"],[4,6,55.85,55.971,"er"],[7,10,55.971,56.113,"bra"],[12,15,56.968,57.1,"jeg"],[16,19,57.1,57.21,"har"],[20,24,57.21,57.41,"hørt@pa-vei-extra-77"],[25,27,57.41,57.55,"at"],[28,33,57.55,57.873,"mange"],[34,37,57.888,58.073,"får"],[38,42,58.088,58.341,"jobb"],[43,50,58.341,58.641,"gjennom@pa-vei-extra-78"],[51,60,58.641,59.153,"vikarbyrå"]],"speaker":"Pablo"},{"id":20,"start":59.848,"end":63.653,"text":"Jeg håper det blir slik for meg også. Nå trenger jeg virkelig å få meg en jobb.","zh":"希望我也能这样。我现在确实需要一份工作。","words":[[0,3,59.848,60.001,"jeg"],[4,9,60.001,60.251,"håper"],[10,13,60.251,60.35,"det"],[14,18,60.35,60.501,"blir"],[19,23,60.501,60.74,"slik"],[24,27,60.74,60.87,"for"],[28,31,60.87,61.033,"meg"],[32,36,61.048,61.313,"også"],[38,40,62.168,62.313,"nå"],[41,48,62.368,62.651,"trenger"],[49,52,62.651,62.76,"jeg"],[53,61,62.76,63.09,"virkelig"],[62,63,63.09,63.151,"å"],[64,66,63.151,63.26,"få"],[67,70,63.26,63.37,"meg"],[71,73,63.37,63.451,"en"],[74,78,63.451,63.653,"jobb"]],"speaker":"Safer"},{"id":21,"start":64.108,"end":65.213,"text":"Lykke til på intervjuet.","zh":"祝你面试顺利。","words":[[0,5,64.108,64.451,"lykke"],[6,9,64.451,64.633,"til"],[10,12,64.648,64.761,"på"],[13,23,64.761,65.213,"intervjuet@pa-vei-extra-84"]],"speaker":"Pablo"},{"id":22,"start":65.628,"end":68.093,"text":"Takk! Og lykke til i den nye jobben.","zh":"谢谢！也祝你新工作顺利。","words":[[0,4,65.628,65.993,"takk"],[6,8,66.788,66.91,"og"],[9,14,66.91,67.16,"lykke"],[15,18,67.16,67.333,"til"],[19,20,67.348,67.43,"i"],[21,24,67.43,67.56,"den@pa-vei-den-definite"],[25,28,67.56,67.791,"nye"],[29,35,67.791,68.093,"jobben"]],"speaker":"Safer"}],"lexicon":{"at":{"lemma":"at","zh":"（连词）引导从句，常不译出","pos":"从属连词","ref":"12-005","clip":null},"av":{"lemma":"av","pos":"介词","zh":"从；由；……的（表示来源、组成等）","ref":null,"clip":null},"begynne":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","clip":null},"begynner":{"lemma":"begynne","zh":"开始","pos":"动词","ref":"6-105","form":"现在时","clip":null},"bilen":{"lemma":"bil","zh":"汽车","pos":"名词","ref":"6-095","form":"单数定指","clip":null},"blir":{"lemma":"bli","zh":"变成；（将）会；留下","pos":"动词","ref":"5-065","form":"现在时","clip":null},"bra":{"lemma":"bra","zh":"好","pos":"副词","ref":"pa-vei-2-018","clip":null},"byen":{"lemma":"by","zh":"城市","pos":"名词","ref":"basics:city:by","form":"单数定指","clip":null},"cv-en":{"lemma":"cv","pos":"名词","form":"单数定指","zh":"简历","ref":null,"clip":null},"da":{"lemma":"da","zh":"那么；那就","pos":"副词","ref":"ty-conversation-9-006","clip":null},"de":{"lemma":"de","pos":"代词","zh":"他们；她们；它们","ref":null,"clip":null,"form":"复数主格"},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"den":{"lemma":"den","pos":"代词","zh":"它；那个（指通性名词）","ref":null,"clip":null},"den@pa-vei-den-definite":{"lemma":"den","pos":"定冠词","zh":"这个；那个（形容词或序数词前的通性定冠词）","ref":null,"clip":n