{"id":"pa-vei-10.C","bookId":"pa-vei-textbook","readingId":"10.C","title":"Livet etter norskkurset","audio":"audio/pa-vei/10.C.mp3","duration":93.84,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.18,"end":6.425,"text":"Michelle og Paul er ferdige med norskkurset, og Michelle jobber på et sykehjem.","zh":"米歇尔和保罗已经完成了挪威语课程，米歇尔在一家养老院工作。","words":[[0,8,1.18,1.802,"michelle"],[9,11,1.802,1.945,"og"],[12,16,1.96,2.325,"paul"],[17,19,2.46,2.665,"er"],[20,27,2.74,3.242,"ferdige"],[28,31,3.242,3.373,"med"],[32,43,3.373,4.045,"norskkurset"],[45,47,4.52,4.662,"og"],[48,56,4.662,5.232,"michelle"],[57,63,5.232,5.565,"jobber"],[64,66,5.58,5.705,"på"],[67,69,5.72,5.883,"et"],[70,78,5.883,6.425,"sykehjem"]]},{"id":1,"start":8.0,"end":11.665,"text":"Paul vil gjerne arbeide som arkitekt, men det er vanskelig.","zh":"保罗很想当建筑师，不过很困难。","words":[[0,4,8.0,8.363,"paul"],[5,8,8.363,8.523,"vil"],[9,15,8.523,8.805,"gjerne"],[16,23,8.84,9.303,"arbeide"],[24,27,9.303,9.463,"som@pa-vei-som-as"],[28,36,9.463,10.125,"arkitekt"],[38,41,10.5,10.685,"men"],[42,45,10.7,10.885,"det"],[46,48,10.92,11.085,"er"],[49,58,11.12,11.665,"vanskelig"]]},{"id":2,"start":13.166,"end":15.331,"text":"Nå har han jobb på et lager i byen.","zh":"现在他在城里的一家仓库工作。","words":[[0,2,13.166,13.311,"nå"],[3,6,13.386,13.559,"har"],[7,10,13.559,13.711,"han"],[11,15,13.726,14.011,"jobb"],[16,18,14.086,14.231,"på"],[19,21,14.246,14.411,"et"],[22,27,14.426,14.909,"lager"],[28,29,14.909,14.998,"i"],[30,34,14.998,15.331,"byen"]]},{"id":3,"start":16.426,"end":20.511,"text":"Det er et hyggelig miljø på arbeidsplassen med mennesker fra mange land.","zh":"工作环境很友好，同事来自很多国家。","words":[[0,3,16.426,16.578,"det"],[4,6,16.578,16.698,"er"],[7,9,16.698,16.828,"et"],[10,18,16.828,17.238,"hyggelig"],[19,24,17.238,17.551,"miljø"],[25,27,17.646,17.771,"på"],[28,42,17.786,18.571,"arbeidsplassen"],[43,46,18.946,19.108,"med"],[47,56,19.108,19.631,"mennesker"],[57,60,19.666,19.851,"fra"],[61,66,19.886,20.228,"mange"],[67,71,20.228,20.511,"land"]]},{"id":4,"start":22.506,"end":26.231,"text":"I samme hus som Paul og Michelle bor Gaute.","zh":"高特和保罗、米歇尔住在同一栋楼里。","words":[[0,1,22.506,22.611,"i"],[2,7,22.726,23.091,"samme"],[8,11,23.106,23.471,"hus"],[12,15,23.626,23.811,"som"],[16,20,23.886,24.251,"paul"],[21,23,24.286,24.419,"og"],[24,32,24.419,24.891,"michelle"],[33,36,25.306,25.611,"bor"],[37,42,25.706,26.231,"gaute"]]},{"id":5,"start":27.326,"end":28.611,"text":"Han er naboen deres.","zh":"他是他们的邻居。","words":[[0,3,27.326,27.511,"han"],[4,6,27.526,27.648,"er"],[7,13,27.648,28.198,"naboen"],[14,19,28.198,28.611,"deres"]]},{"id":6,"start":30.246,"end":34.911,"text":"Gaute er alenepappa og bor sammen med sønnen sin, Elias.","zh":"高特是单身爸爸，和儿子埃利亚斯一起住。","words":[[0,5,30.246,30.751,"gaute"],[6,8,30.766,30.931,"er"],[9,19,30.946,31.811,"alenepappa"],[20,22,32.226,32.351,"og"],[23,26,32.386,32.671,"bor"],[27,33,32.746,33.088,"sammen"],[34,37,33.088,33.248,"med"],[38,44,33.248,33.611,"sønnen"],[45,48,33.646,33.931,"sin"],[50,55,34.266,34.911,"elias"]]},{"id":7,"start":36.606,"end":39.031,"text":"Elias og Ben er bestevenner.","zh":"埃利亚斯和本是最好的朋友。","words":[[0,5,36.606,37.231,"elias"],[6,8,37.286,37.431,"og"],[9,12,37.466,37.711,"ben"],[13,15,38.066,38.271,"er"],[16,27,38.326,39.031,"bestevenner"]]},{"id":8,"start":40.386,"end":44.191,"text":"De går sammen på skolen og spiller på samme fotballag.","zh":"他们一起上学，也在同一支足球队踢球。","words":[[0,2,40.386,40.531,"de"],[3,6,40.626,40.871,"går"],[7,13,40.946,41.331,"sammen"],[14,16,41.346,41.491,"på"],[17,23,41.506,41.951,"skolen"],[24,26,42.346,42.491,"og"],[27,34,42.526,42.951,"spiller"],[35,37,42.966,43.091,"på"],[38,43,43.146,43.511,"samme"],[44,53,43.526,44.191,"fotballag"]]},{"id":9,"start":46.526,"end":55.211,"text":"En dag fortalte Gaute at fotballklubben trengte en ny trener til guttelaget, og han lurte på om Paul hadde lyst på jobben.","zh":"有一天，高特说足球俱乐部需要一位新的男孩队教练，问保罗有没有兴趣。","words":[[0,2,46.526,46.769,"en"],[3,6,46.769,47.071,"dag"],[7,15,47.106,47.689,"fortalte"],[16,21,47.689,48.211,"gaute"],[22,24,48.326,48.489,"at"],[25,39,48.489,49.351,"fotballklubben"],[40,47,49.446,49.871,"trengte"],[48,50,49.906,50.031,"en"],[51,53,50.086,50.231,"ny"],[54,60,50.426,50.971,"trener@pa-vei-trener-coach"],[61,64,51.026,51.191,"til"],[65,75,51.226,51.871,"guttelaget"],[77,79,52.726,52.851,"og"],[80,83,52.866,53.011,"han"],[84,89,53.026,53.368,"lurte"],[90,92,53.368,53.491,"på"],[93,95,53.546,53.691,"om@pa-vei-om-whether"],[96,100,53.766,54.171,"paul"],[101,106,54.206,54.439,"hadde"],[107,111,54.439,54.719,"lyst@pa-vei-lyst-desire"],[112,114,54.719,54.849,"på"],[115,121,54.849,55.211,"jobben"]]},{"id":10,"start":56.746,"end":57.731,"text":"Paul ble glad.","zh":"保罗很高兴。","words":[[0,4,56.746,57.151,"paul"],[5,8,57.186,57.371,"ble"],[9,13,57.406,57.731,"glad"]]},{"id":11,"start":59.186,"end":63.751,"text":"Han spilte fotball i Kongo og hadde veldig lyst på en slik jobb.","zh":"他在刚果时踢过足球，很想做这样的工作。","words":[[0,3,59.186,59.371,"han"],[4,10,59.466,59.831,"spilte"],[11,18,59.846,60.319,"fotball"],[19,20,60.319,60.411,"i"],[21,26,60.426,60.811,"kongo"],[27,29,61.346,61.489,"og"],[30,35,61.489,61.751,"hadde"],[36,42,61.846,62.409,"veldig"],[43,47,62.409,62.751,"lyst@pa-vei-lyst-desire"],[48,50,62.766,62.891,"på"],[51,53,62.906,63.031,"en"],[54,58,63.066,63.451,"slik"],[59,63,63.466,63.751,"jobb"]]},{"id":12,"start":65.586,"end":67.471,"text":"Men han følte seg usikker.","zh":"可是他没有把握。","words":[[0,3,65.586,65.771,"men"],[4,7,65.846,66.031,"han"],[8,13,66.086,66.548,"følte"],[14,17,66.548,66.731,"seg"],[18,25,66.846,67.471,"usikker"]]},{"id":13,"start":68.826,"end":71.391,"text":"Han visste ikke om han var flink nok i norsk.","zh":"他不知道自己的挪威语是否足够好。","words":[[0,3,68.826,68.991,"han"],[4,10,69.006,69.351,"visste"],[11,15,69.366,69.638,"ikke"],[16,18,69.638,69.768,"om@pa-vei-om-whether"],[19,22,69.768,69.918,"han"],[23,26,69.918,70.071,"var"],[27,32,70.166,70.611,"flink"],[33,36,70.626,70.869,"nok"],[37,38,70.869,70.969,"i"],[39,44,70.969,71.391,"norsk"]]},{"id":14,"start":72.906,"end":78.451,"text":"Han ble likevel med Gaute for å snakke med lederne i klubben, og det gikk bra.","zh":"不过他还是跟高特一起去和俱乐部负责人聊了聊，结果很顺利。","words":[[0,3,72.906,73.091,"han"],[4,7,73.106,73.271,"ble"],[8,15,73.366,73.911,"likevel"],[16,19,73.946,74.151,"med"],[20,25,74.206,74.711,"gaute"],[26,29,74.746,74.928,"for"],[30,31,74.928,75.031,"å"],[32,38,75.086,75.488,"snakke"],[39,42,75.488,75.638,"med"],[43,50,75.638,76.111,"lederne"],[51,52,76.126,76.231,"i"],[53,60,76.246,76.631,"klubben"],[62,64,77.446,77.591,"og"],[65,68,77.646,77.851,"det"],[69,73,77.946,78.231,"gikk"],[74,77,78.246,78.451,"bra"]]},{"id":15,"start":80.226,"end":83.411,"text":"To dager senere hadde han den første treningen.","zh":"两天后，他进行了第一次训练。","words":[[0,2,80.226,80.391,"to"],[3,8,80.526,80.911,"dager"],[9,15,80.966,81.391,"senere"],[16,21,81.706,81.991,"hadde"],[22,25,82.006,82.171,"han"],[26,29,82.226,82.391,"den@pa-vei-den-definite"],[30,36,82.446,82.851,"første"],[37,46,82.866,83.411,"treningen"]]},{"id":16,"start":84.726,"end":89.371,"text":"Nå trener han laget til Ben og vennene hans to ettermiddager i uka.","zh":"现在，他每周有两个下午带本和他的朋友们训练。","words":[[0,2,84.726,84.871,"nå"],[3,9,85.006,85.418,"trener"],[10,13,85.418,85.571,"han"],[14,19,85.606,86.011,"laget"],[20,23,86.026,86.191,"til"],[24,27,86.266,86.511,"ben"],[28,30,86.746,86.891,"og"],[31,38,86.906,87.288,"vennene"],[39,43,87.288,87.631,"hans"],[44,46,87.966,88.151,"to"],[47,60,88.346,88.999,"ettermiddager"],[61,62,88.999,89.078,"i"],[63,66,89.078,89.371,"uka"]]},{"id":17,"start":90.406,"end":92.371,"text":"I dag spiller laget hans kamp.","zh":"今天，他的球队有比赛。","words":[[0,1,90.406,90.511,"i"],[2,5,90.546,90.871,"dag"],[6,13,90.906,91.311,"spiller"],[14,19,91.326,91.668,"laget"],[20,24,91.668,91.948,"hans"],[25,29,91.948,92.371,"kamp"]]}],"lexicon":{"alenepappa":{"lemma":"alenepappa","zh":"独自抚养孩子的父亲；单亲爸爸","pos":"名词","ref":"pa-vei-10-078","clip":null},"arbeide":{"lemma":"arbeide","zh":"工作","pos":"动词","ref":"pa