{"id":"ty-conversation-5.1","bookId":"ty-conversation-guide","readingId":"5.1","title":"Going to a chemist","audio":"audio/ty-conversation/5.1.mp3","duration":46.654708,"synthetic":false,"sentences":[{"id":0,"start":0.77,"end":2.875,"speaker":"Pharmacist","text":"Hei! Kan jeg hjelpe deg?","zh":"你好！有什么可以帮你的吗？","words":[[0,3,0.77,0.995,"hei"],[5,8,1.93,2.135,"kan"],[9,12,2.15,2.335,"jeg"],[13,19,2.35,2.702,"hjelpe"],[20,23,2.702,2.875,"deg"]]},{"id":1,"start":4.51,"end":7.275,"speaker":"Olav","text":"Hei! Jeg er syk.","zh":"你好！我生病了。","words":[[0,3,4.51,4.775,"hei"],[5,8,6.13,6.395,"jeg"],[9,11,6.51,6.695,"er@ty-be-state"],[12,15,6.81,7.275,"syk"]]},{"id":2,"start":8.75,"end":9.855,"speaker":"Olav","text":"Jeg kaster opp.","zh":"我在呕吐。","words":[[0,3,8.75,8.935,"jeg"],[4,10,8.97,9.535,"kaster"],[11,14,9.59,9.855,"opp"]]},{"id":3,"start":11.37,"end":12.315,"speaker":"Olav","text":"Jeg har diaré.","zh":"我还腹泻。","words":[[0,3,11.37,11.555,"jeg"],[4,7,11.59,11.855,"har@ty-symptom"],[8,13,11.91,12.315,"diaré"]]},{"id":4,"start":13.51,"end":14.535,"speaker":"Pharmacist","text":"Har du feber?","zh":"你发烧吗？","words":[[0,3,13.51,13.752,"har@ty-symptom"],[4,6,13.752,13.895,"du"],[7,12,14.13,14.535,"feber"]]},{"id":5,"start":15.65,"end":18.235,"speaker":"Olav","text":"Nei, jeg har ikke feber.","zh":"不，我不发烧。","words":[[0,3,15.65,15.955,"nei"],[5,8,16.99,17.163,"jeg"],[9,12,17.163,17.335,"har@ty-symptom"],[13,17,17.39,17.755,"ikke"],[18,23,17.85,18.235,"feber"]]},{"id":6,"start":19.33,"end":20.315,"speaker":"Pharmacist","text":"Har du hodepine?","zh":"你头痛吗？","words":[[0,3,19.33,19.523,"har@ty-symptom"],[4,6,19.523,19.635,"du"],[7,15,19.67,20.315,"hodepine"]]},{"id":7,"start":21.93,"end":24.675,"speaker":"Olav","text":"Nei, men jeg føler meg syk.","zh":"不，但我觉得不舒服。","words":[[0,3,21.93,22.195,"nei"],[5,8,23.25,23.402,"men"],[9,12,23.402,23.575,"jeg"],[13,18,23.63,24.035,"føler"],[19,22,24.05,24.215,"meg"],[23,26,24.29,24.675,"syk"]]},{"id":8,"start":25.85,"end":26.895,"speaker":"Pharmacist","text":"Er du allergisk?","zh":"你有过敏的情况吗？","words":[[0,2,25.85,26.013,"er@ty-be-state"],[3,5,26.013,26.155,"du"],[6,15,26.21,26.895,"allergisk"]]},{"id":9,"start":28.17,"end":31.195,"speaker":"Olav","text":"Nei, jeg er ikke allergisk.","zh":"没有，我不过敏。","words":[[0,3,28.17,28.435,"nei"],[5,8,29.39,29.595,"jeg"],[9,11,29.63,29.815,"er@ty-be-state"],[12,16,29.97,30.355,"ikke"],[17,26,30.55,31.195,"allergisk"]]},{"id":10,"start":32.79,"end":34.755,"speaker":"Pharmacist","text":"Her har du en god medisin.","zh":"给你，这种药效果很好。","words":[[0,3,32.79,33.095,"her"],[4,7,33.11,33.323,"har@ty-handover"],[8,10,33.323,33.455,"du"],[11,13,33.55,33.695,"en"],[14,17,33.77,34.055,"god"],[18,25,34.19,34.755,"medisin"]]},{"id":11,"start":35.59,"end":37.915,"speaker":"Pharmacist","text":"Medisinen koster tjuetre kroner.","zh":"这种药要 23 克朗。","words":[[0,9,35.59,36.255,"medisinen"],[10,16,36.39,36.795,"koster"],[17,24,36.83,37.355,"tjuetre"],[25,31,37.51,37.915,"kroner"]]},{"id":12,"start":38.99,"end":39.935,"speaker":"Pharmacist","text":"Du må drikke vann.","zh":"你得喝水。","words":[[0,2,38.99,39.133,"du"],[3,5,39.133,39.275,"må"],[6,12,39.29,39.655,"drikke"],[13,17,39.67,39.935,"vann"]]},{"id":13,"start":41.29,"end":42.355,"speaker":"Olav","text":"Takk for hjelpen.","zh":"谢谢你的帮助。","words":[[0,4,41.29,41.655,"takk"],[5,8,41.77,41.942,"for"],[9,16,41.942,42.355,"hjelpen"]]},{"id":14,"start":43.11,"end":44.635,"speaker":"Pharmacist","text":"Adjø, og god bedring.","zh":"再见，祝你早日康复。","words":[[0,4,43.11,43.415,"adjø"],[6,8,43.77,43.895,"og"],[9,12,43.91,44.175,"god"],[13,20,44.19,44.635,"bedring"]]}],"lexicon":{"adjø":{"lemma":"adjø","zh":"再见","pos":"感叹词","ref":"ty-conversation-5-001","clip":null},"allergisk":{"lemma":"allergisk","zh":"过敏的","pos":"形容词","ref":"ty-conversation-5-002","clip":null},"bedring":{"lemma":"bedring","zh":"康复（god bedring：祝早日康复）","pos":"名词","ref":null,"clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"diaré":{"lemma":"diaré","zh":"腹泻","pos":"名词","ref":"ty-conversation-5-006","clip":null},"drikke":{"lemma":"drikke","zh":"喝","pos":"动词","ref":"ty-conversation-5-007","clip":null,"form":"不定式"},"du":{"lemma":"du","zh":"你","pos":"代词","ref":"ty-conversation-1-003","clip":null,"form":"主格"},"en":{"lemma":"en","zh":"一个（用于通性名词）","pos":"不定冠词","ref":"ty-conversation-4-005","clip":null,"form":"通性"},"er":{"lemma":"være","zh":"是；处于某种状态","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时"},"er@ty-be-state":{"lemma":"være","zh":"处于（饥饿、生病、度假等状态）","pos":"动词","ref":"ty-conversation-1-004","clip":null,"form":"现在时","contextual":true,"baseKey":"er","surface":"er"},"feber":{"lemma":"feber","zh":"发烧","pos":"名词","ref":"ty-conversation-5-008","clip":null},"for":{"lemma":"for","zh":"为（takk for …：为……致谢）","pos":"介词","ref":"ty-conversation-5-011","clip":null},"føler":{"lemma":"føle","zh":"感觉；感到","pos":"动词","ref":"ty-conversation-5-010","clip":null,"form":"现在时"},"god":{"lemma":"god","zh":"好的","pos":"形容词","ref":"ty-conversation-4-011","clip":null},"har":{"lemma":"ha","zh":"有；拥有","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时"},"har@ty-handover":{"lemma":"ha","zh":"（Her har du …）给你……","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时","contextual":true,"baseKey":"har","surface":"har"},"har@ty-symptom":{"lemma":"ha","zh":"有（某种身体症状）","pos":"动词","ref":"ty-conversation-1-008","clip":null,"form":"现在时","contextual":true,"baseKey":"har","surface":"har"},"hei":{"lemma":"hei","zh":"你好","pos":"感叹词","ref":"ty-conversation-1-009","clip":null},"her":{"lemma":"her","zh":"这里","pos":"副词","ref":"ty-conversation-1-010","clip":null},"hjelpe":{"lemma":"hjelpe","zh":"帮助","pos":"动词","ref":"ty-conversation-5-015","clip":null,"form":"不定式"},"hjelpen":{"lemma":"hjelp","zh":"帮助","pos":"名词","ref":"ty-conversation-5-014","clip":null,"form":"单数定指"},"hodepine":{"lemma":"hodepine","zh":"头痛","pos":"名词","ref":"ty-conversation-5-016","clip":null},"ikke":{"lemma":"ikke","zh":"不；没有","pos":"副词","ref":"ty-conversation-1-016","clip":null},"jeg":{"lemma":"jeg","zh":"我","pos":"代词","ref":"ty-conversation-1-018","clip":null,"form":"主格"},"kan":{"lemma":"kunne","zh":"能；可以","pos":"情态动词","ref":"ty-conversation-4-015","clip":null,"form":"现在时"},"kaster":{"lemma":"kaste","zh":"（kaste opp）呕吐","pos":"动词","ref":null,"clip":null,"form":"现在时"},"koster":{"lemma":"koste","zh":"价格为；要（多少钱）","pos":"动词","ref":"ty-conversation-5-018","clip":null,"form":"现在时"},"kroner":{"lemma":"krone","zh":"克朗（挪威货币）","pos":"名词","ref":"ty-conversation-5-019","clip":null,"form":"复数不定"},"medisin":{"lemma":"medisin","zh":"药","pos":"名词","ref":"ty-conversation-5-021","clip":null},"medisinen":{"lemma":"medisin","zh":"药","pos":"名词","ref":"ty-conversation-5-021","clip":null,"form":"单数定指"},"meg":{"lemma":"jeg","zh":"我自己（føle meg：感到）","pos":"代词","ref":"ty-conversation-4-021","clip":null,"form":"反身用法"},"men":{"lemma":"men","zh":"但是","pos":"连词","ref":"ty-conversation-8-017","clip":null},"må":{"lemma":"måtte","zh":"必须；得","pos":"情态动词","ref":"ty-conversation-4-020","clip":null,"form":"现在时"},"nei":{"lemma":"nei","zh":"不；不是","pos":"感叹词","ref":"ty-conversation-1-020","clip":null},"og":{"lemma":"og","zh":"和；（Og du?）那你呢","pos":"连词","ref":"ty-conversation-1-021","clip":null},"opp":{"lemma":"opp","zh":"（kaste opp）呕吐中的副词，无须单译","pos":"副词","ref":null,"clip":null},"syk":{"lemma":"syk","zh":"生病的；不舒服的","pos":"形容词","ref":"ty-conversation-5-033","clip":null},"takk":{"lemma":"takk","zh":"谢谢","pos":"感叹词","ref":"ty-conversation-3-018","clip":null},"tjuetre":{"lemma":"tjuetre","zh":"二十三","pos":"数词","ref":null,"clip":null},"vann":{"lemma":"vann","zh":"水","pos":"名词","ref":"ty-conversation-5-034","clip":null}}}
