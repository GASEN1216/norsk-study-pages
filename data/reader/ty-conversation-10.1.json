{"id":"ty-conversation-10.1","bookId":"ty-conversation-guide","readingId":"10.1","title":"Going by tram","audio":"audio/ty-conversation/10.1.mp3","duration":49.893878,"synthetic":false,"sentences":[{"id":0,"start":23.31,"end":25.015,"speaker":"Olav","text":"Jeg liker å reise med trikken.","zh":"我喜欢坐有轨电车。","words":[[0,3,23.31,23.495,"jeg"],[4,9,23.55,24.015,"liker"],[10,11,24.03,24.133,"å"],[12,17,24.133,24.472,"reise"],[18,21,24.472,24.602,"med@ty-with-vehicle"],[22,29,24.602,25.015,"trikken"]]},{"id":1,"start":25.45,"end":26.055,"speaker":"Eva","text":"Jeg også.","zh":"我也是。","words":[[0,3,25.45,25.675,"jeg"],[4,8,25.73,26.055,"også"]]},{"id":2,"start":26.77,"end":28.935,"speaker":"Olav","text":"Det er mange pene hus og hager her.","zh":"这里有很多漂亮的房子和花园。","words":[[0,3,26.77,26.913,"det@ty-det-existential"],[4,6,26.913,27.035,"er@ty-be-existential"],[7,12,27.05,27.395,"mange"],[13,17,27.41,27.755,"pene"],[18,21,27.77,28.152,"hus"],[22,24,28.152,28.295,"og"],[25,30,28.35,28.733,"hager"],[31,34,28.733,28.935,"her"]]},{"id":3,"start":29.71,"end":31.515,"speaker":"Eva","text":"Ja, og vi har fint vær også.","zh":"是啊，而且天气也很好。","words":[[0,2,29.71,29.875,"ja"],[4,6,30.33,30.432,"og"],[7,9,30.432,30.532,"vi"],[10,13,30.532,30.675,"har@ty-have-weather"],[14,18,30.69,31.023,"fint@ty-fint-weather"],[19,22,31.023,31.223,"vær"],[23,27,31.223,31.515,"også"]]},{"id":4,"start":32.15,"end":33.295,"speaker":"Olav","text":"Se på utsikten nå!","zh":"快看外面的风景！","words":[[0,2,32.15,32.335,"se@ty-see-view-command"],[3,5,32.47,32.595,"på@ty-on-watch-object"],[6,14,32.61,33.155,"utsikten"],[15,17,33.17,33.295,"nå"]]},{"id":5,"start":34.21,"end":35.395,"speaker":"Eva","text":"Vi kan se fjorden.","zh":"我们能看到峡湾。","words":[[0,2,34.21,34.332,"vi"],[3,6,34.332,34.515,"kan"],[7,9,34.59,34.755,"se@ty-see-view"],[10,17,34.93,35.395,"fjorden"]]},{"id":6,"start":35.85,"end":38.695,"speaker":"Olav","text":"Jeg liker å snakke med deg, Eva. Jeg liker deg.","zh":"伊娃，我喜欢和你聊天。我喜欢你。","words":[[0,3,35.85,36.032,"jeg"],[4,9,36.032,36.373,"liker"],[10,11,36.373,36.472,"å"],[12,18,36.472,36.782,"snakke"],[19,22,36.782,36.903,"med@ty-with-person"],[23,26,36.903,37.055,"deg"],[28,31,37.09,37.315,"eva"],[33,36,38.07,38.233,"jeg"],[37,42,38.233,38.543,"liker"],[43,46,38.543,38.695,"deg"]]},{"id":7,"start":39.21,"end":40.835,"speaker":"Eva","text":"Jeg liker deg også, Olav.","zh":"奥拉夫，我也喜欢你。","words":[[0,3,39.21,39.375,"jeg"],[4,9,39.39,39.672,"liker"],[10,13,39.672,39.835,"deg"],[14,18,39.85,40.155,"også"],[20,24,40.51,40.835,"olav"]]},{"id":8,"start":41.51,"end":42.835,"speaker":"Olav","text":"Jeg vil gjerne treffe deg igjen.","zh":"我想再见到你。","words":[[0,3,41.51,41.653,"jeg"],[4,7,41.653,41.763,"vil"],[8,14,41.763,42.075,"gjerne"],[15,21,42.15,42.463,"treffe"],[22,25,42.463,42.603,"deg"],[26,31,42.603,42.835,"igjen"]]},{"id":9,"start":43.71,"end":44.095,"speaker":"Eva","text":"Kanskje.","zh":"也许吧。","words":[[0,7,43.71,44.095,"kanskje"]]},{"id":10,"start":44.69,"end":45.915,"speaker":"Olav","text":"Vi skal gå av trikken her.","zh":"我们在这里下车。","words":[[0,2,44.69,44.793,"vi"],[3,7,44.793,44.975,"skal"],[8,10,45.07,45.195,"gå"],[11,13,45.23,45.382,"av"],[14,21,45.382,45.722,"trikken"],[22,25,45.722,45.915,"her"]]},{"id":11,"start":46.71,"end":48.075,"speaker":"Olav","text":"Dette er Holmenkollen.","zh":"这里是霍尔门科伦。","words":[[0,5,46.71,47.075,"dette@ty-dette-place"],[6,8,47.09,47.295,"er@ty-be-identity"],[9,21,47.41,48.075,"holmenkollen"]]}],"lexicon":{"av":{"lemma":"av","zh":"从……下来（gå av：下车）","pos":"介词","ref":"ty-conversation-11-080","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-existential":{"lemma":"det","zh":"形式主语（det er：有；本词不单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conve