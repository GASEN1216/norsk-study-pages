{"id":"ty-conversation-10.1","bookId":"ty-conversation-guide","readingId":"10.1","title":"Going by tram","audio":"audio/ty-conversation/10.1.mp3","duration":49.893878,"synthetic":false,"sentences":[{"id":0,"start":22.86,"end":25.22,"speaker":"Olav","text":"Jeg liker å reise med trikken.","zh":"我喜欢坐有轨电车。","words":[[0,3,22.86,23.54,"jeg"],[4,9,23.54,24.1,"liker"],[10,11,24.1,24.2,"å"],[12,17,24.2,24.5,"reise"],[18,21,24.5,24.68,"med@ty-with-vehicle"],[22,29,24.68,25.22,"trikken"]]},{"id":1,"start":25.58,"end":26.06,"speaker":"Eva","text":"Jeg også.","zh":"我也是。","words":[[0,3,25.58,25.74,"jeg"],[4,8,25.74,26.06,"også"]]},{"id":2,"start":26.64,"end":28.92,"speaker":"Olav","text":"Det er mange pene hus og hager her.","zh":"这里有很多漂亮的房子和花园。","words":[[0,3,26.64,26.92,"det@ty-det-existential"],[4,6,26.92,26.98,"er@ty-be-existential"],[7,12,26.98,27.28,"mange"],[13,17,27.28,27.72,"pene"],[18,21,27.72,28.04,"hus"],[22,24,28.04,28.32,"og"],[25,30,28.32,28.7,"hager"],[31,34,28.7,28.92,"her"]]},{"id":3,"start":29.58,"end":31.5,"speaker":"Eva","text":"Ja, og vi har fint vær også.","zh":"是啊，而且天气也很好。","words":[[0,2,29.58,29.94,"ja"],[4,6,30.14,30.42,"og"],[7,9,30.42,30.54,"vi"],[10,13,30.54,30.64,"har@ty-have-weather"],[14,18,30.64,30.96,"fint@ty-fint-weather"],[19,22,30.96,31.18,"vær"],[23,27,31.18,31.5,"også"]]},{"id":4,"start":32.0,"end":33.36,"speaker":"Olav","text":"Se på utsikten nå!","zh":"快看外面的风景！","words":[[0,2,32.0,32.4,"se@ty-see-view-command"],[3,5,32.4,32.58,"på@ty-on-watch-object"],[6,14,32.58,33.12,"utsikten"],[15,17,33.12,33.36,"nå"]]},{"id":5,"start":34.04,"end":35.32,"speaker":"Eva","text":"Vi kan se fjorden.","zh":"我们能看到峡湾。","words":[[0,2,34.04,34.34,"vi"],[3,6,34.34,34.5,"kan"],[7,9,34.5,34.8,"se@ty-see-view"],[10,17,34.8,35.32,"fjorden"]]},{"id":6,"start":35.76,"end":38.7,"speaker":"Olav","text":"Jeg liker å snakke med deg, Eva. Jeg liker deg.","zh":"伊娃，我喜欢和你聊天。我喜欢你。","words":[[0,3,35.76,36.02,"jeg"],[4,9,36.02,36.32,"liker"],[10,11,36.32,36.48,"å"],[12,18,36.48,36.76,"snakke"],[19,22,36.76,36.88,"med@ty-with-person"],[23,26,36.88,37.06,"deg"],[28,31,37.08,37.32,"eva"],[33,36,37.86,38.22,"jeg"],[37,42,38.22,38.52,"liker"],[43,46,38.52,38.7,"deg"]]},{"id":7,"start":39.04,"end":40.8,"speaker":"Eva","text":"Jeg liker deg også, Olav.","zh":"奥拉夫，我也喜欢你。","words":[[0,3,39.04,39.38,"jeg"],[4,9,39.38,39.64,"liker"],[10,13,39.64,39.82,"deg"],[14,18,39.82,40.12,"også"],[20,24,40.44,40.8,"olav"]]},{"id":8,"start":40.9,"end":42.92,"speaker":"Olav","text":"Jeg vil gjerne treffe deg igjen.","zh":"我想再见到你。","words":[[0,3,40.9,41.64,"jeg"],[4,7,41.64,41.82,"vil"],[8,14,41.82,42.2,"gjerne"],[15,21,42.2,42.5,"treffe"],[22,25,42.5,42.64,"deg"],[26,31,42.64,42.92,"igjen"]]},{"id":9,"start":43.5,"end":44.1,"speaker":"Eva","text":"Kanskje.","zh":"也许吧。","words":[[0,7,43.5,44.1,"kanskje"]]},{"id":10,"start":44.46,"end":45.9,"speaker":"Olav","text":"Vi skal gå av trikken her.","zh":"我们在这里下车。","words":[[0,2,44.46,44.8,"vi"],[3,7,44.8,44.94,"skal"],[8,10,44.94,45.24,"gå"],[11,13,45.24,45.36,"av"],[14,21,45.38,45.7,"trikken"],[22,25,45.7,45.9,"her"]]},{"id":11,"start":46.62,"end":48.0,"speaker":"Olav","text":"Dette er Holmenkollen.","zh":"这里是霍尔门科伦。","words":[[0,5,46.62,47.0,"dette@ty-dette-place"],[6,8,47.0,47.3,"er@ty-be-identity"],[9,21,47.3,48.0,"holmenkollen"]]}],"lexicon":{"av":{"lemma":"av","zh":"从……下来（gå av：下车）","pos":"介词","ref":"ty-conversation-11-080","clip":null},"deg":{"lemma":"du","zh":"你（宾格）","pos":"代词","ref":"ty-conversation-2-001","clip":null,"form":"宾格"},"det":{"lemma":"det","zh":"这；它","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性"},"det@ty-det-existential":{"lemma":"det","zh":"形式主语（det er：有；本词不单译）","pos":"代词","ref":"ty-conversation-2-002","clip":null,"form":"中性","contextual":true,"baseKey":"det","surface":"det"},"dette":{"lemma":"dette","zh":"这；这个","pos":"指示代词","ref":"ty-conversation-8-003","clip":null,"form":"中性"},"dette@ty-dette-place":{"lemma":"dette","zh":"这里（指刚到达的地点）","pos":"指示代词","ref":"ty-conversation-8-003","c