feranser: Navn, e-postadresse, telefonnummer og stilling til personer som arbeidsgiveren kan ta kontakt med for å få vite mer om deg.","zh":"推荐人：雇主可以联系以进一步了解你的人员的姓名、电子邮箱、电话号码和职位。","words":[[0,10,174.544,175.429,"referanser"],[12,16,176.644,177.029,"navn"],[18,31,177.824,178.589,"e-postadresse"],[33,46,179.364,180.229,"telefonnummer"],[47,49,180.784,180.929,"og"],[50,58,180.984,181.466,"stilling@pa-vei-extra-100"],[59,62,181.466,181.629,"til"],[63,71,181.644,182.207,"personer"],[72,75,182.207,182.389,"som"],[76,90,182.464,183.406,"arbeidsgiveren"],[91,94,183.406,183.577,"kan"],[95,97,183.577,183.707,"ta@pa-vei-extra-101"],[98,105,183.707,184.186,"kontakt"],[106,109,184.186,184.349,"med"],[110,113,184.444,184.587,"for"],[114,115,184.587,184.656,"å"],[116,118,184.656,184.769,"få"],[119,123,184.804,185.149,"vite"],[124,127,185.224,185.546,"mer"],[128,130,185.546,185.666,"om"],[131,134,185.666,185.809,"deg"]]},{"id":25,"start":187.324,"end":192.309,"text":"Før du skriver noen opp som referanse, må du spørre dem om det er i orden.","zh":"把某人列为推荐人之前，必须先征得对方同意。","words":[[0,3,187.324,187.587,"før"],[4,6,187.587,187.709,"du"],[7,14,187.744,188.189,"skriver"],[15,19,188.264,188.629,"noen"],[20,23,188.664,188.887,"opp"],[24,27,188.887,189.049,"som"],[28,37,189.064,189.729,"referanse"],[39,41,190.264,190.389,"må"],[42,44,190.404,190.529,"du"],[45,51,190.624,191.069,"spørre"],[52,55,191.084,191.269,"dem"],[56,58,191.364,191.507,"om"],[59,62,191.507,191.656,"det"],[63,65,191.656,191.827,"er"],[66,67,191.827,191.929,"i"],[68,73,191.964,192.309,"orden"]]},{"id":26,"start":196.744,"end":197.789,"text":"Per får ny jobb","zh":"佩尔找到新工作","words":[[0,3,196.744,197.069,"per@pa-vei-per-name"],[4,7,197.104,197.267,"får"],[8,10,197.267,197.389,"ny"],[11,15,197.504,197.789,"jobb"]]},{"id":27,"start":199.384,"end":201.949,"text":"Du får jobben, og du kan begynne på mandag.","zh":"你被录用了，星期一就可以开始上班。","words":[[0,2,199.384,199.529,"du"],[3,6,199.644,199.846,"får"],[7,13,199.846,200.169,"jobben"],