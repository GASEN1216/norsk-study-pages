{"id":"pa-vei-15.D","bookId":"pa-vei-textbook","readingId":"15.D","title":"Hvordan finner du jobb?","audio":"audio/pa-vei/15.D.mp3","duration":222.12,"synthetic":false,"audioLabel":"教材配套朗读","sentences":[{"id":0,"start":1.1,"end":3.905,"text":"Nå har Pablo heldigvis fått seg en jobb.","zh":"幸运的是，巴勃罗现在已经找到了一份工作。","words":[[0,2,1.1,1.225,"nå"],[3,6,1.42,1.705,"har"],[7,12,1.78,2.265,"pablo"],[13,22,2.4,3.083,"heldigvis"],[23,27,3.083,3.312,"fått@pa-vei-extra-94"],[28,31,3.312,3.485,"seg"],[32,34,3.52,3.652,"en"],[35,39,3.652,3.905,"jobb"]]},{"id":1,"start":5.18,"end":7.805,"text":"Han fikk tips om en ledig jobb gjennom en venn.","zh":"他通过一位朋友得知了一个职位空缺。","words":[[0,3,5.18,5.345,"han"],[4,8,5.38,5.582,"fikk"],[9,13,5.582,5.912,"tips"],[14,16,5.912,6.013,"om"],[17,19,6.013,6.145,"en"],[20,25,6.16,6.532,"ledig"],[26,30,6.532,6.805,"jobb"],[31,38,7.04,7.353,"gjennom@pa-vei-extra-89"],[39,41,7.353,7.485,"en"],[42,46,7.5,7.805,"venn"]]},{"id":2,"start":9.04,"end":11.605,"text":"Det er mange som skaffer seg arbeid på den måten.","zh":"许多人都是这样找到工作的。","words":[[0,3,9.04,9.182,"det"],[4,6,9.182,9.305,"er"],[7,12,9.34,9.665,"mange"],[13,16,9.68,9.843,"som"],[17,24,9.843,10.152,"skaffer"],[25,28,10.152,10.325,"seg"],[29,35,10.4,10.845,"arbeid"],[36,38,10.86,10.985,"på"],[39,42,11.0,11.185,"den@pa-vei-den-definite"],[43,48,11.22,11.605,"måten"]]},{"id":3,"start":13.564,"end":18.709,"text":"Safer har tatt kontakt med et vikarbyrå og håper de har en jobb som passer for ham.","zh":"萨费尔联系了一家临时工作中介，希望他们有适合他的工作。","words":[[0,5,13.564,14.089,"safer"],[6,9,14.264,14.416,"har"],[10,14,14.416,14.636,"tatt@pa-vei-extra-95"],[15,22,14.636,15.076,"kontakt"],[23,26,15.076,15.207,"med"],[27,29,15.207,15.337,"et"],[30,39,15.337,15.989,"vikarbyrå"],[40,42,16.484,16.627,"og"],[43,48,16.627,17.017,"håper"],[49,51,17.017,17.129,"de"],[52,55,17.184,17.377,"har"],[56,58,17.377,17.507,"en"],[59,63,17.507,17.789,"jobb"],[64,67,17.824,17.969,"som"],[68,74,17.984,18.349,"passer"],[75,78,18.364,18.526,"for"],[79,82,18.526,18.709,"ham"]]},{"id":4,"start":20.244,"end":24.649,"text":"Gjennom et vikarbyrå kan du få arbeid for kortere eller lengre tid.","zh":"通过临时工作中介，你可以获得短期或较长期的工作。","words":[[0,7,20.244,20.556,"gjennom@pa-vei-extra-88"],[8,10,20.556,20.716,"et"],[11,20,20.716,21.369,"vikarbyrå"],[21,24,21.484,21.657,"kan"],[25,27,21.657,21.769,"du"],[28,30,21.784,21.929,"få"],[31,37,22.044,22.549,"arbeid"],[38,41,22.604,22.809,"for"],[42,49,22.904,23.429,"kortere"],[50,55,23.564,23.869,"eller"],[56,62,23.924,24.329,"lengre"],[63,66,24.344,24.649,"tid"]]},{"id":5,"start":25.864,"end":29.549,"text":"Du sender inn en cv og forteller om dine kvalifikasjoner.","zh":"你提交简历，介绍自己的资历。","words":[[0,2,25.864,26.009,"du"],[3,9,26.064,26.396,"sender@pa-vei-extra-87"],[10,13,26.396,26.576,"inn"],[14,16,26.576,26.709,"en"],[17,19,26.744,27.089,"cv"],[20,22,27.544,27.666,"og"],[23,32,27.666,28.149,"forteller"],[33,35,28.164,28.289,"om"],[36,40,28.304,28.549,"dine"],[41,56,28.564,29.549,"kvalifikasjoner"]]},{"id":6,"start":30.984,"end":34.789,"text":"Deretter undersøker vikarbyrået om de har arbeid som passer.","zh":"然后中介会查看是否有适合你的工作。","words":[[0,8,30.984,31.469,"deretter"],[9,19,31.544,32.209,"undersøker@pa-vei-extra-86"],[20,31,32.224,33.049,"vikarbyrået"],[32,34,33.184,33.296,"om@pa-vei-om-whether"],[35,37,33.296,33.429,"de"],[38,41,33.444,33.649,"har"],[42,48,33.724,34.209,"arbeid"],[49,52,34.244,34.407,"som"],[53,59,34.407,34.789,"passer"]]},{"id":7,"start":37.104,"end":41.369,"text":"Andre måter å finne jobb på er å lese annonser for ledige stillinger.","zh":"另一种找工作的方法是阅读招聘广告。","words":[[0,5,37.104,37.447,"andre"],[6,11,37.447,37.806,"måter"],[12,13,37.806,37.907,"å"],[14,19,37.907,38.186,"finne"],[20,24,38.186,38.447,"jobb"],[25,27,38.447,38.589,"på"],[28,30,38.904,39.037,"er"],[31,32,39.037,39.117,"å"],[33,37,39.117,39.449,"lese"],[38,46,39.484,40.129,"annonser"],[47,50,40.164,40.369,"for"],[51,57,40.404,40.889,"ledige"],[58,68,40.904,41.369,"stillinger@pa-vei-extra-85"]]},{"id":8,"start":42.624,"end":47.329,"text":"Slike annonser finner du på nettet, i avisene og hos NAV.","zh":"你可以在网上、报纸上和 NAV 找到这类广告。","words":[[0,5,42.624,43.069,"slike"],[6,14,43.084,43.649,"annonser"],[15,21,43.704,43.986,"finner"],[22,24,43.986,44.109,"du"],[25,27,44.224,44.369,"på"],[28,34,44.404,44.849,"nettet"],[36,37,45.284,45.389,"i"],[38,45,45.424,46.049,"avisene"],[46,48,46.484,46.629,"og"],[49,52,46.644,46.889,"hos"],[53,56,46.944,47.329,"nav"]]},{"id":9,"start":49.044,"end":55.529,"text":"NAV er en offentlig tjeneste som kan hjelpe deg med å søke jobb og med å bedre kvalifikasjonene dine.","zh":"NAV 是一项公共服务，可以帮助你找工作、提高职业技能。","words":[[0,3,49.044,49.449,"nav"],[4,6,49.484,49.656,"er"],[7,9,49.656,49.789,"en"],[10,19,49.844,50.397,"offentlig"],[20,28,50.397,50.929,"tjeneste"],[29,32,51.064,51.246,"som"],[33,36,51.246,51.407,"kan"],[37,43,51.407,51.757,"hjelpe"],[44,47,51.757,51.889,"deg"],[48,51,51.964,52.117,"med"],[52,53,52.117,52.209,"å"],[54,58,52.264,52.629,"søke"],[59,63,52.644,52.949,"jobb"],[64,66,53.384,53.516,"og"],[67,70,53.516,53.677,"med"],[71,72,53.677,53.769,"å"],[73,78,53.824,54.269,"bedre@pa-vei-extra-93"],[79,95,54.284,55.267,"kvalifikasjonene"],[96,100,55.267,55.529,"dine"]]},{"id":10,"start":57.464,"end":62.289,"text":"Hvis du finner en jobb som passer, må du sende inn en søknad og en cv.","zh":"如果找到合适的工作，你需要提交求职申请和简历。","words":[[0,4,57.464,57.746,"hvis"],[5,7,57.746,57.869,"du"],[8,14,57.904,58.227,"finner"],[15,17,58.227,58.346,"en"],[18,22,58.346,58.609,"jobb"],[23,26,58.644,58.809,"som"],[27,33,58.884,59.309,"passer"],[35,37,59.884,60.009,"må"],[38,40,60.024,60.169,"du"],[41,46,60.204,60.496,"sende@pa-vei-extra-90"],[47,50,60.496,60.689,"inn"],[51,53,60.704,60.849,"en"],[54,60,60.884,61.569,"søknad@pa-vei-extra-91"],[61,63,61.624,61.767,"og"],[64,66,61.767,61.909,"en"],[67,69,61.964,62.289,"cv"]]},{"id":11,"start":63.544,"end":66.089,"text":"I søknaden forteller du kort om deg selv.","zh":"在申请中，你要简要介绍自己。","words":[[0,1,63.544,63.649,"i"],[2,10,63.704,64.389,"søknaden@pa-vei-extra-92"],[11,20,64.504,64.936,"forteller"],[21,23,64.936,65.049,"du"],[24,28,65.124,65.469,"kort@pa-vei-kort-briefly"],[29,31,65.504,65.626,"om"],[32,35,65.626,65.769,"deg"],[36,40,65.824,66.089,"selv"]]},{"id":12,"start":67.204,"end":70.709,"text":"Du forteller også hvorfor du tror du passer til denne jobben.","zh":"还要说明为什么认为自己适合这份工作。","words":[[0,2,67.204,67.329,"du"],[3,12,67.384,67.837,"forteller"],[13,17,67.837,68.109,"også"],[18,25,68.244,68.729,"hvorfor"],[26,28,68.784,68.909,"du"],[29,33,68.944,69.226,"tror"],[34,36,69.226,69.369,"du"],[37,43,69.484,69.949,"passer"],[44,47,69.984,70.147,"til"],[48,53,70.147,70.376,"denne"],[54,60,70.376,70.709,"jobben"]]},{"id":13,"start":72.504,"end":76.309,"text":"Søknaden skal være kort, ikke mer enn én side.","zh":"求职申请要简短，不超过一页。","words":[[0,8,72.504,73.169,"søknaden@pa-vei-extra-96"],[9,13,73.224,73.449,"skal"],[14,18,73.464,73.729,"være"],[19,23,73.784,74.169,"kort@pa-vei-kort-short"],[25,29,74.844,75.129,"ikke"],[30,33,75.144,75.356,"mer"],[34,37,75.356,75.549,"enn"],[38,40,75.644,75.929,"én"],[41,45,76.004,76.309,"side"]]},{"id":14,"start":77.964,"end":82.009,"text":"Opplysninger om utdanning og erfaring skal stå i cv-en.","zh":"教育和工作经历应写在简历里。","words":[[0,12,77.964,78.769,"opplysninger"],[13,15,78.884,79.009,"om"],[16,25,79.124,79.726,"utdanning"],[26,28,79.726,79.856,"og"],[29,37,79.856,80.429,"erfaring"],[38,42,80.904,81.109,"skal"],[43,46,81.184,81.369,"stå"],[47,48,81.444,81.549,"i"],[49,54,81.564,82.009,"cv-en"]]},{"id":15,"start":90.284,"end":92.409,"text":"Overskrift: CV","zh":"标题：简历","words":[[0,10,90.284,90.909,"overskrift"],[12,14,91.984,92.409,"cv"]]},{"id":16,"start":94.12,"end":106.145,"text":"Personalia: Navn, adresse, e-postadresse, telefonnummer, alder, nasjonalitet, sivilstand.","zh":"个人资料：姓名、地址、电子邮箱、电话号码、年龄、国籍、婚姻状况。","words":[[0,10,94.12,94.905,"personalia"],[12,16,96.1,96.525,"navn"],[18,25,97.52,98.105,"adresse"],[27,40,99.22,99.985,"e-postadresse"],[42,55,100.86,101.905,"telefonnummer"],[57,62,102.62,103.065,"alder"],[64,76,103.66,104.605,"nasjonalitet"],[78,88,105.32,106.145,"sivilstand"]]},{"id":17,"start":108.024,"end":116.109,"text":"Utdannelse: Hvor? Når? Hvor lenge? Begynn med den siste utdannelsen.","zh":"教育经历：在哪里？什么时候？多长时间？从最近的教育经历开始写。","words":[[0,10,108.024,108.669,"utdannelse"],[12,16,109.644,109.989,"hvor"],[18,21,110.744,111.129,"når"],[23,27,111.944,112.189,"hvor"],[28,33,112.204,112.629,"lenge"],[35,41,113.824,114.367,"begynn"],[42,45,114.367,114.507,"med"],[46,49,114.507,114.649,"den@pa-vei-den-definite"],[50,55,114.744,115.289,"siste@pa-vei-extra-105"],[56,67,115.544,116.109,"utdannelsen"]]},{"id":18,"start":118.084,"end":129.189,"text":"Arbeidserfaring: Hvor? Når? Hvor lenge? Hva gjorde du? Begynn med den siste jobben.","zh":"工作经历：在哪里？什么时候？多长时间？做什么工作？从最近的一份工作开始写。","words":[[0,15,118.084,119.329,"arbeidserfaring"],[17,21,120.344,120.589,"hvor"],[23,26,121.664,121.929,"når"],[28,32,122.844,123.089,"hvor"],[33,38,123.164,123.569,"lenge"],[40,43,125.004,125.209,"hva"],[44,50,125.384,125.707,"gjorde"],[51,53,125.707,125.829,"du"],[55,61,127.244,127.776,"begynn"],[62,65,127.776,127.887,"med"],[66,69,127.887,128.049,"den@pa-vei-den-definite"],[70,75,128.164,128.769,"siste@pa-vei-extra-98"],[76,82,128.804,129.189,"jobben"]]},{"id":19,"start":130.84,"end":142.005,"text":"Kurs: Hvor? Når? Hvor lenge? Hvem arrangerte kurset? Skriv siste kurs først.","zh":"培训课程：在哪里？什么时候？多长时间？由谁举办？先写最近的课程。","words":[[0,4,130.84,131.165,"kurs"],[6,10,132.74,133.045,"hvor"],[12,15,134.16,134.465,"når"],[17,21,135.48,135.725,"hvor"],[22,27,135.78,136.145,"lenge"],[29,33,137.26,137.485,"hvem"],[34,44,137.6,138.405,"arrangerte"],[45,51,138.42,138.805,"kurset"],[53,58,140.14,140.485,"skriv"],[59,64,140.6,141.105,"siste@pa-vei-extra-99"],[65,69,141.14,141.485,"kurs"],[70,75,141.6,142.005,"først"]]},{"id":20,"start":144.004,"end":152.529,"text":"Språk: Hvilke språk kan du flytende, meget godt eller godt, skriftlig og muntlig?","zh":"语言：