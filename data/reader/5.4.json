{"id":"5.4","title":"Hvilken dato er det?","audio":"audio/5.4.mp3","duration":118.44,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.18,"text":"5.4 Hvilken dato er det?","heading":true,"zh":"5.4 今天几号？","words":[[0,3,0.15,1.36,"5.4"],[4,11,2.5,3.08,"hvilken"],[12,16,3.08,3.44,"dato"],[17,19,3.44,3.8,"er"],[20,23,3.8,4.1,"det"]]},{"id":1,"start":6.36,"end":8.68,"text":"Hvilken dato er det i dag?","speaker":"Håvard","zh":"今天是几号？","words":[[0,7,6.42,7.02,"hvilken"],[8,12,7.02,7.82,"dato"],[13,15,7.82,7.94,"er"],[16,19,7.94,8.12,"det"],[20,21,8.12,8.2,"i~de136e71704d"],[22,25,8.2,8.53,"dag"]]},{"id":2,"start":10.08,"end":12.88,"text":"I dag er det 27. april.","speaker":"Hawa","zh":"今天是4月27日。","words":[[0,1,10.14,10.34,"i~de136e71704d"],[2,5,10.34,10.92,"dag"],[6,8,10.92,11.12,"er"],[9,12,11.12,11.34,"det"],[13,15,11.34,12.04,"27~a987c5b93290"],[17,22,12.28,12.73,"april"]]},{"id":3,"start":14.27,"end":19.7,"text":"Ja, og det er vår nå. Når har du bursdag, Hawa?","speaker":"Håvard","zh":"对，现在是春天了。哈娃，你什么时候过生日？","words":[[0,2,14.33,14.76,"ja"],[4,6,15.48,15.62,"og"],[7,10,15.62,15.8,"det"],[11,13,15.8,15.98,"er"],[14,17,15.98,16.36,"vår~3d45572832a5"],[18,20,16.36,16.67,"nå~d531d47a7712"],[22,25,17.68,17.9,"når~a56a1c61425b"],[26,29,17.9,18.04,"har"],[30,32,18.04,18.22,"du"],[33,40,18.22,19.08,"bursdag"],[42,46,19.08,19.55,"hawa"]]},{"id":4,"start":21.12,"end":28.74,"text":"Jeg har bursdag om høsten. Jeg er født 18. september. Når er du født, Biniam?","speaker":"Hawa","zh":"我的生日在秋天。我是9月18日出生的。比尼亚姆，你是什么时候出生的？","words":[[0,3,21.18,21.58,"jeg"],[4,7,21.58,21.8,"har"],[8,15,21.8,22.3,"bursdag"],[16,18,22.3,22.46,"om~2fdd1539ca38"],[19,25,22.46,23.13,"høsten"],[27,30,23.84,24.02,"jeg"],[31,33,24.02,24.18,"er"],[34,38,24.18,24.58,"født"],[39,41,24.58,25.1,"18~d403f0808c85"],[43,52,25.1,25.84,"september"],[54,57,26.98,27.18,"når~a56a1c61425b"],[58,60,27.18,27.32,"er"],[61,63,27.32,27.6,"du"],[64,68,27.6,28.12,"født"],[70,76,28.12,28.59,"biniam"]]},{"id":5,"start":30.2,"end":36.7,"text":"Jeg er født 6. januar, og du Håvard, hvilken dato er du født?","speaker":"Biniam","zh":"我是1月6日出生的。霍瓦尔，你呢，你是哪天出生的？","words":[[0,3,30.25,30.74,"jeg"],[4,6,30.74,30.96,"er"],[7,11,30.96,31.42,"født"],[12,13,31.42,31.84,"6~6aadd6a8e55d"],[15,21,31.84,32.53,"januar"],[23,25,33.18,33.32,"og"],[26,28,33.32,33.62,"du"],[29,35,33.62,34.17,"håvard"],[37,44,34.84,35.32,"hvilken"],[45,49,35.32,35.86,"dato"],[50,52,35.86,35.98,"er"],[53,55,35.98,36.2,"du"],[56,60,36.2,36.55,"født"]]},{"id":6,"start":37.62,"end":40.38,"text":"Jeg er født 27. april.","speaker":"Håvard","zh":"我是4月27日出生的。","words":[[0,3,37.69,38.16,"jeg"],[4,6,38.16,38.32,"er"],[7,11,38.32,38.9,"født"],[12,14,38.9,39.59,"27~a987c5b93290"],[16,21,39.76,40.23,"april"]]},{"id":7,"start":41.06,"end":45.49,"text":"27. april? Har du bursdag i dag?","speaker":"Biniam","zh":"4月27日？你今天过生日？","words":[[0,2,41.14,42.16,"27~a987c5b93290"],[4,9,42.16,42.68,"april"],[11,14,43.66,44.0,"har"],[15,17,44.0,44.14,"du"],[18,25,44.14,44.68,"bursdag"],[26,27,44.68,45.0,"i~de136e71704d"],[28,31,45.0,45.41,"dag"]]},{"id":8,"start":46.33,"end":49.54,"text":"Ja, jeg blir 30 år i dag.","speaker":"Håvard","zh":"是的，我今天满30岁。","words":[[0,2,46.39,46.8,"ja"],[4,7,47.66,47.92,"jeg"],[8,12,47.92,48.3,"blir~bbafbd4205d8"],[13,15,48.3,48.84,"30"],[16,18,48.84,49.0,"år~22379c2e8e96"],[19,20,49.0,49.08,"i~de136e71704d"],[21,24,49.08,49.39,"dag"]]},{"id":9,"start":50.29,"end":52.78,"text":"Gratulerer med dagen, Håvard!","speaker":"Biniam","zh":"生日快乐，霍瓦尔！","words":[[0,10,50.35,51.38,"gratulerer"],[11,14,51.38,51.54,"med~b5eef4ece948"],[15,20,51.54,52.12,"dagen~6f52a65147ad"],[22,28,52.12,52.63,"håvard"]]},{"id":10,"start":56.82,"end":60.96,"text":"godinorsk.blogg.no","zh":"godinorsk.blogg.no（博客）","words":[[0,18,56.88,60.81,"godinorsk.blogg.no"]]},{"id":11,"start":64.67,"end":69.06,"text":"I dag er det 27.4., og det er vår.","zh":"今天是4月27日，是春天。","words":[[0,1,64.73,64.94,"i~de136e71704d"],[2,5,64.94,65.5,"dag"],[6,8,65.64,65.82,"er"],[9,12,65.82,66.0,"det"],[13,17,66.0,67.62,"27.4"],[20,22,68.1,68.2,"og"],[23,26,68.2,68.34,"det"],[27,29,68.34,68.54,"er"],[30,33,68.54,68.91,"vår~3d45572832a5"]]},{"id":12,"start":70.0,"end":72.26,"text":"Vi snakker om fødselsdatoer.","zh":"我们在谈论出生日期。","words":[[0,2,70.06,70.3,"vi"],[3,10,70.3,70.74,"snakker"],[11,13,70.74,70.94,"om~52c0bdc828db"],[14,27,70.94,72.11,"fødselsdatoer"]]},{"id":13,"start":73.22,"end":78.99,"text":"Jeg er født 18.9., og Biniam er født 6.1.","zh":"我是9月18日出生的，比尼亚姆是1月6日出生的。","words":[[0,3,73.3,73.64,"jeg"],[4,6,73.64,73.82,"er"],[7,11,73.82,74.1,"født"],[12,16,74.1,76.28,"18.9"],[19,21,76.28,76.36,"og"],[22,28,76.36,76.8,"biniam"],[29,31,76.8,77.18,"er"],[32,36,77.18,77.54,"født"],[37,40,77.54,78.91,"6.1"]]},{"id":14,"start":79.44,"end":81.13,"text":"Han har bursdag om vinteren.","zh":"他的生日在冬天。","words":[[0,3,79.5,79.72,"han"],[4,7,79.72,79.92,"har"],[8,15,79.92,80.36,"bursdag"],[16,18,80.36,80.48,"om~1e753acc270b"],[19,27,80.48,80.98,"vinteren"]]},{"id":15,"start":82.88,"end":84.75,"text":"Håvard har bursdag i dag!","zh":"霍瓦尔今天过生日！","words":[[0,6,82.94,83.56,"håvard"],[7,10,83.56,83.72,"har"],[11,18,83.72,84.12,"bursdag"],[19,20,84.12,84.24,"i~de136e71704d"],[21,24,84.24,84.6,"dag"]]},{"id":16,"start":85.23,"end":88.3,"text":"Vi spiser kake og drikker kaffe i klassen.","zh":"我们在班上吃蛋糕、喝咖啡。","words":[[0,2,85.29,85.48,"vi"],[3,9,85.48,85.9,"spiser"],[10,14,85.9,86.58,"kake"],[15,17,86.74,86.86,"og"],[18,25,86.86,87.22,"drikker~8bc6fe28e25c"],[26,31,87.22,87.6,"kaffe"],[32,33,87.6,87.68,"i"],[34,41,87.68,88.15,"klassen"]]},{"id":17,"start":89.62,"end":90.9,"text":"Hilsen Hawa","zh":"哈娃 敬上","words":[[0,6,89.68,90.32,"hilsen"],[7,11,90.32,90.75,"hawa"]]},{"id":18,"start":92.56,"end":93.65,"text":"Kommentarer","subheading":true,"zh":"评论","words":[[0,11,92.62,93.5,"kommentarer"]]},{"id":19,"start":94.97,"end":97.52,"text":"Håvard er en fantastisk lærer!","zh":"霍瓦尔是一位很棒的老师！","words":[[0,6,95.03,95.72,"håvard"],[7,9,95.72,95.94,"er"],[10,12,95.94,96.12,"en~a939a9e56dc5"],[13,23,96.12,96.88,"fantastisk"],[24,29,96.88,97.37,"lærer~5a8d077d35fc"]]},{"id":20,"start":98.11,"end":100.17,"text":"Klem fra Sompit.","zh":"来自松皮特的拥抱。","words":[[0,4,98.17,98.72,"klem"],[5,8,98.72,99.1,"fra"],[9,15,99.2,100.02,"sompit"]]},{"id":21,"start":101.73,"end":102.89,"text":"Tusen takk!","zh":"非常感谢！","words":[[0,5,101.79,102.34,"tusen"],[6,10,102.34,102.74,"takk"]]},{"id":22,"start":103.08,"end":105.59,"text":"Dere er en veldig hyggelig klasse.","zh":"你们是一个非常可爱的班级。","words":[[0,4,103.14,103.56,"dere"],[5,7,103.56,103.82,"er"],[8,10,103.82,104.02,"en~a939a9e56dc5"],[11,17,104.02,104.5,"veldig"],[18,26,104.5,104.94,"hyggelig"],[27,33,104.94,105.44,"klasse"]]},{"id":23,"start":105.82,"end":107.03,"text":"Hilsen Håvard","zh":"霍瓦尔 敬上","words":[[0,6,105.88,106.42,"hilsen"],[7,13,106.42,106.88,"håvard"]]},{"id":24,"start":108.91,"end":112.78,"text":"Jeg har lyst til å spise mer kake. Smilefjes.","zh":"我还想再吃点蛋糕。（笑脸）","words":[[0,3,108.97,109.3,"jeg"],[4,7,109.3,109.46,"har"],[8,12,109.46,109.72,"lyst~b499524f55a4"],[13,16,109.72,109.86,"til~99ccdd3453b0"],[17,18,109.86,109.96,"å~0583da7a620a"],[19,24,109.96,110.42,"spise"],[25,28,110.42,110.66,"mer~6e9e1ecc8b41"],[29,33,110.66,111.28,"kake"],[35,44,111.84,112.63,"smilefjes"]]},{"id":25,"start":113.32,"end":114.57,"text":"Hilsen Biniam","zh":"比尼亚姆 敬上","words":[[0,6,113.38,113.88,"hilsen"],[7,13,113.88,114.42,"biniam"]]}],"lexicon":{"18":{"lemma":"18","zh":"数字 18","pos":"数词","ref":"basics:numbers:atten","clip":null,"kind":"number"},"18.9":{"lemma":"18.9.","zh":"9 月 18 日","pos":"日期","ref":null,"clip":null,"kind":"number"},"27":{"lemma":"27","zh":"数字 27","pos":"数词","ref":"basics:numbers:tjuesju","clip":null,"kind":"number"},"27.4":{"lemma":"27.4.","zh":"4 月 27 日","pos":"日期","ref":null,"clip":null,"kind":"number"},"30":{"lemma":"30","zh":"数字 30","pos":"数词","ref":"basics:numbers:tretti","clip":null,"kind":"number"},"5.4":{"lemma":"5.4","zh":"第 5.4 节","pos":"编号","ref":null,"clip":null,"kind":"section"