{"id":"5.4","title":"Hvilken dato er det?","audio":"audio/5.4.mp3","duration":118.44,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.18,"text":"5.4 Hvilken dato er det?","heading":true,"zh":"5.4 今天几号？","words":[[0,3,0.15,1.36,"5.4"],[4,11,2.5,3.08,"hvilken"],[12,16,3.08,3.44,"dato"],[17,19,3.44,3.8,"er"],[20,23,3.8,4.1,"det"]]},{"id":1,"start":6.32,"end":8.62,"text":"Hvilken dato er det i dag?","speaker":"Håvard","zh":"今天是几号？","words":[[0,7,6.4,6.92,"hvilken"],[8,12,6.92,7.3,"dato"],[13,15,7.3,7.92,"er"],[16,19,7.92,8.04,"det"],[20,21,8.04,8.16,"i~de136e71704d"],[22,25,8.16,8.54,"dag"]]},{"id":2,"start":9.98,"end":12.83,"text":"I dag er det 27. april.","speaker":"Hawa","zh":"今天是4月27日。","words":[[0,1,10.06,10.33,"i~de136e71704d"],[2,5,10.33,10.63,"dag"],[6,8,10.63,11.07,"er"],[9,12,11.07,11.23,"det"],[13,15,11.23,12.19,"27~a987c5b93290"],[17,22,12.19,12.75,"april"]]},{"id":3,"start":14.23,"end":19.63,"text":"Ja, og det er vår nå. Når har du bursdag, Hawa?","speaker":"Håvard","zh":"对，现在是春天了。哈娃，你什么时候过生日？","words":[[0,2,14.31,14.64,"ja"],[4,6,15.3,15.58,"og"],[7,10,15.58,15.74,"det"],[11,13,15.74,15.88,"er"],[14,17,15.88,16.24,"vår~3d45572832a5"],[18,20,16.24,16.5,"nå~d531d47a7712"],[22,25,17.4,17.84,"når~a56a1c61425b"],[26,29,17.84,18.0,"har"],[30,32,18.0,18.16,"du"],[33,40,18.16,18.74,"bursdag"],[42,46,19.08,19.55,"hawa"]]},{"id":4,"start":21.02,"end":28.69,"text":"Jeg har bursdag om høsten. Jeg er født 18. september. Når er du født, Biniam?","speaker":"Hawa","zh":"我的生日在秋天。我是9月18日出生的。比尼亚姆，你是什么时候出生的？","words":[[0,3,21.1,21.51,"jeg"],[4,7,21.51,21.73,"har"],[8,15,21.73,22.19,"bursdag"],[16,18,22.19,22.41,"om~2fdd1539ca38"],[19,25,22.41,22.85,"høsten"],[27,30,23.57,23.95,"jeg"],[31,33,23.95,24.09,"er"],[34,38,24.09,24.41,"født"],[39,41,24.41,25.07,"18~d403f0808c85"],[43,52,25.07,25.57,"september"],[54,57,26.8,27.12,"når~a56a1c61425b"],[58,60,27.12,27.26,"er"],[61,63,27.26,27.48,"du"],[64,68,27.48,27.84,"født"],[70,76,28.12,28.61,"biniam"]]},{"id":5,"start":30.09,"end":36.66,"text":"Jeg er født 6. januar, og du Håvard, hvilken dato er du født?","speaker":"Biniam","zh":"我是1月6日出生的。霍瓦尔，你呢，你是哪天出生的？","words":[[0,3,30.17,30.62,"jeg"],[4,6,30.62,30.86,"er"],[7,11,30.86,31.22,"født"],[12,13,31.22,31.8,"6~6aadd6a8e55d"],[15,21,31.8,32.28,"januar"],[23,25,33.0,33.28,"og"],[26,28,33.28,33.46,"du"],[29,35,33.58,33.9,"håvard"],[37,44,34.66,35.26,"hvilken"],[45,49,35.26,35.6,"dato"],[50,52,35.6,35.92,"er"],[53,55,35.92,36.12,"du"],[56,60,36.12,36.58,"født"]]},{"id":6,"start":37.59,"end":40.3,"text":"Jeg er født 27. april.","speaker":"Håvard","zh":"我是4月27日出生的。","words":[[0,3,37.67,37.98,"jeg"],[4,6,37.98,38.24,"er"],[7,11,38.24,38.58,"født"],[12,14,38.58,39.68,"27~a987c5b93290"],[16,21,39.68,40.22,"april"]]},{"id":7,"start":41.06,"end":45.49,"text":"27. april? Har du bursdag i dag?","speaker":"Biniam","zh":"4月27日？你今天过生日？","words":[[0,2,41.14,42.16,"27~a987c5b93290"],[4,9,42.16,42.68,"april"],[11,14,43.66,44.0,"har"],[15,17,44.0,44.14,"du"],[18,25,44.14,44.68,"bursdag"],[26,27,44.68,45.0,"i~de136e71704d"],[28,31,45.0,45.41,"dag"]]},{"id":8,"start":45.93,"end":49.51,"text":"Ja, jeg blir 30 år i dag.","speaker":"Håvard","zh":"是的，我今天满30岁。","words":[[0,2,45.96,46.64,"ja"],[4,7,47.46,47.84,"jeg"],[8,12,47.84,48.1,"blir~bbafbd4205d8"],[13,15,48.1,48.7,"30"],[16,18,48.7,48.94,"år~22379c2e8e96"],[19,20,48.94,49.08,"i~de136e71704d"],[21,24,49.08,49.43,"dag"]]},{"id":9,"start":50.25,"end":52.74,"text":"Gratulerer med dagen, Håvard!","speaker":"Biniam","zh":"生日快乐，霍瓦尔！","words":[[0,10,50.33,51.3,"gratulerer"],[11,14,51.3,51.48,"med~b5eef4ece948"],[15,20,51.48,51.9,"dagen~6f52a65147ad"],[22,28,52.1,52.66,"håvard"]]},{"id":10,"start":56.79,"end":62.35,"text":"godinorsk.blogg.no","zh":"godinorsk.blogg.no（博客）","words":[[0,18,56.87,62.27,"godinorsk.blogg.no"]]},{"id":11,"start":64.64,"end":69.0,"text":"I dag er det 27.4., og det er vår.","zh":"今天是4月27日，是春天。","words":[[0,1,64.72,64.88,"i~de136e71704d"],[2,5,64.88,65.2,"dag"],[6,8,65.2,65.78,"er"],[9,12,65.78,65.92,"det"],[13,17,65.92,67.51,"27.4"],[20,22,68.02,68.2,"og"],[23,26,68.2,68.32,"det"],[27,29,68.32,68.44,"er"],[30,33,68.44,68.92,"vår~3d45572832a5"]]},{"id":12,"start":69.97,"end":72.2,"text":"Vi snakker om fødselsdatoer.","zh":"我们在谈论出生日期。","words":[[0,2,70.05,70.25,"vi"],[3,10,70.25,70.63,"snakker"],[11,13,70.63,70.83,"om~52c0bdc828db"],[14,27,70.83,72.12,"fødselsdatoer"]]},{"id":13,"start":73.22,"end":78.99,"text":"Jeg er født 18.9., og Biniam er født 6.1.","zh":"我是9月18日出生的，比尼亚姆是1月6日出生的。","words":[[0,3,73.3,73.64,"jeg"],[4,6,73.64,73.82,"er"],[7,11,73.82,74.1,"født"],[12,16,74.1,76.28,"18.9"],[19,21,76.28,76.36,"og"],[22,28,76.36,76.8,"biniam"],[29,31,76.8,77.18,"er"],[32,36,77.18,77.54,"født"],[37,40,77.54,78.91,"6.1"]]},{"id":14,"start":79.41,"end":81.07,"text":"Han har bursdag om vinteren.","zh":"他的生日在冬天。","words":[[0,3,79.49,79.68,"han"],[4,7,79.68,79.86,"har"],[8,15,79.86,80.26,"bursdag"],[16,18,80.26,80.46,"om~1e753acc270b"],[19,27,80.46,80.99,"vinteren"]]},{"id":15,"start":82.84,"end":84.69,"text":"Håvard har bursdag i dag!","zh":"霍瓦尔今天过生日！","words":[[0,6,82.92,83.41,"håvard"],[7,10,83.41,83.67,"har"],[11,18,83.67,84.03,"bursdag"],[19,20,84.03,84.25,"i~de136e71704d"],[21,24,84.25,84.61,"dag"]]},{"id":16,"start":85.19,"end":88.24,"text":"Vi spiser kake og drikker kaffe i klassen.","zh":"我们在班上吃蛋糕、喝咖啡。","words":[[0,2,85.27,85.45,"vi"],[3,9,85.45,85.81,"spiser"],[10,14,85.81,86.29,"kake"],[15,17,86.29,86.81,"og"],[18,25,86.81,87.13,"drikker~8bc6fe28e25c"],[26,31,87.13,87.53,"kaffe"],[32,33,87.53,87.65,"i"],[34,41,87.65,88.16,"klassen"]]},{"id":17,"start":89.57,"end":90.84,"text":"Hilsen Hawa","zh":"哈娃 敬上","words":[[0,6,89.65,90.1,"hilsen"],[7,11,90.1,90.76,"hawa"]]},{"id":18,"start":92.52,"end":93.59,"text":"Kommentarer","subheading":true,"zh":"评论","words":[[0,11,92.6,93.51,"kommentarer"]]},{"id":19,"start":94.94,"end":97.46,"text":"Håvard er en fantastisk lærer!","zh":"霍瓦尔是一位很棒的老师！","words":[[0,6,95.02,95.55,"håvard"],[7,9,95.55,95.85,"er"],[10,12,95.85,96.09,"en~a939a9e56dc5"],[13,23,96.09,96.81,"fantastisk"],[24,29,96.81,97.38,"lærer~5a8d077d35fc"]]},{"id":20,"start":98.07,"end":100.11,"text":"Klem fra Sompit.","zh":"来自松皮特的拥抱。","words":[[0,4,98.15,98.47,"klem"],[5,8,98.47,98.99,"fra"],[9,15,98.99,100.03,"sompit"]]},{"id":21,"start":101.69,"end":103.08,"text":"Tusen takk!","zh":"非常感谢！","words":[[0,5,101.77,102.27,"tusen"],[6,10,102.45,103.0,"takk"]]},{"id":22,"start":103.08,"end":105.52,"text":"Dere er en veldig hyggelig klasse.","zh":"你们是一个非常可爱的班级。","words":[[0,4,103.12,103.41,"dere"],[5,7,103.41,103.73,"er"],[8,10,103.73,103.95,"en~a939a9e56dc5"],[11,17,103.95,104.43,"veldig"],[18,26,104.43,104.87,"hyggelig"],[27,33,104.87,105.44,"klasse"]]},{"id":23,"start":105.78,"end":106.98,"text":"Hilsen Håvard","zh":"霍瓦尔 敬上","words":[[0,6,105.86,106.35,"hilsen"],[7,13,106.35,106.9,"håvard"]]},{"id":24,"start":108.87,"end":112.73,"text":"Jeg har lyst til å spise mer kake. Smilefjes.","zh":"我还想再吃点蛋糕。（笑脸）","words":[[0,3,108.95,109.14,"jeg"],[4,7,109.14,109.36,"har"],[8,12,109.36,109.62,"lyst~b499524f55a4"],[13,16,109.62,109.8,"til~99ccdd3453b0"],[17,18,109.8,109.9,"å~0583da7a620a"],[19,24,109.9,110.32,"spise"],[25,28,110.32,110.54,"mer~6e9e1ecc8b41"],[29,33,110.54,111.02,"kake"],[35,44,111.74,112.66,"smilefjes"]]},{"id":25,"start":112.85,"end":114.51,"text":"Hilsen Biniam","zh":"比尼亚姆 敬上","words":[[0,6,112.94,113.82,"hilsen"],[7,13,113.82,114.43,"biniam"]]}],"lexicon":{"18":{"lemma":"18","zh":"数字 18","pos":"数词","ref":"basics:numbers:atten","clip":null,"kind":"number"},"18.9":{"lemma":"18.9.","zh":"9 月 18 日","pos":"日期","ref":null,"clip":null,"kind":"number"},"27":{"lemma":"27","zh":"数字 27","pos":"数词","ref":"basics:numbers:tjuesju","clip":null,"kind":"number"},"27.4":{"lemma":"27.4.","zh":"4 月 27 日","pos":"日期","ref":null,"clip":null,"kind":"number"},"30":{"lemma":"30","zh":"数字 30","pos":"数词","ref":"basics:numbers:tretti","clip":null,"kind":"number"},"5.4":{"lemma":"5.4","zh":"第 5.4 节","pos":"编号","ref":null,"clip":null,"kind":