{"id":"2.2","title":"Jeg kom til Norge i mai","audio":"audio/2.2.mp3","duration":176.0,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":4.79,"text":"2.2 Jeg kom til Norge i mai","heading":true,"zh":"2.2 我五月来到挪威","words":[[0,3,0.15,1.06,"2.2"],[4,7,2.2,2.44,"jeg"],[8,11,2.44,2.78,"kom~a03d8aa690db"],[12,15,2.78,3.1,"til"],[16,21,3.1,3.58,"norge~546b56e35dd5"],[22,23,3.58,4.16,"i"],[24,27,4.16,4.71,"mai"]]},{"id":1,"start":4.81,"end":8.63,"text":"Det er lørdag.","zh":"今天是星期六。","words":[[0,3,6.91,7.43,"det"],[4,6,7.43,7.77,"er"],[7,13,7.77,8.55,"lørdag"]]},{"id":2,"start":9.59,"end":14.1,"text":"Håvard møter Yousef og Leyla i sentrum.","zh":"霍瓦尔在市中心遇见优素福和莱拉。","words":[[0,6,9.67,10.29,"håvard"],[7,12,10.29,10.91,"møter~af568d886d8f"],[13,19,10.91,11.65,"yousef"],[20,22,11.65,12.13,"og"],[23,28,12.13,12.61,"leyla"],[29,30,12.61,13.37,"i"],[31,38,13.37,14.02,"sentrum"]]},{"id":3,"start":15.65,"end":19.03,"text":"Hallo, Håvard. Dette er Leyla.","speaker":"Yousef","zh":"你好，霍瓦尔。这是莱拉。","words":[[0,5,15.73,16.06,"hallo"],[7,13,16.18,16.48,"håvard"],[15,20,17.72,18.0,"dette"],[21,23,18.0,18.3,"er"],[24,29,18.3,18.95,"leyla"]]},{"id":4,"start":19.98,"end":26.62,"text":"Hei, Leyla. Hyggelig å hilse på deg. Når kom du til Norge?","speaker":"Håvard","zh":"你好，莱拉。很高兴认识你。你什么时候来挪威的？","words":[[0,3,20.06,20.43,"hei"],[5,10,20.51,20.65,"leyla"],[12,20,22.18,22.74,"hyggelig"],[21,22,22.74,22.98,"å~0583da7a620a"],[23,28,22.98,23.34,"hilse"],[29,31,23.34,23.46,"på~4d7f4608a94e"],[32,35,23.46,23.64,"deg"],[37,40,24.93,25.25,"når~a56a1c61425b"],[41,44,25.25,25.49,"kom~a03d8aa690db"],[45,47,25.49,25.75,"du"],[48,51,25.75,26.01,"til"],[52,57,26.01,26.54,"norge~546b56e35dd5"]]},{"id":5,"start":27.86,"end":31.55,"text":"Jeg kom til Norge i mai 2015.","speaker":"Leyla","zh":"我 2015 年 5 月来到挪威。","words":[[0,3,27.94,28.19,"jeg"],[4,7,28.19,28.53,"kom~a03d8aa690db"],[8,11,28.53,28.87,"til"],[12,17,28.87,29.39,"norge~546b56e35dd5"],[18,19,29.39,29.81,"i"],[20,23,29.81,30.17,"mai"],[24,28,30.17,31.47,"2015~e80789d569f4"]]},{"id":6,"start":32.19,"end":34.2,"text":"Hvor bor dere?","speaker":"Håvard","zh":"你们住在哪里？","words":[[0,4,32.66,33.32,"hvor"],[5,8,33.32,33.6,"bor"],[9,13,33.6,34.12,"dere"]]},{"id":7,"start":35.42,"end":38.49,"text":"Vi bor i Risveien 22.","speaker":"Leyla","zh":"我们住在 Risveien 街 22 号。","words":[[0,2,35.5,35.86,"vi"],[3,6,35.86,36.2,"bor"],[7,8,36.2,36.64,"i"],[9,17,36.64,37.68,"risveien"],[18,20,37.68,38.41,"22"]]},{"id":8,"start":39.62,"end":41.3,"text":"Hvordan går det i Norge?","speaker":"Håvard","zh":"在挪威过得怎么样？","words":[[0,7,39.7,40.09,"hvordan"],[8,11,40.09,40.37,"går~2536fac625ab"],[12,15,40.37,40.57,"det~8d16156bd355"],[16,17,40.57,40.71,"i"],[18,23,40.71,41.22,"norge~546b56e35dd5"]]},{"id":9,"start":42.05,"end":47.25,"text":"Bare bra, takk! Nå jobber jeg i en barnehage.","speaker":"Leyla","zh":"挺好的，谢谢！现在我在一家幼儿园工作。","words":[[0,4,42.05,42.61,"bare~fd8ffd1acaa7"],[5,8,42.61,43.01,"bra~bbb83846e29f"],[10,14,43.29,43.63,"takk"],[16,18,44.51,45.05,"nå~d531d47a7712"],[19,25,45.05,45.55,"jobber~003ddb6d77e6"],[26,29,45.55,45.81,"jeg"],[30,31,45.81,46.15,"i"],[32,34,46.15,46.31,"en~a939a9e56dc5"],[35,44,46.31,47.17,"barnehage"]]},{"id":10,"start":48.55,"end":51.65,"text":"Så fint, gratulerer med jobb.","speaker":"Håvard","zh":"真好，祝贺你找到工作。","words":[[0,2,48.63,48.9,"så~b7d836739b7f"],[3,7,48.9,49.2,"fint"],[9,19,50.14,50.92,"gratulerer"],[20,23,50.92,51.1,"med~3a143fb74f65"],[24,28,51.1,51.57,"jobb"]]},{"id":11,"start":53.17,"end":58.88,"text":"Håvard, hva betyr «Hvordan går det». Vi går ikke nå.","speaker":"Yousef","zh":"霍瓦尔，“Hvordan går det”是什么意思？我们现在又没在走路。","words":[[0,6,53.25,53.66,"håvard"],[8,11,54.32,54.68,"hva"],[12,17,54.68,55.2,"betyr"],[19,26,55.2,56.06,"hvordan"],[27,30,56.06,56.36,"går~d91f4eff7f16"],[31,34,56.36,56.62,"det~8d16156bd355"],[37,39,57.62,57.9,"vi"],[40,43,57.9,58.18,"går~c60d275ba147"],[44,48,58.18,58.42,"ikke"],[49,51,58.42,58.8,"nå~d531d47a7712"]]},{"id":12,"start":60.06,"end":62.61,"text":"Det betyr «Hvordan har du det».","speaker":"Håvard","zh":"意思是“你过得怎么样”（Hvordan har du det）。","words":[[0,3,60.14,60.35,"det"],[4,9,60.35,60.85,"betyr"],[11,18,61.25,61.73,"hvordan"],[19,22,61.73,62.13,"har~106d9d66c05d"],[23,25,62.13,62.29,"du"],[26,29,62.29,62.53,"det~aef4434dacc8"]]},{"id":13,"start":63.99,"end":68.65,"text":"Å, nå forstår jeg. Vi har det bare bra.","speaker":"Yousef","zh":"哦，现在我明白了。我们过得挺好的。","words":[[0,1,64.07,64.46,"å~496a48c13525"],[3,5,64.96,65.4,"nå~d531d47a7712"],[6,13,65.4,65.88,"forstår"],[14,17,65.88,66.08,"jeg"],[19,21,66.72,67.2,"vi"],[22,25,67.2,67.58,"har~621618be1a78"],[26,29,67.58,67.78,"det~aef4434dacc8"],[30,34,67.78,68.12,"bare~fd8ffd1acaa7"],[35,38,68.12,68.57,"bra~9ed229260de6"]]},{"id":14,"start":68.85,"end":76.36,"text":"Yousef og Leyla bor i Risveien nummer 22.","zh":"优素福和莱拉住在 Risveien 街 22 号。","words":[[0,6,70.28,71.76,"yousef"],[7,9,71.76,72.04,"og"],[10,15,72.04,72.54,"leyla"],[16,19,72.54,73.48,"bor"],[20,21,73.48,73.72,"i"],[22,30,73.72,74.64,"risveien"],[31,37,74.64,75.54,"nummer"],[38,40,75.54,76.36,"22"]]},{"id":15,"start":76.48,"end":80.49,"text":"De er gift og har tre barn.","zh":"他们已婚，有三个孩子。","words":[[0,2,77.34,78.0,"de"],[3,5,78.0,78.24,"er"],[6,10,78.24,78.56,"gift"],[11,13,78.56,79.3,"og"],[14,17,79.3,79.46,"har"],[18,21,79.46,79.86,"tre"],[22,26,79.86,80.41,"barn"]]},{"id":16,"start":81.89,"end":85.14,"text":"Yousef kom til Norge i oktober.","zh":"优素福十月来到挪威。","words":[[0,6,81.97,82.58,"yousef"],[7,10,82.58,82.8,"kom~a03d8aa690db"],[11,14,82.8,83.06,"til"],[15,20,83.06,83.44,"norge~546b56e35dd5"],[21,22,83.44,84.32,"i"],[23,30,84.32,85.06,"oktober"]]},{"id":17,"start":89.55,"end":92.93,"text":"Håvard bor i Fjellgata 15.","zh":"霍瓦尔住在 Fjellgata 街 15 号。","words":[[0,6,89.63,90.18,"håvard"],[7,10,90.18,90.68,"bor"],[11,12,90.68,91.16,"i"],[13,22,91.16,92.06,"fjellgata"],[23,25,92.06,92.85,"15"]]},{"id":18,"start":94.49,"end":96.95,"text":"Han bor sammen med Marit.","zh":"他和玛丽特住在一起。","words":[[0,3,94.57,94.93,"han"],[4,7,94.93,95.25,"bor"],[8,14,95.25,95.81,"sammen"],[15,18,95.81,96.01,"med"],[19,24,96.01,96.87,"marit"]]},{"id":19,"start":97.81,"end":99.85,"text":"De er samboere.","zh":"他们是同居伴侣。","words":[[0,2,97.89,98.24,"de"],[3,5,98.24,98.64,"er"],[6,14,98.64,99.77,"samboere"]]},{"id":20,"start":102.28,"end":105.11,"text":"Biniam bor på Eide.","zh":"比尼亚姆住在艾德。","words":[[0,6,102.36,102.87,"biniam"],[7,10,102.87,103.77,"bor"],[11,13,103.77,104.23,"på~f1860a7da3e3"],[14,18,104.23,105.03,"eide~835eb422ccd4"]]},{"id":21,"start":106.61,"end":108.22,"text":"Han bor alene.","zh":"他一个人住。","words":[[0,3,106.69,107.0,"han"],[4,7,107.0,107.28,"bor"],[8,13,107.28,108.14,"alene"]]},{"id":22,"start":109.5,"end":112.63,"text":"Han kom til Norge i august.","zh":"他八月来到挪威。","words":[[0,3,109.58,109.85,"han"],[4,7,109.85,110.13,"kom~a03d8aa690db"],[8,11,110.13,110.51,"til"],[12,17,110.51,110.97,"norge~546b56e35dd5"],[18,19,110.97,111.51,"i"],[20,26,111.51,112.55,"august"]]},{"id":23,"start":112.69,"end":119.45,"text":"Viola bor i Elgveien 27.","zh":"维奥拉住在 Elgveien 街 27 号。","words":[[0,5,114.57,115.57,"viola"],[6,9,115.57,116.53,"bor"],[10,11,116.53,116.99,"i"],[12,20,116.99,118.25,"elgveien"],[21,23,118.25,119.37,"27"]]},{"id":24,"start":120.41,"end":122.36,"text":"Hun er singel.","zh":"她是单身。","words":[[0,3,120.48,121.04,"hun"],[4,6,121.04,121.5,"er"],[7,13,121.5,122.28,"singel"]]},{"id":25,"start":123.31,"end":127.49,"text":"Hun kom til Norge i mars 2017.","zh":"她 2017 年 3 月来到挪威。","words":[[0,3,123.39,123.87,"hun"],[4,7,123.87,124.23,"kom~a03d8aa690db"],[8,11,124.23,124.59,"til"],[12,17,124.59,124.97,"norge~546b56e35dd5"],[18,19,124.97,125.51,"i"],[20,24,125.51,126.01,"mars"],[25,29,126.01,127.49,"2017~b31af0d1044b"]]},{"id":26,"start":129.17,"end":132.6,"text":"Hun bor sammen med en norsk familie.","zh":"她和一个挪威家庭住在一起。","words":[[0,3,129.25,129.55,"hun"],[4,7,129.55,129.87,"bor"],[8,14,129.87,130.63,"sammen"],[15,18,130.63,130.87,"med"],[19,21,130.87,131.29,"en~a939a9e56dc5"],[22,27,131.29,131.79,"norsk~300c0d0c4f59"],[28,35,131.79,132.52,"familie"]]},{"id":27,"start":135.2,"end":137.68,"text":"Sompit bor i sentrum.","zh":"松皮特住在市中心。","words":[[0,6,135.28,136.13,"sompit"],[7,10,136.13,136.59,"bor"],[11,12,136.59,136.89,"i"],[13,20,136.89,137.6,"sentrum"]]},{"id":28,"start":139.09,"end":143.12,"text":"Hun kom til Norge i februar 2017.","zh":"她 2017 年 2 月来到挪威。","words":[[0,3,139.17,139.45,"hun"],[4,7,139.45,139.77,"kom~a03d8aa690db"],[8,11,139.77,140.15,"til"],[12,17,140.15,140.63,"norge~546b56e35dd5"],[18,19,140.63,141.07,"i"],[20,27,141.07,141.77,"februar"],[28,32,141.77,143.04,"2017~b31af0d1044b"]]},{"id":29,"start":143.82,"end":145.58,"text":"Hun er gift.","zh":"她已婚。","words":[[0,3,143.9,144.45,"hun"],[4,6,144.45,144.79,"er"],[7,11,144.79,145.5,"gift"]]},{"id":30,"start":147.35,"end":152.12,"text":"Hawa kom alene til Norge i desember.","zh":"哈娃十二月独自来到挪威。","words":[[0,4,147.43,148.0,"hawa"],[5,8,148.0,149.0,"kom~a03d8aa690db"],[9,14,149.0,149.68,"alene"],[15,18,150.14,150.18,"til"],[19,24,150.18,150.62,"norge~546b56e35dd5"],[25,26,150.62,151.14,"i"],[27,35,151.14,152.04,"desember"]]},{"id":31,"start":152.48,"end":156.0,"text":"Nå bor hun på Eide.","zh":"现在她住在艾德。","words":[[0,2,153.0,154.0,"nå~d531d47a7712"],[3,6,154.0,154.48,"bor"],[7,10,154.48,154.8,"hun"],[11,13,154.8,155.18,"på~f1860a7da3e3"],[14,18,155.18,155.92,"eide~835eb422ccd4"]]},{"id":32,"start":158.01,"end":163.75,"text":"Bjørnar bor i Gammelveien 134.","zh":"比约纳尔住在 Gammelveien 街 134 号。","words":[[0,7,158.09,158.76,"bjørnar"],[8,11,158.76,159.96,"bor"],[12,13,159.96,160.44,"i"],[14,25,160.44,161.68,"gammelveien"],[26,29,161.68,163.67,"134"]]},{"id":33,"start":165.27,"end":171.85,"text":"Han er skilt og har to barn på fire og sju år.","zh":"他离婚了，有两个孩子，分别是四岁和七岁。","words":[[0,3,165.35,165.58,"han"],[4,6,165.58,165.92,"er"],[7,12,165.92,166.48,"skilt~39bb7cd38da8"],[13,15,166.48,167.6,"og"],[16,19,167.63,167.99,"har"],[20,22,167.99,168.43,"to"],[23,27,168.43,168.85,"barn"],[28,30,168.85,169.71,"på~f81b9c7a500b"]