{"id":"11.3","title":"Norsk geografi","audio":"audio/11.3.mp3","duration":172.25,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.75,"text":"11.3 Norsk geografi","heading":true,"zh":"11.3 挪威地理","words":[[0,4,0.15,1.33,"11.3"],[5,10,1.96,2.8,"norsk~300c0d0c4f59"],[11,19,2.8,3.67,"geografi"]]},{"id":1,"start":5.64,"end":13.88,"text":"Norge har den vakreste naturen i verden, sier mange, og nordmenn er stolte av landet som de bor i.","zh":"很多人说，挪威拥有世界上最美的自然风光，挪威人为自己生活的国家感到骄傲。","words":[[0,5,5.7,6.4,"norge~546b56e35dd5"],[6,9,6.4,6.6,"har"],[10,13,6.6,6.84,"den~5f413bef0ba1"],[14,22,6.84,7.46,"vakreste"],[23,30,7.46,8.08,"naturen"],[31,32,8.08,8.18,"i"],[33,39,8.18,8.86,"verden"],[41,45,9.0,9.32,"sier"],[46,51,9.32,9.78,"mange"],[53,55,10.66,10.8,"og"],[56,64,10.8,11.34,"nordmenn"],[65,67,11.34,11.64,"er"],[68,74,11.64,12.5,"stolte"],[75,77,12.5,12.68,"av~3b15d749ea8f"],[78,84,12.68,13.0,"landet~2155910aaa29"],[85,88,13.0,13.2,"som~b7970b8f941e"],[89,91,13.2,13.36,"de"],[92,95,13.36,13.58,"bor"],[96,97,13.58,13.73,"i"]]},{"id":2,"start":15.5,"end":19.02,"text":"Vi pleier å dele Norge inn i fem landsdeler:","zh":"我们通常把挪威分为五大区域：","words":[[0,2,15.56,15.94,"vi"],[3,9,15.94,16.32,"pleier"],[10,11,16.32,16.44,"å~0583da7a620a"],[12,16,16.44,16.84,"dele~0ef848741bed"],[17,22,16.84,17.28,"norge~546b56e35dd5"],[23,26,17.28,17.56,"inn~cfce693979f5"],[27,28,17.56,17.72,"i~0d22e793ed35"],[29,32,17.72,18.1,"fem"],[33,43,18.1,18.88,"landsdeler"]]},{"id":3,"start":19.66,"end":26.99,"text":"Sørlandet, Vestlandet, Østlandet, Midt-Norge og Nord-Norge.","zh":"南部地区、西部地区、东部地区、中挪威和北挪威。","words":[[0,9,19.72,20.68,"sørlandet"],[11,21,21.3,22.18,"vestlandet"],[23,32,23.04,23.91,"østlandet"],[34,44,24.74,25.59,"midt-norge"],[45,47,25.88,26.22,"og"],[48,58,26.22,26.84,"nord-norge"]]},{"id":4,"start":28.52,"end":32.43,"text":"Naturen og klimaet varierer mye i landsdelene.","zh":"各个区域的自然环境和气候差异很大。","words":[[0,7,28.58,29.38,"naturen"],[8,10,29.38,29.52,"og"],[11,18,29.52,30.16,"klimaet"],[19,27,30.16,30.9,"varierer"],[28,31,30.9,31.4,"mye~933c5a923198"],[32,33,31.4,31.5,"i"],[34,45,31.5,32.28,"landsdelene"]]},{"id":5,"start":33.6,"end":40.84,"text":"Landsdelene deler vi inn i fylker, og fylkene deler vi inn i kommuner.","zh":"我们把这些大区划分为郡，郡又划分为市镇。","words":[[0,11,33.66,34.84,"landsdelene"],[12,17,34.84,35.22,"deler~db6dee44ee34"],[18,20,35.22,35.38,"vi"],[21,24,35.38,35.58,"inn~cfce693979f5"],[25,26,35.58,35.72,"i~0d22e793ed35"],[27,33,35.72,36.48,"fylker"],[35,37,37.34,37.52,"og"],[38,45,37.52,38.34,"fylkene"],[46,51,38.94,39.28,"deler~db6dee44ee34"],[52,54,39.28,39.44,"vi"],[55,58,39.44,39.76,"inn~cfce693979f5"],[59,60,39.76,39.98,"i~0d22e793ed35"],[61,69,39.98,40.69,"kommuner"]]},{"id":6,"start":42.25,"end":49.26,"text":"De største byene i Norge er Oslo, Bergen, Trondheim og Stavanger.","zh":"挪威最大的城市是奥斯陆、卑尔根、特隆赫姆和斯塔万格。","words":[[0,2,42.31,42.62,"de~d251aa490218"],[3,10,42.62,43.08,"største"],[11,16,43.08,43.5,"byene"],[17,18,43.5,43.6,"i"],[19,24,43.6,44.06,"norge~546b56e35dd5"],[25,27,44.06,44.5,"er"],[28,32,44.5,45.13,"oslo"],[34,40,45.68,46.39,"bergen"],[42,51,47.06,47.99,"trondheim"],[52,54,48.24,48.48,"og"],[55,64,48.48,49.11,"stavanger"]]},{"id":7,"start":50.47,"end":55.24,"text":"Det bor flest mennesker i Oslo, som er hovedstaden i Norge.","zh":"奥斯陆人口最多，它是挪威的首都。","words":[[0,3,50.53,50.68,"det"],[4,7,50.68,50.92,"bor"],[8,13,50.92,51.44,"flest"],[14,23,51.44,52.04,"mennesker"],[24,25,52.04,52.12,"i"],[26,30,52.12,52.67,"oslo"],[32,35,53.3,53.52,"som~b7970b8f941e"],[36,38,53.52,53.76,"er"],[39,50,53.76,54.62,"hovedstaden"],[51,52,54.62,54.68,"i"],[53,58,54.68,55.09,"norge~546b56e35dd5"]]},{"id":8,"start":56.56,"end":59.59,"text":"Alle disse byene ligger langs kysten.","zh":"这些城市都位于沿海。","words":[[0,4,56.62,57.1,"alle~6873d9584096"],[5,10,57.1,57.44,"disse"],[11,16,57.44,58.02,"byene"],[17,23,58.16,58.58,"ligger"],[24,29,58.58,58.92,"langs"],[30,36,58.92,59.45,"kysten"]]},{"id":9,"start":60.62,"end":64.52,"text":"Det bor flere mennesker langs kysten enn inne i landet.","zh":"住在沿海的人比住在内陆的人多。","words":[[0,3,60.68,60.92,"det"],[4,7,60.92,61.26,"bor"],[8,13,61.26,61.68,"flere"],[14,23,61.68,62.26,"mennesker"],[24,29,62.26,62.56,"langs"],[30,36,62.56,63.24,"kysten"],[37,40,63.24,63.6,"enn"],[41,45,63.6,63.9,"inne"],[46,47,63.9,64.02,"i"],[48,54,64.02,64.37,"landet~5af37599ee8a"]]},{"id":10,"start":66.34,"end":68.93,"text":"Norge har mange fjell og fjorder.","zh":"挪威有很多山和峡湾。","words":[[0,5,66.4,66.96,"norge~546b56e35dd5"],[6,9,66.96,67.28,"har"],[10,15,67.28,67.76,"mange"],[16,21,67.76,68.1,"fjell"],[22,24,68.1,68.24,"og"],[25,32,68.24,68.78,"fjorder"]]},{"id":11,"start":69.95,"end":75.32,"text":"På Vestlandet og i Nord-Norge er fjellene brattere enn i resten av landet.","zh":"西部地区和北挪威的山比全国其他地方更陡峭。","words":[[0,2,70.02,70.32,"på"],[3,13,70.32,71.12,"vestlandet"],[14,16,71.12,71.36,"og"],[17,18,71.36,71.62,"i"],[19,29,71.62,72.36,"nord-norge"],[30,32,72.36,72.62,"er"],[33,41,72.62,73.24,"fjellene"],[42,50,73.24,73.94,"brattere~0c7e9c9629be"],[51,54,73.94,74.14,"enn"],[55,56,74.14,74.22,"i"],[57,63,74.22,74.66,"resten"],[64,66,74.66,74.82,"av"],[67,73,74.82,75.17,"landet~2155910aaa29"]]},{"id":12,"start":76.43,"end":79.27,"text":"Mellom fjellene er det dype daler.","zh":"群山之间是深深的山谷。","words":[[0,6,76.49,77.14,"mellom"],[7,15,77.14,77.88,"fjellene"],[16,18,77.88,78.0,"er"],[19,22,78.0,78.2,"det"],[23,27,78.2,78.62,"dype"],[28,33,78.62,79.12,"daler"]]},{"id":13,"start":80.41,"end":83.25,"text":"Vestlandet er kjent for vakre fjorder.","zh":"西部地区以美丽的峡湾而闻名。","words":[[0,10,80.47,81.36,"vestlandet"],[11,13,81.36,81.58,"er"],[14,19,81.58,81.9,"kjent~78aab1d11970"],[20,23,81.9,82.14,"for~5d5288bb395e"],[24,29,82.14,82.62,"vakre"],[30,37,82.62,83.1,"fjorder"]]},{"id":14,"start":83.8,"end":91.0,"text":"Den lengste og dypeste fjorden heter Sognefjorden og er over 200 kilometer lang.","zh":"最长、最深的峡湾叫松恩峡湾，长200多公里。","words":[[0,3,83.86,84.08,"den~5f413bef0ba1"],[4,11,84.08,84.74,"lengste~30f74c2863d3"],[12,14,84.74,84.86,"og"],[15,22,84.86,85.5,"dypeste~3dc50a5ac493"],[23,30,85.5,85.96,"fjorden"],[31,36,85.96,86.62,"heter"],[37,49,86.76,87.82,"sognefjorden"],[50,52,88.14,88.26,"og"],[53,55,88.26,88.54,"er"],[56,60,88.54,89.06,"over~25ba017bad18"],[61,64,89.06,89.86,"200"],[65,74,89.86,90.5,"kilometer"],[75,79,90.5,90.85,"lang"]]},{"id":15,"start":93.17,"end":97.63,"text":"Den største innsjøen heter Mjøsa og ligger på Østlandet.","zh":"最大的湖叫米约萨湖，位于东部地区。","words":[[0,3,93.23,93.64,"den~5f413bef0ba1"],[4,11,93.64,94.16,"største~cf448fdd1a9c"],[12,20,94.16,94.86,"innsjøen"],[21,26,94.86,95.22,"heter"],[27,32,95.22,95.84,"mjøsa"],[33,35,96.34,96.46,"og"],[36,42,96.46,96.78,"ligger"],[43,45,96.78,96.92,"på"],[46,55,96.92,97.48,"østlandet"]]},{"id":16,"start":98.88,"end":103.87,"text":"Ved Mjøsa ligger byene Hamar, Lillehammer og Gjøvik.","zh":"米约萨湖畔有哈马尔、利勒哈默尔和约维克这几座城市。","words":[[0,3,98.94,99.3,"ved"],[4,9,99.3,99.88,"mjøsa"],[10,16,99.88,100.24,"ligger"],[17,22,100.24,100.82,"byene"],[23,28,100.82,101.58,"hamar"],[30,41,101.96,102.9,"lillehammer"],[42,44,102.9,103.04,"og"],[45,51,103.04,103.72,"gjøvik"]]},{"id":17,"start":104.86,"end":110.93,"text":"På Østlandet er landskapet flatere enn på Vestlandet, og skogene er større.","zh":"东部地区的地形比西部地区平坦，森林也更大。","words":[[0,2,104.92,105.3,"på"],[3,12,105.3,106.02,"østlandet"],[13,15,106.12,106.26,"er"],[16,26,106.26,106.94,"landskapet"],[27,34,106.94,107.8,"flatere~993cd6cf3a88"],[35,38,107.9,108.08,"enn"],[39,41,108.08,108.2,"på"],[42,52,108.2,108.92,"vestlandet"],[54,56,109.34,109.5,"og"],[57,64,109.5,110.1,"skogene"],[65,67,110.1,110.32,"er"],[68,74,110.32,110.78,"større~58819df7c557"]]},{"id":18,"start":112.0,"end":116.85,"text":"Den lengste elva i Norge ligger også på Østlandet og heter Glomma.","zh":"挪威最长的河流也在东部地区，叫格罗马河。","words":[[0,3,112.06,112.32,"den~5f413bef0ba1"],[4,11,112.32,112.88,"lengste~30f74c2863d3"],[12,16,112.88,113.28,"elva"],[17,18,113.28,113.38,"i"],[19,24,113.38,113.82,"norge~546b56e35dd5"],[25,31,113.82,114.18,"ligger"],[32,36,114.18,114.48,"også"],[37,39,114.48,114.62,"på"],[40,49,114.62,115.3,"østlandet"],[50,52,115.64,115.78,"og"],[53,58,115.78,116.2,"heter"],[59,65,116.2,116.7,"glomma"]]},{"id":19,"start":117.65,"end":120.79,"text":"Den er over 600 kilometer lang.","zh":"它长600多公里。","words":[[0,3,117.71,118.06,"den"],[4,6,118.06,118.36,"er"],[7,11,118.36,118.8,"over~25ba017bad18"],[12,15,118.8,119.72,"600"],[16,25,119.72,120.32,"kilometer"],[26,30,120.32,120.64,"lang"]]},{"id":20,"start":122.57,"end":127.19,"text":"Norge får besøk av mange turister som vil se den vakre naturen.","zh":"很多游客来到挪威，想看看这里美丽的自然风光。","words":[[0,5,122.63,123.12,"norge~546b56e35dd5"],[6,9,123.12,123.34,"får~9dd08843ba81"],[10,15,123.34,123.84,"besøk"],[16,18,123.84,124.06,"av"],[19,24,124.06,124.38,"mange"],[25,33,124.38,125.16,"turister"],[34,37,125.16,125.36,"som~b7970b8f941e"],[38,41,125.36,125.6,"vil"],[42,44,125.6,125.98,"se"],[45,48,125.98,126.18,"den~5f413bef0ba1"],[49,54,126.18,126.52,"vakre"],[55,62,126.52,127.04,"naturen"]]},{"id":21,"start":128.17,"end":131.27,"text":"I Nord-Norge er det midnattssol om sommeren.","zh":"北挪威夏天有午夜太阳。","words":[[0,1,128.23,128.6,"i"],[2,12,128.6,129.22,"nord-norge"],[13,15,129.22,129.32,"er"],[16,19,129.32,129.58,"det"],[20,31,129.58,130.48,"midnattssol"],[32,34,130.48,130.66,"om~1438adee3ecf"],[35,43,130.66,131.12,"sommeren"]]},{"id":22,"start":131.97,"end":135.0,"text":"Da skinner sola både om dagen og om natta.","zh":"那时太阳白天和夜里都照耀着。","words":[[0,2,132.03,132.36,"da~c65388b29f33"],[3,10,132.36,132.84,"skinner~c959f9b56e0a"],[11,15,132.84,133.28,"sola"],[16,20,133.28,133.72,"både"],[21,23,133.72,133.86,"om~66e94fad3771"],[24,29,133.86,134.24,"dagen"],[30,32,134.24,134.34,"og"],[33,35,134.34,134.46,"om~c60166dd3b17"],[36,41,134.46,134.84,"natta"]]},{"id":23,"start":135.84,"end":140.17,"text":"Om vinteren er det mørketid, og sola er borte hele døgnet.","zh":"冬天是极夜，太阳一整天都不出来。","words":[[0,2,135.91,136.14,"om~1e753acc270b"],[3,11,136.14,136.74,"vinteren"],[12,14,136.74,136.86,"er"],[15,18,136.86,137.02,"det"],[19,27,137.02,137.92,"mørketid"],[29,31,138.2,138.36,"og"],[32,36,138.36,138.72,"sola"],[37,39,138.72,138.86,"er"],[40,45,138.86,139.24,"borte"],[46,50,139.24,139.62,"hele"],[51,57,139.62,140.02,"døgnet"]]},{"id":24,"start":144.06,"end":146.65,"text":"Det er mange høye fosser i Norge.","zh":"挪威有很多高高的瀑布。","words":[[0,3,144.12,144.28,"det"],[4,6,144.28,144.48,"er"],[7,12,144.48,144.98,"mange"],[13,17,144.98,145.4,"høye"],[18,24,145.4,146.0,"fosser"],[25,26,146.0,146.1,"i"],[27,32,146.1,146.5,"norge~546b56e35dd5"]]},{"id":25,"start":148.39,"end":151.61,"text":"Mange fjell er høye, bratte og spisse.","zh":"很多山又高、又陡、又尖。","words":[[0,5,148.45,148.98,"mange"],[6,11,148.98,149.36,"fjell"],[12,14,149.36,149.64,"er"],[15,19,149.64,150.24,"høye"],[21,27,150.24,150.88,"bratte"],[28,30,150.88,150.98,"og"],[31,37,150.98,151.46,"spisse"]]},{"id":26,"start":153.46,"end":155.41,"text":"Norge har mange fjorder.","zh":"挪威有很多峡湾。","words":[[0,5,153.52,154.08,"norge~546b56e35dd5"],[6,9,154.08,154.38,"har"],[10,15,154.38,154.78,"mange"],[16,23,154.78,155.26,"fjorder"]]},{"id":27,"start":157.06,"end":159.59,"text":"Det er mange innsjøer i Norge.","zh":"挪威有很多湖泊。","words":[[0,3,157.12,157.34,"det"],[4,6,157.34,157.64,"er"],[7,12,157.64,158.04,"mange"],[13,21,158.04,158.96,"innsjøer"],[22,23,158.96,159.06,"i"],[24,29,159.06,159.44,"norge~546b56e35dd5"]]},{"id":28,"start":161.57,"end":164.23,"text":"Det er store skoger på Østlandet.","zh":"东部地区有大片森林。","words":[[0,3,161.63,161.78,"det"],[4,6,161.78,162.06,"er"],[7,12,162.06,162.64,"store"],[13,19,162.64,163.34,"skoger"],[20,22,163.34,163.5,"på"],[23,32,163.5,164.08,"østlandet"]]},{"id":29,"start":165.99,"end":168.65,"text":"Norge har mange isbreer.","zh":"挪威有很多冰川。","words":[[0,5,166.05,166.66,"norge~546b56e35dd5"],[6,9,166.66,166.98,"har"],[10,15,166.98,167.58,"mange"],[16,23,167.58,168.5,"isbreer"]]}],"lexicon":{"11.3":{"lemma":"11.3","zh":"第 11.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"20