{"id":"11.3","title":"Norsk geografi","audio":"audio/11.3.mp3","duration":172.25,"synthetic":false,"sentences":[{"id":0,"start":0.15,"end":3.75,"text":"11.3 Norsk geografi","heading":true,"zh":"11.3 挪威地理","words":[[0,4,0.15,1.33,"11.3"],[5,10,1.96,2.8,"norsk~300c0d0c4f59"],[11,19,2.8,3.67,"geografi"]]},{"id":1,"start":5.6,"end":13.83,"text":"Norge har den vakreste naturen i verden, sier mange, og nordmenn er stolte av landet som de bor i.","zh":"很多人说，挪威拥有世界上最美的自然风光，挪威人为自己生活的国家感到骄傲。","words":[[0,5,5.68,6.18,"norge~546b56e35dd5"],[6,9,6.18,6.56,"har"],[10,13,6.56,6.76,"den~5f413bef0ba1"],[14,22,6.76,7.38,"vakreste"],[23,30,7.38,8.0,"naturen"],[31,32,8.0,8.14,"i"],[33,39,8.14,8.66,"verden"],[41,45,8.96,9.22,"sier"],[46,51,9.22,9.46,"mange"],[53,55,10.24,10.76,"og"],[56,64,10.76,11.18,"nordmenn"],[65,67,11.18,11.48,"er"],[68,74,11.48,12.24,"stolte"],[75,77,12.24,12.62,"av~3b15d749ea8f"],[78,84,12.62,12.96,"landet~2155910aaa29"],[85,88,12.96,13.1,"som~b7970b8f941e"],[89,91,13.1,13.3,"de"],[92,95,13.3,13.52,"bor"],[96,97,13.52,13.75,"i"]]},{"id":2,"start":15.48,"end":18.97,"text":"Vi pleier å dele Norge inn i fem landsdeler:","zh":"我们通常把挪威分为五大区域：","words":[[0,2,15.56,15.83,"vi"],[3,9,15.83,16.23,"pleier"],[10,11,16.23,16.41,"å~0583da7a620a"],[12,16,16.41,16.67,"dele~0ef848741bed"],[17,22,16.67,17.15,"norge~546b56e35dd5"],[23,26,17.15,17.43,"inn~cfce693979f5"],[27,28,17.43,17.61,"i~0d22e793ed35"],[29,32,17.61,17.93,"fem"],[33,43,17.93,18.89,"landsdeler"]]},{"id":3,"start":19.62,"end":26.94,"text":"Sørlandet, Vestlandet, Østlandet, Midt-Norge og Nord-Norge.","zh":"南部地区、西部地区、东部地区、中挪威和北挪威。","words":[[0,9,19.7,20.51,"sørlandet"],[11,21,21.27,22.01,"vestlandet"],[23,32,22.95,23.75,"østlandet"],[34,44,24.69,25.33,"midt-norge"],[45,47,25.33,26.01,"og"],[48,58,26.01,26.86,"nord-norge"]]},{"id":4,"start":28.49,"end":32.38,"text":"Naturen og klimaet varierer mye i landsdelene.","zh":"各个区域的自然环境和气候差异很大。","words":[[0,7,28.57,29.3,"naturen"],[8,10,29.3,29.46,"og"],[11,18,29.46,30.1,"klimaet"],[19,27,30.1,30.74,"varierer"],[28,31,30.74,31.24,"mye~933c5a923198"],[32,33,31.24,31.46,"i"],[34,45,31.46,32.3,"landsdelene"]]},{"id":5,"start":33.57,"end":40.8,"text":"Landsdelene deler vi inn i fylker, og fylkene deler vi inn i kommuner.","zh":"我们把这些大区划分为郡，郡又划分为市镇。","words":[[0,11,33.65,34.6,"landsdelene"],[12,17,34.79,35.19,"deler~db6dee44ee34"],[18,20,35.19,35.33,"vi"],[21,24,35.33,35.51,"inn~cfce693979f5"],[25,26,35.51,35.65,"i~0d22e793ed35"],[27,33,35.65,36.25,"fylker"],[35,37,36.25,37.41,"og"],[38,45,37.41,38.13,"fylkene"],[46,51,38.81,39.23,"deler~db6dee44ee34"],[52,54,39.23,39.39,"vi"],[55,58,39.39,39.59,"inn~cfce693979f5"],[59,60,39.59,39.89,"i~0d22e793ed35"],[61,69,39.89,40.72,"kommuner"]]},{"id":6,"start":42.22,"end":49.2,"text":"De største byene i Norge er Oslo, Bergen, Trondheim og Stavanger.","zh":"挪威最大的城市是奥斯陆、卑尔根、特隆赫姆和斯塔万格。","words":[[0,2,42.3,42.5,"de~d251aa490218"],[3,10,42.5,42.96,"største"],[11,16,42.96,43.4,"byene"],[17,18,43.4,43.56,"i"],[19,24,43.56,43.8,"norge~546b56e35dd5"],[25,27,43.8,44.3,"er"],[28,32,44.3,44.92,"oslo"],[34,40,45.64,46.14,"bergen"],[42,51,47.02,47.72,"trondheim"],[52,54,47.72,48.4,"og"],[55,64,48.4,49.12,"stavanger"]]},{"id":7,"start":50.46,"end":55.2,"text":"Det bor flest mennesker i Oslo, som er hovedstaden i Norge.","zh":"奥斯陆人口最多，它是挪威的首都。","words":[[0,3,50.54,50.64,"det"],[4,7,50.64,50.78,"bor"],[8,13,50.78,51.32,"flest"],[14,23,51.32,51.92,"mennesker"],[24,25,51.92,52.08,"i"],[26,30,52.08,52.5,"oslo"],[32,35,53.34,53.44,"som~b7970b8f941e"],[36,38,53.44,53.68,"er"],[39,50,53.68,54.44,"hovedstaden"],[51,52,54.44,54.66,"i"],[53,58,54.66,55.12,"norge~546b56e35dd5"]]},{"id":8,"start":56.53,"end":59.54,"text":"Alle disse byene ligger langs kysten.","zh":"这些城市都位于沿海。","words":[[0,4,56.61,56.98,"alle~6873d9584096"],[5,10,56.98,57.34,"disse"],[11,16,57.34,57.86,"byene"],[17,23,57.86,58.38,"ligger"],[24,29,58.38,58.86,"langs"],[30,36,58.86,59.46,"kysten"]]},{"id":9,"start":60.47,"end":64.46,"text":"Det bor flere mennesker langs kysten enn inne i landet.","zh":"住在沿海的人比住在内陆的人多。","words":[[0,3,60.55,60.84,"det"],[4,7,60.84,61.1,"bor"],[8,13,61.1,61.58,"flere"],[14,23,61.58,62.14,"mennesker"],[24,29,62.14,62.5,"langs"],[30,36,62.5,62.94,"kysten"],[37,40,62.94,63.38,"enn"],[41,45,63.38,63.82,"inne"],[46,47,63.82,63.96,"i"],[48,54,63.96,64.38,"landet~5af37599ee8a"]]},{"id":10,"start":66.3,"end":68.97,"text":"Norge har mange fjell og fjorder.","zh":"挪威有很多山和峡湾。","words":[[0,5,66.38,66.88,"norge~546b56e35dd5"],[6,9,66.88,67.14,"har"],[10,15,67.14,67.6,"mange"],[16,21,67.6,68.0,"fjell"],[22,24,68.0,68.18,"og"],[25,32,68.18,68.89,"fjorder"]]},{"id":11,"start":69.92,"end":75.27,"text":"På Vestlandet og i Nord-Norge er fjellene brattere enn i resten av landet.","zh":"西部地区和北挪威的山比全国其他地方更陡峭。","words":[[0,2,70.0,70.18,"på"],[3,13,70.18,71.0,"vestlandet"],[14,16,71.0,71.26,"og"],[17,18,71.26,71.48,"i"],[19,29,71.48,72.16,"nord-norge"],[30,32,72.16,72.46,"er"],[33,41,72.46,73.1,"fjellene"],[42,50,73.1,73.8,"brattere~0c7e9c9629be"],[51,54,73.8,74.1,"enn"],[55,56,74.1,74.2,"i"],[57,63,74.2,74.62,"resten"],[64,66,74.62,74.74,"av"],[67,73,74.74,75.19,"landet~2155910aaa29"]]},{"id":12,"start":76.39,"end":79.21,"text":"Mellom fjellene er det dype daler.","zh":"群山之间是深深的山谷。","words":[[0,6,76.47,77.07,"mellom"],[7,15,77.07,77.67,"fjellene"],[16,18,77.67,77.97,"er"],[19,22,77.97,78.09,"det"],[23,27,78.09,78.55,"dype"],[28,33,78.55,79.13,"daler"]]},{"id":13,"start":80.37,"end":83.19,"text":"Vestlandet er kjent for vakre fjorder.","zh":"西部地区以美丽的峡湾而闻名。","words":[[0,10,80.45,81.22,"vestlandet"],[11,13,81.22,81.5,"er"],[14,19,81.5,81.78,"kjent~78aab1d11970"],[20,23,81.78,82.04,"for~5d5288bb395e"],[24,29,82.04,82.56,"vakre"],[30,37,82.56,83.11,"fjorder"]]},{"id":14,"start":83.67,"end":90.95,"text":"Den lengste og dypeste fjorden heter Sognefjorden og er over 200 km lang.","zh":"最长、最深的峡湾叫松恩峡湾，长200多公里。","words":[[0,3,83.75,84.02,"den~5f413bef0ba1"],[4,11,84.02,84.56,"lengste~30f74c2863d3"],[12,14,84.56,84.82,"og"],[15,22,84.82,85.38,"dypeste~3dc50a5ac493"],[23,30,85.38,85.8,"fjorden"],[31,36,85.8,86.28,"heter"],[37,49,86.28,87.52,"sognefjorden"],[50,52,87.52,88.24,"og"],[53,55,88.24,88.42,"er"],[56,60,88.42,88.86,"over~25ba017bad18"],[61,64,88.86,89.68,"200"],[65,67,89.68,90.28,"km"],[68,72,90.28,90.87,"lang"]]},{"id":15,"start":93.15,"end":97.57,"text":"Den største innsjøen heter Mjøsa og ligger på Østlandet.","zh":"最大的湖叫米约萨湖，位于东部地区。","words":[[0,3,93.23,93.55,"den~5f413bef0ba1"],[4,11,93.55,94.03,"største~cf448fdd1a9c"],[12,20,94.03,94.77,"innsjøen"],[21,26,94.77,95.11,"heter"],[27,32,95.11,95.67,"mjøsa"],[33,35,95.67,96.43,"og"],[36,42,96.43,96.61,"ligger"],[43,45,96.61,96.85,"på"],[46,55,96.85,97.49,"østlandet"]]},{"id":16,"start":98.32,"end":103.86,"text":"Ved Mjøsa ligger byene Hamar, Lillehammer og Gjøvik.","zh":"米约萨湖畔有哈马尔、利勒哈默尔和约维克这几座城市。","words":[[0,3,98.4,99.19,"ved"],[4,9,99.19,99.81,"mjøsa"],[10,16,99.81,100.07,"ligger"],[17,22,100.07,100.63,"byene"],[23,28,100.63,101.37,"hamar"],[30,41,101.83,102.53,"lillehammer"],[42,44,102.53,102.99,"og"],[45,51,102.99,103.78,"gjøvik"]]},{"id":17,"start":104.87,"end":110.87,"text":"På Østlandet er landskapet flatere enn på Vestlandet, og skogene er større.","zh":"东部地区的地形比西部地区平坦，森林也更大。","words":[[0,2,104.95,105.22,"på"],[3,12,105.22,105.84,"østlandet"],[13,15,105.84,106.2,"er"],[16,26,106.2,106.84,"landskapet"],[27,34,106.84,107.58,"flatere~993cd6cf3a88"],[35,38,107.58,108.02,"enn"],[39,41,108.02,108.16,"på"],[42,52,108.16,108.74,"vestlandet"],[54,56,109.28,109.42,"og"],[57,64,109.42,109.92,"skogene"],[65,67,109.92,110.24,"er"],[68,74,110.24,110.79,"større~58819df7c557"]]},{"id":18,"start":111.98,"end":116.78,"text":"Den lengste elva i Norge ligger også på Østlandet og heter Glomma.","zh":"挪威最长的河流也在东部地区，叫格罗马河。","words":[[0,3,112.06,112.26,"den~5f413bef0ba1"],[4,11,112.26,112.76,"lengste~30f74c2863d3"],[12,16,112.76,113.2,"elva"],[17,18,113.2,113.36,"i"],[19,24,113.36,113.66,"norge~546b56e35dd5"],[25,31,113.66,113.98,"ligger"],[32,36,113.98,114.4,"også"],[37,39,114.4,114.56,"på"],[40,49,114.56,115.1,"østlandet"],[50,52,115.1,115.74,"og"],[53,58,115.74,116.08,"heter"],[59,65,116.08,116.7,"glomma"]]},{"id":19,"start":117.66,"end":120.81,"text":"Den er over 600 kilometer lang.","zh":"它长600多公里。","words":[[0,3,117.74,117.86,"den"],[4,6,117.86,118.18,"er"],[7,11,118.18,118.58,"over~25ba017bad18"],[12,15,118.58,119.04,"600"],[16,25,119.04,119.92,"kilometer"],[26,30,119.92,120.73,"lang"]]},{"id":20,"start":122.43,"end":127.12,"text":"Norge får besøk av mange turister som vil se den vakre naturen.","zh":"很多游客来到挪威，想看看这里美丽的自然风光。","words":[[0,5,122.51,123.04,"norge~546b56e35dd5"],[6,9,123.04,123.26,"får~9dd08843ba81"],[10,15,123.26,123.78,"besøk"],[16,18,123.78,123.94,"av"],[19,24,123.94,124.22,"mange"],[25,33,124.22,124.8,"turister"],[34,37,124.8,125.32,"som~b7970b8f941e"],[38,41,125.32,125.5,"vil"],[42,44,125.5,125.8,"se"],[45,48,125.8,126.12,"den~5f413bef0ba1"],[49,54,126.12,126.44,"vakre"],[55,62,126.44,127.04,"naturen"]]},{"id":21,"start":128.13,"end":131.21,"text":"I Nord-Norge er det midnattssol om sommeren.","zh":"北挪威夏天有午夜太阳。","words":[[0,1,128.21,128.53,"i"],[2,12,128.53,129.01,"nord-norge"],[13,15,129.01,129.31,"er"],[16,19,129.31,129.43,"det"],[20,31,129.43,130.35,"midnattssol"],[32,34,130.35,130.59,"om~1438adee3ecf"],[35,43,130.59,131.13,"sommeren"]]},{"id":22,"start":131.83,"end":134.67,"text":"Da skinner sola både om dagen og om natta.","zh":"那时太阳白天和夜里都照耀着。","words":[[0,2,131.91,132.27,"da~c65388b29f33"],[3,10,132.27,132.75,"skinner~626931ca101c"],[11,15,132.75,133.01,"sola"],[16,20,133.01,133.63,"både"],[21,23,133.63,133.81,"om~66e94fad3771"],[24,29,133.81,134.05,"dagen"],[30,32,134.05,134.31,"og"],[33,35,134.31,134.43,"om~c60166dd3b17"],[36,41,134.43,134.67,"natta"]]},{"id":23,"start":134.9,"end":140.11,"text":"Om vinteren er det mørketid, og sola er borte hele døgnet.","zh":"冬天是极夜，太阳一整天都不出来。","words":[[0,2,134.9,136.07,"om~1e753acc270b"],[3,11,136.07,136.67,"vinteren"],[12,14,136.67,136.83,"er"],[15,18,136.83,136.95,"det"],[19,27,136.95,137.65,"mørketid"],[29,31,138.25,138.29,"og"],[32,36,138.29,138.55,"sola"],[37,39,138.55,138.79,"er"],[40,45,138.79,139.13,"borte"],[46,50,139.13,139.45,"hele"],[51,57,139.45,140.03,"døgnet"]]},{"id":24,"start":144.06,"end":146.59,"text":"Det er mange høye fosser i Norge.","zh":"挪威有很多高高的瀑布。","words":[[0,3,144.14,144.23,"det"],[4,6,144.23,144.35,"er"],[7,12,144.35,144.69,"mange"],[13,17,144.69,145.31,"høye"],[18,24,145.31,145.87,"fosser"],[25,26,145.87,146.05,"i"],[27,32,146.05,146.51,"norge~546b56e35dd5"]]},{"id":25,"start":148.37,"end":151.55,"text":"Mange fjell er høye, bratte og spisse.","zh":"很多山又高、又陡、又尖。","words":[[0,5,148.45,148.87,"mange"],[6,11,148.87,149.27,"fjell"],[12,14,149.27,149.51,"er"],[15,19,149.51,150.05,"høye"],[21,27,150.21,150.55,"bratte"],[28,30,150.55,150.95,"og"],[31,37,150.95,151.47,"spisse"]]},{"id":26,"start":153.43,"end":155.36,"text":"Norge har mange fjorder.","zh":"挪威有很多峡湾。","words":[[0,5,153.51,153.98,"norge~546b56e35dd5"],[6,9,153.98,154.24,"har"],[10,15,154.24,154.56,"mange"],[16,23,154.56,155.28,"fjorder"]]},{"id":27,"start":156.99,"end":159.53,"text":"Det er mange innsjøer i Norge.","zh":"挪威有很多湖泊。","words":[[0,3,157.06,157.26,"det"],[4,6,157.26,157.52,"er"],[7,12,157.52,157.8,"mange"],[13,21,157.8,158.78,"innsjøer"],[22,23,158.78,159.02,"i"],[24,29,159.02,159.45,"norge~546b56e35dd5"]]},{"id":28,"start":161.55,"end":164.16,"text":"Det er store skoger på Østlandet.","zh":"东部地区有大片森林。","words":[[0,3,161.63,161.74,"det"],[4,6,161.74,161.92,"er"],[7,12,161.92,162.4,"store"],[13,19,162.4,163.22,"skoger"],[20,22,163.22,163.44,"på"],[23,32,163.44,164.08,"østlandet"]]},{"id":29,"start":165.95,"end":168.59,"text":"Norge har mange isbreer.","zh":"挪威有很多冰川。","words":[[0,5,166.03,166.54,"norge~546b56e35dd5"],[6,9,166.54,166.86,"har"],[10,15,166.86,167.22,"mange"],[16,23,167.22,168.51,"isbreer"]]}],"lexicon":{"11.3":{"lemma":"11.3","zh":"第 11.3 节","pos":"编号","ref":null,"clip":null,"kind":"section"},"