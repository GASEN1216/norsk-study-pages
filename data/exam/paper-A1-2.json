        },
        {
          "id": "A1-2-1-4",
          "text": "___ starter møtet?",
          "answer": "Når",
          "tr": "会议什么时候开始？",
          "why": "问时间用 når（什么时候）。"
        },
        {
          "id": "A1-2-1-5",
          "text": "___ lærer du norsk?",
          "note": "(Fordi jeg vil snakke med venner.)",
          "answer": "Hvorfor",
          "tr": "你为什么学挪威语？（因为我想和朋友说话。）",
          "why": "回答用 fordi（因为），所以问句用 hvorfor（为什么）。"
        }
      ]
    },
